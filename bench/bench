#!/usr/bin/env bash
# The single entry point of the sift benchmark harness. `bench/bench --help` documents everything;
# bench/README.md has the short version. The scripts in bench/steps/ are internal helpers it calls.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
STEPS=$HERE/steps
REPO=$(dirname "$HERE")

usage() {
  cat <<'EOF'
Usage: bench/bench COMMAND [options]

One suite for every engine and every dataset: sift (and its variants), ParadeDB pg_search, pg_textsearch, rum, pgx-bm25, gin,
Tantivy, Elasticsearch on two public datasets, every engine on a throwaway PostgreSQL 18 cluster of its own (a lane; Elasticsearch and Tantivy
run as a server / library next to it, driven over HTTP by xbench) with an equal share of the CPU budget, all engines measured at the same time so host load drifts hit all of them alike (--serial: one cluster, interleaved). The engines are the lines of bench/engines.tsv, each with an adapter bench/engines/<id>.sh.

Commands
  setup      check the prerequisites, download and convert the datasets, build or unpack the engines
  run        measure: articles (full-text search on Simple English Wikipedia) and/or places (multi-field
             autocomplete on GeoNames); writes raw tables per dataset and tier into the result directory and
             prints the tables (the report) at the end
  report     turn result directories into results.tsv (chart input), builds.tsv and tables.md
  charts     draw the SVG charts of docs/img from the committed bench/results/*.tsv (stdlib python, deterministic)
  all        setup, run and report in one go (the clean-checkout reproduction). For the ab and full tiers it also runs
             the cold-cache tables and writes bench/results and docs/img (report --docs)
  cold       like run, but every query starts with the index and heap evicted from the caches (Postgres engines)
  regress    the regression check: sift against a build of an older git ref (sift_ref, `--ref`, default v1.1.0) and sift
             `positions = off` against sift_ref, per class: new and reference values,
             ratio, and a REGRESSION when the new value is worse by more than 5% and 2 combined standard errors (index size,
             build time too); exit status 1 on a regression. `regress --run` builds both and measures sift and sift_ref on the
             articles and places (a reduced matrix of classes, see --engines to add sift_nopos and --classes to widen
             it) and compares; `regress [DIR|results.tsv ...]` compares results that exist (default bench/out/latest)
  check      correctness: `check oracle ENGINE [N]` compares match sets and count(*) with a tsvector oracle,
             `check rank ENGINE [N]` compares the top-10 with pgx-bm25's BM25 (any engine, external ones included);
             `check --dataset places [oracle|rank] [N]` runs every engine of --engines on N (default 30) places queries
             per class against the SQL oracle of sql/places_oracle.sql (match sets; BM25 top-20 of top, boost, filter)
  suite      the standard multi-engine suite: `suite [ENGINE...]` is `run --dataset articles` over every engine (default) with
             the classes term and or phrase prefix fuzzy count mixed
  workload   `workload ENGINE [CLASS...]` is `run --dataset articles --engines ENGINE --classes CLASS...` with one 30 s round
             per class (default and or phrase mixed count filter join update)
  workers    sift CREATE INDEX time per parallel worker count: `workers [N...]`
  remote     run the harness on a remote host: `remote sync|setup|sift|quick|run|sh|pull|clean ...` (RHOST)
  machine    print the machine and engine description (CPU, RAM, kernel, PostgreSQL, versions, load)
  clean      destroy the clusters and remove scratch; `clean --all` also removes datasets, dumps and engines

check, workers and the engines' databases of a run start the tier's cluster, load the corpus if needed and leave it running
(`check`, `workers`); `clean` stops it.

Options (not every option applies to every command)
  --tier T          quick | ab | full (default quick, the reduced scale)
                      quick  25,000 articles, GeoNames cities15000 (34,165 places), 2 rounds of 1 s cells:
                             the whole default run takes about 2 minutes after the one-time downloads
                      ab     150,000 articles, cities15000, 2-3 rounds: the intermediate tier of docs/BENCHMARKS.md (about 4 minutes)
                      full   218,058 articles (all), cities500 (236,262 places), 2-3 rounds (--serial: 51 minutes measured with the previous fixed-length cells, 18 minutes of cells with cells that stop on their standard error)
  --full            same as --tier full: the full-size run, the scale of the published numbers
  --dataset D       articles | places | all (default all)
  --engines LIST    comma separated engine ids of bench/engines.tsv (default: the engines with default = yes: sift, sift_nopos
                    (positions = off), pg_search, pg_textsearch, rum, bm25, elasticsearch). setup: which engines to
                    build. An engine whose extension is missing, or that has no workload for the dataset, is skipped with a message.
  --classes LIST    comma separated classes. articles: and or phrase mixed count filter join term prefix fuzzy update; places:
                    p1 p2 p3 p4 w1 a2 a2s a3 x2 (default: the classes of the tier; a dataset with none of the names is not run)
  --workloads LIST  places workloads: top boost filter count scan (default: those of the tier)
  --cpus LIST       the server CPUs of the CPU budget (default: the 8 least busy hardware threads, whole cores, picked by
                    steps/cpus.sh); with --load-cpus the budget is printed in the machine description and the tables
  --load-cpus LIST  the CPUs of the load generators (pgbench, xbench), disjoint from the servers' (default: 4 threads)
  --serial          one cluster with all server CPUs and the engines interleaved cell by cell (the earlier method) instead of one
                    cluster per engine, each on an equal share of the CPUs, all engines measured at the same time
  --rebuild         build every engine database again instead of taking it from the cache of built clusters ($SIFT_BENCH_ROOT/cache/lanes)
  --sample N        statements per class of the articles trace every engine gets (default 0 = the whole trace; a fixed
                    pseudo-random order, the same for every engine)
  --clients N       concurrent clients of the articles cells (default 8; places is single client)
  --workers N       cap the worker processes: pgbench threads and the server's parallel workers (default: from the CPU lists)
  --max-time S      the longest a cell is measured in a round, seconds (alias --duration; defaults: quick 1, ab 2, full 2 for articles;
                    places 1 / 1 / 1). A cell stops earlier as soon as its relative standard error is at most --rse; the slow ones
                    (tens of ms and more per query) run the whole time
  --min-time S      the shortest a cell is measured in a round, seconds (default 0.25)
  --min-samples N   the fewest transactions of a cell in a round (default 3 for places, the number of clients for articles)
  --rounds MIN-MAX  rounds (default 2-3, regress 3-3): after MIN only the cells whose relative standard error is above --rse are measured
                    again, up to MAX. Three is the most there is: a MAX above 3 runs, with a warning. The standard error of a cell
                    combines the one of each round (batch means, order statistics) with the spread of the rounds
  --rse X           the relative standard error a cell is measured to in a round, and below which a cell is not measured again
                    (default 0.05; the cells that one more round cannot bring below it are not repeated)
  --ref REF         regress, setup: the git ref sift_ref is built from (default the tag SIFT_REF of bench/versions.env, v1.1.0)
  --run             regress: build and measure the engines and their references first
  --out DIR         result directory (default bench/out/run-<UTC time>, gitignored; `bench/out/latest` links
                    to the last one). report: where results.tsv / builds.tsv / tables.md are written
  --docs            report: also write bench/results/<dataset>.tsv (the committed chart input) and redraw docs/img
  --no-build        setup/all: use the engines already built under $SIFT_BENCH_ROOT
  --no-datasets     setup/all: do not download the datasets
  -h, --help        this text

report takes result directories as arguments: a run directory (default: bench/out/latest) or
DATASET:TIER:DIR for a raw tables directory of steps/articles.sh (articles) or steps/places.sh (places).

Output of run/all: a result directory with machine.txt, articles-<tier>/ and places-<tier>/ (raw cell tables: every round's
value), and results.tsv, builds.tsv and tables.md (value, standard error, rounds); the formats are in bench/README.md.

Environment
  SIFT_BENCH_ROOT   scratch, datasets, dumps and engine builds (default /tmp/sift-bench; 8-15 GB free; a fast
                    disk or tmpfs; clusters, builds and the throwaway databases are removed after each run)
  SIFT_SRC          head | worktree: sift is built from the last commit or the tracked files (default worktree)
  SIFT_REF          the git ref of sift_ref (default v1.1.0)
  BM25_PKG, BM25_SRC  pgx-bm25: the Arch package to unpack, or the source tarball to build (setup --engines bm25)
  JOBS              parallel jobs of the engine builds (default 4)
  CPU_QUOTA, MEM_MAX  the quota of an engine server (default 100% per CPU of its share) and its memory cap (32G), as a cgroup scope
                    when a systemd user session exists
  MINR, MAXR, RSE, SECS, WARM, CLIENTS, TIMEOUT, UPDATE_RATE, KEEP=1 (keep the cluster), Q_DOCS  see steps/articles.sh, steps/places.sh
  Pinned versions, dump dates and checksums: bench/versions.env

Examples
  bench/bench all                                     clean machine to tables, reduced scale, about 2 minutes of measurements
  bench/bench all --full                              the full-size run with the cold-cache tables, bench/results and charts
  bench/bench setup && bench/bench run --tier full --engines sift,pg_search,bm25
  bench/bench run --dataset places --tier ab --duration 4
  bench/bench run --dataset articles --engines gin,tantivy --classes and,or,update
  bench/bench report --docs --engines sift,sift_nopos,pg_search bench/out/latest
  bench/bench charts                                  redraw docs/img from bench/results
  bench/bench regress --run --ref v1.1.0              sift against the tag v1.1.0, exit 1 on a regression
  bench/bench check oracle sift 200
  bench/bench clean --all
EOF
}

die() { echo "bench: $*" >&2; exit 1; }

# --- options
tier=quick dataset=all engines='' classes='' workloads='' clients='' workers='' duration='' rounds='' out='' docs='' build=1 fetch_data=1 all_clean='' ref='' run='' cpus='' load_cpus=''
rest=()
parse() {
  while (( $# )); do
    case $1 in
      --tier) tier=$2; shift ;;
      --dataset|--datasets) dataset=$2; shift ;;
      --engines) engines=${2//,/ }; shift ;;
      --classes) classes=${2//,/ }; shift ;;
      --workloads) workloads=${2//,/ }; shift ;;
      --clients) clients=$2; shift ;;
      --workers) workers=$2; shift ;;
      --duration|--max-time) duration=$2; shift ;;
      --min-time) export MIN_TIME=$2; shift ;;
      --min-samples) export MIN_N=$2; shift ;;
      --rounds) rounds=$2; shift ;;
      --ref) ref=$2; shift ;;
      --run) run=1 ;;
      --cpus) cpus=$2; shift ;;
      --load-cpus) load_cpus=$2; shift ;;
      --serial) export SERIAL=1 ;;
      --rebuild) export NO_CACHE=1 ;;
      --sample) export SAMPLE=$2; shift ;;
      --rse) export RSE=$2; shift ;;
      --out) out=$2; shift ;;
      --docs) docs=1 ;;
      --no-build) build= ;;
      --no-datasets) fetch_data= ;;
      --all) all_clean=1 ;;
      --full) tier=full ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown option $1 (bench/bench --help)" ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
  case $tier in quick|ab|full) ;; *) die "unknown tier $tier (quick, ab or full)" ;; esac
  case $dataset in articles|places|all) ;; *) die "unknown dataset $dataset" ;; esac
  [[ -z $ref ]] || export SIFT_REF=$ref
  [[ $dataset == all ]] && datasets="articles places" || datasets=$dataset
}

ARTICLE_CLASSES="and or phrase mixed count filter join term prefix fuzzy update"
PLACE_CLASSES="p1 p2 p3 p4 w1 a2 a2s a3 x2"
class_set() { # DATASET: the --classes that belong to the dataset
  local c set=$ARTICLE_CLASSES
  [[ $1 == places ]] && set=$PLACE_CLASSES
  for c in $classes; do [[ " $set " == *" $c "* ]] && printf '%s ' "$c"; done
  return 0
}
check_classes() {
  local c d keep=''
  for c in $classes; do [[ " $ARTICLE_CLASSES $PLACE_CLASSES " == *" $c "* ]] || die "unknown class $c (articles: $ARTICLE_CLASSES; places: $PLACE_CLASSES)"; done
  [[ -n $classes ]] || return 0
  for d in $datasets; do [[ -z $(class_set "$d") ]] || keep+="$d "; done   # a dataset none of whose classes were named is not run
  datasets=${keep% }
  [[ -n $datasets ]] || die "none of the classes ($classes) belongs to the dataset $dataset"
}

# --- tiers and engines (ALL_ENGINES, DEFAULT_ENGINES come from engines.tsv through steps/lib.sh)
tier_env() {
  step_mode=quick
  case $tier in
    quick) export Q_DOCS=25000 MINR=${MINR:-2} MAXR=${MAXR:-2} SECS=${SECS:-1} WARM=${WARM:-1} ;;
    ab) ;;
    full) step_mode=full ;;
  esac
  [[ -z $rounds ]] || { export MINR=${rounds%-*} MAXR=${rounds#*-}; }
  [[ -z $duration ]] || export SECS=$duration
  [[ -z $clients ]] || export CLIENTS=$clients
  [[ -z $workers ]] || export WORKERS=$workers THREADS=$workers
  [[ -z $workloads ]] || export WLS=$workloads
  budget
  case $tier in full) export TIER=F ;; *) export TIER=Q ;; esac
}
engine_default=DEFAULT_ENGINES   # the lib.sh list `selected` falls back to: DEFAULT_ENGINES, SUITE_ENGINES (suite), PAIR_ENGINES (regress)
budget() { # the CPU budget: CPUS and LOAD_CPUS from the options, the environment or the machine as it is now
  [[ -z $cpus ]] || CPUS=$cpus
  [[ -z $load_cpus ]] || LOAD_CPUS=$load_cpus
  if [[ -z ${CPUS:-} || -z ${LOAD_CPUS:-} ]]; then
    local picked; picked=$("$STEPS/cpus.sh")
    CPUS=${CPUS:-${picked% *}} LOAD_CPUS=${LOAD_CPUS:-${picked#* }}
  fi
  export CPUS LOAD_CPUS
  echo "cpu budget: servers on CPUs $CPUS, load generators on CPUs $LOAD_CPUS${SERIAL:+ (serial: one cluster)}"
}
perf_lock() { # one run at a time on the machine: the sessions of a run time their cells on purpose together, so the run holds the lock
  [[ -z ${PERF_LOCK_HELD:-} ]] || return 0
  exec 8>>/tmp/sift-perf.lock
  flock -n 8 || { echo "waiting for the perf lock (another benchmark is timing)"; flock 8; }
  export PERF_LOCK_HELD=1
}
selected() { # the engines of --engines (default: those with default = yes)
  local e
  for e in ${engines:-${!engine_default}}; do
    [[ " $ALL_ENGINES " == *" $e "* ]] || die "unknown engine $e (bench/engines.tsv: $ALL_ENGINES)"
    printf '%s ' "$e"
  done
}

# --- prerequisites, checked before anything is downloaded or built
preflight() {
  local missing=() c x
  for c in pg_config gcc make python3 curl bzip2 unzip ar tar flock awk; do command -v "$c" >/dev/null || missing+=("$c"); done
  if command -v pg_config >/dev/null; then
    PATH=$(pg_config --bindir):$PATH
    for c in psql pgbench initdb pg_ctl pg_dump pg_restore; do command -v "$c" >/dev/null || missing+=("$c"); done
    [[ -f $(pg_config --pgxs) ]] || missing+=("PostgreSQL server development files (pgxs.mk)")
    for x in pg_stat_statements pg_prewarm pg_buffercache; do [[ -f $(pg_config --sharedir)/extension/$x.control ]] || missing+=("contrib module $x"); done
  fi
  (( ${#missing[@]} == 0 )) || die "missing prerequisites: ${missing[*]}"
  export PATH
  . "$STEPS/lib.sh"
  [[ $(pg_config --version | grep -oP '\d+' | head -1) == "$PG_MAJOR" ]] || die "PostgreSQL $PG_MAJOR is required, pg_config is $(pg_config --version)"
  mkdir -p "$ROOT"
  local need free
  need=$([[ $tier == full ]] && echo 15 || echo 8)
  free=$(( $(df -Pk "$ROOT" | awk 'NR == 2 {print $4}') / 1048576 ))
  (( free >= need )) || echo "warning: only $free GiB free under $ROOT (SIFT_BENCH_ROOT), $need GiB recommended" >&2
}

fetch_targets() { # the steps/fetch.sh targets of the engines: the variants of sift are one build, gin is built in
  local e
  for e in "$@"; do
    case $e in
      sift|sift_nopos) echo sift ;;
      sift_ref) echo sift_ref ;;
      gin) ;;
      *) echo "$e" ;;
    esac
  done | awk '!seen[$0]++'
}

cmd_setup() {
  preflight
  if [[ $fetch_data ]]; then "$HERE/datasets/fetch.sh" "$dataset"; fi
  [[ $build ]] || return 0
  # Without network or a toolchain the system's copy of an engine is used when installed (machine.txt says which).
  local t
  # shellcheck disable=SC2046  # one argument per engine
  for t in $(fetch_targets $(selected)); do
    [[ $t != sift ]] || echo "building sift ($(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo 'no git'))"
    "$STEPS/fetch.sh" "$t" || { echo "warning: $t could not be built or fetched; using the system's if installed" >&2; [[ $t == sift ]] || rm -rf "${ENG:?}/$t/root"; }
  done
}

ready() { # the datasets are present
  local d
  for d in $datasets; do
    case $d in
      articles) [[ -f $DATA/articles.tsv ]] ;;
      places) [[ -f $DATA/places-$([[ $tier == full ]] && echo full || echo quick)/places.tsv ]] ;;
    esac || die "the $d dataset is missing under $DATA: run bench/bench setup"
  done
}

new_out() {
  OUT=${out:-$HERE/out/run-$(date -u +%Y%m%dT%H%M%SZ)}
  mkdir -p "$OUT" "$HERE/out"
  OUT=$(cd "$OUT" && pwd)
  ln -sfn "$OUT" "$HERE/out/latest"
  exec > >(tee -a "$OUT/bench.log") 2>&1
}

measure() { # [cold]: every selected dataset at the tier into $OUT, after the machine description
  local d t0=$SECONDS suffix=${1:+-cold} e
  perf_lock
  [[ -n ${1:-} && -s $OUT/machine.txt ]] || "$STEPS/machine.sh" >"$OUT/machine.txt"
  e=$(selected)
  for d in $datasets; do
    echo; echo "=== $d, tier $tier${1:+, cold cache} ($(( SECONDS - t0 )) s)"
    case $d in
      articles) ENGINES=$e CLASSES=$(class_set articles) DEST=$OUT/articles-$tier$suffix "$STEPS/articles.sh" ${1:+cold} "$step_mode" ;;
      places)   ENGINES=$e CLASSES=$(class_set places) DEST=$OUT/places-$tier$suffix "$STEPS/places.sh" "$step_mode" ${1:+cold} ;;
    esac
  done
  echo "wall time of the measurements $(( SECONDS - t0 )) s, load average at end $(cut -d' ' -f1-3 /proc/loadavg)" | tee -a "$OUT/machine.txt"
}

cmd_run() { # [cold]
  check_classes; preflight; ready; tier_env; new_out
  measure "$@"
  echo "results: $OUT"
  rest=("$OUT"); cmd_report
}

cmd_report() {
  command -v python3 >/dev/null || die "python3 is required"
  local specs=() arg d dir
  set -- "${rest[@]}"
  (( $# )) || set -- "$HERE/out/latest"
  for arg in "$@"; do
    if [[ $arg == *:*:* ]]; then specs+=("$arg"); continue; fi
    [[ -d $arg ]] || die "no such result directory: $arg"
    dir=$(cd "$arg" && pwd)
    [[ -n $out ]] || out=$dir
    for d in "$dir"/articles-* "$dir"/places-*; do
      [[ -f $d/cells.tsv || -f $d/cold.tsv ]] || continue
      specs+=("$(basename "$d" | sed -E 's/^([a-z]+)-(.*)$/\1:\2/'):$d")
    done
  done
  (( ${#specs[@]} )) || die "no results to report"
  [[ -n $out ]] || die "report with DATASET:TIER:DIR arguments needs --out DIR"
  local args=("$out")
  [[ -z $engines ]] || args+=(--engines "${engines// /,}")
  [[ -z $docs ]] || args+=(--per-dataset "$REPO/bench/results")
  python3 -I "$STEPS/tables.py" "${args[@]}" "${specs[@]}"
  echo; echo "written: $out/{results.tsv,builds.tsv,tables.md}${docs:+ and $REPO/bench/results/}"
  [[ -z $docs ]] || cmd_charts
}

cmd_charts() {
  command -v python3 >/dev/null || die "python3 is required"
  python3 -I "$STEPS/charts.py" --results "$REPO/bench/results" --out "$REPO/docs/img"
}

cmd_all() {
  local t0=$SECONDS
  check_classes
  new_out
  echo "=== setup"; cmd_setup
  ready; tier_env
  measure
  if [[ $tier != quick ]]; then measure cold; docs=1; fi   # the published tiers: cold-cache tables, bench/results and the charts too
  echo "=== report"; rest=("$OUT"); cmd_report
  echo "bench all --tier $tier: wall time $(( SECONDS - t0 )) s" | tee -a "$OUT/machine.txt"
}

cmd_regress() { # [--run] [DIR|results.tsv ...]
  local files=() arg rc=0
  if [[ $run ]]; then
    # the reduced matrix: sift against its reference on both datasets, the classes and workloads a change to the index or the scan
    # touches (--engines adds sift_nopos; --classes and --workloads widen it)
    [[ -n $engines ]] || engines="sift sift_ref"
    [[ -n $classes ]] || classes="and or phrase count filter join p1 p3 w1 a3"
    [[ -n $workloads ]] || workloads="top boost"
    [[ -n $rounds ]] || rounds=3-3   # three rounds, the most the harness runs by default: a 5% difference is told from the noise by the standard errors of the cells
    check_classes; preflight; ready; tier_env
    "$STEPS/fetch.sh" sift
    local sel; sel=" $(selected)"
    [[ $sel != *" sift_ref "* ]] || [[ $(cut -d' ' -f1 "$ENG/sift_ref/root/.build-info" 2>/dev/null) == "$SIFT_REF" ]] || "$STEPS/fetch.sh" sift_ref
    new_out
    measure
    rest=("$OUT"); cmd_report >/dev/null
    files=("$OUT/results.tsv")
  else
    set -- "${rest[@]}"
    (( $# )) || set -- "$HERE/out/latest"
    for arg in "$@"; do
      if [[ -d $arg ]]; then
        [[ -f $arg/results.tsv ]] || { rest=("$arg"); cmd_report >/dev/null; }
        files+=("$arg/results.tsv")
      else files+=("$arg"); fi
    done
  fi
  python3 -I "$STEPS/regress.py" "${files[@]}" || rc=$?
  return $rc
}

cluster_up() { # the tier's cluster with the `bench` corpus, left running (bench clean stops it)
  preflight; ready; tier_env
  "$STEPS/corpus.sh" ensure >/dev/null
}

cmd_check() {
  if [[ $dataset == places ]]; then
    [[ ${rest[0]:-} != [0-9]* ]] || rest=('' "${rest[@]}")   # check --dataset places N: both checks
    case ${rest[0]:-} in oracle|rank|'') ;; *) die "usage: check --dataset places [oracle|rank] [N]" ;; esac
    datasets=places; preflight; ready; tier_env
    ENGINES=$(selected) DEST=$HERE/out/places-check-$tier "$STEPS/places.sh" "$step_mode" check "${rest[0]:-all}" "${rest[1]:-}"
    return
  fi
  local what=${rest[0]:-} engine=${rest[1]:-} n=${rest[2]:-}
  [[ -n $engine ]] || die "usage: check oracle|rank ENGINE [N]"
  datasets=articles; cluster_up
  case $what in
    oracle) "$STEPS/oracle.sh" "$engine" "$n" ;;
    rank) "$STEPS/rank_check.sh" "$engine" "$n" ;;
    *) die "check oracle|rank ENGINE [N]" ;;
  esac
}

cmd_suite() { # the standard suite: run on articles over the named engines (default every engine but the references)
  dataset=articles datasets=articles
  engines=${engines:-${rest[*]}}; engine_default=SUITE_ENGINES
  [[ -n $classes ]] || classes="term and or phrase prefix fuzzy count mixed"
  rest=(); cmd_run
}

cmd_workload() { # ENGINE [CLASS...]
  [[ -n ${rest[0]:-} ]] || die "usage: workload ENGINE [CLASS...]"
  dataset=articles datasets=articles engines=${rest[0]}
  [[ -n $classes ]] || classes=${rest[*]:1}
  [[ -n $classes ]] || classes="and or phrase mixed count filter join update"
  [[ -n $duration ]] || duration=30
  [[ -n $rounds ]] || rounds=1-1
  export RSE=${RSE:-0}   # a timed run: every cell takes the whole duration
  rest=(); cmd_run
}

cmd_workers() { datasets=articles; cluster_up; "$STEPS/build.sh" "${rest[@]}"; }

cmd_clean() {
  . "$STEPS/lib.sh"
  local t
  for t in Q F; do TIER=$t "$STEPS/cluster.sh" destroy 2>/dev/null || true; done
  rm -rf "$ROOT/pg" "$ROOT/articles" "$ROOT/places" "$ROOT/run" "$ROOT/build"
  [[ -z $all_clean ]] || rm -rf "$ROOT/data" "$ROOT/cache" "$ROOT/download" "$ENG" "$ROOT/target"
  echo "removed scratch under $ROOT${all_clean:+ including datasets, dumps and engine builds}"
}

cmd=${1:-}
[[ -n $cmd ]] || { usage; exit 1; }
shift || true
case $cmd in -h|--help|help) usage; exit 0 ;; esac
parse "$@"
case $cmd in
  setup) cmd_setup ;;
  run) cmd_run ;;
  cold) cmd_run cold ;;
  report) cmd_report ;;
  charts) cmd_charts ;;
  all) cmd_all ;;
  regress) cmd_regress ;;
  check) cmd_check ;;
  suite) cmd_suite ;;
  workload) cmd_workload ;;
  workers) cmd_workers ;;
  remote) "$STEPS/remote.sh" "${rest[@]}" ;;
  machine) "$STEPS/machine.sh" ;;
  clean) cmd_clean ;;
  *) echo "bench: unknown command $cmd" >&2; usage; exit 1 ;;
esac
