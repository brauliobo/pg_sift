# Maintainer: Braulio Oliveira <brauliobo@gmail.com>
# Release package: builds the tag v$pkgver. Before publishing, replace OWNER in url and source with the
# GitHub account that hosts the repository and push the tag. To package the committed HEAD of this
# checkout instead, run: cd packaging && makepkg -p PKGBUILD.local -f
pkgname=sift-pg
pkgver=1.0.0
pkgrel=1
pkgdesc='CTID-bitmap full-text search index with BM25 ranking for PostgreSQL'
arch=('x86_64')
url='https://github.com/OWNER/sift'
license=('PostgreSQL')
depends=('postgresql>=18' 'postgresql<19')
makedepends=('git' 'make' 'gcc')
checkdepends=('perl-ipc-run' 'python')
source=("sift::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd sift
  make
}

# The quick tier builds a test flavor of the library in its own tree; run it on a copy so package() installs the
# release build.
check() {
  cp -a sift sift-check
  cd sift-check
  SIFT_CI_TMP="$srcdir/ci" make check
}

package() {
  cd sift
  make DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE NOTICE
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md docs/*.md
}
