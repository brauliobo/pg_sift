# Builds the committed HEAD of the enclosing pg_sift checkout (uncommitted changes are not packaged):
#   cd packaging && makepkg -p PKGBUILD.local -f
# makepkg rewrites pkgver below from the commit count and hash; the committed value is a placeholder.
pkgname=pg_sift
pkgver=1.0.r0
pkgrel=1
pkgdesc='CTID-bitmap full-text search index with BM25 ranking for PostgreSQL'
arch=('x86_64')
license=('PostgreSQL')
depends=('postgresql>=18' 'postgresql<19' 'lz4' 'zstd')
makedepends=('git' 'make' 'gcc')
source=("pg_sift::git+file://${startdir%/packaging}")
sha256sums=('SKIP')

pkgver() {
  cd pg_sift
  printf '1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd pg_sift
  nice make -j4 SIFT_LTO=1
}

package() {
  cd pg_sift
  make SIFT_LTO=1 DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE NOTICE
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md DESIGN.md docs/*.md
}
