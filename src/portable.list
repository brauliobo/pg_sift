# The portable core: the files of src/ that every host compiles (PostgreSQL, SQLite, ...). They include the C library,
# compiler intrinsics, sift_*.h headers of this list and sift_host.h, and nothing else: scripts/check-portable.sh enforces it
# (CI, both jobs), sqlite/Makefile builds the .c files of this list into the SQLite extension. Add a file here when it
# needs no host API beyond src/core/sift_host.h; a file that needs more belongs to a host (src/ for PostgreSQL, sqlite/).
#
# sources
bm25/sift_bitmap.c
bm25/sift_bitmap_scalar.c
bm25/sift_bitmap_avx2.c
bm25/sift_bitmap_avx512.c
bm25/sift_kernels.c
bm25/sift_kernels_avx2.c
bm25/sift_kernels_avx512.c
bm25/sift_analyze.c
bm25/sift_analyze_stem.c
bm25/sift_query.c
bm25/sift_posting.c
bm25/sift_dict.c
bm25/sift_segment.c
core/sift_live.c
bm25/sift_runs.c
core/sift_stream.c
bm25/sift_merge.c
bm25/sift_prefix.c
core/sift_filter.c
bm25/sift_eval.c
bm25/sift_parallel.c
core/sift_cpu.c
core/sift_span.c
