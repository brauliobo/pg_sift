# The portable files of the sift_col track (the shredder, docs/COL-SHRED.md; the chunk and unit encoding, docs/COL.md; the chunk codec, docs/COL-CODEC.md): the same rule as portable.list (C library, intrinsics,
# sift_host.h and files of the lists; scripts/check-portable.sh enforces it) but not compiled by the SQLite and MariaDB hosts yet,
# which build portable.list only. Move a file to portable.list when a host needs it.
#
# sources
sift_col_enc.c
sift_colcodec.c
sift_colcodec_kern.c
sift_colcodec_avx2.c
sift_colcodec_avx512.c
sift_shred.c
sift_shred_kern.c
sift_shred_kern_avx2.c
sift_shred_kern_avx512.c
# headers
sift_shred.h
sift_col.h
sift_col_enc.h
sift_colcodec.h
sift_colcodec_int.h
sift_colcodec_vec.h
sift_colz.h
