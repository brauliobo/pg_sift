#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * vk_ht_compact.comp - the finish of a hash job, by what the host asks (pc0):
 *   0  writes the ready slots of the hash table one after the other (without the state word) into the result buffer, so that the host reads back the groups there are and not the slots of the
 *      table. One atomic counter update per subgroup. The counts the fast kernels leave out (J_CNT_ROWS) are the rows of the group: written here.
 *   1  COUNT(DISTINCT x): the table holds the pairs (group keys, x), its last key the value; counts the slots whose value is not NULL, in RES_NCOMP.
 *   2  the same per group: out64[g] is the number of such slots of the group g in its low 40 bits, and 1 << 40 for each slot whose value is NULL, so that a group with no value still has a word that is not 0;
 *      g is a dense number of the group keys (pc1 of them, the spans and the least values of the job), the digits as the dense kernels count them and the slot of a NULL key last.
 */
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "common_decode.glsl"
#include "common_compact.glsl"

layout(local_size_x = 256) in;

uint dense_group(uint s, uint ngk)
{
	uint b = s * ctl[J_HT_STRIDE], g = 0u;

	for (uint j = 0u; j < ngk; j++)
	{
		uint span = ctl[J_DENSE_SPAN + j];
		int64_t kmin = int64_t(u64of(ctl[J_DENSE_KMIN + 2u * j], ctl[J_DENSE_KMIN + 2u * j + 1u]));
		uint d = key_null(s, j) ? span - 1u : uint(ht[b + 1u + j] - kmin);

		g = g * span + d;
	}
	return g;
}

void main()
{
	uint mode = pc0, mask = ctl[J_HT_MASK], stride = ctl[J_HT_STRIDE];
	uint nslots = mask + 1u, total = gl_NumWorkGroups.x * 256u, rounds = (nslots + total - 1u) / total;
	uint gid = gl_GlobalInvocationID.x, nk = ctl[J_NKEYS];

	for (uint it = 0u; it < rounds; it++)
	{
		uint s = gid + it * total;
		bool ready = s < nslots && ht[s * stride] < 0l;

		if (mode == 2u)
		{
			if (ready)
				atomicAdd(out64[dense_group(s, pc1)], key_null(s, nk - 1u) ? (1l << 40) : 1l);
			continue;
		}
		if (mode == 1u)
			ready = ready && !key_null(s, nk - 1u);
		uvec4 bal = subgroupBallot(ready);
		uint cnt = subgroupBallotBitCount(bal), before = subgroupBallotExclusiveBitCount(bal);
		uint first = 0u;

		if (subgroupElect() && cnt != 0u)
			first = uint(atomicAdd(res[RES_NCOMP], int64_t(cnt)));
		first = subgroupBroadcastFirst(first);
		if (ready && mode == 0u)
			write_group(s, (first + before) * (stride - 1u));
	}
}
