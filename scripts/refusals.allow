# The functions of src/agg/plan*.c and spec*.c whose `return false` names no refusal (scripts/gen-refusals.sh checks it).
# Format: file.c: function function # reason. False in these means "not this shape", "keep walking" or "this try does not apply", and the caller that
# gives the arm up names the refusal. A reason recorded in a try would be the first of the arm and would hide the one that follows it (the arm keeps
# the first reason it gets), so a try never names one.

plan.c: member_source reads_overflow reads_json_null_cast groupClause_has_nonconst has_agg_path missing_column_walker # predicates of the shape and the mid-way tries of agg_base, and the walker that finds the column a where refusal names: the sites that give the arm up name the slug
plan_agg.c: compile_combo_key compile_key unique_row_column compile_vx compile_ordered same_sorted_input mapped_pg_agg compile_mapped count_rows_kind compile_int8_agg leaf_agg_kind compile_leaf_agg compile_native_agg compile_agg # tries of compile_agg (native, mapped, ordered, generic in turn): compile_agg and its caller name the aggregate
plan_child.c: derived_column_walker bare_read_walker planned_child first_key_ok first_filter_bad first_order correlated_child scoped_child ancestor_param_walker # tries of the lookup child: the caller of planned_correlated_child names join_child
plan_combo.c: table_key_expr join_clause combo_walker nonzero_const func_may_raise may_raise_walker join_expr_clause combo_slot_in # tries of the join key and of the combo slot: setup_joins and the callers name the join condition or the expression
plan_cost.c: real_cost_walker lookup_counted pred_uses_leaf leaf_read_whole extern_param_walker rel_has_param_qual join_index_usable leaf_filtered # predicates of the cost model and the walkers it uses: no refusal
plan_exists.c: exists_scan dep_walker out_walker # shape tests of the EXISTS rewrite: the caller names from_shape or where
plan_expr.c: outer_ref_walker subplan_runs_at_start array_initplan_ok leaf_walker single_leaf safe_int_divisor raising_walker leaf_stats_range utc_name is_num_cast is_utc_conversion cal_unit cal_part cal_ptype_walker cal_tree nx_put nx_leaf nx_const nx_walk compile_int8_arith nx_raises calendar_units_walker # walkers and tests of an expression the scan evaluates (the calendar ones classify it for the cells of a unit: sift_aggexpr_cal returns SAC_NOT, SAC_ZONE or SAC_FINE): the caller names group_key, aggregate, where or output_expr
plan_from.c: right_only scan_preserved scan_semi_tree exec_param_walker mentions_key hash_clause_handled part_prune_clauses find_source text_io_leaf recordset_recheck_ok unconditional leaf_read count_leaf_reads others_first filtered_reads pred_reads_leaf member_casts pred_reads_any pred_reads_set list_read_by_tuple_tests # tests of the FROM list (outer joins are tried both ways round) and of a recordset: the caller names from_shape or outer_join
plan_gen.c: gen_leaf_ok gen_walker arg_joined compile_gen_arg gen_parallel_ok gen_eligible compile_gen # tests of a generic aggregate and its argument: compile_gen names the aggregate
plan_join.c: reads_outer index_qual preserved_join lookup_ready order_inner_lookups child_cols_kept pushed_into_child null_row_passes column_equality array_keys # tests of one join condition or lookup (each is tried in turn): setup_joins names join_condition
plan_leaf.c: has_exec_param_walker paths_equal path_keys json_access reads_preserved_only reads_full_lookup # tests of a jsonb path and of the side of a join an expression reads: the caller names the slug
plan_path.c: jsonb_lit path_lit # tests of a jsonpath literal: the caller names where
plan_pred.c: false_on_absent # a test of a compiled predicate: no refusal
plan_rows.c: pg_aggregate_ok # a test of an aggregate of the rows plan: the caller names rows_shape
plan_two.c: append_arms same_scan cond_split outer_cond arm_gates arm_having_expr count_aggs_walker outer_agg spine_key two_keys two_aggs spine_where two_from spine_type spine_eq spine_conjunct two_spine # steps of the two-level shape: two_level names two_arms, two_keys, two_aggs or spine_shape
plan_type.c: typeof_cmp_operands typeof_test wide_test types_guard_reads # tests of a jsonb_typeof or wide comparison: the caller names where
plan_zone.c: array_consts zone_range zone_meets zone_may # zone pruning tests: a unit that cannot be pruned is read, no refusal
spec.c: sift_aggspec_spillable sift_parse_decimal sift_aggspec_zone_cmp str_const str_cmp_test str_in_test sift_aggspec_str_test plain_agg # tests of a compiled spec (parallel workers, string tests): a scan that cannot use workers or a kernel is not a refusal
spec_fuse.c: combo_same fuse_join fuse_combo fuse_fslots fuse_posts runs_plan pred_runs_plan fuse_aggs routable fuse_split fuse_leaves fuse_children fuse_build fuse_key_slots fuse_candidate sift_aggspec_fusable # fusing the arms of a spec: arms that do not fuse run as separate scans, no refusal
spec_preagg.c: plain_leaf pa_pres sift_pawhy_fixable add_leaf pred_dims in_leaves rows_zone_bound cal_pred cal_tests # pre-aggregate decisions: a miss is counted by sift.col_rollup_misses, no refusal
plan_order.c: topn_unique_key # a test of the join table's indexes: topn_joins_ok names topn_shape
plan_order.c: topn_bounds # an early guard of topn_paths: a query without a usable LIMIT is no top-N candidate, so no arm is open to refuse
plan_order.c: topn_num_type topn_in_leaf_ok topn_expr_walker topn_key # type tests and the walker of a sort expression (its reason is kept in the walk): topn_paths names topn_shape with it
