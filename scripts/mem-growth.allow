double	col/f2/col_delta/srv.c	c->entries = repalloc(c->entries, c->cap * sizeof(CdCacheEntry));	bounded: one entry for each part of the relation the statement remaps, in the memory of the statement
double	col/f2/scope/over.c	p->s = repalloc(p->s, (p->cap = Max(p->cap * 2, 16)) * sizeof(SiftF2ScopeSlot));	bounded: one slot for each part with granules that a scope overlay of one statement names, the parts of the manifest of one relation
double	col/f2/l0/stage.c	st->parts = st->parts ? repalloc(st->parts, st->cap_parts * sizeof(SiftStagePart)) : palloc(st->cap_parts * sizeof(SiftStagePart));	bounded: one record for each partition the transaction stages rows for, in the memory of the transaction
double	col/f2/del/pend.c	blks = repalloc(blks, cap * sizeof(BlockNumber));	bounded: the pages of the pending buffer of one partition, which a fold into deletion vectors ends at SIFT_PEND_DEL_FOLD_PAGES
double	col/f2/del/pend.c	chunk = repalloc(chunk, cap * sizeof(SiftPendDelRec *));	bounded: the pages of the pending buffer of one partition, which a fold into deletion vectors ends at SIFT_PEND_DEL_FOLD_PAGES
double	col/f2/del/pend.c	nrecs = repalloc(nrecs, cap * sizeof(int));	bounded: the pages of the pending buffer of one partition, which a fold into deletion vectors ends at SIFT_PEND_DEL_FOLD_PAGES
double	col/f2/cube/refresh.c	c->v = repalloc(c->v, sizeof(SiftScopeMemberKey) * (c->cap *= 2));	bounded: one entry for each changed member (at most REFRESH_MEMBERS_MAX) and each key of the roots or of its pairs
double	col/f2/del/delete.c	mk->v = mk->v ? repalloc(mk->v, mk->cap * sizeof(SiftDvMark)) : MemoryContextAlloc(mk->cx, mk->cap * sizeof(SiftDvMark));	bounded: the marks of a part are at most the delete records of one call, which the caller cuts at a quarter of the maintenance budget (DeadList.max in col/f2/write.c)
double	agg/group/rows.c	rs->pending = rs->pending ? repalloc(rs->pending, rs->cap * sizeof(RowFile)) : palloc(rs->cap * sizeof(RowFile));	bounded: the spill files still to run, ROW_PARTS of each level of the recursion; a level splits its rows by PART_BITS of the hash, so the depth is the logarithm of the groups, a few dozen entries
double	col/f2/uniq/shm.c	owned = repalloc(owned, sizeof(Owned) * (capowned *= 2));	open: one entry for each unique key a transaction holds (the check of a deferred UNIQUE constraint): no limit but the 1 GB of one allocation, about 44 million keys in one transaction; it needs a budget of the tracker, not a huge allocation
