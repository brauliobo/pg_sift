# RULE	FILE	THE LINE	WHAT BOUNDS IT -- 'bounded:' was read at the site, 'open:' is a growth that nothing bounds by a setting (the 5.0.1 memory audit lists it).
double	agg/combo/ents.c	cs->dir = cs->dir ? repalloc(cs->dir, (size_t) cap * sizeof(uint32)) : MemoryContextAlloc(cs->cxt, (size_t) cap * sizeof(uint32));	open: the directory of the combinations of one statement: one per distinct combination, no limit but the group table check
double	agg/combo/ids.c	t->hv = repalloc(t->hv, t->cap * sizeof(uint32));	open: ids of the strings of one combination: one per distinct string, no limit but the group table check
double	agg/combo/ids.c	t->len = repalloc(t->len, t->cap * sizeof(uint32));	open: ids of the strings of one combination: one per distinct string, no limit but the group table check
double	agg/combo/ids.c	t->ptr = repalloc(t->ptr, t->cap * sizeof(char *));	open: ids of the strings of one combination: one per distinct string, no limit but the group table check
double	agg/leaf.c	t->hv = repalloc(t->hv, t->cap * sizeof(uint32));	bounded: the table of a count(DISTINCT) is held to hash memory (values_nospill_check ends the scan past it and the statement runs again as PostgreSQL plans it); a statement that cannot run again keeps its values
double	agg/leaf.c	t->val = repalloc(t->val, t->cap * sizeof(Datum));	bounded: the table of a count(DISTINCT) is held to hash memory (values_nospill_check ends the scan past it and the statement runs again as PostgreSQL plans it); a statement that cannot run again keeps its values
double	agg/lookclass.c	s->buf = s->buf ? repalloc(s->buf, s->cap) : MemoryContextAlloc(s->cxt, s->cap);	bounded: the bytes of the classes of one lookup table, under sift.agg_lookup_kb
double	agg/lookcol.c	kp->pair = kp->pair ? repalloc(kp->pair, (kp->cap *= 2) * sizeof(SiftScopePair)) : palloc((kp->cap = 1024) * sizeof(SiftScopePair));	bounded: pairs of one lookup, under sift.agg_lookup_kb
double	agg/lookup/map.c	mc->hv = repalloc(mc->hv, mc->cap * sizeof(uint32));	bounded: the values of one lookup table, under sift.agg_lookup_kb
double	agg/lookup/map.c	mc->val = repalloc(mc->val, mc->cap * sizeof(Datum));	bounded: the values of one lookup table, under sift.agg_lookup_kb
double	agg/pred_cal.c	out = repalloc(out, (cap *= 2) * sizeof(int64));	bounded: values of one IN list or predicate of the statement
double	agg/stub_dec.c	d->bytes = repalloc(d->bytes, d->bcap *= 2);	open: the decoded dictionary of one source leaf, with the distinct values of the leaf: no limit but the segment's own size
double	agg/stub_dec.c	d->off = repalloc(d->off, sizeof(uint32) * ((d->cap *= 2) + 1));	open: the decoded dictionary of one source leaf, with the distinct values of the leaf: no limit but the segment's own size
double	agg/stub_src.c	src->rowkey = repalloc(src->rowkey, sizeof(SiftKey) * src->cap);	bounded: the rows of one unit of the source (a unit is at most SIFT_COL_UNIT_ROWS rows)
double	agg/stub_src.c	u->nulls = repalloc(u->nulls, sizeof(bool) * natts * src->cap);	bounded: the rows of one unit of the source (a unit is at most SIFT_COL_UNIT_ROWS rows)
double	agg/stub_src.c	u->vals = repalloc(u->vals, sizeof(Datum) * natts * src->cap);	bounded: the rows of one unit of the source (a unit is at most SIFT_COL_UNIT_ROWS rows)
double	agg/topn/unit.c	t->mem = repalloc(t->mem, t->capmem * t->stride * sizeof(int64));	bounded: at most topn_rows (100,000) rows of stride int64 words
double	agg/two.c	a->cid = repalloc(a->cid, (Size) a->ccap * a->nlk * sizeof(uint32));	open: cells of a two-level aggregate: one per distinct inner key tuple, no limit but the group table check
double	agg/wide.c	w->bytes = repalloc(w->bytes, w->bcap);	open: wide values (numeric, text over 8 bytes) of one aggregate, one per distinct value: no limit but the group table check
double	agg/wide.c	w->key = repalloc(w->key, w->dcap * 3 * sizeof(uint64));	open: wide values (numeric, text over 8 bytes) of one aggregate, one per distinct value: no limit but the group table check
double	agg/wide.c	w->off = repalloc(w->off, (w->dcap + 1) * sizeof(uint32));	open: wide values (numeric, text over 8 bytes) of one aggregate, one per distinct value: no limit but the group table check
double	bm25/step.c	pk->buf = repalloc(pk->buf, pk->cap = size * 2);	bounded: the size of one posting block of a cursor
double	col/f2/f2_build.c	bs->ended = bs->ended != NULL ? repalloc(bs->ended, bs->capended * sizeof(SiftPendDelRec)) : MemoryContextAlloc(bs->cx, bs->capended * sizeof(SiftPendDelRec));	bounded: one record for each row of the run that the heap has deleted, charged to the memory of the run (maintenance_work_mem), which writes the part and the deletes when it is full
double	col/f2/pend_del.c	out = repalloc(out, cap * sizeof(SiftPendDelRec));	bounded: the pending buffer of a partition is folded into deletion vectors at SIFT_PEND_DEL_FOLD_PAGES pages
double	col/skip/build.c	b->s = b->s ? repalloc(b->s, b->cap * sizeof(Stream *)) : palloc(b->cap * sizeof(Stream *));	bounded: one stream per column and kind of one part, at most two for each column of the schema
double	col/skip/join.c	keys = repalloc(keys, (capk *= 2) * sizeof(JoinKey));	bounded: one key per column and kind of the parts joined, at most five for each column of the schema
double	col/v1/dict/dict.c	d->off = repalloc(d->off, (d->cap + 1) * sizeof(uint32));	open: the entries of a dictionary under construction: segment writer, owned by the lane build-memory
double	col/v1/scan/scope.c	ps->p = ps->p ? repalloc(ps->p, ps->cap * sizeof(SiftScopePair)) : palloc(ps->cap * sizeof(SiftScopePair));	bounded: pairs of one scope read, under work_mem (sift_budget_check) in the caller
double	col/v1/scan/scope_delta.c	o->row = repalloc(o->row, o->cap * sizeof(DeltaRow));	bounded: rows of the changed keys of one scope delta, under sift.col_scope_refresh_pct
double	col/v1/scan/scope_segrows.c	bids = bids ? repalloc(bids, cap * sizeof(int64 *)) : palloc(cap * sizeof(int64 *));	bounded: batches of one scope segment read
double	col/v1/scan/scope_segrows.c	bs = bs ? repalloc(bs, cap * sizeof(SiftColBatch *)) : palloc(cap * sizeof(SiftColBatch *));	bounded: batches of one scope segment read
double	col/v1/scope_paid.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: the same array as the lifetime row of this file
double	col/v1/seg_write/groups.c	g->gfirst = repalloc(g->gfirst, g->cap * sizeof(uint32));	open: the group arrays of the segment writer: the lane build-memory (src/col/build, seg_write) owns them
double	col/v1/seg_write/groups.c	g->gn = repalloc(g->gn, g->cap * sizeof(uint32));	open: the group arrays of the segment writer: the lane build-memory (src/col/build, seg_write) owns them
double	col/v1/seg_write/groups.c	g->xsplit = repalloc(g->xsplit, g->cap * sizeof(uint64));	open: the group arrays of the segment writer: the lane build-memory (src/col/build, seg_write) owns them
double	col/v1/verify.c	hc->win = hc->win ? repalloc(hc->win, hc->capwin * sizeof(RowHash)) : MemoryContextAlloc(hc->cv->cxt, hc->capwin * sizeof(RowHash));	bounded: the rows of the entities of one heap block (a window), at most MaxHeapTuplesPerPage live entries
double	col/v1/wbuf/batches.c	f->held = repalloc(f->held, (f->cap *= 2) * sizeof(Held));	bounded: the batches of one write buffer, which sift.wbuf_max_kb bounds
double	col/v1/wbuf/batches.c	s->b = s->b ? repalloc(s->b, (s->cap *= 2) * sizeof(SiftColBatch *)) :	bounded: the batches of one write buffer, which sift.wbuf_max_kb bounds
double	col/v1/wbuf/lookup.c	out = repalloc(out, (cap *= 2) * sizeof(ItemPointerData));	bounded: the addresses of one lookup of the write buffer
double	core/reads.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: the same array as the lifetime row of this file
double	core/lane.c	blks = repalloc(blks, (cap *= 2) * sizeof(BlockNumber));	bounded: the blocks of one lane, at most the pages of the relation
double	table/v1/gscan_cache.c	g->cu = repalloc(g->cu, (cap *= 2) * sizeof(UnitTids));	bounded: units of one group scan of a sift_table, the memory of its fetch contexts
double	col/scope_v6/topk.c	l->e = repalloc(l->e, sizeof(*l->e) * (l->cap = Max(l->cap * 2, l->n + n)));	bounded: the live rows of one scope key that hold one value of an order leaf (the tie at the cut of a query), at most the rows of the key
int	agg/gord.c	char *cand = palloc(g->ncur * SIFT_CGORD_STR_MAX);	bounded: ncur sources (the segments of one scan, a few) times a constant string length
int	agg/leaf.c	char *data = (char *) TYPEALIGN(SIFT_SIMD_ALIGN, MemoryContextAlloc(ex->ucxt, nrow * esz + SIFT_AGG_PAD + SIFT_SIMD_ALIGN));	bounded: nrow is a unit's rows (SIFT_COL_UNIT_ROWS at most) times esz of 4 or 8: far below 4 GB
int	agg/leaf.c	v->data = (char *) TYPEALIGN(SIFT_SIMD_ALIGN, MemoryContextAllocZero(ex->ucxt, n * esz + SIFT_AGG_PAD * esz + SIFT_SIMD_ALIGN));	bounded: nrow is a unit's rows (SIFT_COL_UNIT_ROWS at most) times esz of 4 or 8: far below 4 GB
int	agg/sel.c	b->data = MemoryContextAlloc(cxt, b->cap * 8);	bounded: cap is a size_t of the rows of a unit
int	bm25/facet.c	rows = MemoryContextAlloc(f->mcxt, n * ROW_BYTES);	bounded: n is the pages of a superblock (SIFT_PAGEMASK_WORDS * 64) times ROW_BYTES
int	bm25/livestream.c	dc->dead = MemoryContextAlloc(mcxt, (SIFT_SB_PAGES * MAXOFF + 7) / 8);	bounded: constants of a superblock
int	bm25/step.c	pk->buf = repalloc(pk->buf, pk->cap = size * 2);	bounded: size is the length of one posting block
lifetime	core/cachebudget.c	cache_root = AllocSetContextCreate(TopMemoryContext, "SiftBackendCacheContext", 8 * 1024, 8 * 1024, 64 * 1024);	bounded: the root of every cache of the backend: sift.backend_cache_kb, the oldest entry nobody holds goes first (sift_cache_room)
lifetime	agg/cost/cte.c	priced = MemoryContextAlloc(TopMemoryContext, PRICED_MAX * sizeof(PricedList));	bounded: PRICED_MAX entries
lifetime	agg/cte/rewrite.c	source_cx = AllocSetContextCreate(TopMemoryContext, "sift cache column sources", ALLOCSET_SMALL_SIZES);	bounded: one entry per column source (relation) the backend planned over, flushed by the relcache callback
lifetime	agg/expr/walk.c	walk_memo = MemoryContextAlloc(TopMemoryContext, WALK_MEMO_MAX * sizeof(WalkMemo));	bounded: WALK_MEMO_MAX entries
lifetime	agg/fuse.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one registration per executor state of the statement in flight, removed with it
lifetime	agg/fuse.c	old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one registration per executor state of the statement in flight, removed with it
lifetime	agg/gord.c	gbuf_cx = AllocSetContextCreate(TopMemoryContext, "sift cache cursors", ALLOCSET_DEFAULT_SIZES);	bounded: spare cursor buffers, a fixed number kept (ngbuf_spare)
lifetime	agg/lookshm.c	old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one attach record per shared lookup table in use (sift.agg_lookup_shared_kb)
lifetime	agg/lookup/first.c	old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one counter per first-row lookup of the statement in flight, forgotten by the callback of its query context
lifetime	agg/lookup/load.c	old = MemoryContextSwitchTo(TopMemoryContext);	bounded: the lookup tables kept for the backend are those of lookcache.c, under its byte limit
lifetime	agg/par/stats.c	s = MemoryContextAllocZero(TopMemoryContext, sizeof(ParStats));	bounded: one struct per backend
lifetime	agg/part/prune.c	bound_cx = AllocSetContextCreate(CacheMemoryContext, "sift cache partition bounds", ALLOCSET_DEFAULT_SIZES);	open: one bound per partition read, emptied only by a catalog invalidation: about 2 kB a partition, no byte limit (SIFT_AGG_MAX_PARTS partitions)
lifetime	agg/refuse.c	vet_cx = AllocSetContextCreate(TopMemoryContext, "sift cache path vets", ALLOCSET_SMALL_SIZES);	bounded: vets of one statement's paths, dropped at its end
lifetime	agg/topn/zone.c	walk_cx = AllocSetContextCreate(TopMemoryContext, "sift cache topn walks", ALLOCSET_DEFAULT_SIZES);	bounded: WALK_KEEP_BYTES for an entry and a fixed count of entries (walk_keep)
lifetime	agg/verdict.c	HASHCTL ctl = {.keysize = sizeof(uint64), .entrysize = sizeof(VerdictEntry), .hcxt = TopMemoryContext};	bounded: VERDICT_MAX entries, least recently used evicted (a few hundred bytes each)
lifetime	agg/verdict.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: VERDICT_MAX entries, least recently used evicted (a few hundred bytes each)
lifetime	col/am/rel.c	memset(MemoryContextAlloc(CacheMemoryContext, sz), 0x7f, sz);	bounded: one planning memo per backend, reset when the catalog changes; the 0x7f fill is a leak canary of a test
lifetime	col/am/ioss.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: emptied at the end of the transaction (ioss_pending)
lifetime	col/dsmreg.c	cx = MemoryContextSwitchTo(TopMemoryContext);	bounded: one record per attached dynamic shared memory segment, with its settings
lifetime	col/v1/maint/merge_pick.c	settled.gens = settled.gens ? repalloc(settled.gens, settled.cap * sizeof(uint64)) : MemoryContextAlloc(TopMemoryContext, settled.cap * sizeof(uint64));	bounded: the generations of the segments the last merges of one index wrote, at most 2 * SIFT_DIR_WIDE_MAX (a ring)
lifetime	col/names.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one name per index the statement or the backend asked about, flushed by the relcache callback
lifetime	col/v1/rowkey.c	dead_share.cxt = AllocSetContextCreate(TopMemoryContext, "sift dead share", ALLOCSET_DEFAULT_SIZES);	bounded: reset at the end of every transaction (dead_share_reset)
lifetime	col/v1/scan/gmem.c	gkept_cxt = AllocSetContextCreate(TopMemoryContext, "sift cache write buffer orders", ALLOCSET_DEFAULT_SIZES);	bounded: gord_mem_rows rows (2 million) and a fixed number of slots (gkept)
lifetime	col/scope_journal.c	m->cx = AllocSetContextCreate(TopMemoryContext, "sift cache scope groups", ALLOCSET_SMALL_SIZES);	bounded: SIFT_SCOPE_MAX slots, replaced in turn
lifetime	col/scope_legs.c	m->cx = AllocSetContextCreate(TopMemoryContext, "sift cache scope legs", ALLOCSET_SMALL_SIZES);	bounded: a fixed ring of slots, replaced in turn
lifetime	col/scope_make.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one OID for each journal index a scope build makes empty (at most the number of pairs relations of the statement), freed by the validation pass or forgotten at abort
lifetime	col/v1/scope_paid.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: an array of indexes with pending scope work, doubling, in the backend's memory: the number of scope indexes written; the release at transaction end is not proved
lifetime	col/scope_parse.c	specs_memo[slot].cx = AllocSetContextCreate(TopMemoryContext, "sift cache scope specs", ALLOCSET_SMALL_SIZES);	bounded: a fixed array of slots (specs_memo), replaced in turn
lifetime	col/v1/track_drop.c	gone = gone ? repalloc(gone, gone_cap * sizeof(Oid)) : MemoryContextAlloc(TopMemoryContext, gone_cap * sizeof(Oid));	open: an array of dropped index oids, doubling: one per index dropped in a transaction; the release at transaction end is not proved
lifetime	col/types.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: the type cache of the extension's own types, a fixed set
lifetime	col/keystore/keystore_rel.c	gone = gone ? repalloc(gone, gone_cap * sizeof(Oid)) : MemoryContextAlloc(TopMemoryContext, gone_cap * sizeof(Oid));	open: an array of the tables of the indexes dropped in a transaction, doubling: one per index dropped in it; the release at transaction end (gone_xact) is not proved
lifetime	col/v1/wbuf/pending.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: pending rows of the transaction, flushed at its end
lifetime	core/reads.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: an array of write-buffer reads pending in the transaction, doubling; the release at transaction end is not proved
lifetime	table/v1/load/load.c	MemoryContextSwitchTo(TopMemoryContext);	bounded: the context of one bulk load, deleted when the load ends
lifetime	table/v1/load/load.c	cxt = AllocSetContextCreate(TopMemoryContext, "sift_table bulk load", ALLOCSET_DEFAULT_SIZES);	bounded: the context of one bulk load, deleted when the load ends
lifetime	table/v1/store.c	HASHCTL ctl = {.keysize = sizeof(Oid),.entrysize = sizeof(CacheEnt),.hcxt = CacheMemoryContext};	bounded: one entry per sift_table relation the backend opened, dropped with the relcache entry
lifetime	table/v1/store.c	MemoryContext cxt = AllocSetContextCreate(CacheMemoryContext, "sift cache table", ALLOCSET_DEFAULT_SIZES);	bounded: one entry per sift_table relation the backend opened, dropped with the relcache entry
lifetime	table/v1/store.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one entry per sift_table relation the backend opened, dropped with the relcache entry
lifetime	table/v1/store.c	rel->rd_amcache = MemoryContextAlloc(CacheMemoryContext, sizeof(SiftTblRelHeader));	bounded: one entry per sift_table relation the backend opened, dropped with the relcache entry
loop	agg/lookcol.c	for (uint64 bits = rows[w]; bits != 0; bits &= bits - 1)	bounded: walks the set bits of a member bitmap into pairs under sift.agg_lookup_kb
loop	bm25/cscan_exec.c	while (table_scan_getnextslot(scan, ForwardScanDirection, slot))	bounded: the dimension set is capped at SIFT_SEMI_MAX_SET and the scan stops at it
loop	bm25/liveness.c	for (; i < dm->nsb && used < rows; i++)	bounded: used < rows bounds the loop by the rows asked for
loop	col/skip/build.c	for (int c = 0; c < rows->ncols; c++)	bounded: walks the columns of the schema, not rows
loop	col/skip/join.c	for (uint32 e = 0; e < ps[i].nentries; e++)	bounded: walks the entries of the skipping indexes of one part, at most five for each column
loop	core/f2/manifest.c	for (int i = 0; i < PDIR(p)->nentries; i++)	bounded: the loop collects the partitions of the range asked for, the result of the call, in one array that it grows
loop	col/scope_v6/build.c	for (uint32 r = 0; r < rows.n; r++)	bounded: the row lists of one granule's keys, at most SIFT_GRANULE_ROW_BITS rows (8192) a key and freed when the granule is cut
double	col/f2/f2_scope_build.c	#define NOTE(k, m) do { if (n == cap) c = repalloc(c, (cap *= 2) * sizeof(SiftScopeMemberKey)); c[n++] = (SiftScopeMemberKey) {(m), (k)}; } while (0)	bounded: one entry for each changed member (at most REFRESH_MEMBERS_MAX) and each key of the roots or of its pairs
loop	col/f2/f2_scope_cells.c	for (int k = 0; k < nrows; k++)	bounded: the string cells of one scope refresh, one copy for each row of a granule (SIFT_GRANULE_ROWS at most) and string leaf, in the context of the refresh
loop	core/sql_status.c	while ((tup = heap_getnext(scan, ForwardScanDirection)) != NULL)	bounded: one candidate for each sift index or sift_table of the database, none for any other row of pg_class
