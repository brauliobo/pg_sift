# RULE	FILE	THE LINE	WHAT BOUNDS IT -- 'bounded:' was read at the site, 'open:' is a growth that nothing bounds by a setting (the 5.0.1 memory audit lists it).
double	col/v1/src_wide.c	w->bytes = repalloc(w->bytes, w->bcap);	open: wide values (numeric, text over 8 bytes) of one aggregate, one per distinct value: no limit but the group table check
double	col/v1/src_wide.c	w->key = repalloc(w->key, w->dcap * 3 * sizeof(uint64));	open: wide values (numeric, text over 8 bytes) of one aggregate, one per distinct value: no limit but the group table check
double	col/v1/src_wide.c	w->off = repalloc(w->off, (w->dcap + 1) * sizeof(uint32));	open: wide values (numeric, text over 8 bytes) of one aggregate, one per distinct value: no limit but the group table check
double	bm25/step.c	pk->buf = repalloc(pk->buf, pk->cap = size * 2);	bounded: the size of one posting block of a cursor
double	col/f2/build/build.c	bs->ended = bs->ended != NULL ? repalloc(bs->ended, bs->capended * sizeof(SiftPendDelRec)) : MemoryContextAlloc(bs->cx, bs->capended * sizeof(SiftPendDelRec));	bounded: one record for each row of the run that the heap has deleted, charged to the memory of the run (maintenance_work_mem), which writes the part and the deletes when it is full
double	col/skip/build.c	b->s = b->s ? repalloc(b->s, b->cap * sizeof(Stream *)) : palloc(b->cap * sizeof(Stream *));	bounded: one stream per column and kind of one part, at most two for each column of the schema
double	col/v1/dict/dict.c	d->off = repalloc(d->off, (d->cap + 1) * sizeof(uint32));	open: the entries of a dictionary under construction: segment writer, owned by the lane build-memory
double	col/v1/scan/scope.c	ps->p = ps->p ? repalloc(ps->p, ps->cap * sizeof(SiftScopePair)) : palloc(ps->cap * sizeof(SiftScopePair));	bounded: pairs of one scope read, under work_mem (sift_budget_check) in the caller
double	col/v1/scan/scope_delta.c	o->row = repalloc(o->row, o->cap * sizeof(DeltaRow));	bounded: rows of the changed keys of one scope delta, under sift.col_scope_refresh_pct
double	col/v1/scan/scope_segrows.c	bids = bids ? repalloc(bids, cap * sizeof(int64 *)) : palloc(cap * sizeof(int64 *));	bounded: batches of one scope segment read
double	col/v1/scan/scope_segrows.c	bs = bs ? repalloc(bs, cap * sizeof(SiftColBatch *)) : palloc(cap * sizeof(SiftColBatch *));	bounded: batches of one scope segment read
double	col/v1/scope/paid.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: the same array as the lifetime row of this file
double	col/v1/seg_write/groups.c	g->gfirst = repalloc(g->gfirst, g->cap * sizeof(uint32));	open: the group arrays of the segment writer: the lane build-memory (src/col/build, seg_write) owns them
double	col/v1/seg_write/groups.c	g->gn = repalloc(g->gn, g->cap * sizeof(uint32));	open: the group arrays of the segment writer: the lane build-memory (src/col/build, seg_write) owns them
double	col/v1/seg_write/groups.c	g->xsplit = repalloc(g->xsplit, g->cap * sizeof(uint64));	open: the group arrays of the segment writer: the lane build-memory (src/col/build, seg_write) owns them
double	col/v1/verify.c	hc->win = hc->win ? repalloc(hc->win, hc->capwin * sizeof(RowHash)) : MemoryContextAlloc(hc->cv->cxt, hc->capwin * sizeof(RowHash));	bounded: the rows of the entities of one heap block (a window), at most MaxHeapTuplesPerPage live entries
double	col/v1/wbuf/batches.c	f->held = repalloc(f->held, (f->cap *= 2) * sizeof(Held));	bounded: the batches of one write buffer, which sift.wbuf_max_kb bounds
double	col/v1/wbuf/batches.c	s->b = s->b ? repalloc(s->b, (s->cap *= 2) * sizeof(SiftColBatch *)) :	bounded: the batches of one write buffer, which sift.wbuf_max_kb bounds
double	col/v1/wbuf/lookup.c	out = repalloc(out, (cap *= 2) * sizeof(ItemPointerData));	bounded: the addresses of one lookup of the write buffer
double	core/reads.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: the same array as the lifetime row of this file
double	core/lane.c	blks = repalloc(blks, (cap *= 2) * sizeof(BlockNumber));	bounded: the blocks of one lane, at most the pages of the relation
double	table/v1/gscan/cache.c	g->cu = repalloc(g->cu, (cap *= 2) * sizeof(UnitTids));	bounded: units of one group scan of a sift_table, the memory of its fetch contexts
double	col/f2/cube/topk.c	l->e = repalloc(l->e, sizeof(*l->e) * (l->cap = Max(l->cap * 2, l->n + n)));	bounded: the live rows of one scope key that hold one value of an order leaf (the tie at the cut of a query), at most the rows of the key
int	col/v1/src_sel.c	b->data = MemoryContextAlloc(cxt, b->cap * 8);	bounded: cap is a size_t of the rows of a unit
int	bm25/facet/facet.c	rows = MemoryContextAlloc(f->mcxt, n * ROW_BYTES);	bounded: n is the pages of a superblock (SIFT_PAGEMASK_WORDS * 64) times ROW_BYTES
int	bm25/step.c	pk->buf = repalloc(pk->buf, pk->cap = size * 2);	bounded: size is the length of one posting block
lifetime	col/am/rel.c	memset(MemoryContextAlloc(CacheMemoryContext, sz), 0x7f, sz);	bounded: one planning memo per backend, reset when the catalog changes; the 0x7f fill is a leak canary of a test
lifetime	col/am/ioss.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: emptied at the end of the transaction (ioss_pending)
lifetime	col/dsmreg.c	cx = MemoryContextSwitchTo(TopMemoryContext);	bounded: one record per attached dynamic shared memory segment, with its settings
lifetime	col/names.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one name per index the statement or the backend asked about, flushed by the relcache callback
lifetime	col/v1/scope/paid.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: an array of indexes with pending scope work, doubling, in the backend's memory: the number of scope indexes written; the release at transaction end is not proved
lifetime	col/v1/track/drop.c	gone = gone ? repalloc(gone, gone_cap * sizeof(Oid)) : MemoryContextAlloc(TopMemoryContext, gone_cap * sizeof(Oid));	open: an array of dropped index oids, doubling: one per index dropped in a transaction; the release at transaction end is not proved
lifetime	col/types.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: the type cache of the extension's own types, a fixed set
lifetime	col/keystore/rel.c	gone = gone ? repalloc(gone, gone_cap * sizeof(Oid)) : MemoryContextAlloc(TopMemoryContext, gone_cap * sizeof(Oid));	open: an array of the tables of the indexes dropped in a transaction, doubling: one per index dropped in it; the release at transaction end (gone_xact) is not proved
lifetime	col/v1/wbuf/pending.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: pending rows of the transaction, flushed at its end
lifetime	core/reads.c	pending = pending ? repalloc(pending, cap * sizeof(Pending)) : MemoryContextAlloc(TopMemoryContext, cap * sizeof(Pending));	open: an array of write-buffer reads pending in the transaction, doubling; the release at transaction end is not proved
lifetime	table/v1/load/load.c	MemoryContextSwitchTo(TopMemoryContext);	bounded: the context of one bulk load, deleted when the load ends
lifetime	table/v1/load/load.c	cxt = AllocSetContextCreate(TopMemoryContext, "sift_table bulk load", ALLOCSET_DEFAULT_SIZES);	bounded: the context of one bulk load, deleted when the load ends
lifetime	table/v1/store.c	HASHCTL ctl = {.keysize = sizeof(Oid),.entrysize = sizeof(CacheEnt),.hcxt = CacheMemoryContext};	bounded: one entry per sift_table relation the backend opened, dropped with the relcache entry
lifetime	table/v1/store.c	MemoryContext old = MemoryContextSwitchTo(TopMemoryContext);	bounded: one entry per sift_table relation the backend opened, dropped with the relcache entry
lifetime	table/v1/store.c	rel->rd_amcache = MemoryContextAlloc(CacheMemoryContext, sizeof(SiftTblRelHeader));	bounded: one entry per sift_table relation the backend opened, dropped with the relcache entry
lifetime	core/cachebudget.c	cache_root = AllocSetContextCreate(TopMemoryContext, "SiftBackendCacheContext", ALLOCSET_SMALL_MINSIZE, ALLOCSET_SMALL_INITSIZE, CACHE_BLOCK_MAX);	bounded: the root of every cache of the backend: sift.backend_cache_kb, the oldest entry nobody holds goes first (sift_cache_room)
lifetime	col/v1/maint/merge_pick.c	settled.gens = settled.gens ? repalloc(settled.gens, 2 * settled.cap * sizeof(uint64)) : MemoryContextAlloc(TopMemoryContext, 2 * settled.cap * sizeof(uint64));	bounded: the generations of the segments the last merges of one index wrote, at most 2 * SETTLED_MAX (a ring)
loop	agg/unnest/jsonb.c	for (uint32 k = 0; ts != NULL && tuplestore_gettupleslot(ts, true, false, f->slot); k++)	bounded: the members of the one document of a row, in the context of the batch that is reset for the next
loop	bm25/cscan/exec.c	while (nset != SIFT_SEMI_OVER && table_scan_getnextslot(scan, ForwardScanDirection, slot))	bounded: the dimension set is capped at SIFT_SEMI_MAX_SET and the scan stops at it
loop	bm25/liveness.c	for (; i < dm->nsb && used < rows; i++)	bounded: used < rows bounds the loop by the rows asked for
loop	col/skip/build.c	for (int c = 0; c < rows->ncols; c++)	bounded: walks the columns of the schema, not rows
loop	col/f2/cube/build.c	for (uint32 r = 0; r < rows.n; r++)	bounded: the row lists of one granule's keys, at most SIFT_GRANULE_ROW_BITS rows (8192) a key and freed when the granule is cut
loop	col/f2/scope/cells.c	for (int k = 0; k < nrows; k++)	bounded: the string cells of one scope refresh, one copy for each row of a granule (SIFT_GRANULE_ROWS at most) and string leaf, in the context of the refresh
loop	core/sql/status.c	while ((tup = heap_getnext(scan, ForwardScanDirection)) != NULL)	bounded: one candidate for each sift index or sift_table of the database, none for any other row of pg_class
loop	col/v1/seg/maint.c	for (uint32 r = 0; r < seg->sbdir[u].nrows; r++)	bounded: tmp is reused by every row and grows to the longest list of one key of the unit, at most its rows
double	table/f2/col_delta/col_delta.c	st->items = st->items != NULL ? repalloc(st->items, sizeof(SiftStageColDelta) * st->cap)	bounded: the entries a transaction stages for the chains it patches, each chain admitting at most SIFT_COL_DELTA_MAX_PAGES pages (256 kB): the entries of one chain are as many as its records
double	table/f2/col_delta/compact.c	plan->fate = plan->fate != NULL ? repalloc(plan->fate, cap) : palloc(cap);	bounded: a nibble for each record of one delta chain of one partition, which SIFT_COL_DELTA_MAX_PAGES pages hold at most: no update is admitted to a longer chain
double	table/f2/col_delta/overlay.c	c->v = c->v != NULL ? repalloc(c->v, sizeof(Collected) * c->cap) : palloc(sizeof(Collected) * c->cap);	bounded: the records of one delta chain of one partition, which SIFT_COL_DELTA_MAX_PAGES pages (256 kB) hold at most: no update is admitted to a longer chain
double	col/f2/col_delta/idx.c	v = v != NULL ? repalloc(v, cap * sizeof(SiftCdRemap)) : palloc(cap * sizeof(SiftCdRemap));	bounded: the records of one delta chain of one partition, which SIFT_COL_DELTA_MAX_PAGES pages (256 kB) hold at most: no update is admitted to a longer chain
double	col/f2/par.c	b->out->refs = repalloc(b->out->refs, (b->cap *= 2) * sizeof(SiftParPartRef));	bounded: the parts of the manifest of one relation (the manifest is one allocation under 1 GB), one reference each
double	col/f2/prefetch/prefetch.c	plan->runs = plan->runs ? repalloc(plan->runs, cap * sizeof(SiftPfRun)) : palloc(cap * sizeof(SiftPfRun));	bounded: the runs of pages of one prefetch window (SIFT_PF_WINDOW_GRANULES granules), at most one run for each page of the window
double	col/f2/tier/tier.c	l->keys = l->keys ? repalloc(l->keys, l->cap * sizeof(char *)) : palloc(l->cap * sizeof(char *));	bounded: the object keys of the directory of one relation in object storage, one for each part moved there
double	col/f2/tier/cache.c	f = f ? repalloc(f, cap * sizeof(Found)) : palloc(cap * sizeof(Found));	bounded: the chunk files in the directory of the tier cache, which is held to its byte limit and evicted from; read once at start
double	col/f2/tier/sigv4.c	b->d = b->d ? repalloc(b->d, b->cap) : palloc(b->cap);	bounded: the canonical request of one signed HTTP call: the method, the path and a few headers, under a kilobyte
double	col/f2/key/marks.c	b->bytes = b->bytes ? repalloc(b->bytes, (size_t) b->cap * stride) : palloc((size_t) b->cap * stride);	bounded: one mark for each granule of the part being built, which maintenance_work_mem holds
double	col/f2/gpu/plan.c	pv->part = repalloc(pv->part, (cap *= 2) * sizeof(PlanPart));	bounded: the parts of the manifest of one relation (the manifest is one allocation under 1 GB), a few words each
double	agg/gpu/scan.c	t->cand = repalloc(t->cand, (t->cap *= 2) * sizeof(SiftGpuCand));	bounded: at most k candidates (k up to SIFT_TOPN_MAX_ROWS) for each device batch of one scan
double	agg/ht/rec.c	b->p = b->p ? repalloc(b->p, b->cap) : palloc(b->cap);	bounded: the largest record of one group (its key and aggregate states), a few kilobytes
double	col/f2/agg/scope/scope.c	p->spec.agg = p->spec.agg ? repalloc(p->spec.agg, (Size) p->cap_aggs * sizeof(SiftV6Agg)) : palloc((Size) p->cap_aggs * sizeof(SiftV6Agg));	bounded: the aggregates of one statement, one entry for each aggregate it names
double	col/f2/agg/scope/run.c	st->vals = st->vals ? repalloc(st->vals, (Size) st->cap_rows * sizeof(Datum *)) : palloc((Size) st->cap_rows * sizeof(Datum *));	open: the result rows of one scope statement, one for each group the statement returns
double	col/f2/agg/scope/run.c	st->nulls = st->nulls ? repalloc(st->nulls, (Size) st->cap_rows * sizeof(bool *)) : palloc((Size) st->cap_rows * sizeof(bool *));	open: the result rows of one scope statement, one for each group the statement returns
double	agg/group/fast.c	wb->buf = repalloc(wb->buf, wb->cap);	bounded: the bytes of the wide keys of one vector of SIFT_VEC_LEN rows, each key at most the size of a stored value
double	col/f2/del/delvec_delta.c	bs->b = repalloc(bs->b, bs->cap * sizeof(DeltaBucket));	bounded: one bucket for each group of granules the delta tail of one part changes; a fold of the tail ends it
double	col/f2/del/delvec_delta.c	b->rows = repalloc(b->rows, b->cap * sizeof(DeltaRow));	bounded: the rows of the chunks of one delta tail, which a fold of the tail bounds
