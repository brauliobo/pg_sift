array-append	src/agg/chunkfilter.c	p[np++] = (SiftColPred) {r->col, SIFT_COLOP_LE, 1, &hiv};	the conjuncts offered are cut at SIFT_COLSRC_MAX_FILTERS (agg/init_filter.c), the arrays are allocated for that many; the pair array holds the two ends of one range
array-append	src/agg/col.c	preds[n++] = src->flt.pred[i];	preds is COL_PREDS_MAX entries: the sum of the caps of the predicates that are copied into it
array-append	src/agg/col.c	preds[n++] = src->spred[i];	preds is COL_PREDS_MAX entries: the sum of the caps of the predicates that are copied into it
array-append	src/agg/col.c	preds[n++] = src->wpred[i];	preds is COL_PREDS_MAX entries: the sum of the caps of the predicates that are copied into it
array-append	src/agg/lookclass.c	m->idx[m->n++] = p;	each distinct need is added once, at most nneed <= MAX_NEED
cast-after-product	src/agg/par/split.c	return (uint32) (((uint64) (h * SPLIT_MUL) * n) >> 32);	a multiplicative hash of 32-bit values: the wrap is the hash
array-append	src/agg/spill/stream.c	act[k++] = act[a];	the active list is compacted in place, k never passes the index being read
array-append	src/agg/wide.c	dig[n++] = (uint16) (u % 10000);	the limbs of a 128-bit value in base 10^4: at most 10 of the 16
array-append	src/bm25/livestream.c	dl[n++] = row[o];	a term is buffered only while its df is within STREAM_POSTINGS (the arrays' size), or a full batch is flushed before the next row
array-append	src/bm25/livestream.c	s->dl[s->n++] = dl;	a term is buffered only while its df is within STREAM_POSTINGS (the arrays' size), or a full batch is flushed before the next row
array-append	src/bm25/merge_ranges.c	segs[nlive++] = seg;	the segments are the input of the merge, at most MAX_MERGE_FANIN (checked before the worker starts)
array-append	src/bm25/query_analyze.c	kids[nk++] = c;	allocated for the length of the list the loop walks
blocknumber-sum	src/bm25/rank_search.c	BlockNumber blk = u->gid << SIFT_SB_SHIFT | (b * SIFT_BLK_PAGES + slot / SIFT_KERN_SLOTS);	the block of a page of a superblock of the heap: a heap block number, below 2^32 by PostgreSQL
array-append	src/bm25/runs/merge.c	dl[n++] = top->ddl;	the batch is flushed at BATCH rows
array-append	src/bm25/runs_int.h	v[n++] = (uint8) (x | 0x80);	a varint of 64 bits takes at most 10 bytes
array-append	src/bm25/runs_int.h	v[n++] = (uint8) x;	a varint of 64 bits takes at most 10 bytes
blocknumber-sum	src/bm25/walk.c	BlockNumber blk = dm->dir[i].sb * SIFT_SB_PAGES + p;	the heap block of a page of a superblock of the segment: a heap block number, below 2^32 by PostgreSQL
array-append	src/bm25/writer.c	offs[n++] = k * 64 + __builtin_ctzll(m) + 1;	the offsets of one page: at most MaxHeapTuplesPerPage
