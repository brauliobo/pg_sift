array-append	src/col/am/am.c	rels[n++] = rt_fetch(rti, ps->rtable)->relid;	allocated for stmt_result_count() relations, the count of the same range table
array-append	src/col/amscan/amscan.c	tids[m++] = tids[i];	a compaction in place of the TIDs read, m never passes i; an estimate of rows by a double ratio
cast-after-product	src/col/amscan/amscan.c	int64 fetches = so->sampled > 0 ? (int64) (so->returned * ((double) so->unseen / so->sampled)) : 0;	a compaction in place of the TIDs read, m never passes i; an estimate of rows by a double ratio
array-append	src/col/build/run.c	pick[n++] = low;	two picks, the loop runs twice
