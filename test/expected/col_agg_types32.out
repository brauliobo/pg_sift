 renamed scan same scan same scan same scan same scan same scan same scan same
(1 row)

-- parallel workers
RESET seq_page_cost;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET max_parallel_workers_per_gather = 2;
SET seq_page_cost = 1000;
SELECT chk($$SELECT grp AS g, count(*) AS c, min(t) AS a, max(e)::text AS b FROM wt GROUP BY grp$$) AS parallel_aggs,
       chk($$SELECT e::text AS k, count(*) AS c FROM wt GROUP BY e$$) AS parallel_key;
 parallel_aggs | parallel_key 
---------------+--------------
 scan same     | scan same
(1 row)

-- a sift_table stores these types by size and keeps its format minor
CREATE TABLE tt (id int, t time, e lvl3, ia int[], r int4range, u uuid, b bytea, mo money) USING sift_table;
INSERT INTO tt SELECT i, '01:00'::time + i * interval '1 second', 'ok', ARRAY[i], int4range(i, i + 2), md5(i::text)::uuid, '\x01', (i % 50)::numeric::money FROM generate_series(1, 20000) i;
VACUUM tt;
SELECT kind, format, count(*) FROM sift.table_segments('tt') GROUP BY 1, 2 ORDER BY 1, 2;
    kind    | format | count 
------------+--------+-------
 buffer     |        |     1
 columns    |      4 |     1
 tombstones |        |     1
(3 rows)

SELECT e::text, count(*), min(t), max(ia) FROM tt GROUP BY e;
 e  | count |   min    |   max   
----+-------+----------+---------
 ok | 20000 | 01:00:01 | {20000}
(1 row)

SELECT chk($$SELECT mo::text AS k, count(*) AS c, sum(mo)::text AS s, max(mo)::text AS m FROM tt GROUP BY mo$$) AS table_money;
 table_money 
-------------
 plain same
(1 row)

DROP TABLE tt;
DROP TABLE wt;
DROP TYPE lvl3;
DROP FUNCTION chk(text), shapes(text);
DROP EXTENSION pg_sift;
