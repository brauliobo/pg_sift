-- Parallel CREATE INDEX / REINDEX of a sift_col index: the participants claim whole superblocks and write buffers of
-- their own, so the column data must equal the serial build's whatever the segment boundaries. sift.test_col_workers is the number of
-- workers the last build launched.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
-- Every leaf of two indexes: the same rows with the same values
CREATE FUNCTION col_same(a regclass, b regclass) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l int; bad text := '';
BEGIN
	FOR l IN SELECT leaf FROM sift.col_leaves(a) ORDER BY 1 LOOP
		IF (SELECT count(*) FROM (SELECT * FROM sift._test_col_read(a, l) EXCEPT ALL SELECT * FROM sift._test_col_read(b, l)) z) +
		   (SELECT count(*) FROM (SELECT * FROM sift._test_col_read(b, l) EXCEPT ALL SELECT * FROM sift._test_col_read(a, l)) z) > 0
		THEN bad := bad || ' ' || l; END IF;
	END LOOP;
	RETURN CASE WHEN bad = '' THEN 'ok' ELSE 'differs in leaves' || bad END;
END $$;
-- The rows of a scan (TIDs of the index) against the visible heap tuples; no HOT chains in the table at the time
CREATE FUNCTION col_cmp(idx regclass, preds text, heapwhere text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a bigint; b bigint; ex bigint; mi bigint;
BEGIN
	SELECT count(*) INTO a FROM sift._test_col_tids(idx, preds);
	EXECUTE format('SELECT count(*) FROM li WHERE %s', heapwhere) INTO b;
	EXECUTE format('SELECT count(*) FROM (SELECT tid FROM sift._test_col_tids(%L, %L) EXCEPT SELECT ctid FROM li WHERE %s) z', idx, preds, heapwhere) INTO ex;
	EXECUTE format('SELECT count(*) FROM (SELECT ctid FROM li WHERE %s EXCEPT SELECT tid FROM sift._test_col_tids(%L, %L)) z', heapwhere, idx, preds) INTO mi;
	RETURN CASE WHEN a = b AND ex = 0 AND mi = 0 THEN 'ok' ELSE format('MISMATCH index=%s heap=%s extra=%s missing=%s', a, b, ex, mi) END;
END $$;
-- sift.col_verify returns void: this one says ok
CREATE FUNCTION col_verified(idx regclass) RETURNS text LANGUAGE plpgsql AS $$
BEGIN PERFORM sift.col_verify(idx, true); RETURN 'ok'; END $$;
-- 12 000 rows, 3 per page: 4 000 pages, 16 superblocks of 256 pages
CREATE TABLE li (id int, tenant_id int, qty int, price float8, sku text, attrs jsonb, pad text) WITH (fillfactor = 10, autovacuum_enabled = off);
INSERT INTO li
SELECT i, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 7919) % 500 END, 1 + i % 40, CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 1000) / 8.0 END,
	   CASE WHEN i % 17 = 0 THEN NULL ELSE 'sku-' || (i % 300) END,
	   jsonb_build_object('channel', (ARRAY['web', 'app', 'pos'])[1 + i % 3], 'weight', (i % 50) / 4.0,
						  'tags', jsonb_build_array('a' || (i % 7), 'b' || (i % 5))),
	   repeat('x', 100)
FROM generate_series(1, 12000) i;
SELECT pg_relation_size('li') / 8192 >= 3 * 256 AS three_superblocks;
 three_superblocks 
-------------------
 t
(1 row)

-- What the build wrote: the participants, the segments, whether every superblock is in one segment only and whether the units add up
CREATE FUNCTION col_shape(idx regclass) RETURNS TABLE (workers int, segments bigint, all_have_units bool, one_segment_each bool, units_ok bool, rows_ok bool, verified text)
LANGUAGE sql AS $$
	SELECT current_setting('sift.test_col_workers')::int, count(*), bool_and(s.units > 0), sum(s.units) = (SELECT count(DISTINCT sb) FROM sift._test_col_tids(idx, '', 2)),
		   (SELECT units FROM sift.col_index_info(idx)) = (SELECT count(DISTINCT sb) FROM sift._test_col_tids(idx, '', 2)),
		   sum(s.rows) = (SELECT count(*) FROM li), col_verified(idx)
	FROM sift.col_segments(idx) s $$;
SET maintenance_work_mem = '128MB';
SET min_parallel_table_scan_size = 0;
SET max_parallel_maintenance_workers = 2;
-- The serial reference
SET max_parallel_maintenance_workers = 0;
CREATE INDEX li_ser ON li USING sift_col (tenant_id, qty, price, sku, attrs) WITH (paths = 'attrs.channel text, attrs.weight float4, attrs.tags[] text');
NOTICE:  sift_col index li_ser keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_ser SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SELECT * FROM col_shape('li_ser');
 workers | segments | all_have_units | one_segment_each | units_ok | rows_ok | verified 
---------+----------+----------------+------------------+----------+---------+----------
       0 |        1 | t              | t                | t        | t       | ok
(1 row)

SET max_parallel_maintenance_workers = 2;
-- Two workers and the leader: a segment each, the same column data
CREATE INDEX li_par ON li USING sift_col (tenant_id, qty, price, sku, attrs) WITH (paths = 'attrs.channel text, attrs.weight float4, attrs.tags[] text');
NOTICE:  sift_col index li_par keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_par SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SELECT * FROM col_shape('li_par');
 workers | segments | all_have_units | one_segment_each | units_ok | rows_ok | verified 
---------+----------+----------------+------------------+----------+---------+----------
       2 |        3 | t              | t                | t        | t       | ok
(1 row)

SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

SELECT col_cmp('li_par', '', 'true'), col_cmp('li_par', '1:ge:30;0:lt:100', 'qty >= 30 AND tenant_id < 100'), col_cmp('li_par', '3:eq:sku-7', 'sku = ''sku-7''');
 col_cmp | col_cmp | col_cmp 
---------+---------+---------
 ok      | ok      | ok
(1 row)

-- Updated (HOT and not), deleted and dead rows of the table: only the live ones enter, and as they do in a serial build
UPDATE li SET pad = repeat('y', 100) WHERE id % 10 = 1;
UPDATE li SET qty = qty + 100 WHERE id % 10 = 2;
UPDATE li SET tenant_id = NULL WHERE id % 10 = 3;
DELETE FROM li WHERE id % 10 = 4;
DROP INDEX li_ser, li_par;
SET max_parallel_maintenance_workers = 0;
CREATE INDEX li_ser ON li USING sift_col (tenant_id, qty, price, sku, attrs) WITH (paths = 'attrs.channel text, attrs.weight float4, attrs.tags[] text');
NOTICE:  sift_col index li_ser keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_ser SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SET max_parallel_maintenance_workers = 2;
CREATE INDEX li_par ON li USING sift_col (tenant_id, qty, price, sku, attrs) WITH (paths = 'attrs.channel text, attrs.weight float4, attrs.tags[] text');
NOTICE:  sift_col index li_par keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_par SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SELECT * FROM col_shape('li_par');
 workers | segments | all_have_units | one_segment_each | units_ok | rows_ok | verified 
---------+----------+----------------+------------------+----------+---------+----------
       2 |        3 | t              | t                | t        | t       | ok
(1 row)

SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

SELECT (SELECT count(*) FROM sift._test_col_tids('li_par', '', 2)) = (SELECT count(*) FROM li) AS only_live_rows,
	   (SELECT count(*) FROM sift._test_col_tids('li_par', '1:ge:100', 0)) = (SELECT count(*) FROM li WHERE qty >= 100) AS updated_rows;
 only_live_rows | updated_rows 
----------------+--------------
 t              | t
(1 row)

-- No worker granted: the leader builds alone, as a serial build
SET max_parallel_workers = 0;
DROP INDEX li_par;
CREATE INDEX li_par ON li USING sift_col (tenant_id, qty, price, sku, attrs) WITH (paths = 'attrs.channel text, attrs.weight float4, attrs.tags[] text');
NOTICE:  sift_col index li_par keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_par SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SELECT workers, segments, one_segment_each, rows_ok, verified FROM col_shape('li_par');
 workers | segments | one_segment_each | rows_ok | verified 
---------+----------+------------------+---------+----------
       0 |        1 | t                | t       | ok
(1 row)

SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

RESET max_parallel_workers;
-- Segments cut after every unit: the 16 superblocks are 16 segments of three participants, with generations of their own
SET sift.test_col_segment_kb = 1;
CREATE INDEX li_cut ON li USING sift_col (tenant_id, qty, price, sku, attrs) WITH (paths = 'attrs.channel text, attrs.weight float4, attrs.tags[] text');
NOTICE:  sift_col index li_cut keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_cut SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
RESET sift.test_col_segment_kb;
SELECT * FROM col_shape('li_cut');
 workers | segments | all_have_units | one_segment_each | units_ok | rows_ok | verified 
---------+----------+----------------+------------------+----------+---------+----------
       2 |       16 | t              | t                | t        | t       | ok
(1 row)

SELECT count(*) = 16 AS one_per_superblock, count(DISTINCT gen) = 16 AS own_generations, bool_and(sb_lo = sb_hi) AS single_unit FROM sift.col_segments('li_cut');
 one_per_superblock | own_generations | single_unit 
--------------------+-----------------+-------------
 t                  | t               | t
(1 row)

SELECT col_same('li_cut', 'li_ser');
 col_same 
----------
 ok
(1 row)

SELECT sift.col_merge('li_cut', true) >= 0 AS merged;
 merged 
--------
 t
(1 row)

SELECT segments FROM sift.col_index_info('li_cut');
 segments 
----------
        1
(1 row)

SELECT col_same('li_cut', 'li_ser'), col_verified('li_cut');
 col_same | col_verified 
----------+--------------
 ok       | ok
(1 row)

DROP INDEX li_cut;
-- REINDEX, REINDEX CONCURRENTLY and CREATE INDEX CONCURRENTLY (the snapshot of the leader is the workers')
REINDEX INDEX li_par;
NOTICE:  sift_col index li_par keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_par SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SELECT * FROM col_shape('li_par');
 workers | segments | all_have_units | one_segment_each | units_ok | rows_ok | verified 
---------+----------+----------------+------------------+----------+---------+----------
       2 |        3 | t              | t                | t        | t       | ok
(1 row)

SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

REINDEX INDEX CONCURRENTLY li_par;
NOTICE:  sift_col index li_par_ccnew keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1280 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_par_ccnew SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
