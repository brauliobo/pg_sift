-- Writes on top of the build, the promotion of the write buffer and the merge of the interleaved segments
INSERT INTO li SELECT 20000 + i, i % 500, 1 + i % 40, i / 8.0, 'sku-' || (i % 300), '{"channel": "web", "weight": 1.5, "tags": ["z"]}', 'p'
FROM generate_series(1, 1500) i;
DELETE FROM li WHERE id % 10 = 5;
UPDATE li SET qty = 7 WHERE id % 10 = 6;
SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

SELECT sift.col_promote('li_par') >= 0 AS promoted, sift.col_promote('li_ser') >= 0 AS promoted;
 promoted | promoted 
----------+----------
 t        | t
(1 row)

SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

SELECT sift.col_merge('li_par', true) >= 0 AS merged, sift.col_merge('li_ser', true) >= 0 AS merged;
 merged | merged 
--------+--------
 t      | t
(1 row)

SELECT segments, buffers FROM sift.col_index_info('li_par');
 segments | buffers 
----------+---------
        2 |       1
(1 row)

SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

SELECT col_verified('li_par') AS verified;
 verified 
----------
 ok
(1 row)

VACUUM li;
SELECT col_same('li_par', 'li_ser');
 col_same 
----------
 ok
(1 row)

SELECT col_verified('li_par') AS verified;
 verified 
----------
 ok
(1 row)

-- A failure of a worker (superblock 1 is the first of worker 0) and of the leader (superblock 3 is its first) ends the build
SET sift.test_col_fail_sb = 1;
CREATE INDEX li_fail ON li USING sift_col (tenant_id, qty, price, sku);
ERROR:  sift test: the participant of superblock 0 fails
CONTEXT:  parallel worker
SET sift.test_col_fail_sb = 3;
CREATE INDEX li_fail ON li USING sift_col (tenant_id, qty, price, sku);
ERROR:  sift test: the participant of superblock 2 fails
SET sift.test_col_fail_sb = 0;
SELECT count(*) AS left_behind FROM pg_class WHERE relname = 'li_fail';
 left_behind 
-------------
           0
(1 row)

CREATE INDEX li_fail ON li USING sift_col (tenant_id, qty, price, sku);
NOTICE:  sift_col index li_fail keeps the keys of tenant_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 1360 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX li_fail SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SELECT current_setting('sift.test_col_workers') AS workers, col_verified('li_fail') AS verified;
 workers | verified 
---------+----------
 2       | ok
(1 row)

-- Too small a table is built serially, and the parallel_workers option of the table forces the workers
CREATE TABLE li_small (id int, qty int) WITH (autovacuum_enabled = off);
INSERT INTO li_small SELECT i, i FROM generate_series(1, 1000) i;
RESET min_parallel_table_scan_size;
CREATE INDEX li_small_serial ON li_small USING sift_col (qty);
SELECT current_setting('sift.test_col_workers') AS workers;
 workers 
---------
 0
(1 row)

ALTER TABLE li_small SET (parallel_workers = 1);
CREATE INDEX li_small_forced ON li_small USING sift_col (qty);
SELECT current_setting('sift.test_col_workers') AS workers, (SELECT count(*) FROM sift._test_col_tids('li_small_forced', '')) AS rows;
 workers | rows 
---------+------
 1       | 1000
(1 row)

DROP TABLE li, li_small;
DROP FUNCTION col_same(regclass, regclass), col_cmp(regclass, text, text), col_verified(regclass), col_shape(regclass);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
