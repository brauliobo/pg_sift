-- The automatic rewrite of a connected index asks for the rewrite of the whole index only for what its readers cannot patch, and not again for what it did
-- (docs/COL-CONNECT.md): a parent whose other columns change, whose index is maintained and whose rows come in does not age the child.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE dim_a (id int PRIMARY KEY, name text, updated_at timestamptz, score int) WITH (autovacuum_enabled = false);
INSERT INTO dim_a SELECT i, 'p' || i, now(), i % 100 FROM generate_series(1, 20000) i;
CREATE INDEX dim_a_col ON dim_a USING sift_col (id, name, score) WITH (track_changes = 'id');
NOTICE:  sift_col index "dim_a_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('dim_a_col');
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, amount int, body text) WITH (autovacuum_enabled = false);
-- one row in ten points at a parent row the table does not have yet
INSERT INTO facts SELECT i, 1 + (i * 7919) % 22000, i % 5, 'c' || i FROM generate_series(1, 40000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, amount) WITH (track_changes = 'id', connect = 'dim_a_id -> dim_a(id)');
NOTICE:  sift_col index "facts_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('facts_col');
VACUUM dim_a, facts;
SELECT sift.col_maintain('facts_col') AS filled;
 filled 
--------
 t
(1 row)

SELECT sift.col_maintenance_due('facts_col', true) AS due;
 due 
-----
 
(1 row)

-- six rounds of the application: a few of the parent rows change a column the index does not key, children come in and change, the tables are vacuumed and the index of the parent maintained
CREATE TABLE trail (round int, due text);
\o /dev/null
SELECT s FROM generate_series(1, 6) r, LATERAL unnest(ARRAY[
	format('UPDATE dim_a SET updated_at = now() WHERE (id + %s * 7) %% 100 < 3', r),
	format('INSERT INTO facts SELECT 100000 + %s * 1000 + i, 1 + (i * 13) %% 20000, i %% 5, ''n'' FROM generate_series(1, 200) i', r),
	format('UPDATE facts SET body = body || ''x'' WHERE id BETWEEN %s * 100 AND %s * 100 + 199', r, r),
	'VACUUM dim_a, facts',
	'SELECT sift.col_maintain(''dim_a_col'')',
	format('INSERT INTO trail SELECT %s, sift.col_maintenance_due(''facts_col'', true)', r)]) WITH ORDINALITY u(s, o) ORDER BY r, o \gexec
UPDATE dim_a SET updated_at = now() WHERE (id + 1 * 7) % 100 < 3
INSERT INTO facts SELECT 100000 + 1 * 1000 + i, 1 + (i * 13) % 20000, i % 5, 'n' FROM generate_series(1, 200) i
UPDATE facts SET body = body || 'x' WHERE id BETWEEN 1 * 100 AND 1 * 100 + 199
VACUUM dim_a, facts
SELECT sift.col_maintain('dim_a_col')
INSERT INTO trail SELECT 1, sift.col_maintenance_due('facts_col', true)
UPDATE dim_a SET updated_at = now() WHERE (id + 2 * 7) % 100 < 3
INSERT INTO facts SELECT 100000 + 2 * 1000 + i, 1 + (i * 13) % 20000, i % 5, 'n' FROM generate_series(1, 200) i
UPDATE facts SET body = body || 'x' WHERE id BETWEEN 2 * 100 AND 2 * 100 + 199
VACUUM dim_a, facts
SELECT sift.col_maintain('dim_a_col')
INSERT INTO trail SELECT 2, sift.col_maintenance_due('facts_col', true)
UPDATE dim_a SET updated_at = now() WHERE (id + 3 * 7) % 100 < 3
INSERT INTO facts SELECT 100000 + 3 * 1000 + i, 1 + (i * 13) % 20000, i % 5, 'n' FROM generate_series(1, 200) i
UPDATE facts SET body = body || 'x' WHERE id BETWEEN 3 * 100 AND 3 * 100 + 199
VACUUM dim_a, facts
SELECT sift.col_maintain('dim_a_col')
INSERT INTO trail SELECT 3, sift.col_maintenance_due('facts_col', true)
UPDATE dim_a SET updated_at = now() WHERE (id + 4 * 7) % 100 < 3
INSERT INTO facts SELECT 100000 + 4 * 1000 + i, 1 + (i * 13) % 20000, i % 5, 'n' FROM generate_series(1, 200) i
UPDATE facts SET body = body || 'x' WHERE id BETWEEN 4 * 100 AND 4 * 100 + 199
VACUUM dim_a, facts
SELECT sift.col_maintain('dim_a_col')
INSERT INTO trail SELECT 4, sift.col_maintenance_due('facts_col', true)
UPDATE dim_a SET updated_at = now() WHERE (id + 5 * 7) % 100 < 3
INSERT INTO facts SELECT 100000 + 5 * 1000 + i, 1 + (i * 13) % 20000, i % 5, 'n' FROM generate_series(1, 200) i
UPDATE facts SET body = body || 'x' WHERE id BETWEEN 5 * 100 AND 5 * 100 + 199
VACUUM dim_a, facts
SELECT sift.col_maintain('dim_a_col')
INSERT INTO trail SELECT 5, sift.col_maintenance_due('facts_col', true)
UPDATE dim_a SET updated_at = now() WHERE (id + 6 * 7) % 100 < 3
INSERT INTO facts SELECT 100000 + 6 * 1000 + i, 1 + (i * 13) % 20000, i % 5, 'n' FROM generate_series(1, 200) i
UPDATE facts SET body = body || 'x' WHERE id BETWEEN 6 * 100 AND 6 * 100 + 199
VACUUM dim_a, facts
SELECT sift.col_maintain('dim_a_col')
INSERT INTO trail SELECT 6, sift.col_maintenance_due('facts_col', true)
\o
SELECT count(*) AS rounds, count(*) FILTER (WHERE due = 'stale connection') AS rounds_stale FROM trail;
 rounds | rounds_stale 
--------+--------------
      6 |            0
(1 row)

DROP TABLE trail, facts, dim_a CASCADE;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
