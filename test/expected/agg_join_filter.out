-- An inner or semi lookup join on an integer leaf of Custom Scan (SiftAgg) tests the leaf against the keys of the loaded table before tuples are made
-- (sift.agg_join_filter; "Join Key Filters" of EXPLAIN ANALYZE): the units the keys' range misses are not read, the other rows are tested as a set.
-- Every statement is run with the filter, with sift.agg_join_filter = off and with sift.enable_agg = off: the rows (and the errors) must be the same.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET seq_page_cost = 10000; SET random_page_cost = 10000;
-- events stored in entity order, so that a set of entities is a few units
CREATE TABLE ev (id int PRIMARY KEY, dim_a_id int, small_id int2, day date, kind text, amount numeric(10, 2)) WITH (autovacuum_enabled = false);
INSERT INTO ev
SELECT i, CASE WHEN i % 997 = 0 THEN NULL ELSE 1 + (i - 1) / 20 END, (i % 50)::int2, date '2024-01-01' + i % 700, (ARRAY['a', 'b', 'c', 'd'])[1 + i % 4], (i % 1000) / 10.0
FROM generate_series(1, 300000) i;
CREATE INDEX ev_col ON ev USING sift_col (dim_a_id, small_id, day, kind, amount);
VACUUM (FREEZE, ANALYZE) ev;
-- a dimension with a duplicate key, a NULL key, keys the events do not have, a zero divisor on entities that exist, and an int8 key table
CREATE TABLE ents (id int, country int, tier int, label text);
INSERT INTO ents SELECT i, i % 60, CASE WHEN i % 10 = 0 THEN 0 ELSE 1 + i % 4 END, 'e' || i FROM generate_series(1, 15000) i;
INSERT INTO ents VALUES (11, 11, 3, 'dup'), (NULL, 11, 1, 'nokey'), (900000, 11, 1, 'far'), (-5, 11, 1, 'neg');
CREATE INDEX ents_country ON ents (country);
CREATE TABLE ents8 (id int8, grp int);
INSERT INTO ents8 SELECT i, i % 7 FROM generate_series(1, 15000) i;
INSERT INTO ents8 VALUES (5000000000, 1), (-5000000000, 1), (4294967297, 1);
CREATE TABLE pairs (dim_a_id int, small_id int2, w int);
INSERT INTO pairs SELECT 1 + i * 3, (i % 50)::int2, i FROM generate_series(0, 4000) i;
CREATE TABLE days (d date, name text);
INSERT INTO days SELECT date '2024-01-01' + i * 9, 'd' || i FROM generate_series(0, 70) i;
CREATE TABLE nothing (id int, label text);
-- entities in blocks of 250 consecutive ids per group, and a table of the groups: a join keyed by a column of the entities, not by the events
CREATE TABLE ents2 (id int, grp int);
INSERT INTO ents2 SELECT i, CASE WHEN i % 1000 = 0 THEN NULL ELSE (i - 1) / 250 END FROM generate_series(1, 15000) i;
CREATE TABLE grps (grp int, name text);
INSERT INTO grps SELECT i, 'g' || i FROM generate_series(0, 59) i;
INSERT INTO grps VALUES (7, 'g7'), (NULL, 'g7'), (900, 'far');
ANALYZE ents; ANALYZE ents8; ANALYZE pairs; ANALYZE days; ANALYZE nothing; ANALYZE ents2; ANALYZE grps;
-- the filters and pruned units of an EXPLAIN ANALYZE, and whether the plan is the pushed one
CREATE FUNCTION plan_of(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'normal';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF l LIKE '%Custom Scan (SiftAgg)%' THEN r := 'SiftAgg'; END IF;
		IF l LIKE '%Join Key Filters:%' THEN r := r || ' key filters ' || trim(split_part(l, ':', 2)); END IF;
		IF l LIKE '%Units Pruned: _%' AND l NOT LIKE '%Units Pruned: 0%' THEN r := r || ' units pruned'; END IF;
		IF l LIKE '%Workers Launched: _%' AND l NOT LIKE '%Workers Launched: 0%' THEN r := r || ' with workers'; END IF;
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION same(q text) RETURNS TABLE (plan text, result_rows bigint, vs_no_filter bigint, vs_normal_plan bigint) LANGUAGE plpgsql AS $$
BEGIN
	plan := plan_of(q);
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS %s', q);
	SET LOCAL sift.agg_join_filter = off;
	EXECUTE format('CREATE TEMP TABLE r_gen ON COMMIT DROP AS %s', q);
	RESET sift.agg_join_filter;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS %s', q);
	RESET sift.enable_agg;
	result_rows := (SELECT count(*) FROM r_on);
	vs_no_filter := (SELECT count(*) FROM ((TABLE r_on EXCEPT TABLE r_gen) UNION ALL (TABLE r_gen EXCEPT TABLE r_on)) d);
	vs_normal_plan := (SELECT count(*) FROM ((TABLE r_on EXCEPT TABLE r_off) UNION ALL (TABLE r_off EXCEPT TABLE r_on)) d);
	DROP TABLE r_on, r_gen, r_off;
	RETURN NEXT;
END $$;
-- an inner join that returns a column of the table, selective (a country: its keys span the events, 1,500 of the 15,000 entities) and a few entities
SELECT * FROM same($$SELECT e.country, e.tier, count(*) AS n, sum(amount) AS s FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = 7 GROUP BY 1, 2$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT e.label, count(*) AS n, sum(amount) AS s FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.id < 40 AND e.country = e.id % 60 GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |          40 |            0 |              0
(1 row)

-- the duplicate key multiplies the events of its entity; a NULL key, a key far away and a negative one match nothing
SELECT * FROM same($$SELECT e.label, count(*) AS n FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = 11 GROUP BY 1$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |         251 |            0 |              0
(1 row)

-- the whole table, the leaves' own filters, and a table with no rows or no matching row
SELECT * FROM same($$SELECT e.country, count(*) AS n FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE day >= '2025-01-01' AND small_id < 30 GROUP BY 1$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |          60 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev JOIN nothing e ON e.id = ev.dim_a_id$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n, sum(amount) AS s FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = 999$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           1 |            0 |              0
(1 row)

-- semi joins: IN and EXISTS
SELECT * FROM same($$SELECT kind, count(*) AS n FROM ev WHERE dim_a_id IN (SELECT id FROM ents WHERE country = 7) GROUP BY kind$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           4 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT kind, count(*) AS n FROM ev WHERE EXISTS (SELECT 1 FROM ents e WHERE e.id = ev.dim_a_id AND e.tier = 2) GROUP BY kind$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           4 |            0 |              0
(1 row)

-- two joins on two leaves, a join on two keys, an int8 key table (keys past int4 match no event), a date key
SELECT * FROM same($$SELECT e.country, d.name, count(*) AS n FROM ev JOIN ents e ON e.id = ev.dim_a_id JOIN days d ON d.d = ev.day WHERE e.country < 3 GROUP BY 1, 2$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 2 |          43 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT p.w % 5 AS w, count(*) AS n FROM ev JOIN pairs p ON p.dim_a_id = ev.dim_a_id AND p.small_id = ev.small_id GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 2 units pruned |           5 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT e.grp, count(*) AS n FROM ev JOIN ents8 e ON e.id = ev.dim_a_id GROUP BY 1$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           7 |            0 |              0
(1 row)

-- a table joined to another joined table by their key is probed with the key of the events: its keys filter the events and prune units too
SELECT * FROM same($$WITH ks AS MATERIALIZED (SELECT id FROM ents WHERE id IN (5, 4000, 11)) SELECT e.label, count(*) AS n, sum(amount) AS s FROM ev JOIN ents e ON e.id = ev.dim_a_id JOIN ks ON ks.id = e.id GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 2 units pruned |           4 |            0 |              0
(1 row)

SELECT * FROM same($$WITH ks AS MATERIALIZED (SELECT id FROM ents WHERE id IN (5, 4000)) SELECT e.label, count(*) AS n FROM ev JOIN ents e ON ev.dim_a_id = e.id JOIN ks ON e.id = ks.id GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 2 units pruned |           2 |            0 |              0
(1 row)

SELECT * FROM same($$WITH ks AS MATERIALIZED (SELECT id FROM ents WHERE id IN (5, 4000)), ks2 AS MATERIALIZED (SELECT id FROM ks) SELECT e.label, count(*) AS n FROM ev JOIN ents e ON e.id = ev.dim_a_id JOIN ks ON ks.id = e.id JOIN ks2 ON ks2.id = ks.id GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 3 units pruned |           2 |            0 |              0
(1 row)

-- a key of another type, a key of another column and a LEFT join in the chain keep the chain: the same rows
SELECT * FROM same($$SELECT e.label, count(*) AS n FROM ev JOIN ents e ON e.id = ev.dim_a_id JOIN ents8 e8 ON e8.id = e.id WHERE e8.id IN (5, 4000) GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |           2 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT e.label, count(*) AS n FROM ev JOIN ents e ON e.id = ev.dim_a_id LEFT JOIN ents e2 ON e2.id = e.id AND e2.id IN (5, 4000) GROUP BY 1 ORDER BY 2 DESC, 1 LIMIT 5$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           5 |            0 |              0
(1 row)

-- a LEFT join and an anti join keep the tuples without a match: no filter
SELECT * FROM same($$SELECT e.country, count(*) AS n FROM ev LEFT JOIN ents e ON e.id = ev.dim_a_id AND e.country = 7 GROUP BY 1$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           2 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT kind, count(*) AS n FROM ev WHERE NOT EXISTS (SELECT 1 FROM ents e WHERE e.id = ev.dim_a_id AND e.country = 7) GROUP BY kind$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           4 |            0 |              0
(1 row)

-- a sub-select as the table
SELECT * FROM same($$SELECT s.c, count(*) AS n FROM ev JOIN (SELECT id, country AS c FROM ents WHERE country < 4 ORDER BY id LIMIT 500) s ON s.id = ev.dim_a_id GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |           4 |            0 |              0
(1 row)

-- a join keyed by a column of the entities' table drops the entities it has no match for: only their events can make a tuple, so they are the keys of the filter
SELECT * FROM same($$SELECT e.grp, count(*) AS n, sum(amount) AS s FROM ev JOIN ents2 e ON e.id = ev.dim_a_id JOIN grps g ON g.grp = e.grp WHERE g.name = 'g7' GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev JOIN ents2 e ON e.id = ev.dim_a_id JOIN grps g ON g.grp = e.grp WHERE g.name = 'far'$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT g.name, count(*) AS n FROM ev JOIN ents2 e ON e.id = ev.dim_a_id JOIN grps g ON g.grp = e.grp WHERE g.grp IN (3, 4) GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |           2 |            0 |              0
(1 row)

-- a LEFT join keyed by the same column keeps the entities without a match: no reduction
SELECT * FROM same($$SELECT g.name, count(*) AS n FROM ev JOIN ents2 e ON e.id = ev.dim_a_id LEFT JOIN grps g ON g.grp = e.grp AND g.name = 'g7' WHERE e.id < 1000 GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |           1 |            0 |              0
(1 row)

-- a calendar LEFT JOIN rows: the inner joins of the rows filter the events ahead of the preserved join, so their keys prune units and test rows as well; a period without events stays
SELECT * FROM same($$WITH periods AS (SELECT * FROM (VALUES ('a', daterange('2024-02-01', '2024-04-01', '[]')), ('b', daterange('2024-06-01', '2024-07-01', '[]')), ('c', daterange('2030-01-01', '2030-02-01', '[]'))) p (period, range)),
 all_dates AS (SELECT period FROM periods),
 rev AS (SELECT ev.id, ev.amount, periods.period AS bucket FROM ev JOIN periods ON ev.day <@ range JOIN ents2 e ON e.id = ev.dim_a_id WHERE e.grp = 7)
 SELECT all_dates.period, count(DISTINCT rev.id) AS n, sum(rev.amount) AS total FROM all_dates LEFT JOIN rev ON rev.bucket = all_dates.period GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg key filters 1 units pruned |           3 |            0 |              0
(1 row)

-- a divisor that is zero only on entities outside the table's rows is never evaluated for their events, as in the normal plan; a zero on a matching one raises the same error
SELECT * FROM same($$SELECT count(*) AS n, sum(amount / e.tier) AS s FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = 7 AND e.tier > 0$$);
         plan          | result_rows | vs_no_filter | vs_normal_plan 
-----------------------+-------------+--------------+----------------
 SiftAgg key filters 1 |           1 |            0 |              0
(1 row)

CREATE FUNCTION error_of(q text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN EXECUTE q; RETURN 'no error'; EXCEPTION WHEN OTHERS THEN RETURN SQLSTATE; END $$;
SELECT error_of($$SELECT sum(amount / e.tier) FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = 10$$) AS filter;
 filter 
--------
 22012
(1 row)

SET sift.agg_join_filter = off;
SELECT error_of($$SELECT sum(amount / e.tier) FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = 10$$) AS no_filter;
 no_filter 
-----------
 22012
(1 row)

RESET sift.agg_join_filter;
SET sift.enable_agg = off;
SELECT error_of($$SELECT sum(amount / e.tier) FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = 10$$) AS normal_plan;
 normal_plan 
-------------
 22012
(1 row)

RESET sift.enable_agg;
DROP FUNCTION error_of(text);
-- parallel workers build their own sets
SET max_parallel_workers_per_gather = 2; SET parallel_setup_cost = 0; SET parallel_tuple_cost = 0; SET min_parallel_table_scan_size = 0; SET min_parallel_index_scan_size = 0;
SELECT * FROM same($$SELECT e.country, count(*) AS n, sum(amount) AS s FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country < 5 GROUP BY 1$$);
                plan                | result_rows | vs_no_filter | vs_normal_plan 
------------------------------------+-------------+--------------+----------------
 SiftAgg with workers key filters 1 |           5 |            0 |              0
(1 row)

RESET max_parallel_workers_per_gather;
-- a prepared statement with a parameter in the table's condition, run again with another value and with the filter off
PREPARE by_country(int) AS SELECT e.country, count(*) AS n FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.country = $1 GROUP BY 1;
EXECUTE by_country(3);
 country |  n   
---------+------
       3 | 4995
(1 row)

EXECUTE by_country(4);
 country |  n   
---------+------
       4 | 4996
(1 row)

SET sift.agg_join_filter = off;
EXECUTE by_country(3);
 country |  n   
---------+------
       3 | 4995
(1 row)

RESET sift.agg_join_filter;
-- keys spread over more than 4 million values: a unit whose zone holds none of them is not read, though the range of the keys covers every zone
CREATE TABLE ev_far (id int, dim_a_id int, amount numeric(10, 2));
INSERT INTO ev_far SELECT i, 1 + (i - 1) / 20 * 1000, (i % 100)::numeric FROM generate_series(1, 300000) i;
CREATE INDEX ev_far_col ON ev_far USING sift_col (dim_a_id, amount);
CREATE TABLE ents_far (id int, label text);
INSERT INTO ents_far VALUES (1, 'a'), (5001, 'b'), (9000001, 'c'), (14000001, 'd'), (-7, 'none'), (NULL, 'nokey');
VACUUM (FREEZE, ANALYZE) ev_far;
ANALYZE ents_far;
SELECT * FROM same($$SELECT e.label, count(*) AS n, sum(amount) AS s FROM ev_far JOIN ents_far e ON e.id = ev_far.dim_a_id GROUP BY 1$$);
                      plan                       | result_rows | vs_no_filter | vs_normal_plan 
-------------------------------------------------+-------------+--------------+----------------
 SiftAgg with workers key filters 1 units pruned |           4 |            0 |              0
(1 row)

-- no unit holds a histogram of dim_a_id (too many groups): the units left are scanned, and with the free parallel costs set above the workers price lower
SELECT * FROM same($$SELECT count(*) AS n FROM ev_far WHERE dim_a_id IN (5001, 9000001, 14000001, 3)$$);
               plan                | result_rows | vs_no_filter | vs_normal_plan 
-----------------------------------+-------------+--------------+----------------
 SiftAgg with workers units pruned |           1 |            0 |              0
(1 row)

-- the cost of the SiftAgg node follows the units the keys leave: two entities cost less than all of them, and less with the filter than without
CREATE FUNCTION agg_cost_of(q text) RETURNS float8 LANGUAGE plpgsql AS $$
DECLARE j json;
BEGIN
	EXECUTE 'EXPLAIN (FORMAT JSON) ' || q INTO j;
	IF j::text NOT LIKE '%"SiftAgg"%' THEN RETURN NULL; END IF;
	RETURN (j -> 0 -> 'Plan' ->> 'Total Cost')::float8;
END $$;
SELECT agg_cost_of($$SELECT e.label, count(*) FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.id IN (5, 4000) GROUP BY 1$$) <
       agg_cost_of($$SELECT e.label, count(*) FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.id < 15000 GROUP BY 1$$) AS fewer_keys_cost_less;
 fewer_keys_cost_less 
----------------------
 t
(1 row)

CREATE TEMP TABLE with_filter AS SELECT agg_cost_of($$SELECT e.label, count(*) FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.id IN (5, 4000) GROUP BY 1$$) AS c;
SET sift.agg_join_filter = off;
SELECT agg_cost_of($$SELECT e.label, count(*) FROM ev JOIN ents e ON e.id = ev.dim_a_id WHERE e.id IN (5, 4000) GROUP BY 1$$) > (SELECT c FROM with_filter) AS filter_costs_less;
 filter_costs_less 
-------------------
 t
(1 row)

RESET sift.agg_join_filter;
DROP TABLE with_filter;
DROP FUNCTION agg_cost_of(text);
DROP FUNCTION same(text);
DROP FUNCTION plan_of(text);
DROP TABLE ev, ents, ents8, pairs, days, nothing, ev_far, ents_far, ents2, grps;
DROP EXTENSION pg_sift;
