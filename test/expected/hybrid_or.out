(21 rows)

-- in the transaction that changes them
BEGIN;
UPDATE oc_col SET tenant = 5, body = 'rareterm moved' WHERE id % 777 = 3;
UPDATE oc_tbl SET tenant = 5, body = 'rareterm moved' WHERE id % 777 = 3;
DELETE FROM oc_col WHERE id % 333 = 1;
DELETE FROM oc_tbl WHERE id % 333 = 1;
INSERT INTO oc_col VALUES (50001, 5, 2, 'r0', 'inside'), (50002, 1, 2, 'r0', 'rareterm inside');
INSERT INTO oc_tbl VALUES (50001, 5, 2, 'r0', 'inside'), (50002, 1, 2, 'r0', 'rareterm inside');
SELECT n, tbl, s.* FROM oc_q, LATERAL oc_same(body) s WHERE n IN (1, 2, 5, 6) ORDER BY n, tbl;
 n |  tbl   |       node        | rows  | diff 
---+--------+-------------------+-------+------
 1 | oc_col | SiftHybridScan OR |   271 |    0
 1 | oc_tbl | SiftHybridScan OR |   271 |    0
 2 | oc_col | SiftHybridScan OR |  5888 |    0
 2 | oc_tbl | SiftHybridScan OR |  5888 |    0
 5 | oc_col | SiftHybridScan OR |   139 |    0
 5 | oc_tbl | SiftHybridScan OR |   139 |    0
 6 | oc_col | SiftHybridScan OR | 13322 |    0
 6 | oc_tbl | SiftHybridScan OR | 13322 |    0
(8 rows)

ROLLBACK;
DROP TABLE oc_q, oc_col, oc_tbl;
DROP FUNCTION oc_node, oc_cmp, oc_same;
DROP EXTENSION pg_sift;
