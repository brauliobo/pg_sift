(1 row)

-- minor 3 writes no tags: the stored values still count, an overflow value has no type
DROP INDEX d_col;
SET sift.col_format_minor = 3;
CREATE INDEX d_col ON d USING sift_col (id, doc) WITH (paths = 'doc.m float8, doc.n int4, doc.s text, doc.b bool, doc.o.v int4, doc.a astext');
SELECT fmt('d_col');
 fmt 
-----
 3
(1 row)

SELECT leaf, type, idx_rows, heap_rows, allknown FROM (VALUES ('m', 1, 2), ('b', 4, 3)) k(leaf, n, own),
	LATERAL types('d_col', k.n, ARRAY[k.leaf], k.own) r
	WHERE type IN ('number', 'boolean') ORDER BY leaf, type;
 leaf |  type   | idx_rows | heap_rows | allknown 
------+---------+----------+-----------+----------
 b    | boolean |    15000 |     15000 | f
 b    | number  |        0 |      2500 | f
 m    | boolean |        0 |      2500 | f
 m    | number  |    12500 |     15000 | f
(4 rows)

SELECT sift.col_verify('d_col', true);
 col_verify 
------------
 
(1 row)

-- rows added under minor 4 sit in the write buffer with their types, are promoted to a minor 4 segment, and the merge with the minor 3 one
-- gives the old overflow values no type again
RESET sift.col_format_minor;
INSERT INTO d SELECT g, doc(g) FROM generate_series(30001, 40000) g;
SELECT * FROM unit_kinds('d_col');
 buffered_known | segment_known | segment_unknown 
----------------+---------------+-----------------
 t              | f             | t
(1 row)

SELECT sift.col_promote('d_col');
 col_promote 
-------------
           1
(1 row)

SELECT fmt('d_col');
 fmt 
-----
 3,4
(1 row)

SELECT * FROM unit_kinds('d_col');
 buffered_known | segment_known | segment_unknown 
----------------+---------------+-----------------
 f              | t             | t
(1 row)

SELECT sift.col_merge('d_col', true);
 col_merge 
-----------
         1
(1 row)

SELECT fmt('d_col');
 fmt 
-----
 4
(1 row)

SELECT * FROM unit_kinds('d_col');
 buffered_known | segment_known | segment_unknown 
----------------+---------------+-----------------
 f              | t             | t
(1 row)

SELECT sift.col_verify('d_col', true);
 col_verify 
------------
 
(1 row)

-- REINDEX writes the types again
REINDEX INDEX d_col;
SELECT fmt('d_col');
 fmt 
-----
 4
(1 row)

SELECT * FROM all_types('d_col') WHERE NOT same OR NOT allknown;
 leaf | type | same | allknown 
------+------+------+----------
(0 rows)

SELECT count(*) AS rows_checked FROM all_types('d_col');
 rows_checked 
--------------
           42
(1 row)

-- without an overflow value a minor 4 unit still tells a JSON null from a missing key; a minor 3 one cannot, but it knows the types that do not need it
CREATE TABLE z (id int, doc jsonb);
INSERT INTO z SELECT g, CASE g % 3 WHEN 0 THEN '{"m": 1}' WHEN 1 THEN '{"m": null}' ELSE '{}' END::jsonb FROM generate_series(1, 3000) g;
CREATE FUNCTION z_types(idx regclass) RETURNS TABLE (type text, idx_rows int8, known bool) LANGUAGE sql AS
$$ SELECT t.name, sum(u.matched)::int8, bool_and(u.known)
	FROM (VALUES ('number', 2), ('none', 6), ('null', 7)) t(name, tag), LATERAL sift._test_col_types(idx, 0, 1 << t.tag, 2) u
	GROUP BY t.name, t.tag ORDER BY t.tag $$;
SET sift.col_format_minor = 3;
CREATE INDEX z3_col ON z USING sift_col (doc) WITH (paths = 'doc.m int4');
RESET sift.col_format_minor;
CREATE INDEX z4_col ON z USING sift_col (doc) WITH (paths = 'doc.m int4');
SELECT * FROM z_types('z3_col');
  type  | idx_rows | known 
--------+----------+-------
 number |     1000 | t
 none   |     2000 | f
 null   |        0 | f
(3 rows)

SELECT * FROM z_types('z4_col');
  type  | idx_rows | known 
--------+----------+-------
 number |     1000 | t
 none   |     1000 | t
 null   |     1000 | t
(3 rows)

-- verification: the type of a buffered overflow value is a tag, and it is the type of the heap value; the flag of a segment follows its minor
CREATE FUNCTION expect(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	d text;
BEGIN
	EXECUTE q;
	RETURN 'ok';
EXCEPTION WHEN OTHERS THEN
	GET STACKED DIAGNOSTICS d = PG_EXCEPTION_DETAIL;
	RETURN regexp_replace(SQLSTATE || ': ' || SQLERRM || coalesce(' | ' || nullif(d, ''), ''), '[0-9]+', 'N', 'g');
END $$;
CREATE TABLE w (id int, doc jsonb);
CREATE INDEX w_idx ON w USING sift_col (doc) WITH (paths = 'doc.m float8');
INSERT INTO w VALUES (1, '{"m": "str"}');
CREATE TABLE pages AS SELECT b AS blk, pg.type, pg.lower FROM generate_series(0, pg_relation_size('w_idx') / 8192 - 1) b, LATERAL sift._test_page('w_idx', b) pg;
-- the first record of the buffer: its head follows the page head at 32, its first flag byte is at 44 (3: null and overflow, the type in the high nibble)
SELECT min(blk) AS rec_page FROM pages WHERE type = 7 AND lower > 32 \gset
SELECT sift._test_poke('w_idx', :rec_page, 44, 2 * 16 + 3, 1);
 _test_poke 
------------
 
(1 row)

SELECT expect($$ SELECT sift.col_verify('w_idx', true) $$);
                                                        expect                                                        
----------------------------------------------------------------------------------------------------------------------
 XXN: sift index "w_idx" is corrupted | The types of the overflow values of heap tuple (N,N) differ from the index's.
(1 row)

SELECT sift._test_poke('w_idx', :rec_page, 44, 7 * 16 + 3, 1);
 _test_poke 
------------
 
(1 row)

SELECT expect($$ SELECT sift.col_verify('w_idx', true) $$);
                                          expect                                          
------------------------------------------------------------------------------------------
 XXN: sift index "w_idx" is corrupted | A record of write buffer N has the flag byte NxN.
(1 row)

SELECT sift._test_poke('w_idx', :rec_page, 44, 1 * 16 + 3, 1);
 _test_poke 
------------
 
(1 row)

SELECT expect($$ SELECT sift.col_verify('w_idx', true) $$);
 expect 
--------
 ok
(1 row)

SELECT sift.col_promote('w_idx');
 col_promote 
-------------
           1
(1 row)

-- the directory entry of the segment says minor 3 or minor 4 (generation at 32, the minor 9 bytes after)
SELECT sift._test_poke('w_idx', 1, 41, 3, 1);
 _test_poke 
------------
 
(1 row)

SELECT expect($$ SELECT sift.col_verify('w_idx', false) $$);
                                                                               expect                                                                                
---------------------------------------------------------------------------------------------------------------------------------------------------------------------
 XXN: sift index "w_idx" segment N is corrupted | The pre-aggregates start with NxNcNfN, version N, N leaves, N units; a segment of column format N.N has version N.
(1 row)

SELECT sift._test_poke('w_idx', 1, 41, 4, 1);
 _test_poke 
------------
 
(1 row)

SELECT expect($$ SELECT sift.col_verify('w_idx', true) $$);
 expect 
--------
 ok
(1 row)

SET sift.col_format_minor = 3;
CREATE INDEX w3_idx ON w USING sift_col (doc) WITH (paths = 'doc.m float8');
RESET sift.col_format_minor;
SELECT sift._test_poke('w3_idx', 1, 41, 4, 1);
 _test_poke 
------------
 
(1 row)

SELECT expect($$ SELECT sift.col_verify('w3_idx', false) $$);
                                                           expect                                                           
----------------------------------------------------------------------------------------------------------------------------
 XXN: sift index "wN_idx" segment N is corrupted | The ZONES section holds N bytes, no room for the pre-aggregates after N.
(1 row)

DROP TABLE d, w, z, pages;
DROP FUNCTION expect(text);
DROP FUNCTION doc(int), fmt(regclass), types(regclass, int, text[], int, bool), all_types(regclass), unit_kinds(regclass), z_types(regclass);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
