-- a bit flipped, one at a time, in the section of the tables in the stream (every 5th byte of a table): the reader or the check against the units refuses each.
-- Each flip opens and verifies the whole segment, so the cost grows with the square of the rows: two units of the table
CREATE TABLE kt_f (LIKE kt) WITH (autovacuum_enabled = off);
ALTER TABLE kt_f ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO kt_f SELECT * FROM kt WHERE id <= 9000 ORDER BY id;
VACUUM (FREEZE, ANALYZE) kt_f;
CREATE INDEX kt_f_on ON kt_f USING sift_col (id, grp_id, ts, d, amt, val, mid_id, many_id, pad) WITH (write_buffer_limit = 4096);
SELECT runs > 0 AS has_sections, damaged > 500 AS many, refused > 0 AS some_refused, unnoticed FROM sift._test_col_ktab_file_damage('kt_f_on', 5);
 has_sections | many | some_refused | unnoticed 
--------------+------+--------------+-----------
 t            | t    | t            |         0
(1 row)

DROP TABLE kt_f;
