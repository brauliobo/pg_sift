(22 rows)

-- what stays on the leader says why in EXPLAIN VERBOSE: the aggregate whose partial state the leader cannot merge
CREATE FUNCTION serial_because(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := '';
BEGIN
	PERFORM set_config('sift.enable_agg', 'on', true);
	PERFORM set_config('max_parallel_workers_per_gather', '4', true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF, VERBOSE) ' || q LOOP
		IF l LIKE '%Serial Because%' THEN r := btrim(l); END IF;
	END LOOP;
	RETURN r;
END $$;
SELECT mode_of('SELECT grp, string_agg(DISTINCT kind, '','') FROM facts GROUP BY grp', 4) AS string_agg_mode,
       serial_because('SELECT grp, string_agg(DISTINCT kind, '','') FROM facts GROUP BY grp') AS string_agg_why,
       serial_because('SELECT grp, count(DISTINCT amount) FROM facts GROUP BY grp') AS count_distinct_why;
 string_agg_mode |                                                   string_agg_why                                                    | count_distinct_why 
-----------------+---------------------------------------------------------------------------------------------------------------------+--------------------
 serial          | Serial Because: string_agg(DISTINCT facts.kind, ','::text): DISTINCT keeps the values of a group in one sort or set | 
(1 row)

DROP TABLE facts, shapes;
DROP EXTENSION pg_sift;
DROP FUNCTION mode_of, rows_of, serial_because;
