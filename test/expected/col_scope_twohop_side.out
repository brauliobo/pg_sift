-- a scope of two paths with the union as the statement writes it (the recognised form) takes the runs as the function does
SET sift.test_scope_entity = on;
SET sift.enable_agg = on;
SELECT runs_of($q$SELECT kind, count(*) FROM facts f WHERE f.dim_a_id IN (
	SELECT dim_a_id FROM grants WHERE tenant_id = 2 AND dim_a_id IS NOT NULL AND deleted_at IS NULL
	UNION SELECT m.dim_a_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.tenant_id = 2 AND g.deleted_at IS NULL AND m.deleted_at IS NULL) GROUP BY kind$q$) > 0 AS union_statement_takes_runs;
 union_statement_takes_runs 
----------------------------
 t
(1 row)

