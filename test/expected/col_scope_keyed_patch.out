INSERT INTO lines1 SELECT 1, 2, 'a pair soft deleted', l.* FROM state_line1(1) l
INSERT INTO lines1 SELECT 2, 2, 'a pair soft deleted', l.* FROM state_line1(2) l
REINDEX INDEX facts1_col
DELETE FROM tenant_scope WHERE dim_a_id = 7
INSERT INTO lines1 SELECT 1, 3, 'a pair deleted', l.* FROM state_line1(1) l
INSERT INTO lines1 SELECT 2, 3, 'a pair deleted', l.* FROM state_line1(2) l
REINDEX INDEX facts1_col
UPDATE tenant_scope SET tenant_id = 6 WHERE dim_a_id = 8
INSERT INTO lines1 SELECT 1, 4, 'a pair moved to another key', l.* FROM state_line1(1) l
INSERT INTO lines1 SELECT 2, 4, 'a pair moved to another key', l.* FROM state_line1(2) l
REINDEX INDEX facts1_col
UPDATE tenant_scope SET deleted_at = NULL WHERE dim_a_id = 30 AND tenant_id = 5
INSERT INTO lines1 SELECT 1, 5, 'a soft deleted pair restored', l.* FROM state_line1(1) l
INSERT INTO lines1 SELECT 2, 5, 'a soft deleted pair restored', l.* FROM state_line1(2) l
REINDEX INDEX facts1_col
