INSERT INTO lines1 SELECT 1, 6, 'an update that keeps every column', l.* FROM state_line1(1) l
INSERT INTO lines1 SELECT 2, 6, 'an update that keeps every column', l.* FROM state_line1(2) l
REINDEX INDEX facts1_col
DELETE FROM tenant_scope WHERE tenant_id = 3 AND dim_a_id < 40
INSERT INTO lines1 SELECT 1, 7, 'twenty dim_a_id values of one key deleted', l.* FROM state_line1(1) l
INSERT INTO lines1 SELECT 2, 7, 'twenty dim_a_id values of one key deleted', l.* FROM state_line1(2) l
SELECT n, label, same, stored, changed, patched FROM lines1 WHERE route = 2 ORDER BY n;
