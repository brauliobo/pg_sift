INSERT INTO lines SELECT 1, 1, 'a direct grant of tenant 3 to a new dim_a_id', l.* FROM state_line(1) l
INSERT INTO lines SELECT 2, 1, 'a direct grant of tenant 3 to a new dim_a_id', l.* FROM state_line(2) l
