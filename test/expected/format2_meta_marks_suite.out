        dead        | parts | granules | with_dead | corrected | rescanned | mismatched 
--------------------+-------+----------+-----------+-----------+-----------+------------
 about five percent |     1 |        5 |         5 |         3 |         2 |          0
(1 row)

SELECT f2_same('SELECT g, count(*), sum(v) FROM pa WHERE id BETWEEN 1 AND 39500 GROUP BY g');
