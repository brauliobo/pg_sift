 3 | SELECT g, k FROM pa WHERE g BETWEEN 10 AND 30 ORDER BY g, k |  6349 | t     |             1 |     0
(3 rows)

-- after a vacuum (pages all-visible, the dead entries gone from the heap), and rows put at the addresses it freed
VACUUM pa;
VACUUM pb;
VACUUM pd;
