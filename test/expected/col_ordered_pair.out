-- An index-only scan of a sift_col index on its first two columns (g, k) gives the rows ordered by both when the plan reads those alone and g is NOT NULL: the second order of k
-- grouped by g, read group after group (the groups ascending, descending for ORDER BY g DESC, k DESC; NULL k last, first for DESC). The rows must be the heap's, in order, after deletes,
-- updates (of k, and of g: the row changes group), rows in the write buffer (a group it alone has too), a transaction's own changes and a vacuum; a table with no such order sorts.
CREATE EXTENSION pg_sift;
SET sift.async_maintenance = off;
SET client_min_messages = warning;
CREATE TABLE pa (id int, g int4 NOT NULL, k int4, pad text DEFAULT repeat('x', 100));
ALTER TABLE pa ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO pa (id, g, k) SELECT i, i % 40, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 7919) % 301 - 150 END FROM generate_series(1, 12000) i;
CREATE INDEX pa_i ON pa USING sift_col (g, k, id) WITH (count_columns = 'off', write_buffer_limit = 512, order_array_columns = 'k', order_array_group = 'g', order_layout = 'whole');
-- many small groups, int8 keys, a negative group, a date group
CREATE TABLE pb (id int, g int8 NOT NULL, k int8, pad text DEFAULT repeat('x', 100));
ALTER TABLE pb ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO pb (id, g, k) SELECT i, (i % 3000) - 1000, CASE WHEN i % 7 = 0 THEN NULL ELSE (i * 104729::int8) % 5003 - 2500 END FROM generate_series(1, 9000) i;
CREATE INDEX pb_i ON pb USING sift_col (g, k, id) WITH (count_columns = 'off', write_buffer_limit = 512, order_array_columns = 'k', order_array_group = 'g', order_layout = 'whole');
CREATE TABLE pd (id int, g date NOT NULL, k timestamp, pad text DEFAULT repeat('x', 100));
ALTER TABLE pd ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO pd (id, g, k) SELECT i, date '2024-01-01' + i % 30, CASE WHEN i % 9 = 0 THEN NULL ELSE timestamp '2024-01-01' + ((i * 7919) % 100000) * interval '1 minute' END FROM generate_series(1, 6000) i;
CREATE INDEX pd_i ON pd USING sift_col (g, k, id) WITH (count_columns = 'off', write_buffer_limit = 512, order_array_columns = 'k', order_array_group = 'g', order_layout = 'whole');
-- no order of the pair to read: compact chunks, a nullable g, and a second order grouped by another column
CREATE TABLE pc (id int, g int4 NOT NULL, k int4);
INSERT INTO pc SELECT i, i % 40, CASE WHEN i % 29 = 0 THEN NULL ELSE ((i::int8 * 2654435761) % 1000000007)::int END FROM generate_series(1, 36000) i;
CREATE INDEX pc_i ON pc USING sift_col (g, k, id) WITH (count_columns = 'off', order_array_columns = 'k', order_array_group = 'g', order_layout = 'compact');
CREATE TABLE pn (id int, g int4, k int4);
INSERT INTO pn SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE i % 40 END, (i * 7919) % 301 FROM generate_series(1, 6000) i;
CREATE INDEX pn_i ON pn USING sift_col (g, k, id) WITH (count_columns = 'off', order_array_columns = 'k', order_array_group = 'g', order_layout = 'whole');
CREATE TABLE po (id int, g int4 NOT NULL, h int4 NOT NULL, k int4);
INSERT INTO po SELECT i, i % 40, i % 7, (i * 7919) % 301 FROM generate_series(1, 6000) i;
CREATE INDEX po_i ON po USING sift_col (g, k, h) WITH (count_columns = 'off', order_array_columns = 'k', order_array_group = 'h', order_layout = 'whole');
-- a second table of the same shape, for a merge join on both columns (it marks the position at the start of a run of equal (g, k) and goes back to it)
CREATE TABLE pe (id int, g int4 NOT NULL, k int4);
INSERT INTO pe SELECT i, (i * 3) % 40, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 104729) % 301 - 150 END FROM generate_series(1, 9000) i;
CREATE INDEX pe_i ON pe USING sift_col (g, k, id) WITH (count_columns = 'off', order_array_columns = 'k', order_array_group = 'g', order_layout = 'whole');
VACUUM (ANALYZE) pe;
-- every (g, k) three times, in 10 groups: the run of equal keys of a merge join ends at the first row of the next group, and the rows it marked are given again with their own g
CREATE TABLE pf (id int, g int4 NOT NULL, k int4);
INSERT INTO pf SELECT i, i / 600, (i / 3) % 200 FROM generate_series(0, 5999) i;
CREATE INDEX pf_i ON pf USING sift_col (g, k, id) WITH (count_columns = 'off', order_array_columns = 'k', order_array_group = 'g', order_layout = 'whole');
VACUUM (ANALYZE) pf;
-- partitions: a Merge Append of the pair scans of the partitions
CREATE TABLE pt (id int, g int4 NOT NULL, k int4) PARTITION BY HASH (id);
CREATE TABLE pt0 PARTITION OF pt FOR VALUES WITH (MODULUS 3, REMAINDER 0);
CREATE TABLE pt1 PARTITION OF pt FOR VALUES WITH (MODULUS 3, REMAINDER 1);
CREATE TABLE pt2 PARTITION OF pt FOR VALUES WITH (MODULUS 3, REMAINDER 2);
INSERT INTO pt SELECT i, i % 90, CASE WHEN i % 13 = 0 THEN NULL ELSE (i * 7919) % 5003 END FROM generate_series(1, 18000) i;
CREATE INDEX pt_i ON pt USING sift_col (g, k, id) WITH (count_columns = 'off', order_array_columns = 'k', order_array_group = 'g', order_layout = 'whole');
VACUUM (ANALYZE) pa;
VACUUM (ANALYZE) pt;
VACUUM (ANALYZE) pb;
VACUUM (ANALYZE) pc;
VACUUM (ANALYZE) pd;
VACUUM (ANALYZE) pn;
VACUUM (ANALYZE) po;
-- the rows of q as the plan gives them, in the order it gives them (the ordered scan, or the heap and a Sort with sift off); the digest covers both columns
CREATE FUNCTION pa_run(q text, ios bool, OUT n bigint, OUT md5 text, OUT scans int, OUT sorts int) LANGUAGE plpgsql AS $$
DECLARE line text;
BEGIN
	PERFORM set_config('sift.enable_agg', 'off', true);
	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	PERFORM set_config('sift.enable_col_scan', ios::text, true);
	PERFORM set_config('enable_seqscan', (NOT ios)::text, true);
	PERFORM set_config('enable_sort', (NOT ios)::text, true);
	PERFORM set_config('enable_bitmapscan', 'false', true);
	PERFORM set_config('enable_hashagg', 'false', true);
	PERFORM set_config('enable_hashjoin', 'false', true);
	PERFORM set_config('enable_nestloop', 'false', true);
	PERFORM set_config('enable_material', 'false', true);
	scans := 0;
	sorts := 0;
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF line ~ 'Index Only Scan (Backward )?using p[a-z0-9]*_(i|g_k_id_idx)' THEN scans := scans + 1; END IF;
		IF line ~ '^ *(->  )?(Incremental )?Sort$' THEN sorts := sorts + 1; END IF;
	END LOOP;
	EXECUTE 'SELECT count(*), md5(string_agg(g::text || '':'' || coalesce(k::text, ''null''), ''|'')) FROM (' || q || ') w' INTO n, md5;
END $$;
CREATE FUNCTION pa_check(q text, OUT rows bigint, OUT agree bool, OUT ordered_scans int, OUT sorts int) LANGUAGE plpgsql AS $$
DECLARE a record; h record;
BEGIN
	SELECT * INTO a FROM pa_run(q, true);
	SELECT * INTO h FROM pa_run(q, false);
	rows := h.n; agree := a.n = h.n AND a.md5 IS NOT DISTINCT FROM h.md5; ordered_scans := a.scans; sorts := a.sorts;
	IF NOT agree THEN
		RAISE EXCEPTION 'the ordered pair scan gives other rows than the heap: % (% against % rows)', q, a.n, h.n;
	END IF;
END $$;
-- sorts is 0 where the scan gives the order: queries 1 to 3, 5 to 7 and 9. Query 4 asks k the other way round than g: the scan gives g and the sort is incremental, by group. Queries 8 and
-- 10 to 12 have no whole order of the pair (a compact order, a g that may be NULL, an order grouped by another column) and sort the rows of the plain scan; 13 reads a third column. Queries 14 to 18 have
-- g = value (the scan reads that group alone; 17 is three rows, which the heap plan reads cheaper), 19 and 20 are the Merge Append of the scans of 3 partitions, 21 and 22 a merge join of the scans of two tables (no Materialize); 23 to 41 have conditions (on k, on g, both, NULL tests, an IN list, a cross-type g = value, LIMIT and OFFSET, partitions), each against the heap plan: the group walk is for the scan without conditions on a key, and a condition is a filter of the rows it gives
CREATE TABLE pa_q (n int, q text);
INSERT INTO pa_q VALUES
 (1, 'SELECT g, k FROM pa ORDER BY g, k'),
 (2, 'SELECT g, k FROM pa ORDER BY g DESC, k DESC'),
 (3, 'SELECT g, k FROM pa WHERE g BETWEEN 10 AND 30 ORDER BY g, k'),
 (4, 'SELECT g, k FROM pa ORDER BY g, k DESC'),
 (5, 'SELECT g, k FROM pb ORDER BY g, k'),
 (6, 'SELECT g, k FROM pb ORDER BY g DESC, k DESC'),
 (7, 'SELECT g, k FROM pd ORDER BY g, k'),
 (8, 'SELECT g, k FROM pc ORDER BY g, k'),
 (9, 'SELECT k, g FROM pd ORDER BY g DESC, k DESC'),
 (10, 'SELECT g, k FROM pn ORDER BY g, k'),
 (11, 'SELECT g, k FROM po ORDER BY g, k'),
 (12, 'SELECT g, k FROM pc ORDER BY g DESC, k DESC'),
 (13, 'SELECT g, k, id FROM pa ORDER BY g, k'),
 (14, 'SELECT g, k FROM pa WHERE g = 17 ORDER BY k'),
 (15, 'SELECT g, k FROM pa WHERE g = 17 ORDER BY k DESC'),
 (16, 'SELECT g, k FROM pa WHERE g = 500 ORDER BY k'),
 (17, 'SELECT g, k FROM pb WHERE g = -1000 ORDER BY g, k'),
 (18, 'SELECT g, k FROM pa WHERE g = 41 ORDER BY k'),
 (19, 'SELECT g, k FROM pt ORDER BY g, k'),
 (20, 'SELECT g, k FROM pt ORDER BY g DESC, k DESC'),
 (21, 'SELECT a.g, a.k FROM pa a JOIN pe b ON a.g = b.g AND a.k = b.k ORDER BY a.g, a.k'),
 (22, 'SELECT a.g, a.k FROM pf a JOIN pf b ON a.g = b.g AND a.k = b.k ORDER BY a.g, a.k'),
 (23, 'SELECT g, k FROM pa WHERE k > 0 ORDER BY g, k'),
 (24, 'SELECT g, k FROM pa WHERE k IS NULL ORDER BY g DESC, k DESC'),
 (25, 'SELECT g, k FROM pa WHERE k IS NOT NULL AND g < 20 ORDER BY g, k'),
 (26, 'SELECT g, k FROM pa WHERE g = 17 AND k > 0 ORDER BY k DESC'),
 (27, 'SELECT g, k FROM pa WHERE g IN (3, 5, 17) ORDER BY g, k'),
 (28, 'SELECT g, k FROM pa WHERE g <> 17 ORDER BY g DESC, k DESC'),
 (29, 'SELECT g, k FROM pa WHERE g = 17 ORDER BY g, k'),
 (30, 'SELECT g, k FROM pa WHERE g = 17::int8 ORDER BY k'),
 (31, 'SELECT g, k FROM pa WHERE k % 7 = 0 ORDER BY g, k LIMIT 50 OFFSET 20'),
 (32, 'SELECT g, k FROM pa ORDER BY g, k OFFSET 5000'),
 (33, 'SELECT g, k FROM pa ORDER BY g DESC, k DESC LIMIT 100'),
 (34, 'SELECT g, k FROM pb WHERE k < 0 ORDER BY g, k'),
 (35, 'SELECT g, k FROM pb WHERE g > 0 AND k IS NULL ORDER BY g DESC, k DESC'),
 (36, 'SELECT g, k FROM pd WHERE k > timestamp ''2024-03-01'' ORDER BY g, k'),
 (37, 'SELECT g, k FROM pd WHERE g = date ''2024-01-05'' ORDER BY k DESC'),
 (38, 'SELECT g, k FROM pt WHERE k > 100 ORDER BY g, k'),
 (39, 'SELECT g, k FROM pt WHERE g = 7 ORDER BY k'),
 (40, 'SELECT g, k FROM pt WHERE k IS NULL ORDER BY g DESC, k DESC LIMIT 30'),
 (41, 'SELECT g, k FROM pt WHERE g BETWEEN 10 AND 20 AND k < 3000 ORDER BY g DESC, k DESC OFFSET 10');
SELECT n, q, (pa_check(q)).* FROM pa_q ORDER BY n;
