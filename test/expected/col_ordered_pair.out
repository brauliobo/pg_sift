 3 | SELECT g, k FROM pa WHERE g BETWEEN 10 AND 30 ORDER BY g, k |  6425 | t     |             1 |     0
 4 | SELECT g, k FROM pa ORDER BY g, k DESC                      | 11950 | t     |             1 |     1
(4 rows)

DROP FUNCTION pa_check(text), pa_run(text, bool);
DROP TABLE pa_q, pa, pb, pc, pd, pn, po, pt, pe, pf;
DROP EXTENSION pg_sift CASCADE;
