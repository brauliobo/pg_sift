SELECT * FROM check_q($$SELECT grp, count(*) FROM t WHERE (doc ->> 'm')::float8 > 100 AND grp IN (0, 1, 5) AND jsonb_typeof(doc -> 'm') = 'number' GROUP BY 1$$);
