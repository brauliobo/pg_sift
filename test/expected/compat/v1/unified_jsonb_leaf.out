SELECT * FROM check_q($$SELECT r.k, count(*), sum(r.v) FROM e CROSS JOIN LATERAL jsonb_to_recordset(e.items) AS r(k text, v float8) WHERE e.id < 5000 GROUP BY r.k$$);
