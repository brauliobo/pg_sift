INSERT INTO e SELECT 2000 + i, 2000 + i, ARRAY['w' || i % 3, NULL], ARRAY[i], jsonb_build_array(jsonb_build_object('k', 'w' || i % 3, 'v', i * 0.25)) FROM generate_series(1, 100) i;
