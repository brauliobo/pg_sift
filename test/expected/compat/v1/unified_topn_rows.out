-- Format 1 on the unified scan (sift.test_unified_agg): ORDER BY .. LIMIT of the rows of a table is SiftAggV6 when the keys are computed from columns, when the statement carries the aggregates of the
-- whole set (count(*) OVER ()), and when a text match narrows the rows, and a float sum has the same bits at any number of workers. The copy of the table without an index is the oracle.
-- requires: build col
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET client_min_messages = warning;
SET sift.async_maintenance = off;
SET sift.test_create_format1 = on;
SET max_parallel_workers_per_gather = 0;
SET seq_page_cost = 10000;
SET random_page_cost = 10000;
CREATE TABLE t (id int PRIMARY KEY, a int, b int, s text, f float8, memo text) WITH (autovacuum_enabled = false);
INSERT INTO t SELECT g, CASE WHEN g % 13 = 0 THEN NULL ELSE g % 40 END, g % 7, (ARRAY['Pear', 'apple', 'Fig', 'plum'])[1 + g % 4], g * 1.37,
	(ARRAY['damaged', 'late', 'refund', 'wrong size', 'missing', 'gift box', 'broken label', 'perfect'])[1 + g % 8] || ' ' || (ARRAY['cable', 'wire', 'plug', 'color'])[1 + g % 4]
	FROM generate_series(1, 3000) g;
CREATE TABLE p (LIKE t INCLUDING ALL) WITH (autovacuum_enabled = false);
INSERT INTO p SELECT * FROM t;
CREATE INDEX t_col ON t USING sift_col (id, a, b, s, f);
CREATE INDEX t_fts ON t USING sift (memo);
ANALYZE t;
ANALYZE p;
CREATE FUNCTION rows_of(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE x text;
BEGIN
	EXECUTE format('SELECT coalesce(string_agg(r::text, E''\n''), '''') FROM (%s) r', q) INTO x;
	RETURN x;
END $$;
-- the plan of q on the table has SiftAggV6 (and the text index when it is named) and its rows, in order, are those of the copy
CREATE FUNCTION served(q text, fts boolean DEFAULT false) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE line text; agg boolean := false; txt boolean := NOT fts;
BEGIN
	FOR line IN EXECUTE 'EXPLAIN (COSTS off) ' || replace(q, '@T', 't') LOOP
		agg := agg OR line LIKE '%SiftAggV6%';
		txt := txt OR line LIKE '%Search: t_fts%';
	END LOOP;
	RETURN agg AND txt AND rows_of(replace(q, '@T', 't')) = rows_of(replace(q, '@T', 'p'));
END $$;
-- the keys the scan computes from the columns
SELECT q, served(q) AS served FROM unnest(ARRAY[
	'SELECT id, a FROM @T ORDER BY coalesce(a, 500) DESC, id LIMIT 7',
	'SELECT id, a FROM @T ORDER BY a + 1 DESC, id LIMIT 7',
	'SELECT id, a FROM @T ORDER BY a * 2 - b, id LIMIT 12 OFFSET 3',
	'SELECT id, s FROM @T ORDER BY lower(s), id LIMIT 9',
	'SELECT id, s FROM @T ORDER BY upper(s) DESC, id DESC LIMIT 9',
	'SELECT id, a, b FROM @T WHERE b > 2 ORDER BY abs(a - 20), id LIMIT 11',
	'SELECT id, a FROM @T ORDER BY CASE WHEN a IS NULL THEN -1 ELSE a % 5 END, id LIMIT 8',
	'SELECT id FROM @T ORDER BY f * 2, id LIMIT 6'
]) q;
                                          q                                           | served 
--------------------------------------------------------------------------------------+--------
 SELECT id, a FROM @T ORDER BY coalesce(a, 500) DESC, id LIMIT 7                      | t
 SELECT id, a FROM @T ORDER BY a + 1 DESC, id LIMIT 7                                 | t
 SELECT id, a FROM @T ORDER BY a * 2 - b, id LIMIT 12 OFFSET 3                        | t
 SELECT id, s FROM @T ORDER BY lower(s), id LIMIT 9                                   | t
 SELECT id, s FROM @T ORDER BY upper(s) DESC, id DESC LIMIT 9                         | t
 SELECT id, a, b FROM @T WHERE b > 2 ORDER BY abs(a - 20), id LIMIT 11                | t
 SELECT id, a FROM @T ORDER BY CASE WHEN a IS NULL THEN -1 ELSE a % 5 END, id LIMIT 8 | t
 SELECT id FROM @T ORDER BY f * 2, id LIMIT 6                                         | t
(8 rows)

-- the aggregates of the whole set next to the page
SELECT q, served(q) AS served FROM unnest(ARRAY[
	'SELECT id, a, count(*) OVER (), sum(a) OVER () FROM @T WHERE b = 3 ORDER BY a, id LIMIT 7',
	'SELECT id, count(*) OVER (), max(a) OVER (), min(a) OVER () FROM @T ORDER BY coalesce(a, 0) DESC, id LIMIT 5',
	'SELECT id, count(a) OVER (), avg(f) OVER () FROM @T WHERE a > 10 ORDER BY id DESC LIMIT 4'
]) q;
                                                      q                                                       | served 
--------------------------------------------------------------------------------------------------------------+--------
 SELECT id, a, count(*) OVER (), sum(a) OVER () FROM @T WHERE b = 3 ORDER BY a, id LIMIT 7                    | t
 SELECT id, count(*) OVER (), max(a) OVER (), min(a) OVER () FROM @T ORDER BY coalesce(a, 0) DESC, id LIMIT 5 | t
 SELECT id, count(a) OVER (), avg(f) OVER () FROM @T WHERE a > 10 ORDER BY id DESC LIMIT 4                    | t
(3 rows)

-- a text match, with filters and a direction beside it
SELECT q, served(q, true) AS served FROM unnest(ARRAY[
	'SELECT id, b FROM @T WHERE memo @@> ''damaged'' ORDER BY b DESC, id LIMIT 10',
	'SELECT id, b FROM @T WHERE memo @@> ''cable'' AND a > 5 ORDER BY b, id LIMIT 10',
	'SELECT id FROM @T WHERE memo @@> ''cable'' OR memo @@> ''wire'' ORDER BY b DESC, id LIMIT 10',
	'SELECT id, a FROM @T WHERE memo @@> ''refund'' ORDER BY coalesce(a, 500) DESC, id LIMIT 7'
]) q;
                                            q                                             | served 
------------------------------------------------------------------------------------------+--------
 SELECT id, b FROM @T WHERE memo @@> 'damaged' ORDER BY b DESC, id LIMIT 10               | t
 SELECT id, b FROM @T WHERE memo @@> 'cable' AND a > 5 ORDER BY b, id LIMIT 10            | t
 SELECT id FROM @T WHERE memo @@> 'cable' OR memo @@> 'wire' ORDER BY b DESC, id LIMIT 10 | t
 SELECT id, a FROM @T WHERE memo @@> 'refund' ORDER BY coalesce(a, 500) DESC, id LIMIT 7  | t
(4 rows)

-- the plan lists the text index and the keys
EXPLAIN (COSTS off) SELECT id, b FROM t WHERE memo @@> 'damaged' ORDER BY b DESC, id LIMIT 10;
                         QUERY PLAN                         
------------------------------------------------------------
 Limit
   ->  Custom Scan (SiftAggV6)
         Index: t_col
         Search: t_fts @@> 'damaged'::text
         Top-N: b DESC, id (limit 10)
         Exec: SIMD=avx2 group=salted-ht
         I/O & Mem: aio_batches=0 (0 blks) peak_mem=0KB/0KB
(7 rows)

EXPLAIN (COSTS off) SELECT id, a FROM t ORDER BY coalesce(a, 500) DESC, id LIMIT 7;
                         QUERY PLAN                         
------------------------------------------------------------
 Limit
   ->  Custom Scan (SiftAggV6)
         Index: t_col
         Top-N: COALESCE(a, 500) DESC, id (limit 7)
         Exec: SIMD=avx2 group=salted-ht
         I/O & Mem: aio_batches=0 (0 blks) peak_mem=0KB/0KB
(6 rows)

-- a float sum has one value at any number of workers
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
CREATE FUNCTION workers_agree(q text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE w int; r text[]; planned boolean := false; line text;
BEGIN
	FOREACH w IN ARRAY ARRAY[0, 2, 4] LOOP
		PERFORM set_config('max_parallel_workers_per_gather', w::text, true);
		r := r || rows_of(q);
		IF w = 2 THEN
			FOR line IN EXECUTE 'EXPLAIN (COSTS off) ' || q LOOP planned := planned OR line LIKE '%Workers Planned: _%'; END LOOP;
		END IF;
	END LOOP;
	RETURN r[1] = r[2] AND r[2] = r[3] AND planned;
END $$;
INSERT INTO t SELECT g, g % 40, g % 7, 'x', g / 7.0, 'x' FROM generate_series(3001, 60000) g;
ANALYZE t;
SELECT workers_agree('SELECT b, sum(f), avg(f), count(*) FROM t GROUP BY b ORDER BY b') AS float_sums_agree;
 float_sums_agree 
------------------
 t
(1 row)

DROP FUNCTION rows_of, served, workers_agree;
DROP TABLE t, p;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
