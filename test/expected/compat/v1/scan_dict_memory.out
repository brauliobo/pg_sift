-- A scan of a Format 1 sift_table (the 5.x layout), not an aggregate the engine answers from its own units, reads the strings of a leaf from the dictionary of its segment in place, block by block, whatever rows it reads: the backend neither
-- parses nor keeps a dictionary of tens of thousands of strings, nor the table of the positions a search of it looks at, and the rows are the same.
CREATE EXTENSION pg_sift;
SET sift.test_create_format1 = on;
SET sift.async_maintenance = off;
SET client_min_messages = warning;
SET sift.enable_agg = off;
CREATE TABLE sd (id int, s text, c text) USING sift_table;
INSERT INTO sd SELECT i, md5(i::text), 'c' || i % 7 FROM generate_series(1, 50000) i;
SELECT busy FROM sift.table_maintain('sd');
 busy 
------
 f
(1 row)

SELECT count(*) AS strings, sum(length(s)) AS bytes, count(DISTINCT s) AS distinct_strings, min(c), max(c) FROM sd;
 strings |  bytes  | distinct_strings | min | max 
---------+---------+------------------+-----+-----
   50000 | 1600000 |            50000 | c0  | c6
(1 row)

SELECT count(*) FILTER (WHERE s = md5(id::text)) AS equal_to_the_source FROM sd;
 equal_to_the_source 
---------------------
               50000
(1 row)

SELECT coalesce(sum(total_bytes), 0) < 65536 AS no_dictionary_kept
  FROM pg_backend_memory_contexts WHERE name = 'sift cache segment dictionary';
 no_dictionary_kept 
--------------------
 t
(1 row)

SELECT coalesce(sum(total_bytes), 0) < 65536 AS no_bisection_table
  FROM pg_backend_memory_contexts WHERE name LIKE 'sift cache segment bisection%';
 no_bisection_table 
--------------------
 t
(1 row)

DROP TABLE sd;
DROP EXTENSION pg_sift;
