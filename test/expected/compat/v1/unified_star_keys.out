-- Format 1 on the unified aggregate scan (sift.test_unified_agg): a join to small relations keys its groups, arguments and dimensions by what the scan computes (the month of a date, a
-- PostgreSQL expression of the columns of the fact table, a derived argument), joins them on an expression of their own columns, and takes a text search of the fact table. Every statement is
-- run with the node and without it (sift.enable_agg) and the answers are compared.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET client_min_messages = warning;
\set VERBOSITY terse
SET sift.test_create_format1 = on;
SET sift.test_unified_agg = on;
SET sift.agg_force = on;
SET max_parallel_workers_per_gather = 0;
SET seq_page_cost = 10000;
SET random_page_cost = 10000;
CREATE TABLE dims (id int PRIMARY KEY, tier text NOT NULL, active bool NOT NULL);
INSERT INTO dims SELECT i, 'tier_' || (i % 3), i % 4 <> 0 FROM generate_series(1, 40) i;
CREATE TABLE t (id int PRIMARY KEY, parent_id int, ts date, at timestamp, kind text, qty int, amount float8, gone timestamptz, memo text);
INSERT INTO t
SELECT i, 1 + (i * 7) % 45, date '2024-01-01' + (i * 7) % 400, timestamp '2024-01-01' + (i * 13 % 9000) * interval '1 hour', 'k' || repeat('x', i % 4) || (i % 3), i % 11,
	i % 17 + 0.25 * (i % 4), CASE WHEN i % 37 = 0 THEN now() END,
	(ARRAY['cable', 'wire', 'plug', 'adapter', 'switch', 'panel', 'socket', 'fuse'])[1 + i % 8] || ' ' || (ARRAY['cable', 'wire', 'plug', 'adapter', 'switch', 'panel', 'socket', 'fuse'])[1 + (i * 3 + 1) % 8]
FROM generate_series(1, 6000) i;
CREATE INDEX t_col ON t USING sift_col (id, parent_id, ts, at, kind, qty, amount, gone);
CREATE INDEX t_memo ON t USING sift (memo);
VACUUM (FREEZE, ANALYZE) dims, t;
-- the node the plan of q has, and whether its rows are those of the heap (sift.enable_agg = off), in the order of the statement
CREATE FUNCTION check_q(q text) RETURNS TABLE (node text, same bool) LANGUAGE plpgsql AS $$
DECLARE l text; p text := ''; x text; y text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP p := p || l || E'\n'; END LOOP;
	EXECUTE format('SELECT coalesce(string_agg(r::text, E''\n''), '''') FROM (%s) r', q) INTO x;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('SELECT coalesce(string_agg(r::text, E''\n''), '''') FROM (%s) r', q) INTO y;
	SET LOCAL sift.enable_agg = on;
	node := coalesce((regexp_match(p, 'Custom Scan \((SiftAgg\w*|SiftHybridAgg)\)'))[1], 'none');
	same := x = y;
	RETURN NEXT;
END $$;
-- a join on an expression of the columns of the dimension: IN, an inner join, a left join and its ON clause
SELECT * FROM check_q($$SELECT kind, count(*) AS n, sum(amount) AS total FROM t WHERE parent_id IN (SELECT id + 1 FROM dims WHERE active) AND gone IS NULL GROUP BY 1 ORDER BY 1$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT d.tier, count(*) AS n, sum(t.qty) AS q FROM t JOIN dims d ON d.id * 2 = t.parent_id WHERE t.gone IS NULL GROUP BY 1 ORDER BY 1$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT t.kind, count(d.id) AS n FROM t LEFT JOIN dims d ON d.id + 3 = t.parent_id AND d.active WHERE t.gone IS NULL GROUP BY 1 ORDER BY 1$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

-- the month of a date and of a timestamp, and the keys PostgreSQL computes, under a join
SELECT * FROM check_q($$SELECT d.tier, date_trunc('month', t.ts)::date AS month, count(*) AS n FROM t JOIN dims d ON d.id = t.parent_id WHERE t.gone IS NULL GROUP BY 1, 2 ORDER BY 1, 2$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT d.tier, date_trunc('month', t.at) AS month, sum(t.amount) AS total FROM t JOIN dims d ON d.id = t.parent_id GROUP BY 1, 2 ORDER BY 1, 2$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT d.tier, date_bin('7 days', t.at, timestamp '2024-01-01') AS week, count(*) AS n FROM t JOIN dims d ON d.id = t.parent_id GROUP BY 1, 2 ORDER BY 1, 2$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT d.tier, lower(t.kind) || '-' || (t.qty % 3) AS k, count(*) AS n FROM t JOIN dims d ON d.id = t.parent_id GROUP BY 1, 2 ORDER BY 1, 2$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT d.tier, t.qty + 1 AS q, count(*) AS n FROM t JOIN dims d ON d.id = t.parent_id GROUP BY 1, 2 ORDER BY 1, 2$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

-- the arguments the scan derives, and a FILTER on one
SELECT * FROM check_q($$SELECT d.tier, sum(length(t.kind)) AS chars, count(*) FILTER (WHERE length(t.kind) > 3) AS long FROM t JOIN dims d ON d.id = t.parent_id GROUP BY 1 ORDER BY 1$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT d.tier, sum(t.qty * 2.5) AS scaled FROM t JOIN dims d ON d.id = t.parent_id GROUP BY 1 ORDER BY 1$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

-- a text search of the fact table joined to a dimension
SELECT * FROM check_q($$SELECT d.tier, count(*) AS n FROM t JOIN dims d ON d.id = t.parent_id WHERE t.memo @@> 'plug' AND t.gone IS NULL GROUP BY 1 ORDER BY 1$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

SELECT * FROM check_q($$SELECT d.tier, date_trunc('month', t.ts)::date AS month, count(*) AS n FROM t JOIN dims d ON d.id = t.parent_id WHERE t.memo @@> 'cable wire' GROUP BY 1, 2 ORDER BY 1, 2$$);
   node    | same 
-----------+------
 SiftAggV6 | t
(1 row)

DROP TABLE t, dims;
DROP FUNCTION check_q;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
