-- The reloption scope of a sift_col index: 'key_name: fk -> [schema.]relation(member, scope_key)'. CREATE INDEX, REINDEX and ALTER INDEX resolve it: the index depends
-- on the unique btree of the scope relation on (member, scope_key), has the derived leaf "<key_name>#scope" (NULL in every row the entity segments hold) and is
-- column format minor 45. The text is the record (pg_dump writes it). The build writes the scope segments too (test col_scope_build): the entity segments answer as for an index without the scope.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT i, 1 + i % 5 FROM generate_series(1, 500) i;
INSERT INTO tenant_scope SELECT i, 6 FROM generate_series(1, 500, 7) i;
-- the journal index of the scope relation: a scope index needs it (member first, track_changes = 'ctid')
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
NOTICE:  sift_col index "tenant_scope_journal": 1 automatic choice (track_changes)
DETAIL:  track_changes = ctid
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('tenant_scope_journal');
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int NOT NULL, created_at timestamptz NOT NULL, kind int NOT NULL, label text, value_num int NOT NULL, pad int)
	WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + i % 500, timestamptz '2026-01-01' + i * interval '1 minute', i % 7, 'l' || i % 11, i, 0 FROM generate_series(1, 3000) i;
CREATE FUNCTION edges(idx regclass) RETURNS text LANGUAGE sql AS
$$ SELECT coalesce(string_agg(refobjid::regclass::text, ' ' ORDER BY refobjid::regclass::text), 'none') FROM pg_depend
   WHERE classid = 'pg_class'::regclass AND objid = idx AND refclassid = 'pg_class'::regclass AND deptype = 'n'
	 AND (SELECT relkind FROM pg_class WHERE oid = refobjid) = 'i' $$;
CREATE FUNCTION try(stmt text) RETURNS text LANGUAGE plpgsql AS
$$ DECLARE hint text; BEGIN EXECUTE stmt; RETURN 'ok';
   EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS hint = PG_EXCEPTION_HINT; RETURN sqlerrm || coalesce(' [' || hint || ']', ''); END $$;
CREATE FUNCTION answers(sql text) RETURNS text LANGUAGE plpgsql AS
$$ DECLARE r text; BEGIN EXECUTE format('SELECT md5(string_agg(t::text, '','' ORDER BY t::text)) FROM (%s) t', sql) INTO r; RETURN r; END $$;
-- the relations a scope can name, and what is wrong with the others
CREATE TABLE pairs_nullable (m int, s int, UNIQUE (m, s));
CREATE TABLE pairs_text (m text NOT NULL, s int NOT NULL, PRIMARY KEY (m, s));
CREATE TABLE pairs_numeric (m int NOT NULL, s numeric NOT NULL, PRIMARY KEY (m, s));
CREATE TABLE pairs_plain (m int NOT NULL, s int NOT NULL);
CREATE TABLE pairs_three (m int NOT NULL, s int NOT NULL, x int NOT NULL, PRIMARY KEY (m, s, x));
CREATE TABLE pairs_partial (m int NOT NULL, s int NOT NULL);
CREATE UNIQUE INDEX pairs_partial_i ON pairs_partial (m, s) WHERE s > 0;
CREATE TABLE pairs_deferrable (m int NOT NULL, s int NOT NULL, UNIQUE (m, s) DEFERRABLE);
CREATE TABLE pairs_include (m int NOT NULL, s int NOT NULL, x int);
CREATE UNIQUE INDEX pairs_include_i ON pairs_include (m, s) INCLUDE (x);
CREATE TABLE pairs_part (m int NOT NULL, s int NOT NULL, PRIMARY KEY (m, s)) PARTITION BY RANGE (m);
CREATE VIEW pairs_view AS SELECT dim_a_id AS m, tenant_id AS s FROM tenant_scope;
CREATE TEMP TABLE bad_scopes (n serial, why text, opt text);
INSERT INTO bad_scopes (why, opt) VALUES
	('no colon', 'tenant_id dim_a_id -> tenant_scope(dim_a_id, tenant_id)'),
	('no arrow', 'tenant_id: dim_a_id tenant_scope(dim_a_id, tenant_id)'),
	('no parenthesis', 'tenant_id: dim_a_id -> tenant_scope'),
	('one column', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id)'),
	('three columns', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id, x)'),
	('unclosed', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id'),
	('trailing text', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id) carries x'),
	('empty scope after ;', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id);'),
	('quote not closed', 'tenant_id: "dim_a_id -> tenant_scope(dim_a_id, tenant_id)'),
	('twice the same name', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id); tenant_id: kind -> tenant_scope(dim_a_id, tenant_id)'),
	('five scopes', 'a: dim_a_id -> tenant_scope(dim_a_id, tenant_id); b: dim_a_id -> tenant_scope(dim_a_id, tenant_id); c: dim_a_id -> tenant_scope(dim_a_id, tenant_id); d: dim_a_id -> tenant_scope(dim_a_id, tenant_id); e: dim_a_id -> tenant_scope(dim_a_id, tenant_id)'),
	('fk not in the index', 'tenant_id: pad -> tenant_scope(dim_a_id, tenant_id)'),
	('fk not a column', 'tenant_id: nothing -> tenant_scope(dim_a_id, tenant_id)'),
	('text fk, integer member', 'tenant_id: label -> tenant_scope(dim_a_id, tenant_id)'),
	('name of a column of the index', 'kind: dim_a_id -> tenant_scope(dim_a_id, tenant_id)'),
	('relation missing', 'tenant_id: dim_a_id -> nowhere(dim_a_id, tenant_id)'),
	('relation is the table', 'tenant_id: dim_a_id -> events(id, kind)'),
	('relation is a view', 'tenant_id: dim_a_id -> pairs_view(m, s)'),
	('relation is partitioned', 'tenant_id: dim_a_id -> pairs_part(m, s)'),
	('member column missing', 'tenant_id: dim_a_id -> tenant_scope(nothing, tenant_id)'),
	('scope key column missing', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, nothing)'),
	('same column twice', 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, dim_a_id)'),
	('text member, integer fk', 'tenant_id: dim_a_id -> pairs_text(m, s)'),
	('scope key not an integer, text or uuid', 'tenant_id: dim_a_id -> pairs_numeric(m, s)'),
	('text scope key, no journal index', 'tenant_id: dim_a_id -> pairs_text(s, m)'),
	('nullable columns', 'tenant_id: dim_a_id -> pairs_nullable(m, s)'),
	('no btree', 'tenant_id: dim_a_id -> pairs_plain(m, s)'),
	('btree on three columns', 'tenant_id: dim_a_id -> pairs_three(m, s)'),
	('partial unique, no journal index', 'tenant_id: dim_a_id -> pairs_partial(m, s)'),
	('deferrable unique', 'tenant_id: dim_a_id -> pairs_deferrable(m, s)'),
	('unique with an included column', 'tenant_id: dim_a_id -> pairs_include(m, s)');
SELECT n, why, try(format('CREATE INDEX bad ON events USING sift_col (id, dim_a_id, created_at, kind, label, value_num) WITH (scope = %L)', opt)) AS result
	FROM bad_scopes ORDER BY n;
NOTICE:  scope "tenant_id": the pairs of "pairs_text" are the rows of its unique btree "pairs_text_pkey"
NOTICE:  scope "tenant_id": the pairs of "pairs_partial" are the rows of its unique btree "pairs_partial_i" that satisfy (s > 0)
 n  |                  why                   |                                                                                                                                                           result                                                                                                                                                            
----+----------------------------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  1 | no colon                               | invalid scope option "tenant_id dim_a_id -> tenant_scope(dim_a_id, tenant_id)": expected ':' after the name of the derived key []
  2 | no arrow                               | invalid scope option "tenant_id: dim_a_id tenant_scope(dim_a_id, tenant_id)": expected '->' after the column of this index that holds the member key []
  3 | no parenthesis                         | invalid scope option "tenant_id: dim_a_id -> tenant_scope": expected '(' and the member and scope key columns of the relation after its name []
  4 | one column                             | invalid scope option "tenant_id: dim_a_id -> tenant_scope(dim_a_id)": expected ',' and the scope key column after the member column []
  5 | three columns                          | invalid scope option "tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id, x)": expected ')' after the scope key column: a scope is a member column and a scope key column []
  6 | unclosed                               | invalid scope option "tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id": expected ')' after the scope key column: a scope is a member column and a scope key column []
  7 | trailing text                          | invalid scope option "tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id) carries x": unexpected text after the scope []
  8 | empty scope after ;                    | invalid scope option "tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id);": a name is expected here []
  9 | quote not closed                       | invalid scope option "tenant_id: "dim_a_id -> tenant_scope(dim_a_id, tenant_id)": a quoted name is not closed or is empty []
 10 | twice the same name                    | invalid scope option "tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id); tenant_id: kind -> tenant_scope(dim_a_id, tenant_id)": the derived key "tenant_id" is declared twice: each scope has a name of its own []
 11 | five scopes                            | invalid scope option "a: dim_a_id -> tenant_scope(dim_a_id, tenant_id); b: dim_a_id -> tenant_scope(dim_a_id, tenant_id); c: dim_a_id -> tenant_scope(dim_a_id, tenant_id); d: dim_a_id -> tenant_scope(dim_a_id, tenant_id); e: dim_a_id -> tenant_scope(dim_a_id, tenant_id)": too many scopes (4 at most in an index) []
 12 | fk not in the index                    | scope "tenant_id": "pad" is not a column of this index [Name the column of the index that holds the member key.]
 13 | fk not a column                        | scope "tenant_id": "nothing" is not a column of this index [Name the column of the index that holds the member key.]
 14 | text fk, integer member                | scope "tenant_id": the member column "dim_a_id" of "tenant_scope" (integer) and the column "label" of the index (text) are not of one kind [Both are integers, both text or varchar, or both uuid: their values are equal when their bytes are.]
 15 | name of a column of the index          | scope "kind": the name of the derived key is a column of this index [Give the derived key a name that no column of the index has: key_order names a column or a derived key.]
 16 | relation missing                       | relation "public.nowhere" does not exist []
 17 | relation is the table                  | scope "tenant_id": the scope relation is the table of the index [Name the table of (member, scope key) pairs.]
 18 | relation is a view                     | scope "tenant_id": "pairs_view" is not a plain heap table [The scope relation is a heap table that is not partitioned: a view or a partitioned table is not supported.]
 19 | relation is partitioned                | scope "tenant_id": "pairs_part" is not a plain heap table [The scope relation is a heap table that is not partitioned: a view or a partitioned table is not supported.]
 20 | member column missing                  | scope "tenant_id": relation "tenant_scope" has no column "nothing" []
 21 | scope key column missing               | scope "tenant_id": relation "tenant_scope" has no column "nothing" []
 22 | same column twice                      | scope "tenant_id": the member and scope key columns are the same column [A scope relation has two columns: the member key and the scope key.]
 23 | text member, integer fk                | scope "tenant_id": the member column "m" of "pairs_text" (text) and the column "dim_a_id" of the index (integer) are not of one kind [Both are integers, both text or varchar, or both uuid: their values are equal when their bytes are.]
 24 | scope key not an integer, text or uuid | scope "tenant_id": column "s" of "pairs_numeric" is not an integer, text, varchar or uuid column [The member and scope key columns are int2, int4, int8, text, varchar or uuid columns.]
 25 | text scope key, no journal index       | scope "tenant_id": "pairs_text" has no sift_col index that journals its changes [CREATE INDEX ON pairs_text USING sift_col (s, m) WITH (track_changes = 'ctid'): the member column first, so that a read can tell which pairs changed since the scope segments were written.]
 26 | nullable columns                       | scope "tenant_id": column "m" of "pairs_nullable" is nullable [Declare the member and scope key columns NOT NULL: a pair has both keys.]
 27 | no btree                               | scope "tenant_id": "pairs_plain" has no btree index on (m, s) [CREATE UNIQUE INDEX on pairs_plain (m, s), or make them its primary key: an immediate btree on exactly those two columns (a non-unique one makes the pairs a multiset of rows).]
 28 | btree on three columns                 | scope "tenant_id": "pairs_three" has no btree index on (m, s) [CREATE UNIQUE INDEX on pairs_three (m, s), or make them its primary key: an immediate btree on exactly those two columns (a non-unique one makes the pairs a multiset of rows).]
 29 | partial unique, no journal index       | scope "tenant_id": "pairs_partial" has no sift_col index that journals its changes [CREATE INDEX ON pairs_partial USING sift_col (m, s) WITH (track_changes = 'ctid'): the member column first, so that a read can tell which pairs changed since the scope segments were written.]
 30 | deferrable unique                      | scope "tenant_id": "pairs_deferrable" has no btree index on (m, s) [CREATE UNIQUE INDEX on pairs_deferrable (m, s), or make them its primary key: an immediate btree on exactly those two columns (a non-unique one makes the pairs a multiset of rows).]
 31 | unique with an included column         | scope "tenant_id": "pairs_include" has no btree index on (m, s) [CREATE UNIQUE INDEX on pairs_include (m, s), or make them its primary key: an immediate btree on exactly those two columns (a non-unique one makes the pairs a multiset of rows).]
(31 rows)

