 join, one key a user                          | Keys: (1 keys)
 join, one key a user, the table in the middle | Keys: (1 keys)
 join, one key, a NULL key                     | Keys: (0 keys)
 join, one key, no row                         | Keys: (0 keys)
 join, several keys                            | Keys: (4 keys)
(17 rows)

-- row-level security that applies to the role (the owner is exempt): the policy of the table of keys is the visibility of every read of it, which a scan that reads it once itself would have to repeat
CREATE ROLE kt_user;
GRANT SELECT ON forms, events, tenant_scope, tenants_rls TO kt_user;
CREATE POLICY own_tenants ON tenants_rls USING (user_id = 1);
SET ROLE kt_user;
SELECT name, label(q) AS plan, same(q) AS same_rows FROM forms WHERE name LIKE 'miss: row-level security%' ORDER BY name COLLATE "C";
                name                 |                                                                            plan                                                                             | same_rows 
-------------------------------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------+-----------
 miss: row-level security, join      | join, no SiftAgg scan of "events" is planned, so its join to the scope relation runs as written (the arms index and single say why the scan is not planned) | t
 miss: row-level security, nested IN | join, row-level security is enabled on the table of keys                                                                                                    | t
(2 rows)

RESET ROLE;
-- a statement that modifies the table of keys keeps the join: its reason is the notice (sift.explain_refusals), the plan has no scope read
CREATE FUNCTION scope_read(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; plan text := '';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		plan := plan || l || E'\n';
	END LOOP;
	RETURN CASE WHEN plan ~ 'Scope Index: ' THEN 'scope read' ELSE 'no scope read' END;
END $$;
SET client_min_messages = notice;
SET sift.explain_refusals = on;
SELECT scope_read($q$INSERT INTO tenants_log SELECT 9, count(*)::int FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM tenants_log WHERE user_id = 1))$q$) AS insert_plan;
NOTICE:  SiftAgg not used: scope: a join to the scope relation of a scope index is not one the scope read proves equal to the join: the join runs as written (the table of keys is a table the statement modifies)
DETAIL:  arm: L2:scope
HINT:  Join the scope relation by its declared member column to the declared column of the table, bind its scope key with an equality or an IN list of constants, and read no other column of it; the detail names what differs.
  insert_plan  
---------------
 no scope read
(1 row)

SELECT scope_read($q$WITH w AS (INSERT INTO tenants_log VALUES (1, 3) RETURNING 1) SELECT kind, sum(amount) AS total FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM tenants_log WHERE user_id = 1)) GROUP BY kind$q$) AS cte_plan;
NOTICE:  SiftAgg not used: scope: a join to the scope relation of a scope index is not one the scope read proves equal to the join: the join runs as written (the table of keys is a table the statement modifies)
DETAIL:  arm: scope
HINT:  Join the scope relation by its declared member column to the declared column of the table, bind its scope key with an equality or an IN list of constants, and read no other column of it; the detail names what differs.
   cte_plan    
---------------
 no scope read
(1 row)

RESET sift.explain_refusals;
SET client_min_messages = warning;
DROP FUNCTION scope_read(text);
-- a prepared statement: the plan, generic or custom, reads the table when the scan starts, so a change of the table between two executions changes the keys of the next
CREATE TABLE pforms (name text PRIMARY KEY, body text, args text);
INSERT INTO pforms VALUES
 ('nested IN, $1', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = $1)) GROUP BY kind$q$, '1'),
 ('join, one key a user, $1', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN user_home k ON k.tenant_id = s.tenant_id WHERE k.user_id = $1 GROUP BY kind$q$, '1');
CREATE FUNCTION exec_state(f pforms, note text) RETURNS TABLE (form text, step text, run text, same_rows boolean) LANGUAGE plpgsql AS $$
DECLARE a text;
BEGIN
	form := f.name;
	step := note;
	run := run_of('EXECUTE q(' || f.args || ')');
	a := rows_md5('EXECUTE q(' || f.args || ')');
	PERFORM set_config('sift.enable_agg', 'off', false);
	EXECUTE 'PREPARE plain AS ' || f.body;
	same_rows := a = rows_md5('EXECUTE plain(' || f.args || ')');
	DEALLOCATE plain;
	PERFORM set_config('sift.enable_agg', 'on', false);
	RETURN NEXT;
END $$;
CREATE FUNCTION states(mode text) RETURNS TABLE (form text, step text, run text, same_rows boolean) LANGUAGE plpgsql AS $$
DECLARE f pforms;
BEGIN
	PERFORM set_config('plan_cache_mode', mode, false);
	FOR f IN SELECT * FROM pforms p ORDER BY p.name COLLATE "C" LOOP
		DEALLOCATE ALL;
		EXECUTE 'PREPARE q(int) AS ' || f.body;
		RETURN QUERY SELECT * FROM exec_state(f, 'built');
		UPDATE my_tenants SET tenant_id = 4 WHERE user_id = 1 AND tenant_id = 2;
		UPDATE user_home SET tenant_id = 4 WHERE user_id = 1;
		RETURN QUERY SELECT * FROM exec_state(f, 'a key changed');
		DELETE FROM my_tenants WHERE user_id = 1 AND tenant_id = 5;
		INSERT INTO my_tenants VALUES (1, 6, 'admin', NULL);
		UPDATE user_home SET tenant_id = NULL WHERE user_id = 1;
		RETURN QUERY SELECT * FROM exec_state(f, 'a key ended, a key added, a NULL key');
		DELETE FROM my_tenants WHERE user_id = 1;
		DELETE FROM user_home WHERE user_id = 1;
		RETURN QUERY SELECT * FROM exec_state(f, 'no keys');
		INSERT INTO my_tenants VALUES (1, 2, 'admin', NULL), (1, 5, 'admin', NULL), (1, 9, 'reader', NULL);
		INSERT INTO user_home VALUES (1, 2);
		RETURN QUERY SELECT * FROM exec_state(f, 'restored');
	END LOOP;
	DEALLOCATE ALL;
END $$;
SELECT 'generic' AS mode, s.* FROM states('force_generic_plan') s;
  mode   |           form           |                 step                 |                               run                                | same_rows 
---------+--------------------------+--------------------------------------+------------------------------------------------------------------+-----------
 generic | join, one key a user, $1 | built                                | Keys: (1 keys)                                                   | t
 generic | join, one key a user, $1 | a key changed                        | Keys: (1 keys)                                                   | t
 generic | join, one key a user, $1 | a key ended, a key added, a NULL key | Keys: (0 keys)                                                   | t
 generic | join, one key a user, $1 | no keys                              | Keys: (0 keys)                                                   | t
 generic | join, one key a user, $1 | restored                             | Keys: (1 keys)                                                   | t
 generic | nested IN, $1            | built                                | Keys: (3 keys); Changed Keys: 0; Patched Keys: 0; Dedupe Keys: 1 | t
 generic | nested IN, $1            | a key changed                        | Keys: (3 keys); Changed Keys: 0; Patched Keys: 0; Dedupe Keys: 1 | t
 generic | nested IN, $1            | a key ended, a key added, a NULL key | Keys: (3 keys); Changed Keys: 0; Patched Keys: 0; Dedupe Keys: 1 | t
 generic | nested IN, $1            | no keys                              | Keys: (0 keys)                                                   | t
 generic | nested IN, $1            | restored                             | Keys: (3 keys); Changed Keys: 0; Patched Keys: 0; Dedupe Keys: 1 | t
(10 rows)

SELECT 'custom' AS mode, s.* FROM states('force_custom_plan') s;
  mode  |           form           |                 step                 |                               run                                | same_rows 
--------+--------------------------+--------------------------------------+------------------------------------------------------------------+-----------
 custom | join, one key a user, $1 | built                                | Keys: (1 keys)                                                   | t
