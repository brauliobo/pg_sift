 IN, nested IN        | join, sift.agg_scope is off
 join, one key a user | join, sift.agg_scope is off
(2 rows)

RESET sift.agg_scope;
-- the keys the run read (NULLs and the repeats of the table are no keys), and the reader's verdict
SELECT name, run_of(q) AS run FROM forms WHERE name LIKE 'IN, %' OR name LIKE 'join, %' AND name NOT LIKE '%sub-select%' ORDER BY name COLLATE "C";
