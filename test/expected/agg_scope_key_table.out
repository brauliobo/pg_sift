(38 rows)

-- the switch: with sift.agg_scope off nothing is taken out
SET sift.agg_scope = off;
SELECT name, label(q) FROM forms WHERE name IN ('IN, nested IN', 'join, one key a user') ORDER BY name COLLATE "C";
         name         |            label            
