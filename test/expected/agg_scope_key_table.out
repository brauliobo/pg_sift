(10 rows)

RESET plan_cache_mode;
-- more keys than the dedupe lists (64 keys that have lists), and than work_mem holds (the plan expected few): the reader reads the entity rows of the members the pairs list, the rows are the join's
CREATE TABLE membership (dim_a_id int NOT NULL, group_id int NOT NULL, PRIMARY KEY (dim_a_id, group_id)) WITH (autovacuum_enabled = false);
INSERT INTO membership SELECT m, 1 + (m * 13) % 80 FROM generate_series(1, 2000) m;
INSERT INTO membership SELECT m, 1 + (m * 7 + 3) % 80 FROM generate_series(1, 2000) m ON CONFLICT DO NOTHING;
INSERT INTO membership SELECT m, 1 + (m * 11 + 5) % 80 FROM generate_series(1, 2000, 3) m ON CONFLICT DO NOTHING;
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, 1 + (i::bigint * 7919) % 2100, 'k' || i % 4, i % 100 FROM generate_series(1, 10000) i;
CREATE TABLE my_groups (user_id int, group_id int, PRIMARY KEY (user_id, group_id)) WITH (autovacuum_enabled = false);
INSERT INTO my_groups SELECT 1, g FROM generate_series(1, 3) g;
CREATE INDEX membership_journal ON membership USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, kind, amount) WITH (scope = 'group_id: dim_a_id -> membership(dim_a_id, group_id)');
REINDEX INDEX facts_col;
VACUUM (FREEZE, ANALYZE) facts, membership, my_groups;
-- the statistics of the table of keys know the three groups of user 1: the 80 of user 2 come after them, so the plan expects few keys and the scan reads 80
INSERT INTO my_groups SELECT 2, g FROM generate_series(1, 80) g;
CREATE TABLE gforms (name text PRIMARY KEY, q text);
INSERT INTO gforms VALUES
 ('3 groups', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM membership WHERE group_id IN (SELECT group_id FROM my_groups WHERE user_id = 1)) GROUP BY kind$q$),
 ('80 groups', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM membership WHERE group_id IN (SELECT group_id FROM my_groups WHERE user_id = 2)) GROUP BY kind$q$);
SELECT name, label(q) AS plan, run_of(q) AS run, same(q) AS same_rows FROM gforms ORDER BY name;
   name    |                                              plan                                               |                  run                   | same_rows 
-----------+-------------------------------------------------------------------------------------------------+----------------------------------------+-----------
 3 groups  | scope read, ARRAY(SELECT my_groups.group_id FROM my_groups WHERE (my_groups.user_id = 1)), once | Keys: (3 keys)                         | t
 80 groups | scope read, ARRAY(SELECT my_groups.group_id FROM my_groups WHERE (my_groups.user_id = 2)), once | Keys: (80 keys); Fallback: dedupe keys | t
(2 rows)

SET work_mem = '64kB';
SELECT name || ', work_mem 64kB' AS name, run_of(q) AS run, same(q) AS same_rows FROM gforms ORDER BY name;
           name           |                       run                       | same_rows 
--------------------------+-------------------------------------------------+-----------
 3 groups, work_mem 64kB  | Keys: (3 keys)                                  | t
 80 groups, work_mem 64kB | Keys: (80 keys); Fallback: dedupe over work_mem | t
(2 rows)

RESET work_mem;
DROP FUNCTION states(text), exec_state(pforms, text), same(text), rows_md5(text), run_of(text), label(text);
DROP TABLE gforms, pforms, forms, facts, membership, my_groups, events, tenant_scope, my_tenants, user_home, user_tenants, my_tenants_big, users, my_tenants_part, tenants_rls, tenants_child,
	tenants_parent, tenants_log CASCADE;
DROP MATERIALIZED VIEW IF EXISTS my_tenants_mv;
DROP ROLE kt_user;
DROP EXTENSION pg_sift;
