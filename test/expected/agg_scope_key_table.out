-- The keys of the scope conjunct may be the rows of a table: `s.key IN (SELECT key FROM keys WHERE ..)` (nested, as an IN, an EXISTS or a join inside the sub-select) and the join
-- `JOIN keys k ON k.key = s.key`. The scan reads the table once when it starts, as an InitPlan reads an ARRAY(SELECT ..), under the snapshot of the statement and with the conditions of the
-- table (EXPLAIN: Scope Keys: ARRAY(SELECT ..), the InitPlan below). A semi join counts a row once whichever keys the table gives; a join counts it once for each pair, so it is taken only when the table
-- gives at most one key (a unique index whose columns the conditions all equate to constants or parameters). The table must be a plain table read as itself (no view, row-level security, inheritance,
-- table the statement modifies) with conditions that read it only. Every near miss keeps the join and names its reason (sift.explain_why, arm scope). Rows are those of the join (sift.agg_scope = off) and of the normal plan.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET default_statistics_target = 1000;
-- a page cost that keeps a SiftAgg plan the cheaper one whenever it is generated (the tables are read whole by the normal plan), and cheap index reads of the tables of keys: the plan then
-- depends on the shape of the statement and the price of the two SiftAgg plans only
SET seq_page_cost = 1000;
SET random_page_cost = 1;
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at date, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i::bigint * 7919) % 400, date '2025-01-01' + i % 300, 'k' || i % 4, i % 100 FROM generate_series(1, 6000) i;
-- entities 1 to 360 are members of tenant 1 + id % 10, one in seven of a second tenant; the others are in no tenant
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT i, 1 + i % 10 FROM generate_series(1, 360) i;
INSERT INTO tenant_scope SELECT i, 1 + (i * 3 + 1) % 10 FROM generate_series(1, 360) i WHERE i % 7 = 0 ON CONFLICT DO NOTHING;
CREATE INDEX tenant_pairs_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, kind, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
-- the tables of keys: the tenants of a user (user 1 has three, user 2 one, user 3 none), one home tenant a user (user 3 has a NULL one), a table that repeats a key and holds a NULL
CREATE TABLE my_tenants (user_id int, tenant_id int, role text, deleted_at date, PRIMARY KEY (user_id, tenant_id));
INSERT INTO my_tenants VALUES (1, 2, 'admin', NULL), (1, 5, 'admin', NULL), (1, 9, 'reader', NULL), (1, 7, 'admin', date '2025-01-01'), (2, 3, 'admin', NULL);
CREATE TABLE user_home (user_id int PRIMARY KEY, tenant_id int);
INSERT INTO user_home VALUES (1, 2), (2, 3), (3, NULL);
CREATE TABLE user_tenants (user_id int, tenant_id int);
INSERT INTO user_tenants VALUES (1, 2), (1, 2), (1, 5), (2, 3), (4, NULL), (4, 3);
CREATE INDEX user_tenants_user ON user_tenants (user_id);
CREATE TABLE my_tenants_big (user_id int, tenant_id bigint, PRIMARY KEY (user_id, tenant_id));
INSERT INTO my_tenants_big VALUES (1, 2), (1, 5), (2, 3);
CREATE TABLE users (id int PRIMARY KEY, email text);
INSERT INTO users VALUES (1, 'a@example.com'), (2, 'b@example.com');
CREATE TABLE my_tenants_part (user_id int, tenant_id int, PRIMARY KEY (user_id, tenant_id)) PARTITION BY HASH (user_id);
CREATE TABLE my_tenants_part_0 PARTITION OF my_tenants_part FOR VALUES WITH (MODULUS 2, REMAINDER 0);
CREATE TABLE my_tenants_part_1 PARTITION OF my_tenants_part FOR VALUES WITH (MODULUS 2, REMAINDER 1);
INSERT INTO my_tenants_part SELECT user_id, tenant_id FROM my_tenants WHERE deleted_at IS NULL;
CREATE TABLE tenants_rls (user_id int, tenant_id int, PRIMARY KEY (user_id, tenant_id));
INSERT INTO tenants_rls SELECT user_id, tenant_id FROM my_tenants WHERE deleted_at IS NULL;
ALTER TABLE tenants_rls ENABLE ROW LEVEL SECURITY;
CREATE TABLE tenants_parent (user_id int, tenant_id int, PRIMARY KEY (user_id, tenant_id));
CREATE TABLE tenants_child () INHERITS (tenants_parent);
INSERT INTO tenants_parent SELECT user_id, tenant_id FROM my_tenants WHERE deleted_at IS NULL;
INSERT INTO tenants_child VALUES (3, 4);
CREATE TABLE tenants_log (user_id int, tenant_id int);
INSERT INTO tenants_log VALUES (1, 2), (1, 5);
CREATE VIEW my_tenants_view AS SELECT user_id, tenant_id FROM my_tenants WHERE deleted_at IS NULL;
CREATE MATERIALIZED VIEW my_tenants_mv AS SELECT user_id, tenant_id FROM my_tenants WHERE deleted_at IS NULL;
VACUUM (FREEZE, ANALYZE) events, tenant_scope, my_tenants, user_home, user_tenants, my_tenants_big, users, my_tenants_part, tenants_rls, tenants_parent, tenants_child, tenants_log;
CREATE TABLE forms (name text PRIMARY KEY, q text);
INSERT INTO forms VALUES
 ('IN, nested IN', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1)) GROUP BY kind$q$),
 ('IN, nested IN, one key', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 2)) GROUP BY kind$q$),
 ('IN, nested IN, conditions of the table', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1 AND role = 'admin' AND deleted_at IS NULL)) GROUP BY kind$q$),
 ('IN, nested IN, every row', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants)) GROUP BY kind$q$),
 ('IN, nested IN, a key repeated', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM user_tenants WHERE user_id = 1)) GROUP BY kind$q$),
 ('IN, nested IN, NULL keys', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM user_tenants WHERE user_id = 4)) GROUP BY kind$q$),
 ('IN, nested IN, no keys', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 3)) GROUP BY kind$q$),
 ('IN, nested IN, a NULL key only', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM user_home WHERE user_id = 3)) GROUP BY kind$q$),
 ('IN, nested IN, bigint keys', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants_big WHERE user_id = 1)) GROUP BY kind$q$),
 ('IN, nested IN, partitioned table', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants_part WHERE user_id = 1)) GROUP BY kind$q$),
 ('IN, nested IN, a CTE of keys', $q$WITH ks AS (SELECT tenant_id FROM my_tenants WHERE user_id = 1) SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM ks)) GROUP BY kind$q$),
 ('EXISTS, nested IN', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE EXISTS (SELECT 1 FROM tenant_scope s WHERE s.dim_a_id = e.dim_a_id AND s.tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1)) GROUP BY kind$q$),
 ('join, one key a user', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN user_home k ON k.tenant_id = s.tenant_id WHERE k.user_id = 1 GROUP BY kind$q$),
 ('join, one key a user, the table in the middle', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e, user_home k, tenant_scope s WHERE s.dim_a_id = e.dim_a_id AND k.tenant_id = s.tenant_id AND k.user_id = 2 GROUP BY kind$q$),
 ('join, one key, a NULL key', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN user_home k ON k.tenant_id = s.tenant_id WHERE k.user_id = 3 GROUP BY kind$q$),
 ('join, one key, no row', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN user_home k ON k.tenant_id = s.tenant_id WHERE k.user_id = 4 GROUP BY kind$q$),
 ('join, a semi join of one key', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id IN (SELECT tenant_id FROM user_home WHERE user_id = 1) GROUP BY kind$q$),
 ('top 5 ids, nested IN', $q$SELECT e.dim_a_id, sum(amount) AS total FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1)) GROUP BY e.dim_a_id ORDER BY total DESC, e.dim_a_id LIMIT 5$q$),
 ('latest 5, nested IN', $q$SELECT id, created_at FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1)) ORDER BY created_at DESC, id LIMIT 5$q$),
 -- near misses: each keeps the join
 ('join, several keys', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN my_tenants k ON k.tenant_id = s.tenant_id WHERE k.user_id = 1 GROUP BY kind$q$),
 ('miss: join, a key repeated', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN user_tenants k ON k.tenant_id = s.tenant_id WHERE k.user_id = 1 GROUP BY kind$q$),
 ('miss: join, no condition on the table', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN user_home k ON k.tenant_id = s.tenant_id GROUP BY kind$q$),
 ('semi join of several keys, a row for each pair', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1) GROUP BY kind$q$),
 ('miss: row-level security, nested IN', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM tenants_rls WHERE user_id = 1)) GROUP BY kind$q$),
 ('miss: row-level security, join', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN tenants_rls k ON k.tenant_id = s.tenant_id WHERE k.user_id = 1 AND k.tenant_id = 2 GROUP BY kind$q$),
 ('miss: view', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants_view WHERE user_id = 1)) GROUP BY kind$q$),
 ('miss: materialized view', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants_mv WHERE user_id = 1)) GROUP BY kind$q$),
 ('miss: inheritance parent', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM tenants_parent WHERE user_id = 1)) GROUP BY kind$q$),
 ('miss: materialized CTE', $q$WITH ks AS MATERIALIZED (SELECT tenant_id FROM my_tenants WHERE user_id = 1) SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM ks)) GROUP BY kind$q$),
 ('miss: sub-select with an aggregate', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT max(tenant_id) FROM my_tenants WHERE user_id = 1)) GROUP BY kind$q$),
 ('miss: volatile condition', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1 AND random() < 2)) GROUP BY kind$q$),
 ('miss: condition that may raise', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1 AND 100 / tenant_id > 0)) GROUP BY kind$q$),
 ('miss: condition on the facts', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = e.amount)) GROUP BY kind$q$),
 ('miss: sub-select of the table of keys and a third table', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT k.tenant_id FROM my_tenants k, users u WHERE u.id = k.user_id AND u.email = 'a@example.com')) GROUP BY kind$q$),
 ('miss: table joined to a third table, join', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id JOIN user_home k ON k.tenant_id = s.tenant_id JOIN users u ON u.id = k.user_id WHERE u.email = 'a@example.com' GROUP BY kind$q$),
 ('miss: key of an expression', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id + 0 FROM my_tenants WHERE user_id = 1)) GROUP BY kind$q$),
 ('miss: key of an enclosing query level', $q$SELECT k, (SELECT count(*) FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = k) AS n FROM generate_series(1, 3) k$q$),
 ('miss: the key bound twice', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 2 AND tenant_id IN (SELECT tenant_id FROM my_tenants WHERE user_id = 1)) GROUP BY kind$q$);
-- the plan: the scope read (its keys and semantics), or the join and the reason the scope pass gave (sift.explain_why, arm scope), else the plan
CREATE FUNCTION label(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text; plan text := '';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		plan := plan || l || E'\n';
	END LOOP;
	IF plan ~ 'Scope Index: ' THEN
		RETURN 'scope read, ' || substring(plan from 'Scope Keys: ([^\n]*)') || ', ' || substring(plan from 'Scope Semantics: ([^\n]*)');
	END IF;
	SELECT regexp_replace(reason, '^.*the join runs as written \((.*)\)$', '\1') INTO r FROM sift.explain_why(q) WHERE arm = 'scope';
	RETURN CASE WHEN r IS NOT NULL THEN 'join, ' || r WHEN plan ~ 'Lookup Joins' THEN 'join' WHEN plan ~ 'SiftAgg' THEN 'SiftAgg' ELSE 'normal plan' END;
END $$;
-- the rows of the statement as planned, with sift.agg_scope off and on the normal plan
CREATE FUNCTION rows_md5(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	DROP TABLE IF EXISTS scope_rows;
	EXECUTE 'CREATE TEMP TABLE scope_rows AS ' || q;
	SELECT md5(coalesce(string_agg(t::text, '|' ORDER BY t::text), '')) INTO r FROM scope_rows t;
	DROP TABLE scope_rows;
	RETURN r;
END $$;
CREATE FUNCTION same(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE a text; b text; c text;
BEGIN
	a := rows_md5(q);
	PERFORM set_config('sift.agg_scope', 'off', false);
	b := rows_md5(q);
	PERFORM set_config('sift.enable_agg', 'off', false);
	c := rows_md5(q);
	PERFORM set_config('sift.agg_scope', 'on', false);
	PERFORM set_config('sift.enable_agg', 'on', false);
	RETURN a = b AND b = c;
END $$;
-- what the run did: the keys it read, the reader's refusal, or the keys it patched
CREATE FUNCTION run_of(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := '';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF l ~ 'Scope (Fallback|Changed Keys|Patched Keys|Dedupe Keys|Members Listed)' OR l ~ 'Scope Keys: .* keys\)$' THEN
			r := r || regexp_replace(regexp_replace(l, '^ *Scope ', ''), 'ARRAY\(.*\) \(', '(') || '; ';
		END IF;
	END LOOP;
	RETURN CASE WHEN r = '' THEN 'units' ELSE rtrim(r, '; ') END;
END $$;
SELECT name, label(q) AS plan, same(q) AS same_rows FROM forms ORDER BY name COLLATE "C";
