DROP INDEX au_old;
-- no column of the index qualifies: nothing written, no notice
CREATE INDEX au_none ON au USING sift_col (id, plain, uniq_id, wide_fk, txt_id, val);
NOTICE:  sift_col index "au_none": the foreign key columns parent_id, set_id, sparse_fk, ext_fk of "au" are not columns of the index
DETAIL:  A join to "au_p" on them keeps the normal plan (join_condition) and the scan cannot filter the table by the keys of another table's rows; a column adds a few bytes a row.
HINT:  Add the columns to the index if queries join on them.
SELECT au_option('au_none') AS option, au_minors('au_none') AS minors;
 option  | minors 
---------+--------
 not set | {12}
(1 row)

DROP INDEX au_none;
-- the workers of a parallel build see the columns, and CREATE INDEX CONCURRENTLY chooses them too
SET max_parallel_maintenance_workers = 3;
SET min_parallel_table_scan_size = 0;
SET parallel_setup_cost = 0;
ALTER TABLE au SET (parallel_workers = 3);
CREATE INDEX au_par ON au USING sift_col (id, parent_id, set_id, region_id, val) WITH (write_buffer_limit = 4096);
NOTICE:  sift_col index "au_par": the foreign key columns sparse_fk, ext_fk, wide_fk of "au" are not columns of the index
DETAIL:  A join to "au_p" on them keeps the normal plan (join_condition) and the scan cannot filter the table by the keys of another table's rows; a column adds a few bytes a row.
HINT:  Add the columns to the index if queries join on them.
NOTICE:  sift_col index au_par keeps the keys of parent_id, set_id, region_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 2376 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX au_par SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
RESET max_parallel_maintenance_workers;
RESET min_parallel_table_scan_size;
RESET parallel_setup_cost;
CREATE INDEX CONCURRENTLY au_conc ON au USING sift_col (id, parent_id, set_id, region_id, val) WITH (write_buffer_limit = 4096);
NOTICE:  sift_col index "au_conc": the foreign key columns sparse_fk, ext_fk, wide_fk of "au" are not columns of the index
DETAIL:  A join to "au_p" on them keeps the normal plan (join_condition) and the scan cannot filter the table by the keys of another table's rows; a column adds a few bytes a row.
HINT:  Add the columns to the index if queries join on them.
NOTICE:  sift_col index au_conc keeps the keys of parent_id, set_id, region_id in every unit
DETAIL:  They are foreign key columns and columns named *_id of type int2, int4 or date that are not unique: a key list or bitmap of each unit, 2376 bytes together, which a count(DISTINCT) of one reads instead of its rows.
HINT:  ALTER INDEX au_conc SET (key_columns = 'off'), then REINDEX, turns it off; key_columns = 'a, b' on CREATE INDEX names the columns.
SELECT au_option('au_par') AS par_option, au_minors('au_par') AS par_minors, au_option('au_conc') AS conc_option, au_minors('au_conc') AS conc_minors;
                   par_option                   | par_minors |                  conc_option                   | conc_minors 
------------------------------------------------+------------+------------------------------------------------+-------------
 key_columns=auto: parent_id, set_id, region_id | {15}       | key_columns=auto: parent_id, set_id, region_id | {15}
(1 row)

SELECT sift.col_verify('au_par', true), sift.col_verify('au_conc', true);
 col_verify | col_verify 
------------+------------
            | 
