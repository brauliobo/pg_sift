-- A group key computed inside the nullable input of an outer join is NULL for the preserved rows, also when it tests a sub-select (IN is hashed).
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE dates (day date PRIMARY KEY);
INSERT INTO dates SELECT d::date FROM generate_series('2026-01-01'::date, '2026-01-20', '1 day') d;
CREATE TABLE facts (id int, day date, country text, amount float8, payload text);
INSERT INTO facts
SELECT i, '2026-01-01'::date + (i % 15), CASE WHEN i % 13 = 0 THEN NULL ELSE (ARRAY['pt', 'br', 'us', 'zz'])[1 + i % 4] END, i % 11, repeat('payload', 50)
FROM generate_series(1, 60000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, day, country, amount);
NOTICE:  sift_col index facts_col writes a rollup of the rows by day, country
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 8 sampled stretches of about a unit, about 75 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX facts_col SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
CREATE TABLE countries (iso text);
INSERT INTO countries VALUES ('pt'), ('br'), ('us'), ('pt');
CREATE TABLE countries_null (iso text);
INSERT INTO countries_null VALUES ('pt'), (NULL);
VACUUM (FREEZE, ANALYZE) facts;
ANALYZE dates;
ANALYZE countries;
ANALYZE countries_null;
\ir test/agg_check_query.sql
\set ECHO none
-- The attribute of the day's facts as a JSON value, NULL for a country outside the list (and for a day without facts).
SELECT * FROM check_query($q$
 SELECT d.day, f.attribute, count(f.id) AS n, sum(f.amount) AS total
 FROM dates d LEFT JOIN (SELECT id, day, amount, CASE WHEN country IN (SELECT iso FROM countries) THEN jsonb_build_object('iso2', country, 'type', 'country') ELSE NULL END AS attribute FROM facts) f ON f.day = d.day
 GROUP BY 1, 2
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

-- The list holds a NULL: IN is NULL, not false, for the countries it lacks.
SELECT * FROM check_query($q$
 SELECT d.day, f.attribute, count(f.id) AS n
 FROM dates d LEFT JOIN (SELECT id, day, CASE WHEN country IN (SELECT iso FROM countries_null) THEN 'listed' WHEN country NOT IN (SELECT iso FROM countries_null) THEN 'other' ELSE 'unknown' END AS attribute FROM facts) f ON f.day = d.day
 GROUP BY 1, 2
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

-- Without the calendar the key is the plain expression of one column.
SELECT * FROM check_query($q$
 SELECT attribute, count(*) AS n
 FROM (SELECT CASE WHEN country IN (SELECT iso FROM countries) THEN jsonb_build_object('iso2', country, 'type', 'country') ELSE NULL END AS attribute FROM facts) f
 GROUP BY 1
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

DROP FUNCTION check_query(text);
DROP TABLE facts, dates, countries, countries_null;
DROP EXTENSION pg_sift;
