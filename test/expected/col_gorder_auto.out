-- order_array_columns is chosen by the build when it is unset or 'auto': a column of 100,000 rows or more with 1,000 or more distinct values whose values are
-- scattered over the heap (correlation under 0.99) gets the global order, so that a range of it reads the entries between its bounds; a column in heap order, with few values, on
-- a smaller table or a narrow index gets none; a table without statistics is analyzed first. A date or timestamp comes before the other columns, as a range or an
-- ORDER BY .. LIMIT is what it is read by. 'off' and a list are the user's.
-- The pad column has strings over 64 bytes: a text column of shorter strings is chosen too (col_gorder_text), and the array holds the strings again, so these tests keep it out.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.async_maintenance = off;
SET max_parallel_maintenance_workers = 0;
CREATE TABLE ga (id int, r int, g int, ts timestamp, pad text);
ALTER TABLE ga ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO ga SELECT i, abs(hashint4(i)) % 5000000, i % 50, timestamp '2024-01-01' + i * interval '1 second', md5(i::text) || md5(i::text || 'x') FROM generate_series(1, 120000) i;
-- no statistics yet: the build analyzes the table and chooses
CREATE INDEX ga_nostats ON ga USING sift_col (id, r, g, ts, pad);
NOTICE:  sift_col index "ga_nostats": order_array_columns = 'auto' adds the sorted keys and heap addresses of r
DETAIL:  3.9 bytes a row for each column, 0.4 MB together; the segments are column format minor 30, which a library before 3.6 cannot read. The build chose them from the statistics of the table: 100,000 rows or more, 1,000 or more distinct values, a correlation with the heap order under 0.99 (the zones cannot skip units), and for a date or timestamp that the default formula pays (the benefit of an ordered read against the growth of the index and of its build), for another column at most a quarter of the index (a table with no statistics is analyzed first).
HINT:  A range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit, and ORDER BY column LIMIT n reads n entries, whatever the number of units. ALTER INDEX .. SET (order_array_columns = 'off'), then REINDEX, drops it; set sift.col_format_minor to 14 to write none.
SELECT reloptions FROM pg_class WHERE relname = 'ga_nostats';
           reloptions            
---------------------------------
 {"order_array_columns=auto: r"}
(1 row)

DROP INDEX ga_nostats;
ANALYZE ga;
-- r is scattered, g has 50 values, id and ts follow the heap
CREATE INDEX ga_auto ON ga USING sift_col (id, r, g, ts, pad);
NOTICE:  sift_col index "ga_auto": order_array_columns = 'auto' adds the sorted keys and heap addresses of r
DETAIL:  3.9 bytes a row for each column, 0.4 MB together; the segments are column format minor 30, which a library before 3.6 cannot read. The build chose them from the statistics of the table: 100,000 rows or more, 1,000 or more distinct values, a correlation with the heap order under 0.99 (the zones cannot skip units), and for a date or timestamp that the default formula pays (the benefit of an ordered read against the growth of the index and of its build), for another column at most a quarter of the index (a table with no statistics is analyzed first).
HINT:  A range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit, and ORDER BY column LIMIT n reads n entries, whatever the number of units. ALTER INDEX .. SET (order_array_columns = 'off'), then REINDEX, drops it; set sift.col_format_minor to 14 to write none.
SELECT reloptions FROM pg_class WHERE relname = 'ga_auto';
           reloptions            
---------------------------------
 {"order_array_columns=auto: r"}
(1 row)

SELECT min(format) AS format FROM sift.col_segments('ga_auto') WHERE kind = 'immutable';
 format 
--------
     30
(1 row)

-- a range of r reads the addresses and no unit
SELECT p.units AS units_with_addresses, p.rows = 0 AS no_row_read, f.units > p.units AS fewer_units
FROM sift._test_col_counters('ga_auto', '1:ge:2000000;1:le:2004000', 24) p, sift._test_col_counters('ga_auto', '1:ge:2000000;1:le:2004000', 0) f;
 units_with_addresses | no_row_read | fewer_units 
----------------------+-------------+-------------
                    0 | t           | t
(1 row)

-- off and a list are the user's
CREATE INDEX ga_off ON ga USING sift_col (id, r, g, ts, pad) WITH (order_array_columns = off);
NOTICE:  sift_col index "ga_off": point_tid_columns includes "r", chosen by the default formula: an equality on its nearly unique values, which do not follow the order of the table, would read every unit (about 0.8 M instructions against 0.2 M with the directory; predicted index size +5%, 3.7 bytes a row, benefit 28 against cost 6)
HINT:  ALTER INDEX ga_off SET (point_tid_columns = 'off') and REINDEX keep the index without it.
CREATE INDEX ga_list ON ga USING sift_col (id, r, g, ts, pad) WITH (order_columns = 'g', order_array_columns = 'g');
NOTICE:  sift_col index "ga_list": point_tid_columns includes "r", chosen by the default formula: an equality on its nearly unique values, which do not follow the order of the table, would read every unit (about 0.8 M instructions against 0.2 M with the directory; predicted index size +5%, 3.7 bytes a row, benefit 28 against cost 6)
HINT:  ALTER INDEX ga_list SET (point_tid_columns = 'off') and REINDEX keep the index without it.
NOTICE:  sift_col index "ga_list": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  0.5 bytes a row for each column, 0.1 MB together; the segments are column format minor 30, which a library before 3.6 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
SELECT relname, reloptions FROM pg_class WHERE relname IN ('ga_off', 'ga_list') ORDER BY 1;
 relname |                             reloptions                              
---------+---------------------------------------------------------------------
 ga_list | {order_columns=g,order_array_columns=g,"point_tid_columns=auto: r"}
 ga_off  | {order_array_columns=off,"point_tid_columns=auto: r"}
(2 rows)

-- the update list is for an option that names columns: off is not a gain to reindex for
SELECT count(*) AS commands FROM sift.upgrade_commands() WHERE object = 'ga_off'::regclass;
 commands 
----------
        0
(1 row)

DROP INDEX ga_auto, ga_off, ga_list;
-- a narrow index of small columns: the arrays would be a third of it
CREATE INDEX ga_narrow ON ga USING sift_col (id, r, g) WITH (point_tid_columns = 'off');
SELECT reloptions FROM pg_class WHERE relname = 'ga_narrow';
       reloptions        
-------------------------
 {point_tid_columns=off}
(1 row)

DROP INDEX ga_narrow;
-- a table under 100,000 rows
CREATE TABLE gs AS SELECT id, r, g, ts, pad FROM ga WHERE id <= 90000;
ANALYZE gs;
CREATE INDEX gs_i ON gs USING sift_col (id, r, g, ts, pad);
NOTICE:  sift_col index "gs_i": point_tid_columns includes "r", chosen by the default formula: an equality on its nearly unique values, which do not follow the order of the table, would read every unit (about 0.6 M instructions against 0.2 M with the directory; predicted index size +5%, 3.8 bytes a row, benefit 23 against cost 6)
HINT:  ALTER INDEX gs_i SET (point_tid_columns = 'off') and REINDEX keep the index without it.
SELECT reloptions FROM pg_class WHERE relname = 'gs_i';
          reloptions           
-------------------------------
 {"point_tid_columns=auto: r"}
(1 row)

-- the choice is made again by REINDEX: after the statistics change the column is dropped
CREATE INDEX ga_re ON ga USING sift_col (id, r, g, ts, pad);
NOTICE:  sift_col index "ga_re": order_array_columns = 'auto' adds the sorted keys and heap addresses of r
DETAIL:  3.9 bytes a row for each column, 0.4 MB together; the segments are column format minor 30, which a library before 3.6 cannot read. The build chose them from the statistics of the table: 100,000 rows or more, 1,000 or more distinct values, a correlation with the heap order under 0.99 (the zones cannot skip units), and for a date or timestamp that the default formula pays (the benefit of an ordered read against the growth of the index and of its build), for another column at most a quarter of the index (a table with no statistics is analyzed first).
HINT:  A range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit, and ORDER BY column LIMIT n reads n entries, whatever the number of units. ALTER INDEX .. SET (order_array_columns = 'off'), then REINDEX, drops it; set sift.col_format_minor to 14 to write none.
SELECT reloptions FROM pg_class WHERE relname = 'ga_re';
           reloptions            
---------------------------------
 {"order_array_columns=auto: r"}
(1 row)

UPDATE ga SET r = id;
ANALYZE ga;
REINDEX INDEX ga_re;
SELECT reloptions FROM pg_class WHERE relname = 'ga_re';
         reloptions         
----------------------------
 {order_array_columns=auto}
(1 row)

-- a table never analyzed, a timestamp at random in the heap and another column of more values: both are chosen, the timestamp first
CREATE TABLE gt (id int, v int, ts timestamptz, pad text);
ALTER TABLE gt ALTER COLUMN pad SET STORAGE PLAIN;
SELECT setseed(0.5);
 setseed 
---------
 
(1 row)

INSERT INTO gt SELECT i, (random() * 100000000)::int, timestamptz '2024-01-01' + random() * interval '700 days', md5(i::text) || md5(i::text || 'x') FROM generate_series(1, 120000) i;
CREATE INDEX gt_i ON gt USING sift_col (id, v, ts, pad);
NOTICE:  sift_col index "gt_i": order_array_columns = 'auto' adds the sorted keys and heap addresses of v, ts
DETAIL:  5.7 bytes a row for each column, 1.3 MB together; the segments are column format minor 30, which a library before 3.6 cannot read. The build chose them from the statistics of the table: 100,000 rows or more, 1,000 or more distinct values, a correlation with the heap order under 0.99 (the zones cannot skip units), and for a date or timestamp that the default formula pays (the benefit of an ordered read against the growth of the index and of its build), for another column at most a quarter of the index (a table with no statistics is analyzed first).
HINT:  A range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit, and ORDER BY column LIMIT n reads n entries, whatever the number of units. ALTER INDEX .. SET (order_array_columns = 'off'), then REINDEX, drops it; set sift.col_format_minor to 14 to write none.
SELECT reloptions FROM pg_class WHERE relname = 'gt_i';
             reloptions              
-------------------------------------
 {"order_array_columns=auto: ts, v"}
(1 row)

-- a REINDEX cannot analyze (ANALYZE opens the index it rebuilds): a table without statistics chooses nothing
DELETE FROM pg_statistic WHERE starelid = 'gt'::regclass;
ALTER INDEX gt_i RESET (order_array_columns);
REINDEX INDEX gt_i;
REINDEX TABLE gt;
SELECT reloptions FROM pg_class WHERE relname = 'gt_i';
 reloptions 
------------
 
(1 row)

DROP TABLE ga, gs, gt;
DROP EXTENSION pg_sift_test, pg_sift CASCADE;
