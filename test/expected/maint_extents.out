-- The runs of a segment stream grow with it, so a segment of any size fits the extents its header page
-- lists (about 1000): 8 GB took them all when runs stopped at 1024 blocks and another writer allocated
-- between two of them. A stream of unknown size starts with runs of 16 blocks and grows them by a 16th of what it has written (the unused
-- end of its last run is the hole it leaves). Here the cap is 160 extents (sift.test_max_extents), a page taken by another
-- writer follows every run (sift.test_run_gap) and the segment is 400 MB: 3200 extents of a fixed 16 blocks, 50 of a fixed 1024, about 100 of the growing runs.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE UNLOGGED TABLE ex (v int);
CREATE INDEX ex_idx ON ex USING sift_store_test (v);
SET sift.test_run_gap = on;
SET sift.test_max_extents = 160;
SELECT sift._test_seg_write('ex_idx', 400::bigint << 20, 0) > 0 AS written;
 written 
---------
 t
(1 row)

SELECT nextents BETWEEN 8 AND 160 AS within_cap, size >> 20 AS mb FROM sift._test_segments('ex_idx');
 within_cap | mb  
------------+-----
 t          | 400
(1 row)

RESET sift.test_run_gap;
SELECT sift._test_seg_read('ex_idx', gen, 2) = payload AS reads_back FROM sift._test_segments('ex_idx');
 reads_back 
------------
 t
(1 row)

SELECT sift._test_check('ex_idx') >= 0 AS consistent;
 consistent 
------------
 t
(1 row)

DROP TABLE ex;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
