DROP TABLE items, kinds, kinds_u, parents, p_q;
DROP FUNCTION report(text, text, text, text, text, text), p_rows(text, bool, int), p_mode(text), p_launched(text), p_compare(int[]), p_each(bool);
DROP EXTENSION pg_sift;
