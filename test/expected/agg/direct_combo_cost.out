-- An argument that PostgreSQL evaluates (a column minus a column) is paid for each row the scan reads: the second column decoded, the row put in the slot of the
-- expression and its operator (2.0 ms for the maximum of a column of 60,000 rows, 4.9 ms for the maximum of the difference of two columns of 10 distinct pairs, 6.1 ms
-- for 60,000 distinct pairs, whose columns take more bytes), so the scan costs more than twice the maximum of a column, and the distinct pairs no less than the few.
-- The estimates are compared with each other, not with a time. Every statement is also run with sift.enable_agg = off: the rows must be the same.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_helpers;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE spans (id int PRIMARY KEY, tenant int NOT NULL, few_s int NOT NULL, few_e int NOT NULL, many_s int NOT NULL, many_e int NOT NULL);
INSERT INTO spans SELECT g, g % 50, g % 10, g % 10 + 5, g, g + 3 FROM generate_series(1, 60000) g;
CREATE INDEX spans_col ON spans USING sift_col (id, tenant, few_s, few_e, many_s, many_e) WITH (rollup_columns = 'off');
VACUUM (FREEZE, ANALYZE) spans;
CREATE FUNCTION scan_cost(q text) RETURNS numeric LANGUAGE sql AS $$ SELECT scan_cost::numeric FROM sift.explain_why(q) WHERE scan_cost IS NOT NULL $$;
CREATE FUNCTION differences(q text) RETURNS bigint LANGUAGE sql AS $$ SELECT sift_helpers.differences_agg(q) $$;
-- the rows of 10 distinct pairs cost more than twice the maximum of one column; 60,000 distinct pairs cost 1 to 1.5 times the 10
SELECT scan_cost('SELECT tenant, max(few_e - few_s) FROM spans GROUP BY tenant') > 2 * scan_cost('SELECT tenant, max(few_e) FROM spans GROUP BY tenant') AS rows_priced,
       scan_cost('SELECT tenant, max(many_e - many_s) FROM spans GROUP BY tenant') / scan_cost('SELECT tenant, max(few_e - few_s) FROM spans GROUP BY tenant') BETWEEN 1 AND 1.5 AS entries_priced;
 rows_priced | entries_priced 
-------------+----------------
 t           | t
(1 row)

SELECT differences('SELECT tenant, max(few_e - few_s) FROM spans GROUP BY tenant') AS few_differences,
       differences('SELECT tenant, max(many_e - many_s) FROM spans GROUP BY tenant') AS many_differences;
 few_differences | many_differences 
-----------------+------------------
               0 |                0
(1 row)

DROP FUNCTION differences(text);
DROP FUNCTION scan_cost(text);
DROP TABLE spans;
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift;
