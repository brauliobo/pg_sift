-- A typed path cast in the head of a star join, `sum((doc ->> 'v')::float8)`, over fact rows whose value is no number. PostgreSQL casts only the rows the join
-- keeps: an inner join that drops them raises nothing, a left join that keeps them raises. The scan converts every row it reads before the join, so a join
-- that can drop a row keeps the normal plan; a left join keeps the scan. Every query runs with and without the pushdown; the rows, or the error, must be the same.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET seq_page_cost = 1000;
SET random_page_cost = 1000;
\ir test/common/sql/agg/base.sql
\set ECHO none
CREATE FUNCTION outcome(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text := runq(q, false); b text := runq(q, true);
BEGIN
	RETURN CASE WHEN a <> b THEN format('DIFF off=%s on=%s', left(a, 120), left(b, 120))
	            WHEN a LIKE 'ERR %' THEN 'same ' || left(a, 70) ELSE 'same rows' END;
END $$;
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, doc jsonb) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, i % 10, jsonb_build_object('v', i % 17 + 0.5) FROM generate_series(1, 2000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, doc) WITH (paths = 'doc.v float8');
UPDATE facts SET doc = '{"v": "abc"}' WHERE dim_a_id = 9 AND id % 50 = 9;
CREATE TABLE dim_a (id int PRIMARY KEY, label text);
INSERT INTO dim_a SELECT i, 'l' || i % 3 FROM generate_series(0, 8) i;
VACUUM ANALYZE facts;
ANALYZE dim_a;
CREATE TABLE q (n text PRIMARY KEY, q text);
INSERT INTO q VALUES
	('inner',     'SELECT d.label, sum((f.doc ->> ''v'')::float8) FROM facts f JOIN dim_a d ON d.id = f.dim_a_id GROUP BY d.label'),
	('semi',      'SELECT sum((f.doc ->> ''v'')::float8) FROM facts f WHERE EXISTS (SELECT 1 FROM dim_a d WHERE d.id = f.dim_a_id)'),
	('left',      'SELECT d.label, sum((f.doc ->> ''v'')::float8) FROM facts f LEFT JOIN dim_a d ON d.id = f.dim_a_id GROUP BY d.label'),
	('left kept', 'SELECT d.label, count(*) FROM facts f LEFT JOIN dim_a d ON d.id = f.dim_a_id WHERE f.dim_a_id < 9 GROUP BY d.label');
SELECT n, CASE WHEN pushed(q) THEN 'scan' ELSE 'normal' END AS plan, outcome(q) FROM q ORDER BY n;
     n     |  plan  |                               outcome                                
-----------+--------+----------------------------------------------------------------------
 inner     | normal | same rows
 left      | scan   | same ERR 22P02 invalid input syntax for type double precision: "abc"
 left kept | scan   | same rows
 semi      | scan   | same rows
(4 rows)

DROP TABLE q, facts, dim_a;
DROP FUNCTION outcome(text);
DROP FUNCTION runq(text, bool), outcome, runs_in_scan, pushed;
DROP EXTENSION pg_sift;
