-- The joins of Custom Scan (SiftAggV6) that look a key up in a relation that may hold it more than once or be any plan: every statement runs on the node and with sift.enable_agg = off,
-- and the rows must be the same. inner, left, right, full, semi and anti joins, an inequality beside the key, VALUES, CTE, sub-select and join-tree dimensions, a composite key,
-- and the same dimensions under the unnest of a jsonb array; keys and arguments that are expressions of the columns of the joined rows.
CREATE EXTENSION pg_sift;
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET sift.agg_force = on;
CREATE TABLE f (id int PRIMARY KEY, k int, g text, v int, items jsonb, doc jsonb) WITH (autovacuum_enabled = false);
INSERT INTO f
SELECT i, CASE WHEN i % 17 = 0 THEN NULL WHEN i % 11 = 0 THEN 900 + i % 3 ELSE 1 + i % 20 END, 'g' || (i % 4), i % 50,
       jsonb_build_array(jsonb_build_object('category', 'c' || (i % 5), 'qty', i % 7), jsonb_build_object('category', 'c' || (i % 3), 'qty', i % 4)),
       CASE WHEN i % 3 > 0 THEN jsonb_build_object('a', i % 2, 't', 'j' || (i % 6)) END
FROM generate_series(1, 3000) i;
CREATE INDEX f_col ON f USING sift_col (id, k, g, v, items, doc) WITH (paths = 'items[]{category text, qty int4}, doc->a int4, doc->t text');
VACUUM (FREEZE, ANALYZE) f;
-- keys that repeat, NULL keys, keys no row of f has (21 to 25, 1000) and a text key
CREATE TABLE d (k int, t text, w int);
INSERT INTO d SELECT 1 + i % 25, 't' || (i % 4), i % 30 FROM generate_series(1, 60) i;
INSERT INTO d VALUES (NULL, 'tn', 5), (NULL, 'tn', 6), (1000, 'tx', 1);
CREATE TABLE e (t text, z int);
INSERT INTO e VALUES ('t0', 1), ('t1', 2), ('t1', 3), ('t2', 0), (NULL, 4);
CREATE TABLE m (category text, tag text);
INSERT INTO m VALUES ('c0', 'a'), ('c0', 'x'), ('c1', NULL), ('c2', 'b'), (NULL, 'n'), ('c4', 'x'), ('c0', 't1'), ('c0', 't1'), ('c1', 't2'), ('c2', 't0');
ANALYZE d; ANALYZE e; ANALYZE m;
CREATE FUNCTION same(q text) RETURNS TABLE (engine text, result_rows bigint, vs_heap bigint) LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	engine := 'normal';
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%Custom Scan (SiftAggV6)%' THEN engine := 'SiftAggV6'; END IF;
		IF l LIKE '%SiftAggV6Push%' THEN engine := 'push'; END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS SELECT x::text AS r FROM (%s) x', q);
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS SELECT x::text AS r FROM (%s) x', q);
	RESET sift.enable_agg;
	result_rows := (SELECT count(*) FROM r_on);
	vs_heap := (SELECT count(*) FROM ((TABLE r_on EXCEPT ALL TABLE r_off) UNION ALL (TABLE r_off EXCEPT ALL TABLE r_on)) x);
	DROP TABLE r_on, r_off;
	RETURN NEXT;
END $$;
CREATE TABLE stmts (id int, q text);
INSERT INTO stmts VALUES
(1, 'SELECT f.g, count(*), sum(d.w) FROM f JOIN d ON d.k = f.k GROUP BY f.g'),
(2, 'SELECT f.g, count(*), count(d.t), sum(d.w) FROM f LEFT JOIN d ON d.k = f.k GROUP BY f.g'),
(3, 'SELECT d.t, count(f.id), count(*) FROM f RIGHT JOIN d ON d.k = f.k GROUP BY d.t'),
(4, 'SELECT d.t, f.g, count(f.id), count(*) FROM f FULL JOIN d ON d.k = f.k GROUP BY d.t, f.g'),
(5, 'SELECT g, count(*) FROM f WHERE EXISTS (SELECT 1 FROM d WHERE d.k = f.k AND d.w > 10) AND EXISTS (SELECT 1 FROM e WHERE e.z = f.v) GROUP BY g'),
(6, 'SELECT g, count(*) FROM f WHERE f.k IN (SELECT k FROM d WHERE w < 5) AND f.v IN (SELECT z FROM e) GROUP BY g'),
(7, 'SELECT g, count(*) FROM f WHERE NOT EXISTS (SELECT 1 FROM d WHERE d.k = f.k AND d.w > 10) GROUP BY g'),
(8, 'SELECT f.g, count(*) FROM f JOIN d ON d.k = f.k AND f.v < d.w GROUP BY f.g'),
(9, 'SELECT f.g, count(*), sum(f.v) FROM f JOIN d ON d.k = f.k AND f.v BETWEEN d.w AND d.w + 3 GROUP BY f.g'),
(10, 'SELECT x.t, count(*) FROM f JOIN (VALUES (1, ''a''), (2, ''b''), (2, ''c''), (NULL, ''n'')) x(k, t) ON x.k = f.k GROUP BY x.t'),
(11, 'WITH c AS MATERIALIZED (SELECT k, t, w FROM d WHERE w > 3) SELECT c.t, count(*) FROM f JOIN c ON c.k = f.k GROUP BY c.t'),
(12, 'SELECT s.mw, count(*) FROM f JOIN (SELECT k, min(w) mw FROM d GROUP BY k) s ON s.k = f.k GROUP BY s.mw'),
(13, 'SELECT count(*), sum(d.w) FROM f JOIN d ON d.k = f.k AND d.t = f.g'),
(14, 'SELECT g, count(*) FROM f WHERE f.k IN (SELECT d.k FROM d JOIN e ON e.t = d.t WHERE e.z > 1) GROUP BY g'),
(15, 'SELECT g, count(*) FROM f WHERE NOT EXISTS (SELECT 1 FROM d JOIN e ON e.t = d.t WHERE d.k = f.k AND e.z > 1) GROUP BY g'),
(16, 'SELECT count(*) FROM f a JOIN f b ON a.k = b.k AND a.id < b.id'),
(17, 'SELECT i.category, count(*), count(m.tag) FROM f CROSS JOIN LATERAL jsonb_to_recordset(f.items) AS i(category text, qty int) LEFT JOIN m ON m.category = i.category WHERE m.tag IS NULL OR m.tag <> ''x'' GROUP BY i.category'),
(18, 'SELECT i.category, count(*), sum(i.qty) FROM f CROSS JOIN LATERAL jsonb_to_recordset(f.items) AS i(category text, qty int) WHERE EXISTS (SELECT 1 FROM m WHERE m.category = i.category AND m.tag IS NOT NULL) GROUP BY i.category'),
(19, 'SELECT i.category, count(*), count(DISTINCT f.id) FROM f CROSS JOIN LATERAL jsonb_to_recordset(f.items) AS i(category text, qty int) WHERE NOT EXISTS (SELECT 1 FROM m WHERE m.category = i.category) GROUP BY i.category'),
(20, 'SELECT d.t, count(*) FROM f CROSS JOIN LATERAL jsonb_to_recordset(f.items) AS i(category text, qty int) JOIN d ON d.k = f.k JOIN m ON m.category = i.category AND m.tag = d.t GROUP BY d.t'),
-- keys and arguments of the joined rows: expressions of the columns of a dimension, of the fact table and of the element, computed on each joined row (the NULLs of an unmatched dimension too)
(21, 'SELECT d.w % 3, count(*), sum(f.v) FROM f JOIN d ON d.k = f.k GROUP BY 1'),
(22, 'SELECT coalesce(d.t, ''-'') || f.g, count(*), sum(coalesce(d.w, -1) + f.v) FROM f LEFT JOIN d ON d.k = f.k GROUP BY 1'),
(23, 'SELECT coalesce(m.tag, ''-''), count(*), count(DISTINCT i.category) FROM f CROSS JOIN LATERAL jsonb_to_recordset(f.items) AS i(category text, qty int) LEFT JOIN m ON m.category = i.category GROUP BY 1'),
(24, 'SELECT g.n % 4, count(*) FROM f JOIN generate_series(1, 12) AS g(n) ON f.k = g.n GROUP BY 1'),
(25, 'SELECT f.g, count(*) FILTER (WHERE d.w > 10), sum(f.v) FILTER (WHERE d.t = ''t1'' OR f.v < 5), count(*) FILTER (WHERE coalesce(d.w, 0) + f.v > 30) FROM f LEFT JOIN d ON d.k = f.k GROUP BY 1'),
-- keys of the rows of an unnest that the groups take by their values (a jsonb), and one a hashed sub-plan computes, which the node prepares for the scan of the unnest
(26, 'SELECT jsonb_build_object(''g'', f.g), count(*), sum(i.qty) FROM f CROSS JOIN LATERAL jsonb_to_recordset(f.items) AS i(category text, qty int) GROUP BY 1'),
(27, 'SELECT CASE WHEN f.v IN (SELECT w FROM d) THEN jsonb_build_object(''v'', f.v % 3) END, i.category, sum(i.qty) FROM f CROSS JOIN LATERAL jsonb_to_recordset(f.items) AS i(category text, qty int) GROUP BY 1, 2'),
-- a key of the joined rows that reads a key of a document of the fact table beside a column of the dimension
(28, 'SELECT CASE WHEN f.doc ->> ''t'' IS NOT NULL THEN f.doc ->> ''t'' ELSE d.t END, count(*), sum(f.v) FROM f LEFT JOIN d ON d.k = f.k GROUP BY 1');
SELECT id, (same(q)).* FROM stmts ORDER BY id;
