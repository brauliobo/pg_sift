-- the arms of a statement that join the same table (the same columns and conditions, the same keys) read it once: the second node uses the first one's table
CREATE FUNCTION arms(q text) RETURNS TABLE (nodes bigint, shared_dimensions bigint, vs_heap bigint) LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	nodes := 0; shared_dimensions := 0;
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) ' || q LOOP
		nodes := nodes + (l LIKE '%Custom Scan (SiftAggV6)%')::int;
		shared_dimensions := shared_dimensions + coalesce(substring(l from 'Shared Dimensions: (\d+)')::int, 0);
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS SELECT x::text AS r FROM (%s) x', q);
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS SELECT x::text AS r FROM (%s) x', q);
	RESET sift.enable_agg;
	vs_heap := (SELECT count(*) FROM ((TABLE r_on EXCEPT ALL TABLE r_off) UNION ALL (TABLE r_off EXCEPT ALL TABLE r_on)) x);
	DROP TABLE r_on, r_off;
	RETURN NEXT;
END $$;
SELECT (arms(q)).* FROM (VALUES
 ('SELECT a.g, a.n, b.n FROM (SELECT f.g, sum(d.w) n FROM f JOIN d ON d.k = f.k GROUP BY f.g) a JOIN (SELECT f.g, min(d.w) n FROM f JOIN d ON d.k = f.k WHERE f.v > 3 GROUP BY f.g) b USING (g)'),
 ('SELECT a.g, a.n, b.n FROM (SELECT f.g, sum(d.w) n FROM f JOIN d ON d.k = f.k GROUP BY f.g) a JOIN (SELECT f.g, min(d.w) n FROM f JOIN d ON d.k = f.k AND d.w > 3 GROUP BY f.g) b USING (g)')) v(q);
 nodes | shared_dimensions | vs_heap 
-------+-------------------+---------
     2 |                 1 |       0
     2 |                 0 |       0
(2 rows)

DROP FUNCTION same(text), arms(text);
DROP TABLE stmts, f, d, e, m;
DROP EXTENSION pg_sift;
