-- The scan of the facts of a scope key (a statement that conditions a leaf no cube holds) takes as the members of the key those of the pairs of the scope: the rows of the pairs relation that its
-- unique btree and the predicate of it give, not every row that has the key. Each line is a statement over the members of one tenant: whether its rows are those of the join as written
-- (sift.enable_agg = off) and what the plan read, before and after pairs are soft deleted, revoked and granted again.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
CREATE TABLE links (id int PRIMARY KEY, dim_a_id int NOT NULL, tenant_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX links_live ON links (dim_a_id, tenant_id) WHERE deleted_at IS NULL;
CREATE INDEX links_journal ON links USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
INSERT INTO links SELECT i, 1 + (i * 7) % 400, 1 + i % 9, CASE WHEN i % 13 = 0 THEN now() END FROM generate_series(1, 1500) i ON CONFLICT DO NOTHING;
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int NOT NULL, created_at date NOT NULL, kind text NOT NULL, region text NOT NULL, amount int NOT NULL) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 31) % 400, DATE '2026-01-01' + i % 300, 'k' || i % 5, 'r' || i % 7, i % 100 FROM generate_series(1, 20000) i;
CREATE INDEX events_s ON events USING sift_col (id, dim_a_id, created_at, kind, region, amount) WITH (scope = 'tenant_id: dim_a_id -> links(dim_a_id, tenant_id)', track_changes = 'ctid');
VACUUM (ANALYZE) events, links;
SET seq_page_cost = 1000;
SET random_page_cost = 1000;
CREATE FUNCTION probe(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text; l text; plan text := ''; read text := '-';
BEGIN
	SET LOCAL sift.enable_agg = on;
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		plan := plan || l;
		IF l LIKE '%Scope Read: %' THEN read := trim(substr(l, position('Scope Read: ' in l) + 12)); END IF;
	END LOOP;
	EXECUTE 'SELECT md5(coalesce(string_agg(r::text, ''|'' ORDER BY r::text), '''')) FROM (' || q || ') r' INTO a;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'SELECT md5(coalesce(string_agg(r::text, ''|'' ORDER BY r::text), '''')) FROM (' || q || ') r' INTO b;
	RETURN (CASE WHEN a IS DISTINCT FROM b THEN 'DIFFERENT' ELSE 'same' END) || ' ' || (CASE WHEN plan LIKE '%SiftAggV6Scope%' THEN 'scope, ' || read WHEN plan LIKE '%SiftAggV6%' THEN 'aggregate scan' ELSE 'normal' END);
END $$;
CREATE FUNCTION matrix() RETURNS TABLE (tenant int, result text) LANGUAGE sql AS $$
	SELECT t, probe(format('SELECT kind, count(*), sum(e.amount) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL AND e.region = ''r3'' GROUP BY 1', t))
	FROM generate_series(1, 10) t ORDER BY t $$;
SELECT * FROM matrix();
 tenant |                         result                         
--------+--------------------------------------------------------
      1 | same scope, scan of the facts (the members of the key)
      2 | same scope, scan of the facts (the members of the key)
      3 | same scope, scan of the facts (the members of the key)
      4 | same scope, scan of the facts (the members of the key)
      5 | same scope, scan of the facts (the members of the key)
      6 | same scope, scan of the facts (the members of the key)
      7 | same scope, scan of the facts (the members of the key)
      8 | same scope, scan of the facts (the members of the key)
      9 | same scope, scan of the facts (the members of the key)
     10 | same scope, scan of the facts (the members of the key)
(10 rows)

-- pairs change
UPDATE links SET deleted_at = now() WHERE id % 29 = 0;
UPDATE links SET tenant_id = 1 + tenant_id % 9 WHERE id % 31 = 1 AND deleted_at IS NULL AND NOT EXISTS (SELECT 1 FROM links l WHERE l.dim_a_id = links.dim_a_id AND l.tenant_id = 1 + links.tenant_id % 9 AND l.deleted_at IS NULL);
INSERT INTO links SELECT 5000 + i, 1 + (i * 11) % 400, 4, NULL FROM generate_series(1, 30) i ON CONFLICT DO NOTHING;
SELECT * FROM matrix();
 tenant |                         result                         
--------+--------------------------------------------------------
      1 | same scope, scan of the facts (the members of the key)
      2 | same scope, scan of the facts (the members of the key)
      3 | same scope, scan of the facts (the members of the key)
      4 | same scope, scan of the facts (the members of the key)
      5 | same scope, scan of the facts (the members of the key)
      6 | same scope, scan of the facts (the members of the key)
      7 | same scope, scan of the facts (the members of the key)
      8 | same scope, scan of the facts (the members of the key)
      9 | same scope, scan of the facts (the members of the key)
     10 | same scope, scan of the facts (the members of the key)
(10 rows)

VACUUM events, links;
SELECT * FROM matrix();
 tenant |                         result                         
--------+--------------------------------------------------------
      1 | same scope, scan of the facts (the members of the key)
      2 | same scope, scan of the facts (the members of the key)
      3 | same scope, scan of the facts (the members of the key)
      4 | same scope, scan of the facts (the members of the key)
      5 | same scope, scan of the facts (the members of the key)
      6 | same scope, scan of the facts (the members of the key)
      7 | same scope, scan of the facts (the members of the key)
      8 | same scope, scan of the facts (the members of the key)
      9 | same scope, scan of the facts (the members of the key)
     10 | same scope, scan of the facts (the members of the key)
(10 rows)

DROP FUNCTION matrix(), probe(text);
DROP TABLE events, links;
DROP EXTENSION pg_sift;
