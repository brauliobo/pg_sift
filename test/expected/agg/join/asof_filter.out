-- SiftAggV6Asof under a qual on the columns of the LATERAL subquery: the qual cannot go past its LIMIT 1, so it stays on the subquery's rel and the ASOF node is not the plan of the join.
-- Every statement is compared with the rows of the normal plan (sift.enable_agg = off).
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET sift.async_maintenance = off;
SET sift.test_create_format1 = off;
SET sift.agg_force = on;
SET enable_nestloop = off;
CREATE FUNCTION has_node(q text, node text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%' || node || '%' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
CREATE FUNCTION same_rows(q text) RETURNS TABLE (n bigint, diff bigint) LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE 'CREATE TEMP TABLE r_on AS ' || q;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'CREATE TEMP TABLE r_off AS ' || q;
	RESET sift.enable_agg;
	SELECT count(*) INTO n FROM r_off;
	SELECT count(*) INTO diff FROM ((TABLE r_on EXCEPT ALL TABLE r_off) UNION ALL (TABLE r_off EXCEPT ALL TABLE r_on)) x;
	DROP TABLE r_on, r_off;
	RETURN NEXT;
END $$;
CREATE TABLE ad (k int, ts bigint, px int, PRIMARY KEY (k, ts)) USING sift_table;
SELECT sift.table_set_option('ad', 'key_order', 'k, ts');
 table_set_option 
------------------
 
(1 row)

INSERT INTO ad SELECT g % 50, g::bigint * 13, g % 200 FROM generate_series(1, 5000) g;
CREATE TABLE af (k int, ts bigint, id int, PRIMARY KEY (k, ts)) USING sift_table;
SELECT sift.table_set_option('af', 'key_order', 'k, ts');
 table_set_option 
------------------
 
(1 row)

INSERT INTO af SELECT g % 50, g::bigint * 10 + g % 7, g FROM generate_series(1, 5000) g;
SELECT sift.table_maintain(t) IS NOT NULL FROM unnest(ARRAY['af', 'ad']) t;
 ?column? 
----------
 t
 t
(2 rows)

ANALYZE af, ad;
SELECT q, has_node(q, 'SiftAggV6Asof') AS asof, s.* FROM (VALUES
	('SELECT f.id, x.px FROM af f LEFT JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true'),
	('SELECT f.id, x.px FROM af f LEFT JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true WHERE x.px > 100'),
	('SELECT f.id, x.px FROM af f JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true WHERE x.px > 100'),
	('SELECT f.id, x.px FROM af f LEFT JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true WHERE x.px IS NULL')
) v(q), same_rows(q) s;
                                                                              q                                                                               | asof |  n   | diff 
--------------------------------------------------------------------------------------------------------------------------------------------------------------+------+------+------
 SELECT f.id, x.px FROM af f LEFT JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true                    | t    | 5000 |    0
 SELECT f.id, x.px FROM af f LEFT JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true WHERE x.px > 100   | f    | 2424 |    0
 SELECT f.id, x.px FROM af f JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true WHERE x.px > 100        | f    | 2424 |    0
 SELECT f.id, x.px FROM af f LEFT JOIN LATERAL (SELECT px FROM ad d WHERE d.k = f.k AND d.ts <= f.ts ORDER BY d.ts DESC LIMIT 1) x ON true WHERE x.px IS NULL | f    |   50 |    0
(4 rows)

DROP TABLE ad, af;
DROP FUNCTION has_node(text, text), same_rows(text);
DROP EXTENSION pg_sift;
