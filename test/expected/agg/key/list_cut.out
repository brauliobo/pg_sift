-- An index in the order of a key (key_order) helps when the rows of one key are in every granule and a lookup of a few keys (a CTE of ids, a list)
-- would read them all: the zones of the granules are ranges of the key, and a scan of 8 of 400 parents reads the granules of the 8 keys, not all of them. The keys of a
-- dimension of a star join (the CTE) narrow the scan of the facts as the constants of a list do: no fact row outside their range finds a match.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET max_parallel_maintenance_workers = 0;
CREATE TABLE kl_parents (id int PRIMARY KEY, label text NOT NULL);
INSERT INTO kl_parents SELECT g, 'p' || g FROM generate_series(1, 400) g;
CREATE TABLE kl_events (id int PRIMARY KEY, parent_id int NOT NULL, ts date NOT NULL, amount float8 NOT NULL) WITH (autovacuum_enabled = false);
INSERT INTO kl_events SELECT i, 1 + (i::bigint * 7919) % 400, date '2024-01-01' + i % 700, 1 + i % 17 FROM generate_series(1, 400000) i;
CREATE INDEX kl_events_parent ON kl_events (parent_id, ts);
CREATE INDEX kl_events_col ON kl_events USING sift_col (id, parent_id, ts, amount) WITH (key_order = 'parent_id');
VACUUM (FREEZE, ANALYZE) kl_events, kl_parents;
-- the granules the scan reads, against those a test no zone decides reads (all of them): the order of the key leaves the granules of the 8 keys, a few of them
CREATE FUNCTION kl_granules(q text) RETURNS int LANGUAGE plpgsql AS $$
DECLARE l text; n int;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		n := coalesce(substring(l from '^\s*Granules: scanned=(\d+)')::int, n);
	END LOOP;
	RETURN n;
END $$;
CREATE FUNCTION kl_units(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE n int := kl_granules(q); total int := kl_granules('SELECT count(*), sum(amount) FROM kl_events WHERE amount > 1');
BEGIN
	RETURN CASE WHEN n IS NULL THEN 'no scan' WHEN n * 8 <= total THEN 'a few granules' ELSE format('%s granules of %s', n, total) END;
END $$;
SET sift.agg_force = on;
SELECT kl_units($q$WITH ids AS MATERIALIZED (SELECT id FROM kl_parents WHERE id <= 8) SELECT count(*), sum(e.amount) FROM kl_events e JOIN ids ON ids.id = e.parent_id$q$) AS cte_of_ids;
   cte_of_ids   
----------------
 a few granules
(1 row)

SELECT kl_units($q$SELECT count(*), sum(amount) FROM kl_events WHERE parent_id IN (1, 2, 3, 4, 5, 6, 7, 8)$q$) AS list_of_ids;
  list_of_ids   
----------------
 a few granules
(1 row)

RESET sift.agg_force;
-- the rows are those of PostgreSQL's plan
SET sift.enable_agg = off;
CREATE TEMP TABLE kl_off AS SELECT count(*) AS n, sum(amount) AS s FROM kl_events WHERE parent_id IN (1, 2, 3, 4, 5, 6, 7, 8);
CREATE TEMP TABLE kl_off_cte AS WITH ids AS MATERIALIZED (SELECT id FROM kl_parents WHERE id <= 8) SELECT count(*) AS n, sum(e.amount) AS s FROM kl_events e JOIN ids ON ids.id = e.parent_id;
RESET sift.enable_agg;
SET sift.agg_force = on;
SELECT (SELECT count(*) FROM (SELECT count(*) AS n, sum(amount) AS s FROM kl_events WHERE parent_id IN (1, 2, 3, 4, 5, 6, 7, 8) EXCEPT TABLE kl_off) d) AS rows_unlike_normal,
       (SELECT count(*) FROM (WITH ids AS MATERIALIZED (SELECT id FROM kl_parents WHERE id <= 8) SELECT count(*) AS n, sum(e.amount) AS s FROM kl_events e JOIN ids ON ids.id = e.parent_id
                               EXCEPT TABLE kl_off_cte) d) AS cte_rows_unlike_normal;
 rows_unlike_normal | cte_rows_unlike_normal 
--------------------+------------------------
                  0 |                      0
(1 row)

RESET sift.agg_force;
DROP FUNCTION kl_units(text), kl_granules(text);
DROP TABLE kl_events, kl_parents;
DROP EXTENSION pg_sift;
