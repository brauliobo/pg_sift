-- A text key is read as dictionary codes and grouped by its strings: a near-unique key under a filter that keeps most rows hashes a string a row into a table of as
-- many groups, which costs the scan more than the integer key of the same groups (about 1.8 times in time for 100,000 rows, and the estimate prices its bytes above the
-- integer's), and the scan is still the plan taken where it is not slower than the normal plan; a key of a few values has few groups and costs what an integer key does.
-- The statements run with enable_agg on and off: the rows must be the same.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_helpers;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE items (id int PRIMARY KEY, tag text NOT NULL, cat text NOT NULL, part int NOT NULL, amount float8 NOT NULL, grp text NOT NULL, gi int NOT NULL);
SELECT setseed(0.42);
 setseed 
---------
 
(1 row)

INSERT INTO items SELECT g, md5(g::text), 'c' || (g % 17), g % 100, random() * 100, 'k' || (g % 20000), g % 20000 FROM generate_series(1, 100000) g;
CREATE INDEX items_col ON items USING sift_col (id, tag, cat, part, amount, grp, gi) WITH (rollup_columns = 'off');
VACUUM (FREEZE, ANALYZE) items;
CREATE FUNCTION scan_cost(q text) RETURNS numeric LANGUAGE sql AS $$ SELECT scan_cost::numeric FROM sift.explain_why(q) WHERE scan_cost IS NOT NULL $$;
CREATE FUNCTION scan_used(q text) RETURNS boolean LANGUAGE sql AS $$ SELECT bool_or(used) FROM sift.explain_why(q) $$;
CREATE FUNCTION differences(q text) RETURNS bigint LANGUAGE sql AS $$ SELECT sift_helpers.differences_agg(q) $$;
-- the strings of the near-unique key cost the scan over the integer key of the same groups; the 17 values of the other cost it less
SELECT key,
       scan_cost(format('SELECT %s, count(*) AS n, max(amount) AS s FROM items WHERE part < 60 GROUP BY %s', g, g)) /
       scan_cost('SELECT id, count(*) AS n, max(amount) AS s FROM items WHERE part < 60 GROUP BY id') > 1 AS strings_priced,
       differences(format('SELECT %s, count(*) AS n, max(amount) AS s FROM items WHERE part < 60 GROUP BY %s', g, g)) AS differences
FROM (VALUES ('near-unique text key', 'tag'), ('17 text values', 'cat')) v(key, g) ORDER BY key;
         key          | strings_priced | differences 
----------------------+----------------+-------------
 17 text values       | f              |           0
 near-unique text key | t              |           0
(2 rows)

-- a text key of repeated values (20,000 groups of 5 rows) costs the scan its 20,000 groups and not a group a row: about what the integer key of the same groups does
SELECT scan_cost('SELECT grp, count(*) AS n, max(amount) AS s FROM items GROUP BY grp') /
       scan_cost('SELECT gi, count(*) AS n, max(amount) AS s FROM items GROUP BY gi') < 2 AS repeats_not_priced,
       differences('SELECT grp, count(*) AS n, max(amount) AS s FROM items GROUP BY grp') AS differences;
 repeats_not_priced | differences 
--------------------+-------------
 t                  |           0
(1 row)

-- both take the scan: the near-unique key about as fast in it as in the normal plan, the 17 values far faster
SELECT key, scan_used(format('SELECT %s, count(*) AS n, max(amount) AS s FROM items WHERE part < 60 GROUP BY %s', g, g)) AS scan
FROM (VALUES ('near-unique text key', 'tag'), ('17 text values', 'cat')) v(key, g) ORDER BY key;
         key          | scan 
----------------------+------
 17 text values       | t
 near-unique text key | t
(2 rows)

DROP FUNCTION scan_cost(text), scan_used(text), differences(text);
DROP TABLE items;
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift;
