-- A text query with a phrase (memo @@> '"cable wire"') needs the text of its hits when the rows are in the write buffer of the text index, which keeps no positions: SiftAggV6 decides
-- those hits on the text of their rows in the heap, as the text index's own scan rechecks them, so that rows with the words in another order ('wire cable new') are left out, before and
-- after the rows reach a segment. So do ANDed searches and the queries a generic plan takes as parameters. Every query is run with the node and without it (sift.enable_agg) and the
-- two answers are compared in order; the first word says they agree, the second that the plan is the node's.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET sift.test_create_format1 = off;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET seq_page_cost = 10000;
SET random_page_cost = 10000;
CREATE TABLE ph (id int PRIMARY KEY, tenant_id int NOT NULL, lang text NOT NULL, memo text NOT NULL) WITH (autovacuum_enabled = false);
INSERT INTO ph SELECT i, i % 40, (ARRAY['en', 'pt', 'es'])[1 + i % 3], CASE WHEN i % 7 = 0 THEN 'cable wire stock' WHEN i % 5 = 0 THEN 'wire cable stock' ELSE 'plain parcel' END FROM generate_series(1, 3000) i;
CREATE INDEX ph_col ON ph USING sift_col (id, tenant_id, lang);
CREATE INDEX ph_memo ON ph USING sift (memo);
VACUUM (FREEZE, ANALYZE) ph;
CREATE FUNCTION answer(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY n)) FROM (SELECT row_number() OVER () AS n, x AS r FROM (' || q || ') x) r' INTO r;
	RETURN r;
END $$;
CREATE FUNCTION same(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text; plan text := ''; l text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || l; END LOOP;
	a := answer(q);
	SET LOCAL sift.enable_agg = off;
	b := answer(q);
	RETURN (CASE WHEN a IS DISTINCT FROM b THEN 'DIFFERENT' ELSE 'same' END) || ' ' || (CASE WHEN plan LIKE '%SiftAggV6%' THEN 'node' ELSE 'normal' END);
END $$;
CREATE FUNCTION check_all() RETURNS TABLE (n int, outcome text) LANGUAGE sql AS $$
	SELECT row_number() OVER ()::int, same(q) FROM unnest(ARRAY[
		'SELECT lang, count(*) AS n, sum(tenant_id) AS s FROM ph WHERE memo @@> ''"cable wire"'' GROUP BY lang ORDER BY lang',
		'SELECT id, tenant_id FROM ph WHERE memo @@> ''"cable wire"'' ORDER BY tenant_id DESC, id DESC LIMIT 10',
		'SELECT lang, count(*) FROM ph WHERE memo @@> ''cable -"wire cable"'' GROUP BY lang ORDER BY lang',
		'SELECT lang, count(*) FROM ph WHERE memo @@> ''"cable wire" OR parcel'' GROUP BY lang ORDER BY lang',
		'SELECT lang, count(*) AS n FROM ph WHERE memo @@> ''cable'' GROUP BY lang ORDER BY lang',
		'SELECT lang, count(*), sum(tenant_id) FROM ph WHERE memo @@> ''stock'' GROUP BY lang ORDER BY lang',
		'SELECT lang, count(*) FROM ph WHERE memo @@> ''"cable wire"'' AND (memo @@> ''stock'' OR memo @@> ''new'') GROUP BY lang ORDER BY lang'
	]) q $$;
SELECT * FROM check_all();
 n |  outcome  
---+-----------
 1 | same node
 2 | same node
 3 | same node
 4 | same node
 5 | same node
 6 | same node
 7 | same node
(7 rows)

INSERT INTO ph SELECT 10000 + i, i % 40, 'xx', CASE WHEN i % 2 = 0 THEN 'cable wire new' ELSE 'wire cable new' END FROM generate_series(1, 40) i;
SELECT * FROM check_all();
 n |  outcome  
---+-----------
 1 | same node
 2 | same node
 3 | same node
 4 | same node
 5 | same node
 6 | same node
 7 | same node
(7 rows)

VACUUM ph;
SELECT * FROM check_all();
 n |  outcome  
---+-----------
 1 | same node
 2 | same node
 3 | same node
 4 | same node
 5 | same node
 6 | same node
 7 | same node
(7 rows)

DELETE FROM ph WHERE id % 3 = 0;
SELECT * FROM check_all();
 n |  outcome  
---+-----------
 1 | same node
 2 | same node
 3 | same node
 4 | same node
 5 | same node
 6 | same node
 7 | same node
(7 rows)

-- the queries are parameters of a generic plan: a phrase, a term, and NULL (an arm that matches nothing)
CREATE FUNCTION same_p(args text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text; plan text := ''; l text;
BEGIN
	SET LOCAL plan_cache_mode = force_generic_plan;
	SET LOCAL sift.enable_agg = on;
	DEALLOCATE ALL;
	PREPARE p(text, text) AS SELECT lang, count(*) FROM ph WHERE memo @@> $1 OR memo @@> $2 GROUP BY lang ORDER BY lang;
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) EXECUTE p(' || args || ')' LOOP plan := plan || l; END LOOP;
	EXECUTE 'CREATE TEMP TABLE pa AS EXECUTE p(' || args || ')';
	SET LOCAL sift.enable_agg = off;
	DEALLOCATE ALL;
	PREPARE p(text, text) AS SELECT lang, count(*) FROM ph WHERE memo @@> $1 OR memo @@> $2 GROUP BY lang ORDER BY lang;
	EXECUTE 'CREATE TEMP TABLE pb AS EXECUTE p(' || args || ')';
	SELECT md5(string_agg(x::text, '|' ORDER BY x::text)) INTO a FROM pa x;
	SELECT md5(string_agg(x::text, '|' ORDER BY x::text)) INTO b FROM pb x;
	DROP TABLE pa, pb;
	DEALLOCATE ALL;
	RETURN (CASE WHEN a IS DISTINCT FROM b THEN 'DIFFERENT' ELSE 'same' END) || ' ' || (CASE WHEN plan LIKE '%SiftAggV6%' THEN 'node' ELSE 'normal' END) || ' ' || args;
END $$;
INSERT INTO ph SELECT 20000 + i, i % 40, 'yy', 'wire cable later' FROM generate_series(1, 10) i;
SELECT same_p(a) FROM unnest(ARRAY[$a$'"cable wire"', 'parcel'$a$, $a$'"cable wire"', NULL$a$, 'NULL, NULL', $a$'later', '"wire cable"'$a$]) a;
               same_p               
------------------------------------
 same node '"cable wire"', 'parcel'
 same node '"cable wire"', NULL
 same node NULL, NULL
 same node 'later', '"wire cable"'
(4 rows)

DROP FUNCTION same_p(text);
DROP TABLE ph;
DROP FUNCTION check_all();
DROP FUNCTION same(text);
DROP FUNCTION answer(text);
DROP EXTENSION pg_sift;
