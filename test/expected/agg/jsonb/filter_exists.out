-- after writes of every shape, an update that changes the shape and a delete, and after the vacuum that rewrites the segments
INSERT INTO ke SELECT 2000 + i, i % 12, ke_doc(i + 5, NULL) FROM generate_series(1, 300) i;
UPDATE ke SET attrs = ke_doc(id + 1, NULL) WHERE id % 7 = 0;
DELETE FROM ke WHERE id % 11 = 0;
SELECT 'after writes' AS stage, n, ke_check(replace(q, '@', 'ke')) AS outcome FROM shapes WHERE n <= 8 ORDER BY n;
    stage     | n |    outcome    
--------------+---+---------------
 after writes | 1 | scan same why
 after writes | 2 | scan same why
 after writes | 3 | scan same why
 after writes | 4 | scan same why
 after writes | 5 | scan same why
 after writes | 6 | scan same why
 after writes | 7 | scan same why
 after writes | 8 | scan same why
(8 rows)

VACUUM ke;
SELECT 'after vacuum' AS stage, n, ke_check(replace(q, '@', 'ke')) AS outcome FROM shapes WHERE n <= 8 ORDER BY n;
    stage     | n |    outcome    
--------------+---+---------------
 after vacuum | 1 | scan same why
 after vacuum | 2 | scan same why
 after vacuum | 3 | scan same why
 after vacuum | 4 | scan same why
 after vacuum | 5 | scan same why
 after vacuum | 6 | scan same why
 after vacuum | 7 | scan same why
 after vacuum | 8 | scan same why
(8 rows)

DROP TABLE shapes, ke, ke_text, ke_obj, ke_f1;
DROP FUNCTION ke_check(text), ke_make(text, jsonb, bool), ke_doc(int, jsonb);
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
