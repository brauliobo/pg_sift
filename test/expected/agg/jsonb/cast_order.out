-- `sum((doc ->> 'score')::float8)` beside a batch qual of another key (`doc ->> 'flag' = 'ok'`): PostgreSQL casts the score of a row the WHERE keeps only, so a text that is no number raises for
-- such a row alone. The scan of an index of format major 2 reads the value of the exception of every row its scan keys keep, and raises the error of the cast for the rows its batch quals keep
-- too: the statement runs in SiftAggV6 with PostgreSQL's rows and error. A statement whose expression decides which rows reach the cast (a CASE, a FILTER) keeps the normal plan, and so does
-- Format 1, which casts before its batch quals. Each statement runs with the scan and without it: `scan` or `plain`, then whether the rows (or the error) are the same; `why` says whether
-- sift.explain_why reports an arm the plan uses.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE EXTENSION pg_sift_helpers;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET sift.agg_force = on;
SET sift.test_create_format1 = off;
-- the score of a row of group 5 is the text `bad` (its flag is `ok` when okbad), of group 6 a container; the others hold a number, a number as a string, null or no score
CREATE FUNCTION co_make(tbl text, bad jsonb, okbad bool, f1 bool) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('sift.test_create_format1', f1::text, true);
	EXECUTE format('CREATE TABLE %I (id int, g int, doc jsonb) WITH (autovacuum_enabled = false)', tbl);
	EXECUTE format($i$INSERT INTO %I SELECT i, i %% 8, CASE WHEN i %% 29 = 0 THEN NULL ELSE jsonb_build_object('channel', 'ch_' || i %% 3,
		'flag', CASE WHEN i %% 8 = 5 THEN CASE WHEN %L THEN 'ok' ELSE 'no' END WHEN i %% 8 = 6 THEN 'skip' WHEN i %% 2 = 0 THEN 'ok' ELSE 'no' END,
		'score', CASE i %% 8 WHEN 5 THEN %L::jsonb WHEN 6 THEN '[1, 2]'::jsonb WHEN 7 THEN to_jsonb((i %% 5)::text) WHEN 3 THEN 'null'::jsonb ELSE to_jsonb((i %% 13) * 0.5) END)
		- CASE WHEN i %% 23 = 0 THEN 'score' ELSE '' END END FROM generate_series(1, 1200) i$i$, tbl, okbad, bad);
	EXECUTE format('CREATE INDEX %I ON %I USING sift_col (id, g, doc) WITH (paths = ''doc.channel text, doc.score float8, doc.flag text'')', tbl || '_col', tbl);
END $$;
SELECT co_make('co', '"bad"', false, false), co_make('co_ok', '"bad"', true, false), co_make('co_num', '4.5', true, false), co_make('co_f1', '"bad"', false, true);
 co_make | co_make | co_make | co_make 
---------+---------+---------+---------
         |         |         | 
(1 row)

VACUUM ANALYZE co, co_ok, co_num, co_f1;
SELECT sift._test_index_format('co_col') AS f2, sift._test_index_format('co_f1_col') AS f1;
 f2 | f1 
----+----
  2 |  1
(1 row)

CREATE FUNCTION co_check(q text) RETURNS text LANGUAGE sql AS $$
	SELECT sift_helpers.agg_check_outcome(q) || CASE WHEN EXISTS (SELECT 1 FROM sift.explain_why(q) WHERE used) THEN ' why' ELSE '' END
$$;
CREATE TABLE shapes (n int, label text, q text);
INSERT INTO shapes VALUES
  (1,  'sum beside a text qual',  $q$SELECT count(*), sum((doc ->> 'score')::float8) FROM @ WHERE doc ->> 'flag' = 'ok'$q$),
  (2,  'grouped',                 $q$SELECT doc ->> 'channel' AS channel, sum((doc ->> 'score')::float8), avg((doc ->> 'score')::float8) FROM @ WHERE doc ->> 'flag' = 'ok' GROUP BY 1$q$),
  (3,  'two text quals',          $q$SELECT max((doc ->> 'score')::float8) FROM @ WHERE doc ->> 'flag' = 'ok' AND doc ->> 'channel' <> 'ch_9'$q$),
  (4,  'text qual and scan key',  $q$SELECT sum((doc ->> 'score')::float8) FROM @ WHERE doc ->> 'flag' = 'ok' AND g <> 6$q$),
  (5,  'or of the flag',          $q$SELECT count(*), sum((doc ->> 'score')::float8) FROM @ WHERE doc ->> 'flag' = 'ok' OR id < 3$q$),
  (6,  'key of the read',         $q$SELECT (doc ->> 'score')::float8 AS score, count(*) FROM @ WHERE doc ->> 'flag' = 'ok' AND g IN (0, 2, 4, 5) GROUP BY 1$q$),
  (7,  'cast in the where',       $q$SELECT count(*) FROM @ WHERE (doc ->> 'score')::float8 > 2 AND doc ->> 'flag' = 'ok'$q$),
  (8,  'case guard',              $q$SELECT sum(CASE WHEN doc ->> 'flag' = 'ok' THEN (doc ->> 'score')::float8 END) FROM @ WHERE doc ->> 'channel' = 'ch_1'$q$),
  (9,  'filter guard',            $q$SELECT sum((doc ->> 'score')::float8) FILTER (WHERE g <> 5) FROM @ WHERE doc ->> 'flag' = 'ok'$q$),
  (10, 'no qual',                 $q$SELECT sum((doc ->> 'score')::float8) FROM @$q$);
SELECT tbl, n, label, co_check(replace(q, '@', tbl)) AS outcome
FROM (VALUES (1, 'co'), (2, 'co_ok'), (3, 'co_num'), (4, 'co_f1')) t(ord, tbl), shapes ORDER BY ord, n;
  tbl   | n  |         label          |                               outcome                               
--------+----+------------------------+---------------------------------------------------------------------
 co     |  1 | sum beside a text qual | scan same why
 co     |  2 | grouped                | scan same why
 co     |  3 | two text quals         | scan same why
 co     |  4 | text qual and scan key | scan same why
 co     |  5 | or of the flag         | scan same why
 co     |  6 | key of the read        | scan same why
 co     |  7 | cast in the where      | plain same
 co     |  8 | case guard             | plain same
 co     |  9 | filter guard           | plain same
 co     | 10 | no qual                | error: invalid input syntax for type double precision: "bad" why
 co_ok  |  1 | sum beside a text qual | error: invalid input syntax for type double precision: "bad" why
 co_ok  |  2 | grouped                | error: invalid input syntax for type double precision: "bad" why
 co_ok  |  3 | two text quals         | error: invalid input syntax for type double precision: "bad" why
 co_ok  |  4 | text qual and scan key | error: invalid input syntax for type double precision: "bad" why
 co_ok  |  5 | or of the flag         | error: invalid input syntax for type double precision: "bad" why
 co_ok  |  6 | key of the read        | error: invalid input syntax for type double precision: "bad" why
 co_ok  |  7 | cast in the where      | error: invalid input syntax for type double precision: "bad"
 co_ok  |  8 | case guard             | error: invalid input syntax for type double precision: "bad"
 co_ok  |  9 | filter guard           | plain same
 co_ok  | 10 | no qual                | error: invalid input syntax for type double precision: "bad" why
 co_num |  1 | sum beside a text qual | scan same why
 co_num |  2 | grouped                | scan same why
 co_num |  3 | two text quals         | scan same why
 co_num |  4 | text qual and scan key | scan same why
 co_num |  5 | or of the flag         | scan same why
 co_num |  6 | key of the read        | scan same why
 co_num |  7 | cast in the where      | plain same
 co_num |  8 | case guard             | plain same
 co_num |  9 | filter guard           | plain same
 co_num | 10 | no qual                | error: invalid input syntax for type double precision: "[1, 2]" why
 co_f1  |  1 | sum beside a text qual | plain same
 co_f1  |  2 | grouped                | plain same
 co_f1  |  3 | two text quals         | plain same
 co_f1  |  4 | text qual and scan key | plain same
 co_f1  |  5 | or of the flag         | plain same
 co_f1  |  6 | key of the read        | plain same
 co_f1  |  7 | cast in the where      | plain same
 co_f1  |  8 | case guard             | plain same
 co_f1  |  9 | filter guard           | plain same
 co_f1  | 10 | no qual                | error: invalid input syntax for type double precision: "bad" why
(40 rows)

-- after writes (a bad score whose flag is not `ok`) and after the vacuum that rewrites the segments
INSERT INTO co SELECT 5000 + i, 5, jsonb_build_object('flag', 'no', 'score', 'worse', 'channel', 'ch_1') FROM generate_series(1, 50) i;
UPDATE co SET doc = jsonb_set(doc, '{score}', '"x"') WHERE id % 17 = 0 AND doc ->> 'flag' = 'no';
SELECT 'after writes' AS stage, n, co_check(replace(q, '@', 'co')) AS outcome FROM shapes WHERE n <= 6 ORDER BY n;
    stage     | n |    outcome    
--------------+---+---------------
 after writes | 1 | scan same why
 after writes | 2 | scan same why
 after writes | 3 | scan same why
 after writes | 4 | scan same why
 after writes | 5 | scan same why
 after writes | 6 | scan same why
(6 rows)

VACUUM co;
SELECT 'after vacuum' AS stage, n, co_check(replace(q, '@', 'co')) AS outcome FROM shapes WHERE n <= 6 ORDER BY n;
    stage     | n |    outcome    
--------------+---+---------------
 after vacuum | 1 | scan same why
 after vacuum | 2 | scan same why
 after vacuum | 3 | scan same why
 after vacuum | 4 | scan same why
 after vacuum | 5 | scan same why
 after vacuum | 6 | scan same why
(6 rows)

DROP TABLE shapes, co, co_ok, co_num, co_f1;
DROP FUNCTION co_check(text), co_make(text, jsonb, bool, bool);
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
