-- after writes and after the vacuum that rewrites the segments
INSERT INTO tl SELECT 2000 + i, i % 10, tl_doc(i + 3, NULL) FROM generate_series(1, 300) i;
UPDATE tl SET doc = tl_doc(id + 1, NULL) WHERE id % 7 = 0;
DELETE FROM tl WHERE id % 11 = 0;
SELECT 'after writes' AS stage, n, tl_check(replace(q, '@', 'tl')) AS outcome FROM shapes WHERE n <= 10 ORDER BY n;
    stage     | n  |    outcome    
--------------+----+---------------
 after writes |  1 | scan same why
