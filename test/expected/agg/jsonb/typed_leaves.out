 after writes |  5 | scan same why
 after writes |  6 | scan same why
 after writes |  7 | scan same why
 after writes |  8 | scan same why
 after writes |  9 | scan same why
 after writes | 10 | scan same why
(10 rows)

VACUUM tl;
SELECT 'after vacuum' AS stage, n, tl_check(replace(q, '@', 'tl')) AS outcome FROM shapes WHERE n <= 10 ORDER BY n;
    stage     | n  |    outcome    
--------------+----+---------------
 after vacuum |  1 | scan same why
