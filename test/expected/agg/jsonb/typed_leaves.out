DROP TABLE shapes, tl, tl_text, tl_obj, tl_frac, tl_f1;
DROP FUNCTION tl_check(text), tl_make(text, jsonb, bool), tl_doc(int, jsonb);
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
