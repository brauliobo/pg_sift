-- The `->>` text and the bool cast of a key whose leaf an index of format major 2 keeps as bool: SiftAggV6 reads the booleans from the leaf, and a value of another JSON type (a string, a number,
-- a container) from the exception of its row as `->>` gives it, cast as PostgreSQL casts it, its error raised for a row the statement keeps. The integer cast of the text of an int leaf stays the
-- normal plan: the leaf keeps the number 3.0 as 3, whose text PostgreSQL's int4 refuses. Format 1 keeps the normal plan. Each statement runs with the scan and without it: `scan` or `plain`, then
-- whether the rows (or the error) are the same; `why` says whether sift.explain_why reports an arm the plan uses.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE EXTENSION pg_sift_helpers;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET sift.agg_force = on;
SET sift.test_create_format1 = off;
CREATE FUNCTION tl_doc(i int, bad jsonb) RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$
	SELECT CASE i % 10
		WHEN 0 THEN jsonb_build_object('f', i % 3 = 0, 'k', i % 50)
		WHEN 1 THEN jsonb_build_object('f', false, 'k', -(i % 7))
		WHEN 2 THEN '{"f": null, "k": null}'::jsonb
		WHEN 3 THEN jsonb_build_object('f', 'yes', 'k', 42)
		WHEN 4 THEN jsonb_build_object('f', 1, 'k', 2147483647)
		WHEN 5 THEN '["f", "k"]'::jsonb
		WHEN 6 THEN '{}'::jsonb
		WHEN 7 THEN CASE WHEN bad IS NULL THEN jsonb_build_object('f', 'off') ELSE jsonb_build_object('f', bad, 'k', bad) END
		WHEN 8 THEN jsonb_build_object('f', true, 'k', '17')
		ELSE jsonb_build_object('f', 'true', 'k', 3.5)
	END
$$;
-- the rows with a value of the bad kind are those of g = 7, a SQL NULL document is one in 31
CREATE FUNCTION tl_make(tbl text, bad jsonb, f1 bool) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('sift.test_create_format1', f1::text, true);
	EXECUTE format('CREATE TABLE %I (id int, g int, doc jsonb) WITH (autovacuum_enabled = false)', tbl);
	EXECUTE format('INSERT INTO %I SELECT i, i %% 10, CASE WHEN i %% 31 = 0 THEN NULL ELSE tl_doc(i, %L) END FROM generate_series(1, 1000) i', tbl, bad);
	EXECUTE format('CREATE INDEX %I ON %I USING sift_col (id, g, doc) WITH (paths = ''doc.f bool, doc.k int4'')', tbl || '_col', tbl);
END $$;
SELECT tl_make('tl', NULL, false), tl_make('tl_text', '"maybe"', false), tl_make('tl_obj', '{"z": 1}', false), tl_make('tl_frac', '3.0', false), tl_make('tl_f1', NULL, true);
 tl_make | tl_make | tl_make | tl_make | tl_make 
---------+---------+---------+---------+---------
         |         |         |         | 
(1 row)

VACUUM ANALYZE tl, tl_text, tl_obj, tl_frac, tl_f1;
SELECT sift._test_index_format('tl_col') AS f2, sift._test_index_format('tl_f1_col') AS f1;
 f2 | f1 
----+----
  2 |  1
(1 row)

CREATE FUNCTION tl_check(q text) RETURNS text LANGUAGE sql AS $$
	SELECT sift_helpers.agg_check_outcome(q) || CASE WHEN EXISTS (SELECT 1 FROM sift.explain_why(q) WHERE used) THEN ' why' ELSE '' END
$$;
CREATE TABLE shapes (n int, label text, q text);
INSERT INTO shapes VALUES
  (1,  'group by text',        $q$SELECT doc ->> 'f' AS f, count(*) FROM @ GROUP BY 1$q$),
  (2,  'group by bool',        $q$SELECT (doc ->> 'f')::bool AS f, count(*) FROM @ GROUP BY 1$q$),
  (3,  'where bool',           $q$SELECT count(*), sum(id) FROM @ WHERE (doc ->> 'f')::bool$q$),
  (4,  'where not bool',       $q$SELECT count(*) FROM @ WHERE NOT (doc ->> 'f')::bool$q$),
  (5,  'where text',           $q$SELECT g, count(*) FROM @ WHERE doc ->> 'f' = 'true' GROUP BY g$q$),
  (6,  'where text in',        $q$SELECT count(*) FROM @ WHERE doc ->> 'f' IN ('false', 'yes', 'off')$q$),
  (7,  'bool is null',         $q$SELECT count(*) FROM @ WHERE (doc ->> 'f')::bool IS NULL$q$),
  (8,  'count of the bool',    $q$SELECT g, count((doc ->> 'f')::bool), bool_and((doc ->> 'f')::bool), bool_or((doc ->> 'f')::bool) FROM @ GROUP BY g$q$),
  (9,  'text min max',         $q$SELECT min(doc ->> 'f'), max(doc ->> 'f'), count(DISTINCT doc ->> 'f') FROM @$q$),
  (10, 'bool beside a filter', $q$SELECT count(*) FROM @ WHERE (doc ->> 'f')::bool AND g IN (0, 3, 4)$q$),
  (11, 'jsonb group key',      $q$SELECT doc -> 'f' AS f, count(*) FROM @ GROUP BY 1$q$),
  (12, 'int cast compare',     $q$SELECT count(*) FROM @ WHERE (doc ->> 'k')::int = 42$q$),
  (13, 'int cast in',          $q$SELECT count(*) FROM @ WHERE (doc ->> 'k')::int IN (1, 42, 17)$q$),
  (14, 'int cast range',       $q$SELECT sum((doc ->> 'k')::int8) FROM @ WHERE (doc ->> 'k')::int BETWEEN 0 AND 40$q$),
  (15, 'text of an int leaf',  $q$SELECT doc ->> 'k' AS k, count(*) FROM @ GROUP BY 1$q$);
SELECT tbl, n, label, tl_check(replace(q, '@', tbl)) AS outcome
FROM (VALUES (1, 'tl'), (2, 'tl_text'), (3, 'tl_obj'), (4, 'tl_frac'), (5, 'tl_f1')) t(ord, tbl), shapes ORDER BY ord, n;
