    194 |    1043 |    41
(1 row)

-- after writes and after the vacuum that rewrites the segments
INSERT INTO cv SELECT 2000 + i, i % 5, CASE WHEN i % 13 = 0 THEN NULL ELSE cv_doc(i + 5) END FROM generate_series(1, 300) i;
UPDATE cv SET doc = cv_doc(id + 1) WHERE id % 7 = 0;
DELETE FROM cv WHERE id % 11 = 0;
