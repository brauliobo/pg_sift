SELECT count(*) FILTER (WHERE doc @> '{"k": 42, "o": {"a": 3}}') AS nested, count(*) FILTER (WHERE NOT (doc @> '{"s": "s1"}')) AS negated, count(*) FILTER (WHERE doc IS NULL) AS nulls FROM cv;
