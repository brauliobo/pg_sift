-- doc['k'] (and doc['o']['a']) is doc -> 'k' (doc -> 'o' -> 'a') for every document: both read the member of an object and give NULL for an array or a scalar. SiftAggV6 reads a subscript of
-- constant object keys as it reads the chain of ->: a comparison of a member, a group key on Format 1, a key under ->>. A key an array reads as the index of an element ('0', ' 1') or an integer
-- subscript is not one, and keeps the normal plan. Each statement runs with the scan and without it: `scan` or `plain`, then whether the rows are the same; `why`: an arm the plan uses.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE EXTENSION pg_sift_helpers;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET sift.agg_force = on;
CREATE FUNCTION ss_doc(i int) RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$
	SELECT CASE i % 8
		WHEN 0 THEN '[{"f": true, "s": "a"}, 7]'::jsonb
		WHEN 1 THEN '"f"'::jsonb
		WHEN 2 THEN '{"f": "true", "s": 1, "o": "x"}'::jsonb
		WHEN 3 THEN '{"f": null, "o": {"a": "3"}}'::jsonb
		ELSE jsonb_build_object('f', i % 3 = 0, 's', 's' || i % 4, 'o', jsonb_build_object('a', i % 5))
	END
$$;
CREATE FUNCTION ss_make(tbl text, f1 bool) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('sift.test_create_format1', f1::text, true);
	EXECUTE format('CREATE TABLE %I (id int, g int, doc jsonb) WITH (autovacuum_enabled = false)', tbl);
	EXECUTE format('INSERT INTO %I SELECT i, i %% 4, CASE WHEN i %% 19 = 0 THEN NULL ELSE ss_doc(i) END FROM generate_series(1, 1000) i', tbl);
	EXECUTE format('CREATE INDEX %I ON %I USING sift_col (id, g, doc) WITH (paths = ''doc.f bool, doc.s text, doc.o.a int4'')', tbl || '_col', tbl);
END $$;
SELECT ss_make('ss', false), ss_make('ss_f1', true);
 ss_make | ss_make 
---------+---------
         | 
(1 row)

VACUUM ANALYZE ss, ss_f1;
SELECT sift._test_index_format('ss_col') AS f2, sift._test_index_format('ss_f1_col') AS f1;
 f2 | f1 
----+----
  2 |  1
(1 row)

CREATE FUNCTION ss_check(q text) RETURNS text LANGUAGE sql AS $$
	SELECT sift_helpers.agg_check_outcome(q) || CASE WHEN EXISTS (SELECT 1 FROM sift.explain_why(q) WHERE used) THEN ' why' ELSE '' END
$$;
CREATE TABLE shapes (n int, label text, q text);
INSERT INTO shapes VALUES
  (1,  'equal',             $q$SELECT count(*) FROM $T WHERE doc['f'] = 'true'$q$),
  (2,  'equal string',      $q$SELECT g, count(*) FROM $T WHERE doc['s'] = '"s1"' GROUP BY g$q$),
  (3,  'nested equal',      $q$SELECT count(*) FROM $T WHERE doc['o']['a'] = '3'$q$),
  (4,  'nested mixed',      $q$SELECT count(*) FROM $T WHERE doc['o'] -> 'a' = '3'$q$),
  (5,  'text of a member',  $q$SELECT doc['o'] ->> 'a' AS a, count(*) FROM $T GROUP BY 1$q$),
  (6,  'group key',         $q$SELECT doc['f'] AS f, count(*) FROM $T GROUP BY 1$q$),
  (7,  'its -> form',       $q$SELECT doc -> 'f' AS f, count(*) FROM $T GROUP BY 1$q$),
  (8,  'text compare',      $q$SELECT count(*) FROM $T WHERE doc['s'] ->> 0 IS NULL$q$),
  (9,  'index key',         $q$SELECT count(*) FROM $T WHERE doc['0'] = '{"f": true, "s": "a"}'$q$),
  (10, 'spaced index key',  $q$SELECT count(*) FROM $T WHERE doc[' 1'] = '7'$q$),
  (11, 'integer subscript', $q$SELECT count(*) FROM $T WHERE doc[1] = '7'$q$);
SELECT tbl, n, label, ss_check(replace(q, '$T', tbl)) AS outcome FROM (VALUES (1, 'ss'), (2, 'ss_f1')) t(ord, tbl), shapes ORDER BY ord, n;
  tbl  | n  |       label       |    outcome    
-------+----+-------------------+---------------
 ss    |  1 | equal             | scan same why
 ss    |  2 | equal string      | scan same why
 ss    |  3 | nested equal      | scan same why
 ss    |  4 | nested mixed      | scan same why
 ss    |  5 | text of a member  | plain same
 ss    |  6 | group key         | plain same
 ss    |  7 | its -> form       | plain same
 ss    |  8 | text compare      | plain same
 ss    |  9 | index key         | plain same
 ss    | 10 | spaced index key  | plain same
 ss    | 11 | integer subscript | plain same
 ss_f1 |  1 | equal             | plain same
 ss_f1 |  2 | equal string      | plain same
 ss_f1 |  3 | nested equal      | plain same
 ss_f1 |  4 | nested mixed      | plain same
 ss_f1 |  5 | text of a member  | scan same why
 ss_f1 |  6 | group key         | scan same why
 ss_f1 |  7 | its -> form       | scan same why
 ss_f1 |  8 | text compare      | plain same
 ss_f1 |  9 | index key         | plain same
 ss_f1 | 10 | spaced index key  | plain same
 ss_f1 | 11 | integer subscript | plain same
(22 rows)

DROP TABLE shapes, ss, ss_f1;
DROP FUNCTION ss_check(text), ss_make(text, bool), ss_doc(int);
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
