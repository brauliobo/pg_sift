-- A statement past a fixed limit of SiftAggV6 (docs/LIMITS.md) keeps the normal plan with the rows of the normal plan, and sift.explain_why names a slug of the
-- registry for it: the 9 expression keys of a statement are past the 8 expressions the scan computes (SIFT_V6_MAX_DERIVE). Every slug of the registry has its
-- action and its sift.help.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET statement_timeout = '30s';
SET client_min_messages = warning;
SET enable_seqscan = off;
SET enable_indexscan = off;
SET enable_bitmapscan = off;
SET enable_indexonlyscan = off;
CREATE TABLE events (id int PRIMARY KEY, kind text, ts date);
INSERT INTO events SELECT i, 'k' || i % 5, date '2025-01-01' + i % 6 FROM generate_series(1, 12000) i;
CREATE INDEX events_col ON events USING sift_col (id, kind, ts);
VACUUM (FREEZE, ANALYZE) events;
-- 8 keys of expressions of id and 9: the scan groups by the first, the normal plan keeps the second
CREATE FUNCTION keys_q(n int) RETURNS text LANGUAGE sql AS $$
	SELECT format('SELECT %s, count(*) FROM events GROUP BY %s', string_agg(format('id %% %s', k + 1), ', '), string_agg(k::text, ', '))
	FROM generate_series(1, n) k
$$;
SELECT n, w.used, w.slug FROM unnest(ARRAY[8, 9]) n, LATERAL sift.explain_why(keys_q(n)) w ORDER BY n;
 n | used | slug 
---+------+------
 8 | t    | 
 9 | f    | key
(2 rows)

-- the rows of the scan and of the normal plan
CREATE FUNCTION answer(q text, agg bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('sift.enable_agg', agg::text, true);
	EXECUTE format('SELECT md5(string_agg(t::text, E''\n'' ORDER BY t::text)) FROM (%s) t', q) INTO r;
	RETURN r;
END $$;
SELECT n, answer(keys_q(n), true) = answer(keys_q(n), false) AS same_rows FROM unnest(ARRAY[8, 9]) n ORDER BY n;
 n | same_rows 
---+-----------
 8 | t
 9 | t
(2 rows)

-- the registry names the class of every slug and what to change: every slug has a line, and the refusal of explain_why joins to it on the slug
SELECT slug, class FROM sift.refusal_slugs() ORDER BY slug;
    slug    |  class   
------------+----------
 aggregate  | semantic
 cost       | semantic
 format     | semantic
 json_order | semantic
 jsonb      | semantic
 key        | semantic
 no_source  | semantic
 other      | semantic
 where      | semantic
(9 rows)

SELECT count(*) = count(*) FILTER (WHERE a.action <> '' AND a.action IS NOT NULL) AS every_slug_has_an_action FROM sift.refusal_slugs() LEFT JOIN sift.refusal_actions() a USING (slug);
 every_slug_has_an_action 
--------------------------
 t
(1 row)

SELECT w.slug, r.class, a.action <> '' AS has_action FROM sift.explain_why(keys_q(9)) w JOIN sift.refusal_slugs() r ON r.slug = w.slug JOIN sift.refusal_actions() a ON a.slug = w.slug;
 slug |  class   | has_action 
------+----------+------------
 key  | semantic | t
(1 row)

-- sift.help(slug) answers a refusal slug too: the reason and the action of the registry; the list of sift.help() stays the messages
SELECT count(*) = count(*) FILTER (WHERE h.message = r.reason AND h.hint = a.action AND h.kind = 'refusal') AS every_slug_has_its_help FROM sift.refusal_slugs() r JOIN sift.refusal_actions() a USING (slug), LATERAL sift.help(r.slug) h;
 every_slug_has_its_help 
-------------------------
 t
(1 row)

SELECT count(*) FILTER (WHERE kind = 'refusal') AS refusals_in_the_list FROM sift.help();
 refusals_in_the_list 
----------------------
                    0
(1 row)

SELECT kind, level, message, hint FROM sift.help('where');
  kind   | level |                              message                               |                                                                          hint                                                                          
---------+-------+--------------------------------------------------------------------+--------------------------------------------------------------------------------------------------------------------------------------------------------
 refusal |       | a condition of the WHERE or ON clause is not one the scan can test | Test a column of the index with a comparison, IN, BETWEEN, LIKE or IS NULL, or add the column or expression the condition reads to the sift_col index.
(1 row)

SELECT * FROM sift.help('no-such-slug');
ERROR:  no message, choice or refusal "no-such-slug"
HINT:  SELECT id FROM sift.help() lists the messages and choices, SELECT slug FROM sift.refusal_slugs() the refusals.
RESET client_min_messages;
DROP TABLE events;
DROP FUNCTION keys_q(int), answer(text, bool);
DROP EXTENSION pg_sift;
