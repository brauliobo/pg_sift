-- jsonb_array_elements(doc -> 'parts') AS e over a list of objects the index keeps shredded (paths `doc.parts[]{kind text, score float8}`), read by `e ->> 'k'` and `(e ->> 'k')::float8`: the members
-- are the leaves jsonb_to_recordset reads, in SiftAggV6, on both formats. A row the leaves cannot hold is taken apart by the function, and its members are read as the statement reads them.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
\ir test/common/sql/agg/base.sql
\set ECHO none
\ir test/common/sql/agg/same.sql
\set ECHO none
CREATE FUNCTION used(q text) RETURNS bool LANGUAGE sql AS $$ SELECT coalesce(bool_or(used), false) FROM sift.explain_why(q) $$;
CREATE TABLE ea (id int, kind text, doc jsonb) WITH (autovacuum_enabled = false);
INSERT INTO ea SELECT i, 'cat_' || chr(97 + i % 4),
	jsonb_build_object('parts', (SELECT jsonb_agg(jsonb_build_object('kind', 'k' || (i + j) % 3, 'score', ((i * j) % 10) / 2.0)) FROM generate_series(1, 1 + i % 3) j))
FROM generate_series(1, 6000) i;
-- the rows the leaves cannot hold, read from the heap: an element that is no object, an empty one, a member of another type, a JSON null, no list, no document
INSERT INTO ea VALUES (7001, 'cat_a', '{"parts": [5, {"kind": "k1", "score": "7"}, {}]}'), (7002, 'cat_b', '{"parts": [{"kind": 3, "score": null}]}'), (7003, 'cat_c', '{"parts": []}'),
	(7004, 'cat_d', '{}'), (7005, 'cat_a', NULL);
CREATE INDEX ea_col ON ea USING sift_col (id, kind, doc) WITH (paths = 'doc.parts[]{kind text, score float8}');
VACUUM (FREEZE, ANALYZE) ea;
-- and the rows whose members or lists raise: a score that is no number, a list that is an object
CREATE TABLE ex (LIKE ea) WITH (autovacuum_enabled = false);
INSERT INTO ex SELECT * FROM ea WHERE id <= 3000;
INSERT INTO ex VALUES (7006, 'cat_b', '{"parts": [{"kind": "k0", "score": "abc"}, {"kind": "k1", "score": 2}]}'), (7007, 'cat_c', '{"parts": {"kind": "k1"}}');
CREATE INDEX ex_col ON ex USING sift_col (id, kind, doc) WITH (paths = 'doc.parts[]{kind text, score float8}');
VACUUM (FREEZE, ANALYZE) ex;
CREATE TABLE q (n int, sql text);
INSERT INTO q VALUES
	(1, $$SELECT e ->> 'kind', count(*), avg((e ->> 'score')::float8) FROM ea t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e GROUP BY 1$$),
	(2, $$SELECT t.kind, count(*), count(e ->> 'kind'), sum((e ->> 'score')::float8) FROM ea t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e GROUP BY 1$$),
	(3, $$SELECT t.kind, count(*) FROM ea t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e WHERE e ->> 'kind' = 'k1' GROUP BY 1$$),
	(4, $$SELECT e ->> 'kind', sum((e ->> 'score')::float8) FROM ea t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e WHERE e ->> 'kind' IN ('k0', 'k2') GROUP BY 1$$),
	(5, $$SELECT t.kind, count(e ->> 'kind'), count(*) FROM ea t LEFT JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e ON true GROUP BY 1$$),
	(6, $$SELECT e ->> 'kind', min((e ->> 'score')::float8), max((e ->> 'score')::float8) FROM ea t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e WHERE e ->> 'kind' IS NOT NULL GROUP BY 1$$),
	-- the same statement over jsonb_to_recordset
	(7, $$SELECT o.kind, count(*), avg(o.score) FROM ea t CROSS JOIN LATERAL jsonb_to_recordset(t.doc -> 'parts') o(kind text, score float8) WHERE t.id <> 7001 GROUP BY 1$$),
	-- the cast raises for the elements the statement casts, and not for those its quals leave out; a list that is an object raises
	(8, $$SELECT t.kind, sum((e ->> 'score')::float8) FROM ex t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e WHERE t.id < 7007 GROUP BY 1$$),
	(9, $$SELECT t.kind, sum((e ->> 'score')::float8) FROM ex t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e WHERE e ->> 'kind' = 'k1' AND t.id < 7007 GROUP BY 1$$),
	(10, $$SELECT e ->> 'kind', count(*) FROM ex t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e GROUP BY 1$$),
	-- a cast in the argument of a FILTER is the normal plan's: the late error of its element would not be left out with the filter
	(11, $$SELECT t.kind, sum((e ->> 'score')::float8) FILTER (WHERE e ->> 'kind' = 'k1') FROM ex t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e WHERE t.id < 7007 GROUP BY 1$$),
	-- a member the index has no leaf of is the normal plan's
	(12, $$SELECT e ->> 'nope', count(*) FROM ea t CROSS JOIN LATERAL jsonb_array_elements(t.doc -> 'parts') e GROUP BY 1$$);
SELECT n, same(sql), pushed(sql) AS scan, used(sql) FROM q ORDER BY n;
 n  | same | scan | used 
----+------+------+------
  1 | same | t    | t
  2 | same | t    | t
  3 | same | t    | t
  4 | same | t    | t
  5 | same | t    | t
  6 | same | t    | t
  7 | same | t    | t
  8 | same | t    | t
  9 | same | t    | t
 10 | same | t    | t
 11 | same | f    | f
 12 | same | f    | f
(12 rows)

DROP TABLE q, ea, ex;
DROP FUNCTION used(text), runq(text, bool), same(text), pushed(text), outcome(text, bool), runs_in_scan(text);
DROP EXTENSION pg_sift;
