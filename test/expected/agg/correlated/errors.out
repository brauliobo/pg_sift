-- A lateral child runs for the rows that reach it. The scan joins one that cannot raise; one that can is joined only when nothing else is (the filters of the
-- scanned table come before it in both plans), else the normal plan stays: PostgreSQL may run the other joins first, and no statement raises only under the scan.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET default_statistics_target = 10000;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE facts (id int, dim_a_id int, code text, payload text);
INSERT INTO facts SELECT i, i % 40, CASE WHEN i % 40 = 0 THEN 'none' ELSE (i % 9)::text END, repeat('payload', 50) FROM generate_series(1, 40000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, code);
CREATE TABLE dims (id int, ok bool);
INSERT INTO dims SELECT i, i % 3 <> 0 FROM generate_series(1, 39) i;
CREATE TABLE tags (id int, dim_a_id int);
INSERT INTO tags SELECT i, i FROM generate_series(1, 39) i;
VACUUM (FREEZE, ANALYZE) facts;
ANALYZE dims;
ANALYZE tags;
CREATE FUNCTION run_query(q text, agg bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
  PERFORM set_config('sift.enable_agg', agg::text, true);
  EXECUTE 'SELECT coalesce(string_agg(t::text, E''\n'' ORDER BY t::text), '''') FROM (' || q || ') t' INTO r;
  RETURN r;
EXCEPTION WHEN OTHERS THEN RETURN 'ERROR: ' || SQLERRM;
END $$;
-- result: the rows of the normal plan or its error; same: the scan answers or fails alike; pushed: the plan the scan chose
CREATE FUNCTION check_query(q text) RETURNS TABLE (pushed bool, same bool, result text) LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
  result := run_query(q, false);
  same := result = run_query(q, true);
  pushed := false;
  PERFORM set_config('sift.enable_agg', 'on', true);
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
    pushed := pushed OR l LIKE '%Custom Scan (SiftAgg%';
  END LOOP;
  RETURN NEXT;
END $$;
-- The division by the id raises for entity 0, which the join with dims leaves out.
SELECT * FROM check_query($q$
 SELECT sum(c.n) FROM facts f CROSS JOIN LATERAL (SELECT 10 / f.dim_a_id AS n LIMIT 1) c JOIN dims d ON d.id = f.dim_a_id AND d.ok
$q$);
 pushed | same | result  
--------+------+---------
 f      | t    | (22000)
(1 row)

-- A cast of text that is no number.
SELECT * FROM check_query($q$
 SELECT sum(c.n) FROM facts f LEFT JOIN LATERAL (SELECT f.code::int AS n LIMIT 1) c ON true JOIN dims d ON d.id = f.dim_a_id AND d.ok
$q$);
 pushed | same |  result  
--------+------+----------
 f      | t    | (104007)
(1 row)

SELECT * FROM check_query($q$
 SELECT d.ok, sum(c.n) FROM facts f JOIN dims d ON d.id = f.dim_a_id
 JOIN LATERAL (SELECT f.code::int AS n UNION ALL SELECT 0) c ON true GROUP BY 1
$q$);
 pushed | same |   result   
--------+------+------------
 f      | t    | (f,51987) +
        |      | (t,104007)
(1 row)

-- Alone, a child that can raise is joined for the rows the filters of the scanned table leave: both plans raise the same error for entity 0, or none without it.
SELECT * FROM check_query($q$
 SELECT sum(c.n) FROM facts f CROSS JOIN LATERAL (SELECT 10 / f.dim_a_id AS n LIMIT 1) c
$q$);
 pushed | same |         result          
--------+------+-------------------------
 t      | t    | ERROR: division by zero
(1 row)

SELECT * FROM check_query($q$
 SELECT sum(c.n) FROM facts f CROSS JOIN LATERAL (SELECT 10 / f.dim_a_id AS n LIMIT 1) c WHERE f.dim_a_id <> 0
$q$);
 pushed | same | result  
--------+------+---------
 t      | t    | (27000)
(1 row)

SELECT * FROM check_query($q$
 SELECT sum(c.n) FROM facts f LEFT JOIN LATERAL (SELECT f.code::int AS n LIMIT 1) c ON true WHERE f.dim_a_id <> 0
$q$);
 pushed | same |  result  
--------+------+----------
 t      | t    | (155994)
(1 row)

-- A sub-select of the child may return more than one row.
SELECT * FROM check_query($q$
 SELECT sum(c.n) FROM facts f JOIN dims d ON d.id = f.dim_a_id AND d.ok
 CROSS JOIN LATERAL (SELECT (SELECT t.id FROM tags t WHERE t.dim_a_id <= f.dim_a_id) AS n LIMIT 1) c
$q$);
 pushed | same |                                result                                 
--------+------+-----------------------------------------------------------------------
 f      | t    | ERROR: more than one row returned by a subquery used as an expression
(1 row)

-- Controls: a division by a constant and a comparison cannot raise, so the scan joins the child.
SELECT * FROM check_query($q$
 SELECT c.n, count(*) FROM facts f JOIN dims d ON d.id = f.dim_a_id AND d.ok
 CROSS JOIN LATERAL (SELECT f.dim_a_id / 4 AS n WHERE f.dim_a_id <> 7 LIMIT 1) c GROUP BY 1
$q$);
 pushed | same |  result  
--------+------+----------
 t      | t    | (0,2000)+
        |      | (1,2000)+
        |      | (2,3000)+
        |      | (3,2000)+
        |      | (4,3000)+
        |      | (5,3000)+
        |      | (6,2000)+
        |      | (7,3000)+
        |      | (8,3000)+
        |      | (9,2000)
(1 row)

-- A correlated aggregate becomes a join to the table grouped by its key only when nothing of it can raise: the groups of every key are computed, where the sub-select reads only
-- the keys asked (no dims row asks for the facts of entity 0; not under check_query, whose wrapper the rewrite does not read). An xid key has an equality and no ordering: no
-- key to group by.
SET sift.agg_force = on;
SELECT d.id, (SELECT sum(10 / f.dim_a_id) FROM facts f WHERE f.dim_a_id = d.id) AS n FROM dims d;
 id |   n   
----+-------
  1 | 10000
  2 |  5000
  3 |  3000
  4 |  2000
  5 |  2000
  6 |  1000
  7 |  1000
  8 |  1000
  9 |  1000
 10 |  1000
 11 |     0
 12 |     0
 13 |     0
 14 |     0
 15 |     0
 16 |     0
 17 |     0
 18 |     0
 19 |     0
 20 |     0
 21 |     0
 22 |     0
 23 |     0
 24 |     0
 25 |     0
 26 |     0
 27 |     0
 28 |     0
 29 |     0
 30 |     0
 31 |     0
 32 |     0
 33 |     0
 34 |     0
 35 |     0
 36 |     0
 37 |     0
 38 |     0
 39 |     0
(39 rows)

CREATE TABLE xid_facts (x xid, n int);
INSERT INTO xid_facts SELECT (i % 5)::text::xid, i FROM generate_series(1, 200) i;
CREATE INDEX xid_facts_col ON xid_facts USING sift_col (x, n);
VACUUM (FREEZE, ANALYZE) xid_facts;
SELECT * FROM check_query($q$ SELECT o.n, (SELECT max(i.n) FROM xid_facts i WHERE i.x = o.x) AS m FROM xid_facts o WHERE o.n <= 5 $q$);
 pushed | same | result  
--------+------+---------
 f      | t    | (1,196)+
        |      | (2,197)+
        |      | (3,198)+
        |      | (4,199)+
        |      | (5,200)
(1 row)

RESET sift.agg_force;
-- A one-row lateral no column of which is read is dropped only when nothing of it can raise or has an effect: the normal plan runs its sub-select and its ON condition for every
-- row of the left side (entity 0 divides by zero; the sequence counts the rows that met the condition).
SELECT * FROM check_query($q$ SELECT count(*) FROM facts f LEFT JOIN LATERAL (SELECT t.id FROM tags t WHERE t.id = 1 LIMIT 1) c ON 10 / f.dim_a_id > 0 $q$);
 pushed | same |         result          
--------+------+-------------------------
 t      | t    | ERROR: division by zero
(1 row)

SELECT * FROM check_query($q$ SELECT count(*) FROM facts f LEFT JOIN LATERAL (SELECT t.id FROM tags t WHERE t.id = 10 / f.dim_a_id LIMIT 1) c ON true $q$);
 pushed | same |         result          
--------+------+-------------------------
 f      | t    | ERROR: division by zero
(1 row)

CREATE SEQUENCE joined;
SET sift.enable_agg = on;
SELECT count(*) FROM facts f LEFT JOIN LATERAL (SELECT t.id FROM tags t WHERE t.id = 1 LIMIT 1) c ON nextval('joined') > 0;
 count 
-------
 40000
(1 row)

SELECT last_value FROM joined;
 last_value 
------------
      40000
(1 row)

-- An init plan the scan runs at its start gives one row by a unique key of its table only: the parent's key does not hold across the tables that inherit it.
CREATE TABLE parents (id int PRIMARY KEY, v int);
CREATE TABLE children () INHERITS (parents);
INSERT INTO parents VALUES (1, 2);
INSERT INTO children VALUES (1, 3);
ANALYZE parents, children;
SELECT * FROM check_query($q$ SELECT count(*) FROM facts WHERE dim_a_id < 0 AND dim_a_id = (SELECT p.v FROM parents p WHERE p.id = 1) $q$);
 pushed | same |                                result                                 
--------+------+-----------------------------------------------------------------------
 f      | t    | ERROR: more than one row returned by a subquery used as an expression
(1 row)

DROP FUNCTION check_query(text);
DROP FUNCTION run_query(text, bool);
DROP SEQUENCE joined;
DROP TABLE facts, dims, tags, xid_facts, children, parents;
DROP EXTENSION pg_sift;
