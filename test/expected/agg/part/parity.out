-- An aggregate of a partitioned table is read by one SiftAggV6 node that scans the index of every partition the planner keeps into one table of groups. Every shape is run with the aggregate on
-- and off and the rows must be the same: counts, sums, averages, minimums, maximums and distinct counts, grouped by a column and by the month of a time, filtered by the partition key (some
-- partitions are pruned), by a value and by none, with a HAVING, a default partition, rows written, changed and deleted in several partitions, and a partition whose columns are in another
-- order (the table stays with PostgreSQL). The statements the node answered are counted, with the number of partitions it read for the pruned ones.
\set ON_ERROR_STOP on
SET client_min_messages = warning;
CREATE EXTENSION pg_sift;
SET sift.test_create_format1 = off;
DROP TABLE IF EXISTS pa_t, pa_x CASCADE;
CREATE TABLE pa_t (id bigint, k int NOT NULL, ts timestamp NOT NULL, v numeric(12,2) NOT NULL, kind text NOT NULL, payload text NOT NULL, PRIMARY KEY (id, ts)) PARTITION BY RANGE (ts);
CREATE TABLE pa_t_0 PARTITION OF pa_t FOR VALUES FROM ('2025-01-01') TO ('2025-02-01');
CREATE TABLE pa_t_1 PARTITION OF pa_t FOR VALUES FROM ('2025-02-01') TO ('2025-03-01');
CREATE TABLE pa_t_2 PARTITION OF pa_t FOR VALUES FROM ('2025-03-01') TO ('2025-04-01');
CREATE TABLE pa_t_3 PARTITION OF pa_t FOR VALUES FROM ('2025-04-01') TO ('2025-05-01');
CREATE TABLE pa_t_d PARTITION OF pa_t DEFAULT;
INSERT INTO pa_t SELECT g, g % 500, TIMESTAMP '2024-12-20' + g * interval '2 minutes', (g % 977) / 10.0, 'k' || (g % 6), 'p' || (g % 40) FROM generate_series(1, 90000) g;
CREATE INDEX pa_ix ON pa_t USING sift_col (id, k, ts, v, kind, payload);
VACUUM (ANALYZE) pa_t;
CREATE TEMP TABLE pa_shapes (name text, q text);
INSERT INTO pa_shapes VALUES
 ('count',      'SELECT count(*), sum(v), min(ts), max(ts) FROM pa_t'),
 ('avg',        'SELECT avg(v), avg(k), count(DISTINCT kind) FROM pa_t'),
 ('bykind',     'SELECT kind, count(*), sum(v), avg(v) FROM pa_t GROUP BY kind'),
 ('bymonth',    'SELECT date_trunc(''month'', ts) m, count(*), sum(v) FROM pa_t GROUP BY 1'),
 ('bymonth2',   'SELECT date_trunc(''month'', ts) m, kind, count(*) FROM pa_t WHERE k < 100 GROUP BY 1, 2'),
 ('pruned',     'SELECT count(*), sum(v) FROM pa_t WHERE ts >= ''2025-02-10'' AND ts < ''2025-03-10'''),
 ('pruned one', 'SELECT kind, count(*) FROM pa_t WHERE ts >= ''2025-03-05'' AND ts < ''2025-03-20'' GROUP BY kind'),
 ('filtered',   'SELECT sum(v), count(*) FROM pa_t WHERE k < 50'),
 ('point',      'SELECT count(*), sum(v) FROM pa_t WHERE k = 7'),
 ('having',     'SELECT kind, count(*) FROM pa_t GROUP BY kind HAVING count(*) > 14000'),
 ('distinct',   'SELECT count(DISTINCT k), count(DISTINCT payload) FROM pa_t');
CREATE TEMP TABLE pa_result (phase text, shape text, served int, bad int);
CREATE FUNCTION pg_temp.check_phase(phase text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE
	s record; a text; b text; plan text; served int; bad int;
BEGIN
	FOR s IN SELECT * FROM pa_shapes LOOP
		served := 0; bad := 0;
		PERFORM set_config('sift.enable_agg', 'on', true);
		EXECUTE 'SELECT coalesce(string_agg(x::text, E''\n'' ORDER BY x::text), '''') FROM (' || s.q || ') x' INTO a;
		FOR plan IN EXECUTE 'EXPLAIN (COSTS OFF) ' || s.q LOOP
			IF plan LIKE '%Custom Scan (SiftAggV6)%' THEN served := 1; END IF;
		END LOOP;
		PERFORM set_config('sift.enable_agg', 'off', true);
		EXECUTE 'SELECT coalesce(string_agg(x::text, E''\n'' ORDER BY x::text), '''') FROM (' || s.q || ') x' INTO b;
		IF a IS DISTINCT FROM b THEN bad := 1; END IF;
		INSERT INTO pa_result VALUES (phase, s.name, served, bad);
	END LOOP;
END $$;
SELECT pg_temp.check_phase('clean');
 check_phase 
-------------
 
(1 row)

INSERT INTO pa_t SELECT g, g % 500, TIMESTAMP '2025-01-15' + (g % 100) * interval '1 day', 1, 'k' || (g % 6), 'n' FROM generate_series(100001, 102000) g;
UPDATE pa_t SET v = v + 1, kind = 'k9' WHERE id % 13 = 0;
DELETE FROM pa_t WHERE id % 17 = 3;
SELECT pg_temp.check_phase('written');
 check_phase 
-------------
 
(1 row)

VACUUM pa_t;
SELECT pg_temp.check_phase('vacuumed');
 check_phase 
-------------
 
(1 row)

CREATE TABLE pa_x (payload text NOT NULL, kind text NOT NULL, v numeric(12,2) NOT NULL, ts timestamp NOT NULL, k int NOT NULL, id bigint NOT NULL);
INSERT INTO pa_x SELECT 'p', 'k0', 1, TIMESTAMP '2025-05-10', 1, g FROM generate_series(200001, 200500) g;
CREATE INDEX pa_x_ix ON pa_x USING sift_col (id, k, ts, v, kind, payload);
ALTER TABLE pa_t DETACH PARTITION pa_t_d;
ALTER TABLE pa_t ATTACH PARTITION pa_x FOR VALUES FROM ('2025-05-01') TO ('2025-06-01');
ALTER TABLE pa_t ATTACH PARTITION pa_t_d DEFAULT;
SELECT pg_temp.check_phase('other column order');
 check_phase 
-------------
 
(1 row)

SELECT shape, count(*) AS phases, sum(served) AS served, sum(bad) AS mismatches FROM pa_result GROUP BY shape ORDER BY shape;
   shape    | phases | served | mismatches 
------------+--------+--------+------------
 avg        |      4 |      4 |          0
 bykind     |      4 |      4 |          0
 bymonth    |      4 |      4 |          0
 bymonth2   |      4 |      4 |          0
 count      |      4 |      4 |          0
 distinct   |      4 |      4 |          0
 filtered   |      4 |      4 |          0
 having     |      4 |      4 |          0
 point      |      4 |      4 |          0
 pruned     |      4 |      4 |          0
 pruned one |      4 |      4 |          0
(11 rows)

SELECT phase, sum(served) AS served, sum(bad) AS mismatches FROM pa_result GROUP BY phase ORDER BY phase;
       phase        | served | mismatches 
--------------------+--------+------------
 clean              |     11 |          0
 other column order |     11 |          0
 vacuumed           |     11 |          0
 written            |     11 |          0
(4 rows)

DROP TABLE pa_t, pa_x CASCADE;
DROP EXTENSION pg_sift;
