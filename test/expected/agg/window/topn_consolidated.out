 SELECT t.id, t.grp, g.name FROM (SELECT id, grp, amount, row_number() OVER (PARTITION BY grp ORDER BY ts, id) rn FROM events WHERE amount > 2) t JOIN groups g ON g.grp = t.grp
 WHERE t.rn = 1 AND t.amount > 5 $q$);
