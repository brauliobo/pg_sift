-- rows that the plan estimated to fit and do not (the estimate is of the plan, work_mem is of the run): the rows of the partitions are put together with files
CREATE TABLE rg (dev int, ts bigint, v int) USING sift_table;
-- 60000 rows of 3000 devices: more than the 64kB of work_mem holds, so they go to files
INSERT INTO rg SELECT g % 3000, g, g FROM generate_series(1, 60000) g;
SELECT sift.table_maintain('rg') IS NOT NULL;
 ?column? 
----------
 t
(1 row)

ANALYZE rg;
CREATE FUNCTION regroup_spill() RETURNS TABLE (n bigint, diff bigint, files bigint) LANGUAGE plpgsql AS $$
DECLARE c refcursor; r record;
BEGIN
	SET LOCAL work_mem = '64MB';
	OPEN c FOR SELECT dev, ts, sum(v) OVER (PARTITION BY dev ORDER BY ts) s FROM rg;
	PERFORM set_config('work_mem', '64kB', true);
	CREATE TEMP TABLE got ON COMMIT DROP AS SELECT 0 dev, 0::bigint ts, 0::bigint s WHERE false;
	LOOP
		FETCH c INTO r;
		EXIT WHEN NOT FOUND;
		INSERT INTO got VALUES (r.dev, r.ts, r.s);
	END LOOP;
	CLOSE c;
	SET LOCAL sift.enable_agg = off;
	CREATE TEMP TABLE want ON COMMIT DROP AS SELECT dev, ts, sum(v) OVER (PARTITION BY dev ORDER BY ts) s FROM rg;
	SELECT count(*) INTO n FROM want;
	SELECT count(*) INTO diff FROM ((TABLE got EXCEPT ALL TABLE want) UNION ALL (TABLE want EXCEPT ALL TABLE got)) x;
	files := leftover();
	RETURN NEXT;
END $$;
SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT temp_bytes AS t0 FROM pg_stat_database WHERE datname = current_database() \gset
SELECT * FROM regroup_spill();
   n   | diff | files 
-------+------+-------
 60000 |    0 |     0
(1 row)

SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT temp_bytes > :t0 AS wrote_files FROM pg_stat_database WHERE datname = current_database();
 wrote_files 
-------------
 t
(1 row)

