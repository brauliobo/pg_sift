-- keys of every type, NULLs, NaNs and ties, in both directions
CREATE TABLE wt (grp int, id int, t text COLLATE "C", n6 numeric(12, 2), n12 numeric(30, 4), f float8, i8 bigint, PRIMARY KEY (grp, id)) USING sift_table;
SELECT sift.table_set_option('wt', 'key_order', 'grp, id');
 table_set_option 
------------------
 
(1 row)

INSERT INTO wt SELECT g % 2, g, CASE WHEN g % 11 = 0 THEN NULL ELSE 'k' || (g * 7 % 13) || repeat('z', g % 4 * 8) END,
	CASE WHEN g % 13 = 0 THEN NULL ELSE (g * 31 % 17) / 4.0 END, CASE WHEN g % 17 = 0 THEN NULL ELSE (g * 37 % 19) * 1000000000000000000::numeric / 8 END,
	CASE WHEN g % 19 = 0 THEN NULL WHEN g % 23 = 0 THEN 'NaN'::float8 ELSE (g * 41 % 29) / 8.0 END, CASE WHEN g % 29 = 0 THEN NULL ELSE g * 43 % 31 END
FROM generate_series(1, 20000) g;
