-- a window over the order of its table: the same, and the rows of a partition do not wait for the end of the input
SET seq_page_cost = 10000;
SET cpu_tuple_cost = 100;
SET random_page_cost = 10000;
SET enable_indexscan = off;
SET enable_indexonlyscan = off;
SET enable_bitmapscan = off;
SELECT has_node($$SELECT grp, id, sum(c1) OVER (PARTITION BY grp ORDER BY id) FROM wg$$, 'SiftAggV6Window');
 has_node 
----------
 t
(1 row)

SELECT no_temp($$SELECT * FROM (SELECT grp, id, sum(c1) OVER (PARTITION BY grp ORDER BY id) FROM wg LIMIT 10) s$$);
 no_temp 
---------
 t
(1 row)

SELECT * FROM same_rows($$SELECT grp, id, sum(c1) OVER (PARTITION BY grp ORDER BY id) FROM wg$$);
   n   | diff 
-------+------
 30000 |    0
(1 row)

-- the partitions of 10000 rows are more than the work_mem / 4 a window may hold sorted by an order the table does not have: they are sorted with files
SELECT has_node($$SELECT grp, ts, sum(c1) OVER (PARTITION BY grp ORDER BY ts) FROM wg$$, 'SiftAggV6Window');
 has_node 
----------
