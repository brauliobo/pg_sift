DO $$
BEGIN
	PERFORM p.id, 1 / (b.v - b.v) FROM hp p LEFT JOIN hb b ON b.k = p.k;
EXCEPTION WHEN division_by_zero THEN
	RAISE NOTICE 'caught, % files left', leftover();
END $$;
NOTICE:  caught, 0 files left
