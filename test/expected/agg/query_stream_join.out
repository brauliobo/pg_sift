(1 row)

SELECT * FROM same_rows($$SELECT g1, g2, g3, g4, o1, o2, o3, o4, row_number() OVER w rn, rank() OVER w rk, dense_rank() OVER w dr, sum(v1) OVER w s1, sum(v2) OVER w s2, count(v3) OVER w c3, min(v4) OVER w m4, max(v5) OVER w m5
	FROM wn WINDOW w AS (PARTITION BY g1, g2, g3, g4 ORDER BY o1, o2, o3, o4)$$);
