-- The nodes of SiftAggV6 that give their rows as they make them (a stream of groups, a window, an ASOF join) read no more of their input than the statement takes, so a LIMIT writes no temporary file;
-- a window sorts a partition larger than its slice of work_mem with files and not with an error, and with many columns at a small work_mem; a Grace hash join gives the rows of the partitions that
-- went to files as it joins them. Every statement is compared with the rows of the normal plan (sift.enable_agg = off), and no temporary file is left after a LIMIT, a closed cursor or an error.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET sift.async_maintenance = off;
SET sift.test_create_format1 = off;
SET sift.agg_force = on;
CREATE FUNCTION leftover() RETURNS bigint LANGUAGE sql AS $$ SELECT count(*) FROM pg_ls_tmpdir() $$;
-- whether the plan of the statement has the node
CREATE FUNCTION has_node(q text, node text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%' || node || '%' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
-- the rows of the statement with the node and with the normal plan: how many, and how many differ
CREATE FUNCTION same_rows(q text) RETURNS TABLE (n bigint, diff bigint) LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE 'CREATE TEMP TABLE r_on ON COMMIT DROP AS ' || q;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'CREATE TEMP TABLE r_off ON COMMIT DROP AS ' || q;
	RESET sift.enable_agg;
	SELECT count(*) INTO n FROM r_off;
	SELECT count(*) INTO diff FROM ((TABLE r_on EXCEPT ALL TABLE r_off) UNION ALL (TABLE r_off EXCEPT ALL TABLE r_on)) x;
	DROP TABLE r_on, r_off;
	RETURN NEXT;
END $$;
-- the statement runs under temp_file_limit, which stops it at the first byte of a temporary file, and leaves no file behind
CREATE FUNCTION no_temp(q text) RETURNS boolean LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('temp_file_limit', '64kB', true);
	EXECUTE q;
	PERFORM set_config('temp_file_limit', '-1', true);
	RETURN leftover() = 0;
END $$;
CREATE TABLE sg (id int PRIMARY KEY, k int, amount int, txt text) USING sift_table;
INSERT INTO sg SELECT g, g % 7, g % 1000, 'row ' || g FROM generate_series(1, 30000) g;
CREATE TABLE wg (grp int, id int, ts timestamptz, txt text COLLATE "C", c1 int, PRIMARY KEY (grp, id)) USING sift_table;
SELECT sift.table_set_option('wg', 'key_order', 'grp, id');
 table_set_option 
------------------
 
(1 row)

INSERT INTO wg SELECT 1 + g % 3, g, timestamptz '2025-01-01' + (g::bigint * 7919 % 100003) * interval '1 second', repeat(md5(g::text), 4), g % 1000 FROM generate_series(1, 30000) g;
SELECT sift.table_maintain(t) IS NOT NULL FROM unnest(ARRAY['sg', 'wg']) t;
 ?column? 
----------
 t
 t
(2 rows)

ANALYZE sg, wg;
SET work_mem = '64kB';
-- a stream of groups: a LIMIT reads a few of them and writes no file
SELECT has_node($$SELECT id, count(*), sum(amount) FROM sg GROUP BY id ORDER BY id$$, 'SiftAggV6Stream');
 has_node 
----------
 t
(1 row)

SELECT has_node($$SELECT id, count(*), sum(amount) FROM sg GROUP BY id ORDER BY id LIMIT 10$$, 'SiftAggV6Stream');
