-- a Grace hash join whose build side is more than its half of work_mem
CREATE TABLE jp (id int PRIMARY KEY, k int, v int) USING sift_table;
INSERT INTO jp SELECT g, g % 2500, g FROM generate_series(1, 20000) g;
CREATE TABLE jb (id int PRIMARY KEY, k int, v int, pad text) USING sift_table;
INSERT INTO jb SELECT g, g % 2500, g, repeat('b', 24) FROM generate_series(1, 20000) g;
-- one key with more rows than the budget (joined in chunks) and keys that have none
CREATE TABLE hp (id int PRIMARY KEY, k int, v int) USING sift_table;
INSERT INTO hp SELECT g, CASE WHEN g % 5 = 0 THEN g ELSE 1 END, g FROM generate_series(1, 20000) g;
CREATE TABLE hb (id int PRIMARY KEY, k int, v int, pad text) USING sift_table;
INSERT INTO hb SELECT g, 1, g, repeat('b', 24) FROM generate_series(1, 12000) g;
INSERT INTO hb SELECT 100000 + g, g, g, repeat('b', 24) FROM generate_series(1, 3000) g;
SELECT sift.table_maintain(t) IS NOT NULL FROM unnest(ARRAY['jp', 'jb', 'hp', 'hb']) t;
 ?column? 
----------
 t
 t
 t
 t
(4 rows)

