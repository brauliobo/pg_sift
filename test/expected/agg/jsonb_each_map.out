-- Q-04. What the scan does not take keeps the normal plan and the same answers: a test on the value, a key pattern of another form, another type than the leaf's, the value as it is,
-- a key that an equality fixes (it is no group), and the value read in two ways
SELECT same(q) FROM unnest(ARRAY[
	'SELECT kv.key, count(*) FROM em o, jsonb_each(o.metrics) kv WHERE kv.key = ''tip'' GROUP BY 1',
	'SELECT kv.key, count(*) FROM em o, jsonb_each(o.metrics) kv WHERE kv.value::float8 > 3 GROUP BY 1',
	'SELECT kv.key, count(*) FROM em o, jsonb_each(o.metrics) kv WHERE kv.key LIKE ''%a'' GROUP BY 1',
	'SELECT kv.key, count(*) FROM em o, jsonb_each(o.metrics) kv WHERE kv.key NOT LIKE ''check%'' GROUP BY 1',
	'SELECT kv.key, sum(kv.value::int4) FROM em o, jsonb_each(o.metrics) kv WHERE kv.key = ''packaging'' GROUP BY 1',
	'SELECT kv.key, count(kv.value) FROM em o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT kv.key, avg(kv.value::float8), avg((kv.value #>> ''{}'')::float8) FROM em o, jsonb_each(o.metrics) kv GROUP BY 1'
]) q;
                                                                 same                                                                 
--------------------------------------------------------------------------------------------------------------------------------------
