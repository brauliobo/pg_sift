-- Q-08. A document that is no object raises where the row reaches the function, and none of the others is read
CREATE TABLE eo (id int PRIMARY KEY, metrics jsonb) WITH (autovacuum_enabled = false);
INSERT INTO eo SELECT i, CASE i % 5 WHEN 0 THEN NULL WHEN 1 THEN '{"a": 1}' WHEN 2 THEN '{}' ELSE jsonb_build_object('a', i, 'b', 2) END FROM generate_series(1, 600) i;
CREATE INDEX eo_col ON eo USING sift_col (id, metrics) WITH (paths = 'metrics.* float8');
ANALYZE eo;
INSERT INTO eo VALUES (1001, '[1, 2]'), (1002, '"s"'), (1003, 'null'), (1004, '3');
SELECT same(q) FROM unnest(ARRAY[
	'SELECT kv.key, sum(kv.value::float8) FROM eo o, jsonb_each(o.metrics) kv WHERE o.id < 1001 GROUP BY 1',
	'SELECT kv.key, sum(kv.value::float8) FROM eo o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT kv.key, sum(kv.value::float8) FROM eo o, jsonb_each(o.metrics) kv WHERE o.id IN (1001, 1002, 1003, 1004) GROUP BY 1',
	'SELECT m.key, count(*) FROM eo o, jsonb_each_text(o.metrics) m WHERE o.id = 1003 GROUP BY 1',
	'SELECT m.key, count(*) FROM eo o LEFT JOIN LATERAL jsonb_each_text(o.metrics) m ON true WHERE o.id < 100 GROUP BY 1'
]) q;
                                                                                          same                                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same node ok SELECT kv.key, sum(kv.value::float8) FROM eo o, jsonb_each(o.metrics) kv WHERE o.id < 1001 GROUP BY 1
 same node error 22023 cannot call jsonb_each on a non-object SELECT kv.key, sum(kv.value::float8) FROM eo o, jsonb_each(o.metrics) kv GROUP BY 1
 same node error 22023 cannot call jsonb_each on a non-object SELECT kv.key, sum(kv.value::float8) FROM eo o, jsonb_each(o.metrics) kv WHERE o.id IN (1001, 1002, 1003, 1004) GROUP BY 1
 same node error 22023 cannot call jsonb_each_text on a non-object SELECT m.key, count(*) FROM eo o, jsonb_each_text(o.metrics) m WHERE o.id = 1003 GROUP BY 1
 same node ok SELECT m.key, count(*) FROM eo o LEFT JOIN LATERAL jsonb_each_text(o.metrics) m ON true WHERE o.id < 100 GROUP BY 1
(5 rows)

-- Q-09. Rows that change: an update, a delete, and a row the index has not seen (the index is read with the table)
UPDATE em SET metrics = jsonb_build_object('m_total', 100, 'tip', 2) WHERE id % 50 = 3;
DELETE FROM em WHERE id % 60 = 4;
INSERT INTO em SELECT 3000 + i, i % 7, jsonb_build_object('m_total', i, 'packaging', i % 3, 'check_a', 1) FROM generate_series(1, 200) i;
SELECT same(q) FROM unnest(ARRAY[
	'SELECT kv.key, count(*), avg(kv.value::float8) FROM em o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT m.key, count(*), sum(m.value::float8) FROM em o, jsonb_each_text(o.metrics) m WHERE m.key IN (''m_total'', ''packaging'') OR m.key LIKE ''check%'' GROUP BY 1'
]) q;
                                                                                    same                                                                                     
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same node ok SELECT kv.key, count(*), avg(kv.value::float8) FROM em o, jsonb_each(o.metrics) kv GROUP BY 1
 same node ok SELECT m.key, count(*), sum(m.value::float8) FROM em o, jsonb_each_text(o.metrics) m WHERE m.key IN ('m_total', 'packaging') OR m.key LIKE 'check%' GROUP BY 1
(2 rows)

-- Q-10. A dimension joined on the key of the member, inner and left
CREATE TABLE dk (k text, grp text) WITH (autovacuum_enabled = false);
INSERT INTO dk VALUES ('m_total', 'a'), ('tip', 'b'), ('packaging', 'a'), ('absent', 'c');
ANALYZE dk;
SELECT same(q) FROM unnest(ARRAY[
	'SELECT d.grp, count(*), sum(kv.value::float8) FROM em o CROSS JOIN LATERAL jsonb_each(o.metrics) kv JOIN dk d ON d.k = kv.key GROUP BY 1',
	'SELECT d.grp, count(*), count(kv.key) FROM em o CROSS JOIN LATERAL jsonb_each(o.metrics) kv LEFT JOIN dk d ON d.k = kv.key GROUP BY 1',
	'SELECT d.grp, sum(m.value::float8) FROM em o CROSS JOIN LATERAL jsonb_each_text(o.metrics) m JOIN dk d ON d.k = m.key WHERE o.g < 4 GROUP BY 1'
]) q;
