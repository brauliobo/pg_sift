-- Q-06. A JSON null value: its text is NULL and so is its cast to a number
CREATE TABLE en (id int PRIMARY KEY, metrics jsonb) WITH (autovacuum_enabled = false);
INSERT INTO en SELECT i, CASE WHEN i % 7 = 0 THEN NULL WHEN i % 5 = 0 THEN jsonb_build_object('a', i, 'tip', NULL) ELSE jsonb_build_object('a', i, 'tip', i % 3) END FROM generate_series(1, 600) i;
CREATE INDEX en_col ON en USING sift_col (id, metrics) WITH (paths = 'metrics.* float8');
ANALYZE en;
SELECT same(q) FROM unnest(ARRAY[
	'SELECT kv.key, count((kv.value #>> ''{}'')::float8), avg((kv.value #>> ''{}'')::float8) FROM en o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT m.key, count(m.value::float8), sum(m.value::float8) FROM en o, jsonb_each_text(o.metrics) m GROUP BY 1',
	'SELECT kv.key, avg(kv.value::float8) FROM en o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT kv.key, avg(kv.value::float8) FROM en o, jsonb_each(o.metrics) kv WHERE o.id > 100 GROUP BY 1',
	'SELECT kv.key, avg(kv.value::float8) FROM en o, jsonb_each(o.metrics) kv WHERE kv.key IN (''a'', ''tip'') GROUP BY 1',
	'SELECT kv.key, count(*) FILTER (WHERE kv.value::float8 > 1) FROM en o, jsonb_each(o.metrics) kv GROUP BY 1'
]) q;
                                                                      same                                                                       
-------------------------------------------------------------------------------------------------------------------------------------------------
 same node ok SELECT kv.key, count((kv.value #>> '{}')::float8), avg((kv.value #>> '{}')::float8) FROM en o, jsonb_each(o.metrics) kv GROUP BY 1
 same node ok SELECT m.key, count(m.value::float8), sum(m.value::float8) FROM en o, jsonb_each_text(o.metrics) m GROUP BY 1
 same node ok SELECT kv.key, avg(kv.value::float8) FROM en o, jsonb_each(o.metrics) kv GROUP BY 1
 same node ok SELECT kv.key, avg(kv.value::float8) FROM en o, jsonb_each(o.metrics) kv WHERE o.id > 100 GROUP BY 1
 same node ok SELECT kv.key, avg(kv.value::float8) FROM en o, jsonb_each(o.metrics) kv WHERE kv.key IN ('a', 'tip') GROUP BY 1
 same node ok SELECT kv.key, count(*) FILTER (WHERE kv.value::float8 > 1) FROM en o, jsonb_each(o.metrics) kv GROUP BY 1
(6 rows)

-- Q-07. A value the leaf cannot hold: a numeric string, a boolean and an object are read again from the table as PostgreSQL reads them, and so are their errors
CREATE TABLE ed (id int PRIMARY KEY, metrics jsonb) WITH (autovacuum_enabled = false);
INSERT INTO ed SELECT i, CASE i % 6 WHEN 0 THEN '{"a": "5", "b": 1}' WHEN 1 THEN '{"a": 2.5, "b": "7.5"}' WHEN 2 THEN '{"a": 1}' WHEN 3 THEN NULL ELSE jsonb_build_object('a', i, 'b', i % 4) END FROM generate_series(1, 600) i;
CREATE INDEX ed_col ON ed USING sift_col (id, metrics) WITH (paths = 'metrics.* float8');
ANALYZE ed;
SELECT same(q) FROM unnest(ARRAY[
	'SELECT kv.key, count(*), sum((kv.value #>> ''{}'')::float8) FROM ed o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT m.key, count(*), sum(m.value::float8) FROM ed o, jsonb_each_text(o.metrics) m GROUP BY 1',
	'SELECT m.key, count(*), sum(m.value::float8) FROM ed o, jsonb_each_text(o.metrics) m WHERE m.key IN (''b'', ''c'') GROUP BY 1',
	'SELECT kv.key, sum(kv.value::float8) FROM ed o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT kv.key, sum(kv.value::float8) FROM ed o, jsonb_each(o.metrics) kv WHERE o.id IN (2, 4, 5, 8, 10, 11) GROUP BY 1',
	'SELECT kv.key, sum(kv.value::float8) FROM ed o, jsonb_each(o.metrics) kv WHERE kv.key IN (''b'', ''c'') AND o.id <> 1 GROUP BY 1'
]) q;
                                                                                                 same                                                                                                 
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same node ok SELECT kv.key, count(*), sum((kv.value #>> '{}')::float8) FROM ed o, jsonb_each(o.metrics) kv GROUP BY 1
 same node ok SELECT m.key, count(*), sum(m.value::float8) FROM ed o, jsonb_each_text(o.metrics) m GROUP BY 1
 same node ok SELECT m.key, count(*), sum(m.value::float8) FROM ed o, jsonb_each_text(o.metrics) m WHERE m.key IN ('b', 'c') GROUP BY 1
 same node error 22023 cannot cast jsonb string to type double precision SELECT kv.key, sum(kv.value::float8) FROM ed o, jsonb_each(o.metrics) kv GROUP BY 1
 same node ok SELECT kv.key, sum(kv.value::float8) FROM ed o, jsonb_each(o.metrics) kv WHERE o.id IN (2, 4, 5, 8, 10, 11) GROUP BY 1
 same node error 22023 cannot cast jsonb string to type double precision SELECT kv.key, sum(kv.value::float8) FROM ed o, jsonb_each(o.metrics) kv WHERE kv.key IN ('b', 'c') AND o.id <> 1 GROUP BY 1
(6 rows)

INSERT INTO ed VALUES (1001, '{"a": true, "b": {"x": 1}}'), (1002, '{"a": "text"}');
SELECT same(q) FROM unnest(ARRAY[
	'SELECT kv.key, sum((kv.value #>> ''{}'')::float8) FROM ed o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT kv.key, count(*) FROM ed o, jsonb_each(o.metrics) kv GROUP BY 1',
	'SELECT kv.key, sum((kv.value #>> ''{}'')::float8) FROM ed o, jsonb_each(o.metrics) kv WHERE o.id < 1001 GROUP BY 1',
	'SELECT kv.key, sum(kv.value::float8) FROM ed o, jsonb_each(o.metrics) kv WHERE o.id IN (1001, 1002) GROUP BY 1',
	'SELECT m.key, sum(m.value::float8) FROM ed o, jsonb_each_text(o.metrics) m WHERE o.id = 1001 AND m.key IN (''b'', ''c'') GROUP BY 1'
]) q;
                                                                                                       same                                                                                                       
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
