-- The rows an outer join preserves from a dimension, on a Format 2.0 table and on a Format 1 table with sift.test_unified_agg = on: the dimension rows no fact row matches are given once,
-- when the scan of the fact table ends, however many chunks of the fact table it reads. Every statement runs on the node and with sift.enable_agg = off, and the rows must be the same.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET sift.agg_force = on;
SET seq_page_cost = 10000;
SET random_page_cost = 10000;
CREATE TABLE ev_f2 (id int PRIMARY KEY, kind text, skew int, qty int) WITH (autovacuum_enabled = false);
CREATE TABLE ev_f1 (LIKE ev_f2 INCLUDING ALL) WITH (autovacuum_enabled = false);
CREATE TABLE ev_f2_empty (LIKE ev_f2 INCLUDING ALL) WITH (autovacuum_enabled = false);
CREATE TABLE ev_f1_empty (LIKE ev_f2 INCLUDING ALL) WITH (autovacuum_enabled = false);
INSERT INTO ev_f2
SELECT i, CASE WHEN i % 19 = 0 THEN NULL ELSE 'cat_' || chr(97 + i % 4) END, CASE WHEN i % 23 = 0 THEN NULL ELSE 1 + i % 8 END, i % 11
FROM generate_series(1, 60000) i;
INSERT INTO ev_f1 SELECT * FROM ev_f2;
SET sift.test_create_format1 = off;
CREATE INDEX ev_f2_col ON ev_f2 USING sift_col (id, kind, skew, qty);
CREATE INDEX ev_f2_empty_col ON ev_f2_empty USING sift_col (id, kind, skew, qty);
SET sift.test_create_format1 = on;
CREATE INDEX ev_f1_col ON ev_f1 USING sift_col (id, kind, skew, qty);
CREATE INDEX ev_f1_empty_col ON ev_f1_empty USING sift_col (id, kind, skew, qty);
VACUUM (FREEZE, ANALYZE) ev_f2;
VACUUM (FREEZE, ANALYZE) ev_f1;
CREATE TABLE dim (tag text, k int, name text);
INSERT INTO dim VALUES ('a', 1, 'cat_a'), ('b', 2, 'cat_b'), ('c', 3, 'cat_c'), ('c2', 3, 'cat_d'), ('d', 8, 'cat_z'), ('e', 9, NULL), ('f', 12, 'cat_a'),
                       ('g', 100, 'none'), ('h', NULL, 'cat_b'), ('i', NULL, NULL);
CREATE TABLE dim2 (tag text, k int);
INSERT INTO dim2 VALUES ('x', 0), ('y', 5), ('z', 10), ('w', 77), ('v', NULL);
ANALYZE dim;
ANALYZE dim2;
CREATE FUNCTION same(q text) RETURNS TABLE (engine text, result_rows bigint, vs_heap bigint) LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	engine := 'normal';
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%Custom Scan (SiftAggV6)%' THEN engine := 'SiftAggV6'; END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS SELECT x::text AS r FROM (%s) x', q);
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS SELECT x::text AS r FROM (%s) x', q);
	RESET sift.enable_agg;
	result_rows := (SELECT count(*) FROM r_on);
	vs_heap := (SELECT count(*) FROM ((TABLE r_on EXCEPT ALL TABLE r_off) UNION ALL (TABLE r_off EXCEPT ALL TABLE r_on)) x);
	DROP TABLE r_on, r_off;
	RETURN NEXT;
END $$;
CREATE TABLE stmts (id int, q text);
INSERT INTO stmts VALUES
(1, 'SELECT d.tag, count(e.id) AS n, sum(e.qty) AS q FROM dim d LEFT JOIN @ e ON e.skew = d.k GROUP BY 1'),
(2, 'SELECT d.tag, count(e.id) AS n, sum(e.qty) AS q FROM @ e RIGHT JOIN dim d ON e.skew = d.k GROUP BY 1'),
(3, 'SELECT d.tag, e.kind, count(e.id) AS n FROM @ e FULL JOIN dim d ON e.skew = d.k GROUP BY 1, 2'),
(4, 'SELECT d.tag, count(*) AS n FROM @ e JOIN dim d ON e.skew = d.k GROUP BY 1'),
(5, 'SELECT d.tag, count(e.id) AS n FROM dim d LEFT JOIN @ e ON e.skew = d.k AND e.qty > 100 GROUP BY 1'),
(6, 'SELECT count(*) AS n, count(e.id) AS m FROM dim d LEFT JOIN @ e ON e.skew = d.k'),
(7, 'SELECT d.tag, count(e.id) AS n FROM dim d LEFT JOIN @ e ON e.kind = d.name GROUP BY 1'),
(8, 'SELECT d.tag, e.kind, count(e.id) AS n FROM dim d LEFT JOIN @ e ON e.skew = d.k AND e.kind = d.name GROUP BY 1, 2'),
(9, 'SELECT a.tag, b.tag AS t2, count(e.id) AS n FROM dim a CROSS JOIN dim2 b LEFT JOIN @ e ON e.skew = a.k AND e.qty = b.k GROUP BY 1, 2'),
(10, 'SELECT k.kind, s.tag, count(e.id) AS n FROM (SELECT DISTINCT kind FROM @) k CROSS JOIN dim2 s FULL JOIN @ e ON e.kind = k.kind AND e.qty = s.k GROUP BY 1, 2'),
(11, 'SELECT k.kind, s.tag, count(e.id) AS n FROM (SELECT DISTINCT kind FROM @) k CROSS JOIN dim2 s RIGHT JOIN @ e ON e.kind = k.kind AND e.qty = s.k GROUP BY 1, 2'),
(12, 'SELECT k.kind, s.tag, count(e.id) AS n FROM (SELECT DISTINCT kind FROM @) k CROSS JOIN dim2 s LEFT JOIN @ e ON e.kind = k.kind AND e.qty = s.k GROUP BY 1, 2'),
(13, 'SELECT a.tag, b.tag AS t2, count(e.id) AS n FROM @ e RIGHT JOIN dim a ON e.skew = a.k JOIN dim2 b ON e.qty = b.k GROUP BY 1, 2'),
(14, 'SELECT e.kind, count(*) AS n FROM @ e WHERE NOT EXISTS (SELECT 1 FROM dim d WHERE d.k = e.skew) GROUP BY 1');
SELECT 'f2' AS fmt, id, (same(replace(q, '@', 'ev_f2'))).* FROM stmts ORDER BY id;
