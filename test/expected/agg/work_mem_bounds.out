-- What SiftAggV6 holds at once stays within work_mem (the plans are made at a larger one): a dimension of a left, full or anti star join that one key makes too large to split
-- is read in chunks of rows and a last pass of its distinct keys, and the rows the heap of an ORDER BY .. LIMIT of the groups copies move to a sort that writes to disk. A star join
-- whose condition runs on the pairs, which no keys answer, fails naming work_mem.
SET client_min_messages = warning;
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET sift.agg_force = on;
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, counter_a int, label text) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT g, g % 4, g % 10, repeat(chr(97 + g % 26), 2000) FROM generate_series(1, 4000) g;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, counter_a, label) WITH (key_order = id);
-- 3000 rows of key 1: no number of parts splits them
CREATE TABLE dim_a (id int, label_a text);
INSERT INTO dim_a SELECT CASE WHEN g <= 3000 THEN 1 ELSE g END, 'label_' || g % 7 FROM generate_series(1, 3100) g;
ANALYZE facts;
ANALYZE dim_a;
RESET client_min_messages;
SET plan_cache_mode = force_generic_plan;
PREPARE left_star AS SELECT d.label_a, count(*) FROM facts f LEFT JOIN dim_a d ON d.id = f.dim_a_id GROUP BY d.label_a ORDER BY 1;
PREPARE full_star AS SELECT d.label_a, count(f.id), count(d.id) FROM facts f FULL JOIN dim_a d ON d.id = f.dim_a_id GROUP BY d.label_a ORDER BY 1;
PREPARE anti_star AS SELECT f.counter_a, count(*) FROM facts f WHERE NOT EXISTS (SELECT 1 FROM dim_a d WHERE d.id = f.dim_a_id) GROUP BY 1 ORDER BY 1;
PREPARE left_pairs AS SELECT d.label_a, count(*) FROM facts f LEFT JOIN dim_a d ON d.id = f.dim_a_id AND d.id + f.counter_a > 3 GROUP BY d.label_a ORDER BY 1;
EXPLAIN (COSTS OFF) EXECUTE left_star;
             QUERY PLAN              
-------------------------------------
 Sort
   Sort Key: d.label_a
   ->  Custom Scan (SiftAggV6)
         Index: facts_col
         Pushed Aggregates: count(*)
         Star Dimensions: 1
         Lookup Joins: dim_a (left)
         ->  Seq Scan on dim_a d
(8 rows)

EXPLAIN (COSTS OFF) EXECUTE full_star;
                    QUERY PLAN                     
---------------------------------------------------
 Sort
   Sort Key: d.label_a
   ->  Custom Scan (SiftAggV6)
         Index: facts_col
         Pushed Aggregates: count(id), count(d.id)
         Star Dimensions: 1
         Lookup Joins: dim_a (full)
         ->  Seq Scan on dim_a d
(8 rows)

EXPLAIN (COSTS OFF) EXECUTE anti_star;
             QUERY PLAN              
-------------------------------------
 Sort
   Sort Key: counter_a
   ->  Custom Scan (SiftAggV6)
         Index: facts_col
         Group Keys: counter_a
         Pushed Aggregates: count(*)
         Star Dimensions: 1
         Lookup Joins: dim_a (anti)
         ->  Seq Scan on dim_a d
(9 rows)

EXPLAIN (COSTS OFF) EXECUTE left_pairs;
             QUERY PLAN              
-------------------------------------
 Sort
   Sort Key: d.label_a
   ->  Custom Scan (SiftAggV6)
         Index: facts_col
         Pushed Aggregates: count(*)
         Star Dimensions: 1
         Lookup Joins: dim_a (left)
         ->  Seq Scan on dim_a d
(8 rows)

EXECUTE left_star;
 label_a | count  
---------+--------
 label_0 | 428000
 label_1 | 429000
 label_2 | 429000
 label_3 | 429000
 label_4 | 429000
 label_5 | 428000
 label_6 | 428000
         |   3000
(8 rows)

EXECUTE full_star;
 label_a | count  | count  
---------+--------+--------
 label_0 | 428000 | 428014
 label_1 | 429000 | 429014
 label_2 | 429000 | 429014
 label_3 | 429000 | 429014
 label_4 | 429000 | 429014
 label_5 | 428000 | 428015
 label_6 | 428000 | 428015
         |   3000 |      0
(8 rows)

EXECUTE anti_star;
 counter_a | count 
-----------+-------
         0 |   400
         1 |   200
         2 |   400
         3 |   200
         4 |   400
         5 |   200
         6 |   400
         7 |   200
         8 |   400
         9 |   200
(10 rows)

SET work_mem = '64kB';
EXECUTE left_star;
 label_a | count  
---------+--------
 label_0 | 428000
 label_1 | 429000
 label_2 | 429000
 label_3 | 429000
 label_4 | 429000
 label_5 | 428000
 label_6 | 428000
         |   3000
(8 rows)

EXECUTE full_star;
 label_a | count  | count  
---------+--------+--------
 label_0 | 428000 | 428014
 label_1 | 429000 | 429014
 label_2 | 429000 | 429014
 label_3 | 429000 | 429014
 label_4 | 429000 | 429014
 label_5 | 428000 | 428015
 label_6 | 428000 | 428015
         |   3000 |      0
(8 rows)

EXECUTE anti_star;
 counter_a | count 
-----------+-------
         0 |   400
         1 |   200
         2 |   400
         3 |   200
         4 |   400
         5 |   200
         6 |   400
         7 |   200
         8 |   400
         9 |   200
(10 rows)

\set VERBOSITY terse
EXECUTE left_pairs;
ERROR:  a dimension of a star join does not fit work_mem and no chunks of it answer the join
\set VERBOSITY default
RESET work_mem;
DEALLOCATE left_star;
DEALLOCATE full_star;
DEALLOCATE anti_star;
DEALLOCATE left_pairs;
RESET plan_cache_mode;
-- 200 groups of a 2000-byte label: their copies are 400 kB, which pass a work_mem of 256kB and go to the sort
EXPLAIN (COSTS OFF) SELECT id % 1000 AS k, max(label) FROM facts GROUP BY 1 ORDER BY 1 LIMIT 200;
                 QUERY PLAN                  
---------------------------------------------
 Limit
   ->  Custom Scan (SiftAggV6)
         Index: facts_col
         Group Keys: id: (facts.id % 1000)
         Pushed Aggregates: max(facts.label)
(5 rows)

SELECT count(*), sum(length(m)) FROM (SELECT id % 1000 AS k, max(label) AS m FROM facts GROUP BY 1 ORDER BY 1 LIMIT 200) t;
 count |  sum   
-------+--------
   200 | 400000
(1 row)

SET work_mem = '256kB';
SELECT count(*), sum(length(m)) FROM (SELECT id % 1000 AS k, max(label) AS m FROM facts GROUP BY 1 ORDER BY 1 LIMIT 200) t;
 count |  sum   
-------+--------
   200 | 400000
(1 row)

SELECT count(*), sum(length(m)) FROM (SELECT id % 1000 AS k, max(label) AS m FROM facts GROUP BY 1 ORDER BY 1 LIMIT 20) t;
 count |  sum  
-------+-------
    20 | 40000
(1 row)

RESET work_mem;
DROP TABLE facts, dim_a;
DROP EXTENSION pg_sift;
