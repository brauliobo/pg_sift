 same node18 error 22023 cannot cast jsonb string to type integer SELECT (attributes -> 'score')::int, count(*) FROM ms GROUP BY 1
 same node18 ok SELECT (attributes -> 'score')::float8, count(*) FROM ms WHERE k IN (0, 1, 2, 4, 5, 7, 9, 10, 11, 100) GROUP BY 1
 same node18 ok SELECT g, sum((attributes['score'])::bigint), avg((attributes -> 'score')::int) FROM ms WHERE k IN (0, 1, 2, 4, 5, 7, 9, 10, 11, 100) GROUP BY 1
