	('SELECT count(*) FROM mk WHERE (metrics -> ''quality'')::int >= 5 AND (metrics -> ''big'')::int > 0', 'node18'),
	('SELECT count(*) FROM mk WHERE (metrics -> ''big'')::int > 0 AND (metrics -> ''quality'')::int >= 5', 'node18')
) t(q, w);
