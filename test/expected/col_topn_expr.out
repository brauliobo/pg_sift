-- the expressions that stay with the normal plan, each by a named refusal: CASE (a later step), do not give one column's value (coalesce of two columns, a
-- concatenation, a function of a function) or are not of the types above (a bigint constant for an integer column). Arithmetic and casts are col_topn_arith.
SET sift.enable_agg = on;
SET enable_seqscan = off; SET enable_indexscan = off; SET enable_bitmapscan = off;
SELECT k, w.used, w.slug, substr(w.reason, 1, 400) AS reason
FROM (VALUES ('case',          $q$SELECT id, a FROM tc ORDER BY CASE WHEN a IS NULL THEN 0 ELSE a END, id LIMIT 5$q$),
			 ('two columns',   $q$SELECT id, a FROM tc ORDER BY coalesce(a, g), id LIMIT 5$q$),
			 ('wide constant', $q$SELECT id, a FROM tc ORDER BY coalesce(a, 5000000000), id LIMIT 5$q$),
			 ('concatenation', $q$SELECT id, s FROM tc ORDER BY lower(s || v), id LIMIT 5$q$),
			 ('nested',        $q$SELECT id, s FROM tc ORDER BY lower(upper(s)), id LIMIT 5$q$),
			 ('length',        $q$SELECT id, s FROM tc ORDER BY length(s), id LIMIT 5$q$),
			 ('allowed',       $q$SELECT id, a FROM tc ORDER BY coalesce(a, 5), id LIMIT 5$q$)) q(k, q),
	 LATERAL sift.explain_why(q.q) w
ORDER BY k COLLATE "C";
       k       | used |    slug    |                                                                                    reason                                                                                     
---------------+------+------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 allowed       | t    |            | 
 case          | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression has a construct the scan does not evaluate)
 concatenation | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression calls a function or operator whose result is not a number)
 length        | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression calls a function or operator on strings)
 nested        | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression calls a function or operator whose result is not a number)
 two columns   | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression has a construct the scan does not evaluate)
 wide constant | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression has a construct the scan does not evaluate)
(7 rows)

RESET enable_seqscan; RESET enable_indexscan; RESET enable_bitmapscan;
-- overflow strings (the byte budget of a unit lowered to 64 kB for 3000 rows of 200 bytes): the plan that would read the key leaves the query to the normal plan
CREATE TABLE tv (id int PRIMARY KEY, w text);
INSERT INTO tv SELECT i, repeat(md5(i::text), 6) || i FROM generate_series(1, 3000) i;
SET sift.test_limits = 'unit_bytes=65536';
CREATE INDEX tv_col ON tv USING sift_col (id, w);
NOTICE:  sift_col: the strings of leaf 1 (attribute 2) in superblock 0 pass 65536 bytes: the values after them are stored as overflow and read from the heap
HINT:  Index an expression that keeps the part of the value that is used, such as left(column, 255).
RESET sift.test_limits;
ANALYZE tv;
SELECT tc_check($q$SELECT id, w FROM tv ORDER BY upper(w) DESC, id LIMIT 10$q$) AS overflow_key;
 overflow_key 
--------------
 same 10
(1 row)

-- the sorted run of a column (order_columns) orders the column, not coalesce(column, constant), which moves the NULLs among the values: the scan reads the units
-- of the expression row by row, where the plain column goes through the run
CREATE TABLE tq (id int, kn int, pad text) WITH (autovacuum_enabled = off);
ALTER TABLE tq ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO tq SELECT g, CASE WHEN g % 7 = 0 THEN NULL ELSE (hashint4(g + 1) & 2147483647) % 40 END, repeat('x', 1500) FROM generate_series(1, 12000) g;
CREATE INDEX tq_col ON tq USING sift_col (id, kn) WITH (order_columns = 'kn', cube_minmax = false, superunit = 0);
ANALYZE tq;
CREATE FUNCTION tq_runs(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE line text;
BEGIN
	PERFORM tc_mode(true, 0);
	PERFORM set_config('seq_page_cost', '1000', true);
	PERFORM set_config('random_page_cost', '1000', true);
	FOR line IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF) ' || q LOOP
		IF line ~ 'Units Read By Sorted Run' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
SELECT tq_runs($q$SELECT id, kn FROM tq ORDER BY kn, id LIMIT 30$q$) AS column_by_run,
	   tq_runs($q$SELECT id, kn FROM tq ORDER BY coalesce(kn, 20), id LIMIT 30$q$) AS coalesce_by_run;
 column_by_run | coalesce_by_run 
---------------+-----------------
 t             | f
(1 row)

SELECT tc_check($q$SELECT id, kn FROM tq ORDER BY coalesce(kn, 20), id LIMIT 30$q$) AS coalesce_asc,
	   tc_check($q$SELECT id, kn FROM tq ORDER BY coalesce(kn, 20) DESC, id LIMIT 30 OFFSET 100$q$) AS coalesce_desc,
	   tc_check($q$SELECT id, kn FROM tq ORDER BY coalesce(kn, -1), id LIMIT 30$q$) AS coalesce_below,
	   tc_check($q$SELECT id, kn FROM tq ORDER BY coalesce(kn, 100), id DESC LIMIT 30$q$) AS coalesce_above;
 coalesce_asc | coalesce_desc | coalesce_below | coalesce_above 
--------------+---------------+----------------+----------------
 same+topn 30 | same+topn 30  | same+topn 30   | same+topn 30
(1 row)

DROP TABLE tc, tc_q, tq, tv;
DROP FUNCTION tc_check(text,integer), tc_coll(), tc_mode(boolean,integer), tq_runs(text);
DROP EXTENSION pg_sift_test, pg_sift;
