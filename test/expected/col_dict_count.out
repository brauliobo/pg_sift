CREATE FUNCTION dk_check() RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	k text;
	t record;
	got bigint;
	want bigint;
	bad int := 0;
	n int := 0;
BEGIN
	FOR k IN VALUES ('a'), ('a1'), ('a199'), ('b'), ('b0'), ('b05'), ('b100'), ('c'), ('c0'), ('c039'), ('c101'), ('d'), ('d005'), ('d0'), ('d5'), ('e'), ('e00'), ('e01500'), ('e03000'), ('e03001'), ('f'), ('') LOOP
		FOR t IN SELECT * FROM (VALUES ('='), ('<'), ('<='), ('>'), ('>='), ('^')) v(op) LOOP
			EXECUTE format('SELECT count(*) FROM dk WHERE s COLLATE "C" %s %L', CASE t.op WHEN '^' THEN 'LIKE' ELSE t.op END, CASE t.op WHEN '^' THEN k || '%' ELSE k END) INTO got;
			EXECUTE format('SELECT count(*) FROM (SELECT s FROM dk OFFSET 0) x WHERE s COLLATE "C" %s %L', CASE t.op WHEN '^' THEN 'LIKE' ELSE t.op END, CASE t.op WHEN '^' THEN k || '%' ELSE k END) INTO want;
			n := n + 1;
			IF got IS DISTINCT FROM want THEN
				bad := bad + 1;
				RAISE NOTICE '% %: index %, heap %', t.op, k, got, want;
			END IF;
		END LOOP;
	END LOOP;
	RETURN n || ' counts, ' || bad || ' differ';
END $$;
