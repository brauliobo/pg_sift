-- A function or UNION that reads a joined row fans it out; the scan runs PostgreSQL's plan of the child for each distinct input.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE entities (id int PRIMARY KEY, labels text[], region text);
INSERT INTO entities SELECT i, CASE i % 5 WHEN 0 THEN NULL WHEN 1 THEN ARRAY[]::text[] WHEN 2 THEN ARRAY['one', 'one', 'two'] WHEN 3 THEN ARRAY['two', NULL] ELSE ARRAY['three'] END,
 CASE WHEN i % 4 = 0 THEN 'north' ELSE 'south' END FROM generate_series(0, 49) i;
CREATE TABLE facts (id int, entity_id int, amount float8, metrics jsonb, code text, payload text);
INSERT INTO facts
SELECT i, CASE WHEN i % 101 = 0 THEN NULL ELSE i % 52 END, CASE WHEN i % 7 = 0 THEN NULL ELSE i % 13 END, jsonb_build_object('overall', i % 10), CASE WHEN i % 101 = 0 THEN 'none' ELSE (i % 10)::text END, repeat('payload', 50)
FROM generate_series(1, 60000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, entity_id, amount, metrics, code) WITH (paths = 'metrics.* float8');
VACUUM (FREEZE, ANALYZE) facts;
ANALYZE entities;
-- pushed: the plan PostgreSQL costs cheapest; eligible: the plan when its own table scans are off, which a Custom Scan (SiftAgg) beats only if the query is one it can run
CREATE FUNCTION check_query(q text) RETURNS TABLE (pushed bool, eligible bool, differences bigint) LANGUAGE plpgsql AS $$
DECLARE line text;
BEGIN
  SET LOCAL sift.enable_agg = off;
  EXECUTE 'CREATE TEMP TABLE r_off ON COMMIT DROP AS ' || q;
  SET LOCAL sift.enable_agg = on;
  EXECUTE 'CREATE TEMP TABLE r_on ON COMMIT DROP AS ' || q;
  SELECT count(*) INTO differences FROM ((TABLE r_off EXCEPT ALL TABLE r_on) UNION ALL (TABLE r_on EXCEPT ALL TABLE r_off)) d;
  pushed := false;
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP pushed := pushed OR line LIKE '%Custom Scan (SiftAgg)%'; END LOOP;
  SET LOCAL enable_seqscan = off;
  SET LOCAL enable_indexscan = off;
  SET LOCAL enable_bitmapscan = off;
  SET LOCAL enable_indexonlyscan = off;
  eligible := false;
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP eligible := eligible OR line LIKE '%Custom Scan (SiftAgg)%'; END LOOP;
  DROP TABLE r_off, r_on;
  RETURN NEXT;
END $$;
-- A UNION ALL of arms, one reading the item: every arm contributes a row, NULL items included.
SELECT * FROM check_query($q$
 SELECT c.category, count(*) AS n, count(DISTINCT f.id) AS ids, sum(f.amount) AS total
 FROM facts f JOIN LATERAL (SELECT 'all' AS category UNION ALL SELECT CASE WHEN f.entity_id > 25 THEN 'high' ELSE 'low' END) c ON true
 GROUP BY 1
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

-- UNION removes the arms' duplicates per item (a high item is 'all' and 'high'; here both arms agree for some items).
SELECT * FROM check_query($q$
 SELECT c.category, count(DISTINCT f.id) AS ids
 FROM facts f JOIN LATERAL (SELECT 'x' AS category UNION SELECT CASE WHEN f.entity_id > 25 THEN 'x' ELSE 'low' END) c ON true
 GROUP BY 1
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

-- A set-returning function of the item: no row for a non-positive count with the inner join, a NULL row with the left join.
SELECT * FROM check_query($q$
 SELECT g, count(*) AS n FROM facts f CROSS JOIN LATERAL generate_series(1, f.entity_id % 4) g GROUP BY g
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

SELECT * FROM check_query($q$
 SELECT g, count(*) AS n, count(f.id) AS ids FROM facts f LEFT JOIN LATERAL generate_series(1, f.entity_id % 4) g ON true GROUP BY g
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

-- The rows the scan keeps are those of the child for every distinct input: more than sift.agg_lookup_max_rows estimated keep the normal plan.
SET sift.agg_lookup_max_rows = 1000;
SELECT * FROM check_query($q$
 SELECT g, count(*) AS n FROM facts f CROSS JOIN LATERAL generate_series(1, f.entity_id % 4) g GROUP BY g
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 f      | f        |           0
(1 row)

RESET sift.agg_lookup_max_rows;
-- The array of a joined row fans out: duplicates stay, NULL and empty arrays and NULL elements behave as PostgreSQL does.
SELECT * FROM check_query($q$
 SELECT label, count(*) AS n, count(DISTINCT f.id) AS ids FROM facts f JOIN entities e ON e.id = f.entity_id
 LEFT JOIN LATERAL unnest(e.labels) label ON true GROUP BY label
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

SELECT * FROM check_query($q$
 SELECT e.region, label, count(*) AS n FROM facts f JOIN entities e ON e.id = f.entity_id
 CROSS JOIN LATERAL unnest(e.labels) label GROUP BY e.region, label
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

-- Stays native: the fan-out casts a joined text column, which can raise ('none' is the code of the rows without an entity, that the join leaves out), so it
-- is not computed for the rows that PostgreSQL's plan has not joined yet.
SELECT * FROM check_query($q$
 SELECT c.category, count(*) AS n
 FROM facts f JOIN entities e ON e.id = f.entity_id
 JOIN LATERAL (SELECT 'all' AS category UNION ALL SELECT CASE WHEN f.code::int > 6 THEN 'high' ELSE 'low' END) c ON true
 GROUP BY 1
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 f      | f        |           0
(1 row)

-- The same fan-out on a comparison of the text, which cannot raise, is joined by the scan.
SELECT * FROM check_query($q$
 SELECT c.category, count(*) AS n
 FROM facts f JOIN entities e ON e.id = f.entity_id
 JOIN LATERAL (SELECT 'all' AS category UNION ALL SELECT CASE WHEN f.code > '6' THEN 'high' ELSE 'low' END) c ON true
 GROUP BY 1
$q$);
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

-- The fan-out reads the member of a LEFT JOIN LATERAL jsonb_each on a constant key: a row level value of the index (agg_left_each). The outer-joined member keeps the normal plan before PostgreSQL 18 (columns: the plan is the pushed one from 18 on).
SELECT pushed <> old AS pushed, eligible <> old AS eligible, differences FROM check_query($q$
 SELECT c.category, count(*) AS n
 FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall'
 JOIN LATERAL (SELECT 'all' AS category UNION ALL SELECT CASE WHEN r.value::int > 6 THEN 'high' ELSE 'low' END) c ON true
 GROUP BY 1
$q$), (SELECT current_setting('server_version_num')::int < 180000 AS old) v;
 pushed | eligible | differences 
--------+----------+-------------
 t      | t        |           0
(1 row)

DROP FUNCTION check_query(text);
DROP TABLE facts, entities;
DROP EXTENSION pg_sift;
