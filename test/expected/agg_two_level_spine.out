(1 row)

-- the arms' column is a key too, next to the spine's
SELECT same(report('TABLE buckets', 'm.kind IS NOT DISTINCT FROM sp.kind', 'category, m.kind, sp.label')) AS arm_key_and_spine_key;
 arm_key_and_spine_key 
-----------------------
