-- The arms of a two-level aggregate may differ in their WHERE: a condition that every arm has is the scan's, and one that only some arms have is a
-- filter of those arms for their tuples (a third arm without the NOT NULL test of a lookup counts the rows the others drop). A constant in the GROUP
-- BY of the arms splits no group. Every query runs as the two-level scan, as the arms alone (sift.agg_two_level off) and as the normal plan; the
-- answers must be the same.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET seq_page_cost = 1000;
SET random_page_cost = 1000;
CREATE TABLE events (id int PRIMARY KEY, parent_id int, kind text, ts date, doc jsonb) WITH (autovacuum_enabled = false);
INSERT INTO events
SELECT i, CASE WHEN i % 31 = 0 THEN NULL ELSE i % 600 END, 'k' || i % 5, date '2025-01-01' + i % 400,
       CASE WHEN i % 13 = 0 THEN NULL
            ELSE jsonb_build_object('parts', (SELECT jsonb_agg(jsonb_build_object('cat', 'cat_' || (i + j) % 6, 'sign', (array['p', 'n'])[1 + (i + j) % 2],
                                                                                 'score', (i * j) % 10)) FROM generate_series(1, 1 + i % 4) j)) END
FROM generate_series(1, 6000) i;
CREATE INDEX events_col ON events USING sift_col (id, parent_id, kind, ts, doc) WITH (paths = 'doc.parts[]{cat text, sign text, score float8}');
CREATE TABLE lookup (kind text, cat text, mapped_cat text) WITH (autovacuum_enabled = false);
INSERT INTO lookup SELECT 'k' || k, 'cat_' || c, 'm' || (k + c) % 3 FROM generate_series(0, 4) k, generate_series(0, 5) c WHERE (k + c) % 5 <> 0;
CREATE UNIQUE INDEX lookup_key ON lookup (kind, cat);
VACUUM (FREEZE, ANALYZE) events;
VACUUM (FREEZE, ANALYZE) lookup;
-- three arms over the rows with their spans and the lookup (LIMIT 1); w1, w2, w3 are the WHERE of each, bucket is a constant the arms group by
CREATE FUNCTION report(w1 text DEFAULT 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', w2 text DEFAULT 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', w3 text DEFAULT 'true') RETURNS text LANGUAGE sql AS $$
	SELECT format($q$WITH scoped AS NOT MATERIALIZED (
	    SELECT e.id, e.parent_id, e.doc, e.kind, p.span, NULL::date AS bucket
	    FROM events e JOIN (VALUES ('span_a', daterange('2025-07-01', '2026-01-31', '[]')), ('span_b', daterange('2025-01-01', '2025-06-30', '[]'))) p(span, range)
	         ON e.ts <@ p.range),
	  mapped AS (
	    SELECT s.id, s.parent_id, s.span, s.bucket, CASE WHEN o.sign = 'p' THEN o.cat ELSE rm.mapped_cat END AS category, avg(o.score) AS score, count(s.id) AS n
	    FROM scoped s CROSS JOIN LATERAL jsonb_to_recordset(s.doc['parts']) o(cat text, sign text, score float8)
	    LEFT JOIN LATERAL (SELECT mapped_cat FROM lookup m WHERE m.kind = s.kind AND m.cat = o.cat LIMIT 1) rm ON true
	    WHERE %s GROUP BY s.id, s.parent_id, s.span, s.bucket, CASE WHEN o.sign = 'p' THEN o.cat ELSE rm.mapped_cat END
	    UNION ALL
	    SELECT s.id, s.parent_id, s.span, s.bucket, NULL::text, avg(o.score), count(s.id)
	    FROM scoped s CROSS JOIN LATERAL jsonb_to_recordset(s.doc['parts']) o(cat text, sign text, score float8)
	    LEFT JOIN LATERAL (SELECT mapped_cat FROM lookup m WHERE m.kind = s.kind AND m.cat = o.cat LIMIT 1) rm ON true
	    WHERE %s GROUP BY s.id, s.parent_id, s.span, s.bucket
	    UNION ALL
	    SELECT s.id, s.parent_id, s.span, s.bucket, NULL::text, avg(o.score), count(s.id)
	    FROM scoped s CROSS JOIN LATERAL jsonb_to_recordset(s.doc['parts']) o(cat text, sign text, score float8)
	    LEFT JOIN LATERAL (SELECT mapped_cat FROM lookup m WHERE m.kind = s.kind AND m.cat = o.cat LIMIT 1) rm ON true
	    WHERE %s GROUP BY s.id, s.parent_id, s.span, s.bucket)
	  SELECT coalesce(category, 'all_cats') AS category, span, round(avg(score)::numeric, 6) AS value, sum(n)::int AS n,
	         count(DISTINCT id) AS ids, count(DISTINCT parent_id) AS parents
	  FROM mapped GROUP BY category, span ORDER BY 1, 2$q$, w1, w2, w3)
$$;
-- the same arms under a spine of buckets, one of which no row has: it is a row of NULL columns
CREATE FUNCTION spined(sets text DEFAULT NULL) RETURNS text LANGUAGE sql AS $$
	SELECT format($q$WITH scoped AS NOT MATERIALIZED (SELECT e.id, e.kind, e.doc, e.ts FROM events e),
	  mapped AS (
	    SELECT s.id, CASE WHEN o.sign = 'p' THEN o.cat ELSE rm.mapped_cat END AS category, avg(o.score) AS score, count(s.id) AS n
	    FROM scoped s CROSS JOIN LATERAL jsonb_to_recordset(s.doc['parts']) o(cat text, sign text, score float8)
	    LEFT JOIN LATERAL (SELECT mapped_cat FROM lookup m WHERE m.kind = s.kind AND m.cat = o.cat LIMIT 1) rm ON true
	    WHERE CASE WHEN o.sign = 'p' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL GROUP BY s.id, CASE WHEN o.sign = 'p' THEN o.cat ELSE rm.mapped_cat END
	    UNION ALL
	    SELECT s.id, NULL::text, avg(o.score), count(s.id)
	    FROM scoped s CROSS JOIN LATERAL jsonb_to_recordset(s.doc['parts']) o(cat text, sign text, score float8)
	    LEFT JOIN LATERAL (SELECT mapped_cat FROM lookup m WHERE m.kind = s.kind AND m.cat = o.cat LIMIT 1) rm ON true
	    GROUP BY s.id)
	  SELECT b.label, m.category, count(*) AS cells, round(avg(m.score)::numeric, 6) AS value, sum(m.n)::int AS n, count(DISTINCT m.id) AS ids
	  FROM (VALUES ('m0'), ('m1'), ('cat_2'), ('none')) b(label) LEFT JOIN mapped m ON m.category = b.label
	  GROUP BY %s ORDER BY 1, 2$q$, coalesce(sets, 'b.label, m.category'))
$$;
-- the plan is the two-level scan: the joins in the node, and neither the grouping of PostgreSQL nor the node that groups rows
CREATE FUNCTION pushed(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE l text; scan bool := false;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l ~ 'Custom Scan \(SiftAgg\)' THEN scan := true; END IF;
		IF l ~ '(SiftAggRows|GroupAggregate|HashAggregate)' THEN RETURN false; END IF;
	END LOOP;
	RETURN scan;
END $$;
-- the rows of the two-level scan and of the normal plan are the same; empty: the answer has no row; scan: the plan is the scan's
CREATE FUNCTION same(q text, empty bool DEFAULT false, scan bool DEFAULT true) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE a bigint; n bigint;
BEGIN
	SET sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off AS %s', q);
	RESET sift.enable_agg;
	EXECUTE format('CREATE TEMP TABLE r_on AS %s', q);
	SELECT count(*) INTO a FROM ((TABLE r_on EXCEPT TABLE r_off) UNION ALL (TABLE r_off EXCEPT TABLE r_on)) d;
	SELECT count(*) INTO n FROM r_off;
	DROP TABLE r_on, r_off;
	RETURN a = 0 AND (n > 0) <> empty AND (NOT scan OR pushed(q));
END $$;
-- the third arm has no WHERE: its rows count where the lookup has no row
SELECT same(report()) AS third_arm_unfiltered;
 third_arm_unfiltered 
----------------------
 t
(1 row)

-- the first arm is the one without WHERE
SELECT same(report('true', 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL')) AS first_arm_unfiltered;
 first_arm_unfiltered 
----------------------
 t
(1 row)

-- a NOT NULL test of the lookup itself makes its outer join an inner one in the arms that have it: they are not arms of one scan
SELECT same(report('rm.mapped_cat IS NOT NULL', 'rm.mapped_cat IS NOT NULL'), scan => false) AS join_types_differ;
 join_types_differ 
-------------------
 t
(1 row)

-- every arm has the same WHERE: it is the scan's
SELECT same(report('CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL')) AS all_alike;
 all_alike 
-----------
 t
(1 row)

SELECT same(report('true', 'true', 'true')) AS none;
 none 
------
 t
(1 row)

-- each arm has a condition of its own besides the common one
SELECT same(report('CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL AND o.score > 2', 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', 'o.sign = ''p'' AND CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL')) AS own_conditions;
 own_conditions 
----------------
 t
(1 row)

SELECT same(report('o.score > 2', 'o.score > 2 AND o.sign = ''n''', 'o.score > 2')) AS common_and_own;
 common_and_own 
----------------
 t
(1 row)

-- a condition no tuple passes in one arm: that arm has no group
SELECT same(report('o.score > 100', 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', 'true')) AS arm_without_rows;
 arm_without_rows 
------------------
 t
(1 row)

SELECT same(report('CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', 'o.score > 100', 'o.score > 100'), scan => false) AS arms_without_rows;
 arms_without_rows 
-------------------
 t
(1 row)

-- a spine of buckets over arms with different WHERE
SELECT same(spined()) AS spine;
 spine 
-------
 t
(1 row)

-- and by grouping sets: the sets that lack a key null it, the spine rows no cell matched are a group in each
SELECT same(spined('GROUPING SETS ((b.label, m.category), (b.label), (m.category), ())')) AS spine_sets;
 spine_sets 
------------
 t
(1 row)

-- rows that were updated and deleted since the index was built are read from the heap
UPDATE events SET doc = jsonb_set(doc, '{parts,0,score}', '9') WHERE id % 17 = 0 AND doc IS NOT NULL;
UPDATE events SET ts = ts + 30, kind = 'k' || (id + 1) % 5 WHERE id % 19 = 0;
DELETE FROM events WHERE id % 23 = 0;
SELECT same(report()) AS dirty_rows;
 dirty_rows 
------------
 t
(1 row)

SELECT same(report('CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL AND o.score > 2', 'CASE WHEN o.sign = ''p'' THEN o.cat ELSE rm.mapped_cat END IS NOT NULL', 'o.sign = ''p''')) AS dirty_own_conditions;
 dirty_own_conditions 
----------------------
 t
(1 row)

UPDATE lookup SET mapped_cat = 'm9' WHERE cat = 'cat_1';
SELECT same(report()) AS dirty_lookup;
 dirty_lookup 
--------------
 t
(1 row)

-- an arm that does not join the lookup is not an arm of the same scan, and the refusal says which
CREATE FUNCTION unlike() RETURNS text LANGUAGE sql AS $$
	SELECT $q$WITH mapped AS (
	    SELECT e.id, rm.mapped_cat AS category, count(*) AS n
	    FROM events e LEFT JOIN LATERAL (SELECT mapped_cat FROM lookup m WHERE m.kind = e.kind LIMIT 1) rm ON true GROUP BY e.id, rm.mapped_cat
	    UNION ALL
	    SELECT e.id, NULL::text, count(*) FROM events e GROUP BY e.id)
	  SELECT category, sum(n) AS n, count(DISTINCT id) AS ids FROM mapped GROUP BY category$q$
$$;
SELECT same(unlike(), scan => false) AS unlike_arms;
 unlike_arms 
-------------
 t
(1 row)

SET sift.explain_refusals = on;
SET client_min_messages = notice;
DO $$
DECLARE l text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || unlike() LOOP
		NULL;
	END LOOP;
END $$;
NOTICE:  SiftAgg not used: lateral_limit: a LATERAL sub-select with LIMIT 1 stays a child that runs for each key: no unique index holds its key, or its ORDER BY leaves ties
DETAIL:  arm: L2:lookup
NOTICE:  SiftAgg not used: two_arms: the arms of the two level aggregate are not UNION ALL branches of aggregates over one scan, each grouped by a unique row id (arm 1 is not a plain aggregate (it has DISTINCT, ORDER BY, LIMIT, windows, grouping sets, a CTE list or no GROUP BY))
DETAIL:  arm: L2:two_level
NOTICE:  SiftAgg not used: cost: the normal plan is estimated cheaper than the scan (the scan costs 42108.94, the normal plan 31193.06; 100% of the heap pages are not all-visible, which adds 41500.00 to the scan: VACUUM (ANALYZE) the table)
DETAIL:  arm: L2:single
NOTICE:  SiftAgg not used: two_arms: the arms of the two level aggregate are not UNION ALL branches of aggregates over one scan, each grouped by a unique row id (arm 2 does not read the scan of arm 1: its tables or joins differ)
DETAIL:  arm: two_level
DROP TABLE events, lookup;
DROP FUNCTION pushed(text), report(text,text,text), same(text,boolean,boolean), spined(text), unlike();
DROP EXTENSION pg_sift;
