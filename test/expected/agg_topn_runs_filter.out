-- ORDER BY ts DESC LIMIT n with a condition on another column is read through the sorted run of each unit: the condition is tested on every row of the unit first (a mask), and
-- the run gives the best rows of those that pass. The planner priced it as the whole scan of the rows (the heap of n rows, every row of the unit with its tuple work) and
-- the fetch of each row of the page at a random page's price: a page of 5,000 rows of a table of 300,000 rows (10% passing) was the normal plan (16 ms) against the scan (8.7 ms).
-- With the mask priced at what it reads, and a fetch at the page-visit price, the scan is the plan; its price follows the page: more rows cost more.
CREATE EXTENSION pg_sift;
SET sift.test_col_legacy_options = on;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE feed (id int, ts timestamptz, q10 int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO feed SELECT i, timestamptz '2024-01-01' + interval '1 second' * ((i::bigint * 7919) % 63072000), (hashint4(i) & 1023 < 102)::int, repeat('x', 40) FROM generate_series(1, 300000) i;
CREATE INDEX feed_col ON feed USING sift_col (id, ts, q10) WITH (order_columns = 'ts', order_array_columns = 'ts');
VACUUM (FREEZE, ANALYZE) feed;
CREATE FUNCTION page(n int) RETURNS TABLE (used bool, cost float8, normal float8) LANGUAGE sql AS
$$ SELECT used, scan_cost, normal_cost FROM sift.explain_why('SELECT id, ts FROM feed WHERE q10 = 1 ORDER BY ts DESC LIMIT ' || n) $$;
SELECT (SELECT used FROM page(5000)) AS big_page_is_the_scan,
	(SELECT cost FROM page(5000)) < (SELECT normal FROM page(5000)) AS cheaper_than_normal,
	(SELECT cost FROM page(20)) < (SELECT cost FROM page(1000)) AND (SELECT cost FROM page(1000)) < (SELECT cost FROM page(5000)) AS grows_with_the_page;
 big_page_is_the_scan | cheaper_than_normal | grows_with_the_page 
----------------------+---------------------+---------------------
 t                    | t                   | t
(1 row)

DROP FUNCTION page(int);
DROP TABLE feed;
DROP EXTENSION pg_sift;
