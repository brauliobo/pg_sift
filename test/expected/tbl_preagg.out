  2 | key int, numeric | all  | t
  3 | key text         | all  | t
  4 | key date         | all  | t
  5 | whole table      | all  | t
  6 | test of dim      | all  | t
  7 | null group       | all  | t
  8 | key in list      | all  | t
  9 | zone covers some | some | t
 10 | other test: scan | none | t
 11 | no rows          | none | t
 12 | having, limit    | all  | t
 13 | float: scan      | scan | t
(13 rows)

-- 4. committed deletes and updates: the superblocks with a tombstone are scanned
DELETE FROM tp WHERE id BETWEEN 1000 AND 1100;
UPDATE tp SET qty = qty + 1, k = 'k9', amt = NULL WHERE id BETWEEN 120000 AND 120100;
SELECT * FROM pa_check('tp');
 n  |      shape       | pre  | same 
----+------------------+------+------
  1 | key int, nulls   | some | t
  2 | key int, numeric | some | t
  3 | key text         | some | t
  4 | key date         | some | t
  5 | whole table      | some | t
  6 | test of dim      | some | t
  7 | null group       | some | t
  8 | key in list      | some | t
  9 | zone covers some | some | t
 10 | other test: scan | none | t
 11 | no rows          | none | t
 12 | having, limit    | some | t
 13 | float: scan      | scan | t
(13 rows)

-- 5. vacuumed: the units that lost rows stay scanned until a rewrite
VACUUM (DISABLE_PAGE_SKIPPING) tp;
SELECT * FROM pa_check('tp');
 n  |      shape       | pre  | same 
----+------------------+------+------
  1 | key int, nulls   | some | t
  2 | key int, numeric | some | t
  3 | key text         | some | t
  4 | key date         | some | t
  5 | whole table      | some | t
  6 | test of dim      | some | t
  7 | null group       | some | t
  8 | key in list      | some | t
  9 | zone covers some | some | t
 10 | other test: scan | none | t
 11 | no rows          | none | t
 12 | having, limit    | some | t
 13 | float: scan      | scan | t
(13 rows)

-- 6. the transaction's own changes, a rolled back one, a savepoint
BEGIN;
DELETE FROM tp WHERE id % 1000 = 0;
INSERT INTO tp SELECT 500000 + i, i % 9, 'new', i % 10, current_date, i, i % 7, i, i FROM generate_series(1, 500) i;
SELECT * FROM pa_check('tp');
 n  |      shape       | pre  | same 
----+------------------+------+------
  1 | key int, nulls   | none | t
  2 | key int, numeric | none | t
  3 | key text         | none | t
  4 | key date         | none | t
  5 | whole table      | none | t
  6 | test of dim      | none | t
  7 | null group       | none | t
  8 | key in list      | none | t
  9 | zone covers some | none | t
 10 | other test: scan | none | t
 11 | no rows          | none | t
 12 | having, limit    | none | t
 13 | float: scan      | scan | t
(13 rows)

SAVEPOINT s1;
UPDATE tp SET g = 1, qty = qty + 5 WHERE id % 777 = 0;
SELECT * FROM pa_check('tp');
