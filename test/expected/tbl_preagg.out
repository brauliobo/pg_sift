-- 7. a rolled back delete and update leave their tombstones aborted
BEGIN;
DELETE FROM tp WHERE id BETWEEN 60000 AND 60500;
UPDATE tp SET qty = 0 WHERE id BETWEEN 150000 AND 150500;
