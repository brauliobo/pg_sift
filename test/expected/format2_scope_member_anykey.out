CREATE INDEX CONCURRENTLY ev_text_c ON ev_text USING sift_col (member, created_at, amount, kind) WITH (scope = 'k: member -> pm_text(member, key)', track_changes = 'ctid');
SELECT relation::text, format_major, scopes > 0 AS summarized FROM sift.status('ev_text_c');
