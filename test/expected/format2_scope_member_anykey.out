-- 6. UNIQUE and INCLUDE compose with a text or uuid member in format major 2
CREATE TABLE accounts (id int NOT NULL, email text NOT NULL, plan int NOT NULL, spent int NOT NULL, tag uuid NOT NULL);
INSERT INTO accounts SELECT i, name, i % 5, i % 90, u FROM generate_series(1, 500) i JOIN names ON n = 1 + i % 44;
CREATE UNIQUE INDEX accounts_u ON accounts USING sift_col (email, id) INCLUDE (plan, spent) WITH (scope = 'k: email -> pm_text(member, key)', track_changes = 'ctid');
CREATE UNIQUE INDEX accounts_uu ON accounts USING sift_col (tag, id) INCLUDE (plan, spent) WITH (scope = 'k: tag -> pm_uuid(member, key)', track_changes = 'ctid');
SELECT relation::text, format_major, scopes > 0 AS summarized FROM sift.status() WHERE relation::text LIKE 'accounts\_%' ORDER BY 1;
  relation   | format_major | summarized 
-------------+--------------+------------
 accounts_u  |            2 | t
 accounts_uu |            2 | t
(2 rows)

SELECT same('SELECT count(*), sum(a.spent) FROM accounts a JOIN pm_text p ON p.member = a.email WHERE p.key = 3') AS unique_include_text;
 unique_include_text 
---------------------
 same summary
(1 row)

SELECT same('SELECT count(*), sum(a.spent) FROM accounts a JOIN pm_uuid p ON p.member = a.tag WHERE p.key = 3') AS unique_include_uuid;
 unique_include_uuid 
---------------------
 same summary
(1 row)

SELECT same('SELECT p.key, count(*), sum(a.spent) FROM accounts a JOIN pm_text p ON p.member = a.email GROUP BY p.key') AS unique_include_group;
 unique_include_group 
----------------------
 same summary
(1 row)

INSERT INTO accounts SELECT 5000 + i, name, i % 5, i % 90, u FROM generate_series(1, 200) i JOIN names ON n = 1 + i % 44;
UPDATE accounts SET spent = spent + 1 WHERE id % 7 = 0;
DELETE FROM accounts WHERE id % 11 = 0;
VACUUM accounts;
SELECT same('SELECT count(*), sum(a.spent) FROM accounts a JOIN pm_text p ON p.member = a.email WHERE p.key = 3') AS after_dml_text;
 after_dml_text 
----------------
 same summary
(1 row)

SELECT same('SELECT count(*), sum(a.spent) FROM accounts a JOIN pm_uuid p ON p.member = a.tag WHERE p.key = 3') AS after_dml_uuid;
 after_dml_uuid 
----------------
 same summary
(1 row)

