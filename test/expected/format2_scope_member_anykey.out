-------------+------+--------
(0 rows)

-- the members the pairs and the facts changed: a member no summary has (45), a member of a key it was not in, members that leave a key or all their keys, rows deleted and updated, a write that aborts
INSERT INTO names SELECT n, 'member-' || n, md5('m' || n)::uuid FROM generate_series(45, 46) n;
DO $$ DECLARE t text; mc text;
BEGIN
	FOR t, mc IN SELECT * FROM (VALUES ('text', 'name'), ('varchar', 'name'), ('uuid', 'u')) v LOOP
		EXECUTE format('INSERT INTO ev_%s SELECT 10000 + i, CASE WHEN i %% 53 = 0 THEN NULL ELSE %s END, timestamptz ''2026-08-01'' + i * interval ''13 minutes'', i %% 11, 3 FROM generate_series(1, 400) i JOIN names ON n = 1 + i %% 46', t, mc);
	END LOOP;
	DELETE FROM ev_text WHERE id % 29 = 0;
	DELETE FROM ev_varchar WHERE id % 29 = 0;
	DELETE FROM ev_uuid WHERE id % 29 = 0;
	UPDATE ev_text SET amount = amount + 1000, kind = 5 WHERE id % 31 = 0;
	UPDATE ev_varchar SET amount = amount + 1000, kind = 5 WHERE id % 31 = 0;
	UPDATE ev_uuid SET amount = amount + 1000, kind = 5 WHERE id % 31 = 0;
END $$;
BEGIN;
INSERT INTO ev_text VALUES (99999, 'member-1', now(), 777, 6);
INSERT INTO ev_uuid VALUES (99999, md5('m1')::uuid, now(), 777, 6);
ROLLBACK;
CREATE FUNCTION after_dml() RETURNS TABLE (member_type text, what text, result text) LANGUAGE plpgsql AS $$
DECLARE t text;
BEGIN
	FOR t IN SELECT unnest(ARRAY['text', 'varchar', 'uuid']) LOOP
		member_type := t;
		what := 'key 3';
		result := same(format('SELECT count(*), sum(e.amount) FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key = 3', t, t));
		RETURN NEXT;
		what := 'key 5';
		result := same(format('SELECT count(*), sum(e.amount), max(e.kind) FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key = 5', t, t));
		RETURN NEXT;
		what := 'group by key';
		result := same(format('SELECT p.key, count(*), sum(e.amount) FROM ev_%s e JOIN pm_%s p ON p.member = e.member GROUP BY p.key', t, t));
		RETURN NEXT;
		what := 'IN list';
		result := same(format('SELECT count(*), sum(e.amount) FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key IN (0, 5, 99)', t, t));
		RETURN NEXT;
		what := 'newest rows';
		result := same(format('SELECT e.created_at, e.amount, e.kind FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key = 5 ORDER BY e.created_at DESC LIMIT 5', t, t));
		RETURN NEXT;
	END LOOP;
END $$;
-- 3. The facts changed: new members of the pairs are not new members of the summary, a row of a member no pair has, deleted and updated rows, an aborted insert
SELECT * FROM after_dml() WHERE result <> 'same summary';
 member_type | what | result 
-------------+------+--------
(0 rows)

SELECT count(*) AS statements FROM after_dml();
 statements 
------------
         15
(1 row)

SELECT count(*) AS differ FROM all_shapes();
 differ 
--------
      0
(1 row)

-- the journal names a member by a 64-bit word of its bytes: the testing library keeps 3 bits of it, so that the members share their words and the read patches the members that share one with a changed member
DO $$ BEGIN IF current_setting('sift.test_member_hash_bits', true) IS NOT NULL THEN PERFORM set_config('sift.test_member_hash_bits', '3', false); END IF; END $$;
-- 4. The pairs changed: a member that joins a key (a row the summary lacks for the key), leaves it, a new member that is in the facts, a key that is new
INSERT INTO pm_text SELECT name, 5 FROM names WHERE n IN (1, 2, 41, 45);
INSERT INTO pm_varchar SELECT name, 5 FROM names WHERE n IN (1, 2, 41, 45);
INSERT INTO pm_uuid SELECT u, 5 FROM names WHERE n IN (1, 2, 41, 45);
DELETE FROM pm_text WHERE key = 4;
DELETE FROM pm_varchar WHERE key = 4;
DELETE FROM pm_uuid WHERE key = 4;
UPDATE pm_text SET key = 12 WHERE key = 7;
UPDATE pm_varchar SET key = 12 WHERE key = 7;
UPDATE pm_uuid SET key = 12 WHERE key = 7;
-- a read of every key answers from the pairs as the summary was built: the join answers it while they have moved, whatever the member type
SELECT * FROM after_dml() WHERE result <> 'same summary';
 member_type |     what     |  result   
-------------+--------------+-----------
 text        | group by key | same join
 varchar     | group by key | same join
 uuid        | group by key | same join
(3 rows)

SELECT * FROM all_shapes();
 member_type |     what     |  result   
-------------+--------------+-----------
