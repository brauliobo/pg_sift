-- 8. A member of the pairs longer than a scope key store holds is refused with its size
CREATE TABLE pm_big (member text NOT NULL, key int NOT NULL);
CREATE UNIQUE INDEX pm_big_u ON pm_big (member, key);
INSERT INTO pm_big VALUES (repeat('b', 300), 1);
DO $$ BEGIN
	CREATE INDEX ev_big ON ev_text USING sift_col (member, created_at, amount, kind) WITH (scope = 'k: member -> pm_big(member, key)', track_changes = 'ctid');
EXCEPTION WHEN program_limit_exceeded THEN RAISE WARNING 'refused: %', SQLERRM;
END $$;
WARNING:  refused: a scope key of 300 bytes is longer than the 255 bytes a scope key store holds
DROP TABLE ev_text, ev_varchar, ev_uuid, pm_text, pm_varchar, pm_uuid, pm_big, accounts, names;
DROP FUNCTION same(text), shapes(text), all_shapes(), after_dml();
DROP EXTENSION pg_sift;
