-- A scope whose member is a text, varchar or uuid column is summarized in format major 2 (sift.status: format_major = 2, scopes > 0): the cubes are cut by the scope key as for an integer member, and
-- the member is named by its code in the scope key store of the member column of the pairs relation (col/f2/f2_scope_mem.c). Every answer of the node is compared with the heap
-- (sift.enable_agg = off): counts and sums of a key, the keys of a group, an IN list, the newest rows, a key the pairs lack, the members that are empty, long, differ in case, in a trailing blank or in
-- an accent, members no pair has, NULL members. The summary follows INSERT, UPDATE, DELETE, an aborted write, VACUUM, the maintenance step, REINDEX and CREATE INDEX CONCURRENTLY, and composes with UNIQUE and INCLUDE.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET TimeZone = 'UTC';
-- the testing library builds new indexes in format major 1 unless told otherwise; the release library has no such setting
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
-- the members: ordinary, empty, long, long with one different last byte, differing in case, in a trailing blank or an accent, with a quote and a multibyte character; 41 to 44 are in no pair
CREATE TABLE names (n int PRIMARY KEY, name text NOT NULL, u uuid NOT NULL);
INSERT INTO names SELECT n, CASE n WHEN 1 THEN '' WHEN 2 THEN repeat('long-', 50) WHEN 3 THEN repeat('x', 200) || 'a' WHEN 4 THEN repeat('x', 200) || 'b' WHEN 5 THEN 'Tenant' WHEN 6 THEN 'tenant'
	WHEN 7 THEN 'tenant ' WHEN 8 THEN 'ténant' WHEN 9 THEN 'it''s' WHEN 10 THEN '日本' ELSE 'member-' || n END, md5('m' || n)::uuid FROM generate_series(1, 44) n;
CREATE TABLE ev_text (id int PRIMARY KEY, member text, created_at timestamptz NOT NULL, amount int NOT NULL, kind int NOT NULL) WITH (autovacuum_enabled = false);
CREATE TABLE ev_varchar (id int PRIMARY KEY, member varchar(255), created_at timestamptz NOT NULL, amount int NOT NULL, kind int NOT NULL) WITH (autovacuum_enabled = false);
CREATE TABLE ev_uuid (id int PRIMARY KEY, member uuid, created_at timestamptz NOT NULL, amount int NOT NULL, kind int NOT NULL) WITH (autovacuum_enabled = false);
INSERT INTO ev_text SELECT i, CASE WHEN i % 97 = 0 THEN NULL ELSE name END, timestamptz '2026-01-01' + i * interval '97 minutes', i % 101, i % 7 FROM generate_series(1, 2000) i JOIN names ON n = 1 + i % 44;
INSERT INTO ev_varchar SELECT id, member, created_at, amount, kind FROM ev_text;
INSERT INTO ev_uuid SELECT i, CASE WHEN i % 97 = 0 THEN NULL ELSE u END, timestamptz '2026-01-01' + i * interval '97 minutes', i % 101, i % 7 FROM generate_series(1, 2000) i JOIN names ON n = 1 + i % 44;
-- member n is in the key n % 10, and in the next one when n is a multiple of 3: keys 0 to 9, and 99 is absent
CREATE TABLE pm_text (member text NOT NULL, key int NOT NULL);
CREATE TABLE pm_varchar (member varchar(255) NOT NULL, key int NOT NULL);
CREATE TABLE pm_uuid (member uuid NOT NULL, key int NOT NULL);
CREATE UNIQUE INDEX pm_text_u ON pm_text (member, key);
CREATE UNIQUE INDEX pm_varchar_u ON pm_varchar (member, key);
CREATE UNIQUE INDEX pm_uuid_u ON pm_uuid (member, key);
INSERT INTO pm_text SELECT name, (n + j) % 10 FROM names, generate_series(0, 1) j WHERE n <= 40 AND j <= (n % 3 = 0)::int;
INSERT INTO pm_varchar SELECT name, (n + j) % 10 FROM names, generate_series(0, 1) j WHERE n <= 40 AND j <= (n % 3 = 0)::int;
INSERT INTO pm_uuid SELECT u, (n + j) % 10 FROM names, generate_series(0, 1) j WHERE n <= 40 AND j <= (n % 3 = 0)::int;
CREATE INDEX ev_text_i ON ev_text USING sift_col (member, created_at, amount, kind) WITH (scope = 'k: member -> pm_text(member, key)', track_changes = 'ctid');
CREATE INDEX ev_varchar_i ON ev_varchar USING sift_col (member, created_at, amount, kind) WITH (scope = 'k: member -> pm_varchar(member, key)', track_changes = 'ctid');
CREATE INDEX ev_uuid_i ON ev_uuid USING sift_col (member, created_at, amount, kind) WITH (scope = 'k: member -> pm_uuid(member, key)', track_changes = 'ctid');
VACUUM ANALYZE ev_text;
VACUUM ANALYZE ev_varchar;
VACUUM ANALYZE ev_uuid;
VACUUM ANALYZE pm_text;
VACUUM ANALYZE pm_varchar;
VACUUM ANALYZE pm_uuid;
-- 1. Format major 2 with a summary of the 10 keys each
SELECT relation::text, format_major, scopes > 0 AS summarized FROM sift.status() WHERE relation::text LIKE 'ev\_%' ORDER BY 1;
   relation   | format_major | summarized 
--------------+--------------+------------
 ev_text_i    |            2 | t
 ev_uuid_i    |            2 | t
 ev_varchar_i |            2 | t
(3 rows)

SELECT 'text' AS member_type, nkeys FROM sift.scope_stats('ev_text_i') UNION ALL SELECT 'varchar', nkeys FROM sift.scope_stats('ev_varchar_i') UNION ALL SELECT 'uuid', nkeys FROM sift.scope_stats('ev_uuid_i') ORDER BY 1;
 member_type | nkeys 
-------------+-------
 text        |    10
 uuid        |    10
 varchar     |    10
(3 rows)

-- the answer of the node and of the heap for one statement: same or DIFFERENT, and whether the summary served it (join: the node ran the join, other: no node)
CREATE FUNCTION same(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a jsonb; b jsonb; plan text := ''; l text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP plan := plan || l; END LOOP;
	EXECUTE format('SELECT coalesce(jsonb_agg(to_jsonb(r) ORDER BY to_jsonb(r)::text), ''[]'') FROM (%s) r', q) INTO a;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('SELECT coalesce(jsonb_agg(to_jsonb(r) ORDER BY to_jsonb(r)::text), ''[]'') FROM (%s) r', q) INTO b;
	SET LOCAL sift.enable_agg = on;
	RETURN (CASE WHEN a = b THEN 'same' ELSE 'DIFFERENT' END) || ' ' || (CASE WHEN plan ~ 'Scope Read: (summary|ring)' THEN 'summary' WHEN plan LIKE '%SiftAggV6Scope%' THEN 'join' ELSE 'other' END);
END $$;
-- every shape of statement over a member type: the keys 0 to 9 and 99 by value, the group by the key, an IN list, a key no pair has, the newest rows
CREATE FUNCTION shapes(t text) RETURNS TABLE (what text, result text) LANGUAGE plpgsql AS $$
DECLARE k int;
BEGIN
	FOR k IN SELECT unnest(ARRAY[0, 1, 3, 4, 5, 6, 7, 9, 99]) LOOP
		what := 'key ' || k;
		result := same(format('SELECT count(*), sum(e.amount), max(e.kind), avg(e.amount) FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key = %s', t, t, k));
		RETURN NEXT;
	END LOOP;
	what := 'group by key';
	result := same(format('SELECT p.key, count(*), sum(e.amount) FROM ev_%s e JOIN pm_%s p ON p.member = e.member GROUP BY p.key', t, t));
	RETURN NEXT;
	what := 'IN list';
	result := same(format('SELECT count(*), sum(e.amount) FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key IN (0, 3, 6)', t, t));
	RETURN NEXT;
	what := 'IN list with an absent key';
	result := same(format('SELECT p.key, count(*) FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key IN (4, 99) GROUP BY p.key', t, t));
	RETURN NEXT;
	what := 'newest rows';
	result := same(format('SELECT e.created_at, e.amount, e.kind FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key = 7 ORDER BY e.created_at DESC LIMIT 5', t, t));
	RETURN NEXT;
END $$;
CREATE FUNCTION all_shapes() RETURNS TABLE (member_type text, what text, result text) LANGUAGE sql AS $$
	SELECT t, s.what, s.result FROM unnest(ARRAY['text', 'varchar', 'uuid']) t, LATERAL shapes(t) s WHERE s.result <> 'same summary'
$$;
