-- 5. VACUUM, the maintenance step, REINDEX and CREATE INDEX CONCURRENTLY build the summary again over the same members
VACUUM ev_text;
VACUUM ev_varchar;
VACUUM ev_uuid;
SELECT count(*) AS differ FROM after_dml() WHERE result <> 'same summary';
 differ 
--------
      0
(1 row)

SELECT count(*) AS busy FROM sift.maintain('ev_text_i') WHERE busy;
