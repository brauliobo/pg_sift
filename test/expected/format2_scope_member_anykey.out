 text        | newest rows  | same join
 varchar     | group by key | same join
 varchar     | newest rows  | same join
 uuid        | group by key | same join
 uuid        | newest rows  | same join
(6 rows)

SELECT same(format('SELECT count(*), sum(e.amount) FROM ev_%s e JOIN pm_%s p ON p.member = e.member WHERE p.key = 12', t, t)) AS new_key FROM unnest(ARRAY['text', 'varchar', 'uuid']) t;
   new_key    
--------------
