	('subselect_not_in', 'subquery', $q$SELECT status, count(*) AS n FROM events e WHERE category_id NOT IN (SELECT id FROM dim_a WHERE set_id = 2) GROUP BY 1$q$),
	('subselect_from_agg_over_agg', 'subquery', $q$SELECT status, avg(n) AS a FROM (SELECT status, tenant_id, count(*) AS n FROM events GROUP BY 1, 2) t GROUP BY 1$q$),
