-- Which ordinary analytics shapes the aggregate scan answers (sift.agg_force on: the shape decides, not the cost), and why it does not for the rest. Each row is one
-- statement: pushed says the plan has a SiftAgg or Top-N node, differences counts the rows that differ from the normal plan (sift.enable_agg off), order_differs says
-- whether a statement with an ORDER BY of its own returns its rows in another order, and why is the refusal slug (sift.explain_why) of one that keeps the normal plan.
-- A row that is not pushed is a gap or a limit by design (docs/LIMITS.md); when a shape starts to be answered its row changes here.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE tenants (id int PRIMARY KEY, type text NOT NULL, region text);
CREATE TABLE dim_a (id int PRIMARY KEY, name text NOT NULL, set_id int NOT NULL);
CREATE TABLE events (id bigint PRIMARY KEY, tenant_id int NOT NULL, category_id int NOT NULL, event_date date NOT NULL, created_at timestamptz NOT NULL, status text,
	value_num numeric(12,2), counter_a int, value_f float8, flag_a bool, label text, metrics jsonb NOT NULL);
INSERT INTO tenants SELECT g, (ARRAY['type_a', 'type_a', 'type_a', 'type_b', 'type_c', 'type_d'])[1 + g % 6], 'region' || (g % 5) FROM generate_series(1, 40) g;
INSERT INTO dim_a SELECT g, 'kind' || g, 1 + g % 4 FROM generate_series(1, 30) g;
INSERT INTO events
SELECT g, 1 + (g * 7) % 40, 1 + (g * 5) % 19, date '2024-01-01' + (g * 13) % 700, timestamptz '2024-01-01' + ((g * 7919) % 700) * interval '1 day' + (g % 86400) * interval '1 second',
       CASE WHEN g % 31 = 0 THEN NULL ELSE (ARRAY['open', 'paid', 'void', 'late'])[1 + g % 4] END,
       CASE WHEN g % 19 = 0 THEN NULL ELSE ((g * 37) % 100000)::numeric / 100 END,
       CASE WHEN g % 17 = 0 THEN NULL ELSE (g * 11) % 51 END,
       CASE WHEN g % 23 = 0 THEN NULL ELSE ((g * 17) % 1000)::float8 / 100 END,
       CASE WHEN g % 13 = 0 THEN NULL ELSE g % 3 = 0 END,
       CASE WHEN g % 2 = 0 THEN 'note_' || (g % 21) ELSE NULL END,
       jsonb_strip_nulls(jsonb_build_object('m1', CASE WHEN g % 5 <> 0 THEN round(3 + (g % 70) / 10.0, 1) END, 'm2', CASE WHEN g % 5 = 0 THEN round(3 + (g % 50) / 10.0, 1) END, 'm5', CASE WHEN g % 16 = 0 THEN 5.0 END))
FROM generate_series(1, 3000) g;
CREATE INDEX events_col ON events USING sift_col (id, tenant_id, category_id, event_date, created_at, status, value_num, counter_a, value_f, flag_a, label, metrics) WITH (paths = 'metrics.* float8');
CREATE VIEW v_keys AS SELECT t.type AS m, upper(e.status) AS k, e.value_num FROM events e JOIN tenants t ON t.id = e.tenant_id;
CREATE VIEW v_counts AS SELECT status, count(*) AS n FROM events GROUP BY 1;
VACUUM (FREEZE, ANALYZE) events, tenants, dim_a;
CREATE FUNCTION survey(q text) RETURNS TABLE (pushed bool, differences bigint, order_differs bool, why text) LANGUAGE plpgsql AS $$
DECLARE l text; off text[]; on_ text[];
BEGIN
	SET LOCAL sift.agg_force = on;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'CREATE TEMP TABLE r_off ON COMMIT DROP AS ' || q;
	SET LOCAL sift.enable_agg = on;
	EXECUTE 'CREATE TEMP TABLE r_on ON COMMIT DROP AS ' || q;
	SELECT count(*) INTO differences FROM ((TABLE r_off EXCEPT ALL TABLE r_on) UNION ALL (TABLE r_on EXCEPT ALL TABLE r_off)) d;
	order_differs := false;
	IF q ~ 'ORDER BY [^()]*$' THEN
		SET LOCAL sift.enable_agg = off;
		EXECUTE 'SELECT array_agg(t::text) FROM (' || q || ') t' INTO off;
		SET LOCAL sift.enable_agg = on;
		EXECUTE 'SELECT array_agg(t::text) FROM (' || q || ') t' INTO on_;
		order_differs := off IS DISTINCT FROM on_;
	END IF;
	pushed := false;
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP pushed := pushed OR l LIKE '%Custom Scan (SiftAgg)%' OR l LIKE '%Top-N:%'; END LOOP;
	IF NOT pushed THEN
		SELECT string_agg(DISTINCT w.slug, ',' ORDER BY w.slug) INTO why FROM sift.explain_why(q) w WHERE NOT w.used AND w.slug IS NOT NULL AND w.arm NOT LIKE 'L2:%';
	END IF;
	DROP TABLE r_off, r_on;
	RETURN NEXT;
END $$;
CREATE TABLE survey_q (n serial, slug text, family text, q text);
INSERT INTO survey_q (slug, family, q) VALUES
	('key_ordinal', 'group-key', $q$SELECT status, count(*) FROM events GROUP BY 1$q$),
	('key_alias', 'group-key', $q$SELECT status AS s, count(*) AS n FROM events GROUP BY s$q$),
	('key_alias_expr', 'group-key', $q$SELECT category_id % 5 AS b, count(*) FROM events GROUP BY b$q$),
	('key_two_ordinals', 'group-key', $q$SELECT status, category_id, count(*) FROM events GROUP BY 1, 2$q$),
	('key_date_trunc_ts', 'group-key', $q$SELECT date_trunc('month', created_at) AS m, count(*) FROM events GROUP BY 1$q$),
	('key_date_trunc_date', 'group-key', $q$SELECT date_trunc('week', event_date)::date AS w, count(*) FROM events GROUP BY 1$q$),
	('key_extract_year', 'group-key', $q$SELECT extract(year FROM event_date)::int AS y, count(*) FROM events GROUP BY 1$q$),
	('key_extract_dow_ts', 'group-key', $q$SELECT extract(dow FROM created_at)::int AS d, count(*) FROM events GROUP BY 1$q$),
	('key_to_char', 'group-key', $q$SELECT to_char(event_date, 'YYYY-MM') AS ym, count(*) FROM events GROUP BY 1$q$),
	('key_case', 'group-key', $q$SELECT CASE WHEN value_num < 100 THEN 'lo' WHEN value_num < 500 THEN 'mid' ELSE 'hi' END AS band, count(*) FROM events GROUP BY 1$q$),
	('key_case_two_cols', 'group-key', $q$SELECT CASE WHEN counter_a > 25 THEN status ELSE label END AS k, count(*) FROM events GROUP BY 1$q$),
	('key_coalesce', 'group-key', $q$SELECT coalesce(status, 'none') AS s, count(*) FROM events GROUP BY 1$q$),
	('key_arith', 'group-key', $q$SELECT counter_a / 10 AS d, count(*) FROM events GROUP BY 1$q$),
	('key_arith_two_cols', 'group-key', $q$SELECT (counter_a + category_id) % 7 AS d, count(*) FROM events GROUP BY 1$q$),
	('key_cast', 'group-key', $q$SELECT value_num::int AS a, count(*) FROM events GROUP BY 1$q$),
	('key_text_fn', 'group-key', $q$SELECT upper(left(label, 6)) AS n, count(*) FROM events GROUP BY 1$q$),
	('key_bool', 'group-key', $q$SELECT flag_a, count(*) FROM events GROUP BY 1$q$),
	('key_float', 'group-key', $q$SELECT round(value_f::numeric, 0) AS s, count(*) FROM events GROUP BY 1$q$),
	('key_jsonb_member', 'group-key', $q$SELECT (metrics ->> 'm1') IS NULL AS no_m1, count(*) FROM events GROUP BY 1$q$),
	('key_const_plus_col', 'group-key', $q$SELECT 'x'::text AS c, status, count(*) FROM events GROUP BY 1, 2$q$),
	('key_func_of_join_col', 'group-key', $q$SELECT upper(k.name) AS n, count(*) FROM events e JOIN dim_a k ON k.id = e.category_id GROUP BY 1$q$),
	('sets_grouping_sets_cols', 'sets', $q$SELECT status, category_id % 3 AS k, count(*) AS n FROM events GROUP BY GROUPING SETS ((status), (status, category_id % 3), ()) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_rollup_cols', 'sets', $q$SELECT status, flag_a, count(*) AS n, sum(counter_a) AS q FROM events GROUP BY ROLLUP (status, flag_a) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_cube_cols', 'sets', $q$SELECT status, flag_a, count(*) AS n FROM events GROUP BY CUBE (status, flag_a) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_grouping_fn', 'sets', $q$SELECT status, flag_a, GROUPING(status, flag_a) AS g, count(*) AS n FROM events GROUP BY CUBE (status, flag_a) ORDER BY 3, 1 NULLS FIRST, 2 NULLS FIRST$q$),
	('sets_rollup_expr_direct', 'sets', $q$SELECT date_trunc('month', created_at) AS m, status, count(*) AS n FROM events GROUP BY ROLLUP (1, 2) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_rollup_expr_subselect', 'sets', $q$SELECT m, count(*) AS n FROM (SELECT upper(status) AS m FROM events) p GROUP BY ROLLUP (m) ORDER BY 1 NULLS FIRST, 2$q$),
	('sets_having', 'sets', $q$SELECT status, count(*) AS n FROM events GROUP BY ROLLUP (status) HAVING count(*) > 100 ORDER BY 1 NULLS FIRST, 2$q$),
	('sets_cte', 'sets', $q$WITH p AS (SELECT upper(status) AS m, category_id % 4 AS k, value_num FROM events) SELECT m, k, count(*) AS n, sum(value_num) AS a FROM p GROUP BY GROUPING SETS ((m), (m, k)) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_cte_materialized', 'sets', $q$WITH p AS MATERIALIZED (SELECT upper(status) AS m, category_id % 4 AS k, value_num FROM events) SELECT m, k, count(*) AS n FROM p GROUP BY ROLLUP (m, k) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_join_dim_key', 'sets', $q$SELECT k.set_id, e.status, count(*) AS n FROM events e JOIN dim_a k ON k.id = e.category_id GROUP BY ROLLUP (k.set_id, e.status) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_lateral_each_key', 'sets', $q$SELECT m, count(*) AS n FROM events ev INNER JOIN LATERAL (SELECT split_part(r.key, '_', 1) AS m FROM jsonb_each(ev.metrics) r) c ON true GROUP BY GROUPING SETS ((m), ()) ORDER BY 1 NULLS FIRST, 2$q$),
	('agg_count_star', 'aggregate', $q$SELECT status, count(*) AS n FROM events GROUP BY 1$q$),
	('agg_count_col', 'aggregate', $q$SELECT status, count(value_num) AS n FROM events GROUP BY 1$q$),
	('agg_sum_avg_numeric', 'aggregate', $q$SELECT status, sum(value_num) AS s, avg(value_num) AS a FROM events GROUP BY 1$q$),
	('agg_sum_avg_int', 'aggregate', $q$SELECT status, sum(counter_a) AS s, avg(counter_a)::numeric(10,3) AS a FROM events GROUP BY 1$q$),
	('agg_sum_avg_float', 'aggregate', $q$SELECT status, round(sum(value_f)::numeric, 3) AS s, round(avg(value_f)::numeric, 3) AS a FROM events GROUP BY 1$q$),
	('agg_min_max', 'aggregate', $q$SELECT status, min(value_num) AS lo, max(value_num) AS hi, min(event_date) AS d0, max(created_at) AS t1, min(label) AS n0 FROM events GROUP BY 1$q$),
	('agg_bool_and_or', 'aggregate', $q$SELECT status, bool_and(flag_a) AS a, bool_or(flag_a) AS o FROM events GROUP BY 1$q$),
	('agg_every', 'aggregate', $q$SELECT status, every(counter_a > 0) AS e FROM events GROUP BY 1$q$),
	('agg_array_agg_ordered', 'aggregate', $q$SELECT status, array_agg(id ORDER BY id) FILTER (WHERE id < 30) AS ids FROM events GROUP BY 1$q$),
	('agg_string_agg', 'aggregate', $q$SELECT status, string_agg(DISTINCT label, ',' ORDER BY label) AS ns FROM events GROUP BY 1$q$),
	('agg_percentile_cont', 'aggregate', $q$SELECT status, percentile_cont(0.5) WITHIN GROUP (ORDER BY value_f) AS med FROM events GROUP BY 1$q$),
	('agg_percentile_disc', 'aggregate', $q$SELECT status, percentile_disc(0.9) WITHIN GROUP (ORDER BY counter_a) AS p90 FROM events GROUP BY 1$q$),
	('agg_mode', 'aggregate', $q$SELECT status, mode() WITHIN GROUP (ORDER BY category_id) AS m FROM events GROUP BY 1$q$),
	('agg_stddev', 'aggregate', $q$SELECT status, round(stddev_samp(value_f)::numeric, 6) AS sd, round(var_pop(counter_a)::numeric, 6) AS v FROM events GROUP BY 1$q$),
	('agg_corr', 'aggregate', $q$SELECT status, round(corr(value_f, value_num)::numeric, 6) AS c FROM events GROUP BY 1$q$),
	('agg_regr', 'aggregate', $q$SELECT status, round(regr_slope(value_num::float8, value_f)::numeric, 6) AS c FROM events GROUP BY 1$q$),
	('agg_jsonb_agg', 'aggregate', $q$SELECT status, jsonb_agg(id ORDER BY id) FILTER (WHERE id < 20) AS ids FROM events GROUP BY 1$q$),
	('agg_json_object_agg', 'aggregate', $q$SELECT status, count(*) FILTER (WHERE jsonb_typeof(metrics -> 'm1') = 'number') AS n FROM events GROUP BY 1$q$),
	('agg_sum_expr', 'aggregate', $q$SELECT status, sum(value_num * counter_a) AS s FROM events GROUP BY 1$q$),
	('agg_sum_expr_case', 'aggregate', $q$SELECT status, sum(CASE WHEN flag_a THEN value_num ELSE 0 END) AS s FROM events GROUP BY 1$q$),
	('agg_avg_expr_cast', 'aggregate', $q$SELECT status, avg(counter_a::numeric / 2) AS a FROM events GROUP BY 1$q$),
	('agg_count_distinct', 'aggregate', $q$SELECT status, count(DISTINCT tenant_id) AS n FROM events GROUP BY 1$q$),
	('agg_count_distinct_expr', 'aggregate', $q$SELECT status, count(DISTINCT category_id % 5) AS n FROM events GROUP BY 1$q$),
	('agg_count_distinct_two', 'aggregate', $q$SELECT status, count(DISTINCT (tenant_id, category_id)) AS n FROM events GROUP BY 1$q$),
	('agg_sum_distinct', 'aggregate', $q$SELECT status, sum(DISTINCT counter_a) AS s FROM events GROUP BY 1$q$),
	('agg_filter_count', 'aggregate', $q$SELECT status, count(*) FILTER (WHERE flag_a) AS n, count(*) FILTER (WHERE value_num > 500) AS big FROM events GROUP BY 1$q$),
	('agg_filter_sum', 'aggregate', $q$SELECT status, sum(value_num) FILTER (WHERE counter_a > 10) AS s FROM events GROUP BY 1$q$),
	('agg_filter_count_distinct', 'aggregate', $q$SELECT status, count(DISTINCT tenant_id) FILTER (WHERE flag_a) AS n FROM events GROUP BY 1$q$),
	('agg_no_group', 'aggregate', $q$SELECT count(*), sum(value_num), min(event_date), max(created_at) FROM events$q$),
	('agg_no_group_filter', 'aggregate', $q$SELECT count(*) FILTER (WHERE status = 'paid'), avg(counter_a) FILTER (WHERE flag_a) FROM events$q$),
	('agg_two_aggs_same_arg', 'aggregate', $q$SELECT status, min(counter_a) AS a, max(counter_a) AS b, sum(counter_a) AS c, count(counter_a) AS d FROM events GROUP BY 1$q$),
	('select_distinct', 'distinct', $q$SELECT DISTINCT status FROM events$q$),
	('select_distinct_two', 'distinct', $q$SELECT DISTINCT status, category_id FROM events$q$),
	('select_distinct_expr', 'distinct', $q$SELECT DISTINCT date_trunc('month', event_date) FROM events$q$),
	('distinct_on', 'distinct', $q$SELECT DISTINCT ON (tenant_id) tenant_id, id, created_at FROM events ORDER BY tenant_id, created_at DESC, id$q$),
	('distinct_on_where', 'distinct', $q$SELECT DISTINCT ON (tenant_id, category_id) tenant_id, category_id, id FROM events WHERE status = 'paid' ORDER BY tenant_id, category_id, id DESC$q$),
	('having_count', 'having', $q$SELECT status, count(*) AS n FROM events GROUP BY 1 HAVING count(*) > 40000$q$),
	('having_sum', 'having', $q$SELECT category_id, sum(value_num) AS s FROM events GROUP BY 1 HAVING sum(value_num) > 5000000$q$),
	('having_expr', 'having', $q$SELECT category_id, sum(value_num) AS s FROM events GROUP BY 1 HAVING sum(value_num) / count(*) > 400$q$),
