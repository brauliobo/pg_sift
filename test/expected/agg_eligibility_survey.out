	('where_is_null', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE status IS NULL GROUP BY 1$q$),
	('where_is_not_null', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE label IS NOT NULL GROUP BY 1$q$),
	('where_is_distinct_from', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE status IS DISTINCT FROM 'paid' GROUP BY 1$q$),
	('where_is_not_distinct_from', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE status IS NOT DISTINCT FROM 'paid' GROUP BY 1$q$),
	('where_like_prefix', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE label LIKE 'note_1%' GROUP BY 1$q$),
	('where_like_infix', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE label LIKE '%_1%' GROUP BY 1$q$),
	('where_ilike', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE label ILIKE 'NOTE_1%' GROUP BY 1$q$),
	('where_regex', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE label ~ '^note_1[0-9]$' GROUP BY 1$q$),
	('where_not_eq', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE status <> 'void' GROUP BY 1$q$),
	('where_not_in', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE status NOT IN ('void', 'late') GROUP BY 1$q$),
	('where_expr_col', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE value_num * counter_a > 5000 GROUP BY 1$q$),
	('where_two_cols_cmp', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE counter_a > category_id GROUP BY 1$q$),
	('where_func_col', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE lower(status) = 'paid' GROUP BY 1$q$),
	('where_extract', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE extract(year FROM event_date) = 2024 GROUP BY 1$q$),
	('where_date_trunc_eq', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE date_trunc('month', created_at) = '2024-05-01' GROUP BY 1$q$),
	('where_jsonb_exists', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE metrics ? 'm2' GROUP BY 1$q$),
	('where_jsonb_member_cmp', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE (metrics ->> 'm1')::float8 > 6 GROUP BY 1$q$),
	('where_jsonb_contains', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE metrics @> '{"m5": 5.0}' GROUP BY 1$q$),
	('where_bool_col', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE flag_a GROUP BY 1$q$),
	('where_not_bool_col', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE NOT flag_a GROUP BY 1$q$),
	('where_coalesce', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE coalesce(status, 'none') = 'none' GROUP BY 1$q$),
	('where_case', 'filter', $q$SELECT category_id, count(*) AS n FROM events WHERE CASE WHEN flag_a THEN counter_a > 10 ELSE counter_a < 5 END GROUP BY 1$q$),
	('join_inner_dim_group_dim', 'join', $q$SELECT k.name, count(*) AS n FROM events e JOIN dim_a k ON k.id = e.category_id GROUP BY 1$q$),
	('join_inner_dim_group_fact', 'join', $q$SELECT e.status, count(*) AS n FROM events e JOIN dim_a k ON k.id = e.category_id WHERE k.set_id = 2 GROUP BY 1$q$),
	('join_inner_dim_two', 'join', $q$SELECT k.set_id, t.type, count(*) AS n FROM events e JOIN dim_a k ON k.id = e.category_id JOIN tenants t ON t.id = e.tenant_id GROUP BY 1, 2$q$),
	('join_left_dim', 'join', $q$SELECT k.name, count(*) AS n FROM events e LEFT JOIN dim_a k ON k.id = e.category_id AND k.set_id = 1 GROUP BY 1$q$),
	('join_right_dim', 'join', $q$SELECT k.name, count(e.id) AS n FROM events e RIGHT JOIN dim_a k ON k.id = e.category_id GROUP BY 1$q$),
	('join_full_dim', 'join', $q$SELECT k.name, count(e.id) AS n FROM events e FULL JOIN dim_a k ON k.id = e.category_id GROUP BY 1$q$),
	('join_dim_agg_expr', 'join', $q$SELECT t.type, sum(e.value_num * k.set_id) AS s FROM events e JOIN dim_a k ON k.id = e.category_id JOIN tenants t ON t.id = e.tenant_id GROUP BY 1$q$),
	('join_dim_filter_in', 'join', $q$SELECT e.status, count(*) AS n FROM events e JOIN tenants t ON t.id = e.tenant_id WHERE t.region IN ('region1', 'region2') GROUP BY 1$q$),
	('join_using', 'join', $q$SELECT t.type, count(*) AS n FROM events e JOIN tenants t ON t.id = e.tenant_id GROUP BY 1$q$),
	('join_nonequi', 'join', $q$SELECT k.name, count(*) AS n FROM events e JOIN dim_a k ON k.id <= e.category_id AND k.set_id = 1 GROUP BY 1$q$),
	('join_self', 'join', $q$SELECT a.status, count(*) AS n FROM events a JOIN events b ON b.id = a.id + 1 GROUP BY 1$q$),
	('join_cross_small', 'join', $q$SELECT k.set_id, count(*) AS n FROM events e CROSS JOIN dim_a k WHERE k.id = e.category_id GROUP BY 1$q$),
	('join_semi_in', 'join', $q$SELECT status, count(*) AS n FROM events WHERE tenant_id IN (SELECT id FROM tenants WHERE type = 'type_b') GROUP BY 1$q$),
	('lateral_jsonb_each', 'lateral', $q$SELECT r.key, count(*) AS n FROM events ev, jsonb_each(ev.metrics) r GROUP BY 1$q$),
	('lateral_jsonb_each_value', 'lateral', $q$SELECT r.key, round(sum((r.value #>> '{}')::numeric), 3) AS s FROM events ev, jsonb_each(ev.metrics) r GROUP BY 1$q$),
	('lateral_subselect_limit1', 'lateral', $q$SELECT k.set_id, count(*) AS n FROM events e CROSS JOIN LATERAL (SELECT set_id FROM dim_a k WHERE k.id = e.category_id LIMIT 1) k GROUP BY 1$q$),
	('lateral_generate_series', 'lateral', $q$SELECT g, count(*) AS n FROM events e CROSS JOIN LATERAL generate_series(1, e.counter_a % 3) g GROUP BY 1$q$),
	('cte_plain', 'cte', $q$WITH p AS (SELECT status, value_num FROM events WHERE flag_a) SELECT status, sum(value_num) AS s FROM p GROUP BY 1$q$),
	('cte_materialized', 'cte', $q$WITH p AS MATERIALIZED (SELECT status, value_num FROM events WHERE flag_a) SELECT status, sum(value_num) AS s FROM p GROUP BY 1$q$),
	('cte_two_refs', 'cte', $q$WITH p AS (SELECT status, count(*) AS n FROM events GROUP BY 1) SELECT a.status, a.n, b.n AS n2 FROM p a JOIN p b ON a.status = b.status$q$),
	('cte_agg_then_agg', 'cte', $q$WITH p AS (SELECT tenant_id, sum(value_num) AS s FROM events GROUP BY 1) SELECT count(*), sum(s), max(s) FROM p$q$),
	('union_all_aggs', 'union', $q$SELECT 'a'::text AS src, status, count(*) AS n FROM events GROUP BY 2 UNION ALL SELECT 'b', status, sum(counter_a) FROM events WHERE flag_a GROUP BY 2$q$),
	('union_all_then_agg', 'union', $q$SELECT status, sum(n) AS n FROM (SELECT status, count(*) AS n FROM events GROUP BY 1 UNION ALL SELECT status, count(*) FROM events WHERE flag_a GROUP BY 1) u GROUP BY 1$q$),
	('union_all_rows_agg', 'union', $q$SELECT status, count(*) AS n FROM (SELECT status FROM events WHERE counter_a < 10 UNION ALL SELECT status FROM events WHERE counter_a > 40) u GROUP BY 1$q$),
	('rows_select_where_limit', 'rows', $q$SELECT id, status, value_num FROM events WHERE tenant_id = 7 ORDER BY id LIMIT 50$q$),
	('rows_point_lookup', 'rows', $q$SELECT id, status FROM events WHERE id = 12345$q$),
	('rows_count_where', 'rows', $q$SELECT count(*) FROM events WHERE status = 'paid' AND flag_a$q$),
	('rows_exists_scalar', 'rows', $q$SELECT EXISTS (SELECT 1 FROM events WHERE status = 'void' AND value_num > 999)$q$),
	('two_level_per_entity', 'two-level', $q$SELECT status, avg(n) AS a FROM (SELECT tenant_id, status, count(*) AS n FROM events GROUP BY 1, 2) t GROUP BY 1$q$),
	('key_at_time_zone', 'group-key', $q$SELECT (created_at AT TIME ZONE 'UTC')::date AS d, count(*) FROM events GROUP BY 1$q$),
	('key_ts_cast_date', 'group-key', $q$SELECT created_at::date AS d, count(*) FROM events GROUP BY 1$q$),
	('key_date_plus_int', 'group-key', $q$SELECT event_date + 7 AS d, count(*) FROM events GROUP BY 1$q$),
	('key_extract_epoch_div', 'group-key', $q$SELECT (extract(epoch FROM created_at) / 86400)::int / 30 AS b, count(*) FROM events GROUP BY 1$q$),
	('key_ntile_bucket', 'group-key', $q$SELECT width_bucket(value_num, 0, 1000, 10) AS b, count(*) FROM events GROUP BY 1$q$),
	('key_concat', 'group-key', $q$SELECT status || '/' || category_id AS k, count(*) FROM events GROUP BY 1$q$),
	('key_row_comparison', 'group-key', $q$SELECT (value_num > 500 AND counter_a > 25) AS big, count(*) FROM events GROUP BY 1$q$),
	('key_nullif', 'group-key', $q$SELECT nullif(status, 'void') AS s, count(*) FROM events GROUP BY 1$q$),
	('key_greatest', 'group-key', $q$SELECT greatest(counter_a, category_id) AS g, count(*) FROM events GROUP BY 1$q$),
	('key_subquery_scalar', 'group-key', $q$SELECT (SELECT t.type FROM tenants t WHERE t.id = e.tenant_id) AS ty, count(*) FROM events e GROUP BY 1$q$),
	('key_jsonb_member_text', 'group-key', $q$SELECT metrics ->> 'm1' AS m1, count(*) FROM events GROUP BY 1$q$),
	('key_jsonb_member_float', 'group-key', $q$SELECT (metrics ->> 'm1')::float8 AS m1, count(*) FROM events GROUP BY 1$q$),
	('key_jsonb_has_key', 'group-key', $q$SELECT metrics ? 'm2' AS has_m2, count(*) FROM events GROUP BY 1$q$),
	('key_jsonb_typeof', 'group-key', $q$SELECT jsonb_typeof(metrics -> 'm1') AS ty, count(*) FROM events GROUP BY 1$q$),
	('sets_grouping_sets_empty_only', 'sets', $q$SELECT count(*) AS n, sum(value_num) AS s FROM events GROUP BY GROUPING SETS (())$q$),
	('sets_rollup_date_parts', 'sets', $q$SELECT extract(year FROM event_date)::int AS y, extract(month FROM event_date)::int AS m, count(*) AS n FROM events GROUP BY ROLLUP (1, 2) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_cube_expr_filter', 'sets', $q$SELECT upper(status) AS s, category_id % 2 AS k, count(*) FILTER (WHERE flag_a) AS n, sum(value_num) AS a FROM events GROUP BY CUBE (1, 2) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3, 4$q$),
	('sets_rollup_count_distinct', 'sets', $q$SELECT status, count(DISTINCT tenant_id) AS n FROM events GROUP BY ROLLUP (status) ORDER BY 1 NULLS FIRST, 2$q$),
	('sets_rollup_subselect_join', 'sets', $q$SELECT p.region, p.k, count(*) AS n FROM (SELECT t.region, upper(e.status) AS k FROM events e JOIN tenants t ON t.id = e.tenant_id) p GROUP BY ROLLUP (p.region, p.k) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_rollup_view', 'sets', $q$SELECT m, k, count(*) AS n FROM v_keys GROUP BY ROLLUP (m, k) ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3$q$),
	('sets_rollup_order_limit', 'sets', $q$SELECT status, category_id % 3 AS k, count(*) AS n FROM events GROUP BY ROLLUP (1, 2) ORDER BY 3 DESC, 1 NULLS FIRST, 2 NULLS FIRST LIMIT 5$q$),
	('sets_union_all_rollup_arms', 'sets', $q$SELECT status, NULL::int AS k, count(*) AS n FROM events GROUP BY 1 UNION ALL SELECT status, category_id, count(*) FROM events GROUP BY 1, 2 UNION ALL SELECT NULL, NULL, count(*) FROM events$q$),
	('view_group', 'view', $q$SELECT m, count(*) AS n FROM v_keys GROUP BY 1$q$),
	('view_group_where', 'view', $q$SELECT k, count(*) AS n FROM v_keys WHERE m = 'type_a' GROUP BY 1$q$),
	('view_with_group_inside', 'view', $q$SELECT status, n FROM v_counts WHERE n > 100$q$),
	('agg_array_agg_distinct', 'aggregate', $q$SELECT status, array_agg(DISTINCT category_id) AS ks FROM events GROUP BY 1$q$),
	('agg_bit_and', 'aggregate', $q$SELECT status, bit_and(counter_a) AS b FROM events GROUP BY 1$q$),
	('agg_min_max_text', 'aggregate', $q$SELECT category_id, min(status) AS a, max(label) AS b FROM events GROUP BY 1$q$),
	('agg_sum_int8_cast', 'aggregate', $q$SELECT status, sum(counter_a::bigint * 1000000) AS s FROM events GROUP BY 1$q$),
	('agg_coalesce_sum', 'aggregate', $q$SELECT status, coalesce(sum(value_num), 0) AS s FROM events GROUP BY 1$q$),
	('agg_ratio_output', 'aggregate', $q$SELECT status, round(100.0 * count(*) / sum(count(*)) OVER (), 2) AS pct FROM events GROUP BY 1$q$),
	('agg_output_arith', 'aggregate', $q$SELECT status, sum(value_num) / NULLIF(count(*), 0) AS a, round(avg(counter_a), 2) AS q FROM events GROUP BY 1$q$),
	('agg_filter_in_rollup_all', 'aggregate', $q$SELECT category_id, count(*) FILTER (WHERE status = 'paid') AS paid, count(*) FILTER (WHERE status = 'void') AS v FROM events GROUP BY 1$q$),
	('agg_count_distinct_filter_key', 'aggregate', $q$SELECT category_id, count(DISTINCT tenant_id) AS n FROM events WHERE status = 'paid' GROUP BY 1$q$),
	('agg_count_distinct_text', 'aggregate', $q$SELECT category_id, count(DISTINCT label) AS n FROM events GROUP BY 1$q$),
	('agg_count_distinct_no_group', 'aggregate', $q$SELECT count(DISTINCT tenant_id) AS n FROM events$q$),
	('agg_count_distinct_id_notnull', 'aggregate', $q$SELECT status, count(DISTINCT id) AS n FROM events GROUP BY 1$q$),
	('agg_ordered_agg_in_call', 'aggregate', $q$SELECT tenant_id, (array_agg(status ORDER BY created_at DESC, id))[1] AS last_status FROM events GROUP BY 1$q$),
	('agg_first_by_min_ts', 'aggregate', $q$SELECT tenant_id, min(created_at) AS first_ts, max(created_at) AS last_ts FROM events GROUP BY 1$q$),
	('fetch_first', 'order-limit', $q$SELECT tenant_id, count(*) AS n FROM events GROUP BY 1 ORDER BY n DESC, tenant_id FETCH FIRST 5 ROWS ONLY$q$),
	('order_key_nulls_last_limit', 'order-limit', $q$SELECT label, count(*) AS n FROM events GROUP BY 1 ORDER BY label NULLS LAST LIMIT 7$q$),
	('order_by_agg_and_key_with_ties', 'order-limit', $q$SELECT category_id, status, count(*) AS n FROM events GROUP BY 1, 2 ORDER BY n DESC, category_id, status LIMIT 7$q$),
	('order_distinct_limit', 'order-limit', $q$SELECT DISTINCT category_id FROM events ORDER BY category_id DESC LIMIT 5$q$),
	('rows_order_limit_offset', 'order-limit', $q$SELECT id, created_at FROM events WHERE category_id = 3 ORDER BY created_at DESC, id LIMIT 10 OFFSET 40$q$),
	('rows_order_limit_join', 'order-limit', $q$SELECT e.id, t.type FROM events e JOIN tenants t ON t.id = e.tenant_id WHERE e.status = 'paid' ORDER BY e.created_at DESC, e.id LIMIT 10$q$),
	('rows_in_list_order_limit', 'order-limit', $q$SELECT id, created_at FROM events WHERE tenant_id IN (4, 8, 15) ORDER BY created_at DESC, id LIMIT 10$q$),
	('window_count_over_partition', 'window', $q$SELECT * FROM (SELECT id, tenant_id, count(*) OVER (PARTITION BY tenant_id) AS n FROM events WHERE category_id = 3) t WHERE n > 200 ORDER BY id LIMIT 10$q$),
	('window_rank_in_group', 'window', $q$SELECT * FROM (SELECT tenant_id, category_id, count(*) AS n, rank() OVER (PARTITION BY tenant_id ORDER BY count(*) DESC, category_id) AS r FROM events GROUP BY 1, 2) t WHERE r <= 2 ORDER BY 1, 2$q$),
	('window_pct_of_total', 'window', $q$SELECT category_id, count(*) AS n, count(*) * 1.0 / sum(count(*)) OVER () AS share FROM events GROUP BY 1$q$),
	('subselect_correlated_select_list', 'subquery', $q$SELECT t.id, (SELECT count(*) FROM events e WHERE e.tenant_id = t.id) AS n FROM tenants t WHERE t.id <= 20 ORDER BY 1$q$),
	('subselect_correlated_sum_select_list', 'subquery', $q$SELECT t.id, (SELECT sum(value_num) FROM events e WHERE e.tenant_id = t.id AND e.status = 'paid') AS s FROM tenants t WHERE t.id <= 20 ORDER BY 1$q$),
	('subselect_exists_select_list', 'subquery', $q$SELECT t.id, EXISTS (SELECT 1 FROM events e WHERE e.tenant_id = t.id AND e.status = 'void') AS has_void FROM tenants t WHERE t.id <= 20 ORDER BY 1$q$),
	('subselect_lateral_agg', 'subquery', $q$SELECT t.id, s.n, s.a FROM tenants t CROSS JOIN LATERAL (SELECT count(*) AS n, sum(value_num) AS a FROM events e WHERE e.tenant_id = t.id) s WHERE t.id <= 20 ORDER BY 1$q$),
	('subselect_lateral_agg_left', 'subquery', $q$SELECT t.id, s.n FROM tenants t LEFT JOIN LATERAL (SELECT count(*) AS n FROM events e WHERE e.tenant_id = t.id AND e.flag_a) s ON true WHERE t.id <= 20 ORDER BY 1$q$),
	('subselect_in_values', 'subquery', $q$SELECT status, count(*) AS n FROM events WHERE tenant_id IN (SELECT v FROM (VALUES (1), (5), (9)) q(v)) GROUP BY 1$q$),
	('subselect_any_subselect_array', 'subquery', $q$SELECT status, count(*) AS n FROM events WHERE tenant_id = ANY (SELECT id FROM tenants WHERE region = 'region2') GROUP BY 1$q$),
	('subselect_row_in', 'subquery', $q$SELECT status, count(*) AS n FROM events WHERE (tenant_id, category_id) IN ((1, 2), (3, 4), (5, 6)) GROUP BY 1$q$),
	('subselect_scalar_in_having', 'subquery', $q$SELECT category_id, count(*) AS n FROM events GROUP BY 1 HAVING count(*) > (SELECT count(*) / 40 FROM events)$q$),
	('subselect_join_agg_dim', 'subquery', $q$SELECT t.type, s.n FROM tenants t JOIN (SELECT tenant_id, count(*) AS n FROM events GROUP BY 1) s ON s.tenant_id = t.id ORDER BY 1, 2 LIMIT 10$q$),
	('join_spine_left', 'join', $q$SELECT d::date AS day, count(e.id) AS n FROM generate_series(date '2024-01-01', date '2024-01-31', interval '1 day') d LEFT JOIN events e ON e.event_date = d::date GROUP BY 1$q$),
	('join_values_list', 'join', $q$SELECT v.label, count(*) AS n FROM events e JOIN (VALUES (1, 'a'), (2, 'b'), (3, 'a')) v(id, label) ON v.id = e.category_id GROUP BY 1$q$),
	('join_agg_of_join_key_in_list', 'join', $q$SELECT t.region, count(*) AS n FROM events e JOIN tenants t ON t.id = e.tenant_id WHERE e.tenant_id IN (1, 2, 3, 4, 5, 6) GROUP BY 1$q$),
	('join_three_dims_chain', 'join', $q$SELECT t.region, k.set_id, e.status, count(*) AS n, sum(e.value_num) AS a FROM events e JOIN tenants t ON t.id = e.tenant_id JOIN dim_a k ON k.id = e.category_id GROUP BY 1, 2, 3$q$),
	('join_group_by_dim_pk_only', 'join', $q$SELECT t.id, count(*) AS n FROM events e JOIN tenants t ON t.id = e.tenant_id GROUP BY t.id$q$),
	('lateral_unnest_array_col', 'lateral', $q$SELECT x, count(*) AS n FROM events e CROSS JOIN LATERAL unnest(ARRAY[e.category_id, e.category_id + 1]) x GROUP BY 1$q$),
	('cte_two_aggs_joined', 'cte', $q$WITH a AS (SELECT tenant_id, count(*) AS n FROM events GROUP BY 1), b AS (SELECT tenant_id, sum(value_num) AS s FROM events GROUP BY 1) SELECT a.tenant_id, a.n, b.s FROM a JOIN b USING (tenant_id) ORDER BY 1 LIMIT 10$q$),
	('cte_filter_then_group', 'cte', $q$WITH recent AS (SELECT * FROM events WHERE event_date >= '2025-01-01') SELECT status, count(*) AS n FROM recent GROUP BY 1$q$),
	('cte_chain', 'cte', $q$WITH a AS (SELECT status, category_id, value_num FROM events WHERE flag_a), b AS (SELECT status, sum(value_num) AS s FROM a GROUP BY 1, category_id) SELECT status, max(s) FROM b GROUP BY 1$q$),
	('union_all_agg_arms_same_key', 'union', $q$SELECT 'all'::text AS bucket, count(*) AS n FROM events UNION ALL SELECT 'paid', count(*) FROM events WHERE status = 'paid' UNION ALL SELECT 'void', count(*) FROM events WHERE status = 'void'$q$),
	('union_distinct_arms', 'union', $q$SELECT status FROM events WHERE category_id = 1 UNION SELECT status FROM events WHERE category_id = 2$q$),
	('intersect_arms', 'union', $q$SELECT tenant_id FROM events WHERE category_id = 1 INTERSECT SELECT tenant_id FROM events WHERE category_id = 2$q$),
	('rows_only_columns', 'rows', $q$SELECT status, category_id FROM events WHERE tenant_id = 3 LIMIT 5$q$),
	('rows_only_keyword', 'rows', $q$SELECT status, count(*) FROM ONLY events GROUP BY 1$q$);
