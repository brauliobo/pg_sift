	('order_key_limit', 'order-limit', $q$SELECT category_id, count(*) AS n FROM events GROUP BY 1 ORDER BY category_id DESC LIMIT 5$q$),
	('order_expr_limit', 'order-limit', $q$SELECT date_trunc('month', event_date)::date AS m, count(*) AS n FROM events GROUP BY 1 ORDER BY 1 DESC LIMIT 6$q$),
	('order_agg_offset', 'order-limit', $q$SELECT tenant_id, count(*) AS n FROM events GROUP BY 1 ORDER BY n DESC, tenant_id LIMIT 5 OFFSET 5$q$),
