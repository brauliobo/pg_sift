 SELECT g, sum(n), avg(n), min(n), max(n), count(n) FROM agg_t GROUP BY g     | t      | t
 SELECT g, sum(w8), min(w8) FROM agg_t GROUP BY g                             | t      | t
 SELECT k, count(*), min(t), max(t) FROM agg_t GROUP BY k                     | t      | t
 SELECT sum(id), avg(f) FROM agg_t WHERE g IN (1, 3)                          | t      | t
(12 rows)

ROLLBACK;
SELECT * FROM agg_compare();
                                    query                                     | pushed | same 
------------------------------------------------------------------------------+--------+------
