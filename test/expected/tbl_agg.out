-- columns added with a default: the older segments give every row the constant
ALTER TABLE agg_t ADD COLUMN w int DEFAULT 5;
ALTER TABLE agg_t ADD COLUMN s text DEFAULT 'dflt';
INSERT INTO agg_t (id, g, k, w, s) SELECT 400000 + i, i % 7, 'w', i % 4, 's' || (i % 2) FROM generate_series(1, 2000) i;
INSERT INTO agg_q VALUES ('SELECT w, count(*) FROM agg_t GROUP BY w'), ('SELECT s, count(*), min(w) FROM agg_t GROUP BY s'),
	('SELECT count(*) FROM agg_t WHERE w = 5 AND s = ''dflt''');
