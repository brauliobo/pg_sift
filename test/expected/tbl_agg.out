 SELECT count(*), sum(n) FROM agg_t WHERE n > 10.5 AND n <> 20                | t      | t
 SELECT g, count(*), sum(id), min(f), max(f) FROM agg_t GROUP BY g            | t      | t
 SELECT g, k, count(*) FROM agg_t WHERE v > 3000 AND id % 3 = 0 GROUP BY g, k | t      | t
 SELECT g, sum(n), avg(n), min(n), max(n), count(n) FROM agg_t GROUP BY g     | t      | t
 SELECT g, sum(w8), min(w8) FROM agg_t GROUP BY g                             | f      | t
 SELECT k, count(*), min(t), max(t) FROM agg_t GROUP BY k                     | t      | t
 SELECT k, count(z), sum(z), min(z) FROM agg_t GROUP BY k                     | t      | t
 SELECT sum(id), avg(f) FROM agg_t WHERE g IN (1, 3)                          | t      | t
