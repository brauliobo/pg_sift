-- SiftAgg over a sift_table: the column groups through the engine, the delta rows as batches, the visibility of the table.
-- Every query runs with and without the pushdown; the results must be the same.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET cpu_tuple_cost = 0.5;
CREATE TABLE agg_t (id int, g int, k text, v bigint, f float8, t timestamptz, d date, b bool, n numeric(10,2), c text, ch char(6), w8 numeric) USING sift_table;
-- the rows of the query's result as text, in a fixed order, and whether the plan is a SiftAgg
CREATE FUNCTION agg_rows(q text, push bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('sift.enable_agg', push::text, true);
	EXECUTE format('SELECT string_agg(x::text, E''\n'' ORDER BY x::text) FROM (%s) x', q) INTO r;
	RETURN r;
END $$;
CREATE FUNCTION agg_pushed(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	PERFORM set_config('sift.enable_agg', 'on', true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%SiftAgg%' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
CREATE TABLE agg_q (q text);
INSERT INTO agg_q VALUES
	('SELECT count(*), count(c), count(f) FROM agg_t'),
	('SELECT g, count(*), sum(id), min(f), max(f) FROM agg_t GROUP BY g'),
	('SELECT k, count(*), min(t), max(t) FROM agg_t GROUP BY k'),
	('SELECT g, k, count(*) FROM agg_t WHERE v > 3000 AND id % 3 = 0 GROUP BY g, k'),
	('SELECT b, count(*), min(d), max(d) FROM agg_t GROUP BY b'),
	('SELECT count(*) FROM agg_t WHERE k = ''k1'' OR c IS NULL'),
	('SELECT sum(id), avg(f) FROM agg_t WHERE g IN (1, 3)'),
	('SELECT g, sum(n), avg(n), min(n), max(n), count(n) FROM agg_t GROUP BY g'),
	('SELECT count(*), sum(n) FROM agg_t WHERE n > 10.5 AND n <> 20'),
	('SELECT ch, count(*), sum(v) FROM agg_t GROUP BY ch'),
	('SELECT count(*), count(ch) FROM agg_t WHERE ch = ''c1'' OR ch = ''zz'''),
	('SELECT g, sum(w8), min(w8) FROM agg_t GROUP BY g');
CREATE FUNCTION agg_compare(OUT query text, OUT pushed bool, OUT same bool) RETURNS SETOF record LANGUAGE plpgsql AS $$
BEGIN
	FOR query IN SELECT q FROM agg_q ORDER BY q COLLATE "C" LOOP
		pushed := agg_pushed(query);
		same := agg_rows(query, true) IS NOT DISTINCT FROM agg_rows(query, false);
		RETURN NEXT;
	END LOOP;
END $$;
INSERT INTO agg_t SELECT i, i % 7, 'k' || (i % 5), i * 3, i / 4.0, '2024-01-01'::timestamptz + (i || ' min')::interval, '2024-01-01'::date + i % 90,
	i % 3 = 0, i / 3.0, CASE WHEN i % 10 = 0 THEN NULL ELSE repeat('x', i % 40) END,
	CASE WHEN i % 17 = 0 THEN NULL ELSE 'c' || (i % 4) END, i / 7.0 FROM generate_series(1, 20000) i;
ANALYZE agg_t;
-- rows in the delta segments
SELECT * FROM agg_compare();
                                    query                                     | pushed | same 
------------------------------------------------------------------------------+--------+------
 SELECT b, count(*), min(d), max(d) FROM agg_t GROUP BY b                     | t      | t
 SELECT ch, count(*), sum(v) FROM agg_t GROUP BY ch                           | f      | t
 SELECT count(*) FROM agg_t WHERE k = 'k1' OR c IS NULL                       | t      | t
 SELECT count(*), count(c), count(f) FROM agg_t                               | t      | t
 SELECT count(*), count(ch) FROM agg_t WHERE ch = 'c1' OR ch = 'zz'           | t      | t
 SELECT count(*), sum(n) FROM agg_t WHERE n > 10.5 AND n <> 20                | t      | t
 SELECT g, count(*), sum(id), min(f), max(f) FROM agg_t GROUP BY g            | t      | t
 SELECT g, k, count(*) FROM agg_t WHERE v > 3000 AND id % 3 = 0 GROUP BY g, k | t      | t
 SELECT g, sum(n), avg(n), min(n), max(n), count(n) FROM agg_t GROUP BY g     | t      | t
 SELECT g, sum(w8), min(w8) FROM agg_t GROUP BY g                             | f      | t
 SELECT k, count(*), min(t), max(t) FROM agg_t GROUP BY k                     | t      | t
 SELECT sum(id), avg(f) FROM agg_t WHERE g IN (1, 3)                          | t      | t
(12 rows)

SELECT count(*) > 0 AS has_delta FROM sift.table_segments('agg_t') WHERE kind = 'delta';
 has_delta 
-----------
 t
(1 row)

-- sealed into column groups
VACUUM agg_t;
SELECT count(*) = 0 AS no_delta_rows FROM sift.table_segments('agg_t') WHERE kind = 'delta' AND rows > 0;
 no_delta_rows 
---------------
 t
(1 row)

