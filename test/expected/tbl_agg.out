-- tombstones of committed deletes and updates, new versions in the write buffer
DELETE FROM agg_t WHERE id % 11 = 0;
UPDATE agg_t SET g = 3, v = v + 1, f = f + 0.5 WHERE id % 13 = 0;
SELECT * FROM agg_compare();
                                    query                                     | pushed | same 
------------------------------------------------------------------------------+--------+------
 SELECT b, count(*), min(d), max(d) FROM agg_t GROUP BY b                     | t      | t
 SELECT ch, count(*), sum(v) FROM agg_t GROUP BY ch                           | t      | t
 SELECT count(*) FROM agg_t WHERE k = 'k1' OR c IS NULL                       | t      | t
 SELECT count(*), count(c), count(f) FROM agg_t                               | t      | t
 SELECT count(*), count(ch) FROM agg_t WHERE ch = 'c1' OR ch = 'zz'           | t      | t
 SELECT count(*), sum(n) FROM agg_t WHERE n > 10.5 AND n <> 20                | t      | t
 SELECT g, count(*), sum(id), min(f), max(f) FROM agg_t GROUP BY g            | t      | t
 SELECT g, k, count(*) FROM agg_t WHERE v > 3000 AND id % 3 = 0 GROUP BY g, k | t      | t
 SELECT g, sum(n), avg(n), min(n), max(n), count(n) FROM agg_t GROUP BY g     | t      | t
 SELECT g, sum(w8), min(w8) FROM agg_t GROUP BY g                             | t      | t
 SELECT k, count(*), min(t), max(t) FROM agg_t GROUP BY k                     | t      | t
 SELECT sum(id), avg(f) FROM agg_t WHERE g IN (1, 3)                          | t      | t
(12 rows)

-- the transaction's own changes, and a rolled back one
BEGIN;
DELETE FROM agg_t WHERE id % 5 = 0;
INSERT INTO agg_t SELECT 100000 + i, i % 7, 'new', i, i, now(), current_date, true, i, 'n', 'zz', i FROM generate_series(1, 500) i;
SELECT * FROM agg_compare();
                                    query                                     | pushed | same 
------------------------------------------------------------------------------+--------+------
 SELECT b, count(*), min(d), max(d) FROM agg_t GROUP BY b                     | t      | t
 SELECT ch, count(*), sum(v) FROM agg_t GROUP BY ch                           | t      | t
 SELECT count(*) FROM agg_t WHERE k = 'k1' OR c IS NULL                       | t      | t
 SELECT count(*), count(c), count(f) FROM agg_t                               | t      | t
 SELECT count(*), count(ch) FROM agg_t WHERE ch = 'c1' OR ch = 'zz'           | t      | t
 SELECT count(*), sum(n) FROM agg_t WHERE n > 10.5 AND n <> 20                | t      | t
 SELECT g, count(*), sum(id), min(f), max(f) FROM agg_t GROUP BY g            | t      | t
