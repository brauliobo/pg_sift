-- order_layout: the layout of the order array of each column ('whole', 'compact', 'auto', or a list of columns for each), what CREATE INDEX says about it, and that merges and REINDEX keep to it. It never adds an array.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.test_col_gorder_ends = 64;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE t (id int, ts timestamp, c date, name text);
INSERT INTO t SELECT i, TIMESTAMP '2026-01-01' + (i * 7919 % 20011) * INTERVAL '1 minute', DATE '2026-01-01' + (i * 31 % 300), 'n' || i FROM generate_series(1, 20000) i;
CREATE TABLE o AS SELECT * FROM t;
-- the value is checked when it is set
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'sequence');
ERROR:  invalid order_layout option "sequence": the layout sequence is not built in this version
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'dense');
ERROR:  invalid order_layout option "dense": unknown layout "dense" (auto, whole or compact)
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact ts');
ERROR:  invalid order_layout option "compact ts": unknown layout "compact ts" (auto, whole or compact)
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact:');
ERROR:  invalid order_layout option "compact:": empty column list
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact: nope');
ERROR:  invalid order_layout option: unknown column
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact: name');
ERROR:  invalid order_layout option: unknown column
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact: ts; whole: ts');
ERROR:  invalid order_layout option: column "ts" is in two layouts
-- the layout of each segment and the bytes of each column, as CREATE INDEX says them
CREATE INDEX t_ix ON t USING sift_col (id, ts, c) WITH (order_columns = 'id, ts, c', order_array_columns = 'id, ts, c', order_layout = 'compact: ts, c; whole: id');
NOTICE:  sift_col index "t_ix": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 3 columns
DETAIL:  1.7 bytes a row for each column, 0.1 MB together; the segments are column format minor 41, which a library before 4.0 cannot read. ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit.
HINT:  Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "t_ix": order_layout: id: exact keys, 0.4 bytes a row; ts: rounded keys in 92.5% of 40 chunks, exact in the rest, 2.7 bytes a row; c: rounded keys in 92.5% of 40 chunks, exact in the rest, 2.2 bytes a row
DETAIL:  A compact chunk of an order array keeps the heap address of each row and its key rounded to a bucket of a few bits; the heap settles ties and gives the exact key of the rows a scan needs. The build keeps a chunk compact where that is at least a fifth smaller than keeping the exact keys and it has no run of 8 equal keys or more. The segments with a compact chunk are column format minor 41, which a library before 4.0 cannot read. c: 37 chunks have long runs of equal keys; order_layout = auto would keep exact keys there.
HINT:  To write exact keys only, run ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge; 'compact: column' and 'whole: column' choose it for a column.
SELECT format, rows FROM sift.col_segments('t_ix') WHERE kind = 'immutable';
 format | rows  
--------+-------
     41 | 20000
(1 row)

