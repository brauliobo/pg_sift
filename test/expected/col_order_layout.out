-- order_layout: the layout of the order array of each column ('whole', 'compact', 'auto', or a list of columns for each), what CREATE INDEX says about it, and that merges and REINDEX keep to it. It never adds an array.
CREATE EXTENSION pg_sift;
SET sift.test_col_gorder_ends = 64;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE t (id int, ts timestamp, c date, name text);
INSERT INTO t SELECT i, TIMESTAMP '2026-01-01' + (i * 7919 % 20011) * INTERVAL '1 minute', DATE '2026-01-01' + (i * 31 % 300), 'n' || i FROM generate_series(1, 20000) i;
CREATE TABLE o AS SELECT * FROM t;
-- the value is checked when it is set
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'sequence');
ERROR:  invalid order_layout option "sequence": the layout sequence is not built in this version
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'dense');
ERROR:  invalid order_layout option "dense": unknown layout "dense" (auto, whole or compact)
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact ts');
ERROR:  invalid order_layout option "compact ts": unknown layout "compact ts" (auto, whole or compact)
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact:');
ERROR:  invalid order_layout option "compact:": empty column list
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact: nope');
ERROR:  invalid order_layout option: unknown column
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact: name');
ERROR:  invalid order_layout option: unknown column
CREATE INDEX x ON t USING sift_col (id, ts) WITH (order_layout = 'compact: ts; whole: ts');
ERROR:  invalid order_layout option: column "ts" is in two layouts
-- the layout of each segment and the bytes of each column, as CREATE INDEX says them
CREATE INDEX t_ix ON t USING sift_col (id, ts, c) WITH (order_columns = 'id, ts, c', order_array_columns = 'id, ts, c', order_layout = 'compact: ts, c; whole: id');
NOTICE:  sift_col index "t_ix": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 3 columns
DETAIL:  1.7 bytes a row for each column, 0.1 MB together; the segments are column format minor 41, which a library before 3.8 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "t_ix": order_layout: id: whole, 0.4 bytes a row; ts: compact, 2.7 bytes a row; c: compact, 2.2 bytes a row
DETAIL:  A compact order keeps the heap address of every row and its key to within a bucket of a few bits, and reads the exact key of the rows it needs from the table; the segments that have one are column format minor 41, which a library before 3.8 cannot read. A whole order keeps every key.
HINT:  ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge, write the whole order again; 'compact: column' and 'whole: column' choose it for a column.
SELECT format, rows FROM sift.col_segments('t_ix') WHERE kind = 'immutable';
 format | rows  
--------+-------
     41 | 20000
(1 row)

-- the layout names every column, the array is only on ts: the option adds none
CREATE INDEX u_ix ON t USING sift_col (id, ts, c) WITH (order_columns = 'id, ts, c', order_array_columns = 'ts', order_layout = 'compact');
NOTICE:  sift_col index "u_ix": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  2.7 bytes a row for each column, 0.1 MB together; the segments are column format minor 41, which a library before 3.8 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "u_ix": order_layout: ts: compact, 2.7 bytes a row
DETAIL:  A compact order keeps the heap address of every row and its key to within a bucket of a few bits, and reads the exact key of the rows it needs from the table; the segments that have one are column format minor 41, which a library before 3.8 cannot read. A whole order keeps every key.
HINT:  ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge, write the whole order again; 'compact: column' and 'whole: column' choose it for a column.
SELECT format FROM sift.col_segments('u_ix') WHERE kind = 'immutable';
 format 
--------
     41
(1 row)

-- the whole order of the same columns, and the minor the notice names for each
CREATE INDEX w_ix ON t USING sift_col (id, ts, c) WITH (order_columns = 'id, ts, c', order_array_columns = 'ts', order_layout = 'whole');
NOTICE:  sift_col index "w_ix": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  2.3 bytes a row for each column, 0.0 MB together; the segments are column format minor 38, which a library before 3.7 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "w_ix": order_layout: ts: whole, 2.3 bytes a row
DETAIL:  A compact order keeps the heap address of every row and its key to within a bucket of a few bits, and reads the exact key of the rows it needs from the table; the segments that have one are column format minor 41, which a library before 3.8 cannot read. A whole order keeps every key.
HINT:  ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge, write the whole order again; 'compact: column' and 'whole: column' choose it for a column.
SELECT format FROM sift.col_segments('w_ix') WHERE kind = 'immutable';
 format 
--------
     38
(1 row)

SELECT sift.col_verify('t_ix'), sift.col_verify('u_ix'), sift.col_verify('w_ix');
 col_verify | col_verify | col_verify 
------------+------------+------------
            |            | 
(1 row)

-- keys that tie much (a date) cost less addressed as runs: the layout that is compact where it is smaller never costs more than either (the testing setting stands for the rule of 'auto' that may choose it)
CREATE TABLE d AS SELECT i AS id, DATE '2026-01-01' + (i * 31 % 40) AS day FROM generate_series(1, 20000) i;
CREATE INDEX d_whole ON d USING sift_col (id, day) WITH (order_columns = 'day', order_array_columns = 'day', order_layout = 'whole');
NOTICE:  sift_col index "d_whole": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  0.7 bytes a row for each column, 0.0 MB together; the segments are column format minor 38, which a library before 3.7 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "d_whole": order_layout: day: whole, 0.7 bytes a row
DETAIL:  A compact order keeps the heap address of every row and its key to within a bucket of a few bits, and reads the exact key of the rows it needs from the table; the segments that have one are column format minor 41, which a library before 3.8 cannot read. A whole order keeps every key.
HINT:  ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge, write the whole order again; 'compact: column' and 'whole: column' choose it for a column.
CREATE INDEX d_compact ON d USING sift_col (id, day) WITH (order_columns = 'day', order_array_columns = 'day', order_layout = 'compact');
NOTICE:  sift_col index "d_compact": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  2.1 bytes a row for each column, 0.0 MB together; the segments are column format minor 41, which a library before 3.8 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "d_compact": order_layout: day: compact, 2.1 bytes a row
DETAIL:  A compact order keeps the heap address of every row and its key to within a bucket of a few bits, and reads the exact key of the rows it needs from the table; the segments that have one are column format minor 41, which a library before 3.8 cannot read. A whole order keeps every key.
HINT:  ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge, write the whole order again; 'compact: column' and 'whole: column' choose it for a column.
SET sift.test_col_gorder_layout = 2;
CREATE INDEX d_smaller ON d USING sift_col (id, day) WITH (order_columns = 'day', order_array_columns = 'day');
NOTICE:  sift_col index "d_smaller": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  0.7 bytes a row for each column, 0.0 MB together; the segments are column format minor 38, which a library before 3.7 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
RESET sift.test_col_gorder_layout;
SELECT pg_relation_size('d_smaller') <= LEAST(pg_relation_size('d_whole'), pg_relation_size('d_compact')) AS smaller_is_least,
	   pg_relation_size('d_compact') > pg_relation_size('d_whole') AS compact_costs_more_on_ties;
 smaller_is_least | compact_costs_more_on_ties 
------------------+----------------------------
 t                | t
(1 row)

SELECT sift.col_verify('d_smaller');
 col_verify 
------------
 
(1 row)

DROP TABLE d;
-- and compact where the keys are many and spread (a timestamp to the microsecond)
SELECT setseed(0.42);
 setseed 
---------
 
(1 row)

CREATE TABLE e AS SELECT i AS id, TIMESTAMP '2026-01-01' + random() * 300 * INTERVAL '1 day' AS ts FROM generate_series(1, 20000) i;
SET sift.test_col_gorder_layout = 2;
CREATE INDEX e_smaller ON e USING sift_col (id, ts) WITH (order_columns = 'ts', order_array_columns = 'ts');
NOTICE:  sift_col index "e_smaller": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  3.0 bytes a row for each column, 0.1 MB together; the segments are column format minor 41, which a library before 3.8 cannot read.
HINT:  ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit. Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "e_smaller": order_layout: ts: compact, 3.0 bytes a row
DETAIL:  A compact order keeps the heap address of every row and its key to within a bucket of a few bits, and reads the exact key of the rows it needs from the table; the segments that have one are column format minor 41, which a library before 3.8 cannot read. A whole order keeps every key.
HINT:  ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge, write the whole order again; 'compact: column' and 'whole: column' choose it for a column.
RESET sift.test_col_gorder_layout;
SELECT format FROM sift.col_segments('e_smaller') WHERE kind = 'immutable';
