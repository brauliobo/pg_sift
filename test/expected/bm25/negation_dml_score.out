CREATE TABLE sd_ref AS SELECT id, sift.score(ctid)::float4 AS s FROM sd_ix WHERE body @@> 'wire OR cable' OFFSET 0;
SELECT count(*) AS reference_rows, count(DISTINCT s) AS distinct_scores, count(*) FILTER (WHERE s > (SELECT avg(s) FROM sd_ref)) AS above_the_mean FROM sd_ref;
