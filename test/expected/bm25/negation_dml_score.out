-- statements that change or lock the rows of a table without an index
UPDATE su SET s = sift.score(ctid) WHERE body @@> 'wire OR cable' AND sift.score(ctid) > (SELECT avg(s) FROM sd_ref);
SELECT count(*) AS updated, count(*) FILTER (WHERE su.s = r.s) AS same_score FROM su JOIN sd_ref r USING (id) WHERE su.s > 0;
 updated | same_score 
---------+------------
      57 |         57
(1 row)

DELETE FROM su WHERE body @@> 'wire OR cable' AND sift.score(ctid) <= (SELECT avg(s) FROM sd_ref);
SELECT count(*) AS left_rows, count(*) FILTER (WHERE su.s IS NULL) AS not_updated FROM su;
 left_rows | not_updated 
-----------+-------------
       286 |         229
(1 row)

SELECT id FROM su WHERE body @@> 'wire OR cable' AND sift.score(ctid) > 0 ORDER BY id LIMIT 2 FOR UPDATE;
 id 
----
  7
 14
(2 rows)

-- under row-level security the corpus is the rows the role sees
CREATE ROLE sift_t_nd_user;
GRANT USAGE ON SCHEMA sift TO sift_t_nd_user;
CREATE TABLE sr (id int, tenant text, body text);
INSERT INTO sr SELECT id, CASE WHEN id % 2 = 0 THEN 'sift_t_nd_user' ELSE 'other' END, body FROM sd_src;
CREATE TABLE sr_own AS SELECT id, body FROM sr WHERE tenant = 'sift_t_nd_user';
ALTER TABLE sr ENABLE ROW LEVEL SECURITY;
CREATE POLICY sr_own ON sr USING (tenant = current_user);
GRANT SELECT ON sr, sr_own TO sift_t_nd_user;
SET ROLE sift_t_nd_user;
SELECT count(*) AS visible_matches,
	bool_and(abs(a.s - b.s) < 1e-6) AS the_scores_of_the_rows_it_sees
	FROM (SELECT id, sift.score(ctid) AS s FROM sr WHERE body @@> 'wire OR cable') a
	JOIN (SELECT id, sift.score(ctid) AS s FROM sr_own WHERE body @@> 'wire OR cable') b USING (id);
 visible_matches | the_scores_of_the_rows_it_sees 
-----------------+--------------------------------
              85 | t
(1 row)

SELECT count(*) AS visible, max(sift.max_score(ctid)) = (SELECT max(sift.score(ctid)) FROM sr_own WHERE body @@> 'wire OR cable') AS max_of_visible
	FROM sr WHERE body @@> 'wire OR cable';
 visible | max_of_visible 
---------+----------------
      85 | t
(1 row)

RESET ROLE;
-- a partitioned table whose partitions have no index
CREATE TABLE sp (id int, body text) PARTITION BY RANGE (id);
CREATE TABLE sp1 PARTITION OF sp FOR VALUES FROM (0) TO (200);
CREATE TABLE sp2 PARTITION OF sp FOR VALUES FROM (200) TO (1000);
INSERT INTO sp SELECT id, body FROM sd_src;
SELECT count(*) AS matches, count(*) FILTER (WHERE s > 0) AS scored FROM (SELECT sift.score(ctid) AS s FROM sp WHERE body @@> 'wire OR cable') q;
 matches | scored 
---------+--------
     171 |    171
(1 row)

SELECT count(*) = (SELECT count(*) FROM sp1 WHERE body @@> 'cable') AS the_rows_of_the_partition, bool_and(a.s = b.s) AS a_partition_as_alone
	FROM (SELECT id, sift.score(ctid) AS s FROM sp WHERE body @@> 'cable' AND tableoid = 'sp1'::regclass) a
	JOIN (SELECT id, sift.score(ctid) AS s FROM sp1 WHERE body @@> 'cable') b USING (id);
 the_rows_of_the_partition | a_partition_as_alone 
---------------------------+----------------------
 t                         | t
(1 row)

DROP TABLE sp, sr, sr_own, su, sd_ix, sd_u1, sd_u2, sd_u3, sd_d, sd_m, sd_src, sd_ref, sd_tgt;
DROP OWNED BY sift_t_nd_user;
DROP ROLE sift_t_nd_user;
DROP FUNCTION su_same(text), sd_copy(text, boolean), nd_err(text), nd_plan(text);
DROP EXTENSION pg_sift;
