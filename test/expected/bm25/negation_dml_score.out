-- A query that is only a NOT, the limits on a query's size, and sift.score() in the statements that change or lock rows and on a table no sift
-- index serves. NOT x matches every row with a text that x does not: through the count, the unordered scan, the ranked scan and the sequential
-- evaluation alike, across the write buffer, deletes, VACUUM and a merge. A score is the one the index gives: the statements read it from the
-- scan that matched the row, and a scan of the heap computes it from the rows that pass the security quals.
CREATE EXTENSION pg_sift;
\set VERBOSITY terse
CREATE FUNCTION nd_plan(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	l text;
	r text := '';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		r := r || l || E'\n';
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION nd_err(q text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE q;
	RETURN 'ok';
EXCEPTION WHEN OTHERS THEN
	RETURN SQLSTATE || ' ' || SQLERRM;
END $$;
-- the ids a query returns: sequentially ('seq'), by a scan without an order ('scan'), by the ranked scan ('rank')
CREATE FUNCTION nd_ids(q text, how text) RETURNS int[] LANGUAGE plpgsql AS $$
DECLARE
	r int[];
BEGIN
	PERFORM set_config('sift.enable_scan', CASE how WHEN 'seq' THEN 'off' ELSE 'on' END, true);
	PERFORM set_config('enable_seqscan', CASE how WHEN 'seq' THEN 'on' ELSE 'off' END, true);
	PERFORM set_config('enable_bitmapscan', CASE how WHEN 'seq' THEN 'off' ELSE 'on' END, true);
	PERFORM set_config('enable_indexscan', CASE how WHEN 'seq' THEN 'off' ELSE 'on' END, true);
	EXECUTE format(CASE how WHEN 'rank' THEN 'SELECT array_agg(id ORDER BY id) FROM (SELECT id FROM nd_docs WHERE body @@> %L ORDER BY sift.score(ctid) DESC) x'
						ELSE 'SELECT array_agg(id ORDER BY id) FROM nd_docs WHERE body @@> %L' END, q) INTO r;
	RETURN coalesce(r, '{}');
END $$;
CREATE FUNCTION nd_count(q text) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE
	n bigint;
BEGIN
	EXECUTE 'SELECT count(*) FROM nd_docs WHERE body @@> $1' INTO n USING q;
	RETURN n;
END $$;
-- the query's matches, by every path, against the rows a predicate written with the positive operator keeps
CREATE FUNCTION nd_check(q text, ref text, OUT matches int, OUT scan boolean, OUT rank boolean, OUT counted boolean, OUT reference boolean)
LANGUAGE plpgsql AS $$
DECLARE
	r int[];
BEGIN
	PERFORM set_config('sift.enable_scan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	EXECUTE 'SELECT coalesce(array_agg(id ORDER BY id), ''{}'') FROM nd_docs WHERE ' || ref INTO r;
	matches := cardinality(nd_ids(q, 'seq'));
	scan := nd_ids(q, 'seq') = nd_ids(q, 'scan');
	rank := nd_ids(q, 'seq') = nd_ids(q, 'rank');
	counted := nd_count(q) = matches;
	reference := nd_ids(q, 'seq') = r;
END $$;
CREATE TABLE nd_docs (id int PRIMARY KEY, body text);
INSERT INTO nd_docs SELECT i, CASE WHEN i % 17 = 0 THEN NULL WHEN i % 13 = 0 THEN '' WHEN i % 11 = 0 THEN 'the'
	ELSE concat_ws(' ', CASE WHEN i % 3 = 0 THEN 'wire' END, CASE WHEN i % 5 = 0 THEN 'fraud' END, CASE WHEN i % 7 = 0 THEN 'cable' END, 'doc' || i % 9) END
	FROM generate_series(1, 3000) i;
CREATE INDEX nd_docs_body ON nd_docs USING sift (body);
VACUUM ANALYZE nd_docs;
CREATE FUNCTION nd_report() RETURNS TABLE (q text, matches int, scan boolean, rank boolean, counted boolean, reference boolean) LANGUAGE sql AS $$
	SELECT v.q, c.* FROM (VALUES
		('NOT wire', 'body IS NOT NULL AND NOT (body @@> ''wire'')'),
		('NOT (wire OR fraud)', 'body IS NOT NULL AND NOT (body @@> ''wire OR fraud'')'),
		('NOT wire NOT fraud', 'body IS NOT NULL AND NOT (body @@> ''wire OR fraud'')'),
		('NOT (wire fraud)', 'body IS NOT NULL AND NOT (body @@> ''wire fraud'')'),
		('NOT "wire fraud"', 'body IS NOT NULL AND NOT (body @@> ''"wire fraud"'')'),
		('NOT wire*', 'body IS NOT NULL AND NOT (body @@> ''wire*'')'),
		('NOT the', 'body IS NOT NULL AND NOT (body @@> ''the'')'),
		('NOT (NOT wire)', 'body @@> ''wire'''),
		('wire OR NOT fraud', 'body IS NOT NULL AND (body @@> ''wire'' OR NOT (body @@> ''fraud''))'),
		('cable AND NOT (wire OR NOT fraud)', 'body @@> ''cable'' AND NOT (body @@> ''wire'' OR NOT (body @@> ''fraud''))'))
		v(q, ref), LATERAL nd_check(v.q, v.ref) c
$$;
