CREATE FUNCTION su_same(q text) RETURNS TABLE (matches bigint, same_rows boolean, same_scores boolean, max_difference float4) LANGUAGE plpgsql AS $$
BEGIN
	RETURN QUERY EXECUTE format('SELECT count(*), bool_and(a.id IS NOT NULL AND b.id IS NOT NULL), bool_and(a.s = b.s), max(abs(a.s - b.s))::float4
		FROM (SELECT id, sift.score(ctid) AS s FROM su WHERE body @@> %1$L) a FULL JOIN (SELECT id, sift.score(ctid) AS s FROM sd_ix WHERE body @@> %1$L) b USING (id)', q);
END $$;
