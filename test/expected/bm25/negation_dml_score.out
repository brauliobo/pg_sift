-- 3. sift.score() in the statements that change or lock the rows it reads. A score depends on the statistics of the index, which count the
-- versions a statement leaves until VACUUM, so every statement runs on a fresh copy of the same rows and is compared with the scores of the
-- untouched one
CREATE TABLE sd_src (id int PRIMARY KEY, body text, s float4, t text);
INSERT INTO sd_src SELECT i, concat_ws(' ', CASE WHEN i % 3 = 0 THEN 'wire' END, CASE WHEN i % 5 = 0 THEN 'fraud' END, CASE WHEN i % 7 = 0 THEN repeat('cable ', 1 + i % 3) END, 'doc' || i % 9), NULL, NULL
	FROM generate_series(1, 400) i;
CREATE FUNCTION sd_copy(tbl text, indexed boolean) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE format('CREATE TABLE %I (LIKE sd_src INCLUDING ALL)', tbl);
	EXECUTE format('INSERT INTO %I SELECT * FROM sd_src', tbl);
	IF indexed THEN
		EXECUTE format('CREATE INDEX ON %I USING sift (body)', tbl);
	END IF;
	EXECUTE format('ANALYZE %I', tbl);
END $$;
SELECT sd_copy('sd_ix', true);
 sd_copy 
---------
 
