-- A LATERAL unnest of a sift_table whose WHERE holds a hashed sub-plan (x NOT IN (SELECT ..)): the rows the scan reads again from the heap are tested with the
-- clauses of the WHERE under the node, which owns the sub-plan. The answers are compared with the aggregate scan off and on, on both formats.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
\ir test/common/sql/agg/base.sql
\set ECHO none
\ir test/common/sql/agg/same.sql
\set ECHO none
CREATE TABLE gone (id int, grp int);
INSERT INTO gone SELECT i * 3, i % 9 FROM generate_series(1, 200) i;
SET sift.test_create_format1 = off;
CREATE TABLE ev2 (id int, doc jsonb) USING sift_table;
SET sift.test_create_format1 = on;
CREATE TABLE ev1 (id int, doc jsonb) USING sift_table;
RESET sift.test_create_format1;
SELECT sift.table_set_paths(t, 'doc', 'doc->parts[]->cat text, doc->parts[]->score float8') FROM unnest(ARRAY['ev2', 'ev1']::regclass[]) t;
 table_set_paths 
-----------------
 
 
(2 rows)

INSERT INTO ev2 SELECT i, jsonb_build_object('parts', (SELECT coalesce(jsonb_agg(jsonb_build_object('cat', 'cat_' || (i + j) % 4, 'score', j)), '[]') FROM generate_series(1, i % 4) j))
FROM generate_series(1, 3000) i;
INSERT INTO ev1 SELECT * FROM ev2;
ANALYZE gone, ev2, ev1;
CREATE FUNCTION q(t regclass, lat text) RETURNS text LANGUAGE sql AS $$
	SELECT format('SELECT count(s.id), sum(s.n), avg(s.sc) FROM (SELECT e.id, count(*) AS n, avg((o ->> %L)::float8) AS sc FROM %s e %s LATERAL jsonb_array_elements(e.doc -> %L) o ON true '
				  'WHERE e.id NOT IN (SELECT id FROM gone WHERE grp < 5) GROUP BY e.id) s', 'score', t, lat, 'parts') $$;
SELECT t, lat, same(q(t, lat)), (SELECT bool_or(used) FROM sift.explain_why(q(t, lat))) AS pushed
FROM unnest(ARRAY['ev2', 'ev1']::regclass[]) t, unnest(ARRAY['JOIN', 'LEFT JOIN']) lat ORDER BY 1, 2;
  t  |    lat    | same | pushed 
-----+-----------+------+--------
 ev2 | JOIN      | same | t
 ev2 | LEFT JOIN | same | t
 ev1 | JOIN      | same | f
 ev1 | LEFT JOIN | same | f
(4 rows)

DROP TABLE gone, ev2, ev1;
DROP FUNCTION q(regclass, text), same(text), runq(text, bool), pushed(text), outcome(text, bool), runs_in_scan(text);
DROP EXTENSION pg_sift;
