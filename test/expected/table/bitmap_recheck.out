-- A bitmap heap scan of a sift_table (both formats) whose bitmap goes lossy (work_mem of 64kB) rechecks every row of a page it returns, not only the first: the rows of the
-- vblocks are those of the qual, as the heap's are, through SELECT, UPDATE and DELETE.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE brc_h (id int PRIMARY KEY, tag int, v int);
CREATE TABLE brc_f2 (id int PRIMARY KEY, tag int, v int) USING sift_table WITH (autovacuum_enabled = false);
SET sift.test_create_format1 = on;
CREATE TABLE brc_f1 (id int PRIMARY KEY, tag int, v int) USING sift_table WITH (autovacuum_enabled = false);
RESET sift.test_create_format1;
-- 300000 rows: about 1000 vblocks match, more than the bitmap of 64kB (the least work_mem) holds exactly, so half its pages go lossy
INSERT INTO brc_h SELECT g, g % 7, g FROM generate_series(1, 300000) g;
INSERT INTO brc_f2 SELECT * FROM brc_h;
INSERT INTO brc_f1 SELECT * FROM brc_h;
CREATE INDEX ON brc_h (tag);
CREATE INDEX ON brc_f2 (tag);
CREATE INDEX ON brc_f1 (tag);
ANALYZE brc_h, brc_f2, brc_f1;
SET enable_seqscan = off;
SET enable_indexscan = off;
SET enable_indexonlyscan = off;
SET sift.enable_agg = off;
SET work_mem = '64kB';
CREATE FUNCTION brc_lossy(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) ' || q LOOP
		IF l ~ 'Heap Blocks:.*lossy=[1-9]' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
SELECT t, brc_lossy(format('SELECT * FROM %I WHERE tag = 3', t)) AS lossy FROM unnest(ARRAY['brc_f2', 'brc_f1']) t;
   t    | lossy 
--------+-------
 brc_f2 | t
 brc_f1 | t
(2 rows)

SELECT 'f2' AS t, count(*), count(*) FILTER (WHERE tag <> 3) AS wrong, sum(v) FROM brc_f2 WHERE tag = 3
UNION ALL SELECT 'f1', count(*), count(*) FILTER (WHERE tag <> 3), sum(v) FROM brc_f1 WHERE tag = 3
UNION ALL SELECT 'heap', count(*), count(*) FILTER (WHERE tag <> 3), sum(v) FROM brc_h WHERE tag = 3;
  t   | count | wrong |    sum     
------+-------+-------+------------
 f2   | 42857 |     0 | 6428507143
 f1   | 42857 |     0 | 6428507143
 heap | 42857 |     0 | 6428507143
(3 rows)

UPDATE brc_f2 SET v = -v WHERE tag = 3;
UPDATE brc_f1 SET v = -v WHERE tag = 3;
DELETE FROM brc_f2 WHERE tag = 5;
DELETE FROM brc_f1 WHERE tag = 5;
RESET work_mem;
RESET enable_seqscan;
RESET enable_indexscan;
SELECT 'f2' AS t, count(*) FILTER (WHERE v < 0) AS negated, count(*) FILTER (WHERE v < 0 AND tag <> 3) AS wrong, count(*) FILTER (WHERE tag = 5) AS left5 FROM brc_f2
UNION ALL SELECT 'f1', count(*) FILTER (WHERE v < 0), count(*) FILTER (WHERE v < 0 AND tag <> 3), count(*) FILTER (WHERE tag = 5) FROM brc_f1;
 t  | negated | wrong | left5 
----+---------+-------+-------
 f2 |   42857 |     0 |     0
 f1 |   42857 |     0 |     0
(2 rows)

DROP TABLE brc_h, brc_f2, brc_f1;
DROP FUNCTION brc_lossy(text);
DROP EXTENSION pg_sift;
