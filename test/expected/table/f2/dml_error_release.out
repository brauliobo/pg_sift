-- An error in the middle of a write to a sift_table (here a statement timeout while the write waits at a gate a prepared transaction holds) leaves nothing in the contexts the
-- table keeps for the session: the detoasted values and the elements of declared paths of the rows it was packing are released, so a session that fails its writes keeps no memory.
-- A COPY releases the values of each pack of its rows once the pack is staged, not every 1024 rows: a call of 1000 wide rows never holds them all.
CREATE EXTENSION pg_sift;
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
SET client_min_messages = warning;
\set VERBOSITY terse
CREATE TABLE der_src (id int, body text);
ALTER TABLE der_src ALTER COLUMN body SET STORAGE EXTERNAL;
INSERT INTO der_src SELECT 1, string_agg(md5(k::text), '') FROM generate_series(1, 64 * 1024) k;
CREATE TABLE der (id int, body text, doc jsonb) USING sift_table;
SELECT sift.table_set_paths('der', 'doc', 'doc->a int4, doc->l[] int4') IS NOT NULL AS paths_set;
 paths_set 
-----------
 t
(1 row)

CREATE FUNCTION der_kept(ctx text) RETURNS bool LANGUAGE sql AS $$
	SELECT count(*) > 0 AND sum(total_bytes) < 64 * 1024 FROM pg_backend_memory_contexts WHERE name = ctx
$$;
SET sift.test_phase_gate = 7000;
BEGIN;
SELECT pg_advisory_xact_lock(7000 + 10), pg_advisory_xact_lock(7000 + 17);
 pg_advisory_xact_lock | pg_advisory_xact_lock 
-----------------------+-----------------------
                       | 
(1 row)

PREPARE TRANSACTION 'der_gate';
-- a row of 4 MB detoasted to be staged, whose flush waits for the manifest
SET work_mem = '64kB';
SET statement_timeout = '300ms';
INSERT INTO der SELECT id, body FROM der_src;
ERROR:  canceling statement due to statement timeout
RESET statement_timeout;
RESET work_mem;
SELECT der_kept('sift cache f2 row') AS row_released;
 row_released 
--------------
 t
(1 row)

-- a COPY whose first pack of rows waits after it is staged
SET statement_timeout = '300ms';
COPY der FROM PROGRAM 'seq 1 200 | awk ''{ printf "%d\tb\t{\"a\": %d, \"l\": [", $1, $1; for (i = 0; i < 400; i++) printf "0,"; printf "0]}\n" }''';
ERROR:  canceling statement due to statement timeout
RESET statement_timeout;
SELECT der_kept('sift cache bulk insert batch') AS batch_released;
 batch_released 
----------------
 t
(1 row)

ROLLBACK PREPARED 'der_gate';
RESET sift.test_phase_gate;
-- the rows of a COPY that went through
COPY der FROM PROGRAM 'seq 1 200 | awk ''{ printf "%d\tb\t{\"a\": %d, \"l\": [", $1, $1; for (i = 0; i < 400; i++) printf "0,"; printf "0]}\n" }''';
SELECT count(*), sum((doc->>'a')::int), sum(jsonb_array_length(doc->'l')) FROM der;
 count |  sum  |  sum  
-------+-------+-------
   200 | 20100 | 80200
(1 row)

SELECT der_kept('sift cache bulk insert batch') AS batch_released;
 batch_released 
----------------
 t
(1 row)

DROP TABLE der, der_src;
DROP FUNCTION der_kept(text);
DROP EXTENSION pg_sift;
