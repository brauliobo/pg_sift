 same node SELECT jsonb_typeof(body->'m') AS ty, count(*) FROM T GROUP BY 1
(3 rows)

DROP FUNCTION same(text, text, text), doc_of(int);
DROP TABLE tp, hp, tq, hq;
DROP EXTENSION pg_sift;
