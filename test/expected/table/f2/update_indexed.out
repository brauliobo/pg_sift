-- sift_table: an UPDATE of the indexed column of every row, with work_mem 1MB and maintenance_work_mem 4MB, rewrites the rows and their btree entries (the stage is written
-- more than once inside the statement, and each row is fetched again after a write). About 3 s. Run on a build where new tables take Format 2.0.
CREATE EXTENSION IF NOT EXISTS pg_sift CASCADE;
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE ti (id bigint, indexed_col bigint, txt text, payload text) USING sift_table;
INSERT INTO ti SELECT g, g, 'k' || ((g * 2654435761) & 1048575) || '_' || repeat('abcdefgh', 7), repeat('seg=00|pad=0123456789abcdef|', 8)
-- 65536 rows: the statement writes its stage several times at work_mem 1MB, which is when the old row is read from a part the same statement wrote
FROM generate_series(1, 65536) g;
CREATE INDEX ti_idx ON ti (indexed_col);
\c -
SET work_mem = '1MB';
SET maintenance_work_mem = '4MB';
UPDATE ti SET indexed_col = indexed_col + 1;
SELECT count(*) AS rows, sum(indexed_col - id) AS shifted, (SELECT count(*) FROM sift.check('ti'::regclass)) AS bad FROM ti;
 rows  | shifted | bad 
-------+---------+-----
 65536 |   65536 |   0
(1 row)

SET enable_seqscan = off;
SELECT count(*) AS by_index FROM ti WHERE indexed_col BETWEEN 2 AND 65537;
 by_index 
----------
    65536
(1 row)

DROP TABLE ti;
DROP EXTENSION pg_sift;
