-- sift.health reports table_options_unapplied for a sift_table whose parts were written before the sort key or the declared paths it has now (a restore loads the rows before the options):
-- the options apply to new writes at once and to the parts as they are rewritten. VACUUM FULL writes them again, and the report goes.
-- requires: build col
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET sift.async_maintenance = off;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE ou (id int, g int) USING sift_table;
CREATE TABLE ou_plain (id int, g int) USING sift_table;
CREATE TABLE ou_doc (id int, doc jsonb) USING sift_table;
INSERT INTO ou SELECT i, i % 7 FROM generate_series(1, 2000) i;
INSERT INTO ou_plain SELECT i, i % 7 FROM generate_series(1, 2000) i;
INSERT INTO ou_doc SELECT i, jsonb_build_object('k', i) FROM generate_series(1, 2000) i;
VACUUM ou, ou_plain, ou_doc;
SELECT sift.table_set_option('ou', 'key_order', 'g, id');
 table_set_option 
------------------
 
(1 row)

SELECT sift.table_set_paths('ou_doc', 'doc', 'doc.k int4');
 table_set_paths 
-----------------
 
(1 row)

SELECT relation, severity, check_name, action_sql FROM sift.health() WHERE check_name = 'table_options_unapplied' ORDER BY relation::text;
 relation | severity |       check_name        |         action_sql         
----------+----------+-------------------------+----------------------------
 ou       | warn     | table_options_unapplied | VACUUM FULL public.ou;
 ou_doc   | warn     | table_options_unapplied | VACUUM FULL public.ou_doc;
(2 rows)

SELECT count(*) AS reported FROM sift.health('ou_plain') WHERE check_name = 'table_options_unapplied';
 reported 
----------
        0
(1 row)

SELECT count(*) AS reported FROM sift.indexes WHERE relation = 'ou'::regclass AND health = 'warn';
 reported 
----------
        1
(1 row)

VACUUM FULL ou;
VACUUM FULL ou_doc;
SELECT count(*) AS reported FROM sift.health() WHERE check_name = 'table_options_unapplied';
 reported 
----------
        0
(1 row)

DROP TABLE ou, ou_plain, ou_doc;
DROP EXTENSION pg_sift;
