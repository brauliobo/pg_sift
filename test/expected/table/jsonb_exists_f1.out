 same node SELECT count(*) FROM T WHERE doc ?| '{a,q}' AND n < 5
 same node SELECT count(*) FROM T WHERE doc @> '{"b": "y"}' AND n < 5
 same node SELECT count(*) FROM T WHERE doc->>'b' = 'y' AND n < 5
 same normal SELECT count(*), sum((doc->>'a')::float8) FROM T WHERE jsonb_typeof(doc->'a') = 'number' AND n < 5
 same node SELECT n, count(*) FROM T WHERE doc ? 'a' AND id BETWEEN 100 AND 15000 GROUP BY n
(8 rows)

DROP TABLE heap_docs, t1;
DROP FUNCTION same(text, text);
DROP EXTENSION pg_sift;
