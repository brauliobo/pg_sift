-- A sift_table answers the point lookups, the text matches and the ORDER BY .. LIMIT of a ClickBench-style table on the fast paths of the aggregate scan, and every answer is the heap's: a lookup of a sort
-- column from the cells of its projection, a <> of an integer column as a scan key, a text =, <> or LIKE of a literal over the bytes of the strings, a Top-N of rows and a text or computed key on the compute threads.
-- Every query is run on the table with the aggregate scan on, and on a heap twin holding the same rows; the sorted rows are compared; the first word says they agree, the second that the plan is the node's,
-- the third that the answer is not empty.
-- requires: build col
CREATE EXTENSION IF NOT EXISTS pg_sift CASCADE;
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 3;
SET jit = off;
SET work_mem = '256MB';
SET sift.agg_force = on;
\ir test/common/sql/agg/base.sql
\set ECHO none
CREATE FUNCTION node_is(q text, node text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	PERFORM set_config('sift.enable_agg', 'on', true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%Custom Scan (' || node || ')%' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
CREATE FUNCTION check_fast(name text, node text, q text) RETURNS TABLE (label text, same bool, on_node bool, nonempty bool) LANGUAGE plpgsql AS $$
DECLARE a text := runq(q, true); b text := runq(replace(q, ' ft', ' fh'), false);
BEGIN
	RETURN QUERY SELECT name, a = b, node_is(q, node), b <> '[]' AND b NOT LIKE 'ERR%';
END $$;
CREATE TABLE ft (id int, uid bigint, ev timestamp, adv int, rw int, ph text, url text, ctr numeric(12,2)) USING sift_table;
INSERT INTO ft SELECT i, (i::bigint * 7919) % 3000, timestamp '2024-01-01' + i * interval '7 seconds', CASE WHEN i % 4 = 0 THEN 0 ELSE i % 30 END, i % 200,
	CASE WHEN i % 5 = 0 THEN '' WHEN i % 17 = 0 THEN NULL ELSE 'phrase ' || (i % 411) END,
	'http://' || CASE WHEN i % 9 = 0 THEN 'www.google.com' ELSE 'site' || (i % 23) || '.example.org' END || '/p' || (i % 977),
	(i % 1000) / 8.0
-- 300000 rows are 37 granules of 8192, spread over the parts that sift.parts counts below, for the fast paths to skip some and read others
FROM generate_series(1, 300000) i;
CREATE TABLE fh (LIKE ft);
INSERT INTO fh SELECT * FROM ft;
SELECT sift.create_projection('ft', 'p_by_uid', 'ORDER BY uid') AS projection;
 projection 
------------
 t
(1 row)

VACUUM (FREEZE, ANALYZE) ft;
SELECT max(granules) > 16 AS many_granules FROM sift.parts('ft'::regclass);
 many_granules 
---------------
 t
(1 row)

\echo == a point lookup of a sort column is answered from the cells of its projection
== a point lookup of a sort column is answered from the cells of its projection
SELECT * FROM check_fast('lookup', 'SiftProjSortScan', $q$ SELECT uid FROM ft WHERE uid = 1234 $q$);
 label  | same | on_node | nonempty 
--------+------+---------+----------
 lookup | t    | t       | t
(1 row)

SELECT * FROM check_fast('lookup of a range', 'SiftProjSortScan', $q$ SELECT uid FROM ft WHERE uid BETWEEN 10 AND 12 $q$);
       label       | same | on_node | nonempty 
-------------------+------+---------+----------
 lookup of a range | t    | t       | t
(1 row)

SELECT * FROM check_fast('lookup of the whole row', 'SiftProjSortScan', $q$ SELECT * FROM ft WHERE uid = 1234 $q$);
          label          | same | on_node | nonempty 
-------------------------+------+---------+----------
 lookup of the whole row | t    | t       | t
(1 row)

SELECT * FROM check_fast('lookup of a column the projection does not sort', 'SiftProjSortScan', $q$ SELECT uid, ph FROM ft WHERE uid = 1234 $q$);
                      label                      | same | on_node | nonempty 
-------------------------------------------------+------+---------+----------
 lookup of a column the projection does not sort | t    | t       | t
(1 row)

DELETE FROM ft WHERE uid = 1234 AND id % 20000 < 10000;
DELETE FROM fh WHERE uid = 1234 AND id % 20000 < 10000;
SELECT * FROM check_fast('lookup after a delete', 'SiftProjSortScan', $q$ SELECT uid FROM ft WHERE uid = 1234 $q$);
         label         | same | on_node | nonempty 
-----------------------+------+---------+----------
 lookup after a delete | t    | t       | t
(1 row)

INSERT INTO ft SELECT 400000 + i, 1234, timestamp '2025-01-01' + i * interval '1 second', 1, 1, 'new', 'http://new', 1 FROM generate_series(1, 5) i;
INSERT INTO fh SELECT * FROM ft WHERE id > 400000;
SELECT * FROM check_fast('lookup after an insert', 'SiftProjSortScan', $q$ SELECT uid FROM ft WHERE uid = 1234 $q$);
         label          | same | on_node | nonempty 
------------------------+------+---------+----------
 lookup after an insert | t    | t       | t
(1 row)

VACUUM (FREEZE, ANALYZE) ft;
\echo == a text =, <> or LIKE of a literal is decided on the bytes of the strings
== a text =, <> or LIKE of a literal is decided on the bytes of the strings
SELECT * FROM check_fast('contains', 'SiftAggV6', $q$ SELECT count(*), sum(rw) FROM ft WHERE url LIKE '%google%' $q$);
  label   | same | on_node | nonempty 
----------+------+---------+----------
 contains | t    | t       | t
(1 row)

SELECT * FROM check_fast('contains, grouped', 'SiftAggV6', $q$ SELECT adv, count(*) FROM ft WHERE url LIKE '%google%' GROUP BY 1 $q$);
       label       | same | on_node | nonempty 
-------------------+------+---------+----------
 contains, grouped | t    | t       | t
(1 row)

SELECT * FROM check_fast('not contains', 'SiftAggV6', $q$ SELECT count(*) FROM ft WHERE url NOT LIKE '%google%' $q$);
    label     | same | on_node | nonempty 
--------------+------+---------+----------
 not contains | t    | t       | t
(1 row)

SELECT * FROM check_fast('prefix', 'SiftAggV6', $q$ SELECT count(*) FROM ft WHERE url LIKE 'http://site1%' $q$);
 label  | same | on_node | nonempty 
--------+------+---------+----------
 prefix | t    | t       | t
(1 row)

SELECT * FROM check_fast('suffix', 'SiftAggV6', $q$ SELECT count(*) FROM ft WHERE url LIKE '%/p1' $q$);
 label  | same | on_node | nonempty 
--------+------+---------+----------
 suffix | t    | t       | t
(1 row)

SELECT * FROM check_fast('equal', 'SiftAggV6', $q$ SELECT count(*) FROM ft WHERE ph = 'phrase 7' $q$);
 label | same | on_node | nonempty 
-------+------+---------+----------
 equal | t    | t       | t
(1 row)

SELECT * FROM check_fast('not equal', 'SiftAggV6', $q$ SELECT count(*), sum(adv) FROM ft WHERE ph <> '' $q$);
   label   | same | on_node | nonempty 
-----------+------+---------+----------
 not equal | t    | t       | t
(1 row)

SELECT * FROM check_fast('two text quals', 'SiftAggV6', $q$ SELECT ph, count(*) FROM ft WHERE ph <> '' AND url LIKE '%google%' GROUP BY 1 $q$);
     label      | same | on_node | nonempty 
----------------+------+---------+----------
 two text quals | t    | t       | t
(1 row)

SELECT * FROM check_fast('a pattern with _', 'SiftAggV6', $q$ SELECT count(*) FROM ft WHERE url LIKE 'http://site_.example.org%' $q$);
      label       | same | on_node | nonempty 
------------------+------+---------+----------
 a pattern with _ | t    | t       | t
(1 row)

