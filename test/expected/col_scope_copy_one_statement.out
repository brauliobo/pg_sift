-- A scope copy stays exact when one statement changes the facts and the pairs together (data-modifying CTEs): the triggers of the two tables
-- run one after the other on the state after the whole statement, in either order. A partitioned copy gets the partition of a new key in both.
CREATE EXTENSION pg_sift;
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int NOT NULL, kind smallint NOT NULL, amount numeric(8,2) NOT NULL);
CREATE TABLE pairs (dim_a_id int NOT NULL, scope_id int NOT NULL, PRIMARY KEY (scope_id, dim_a_id));
INSERT INTO pairs VALUES (1, 1), (2, 1), (2, 2), (3, 2);
INSERT INTO facts SELECT i, 1 + i % 4, i % 3, i FROM generate_series(1, 40) i;
SELECT sift.scope_create('copy_flat', 'facts', 'dim_a_id', 'pairs', 'scope_id');
NOTICE:  sift_col index "copy_flat_col": 3 automatic choices, 1 advice
DETAIL:  advice: track_changes = the table has no one-column primary key; key_order = scope_id;
rollup_columns = scope_id, dim_a_id; order_array_columns = scope_id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('copy_flat_col');
NOTICE:  sift_col index "copy_flat_col" is column format minor 44, which a library before 4.3 cannot read
HINT:  SET sift.col_format_minor = 14 before the build to write a format the older library reads.
NOTICE:  scope copy public.copy_flat: 40 rows, 1.33 copies per row of "public.facts" that reaches a key
NOTICE:  scope copy public.copy_flat: no sift_col index on "public.facts", all 4 columns carried, table of 0.0 MB
DETAIL:  A copy carries the columns of the sift_col index of its table, or every column when there is none, and its indexes come on top of the table.
HINT:  Drop the copy and build it with columns => ARRAY[..] to carry the columns the reads need.
NOTICE:  scope copy public.copy_flat: run VACUUM public.copy_flat now
DETAIL:  VACUUM cannot run inside a function. A copy that is not vacuumed has an empty visibility map: a read checks every row it keeps in the heap.
HINT:  sift.scope_status shows whether a copy was vacuumed.
 scope_create 
--------------
           40
(1 row)

SELECT sift.scope_create('copy_part', 'facts', 'dim_a_id', 'pairs', 'scope_id', partition => true);
