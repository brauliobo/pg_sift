-- positions count characters, not bytes
SELECT q, perr(q) FROM (VALUES
	('ünïcödé "ok'), ('жук OR'), ('日本 語 )'), ('ü^x'), ('éé~5')
) v(q);
      q      |                                     perr                                      
-------------+-------------------------------------------------------------------------------
 ünïcödé "ok | 42601: sift query: unterminated phrase at position 9
 жук OR      | 42601: sift query: expected a term after OR, found end of query at position 7
 日本 語 )   | 42601: sift query: unexpected ")" at position 6
 ü^x         | 42601: sift query: boost must be a non-negative number at position 3
 éé~5        | 42601: sift query: fuzzy distance must be 1 or 2 at position 3
(5 rows)

-- limits
SELECT q, perr(q) FROM (VALUES
	('a^10000.01'), ('a^1e9'), ('a^99999999999999999999999999999999999999999'),
	('(a^100)^101'), ('((a^10)^10)^100.5'),
	('(((((((((((((((((((((((((((((((((a)))))))))))))))))))))))))))))))))')
) v(q);
                                  q                                  |                                perr                                
---------------------------------------------------------------------+--------------------------------------------------------------------
 a^10000.01                                                          | 54000: sift query: boost must be between 0 and 10000 at position 3
 a^1e9                                                               | 54000: sift query: boost must be between 0 and 10000 at position 3
 a^99999999999999999999999999999999999999999                         | 54000: sift query: boost must be between 0 and 10000 at position 3
 (a^100)^101                                                         | 54000: sift query: combined boost exceeds 10000 at position 8
 ((a^10)^10)^100.5                                                   | 54000: sift query: combined boost exceeds 10000 at position 12
 (((((((((((((((((((((((((((((((((a))))))))))))))))))))))))))))))))) | 54000: sift query: nesting deeper than 32 at position 33
(6 rows)

