RESET parallel_tuple_cost;
-- a transaction that deleted rows sees them gone, another does not until it commits
BEGIN;
DELETE FROM md WHERE id BETWEEN 1 AND 100;
SELECT * FROM pa_sum('md');
 queries | differ | all_pre | some_pre | no_pre 
---------+--------+---------+----------+--------
      19 |      0 |       0 |       11 |      2
(1 row)

ROLLBACK;
SELECT * FROM pa_sum('md');
 queries | differ | all_pre | some_pre | no_pre 
---------+--------+---------+----------+--------
      19 |      0 |       0 |       11 |      2
(1 row)

-- the switch
SET sift.agg_preagg = off;
SELECT pre IS NULL AS off FROM pa_units('SELECT kind, min(val), max(val) FROM md GROUP BY kind');
 off 
-----
 t
(1 row)

RESET sift.agg_preagg;
SELECT pre > 0 AS on FROM pa_units('SELECT kind, min(val), max(val) FROM md GROUP BY kind');
 on 
----
 t
(1 row)

DROP TABLE mc, md, mo, mf, mx, pa_q;
DROP FUNCTION pa_rows(text, bool, bool), pa_units(text), pa_check(text, int, int), pa_sum(text, int, int);
DROP PROCEDURE pa_settle();
DROP EXTENSION pg_sift;
