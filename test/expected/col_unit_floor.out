-- deletes and inserts through the same cut
DELETE FROM fl WHERE id % 97 = 0;
INSERT INTO fl SELECT 100000 + g, g % 7, g % 1000, repeat('x', 1000) FROM generate_series(1, 500) g;
VACUUM (FREEZE, DISABLE_PAGE_SKIPPING) fl;
SELECT fl_same();
 fl_same 
