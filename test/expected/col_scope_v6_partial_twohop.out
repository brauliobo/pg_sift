(12 rows)

-- a table of its own and a role without the privilege: the summary never answers for a table the statement may not read
CREATE ROLE s48_reader NOLOGIN;
GRANT SELECT ON facts, grants, memberships TO s48_reader;
SET ROLE s48_reader;
SELECT count(*) FROM facts f JOIN (SELECT dim_a_id AS member FROM grants WHERE tenant_id = 1 AND deleted_at IS NULL AND dim_a_id IS NOT NULL UNION SELECT m.dim_a_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.tenant_id = 1 AND g.deleted_at IS NULL AND m.deleted_at IS NULL) a ON a.member = f.dim_a_id;
 count 
-------
  3128
(1 row)

RESET ROLE;
-- row level security on the facts: the node is not chosen
ALTER TABLE facts ENABLE ROW LEVEL SECURITY;
CREATE POLICY facts_all ON facts USING (true);
SELECT same(union_shape(1, 'UNION'));
                                                                                           same                                                                                            
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same normal SELECT count(*), sum(f.amount), min(f.id) FROM facts f JOIN (                                                                                                                +
         SELECT dim_a_id AS member FROM grants WHERE tenant_id = 1 AND deleted_at IS NULL AND dim_a_id IS NOT NULL                                                                        +
         UNION                                                                                                                                                                            +
         SELECT m.dim_a_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.tenant_id = 1 AND g.deleted_at IS NULL AND m.deleted_at IS NULL) a ON a.member = f.dim_a_id
(1 row)

ALTER TABLE facts DISABLE ROW LEVEL SECURITY;
DROP OWNED BY s48_reader;
DROP ROLE s48_reader;
DROP TABLE events, facts, grants, links, memberships;
DROP FUNCTION left_shape(integer), one_path(), same(text), two_paths(), union_shape(integer, text);
DROP EXTENSION pg_sift;
