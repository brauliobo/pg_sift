         SELECT DISTINCT COALESCE(g.dim_a_id, m.dim_a_id) AS member FROM grants g LEFT JOIN memberships m ON m.group_id = g.group_id AND m.deleted_at IS NULL                             +
         WHERE g.tenant_id = 4 AND g.deleted_at IS NULL)                                                                                                                                  +
         SELECT count(*), sum(f.amount), min(f.id) FROM facts f JOIN allowed a ON a.member = f.dim_a_id
