-- two paths: the direct grants of a tenant on a member, and its grants on a group of members
CREATE TABLE grants (id int PRIMARY KEY, tenant_id int NOT NULL, dim_a_id int, group_id int, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX grants_direct ON grants (dim_a_id, tenant_id) WHERE deleted_at IS NULL;
CREATE UNIQUE INDEX grants_group ON grants (group_id, tenant_id) WHERE deleted_at IS NULL;
CREATE TABLE memberships (id serial PRIMARY KEY, group_id int NOT NULL, dim_a_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX memberships_active ON memberships (group_id, dim_a_id) WHERE deleted_at IS NULL;
ALTER TABLE grants ADD CONSTRAINT grants_one_path CHECK (dim_a_id IS NULL OR group_id IS NULL);
CREATE INDEX grants_by_member ON grants USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX grants_by_group ON grants USING sift_col (group_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX memberships_by_member ON memberships USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
INSERT INTO memberships (group_id, dim_a_id, deleted_at) SELECT 1 + m % 6, m, CASE WHEN m % 11 = 0 THEN now() END FROM generate_series(1, 380) m;
INSERT INTO memberships (group_id, dim_a_id) SELECT 1 + (m + 2) % 6, m FROM generate_series(5, 380, 5) m ON CONFLICT DO NOTHING;
INSERT INTO grants (id, tenant_id, dim_a_id, group_id) SELECT i, 1 + i % 5, CASE WHEN i % 3 = 0 THEN 1 + (i * 13) % 380 END, CASE WHEN i % 3 <> 0 THEN 1 + i % 6 END FROM generate_series(1, 90) i ON CONFLICT DO NOTHING;
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, 1 + (i * 29) % 400, timestamptz '2026-01-01' + i * interval '53 minutes', i % 70 FROM generate_series(1, 5000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'tenant_id: dim_a_id -> grants(dim_a_id, tenant_id) | grants(group_id, tenant_id) via memberships(group_id, dim_a_id)', track_changes = 'ctid');
ANALYZE grants;
ANALYZE memberships;
ANALYZE facts;
CREATE FUNCTION union_shape(tenant int, op text) RETURNS text LANGUAGE sql AS $$ SELECT format($f$SELECT count(*), sum(f.amount), min(f.id) FROM facts f JOIN (
	SELECT dim_a_id AS member FROM grants WHERE tenant_id = %1$s AND deleted_at IS NULL AND dim_a_id IS NOT NULL
	%2$s
	SELECT m.dim_a_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.tenant_id = %1$s AND g.deleted_at IS NULL AND m.deleted_at IS NULL) a ON a.member = f.dim_a_id$f$, tenant, op) $$;
CREATE FUNCTION left_shape(tenant int) RETURNS text LANGUAGE sql AS $$ SELECT format($f$WITH allowed AS (
	SELECT DISTINCT COALESCE(g.dim_a_id, m.dim_a_id) AS member FROM grants g LEFT JOIN memberships m ON m.group_id = g.group_id AND m.deleted_at IS NULL
	WHERE g.tenant_id = %1$s AND g.deleted_at IS NULL)
	SELECT count(*), sum(f.amount), min(f.id) FROM facts f JOIN allowed a ON a.member = f.dim_a_id$f$, tenant) $$;
CREATE FUNCTION two_paths() RETURNS SETOF text LANGUAGE sql AS $$ SELECT union_shape(t, 'UNION') FROM generate_series(1, 5) t UNION ALL SELECT union_shape(t, 'UNION ALL') FROM generate_series(1, 2) t
	UNION ALL SELECT left_shape(t) FROM generate_series(1, 5) t $$;
SELECT same(q) FROM two_paths() q;
                                                                                           same                                                                                            
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same scope SELECT count(*), sum(f.amount), min(f.id) FROM facts f JOIN (                                                                                                                 +
         SELECT dim_a_id AS member FROM grants WHERE tenant_id = 1 AND deleted_at IS NULL AND dim_a_id IS NOT NULL                                                                        +
         UNION                                                                                                                                                                            +
         SELECT m.dim_a_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.tenant_id = 1 AND g.deleted_at IS NULL AND m.deleted_at IS NULL) a ON a.member = f.dim_a_id
 same scope SELECT count(*), sum(f.amount), min(f.id) FROM facts f JOIN (                                                                                                                 +
