-- The scope aggregate over pairs with a predicate and over a scope of two paths. The pairs of a scope are the rows of its unique btree that satisfy the btree's predicate, so a statement takes the
-- summary only when the rows it reads from the pairs relation are those rows: it states the predicate and the key it binds (or the keys of an array), and adds no other condition. The scope of two paths
-- (the grants a tenant has on a member and on the groups of the member) is written as a UNION of the two paths, or as a LEFT JOIN with COALESCE and DISTINCT over the polymorphic table; the facts may be
-- in a partial index of their live rows. Each statement is asked of the summary and of the join as written, after the build and after each change of the pairs, and the two answers are compared.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET TimeZone = 'UTC';
SET sift.test_create_format1 = off;
CREATE TABLE links (id int PRIMARY KEY, dim_a_id int NOT NULL, tenant_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX links_live ON links (dim_a_id, tenant_id) WHERE deleted_at IS NULL;
CREATE INDEX links_journal ON links USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
INSERT INTO links SELECT i, 1 + (i * 7) % 400, 1 + i % 9, CASE WHEN i % 13 = 0 THEN now() END FROM generate_series(1, 1500) i ON CONFLICT DO NOTHING;
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, value_num int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 31) % 400, timestamptz '2026-01-01' + i * interval '41 minutes', i % 100, CASE WHEN i % 29 = 0 THEN now() END FROM generate_series(1, 6000) i;
CREATE INDEX events_s ON events USING sift_col (id, dim_a_id, created_at, value_num, deleted_at) WITH (scope = 'tenant_id: dim_a_id -> links(dim_a_id, tenant_id)', track_changes = 'ctid');
CREATE INDEX events_live ON events USING sift_col (id, dim_a_id, created_at, value_num, deleted_at) WITH (scope = 'tenant_id: dim_a_id -> links(dim_a_id, tenant_id)', track_changes = 'ctid') WHERE deleted_at IS NULL;
ANALYZE links;
ANALYZE events;
CREATE FUNCTION same(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text; plan text := ''; l text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP plan := plan || l; END LOOP;
	EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (' || q || ') r' INTO a;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (' || q || ') r' INTO b;
	RETURN (CASE WHEN a IS DISTINCT FROM b THEN 'DIFFERENT' ELSE 'same' END) || ' ' || (CASE WHEN plan LIKE '%SiftAggV6Scope%' THEN 'scope' ELSE 'normal' END) || ' ' || q;
END $$;
CREATE FUNCTION one_path() RETURNS SETOF text LANGUAGE sql AS $$ SELECT unnest(ARRAY[
	'SELECT count(*), sum(e.value_num), min(e.id), max(e.id) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4 AND s.deleted_at IS NULL',
	'SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4',
	'SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4 AND s.deleted_at IS NULL AND s.id > 10',
	'SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = ANY(ARRAY[2, 4, 7]) AND s.deleted_at IS NULL',
	'SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id IN (2, 4, 4) AND s.deleted_at IS NULL',
	'SELECT s.tenant_id, count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.deleted_at IS NULL GROUP BY s.tenant_id',
	'SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4 AND s.deleted_at IS NULL AND e.deleted_at IS NULL',
	'SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 9 AND s.deleted_at IS NULL AND e.created_at >= ''2026-02-10 08:00'' AND e.created_at < ''2026-04-20 17:30''']) $$;
SELECT same(q) FROM one_path() q;
                                                                                                              same                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same scope SELECT count(*), sum(e.value_num), min(e.id), max(e.id) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4 AND s.deleted_at IS NULL
 same normal SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4
 same normal SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4 AND s.deleted_at IS NULL AND s.id > 10
 same scope SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = ANY(ARRAY[2, 4, 7]) AND s.deleted_at IS NULL
 same scope SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id IN (2, 4, 4) AND s.deleted_at IS NULL
 same scope SELECT s.tenant_id, count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.deleted_at IS NULL GROUP BY s.tenant_id
 same scope SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 4 AND s.deleted_at IS NULL AND e.deleted_at IS NULL
 same scope SELECT count(*), sum(e.value_num) FROM events e JOIN links s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 9 AND s.deleted_at IS NULL AND e.created_at >= '2026-02-10 08:00' AND e.created_at < '2026-04-20 17:30'
(8 rows)

-- pairs change: a link is soft deleted, one moves to another tenant, new ones come in
UPDATE links SET deleted_at = now() WHERE id IN (4, 9, 16, 23);
UPDATE links SET tenant_id = 4 WHERE id IN (5, 12, 33) AND NOT EXISTS (SELECT 1 FROM links l WHERE l.dim_a_id = links.dim_a_id AND l.tenant_id = 4 AND l.deleted_at IS NULL);
