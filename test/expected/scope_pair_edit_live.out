 same scope summary clean SELECT count(*), min(e.amount), max(e.sc ...  ep.entity_id = e.entity_id WHERE ep.parent_id = 4
 same scope summary clean SELECT count(*), sum(e.status) FROM even ... ep.entity_id = e.entity_id WHERE ep.parent_id = 12
 same scope summary clean SELECT count(*), sum(e.amount) FROM even ... p.entity_id = e.entity_id WHERE ep.parent_id = 999
 same scope summary clean SELECT ep.parent_id, count(*), sum(e.amo ... N ep.entity_id = e.entity_id GROUP BY ep.parent_id
 same scope summary clean SELECT ep.parent_id, date_trunc('month', ... = e.entity_id WHERE ep.parent_id = 4 GROUP BY 1, 2
 same scope summary clean SELECT count(*) FROM events e JOIN entit ...  '2024-06-01' AND e.event_date < DATE '2024-07-01'
 same scope summary clean SELECT count(*), sum(e.amount), min(e.sc ... _id = e.entity_id WHERE ep.parent_id IN (4, 5, 12)
 same scope summary clean SELECT ep.parent_id, count(*), sum(e.amo ... = ANY (ARRAY[4, 5, 12, 999]) GROUP BY ep.parent_id
 same scope summary clean SELECT ep.parent_id, date_trunc('month', ... tity_id WHERE ep.parent_id IN (4, 5) GROUP BY 1, 2
