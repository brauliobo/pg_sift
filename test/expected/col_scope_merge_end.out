RESET sift.col_auto_merge_partition_kb;
DROP INDEX events_col;
DROP TABLE sizes, events, tenant_scope;
DROP FUNCTION scope_state(), load_events(int, int);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
