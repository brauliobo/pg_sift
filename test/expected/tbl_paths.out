CREATE TABLE pt (id int, doc jsonb, n int) USING sift_table;
SELECT sift.table_set_paths('pt', 'n', 'n->ch text');
ERROR:  "n" is not a jsonb column of "pt"
CONTEXT:  SQL statement "SELECT sift.table_paths_check(tbl, col, spec)"
PL/pgSQL function sift.table_set_paths(regclass,name,text) line 3 at PERFORM
SELECT sift.table_set_paths('pt', 'nope', 'nope->ch text');
ERROR:  "nope" is not a jsonb column of "pt"
CONTEXT:  SQL statement "SELECT sift.table_paths_check(tbl, col, spec)"
PL/pgSQL function sift.table_set_paths(regclass,name,text) line 3 at PERFORM
