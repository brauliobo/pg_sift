-- The scope of two paths of the stock benchmark (a direct grant, or a grant on a group through the memberships) on an index of format major 2: a statement over the view of the pairs written as IN,
-- EXISTS or a join is answered by the node of the scope (SiftAggV6Scope), from the summary of the key, the ring of its newest rows, or the scan of the facts of its members, never by the
-- join of the facts with the view. Each line is a statement of the classes of bench/sql/scope_stock/queries: whether its rows are those of the join as written (sift.enable_agg = off) and
-- what the plan read. The classes the cubes cannot answer (a group by a leaf that is no flag, a count of distinct members) stay on the aggregate scan.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET TimeZone = 'UTC';
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
CREATE TABLE events (id int NOT NULL PRIMARY KEY, dim_a_id int NOT NULL, created_at date NOT NULL, kind text NOT NULL, channel_id int NOT NULL, region text NOT NULL, score int NOT NULL,
	amount int NOT NULL) WITH (autovacuum_enabled = false);
CREATE TABLE grants (id serial PRIMARY KEY, tenant_id int NOT NULL, dim_a_id int, group_id int, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE TABLE memberships (id serial PRIMARY KEY, group_id int NOT NULL, dim_a_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX grants_direct ON grants (dim_a_id, tenant_id) WHERE deleted_at IS NULL;
CREATE UNIQUE INDEX grants_group ON grants (group_id, tenant_id) WHERE deleted_at IS NULL;
CREATE UNIQUE INDEX memberships_active ON memberships (group_id, dim_a_id) WHERE deleted_at IS NULL;
CREATE VIEW tenant_pairs AS
	SELECT g.dim_a_id AS member, g.tenant_id FROM grants g WHERE g.deleted_at IS NULL AND g.dim_a_id IS NOT NULL
	UNION
	SELECT m.dim_a_id, g.tenant_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.deleted_at IS NULL AND m.deleted_at IS NULL;
-- tenant 1: members 1 to 40 directly and the groups 11 and 12 (member 10 is in both paths, member 95 left group 11); tenant 2: the group 21 (the group 22 was revoked); tenant 3: direct only; tenant 4: none
INSERT INTO grants (tenant_id, dim_a_id) SELECT 1, m FROM generate_series(1, 40) m;
INSERT INTO grants (tenant_id, dim_a_id, deleted_at) VALUES (1, 100, now());
INSERT INTO grants (tenant_id, group_id) VALUES (1, 11), (1, 12), (2, 21);
INSERT INTO grants (tenant_id, group_id, deleted_at) VALUES (2, 22, now());
INSERT INTO grants (tenant_id, dim_a_id) SELECT 3, m FROM generate_series(131, 140) m;
INSERT INTO memberships (group_id, dim_a_id) SELECT 11, m FROM generate_series(41, 70) m;
INSERT INTO memberships (group_id, dim_a_id) SELECT 12, m FROM generate_series(71, 90) m;
INSERT INTO memberships (group_id, dim_a_id) VALUES (12, 10), (12, 41), (21, 91);
INSERT INTO memberships (group_id, dim_a_id, deleted_at) VALUES (11, 95, now());
INSERT INTO memberships (group_id, dim_a_id) SELECT 21, m FROM generate_series(92, 130) m;
INSERT INTO memberships (group_id, dim_a_id) SELECT 22, m FROM generate_series(131, 150) m;
INSERT INTO events SELECT i, 1 + (i * 7) % 160, DATE '2022-01-01' + (i * 13) % 1400, 'k' || i % 6, 1 + i % 12, (ARRAY['US', 'DE', 'BR', 'JP'])[1 + i % 4], 1 + i % 10, i % 500
	FROM generate_series(1, 30000) i;
CREATE INDEX grants_by_member ON grants USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX grants_by_group ON grants USING sift_col (group_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX memberships_by_member ON memberships USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, kind, channel_id, region, score, amount)
	WITH (key_order = 'dim_a_id, created_at', scope = 'tenant_id: dim_a_id -> grants(dim_a_id, tenant_id) | grants(group_id, tenant_id) via memberships(group_id, dim_a_id)');
VACUUM (ANALYZE) events, grants, memberships;
CREATE FUNCTION probe(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text; l text; plan text := ''; read text := '-';
BEGIN
	SET LOCAL sift.enable_agg = on;
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		plan := plan || l;
		IF l LIKE '%Scope Read: %' THEN read := trim(substr(l, position('Scope Read: ' in l) + 12)); END IF;
	END LOOP;
	EXECUTE 'SELECT md5(coalesce(string_agg(r::text, ''|'' ORDER BY r::text), '''')) FROM (' || q || ') r' INTO a;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'SELECT md5(coalesce(string_agg(r::text, ''|'' ORDER BY r::text), '''')) FROM (' || q || ') r' INTO b;
	RETURN (CASE WHEN a IS DISTINCT FROM b THEN 'DIFFERENT' ELSE 'same' END) || ' ' || (CASE WHEN plan LIKE '%SiftAggV6Scope%' THEN 'scope, ' || read WHEN plan LIKE '%SiftAggV6%' THEN 'aggregate scan' ELSE 'normal' END);
END $$;
-- the nine classes, for the members one tenant reaches
CREATE FUNCTION classes(t int) RETURNS TABLE (class text, q text) LANGUAGE sql AS $$ SELECT c, format(s, t) FROM (VALUES
	('by_member', 'SELECT dim_a_id, count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) GROUP BY 1'),
	('count_by_kind', 'SELECT kind, count(*) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) AND created_at >= ''2025-01-01'' GROUP BY 1'),
	('count_by_score', 'SELECT score, count(*) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) GROUP BY 1'),
	('date_range_count', 'SELECT count(*) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) AND created_at >= ''2023-06-01'' AND created_at < ''2024-01-01'''),
	('distinct_members_by_month', 'SELECT date_trunc(''month'', created_at) m, count(DISTINCT dim_a_id) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) AND created_at >= ''2022-01-01'' GROUP BY 1'),
	('filtered_count', 'SELECT count(*) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) AND channel_id = 9 AND region = ''DE'''),
	('latest_20_rows', 'SELECT id, created_at FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) ORDER BY created_at DESC, id DESC LIMIT 20'),
	('sum_by_month', 'SELECT date_trunc(''month'', created_at) m, count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) AND created_at >= ''2023-01-01'' GROUP BY 1'),
	('top_members', 'SELECT dim_a_id, count(*) c FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = %s) GROUP BY 1 ORDER BY c DESC, 1 LIMIT 20')) v (c, s) $$;
CREATE FUNCTION matrix() RETURNS TABLE (tenant int, class text, result text) LANGUAGE sql AS $$
	SELECT t, c.class, probe(c.q) FROM generate_series(1, 4) t, LATERAL classes(t) c ORDER BY t, c.class $$;
-- 1. the classes on the index as built, for the tenant with both paths, the one with groups only, the one with direct grants only and the one with no pair
SELECT * FROM matrix();
 tenant |           class           |                         result                         
--------+---------------------------+--------------------------------------------------------
      1 | by_member                 | same aggregate scan
      1 | count_by_kind             | same scope, scan of the facts (the members of the key)
      1 | count_by_score            | same aggregate scan
      1 | date_range_count          | same scope, summary
      1 | distinct_members_by_month | same aggregate scan
      1 | filtered_count            | same scope, scan of the facts (the members of the key)
      1 | latest_20_rows            | same scope, ring
      1 | sum_by_month              | same scope, summary
      1 | top_members               | same aggregate scan
      2 | by_member                 | same aggregate scan
      2 | count_by_kind             | same scope, scan of the facts (the members of the key)
      2 | count_by_score            | same aggregate scan
      2 | date_range_count          | same scope, summary
      2 | distinct_members_by_month | same aggregate scan
      2 | filtered_count            | same scope, scan of the facts (the members of the key)
      2 | latest_20_rows            | same scope, ring
      2 | sum_by_month              | same scope, summary
      2 | top_members               | same aggregate scan
      3 | by_member                 | same aggregate scan
      3 | count_by_kind             | same scope, scan of the facts (the members of the key)
      3 | count_by_score            | same aggregate scan
      3 | date_range_count          | same scope, summary
      3 | distinct_members_by_month | same aggregate scan
      3 | filtered_count            | same scope, scan of the facts (the members of the key)
      3 | latest_20_rows            | same scope, ring
      3 | sum_by_month              | same scope, summary
      3 | top_members               | same aggregate scan
      4 | by_member                 | same normal
      4 | count_by_kind             | same scope, scan of the facts (the members of the key)
      4 | count_by_score            | same normal
      4 | date_range_count          | same scope, summary
      4 | distinct_members_by_month | same normal
      4 | filtered_count            | same scope, scan of the facts (the members of the key)
      4 | latest_20_rows            | same scope, ring
      4 | sum_by_month              | same scope, summary
      4 | top_members               | same normal
(36 rows)

-- 2. the statement the view is written as: IN, EXISTS, a join to the view or to a sub-select of it, and the union written in the statement
SELECT form, probe(q) FROM (VALUES
	('IN', 'SELECT date_trunc(''month'', created_at) m, count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = 1) AND created_at >= ''2023-01-01'' GROUP BY 1'),
	('EXISTS', 'SELECT date_trunc(''month'', created_at) m, count(*), sum(amount) FROM events e WHERE EXISTS (SELECT 1 FROM tenant_pairs p WHERE p.member = e.dim_a_id AND p.tenant_id = 1) AND created_at >= ''2023-01-01'' GROUP BY 1'),
	('join, view', 'SELECT count(*), sum(amount) FROM events e JOIN tenant_pairs p ON p.member = e.dim_a_id WHERE p.tenant_id = 1'),
	('join, sub-select of the view', 'SELECT count(*), sum(amount) FROM events e JOIN (SELECT member FROM tenant_pairs WHERE tenant_id = 1) p ON p.member = e.dim_a_id'),
	('IN, union of the paths', 'SELECT count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM grants WHERE tenant_id = 1 AND deleted_at IS NULL AND dim_a_id IS NOT NULL UNION SELECT m.dim_a_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.tenant_id = 1 AND g.deleted_at IS NULL AND m.deleted_at IS NULL)'),
	('IN, two keys', 'SELECT count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id IN (1, 2))'),
	('IN, a condition on the pairs', 'SELECT count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = 1 AND member > 20)'),
	('join, every key', 'SELECT p.tenant_id, count(*) FROM events e JOIN tenant_pairs p ON p.member = e.dim_a_id GROUP BY 1')) f (form, q);
             form             |        probe        
------------------------------+---------------------
 IN                           | same scope, summary
 EXISTS                       | same scope, summary
 join, view                   | same scope, summary
 join, sub-select of the view | same scope, summary
 IN, union of the paths       | same scope, summary
 IN, two keys                 | same aggregate scan
 IN, a condition on the pairs | same aggregate scan
 join, every key              | same scope, summary
(8 rows)

-- 3. pairs change: a direct grant is revoked, a member joins a group, a group grant is revoked, a tenant gains a member (the node reads the summary or the join, whichever is exact)
UPDATE grants SET deleted_at = now() WHERE tenant_id = 1 AND dim_a_id IN (3, 4);
INSERT INTO memberships (group_id, dim_a_id) VALUES (11, 150), (21, 20);
UPDATE grants SET deleted_at = now() WHERE tenant_id = 1 AND group_id = 12;
INSERT INTO grants (tenant_id, dim_a_id) VALUES (4, 7), (4, 8);
