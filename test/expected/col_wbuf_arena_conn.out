RESET sift.col_connect_refresh_pct;
DROP FUNCTION phase();
DROP FUNCTION apply(int, text);
DROP FUNCTION apply_tx(text);
DROP FUNCTION found_run(text);
DROP TABLE shapes, ev_a, ev_b, dim_a, dim_b;
DROP EXTENSION pg_sift;
