-- What a text, varchar or uuid scope key does not take, and the reason each refusal names (docs/COL-SCOPE.md "Key types"): a column of another type, a nondeterministic collation
-- (equal values may differ in their bytes, which the btree, the store and the codes agree on), a text key in a scope of two paths; the same for a member (a text member qualifies, a char(n), a domain,
-- a nondeterministic collation, an integer paired with a string, a scope of two paths do not); a condition under a nondeterministic collation keeps the join as written.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET client_min_messages = warning;
CREATE FUNCTION try(stmt text) RETURNS text LANGUAGE plpgsql AS
$$ DECLARE hint text; BEGIN EXECUTE stmt; RETURN 'ok';
   EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS hint = PG_EXCEPTION_HINT; RETURN sqlerrm || coalesce(' [' || hint || ']', ''); END $$;
CREATE COLLATION ci (provider = icu, locale = 'und-u-ks-level2', deterministic = false);
CREATE DOMAIN dom_text AS text;
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, member_text text, member_char char(8), member_ci text COLLATE ci, created_at date, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + i % 50, 'm' || (1 + i % 50), 'm' || (1 + i % 50), 'm' || (1 + i % 50), date '2025-01-01' + i % 100, i % 10 FROM generate_series(1, 2000) i;
-- pairs relations, each with its journal index: a text key (the one that qualifies), and what does not
CREATE TABLE pairs_text (dim_a_id int NOT NULL, tenant_id text NOT NULL, PRIMARY KEY (dim_a_id, tenant_id));
CREATE TABLE pairs_ci (dim_a_id int NOT NULL, tenant_id text COLLATE ci NOT NULL, PRIMARY KEY (dim_a_id, tenant_id));
CREATE TABLE pairs_char (dim_a_id int NOT NULL, tenant_id char(8) NOT NULL, PRIMARY KEY (dim_a_id, tenant_id));
CREATE TABLE pairs_bytea (dim_a_id int NOT NULL, tenant_id bytea NOT NULL, PRIMARY KEY (dim_a_id, tenant_id));
CREATE TABLE pairs_member_text (member_text text NOT NULL, tenant_id text NOT NULL, PRIMARY KEY (member_text, tenant_id));
CREATE TABLE pairs_member_char (member_char char(8) NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (member_char, tenant_id));
CREATE TABLE pairs_member_ci (member_ci text COLLATE ci NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (member_ci, tenant_id));
CREATE TABLE pairs_member_dom (member_dom dom_text NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (member_dom, tenant_id));
INSERT INTO pairs_text SELECT i, 't' || (1 + i % 5) FROM generate_series(1, 50) i;
INSERT INTO pairs_ci SELECT i, 't' || (1 + i % 5) FROM generate_series(1, 50) i;
INSERT INTO pairs_char SELECT i, 't' || (1 + i % 5) FROM generate_series(1, 50) i;
INSERT INTO pairs_bytea SELECT i, ('t' || (1 + i % 5))::bytea FROM generate_series(1, 50) i;
INSERT INTO pairs_member_text SELECT 'm' || i, 't' || (1 + i % 5) FROM generate_series(1, 50) i;
INSERT INTO pairs_member_char SELECT 'm' || i, 1 + i % 5 FROM generate_series(1, 50) i;
INSERT INTO pairs_member_ci SELECT 'm' || i, 1 + i % 5 FROM generate_series(1, 50) i;
INSERT INTO pairs_member_dom SELECT 'm' || i, 1 + i % 5 FROM generate_series(1, 50) i;
CREATE INDEX pairs_text_j ON pairs_text USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX pairs_ci_j ON pairs_ci USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX pairs_char_j ON pairs_char USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX pairs_bytea_j ON pairs_bytea USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX pairs_member_text_j ON pairs_member_text USING sift_col (member_text, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX pairs_member_char_j ON pairs_member_char USING sift_col (member_char, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX pairs_member_ci_j ON pairs_member_ci USING sift_col (member_ci, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX pairs_member_dom_j ON pairs_member_dom USING sift_col (member_dom, tenant_id) WITH (track_changes = 'ctid');
ERROR:  sift_col does not support the type public.dom_text of column "member_dom"
HINT:  Supported: smallint, integer, bigint, boolean, date, time, timetz, timestamp, timestamptz, interval, numeric, money, real, double precision, text, varchar, char(n), name, bytea, uuid, inet, cidr, macaddr, macaddr8, bit, varbit, enums, arrays, ranges and jsonb with paths.
-- two paths with a text key: a grant on a member and on a group, the members of a group
CREATE TABLE grants_direct (dim_a_id int NOT NULL, tenant_id text NOT NULL, PRIMARY KEY (dim_a_id, tenant_id));
CREATE TABLE grants_group (group_id int NOT NULL, tenant_id text NOT NULL, PRIMARY KEY (group_id, tenant_id));
CREATE TABLE memberships (group_id int NOT NULL, dim_a_id int NOT NULL, PRIMARY KEY (group_id, dim_a_id));
CREATE TABLE grants_direct_text (member_text text NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (member_text, tenant_id));
CREATE TABLE grants_group_int (group_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (group_id, tenant_id));
CREATE TABLE memberships_text (group_id int NOT NULL, member_text text NOT NULL, PRIMARY KEY (group_id, member_text));
CREATE TABLE refusals (n int, what text, opt text);
INSERT INTO refusals VALUES
	(1, 'text key', 'tenant_id: dim_a_id -> pairs_text(dim_a_id, tenant_id)'),
	(2, 'nondeterministic collation', 'tenant_id: dim_a_id -> pairs_ci(dim_a_id, tenant_id)'),
	(3, 'char(n) key', 'tenant_id: dim_a_id -> pairs_char(dim_a_id, tenant_id)'),
	(4, 'bytea key', 'tenant_id: dim_a_id -> pairs_bytea(dim_a_id, tenant_id)'),
	(5, 'text member, text key', 'tenant_id: member_text -> pairs_member_text(member_text, tenant_id)'),
	(6, 'text key, two paths', 'tenant_id: dim_a_id -> grants_direct(dim_a_id, tenant_id) | grants_group(group_id, tenant_id) via memberships(group_id, dim_a_id)'),
	(7, 'char(n) member', 'tenant_id: member_char -> pairs_member_char(member_char, tenant_id)'),
	(8, 'nondeterministic collation, member', 'tenant_id: member_ci -> pairs_member_ci(member_ci, tenant_id)'),
	(9, 'domain member', 'tenant_id: member_text -> pairs_member_dom(member_dom, tenant_id)'),
	(10, 'text fact column, integer member', 'tenant_id: member_text -> pairs_text(dim_a_id, tenant_id)'),
	(11, 'integer fact column, text member', 'tenant_id: dim_a_id -> pairs_member_text(member_text, tenant_id)'),
	(12, 'text member, two paths', 'tenant_id: member_text -> grants_direct_text(member_text, tenant_id) | grants_group_int(group_id, tenant_id) via memberships_text(group_id, member_text)'),
	(13, 'char(n) fact column, text member', 'tenant_id: member_char -> pairs_member_text(member_text, tenant_id)'),
	(14, 'nondeterministic collation, fact column', 'tenant_id: member_ci -> pairs_member_text(member_text, tenant_id)');
SELECT n, what, try(format('CREATE INDEX events_col_%s ON events USING sift_col (id, dim_a_id, member_text, member_char, member_ci, created_at, amount) WITH (scope = %L)', n, opt)) AS result FROM refusals ORDER BY n;
 n  |                  what                   |                                                                                                                              result                                                                                                                               
----+-----------------------------------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  1 | text key                                | ok
  2 | nondeterministic collation              | scope "tenant_id": column "tenant_id" of "pairs_ci" has a nondeterministic collation, whose equal values may differ in their bytes: use a deterministic one (COLLATE "C") [The member and scope key columns are int2, int4, int8, text, varchar or uuid columns.]
  3 | char(n) key                             | scope "tenant_id": column "tenant_id" of "pairs_char" is a char(n) column, whose values are equal when they differ in blank padding: declare it text or varchar [The member and scope key columns are int2, int4, int8, text, varchar or uuid columns.]
  4 | bytea key                               | scope "tenant_id": column "tenant_id" of "pairs_bytea" is not an integer, text, varchar or uuid column [The member and scope key columns are int2, int4, int8, text, varchar or uuid columns.]
  5 | text member, text key                   | ok
  6 | text key, two paths                     | scope "tenant_id": column "tenant_id" of "grants_direct" is of type text, which a scope of two paths does not take yet [A text or uuid column is read through a scope of one path.]
  7 | char(n) member                          | scope "tenant_id": column "member_char" is a char(n) column, whose values are equal when they differ in blank padding: declare it text or varchar [The member key is an int2, int4, int8, text, varchar or uuid column.]
  8 | nondeterministic collation, member      | scope "tenant_id": column "member_ci" has a nondeterministic collation, whose equal values may differ in their bytes: use a deterministic one (COLLATE "C") [The member key is an int2, int4, int8, text, varchar or uuid column.]
  9 | domain member                           | scope "tenant_id": column "member_dom" of "pairs_member_dom" is a domain: declare the column with its base type, an integer, text, varchar or uuid [The member and scope key columns are int2, int4, int8, text, varchar or uuid columns.]
 10 | text fact column, integer member        | scope "tenant_id": the member column "dim_a_id" of "pairs_text" (integer) and the column "member_text" of the index (text) are not of one kind [Both are integers, both text or varchar, or both uuid: their values are equal when their bytes are.]
 11 | integer fact column, text member        | scope "tenant_id": the member column "member_text" of "pairs_member_text" (text) and the column "dim_a_id" of the index (integer) are not of one kind [Both are integers, both text or varchar, or both uuid: their values are equal when their bytes are.]
 12 | text member, two paths                  | scope "tenant_id": column "member_text" of "grants_direct_text" is of type text, which a scope of two paths does not take yet [A text or uuid column is read through a scope of one path.]
 13 | char(n) fact column, text member        | scope "tenant_id": column "member_char" is a char(n) column, whose values are equal when they differ in blank padding: declare it text or varchar [The member key is an int2, int4, int8, text, varchar or uuid column.]
 14 | nondeterministic collation, fact column | scope "tenant_id": column "member_ci" has a nondeterministic collation, whose equal values may differ in their bytes: use a deterministic one (COLLATE "C") [The member key is an int2, int4, int8, text, varchar or uuid column.]
(14 rows)

-- the text key that qualifies reads like the join, and a condition under a nondeterministic collation does not take the scope
REINDEX INDEX events_col_1;
VACUUM (FREEZE, ANALYZE) events, pairs_text;
SET seq_page_cost = 1000;
SET random_page_cost = 1000;
CREATE FUNCTION plan_of(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; plan text := '';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || l || E'\n'; END LOOP;
	RETURN CASE WHEN plan ~ 'Scope Index: ' THEN 'scope read' WHEN plan ~ 'SiftAgg' THEN 'SiftAgg, the join' ELSE 'normal plan' END;
END $$;
SELECT plan_of(format('SELECT count(*) FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM pairs_text WHERE tenant_id = %L %s)', 't2', coll)) AS plan, coll
	FROM (VALUES (''), ('COLLATE "C"'), ('COLLATE ci')) c (coll);
       plan        |    coll     
-------------------+-------------
 scope read        | 
 scope read        | COLLATE "C"
 SiftAgg, the join | COLLATE ci
(3 rows)

INSERT INTO pairs_text VALUES (7, 'T2');
CREATE FUNCTION ci_count() RETURNS bigint LANGUAGE sql AS
$$ SELECT count(*) FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM pairs_text WHERE tenant_id = 't2' COLLATE ci) $$;
SELECT ci_count() AS ci, (SELECT count(*) FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM pairs_text WHERE tenant_id = 't2')) AS bytes;
 ci  | bytes 
-----+-------
 440 |   400
(1 row)

SET sift.enable_agg = off;
SELECT ci_count() AS ci_without_sift;
 ci_without_sift 
-----------------
             440
(1 row)

RESET sift.enable_agg;
DROP FUNCTION ci_count();
DROP INDEX events_col_1;
DROP FUNCTION try(text), plan_of(text);
DROP TABLE refusals, events, pairs_text, pairs_ci, pairs_char, pairs_bytea, pairs_member_text, pairs_member_char, pairs_member_ci, pairs_member_dom, grants_direct, grants_group, memberships, grants_direct_text, grants_group_int, memberships_text CASCADE;
DROP DOMAIN dom_text;
DROP COLLATION ci;
DROP EXTENSION pg_sift;
