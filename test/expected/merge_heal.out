(1 row)

DROP TABLE src, fresh1, fresh2, damaged, phrases;
DROP FUNCTION idx_bytes(regclass), heap_checks(regclass, text), top_ids(regclass, text), other_phrases(regclass, regclass);
DROP EXTENSION pg_sift;
