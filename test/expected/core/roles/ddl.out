-- CONCURRENTLY runs outside a transaction block: the owner, then a role that is not the owner
SET SESSION AUTHORIZATION rrd_owner;
CREATE TABLE rrd.conc (id int, body text, g int, v float8);
INSERT INTO rrd.conc SELECT i, 'alpha ' || i, i % 3, i FROM generate_series(1, 300) i;
CREATE INDEX CONCURRENTLY conc_btree ON rrd.conc (g);
CREATE INDEX CONCURRENTLY conc_idx ON rrd.conc USING sift (body);
CREATE INDEX CONCURRENTLY conc_col ON rrd.conc USING sift_col (id, g, v);
REINDEX INDEX CONCURRENTLY rrd.conc_idx;
REINDEX INDEX CONCURRENTLY rrd.conc_col;
REINDEX TABLE CONCURRENTLY rrd.conc;
SELECT count(*) FROM rrd.conc WHERE body @@> 'alpha';
 count 
-------
   300
(1 row)

RESET SESSION AUTHORIZATION;
SET SESSION AUTHORIZATION rrd_other;
CREATE INDEX CONCURRENTLY conc_x ON rrd.conc USING sift (body);
ERROR:  must be owner of table conc
REINDEX INDEX CONCURRENTLY rrd.conc_idx;
ERROR:  permission denied for index conc_idx
REINDEX TABLE CONCURRENTLY rrd.conc;
ERROR:  permission denied for table conc
DROP INDEX CONCURRENTLY rrd.conc_idx;
ERROR:  must be owner of index conc_idx
RESET SESSION AUTHORIZATION;
SET SESSION AUTHORIZATION rrd_member;
DROP INDEX CONCURRENTLY rrd.conc_idx;
DROP INDEX CONCURRENTLY rrd.conc_col;
DROP TABLE rrd.conc;
RESET SESSION AUTHORIZATION;
-- introspection and the writers of the 5.0 catalogs as ordinary roles: one rule for every view and inspector (sift._may_inspect: SELECT on the table, a
-- maintain right, or pg_monitor), and the owner of a table defines projections and follows pairs without any right on the sift tables
GRANT USAGE ON SCHEMA sift TO PUBLIC;
CREATE ROLE rrd_monitor IN ROLE pg_monitor;
GRANT USAGE ON SCHEMA rrd TO rrd_monitor;
SELECT * FROM rr_run($$
rrd_owner | CREATE TABLE rrd.ins (id int PRIMARY KEY, member int, tenant int, kind text, g int, v float8)
rrd_owner | INSERT INTO rrd.ins SELECT i, i, i % 7, 'k' || i % 5, i % 3, i FROM generate_series(1, 300) i
rrd_owner | CREATE INDEX ins_col ON rrd.ins USING sift_col (id, member, tenant, kind, g, v)
rrd_owner | CREATE INDEX ins_bm ON rrd.ins USING sift (kind)
rrd_owner | CREATE TABLE rrd.pairs (member int, tenant int, UNIQUE (member, tenant))
rrd_owner | CREATE VIEW rrd.pairs_v AS SELECT member, tenant FROM rrd.ins
rrd_owner | GRANT SELECT ON rrd.ins TO rrd_reader
rrd_owner | GRANT INSERT ON rrd.ins TO rrd_writer
rrd_owner | SELECT sift.projection_create('rrd_p', 'rrd.ins', ARRAY['member', 'tenant', 'kind'])
rrd_owner | SELECT * FROM sift.scope_follow_pairs('rrd.pairs', 'rrd.pairs_v', 'rrd.ins', 'member', 'member')
rrd_writer | INSERT INTO rrd.ins VALUES (301, 301, 1, 'k1', 1, 301)
$$);
 n  |    role    |                                               stmt                                               |   result    
----+------------+--------------------------------------------------------------------------------------------------+-------------
  1 | rrd_owner  | CREATE TABLE rrd.ins (id int PRIMARY KEY, member int, tenant int, kind text, g int, v float8)    | ok
  2 | rrd_owner  | INSERT INTO rrd.ins SELECT i, i, i % 7, 'k' || i % 5, i % 3, i FROM generate_series(1, 300) i    | ok (300)
  3 | rrd_owner  | CREATE INDEX ins_col ON rrd.ins USING sift_col (id, member, tenant, kind, g, v)                  | ok
  4 | rrd_owner  | CREATE INDEX ins_bm ON rrd.ins USING sift (kind)                                                 | ok
  5 | rrd_owner  | CREATE TABLE rrd.pairs (member int, tenant int, UNIQUE (member, tenant))                         | ok
  6 | rrd_owner  | CREATE VIEW rrd.pairs_v AS SELECT member, tenant FROM rrd.ins                                    | ok
  7 | rrd_owner  | GRANT SELECT ON rrd.ins TO rrd_reader                                                            | ok
  8 | rrd_owner  | GRANT INSERT ON rrd.ins TO rrd_writer                                                            | ok
  9 | rrd_owner  | SELECT sift.projection_create('rrd_p', 'rrd.ins', ARRAY['member', 'tenant', 'kind'])             | ok: ("")
 10 | rrd_owner  | SELECT * FROM sift.scope_follow_pairs('rrd.pairs', 'rrd.pairs_v', 'rrd.ins', 'member', 'member') | ok: (300,0)
 11 | rrd_writer | INSERT INTO rrd.ins VALUES (301, 301, 1, 'k1', 1, 301)                                           | ok (1)
(11 rows)

SELECT * FROM rr_run($$
rrd_owner | SELECT count(*) FROM rrd.pairs
rrd_owner | SELECT count(*) FROM sift.projections
rrd_owner | SELECT * FROM sift.scope_expire_pairs('rrd.pairs')
rrd_owner | SELECT sift.scope_unfollow_pairs('rrd.pairs')
rrd_owner | SELECT * FROM sift.scope_follow_pairs('rrd.pairs', 'rrd.pairs_v', 'rrd.ins', 'member', 'member')
