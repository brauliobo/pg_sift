-- a role that is not the owner: every statement that changes the table or its indexes is refused with the usual error, never one about the
-- sift schema or its tables
SELECT * FROM rr_run($$
rrd_owner | CREATE TABLE rrd.docs (id int PRIMARY KEY, body text, g int, v float8, doc jsonb)
rrd_owner | INSERT INTO rrd.docs SELECT i, 'alpha beta ' || i, i % 3, i, '{"a": 1}' FROM generate_series(1, 300) i
rrd_owner | CREATE INDEX docs_idx ON rrd.docs USING sift (body)
rrd_owner | CREATE INDEX docs_col ON rrd.docs USING sift_col (id, g, v)
rrd_owner | CREATE TABLE rrd.facts (id int, g int, val float8, doc jsonb) USING sift_table
rrd_owner | INSERT INTO rrd.facts SELECT i, i % 3, i, '{"a": 1}' FROM generate_series(1, 300) i
rrd_owner | GRANT SELECT ON rrd.docs, rrd.facts TO rrd_reader, rrd_writer
rrd_owner | GRANT INSERT, UPDATE, DELETE ON rrd.docs, rrd.facts TO rrd_writer
$$);
 n |   role    |                                                  stmt                                                  |  result  
---+-----------+--------------------------------------------------------------------------------------------------------+----------
 1 | rrd_owner | CREATE TABLE rrd.docs (id int PRIMARY KEY, body text, g int, v float8, doc jsonb)                      | ok
 2 | rrd_owner | INSERT INTO rrd.docs SELECT i, 'alpha beta ' || i, i % 3, i, '{"a": 1}' FROM generate_series(1, 300) i | ok (300)
 3 | rrd_owner | CREATE INDEX docs_idx ON rrd.docs USING sift (body)                                                    | ok
 4 | rrd_owner | CREATE INDEX docs_col ON rrd.docs USING sift_col (id, g, v)                                            | ok
 5 | rrd_owner | CREATE TABLE rrd.facts (id int, g int, val float8, doc jsonb) USING sift_table                         | ok
 6 | rrd_owner | INSERT INTO rrd.facts SELECT i, i % 3, i, '{"a": 1}' FROM generate_series(1, 300) i                    | ok (300)
 7 | rrd_owner | GRANT SELECT ON rrd.docs, rrd.facts TO rrd_reader, rrd_writer                                          | ok
 8 | rrd_owner | GRANT INSERT, UPDATE, DELETE ON rrd.docs, rrd.facts TO rrd_writer                                      | ok
(8 rows)

SELECT * FROM rr_matrix(ARRAY['rrd_other', 'rrd_writer', 'rrd_reader', 'rrd_none'], $$
CREATE INDEX x_idx ON rrd.docs USING sift (body)
CREATE INDEX x_col ON rrd.docs USING sift_col (g)
CREATE INDEX x_btree ON rrd.facts (g)
DROP INDEX rrd.docs_idx
DROP INDEX rrd.docs_col
REINDEX INDEX rrd.docs_idx
REINDEX INDEX rrd.docs_col
REINDEX TABLE rrd.facts
ALTER INDEX rrd.docs_idx RENAME TO x
ALTER TABLE rrd.docs ADD COLUMN z int
ALTER TABLE rrd.facts ADD COLUMN z int
ALTER TABLE rrd.docs ALTER COLUMN v TYPE float4
ALTER TABLE rrd.docs SET ACCESS METHOD heap
ALTER TABLE rrd.facts SET ACCESS METHOD heap
ALTER TABLE rrd.docs SET SCHEMA rrd2
ALTER TABLE rrd.docs RENAME TO x
ALTER TABLE rrd.docs OWNER TO rrd_other
TRUNCATE rrd.docs
TRUNCATE rrd.facts
DROP TABLE rrd.docs
DROP TABLE rrd.facts
DROP TABLE rrd.docs, rrd.facts
DROP SCHEMA rrd CASCADE
DROP OWNED BY rrd_owner
REASSIGN OWNED BY rrd_owner TO rrd_other
$$);
                       stmt                        |                    result                    |                   by_role                   
---------------------------------------------------+----------------------------------------------+---------------------------------------------
 CREATE INDEX x_idx ON rrd.docs USING sift (body)  | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 CREATE INDEX x_col ON rrd.docs USING sift_col (g) | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 CREATE INDEX x_btree ON rrd.facts (g)             | ERROR: must be owner of table facts          | rrd_other, rrd_writer, rrd_reader, rrd_none
 DROP INDEX rrd.docs_idx                           | ERROR: must be owner of index docs_idx       | rrd_other, rrd_writer, rrd_reader, rrd_none
 DROP INDEX rrd.docs_col                           | ERROR: must be owner of index docs_col       | rrd_other, rrd_writer, rrd_reader, rrd_none
 REINDEX INDEX rrd.docs_idx                        | ERROR: permission denied for index docs_idx  | rrd_other, rrd_writer, rrd_reader, rrd_none
 REINDEX INDEX rrd.docs_col                        | ERROR: permission denied for index docs_col  | rrd_other, rrd_writer, rrd_reader, rrd_none
 REINDEX TABLE rrd.facts                           | ERROR: permission denied for table facts     | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER INDEX rrd.docs_idx RENAME TO x              | ERROR: must be owner of index docs_idx       | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.docs ADD COLUMN z int             | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.facts ADD COLUMN z int            | ERROR: must be owner of table facts          | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.docs ALTER COLUMN v TYPE float4   | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.docs SET ACCESS METHOD heap       | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.facts SET ACCESS METHOD heap      | ERROR: must be owner of table facts          | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.docs SET SCHEMA rrd2              | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.docs RENAME TO x                  | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 ALTER TABLE rrd.docs OWNER TO rrd_other           | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 TRUNCATE rrd.docs                                 | ERROR: permission denied for table docs      | rrd_other, rrd_writer, rrd_reader, rrd_none
 TRUNCATE rrd.facts                                | ERROR: permission denied for table facts     | rrd_other, rrd_writer, rrd_reader, rrd_none
 DROP TABLE rrd.docs                               | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 DROP TABLE rrd.facts                              | ERROR: must be owner of table facts          | rrd_other, rrd_writer, rrd_reader, rrd_none
 DROP TABLE rrd.docs, rrd.facts                    | ERROR: must be owner of table docs           | rrd_other, rrd_writer, rrd_reader, rrd_none
 DROP SCHEMA rrd CASCADE                           | ERROR: must be owner of schema rrd           | rrd_other, rrd_writer, rrd_reader, rrd_none
