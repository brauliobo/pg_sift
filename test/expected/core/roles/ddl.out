  2 | rrd_owner  | INSERT INTO rrd.exp SELECT i, current_date - 1 FROM generate_series(1, 5) i                                               | ok (5)
  3 | rrd_owner  | CREATE TABLE rrd.exp_pairs (member int, tenant int, UNIQUE (member, tenant))                                              | ok
  4 | rrd_owner  | CREATE VIEW rrd.exp_v AS SELECT member, 1 AS tenant FROM rrd.exp                                                          | ok
  5 | rrd_owner  | SELECT * FROM sift.scope_follow_pairs('rrd.exp_pairs', 'rrd.exp_v', 'rrd.exp', 'member', 'member', 'ends')                | ok: (5,0)
  6 | rrd_owner  | CREATE OR REPLACE VIEW rrd.exp_v AS SELECT member, 1 AS tenant FROM rrd.exp WHERE 1 / (member - member) > 0 OR member > 0 | ok
  7 | rrd_other  | SELECT * FROM sift.scope_expire_pairs('rrd.exp_pairs', '1 year')                                                          | ERROR: must be owner of table exp_pairs
