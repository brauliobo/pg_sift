-- schemas and ownership: the owner creates a schema (the database CREATE privilege) and drops it with everything in it; DROP OWNED and
-- REASSIGN OWNED fire the drop trigger for sift tables too. DROP OWNED warns that it revoked nothing and names the database, whose name
-- depends on how the tests are run
SET client_min_messages = error;
SELECT * FROM rr_run($$
rrd_owner | CREATE SCHEMA rrd_own
rrd_owner | CREATE TABLE rrd_own.docs (id int, body text)
rrd_owner | CREATE INDEX ON rrd_own.docs USING sift (body)
rrd_owner | CREATE INDEX ON rrd_own.docs USING sift_col (id)
rrd_owner | CREATE TABLE rrd_own.facts (id int, val int) USING sift_table
rrd_other | DROP SCHEMA rrd_own CASCADE
rrd_other | DROP SCHEMA rrd_own
rrd_owner | DROP SCHEMA rrd_own
rrd_owner | DROP SCHEMA rrd_own CASCADE
rrd_owner | CREATE TABLE rrd.docs (id int, body text)
rrd_owner | CREATE INDEX ON rrd.docs USING sift (body)
rrd_owner | CREATE TABLE rrd.facts (id int, val int) USING sift_table
rrd_member | REASSIGN OWNED BY rrd_owner TO rrd_member
rrd_member | ALTER TABLE rrd.docs ADD COLUMN z int
rrd_owner | DROP OWNED BY rrd_owner
rrd_member | DROP OWNED BY rrd_member
$$);
 n  |    role    |                             stmt                              |                                result                                
----+------------+---------------------------------------------------------------+----------------------------------------------------------------------
  1 | rrd_owner  | CREATE SCHEMA rrd_own                                         | ok
  2 | rrd_owner  | CREATE TABLE rrd_own.docs (id int, body text)                 | ok
  3 | rrd_owner  | CREATE INDEX ON rrd_own.docs USING sift (body)                | ok
  4 | rrd_owner  | CREATE INDEX ON rrd_own.docs USING sift_col (id)              | ok
  5 | rrd_owner  | CREATE TABLE rrd_own.facts (id int, val int) USING sift_table | ok
  6 | rrd_other  | DROP SCHEMA rrd_own CASCADE                                   | ERROR: must be owner of schema rrd_own
  7 | rrd_other  | DROP SCHEMA rrd_own                                           | ERROR: must be owner of schema rrd_own
  8 | rrd_owner  | DROP SCHEMA rrd_own                                           | ERROR: cannot drop schema rrd_own because other objects depend on it
  9 | rrd_owner  | DROP SCHEMA rrd_own CASCADE                                   | ok
 10 | rrd_owner  | CREATE TABLE rrd.docs (id int, body text)                     | ok
 11 | rrd_owner  | CREATE INDEX ON rrd.docs USING sift (body)                    | ok
 12 | rrd_owner  | CREATE TABLE rrd.facts (id int, val int) USING sift_table     | ok
 13 | rrd_member | REASSIGN OWNED BY rrd_owner TO rrd_member                     | ok
 14 | rrd_member | ALTER TABLE rrd.docs ADD COLUMN z int                         | ok
 15 | rrd_owner  | DROP OWNED BY rrd_owner                                       | ok
 16 | rrd_member | DROP OWNED BY rrd_member                                      | ok
(16 rows)

