-- a child index connected to the index of a table another role owns: the child's owner lists the connection, and sees the state of the parent journal only where it may look at the parent
SELECT * FROM rr_run($$
rrd_other | CREATE TABLE rrd.dim (id int PRIMARY KEY, c int)
rrd_other | CREATE INDEX dim_col ON rrd.dim USING sift_col (id, c)
rrd_owner | CREATE TABLE rrd.fact (id int PRIMARY KEY, dim_id int NOT NULL)
rrd_owner | CREATE INDEX fact_col ON rrd.fact USING sift_col (id, dim_id) WITH (connect = 'dim_id -> rrd.dim(id)')
rrd_owner | SELECT child, parent, stamp FROM sift.col_connections
rrd_other | GRANT SELECT ON rrd.dim TO rrd_owner
rrd_owner | SELECT child, parent, stamp FROM sift.col_connections
$$);
 n |   role    |                                                  stmt                                                  |                 result                 
---+-----------+--------------------------------------------------------------------------------------------------------+----------------------------------------
 1 | rrd_other | CREATE TABLE rrd.dim (id int PRIMARY KEY, c int)                                                       | ok
 2 | rrd_other | CREATE INDEX dim_col ON rrd.dim USING sift_col (id, c)                                                 | ok
 3 | rrd_owner | CREATE TABLE rrd.fact (id int PRIMARY KEY, dim_id int NOT NULL)                                        | ok
 4 | rrd_owner | CREATE INDEX fact_col ON rrd.fact USING sift_col (id, dim_id) WITH (connect = 'dim_id -> rrd.dim(id)') | ok
 5 | rrd_owner | SELECT child, parent, stamp FROM sift.col_connections                                                  | ok: (rrd.fact_col,rrd.dim_col,)
 6 | rrd_other | GRANT SELECT ON rrd.dim TO rrd_owner                                                                   | ok
 7 | rrd_owner | SELECT child, parent, stamp FROM sift.col_connections                                                  | ok: (rrd.fact_col,rrd.dim_col,trimmed)
(7 rows)

