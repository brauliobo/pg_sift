-- The registry of the keys a transaction holds in its stage (col/f2/uniq/shm.c): an entry that cannot be listed for its transaction is not made, a stripe that dead transactions filled takes a
-- new entry, the entries of the rows that a flush wrote to the partitions are let go, and the first check of a deferred constraint inserts the row it reports a conflict for.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET client_min_messages = warning;
SET max_parallel_maintenance_workers = 0;
SET max_parallel_workers_per_gather = 0;
DO $$ BEGIN
	IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN
		PERFORM set_config('sift.test_create_format1', 'off', false);
	END IF;
END $$;
CREATE FUNCTION pg_temp.active() RETURNS int8 AS 'pg_sift', 'sift_test_uniq_shm_active' LANGUAGE C STRICT;
CREATE FUNCTION pg_temp.fill(stripe int, n int, xid int8) RETURNS int AS 'pg_sift', 'sift_test_uniq_shm_fill' LANGUAGE C STRICT;
CREATE FUNCTION pg_temp.reserve_one(stripe int) RETURNS bool AS 'pg_sift', 'sift_test_uniq_shm_reserve_one' LANGUAGE C STRICT;
CREATE FUNCTION pg_temp.sweep(stripe int) RETURNS void AS 'pg_sift', 'sift_test_uniq_shm_sweep' LANGUAGE C STRICT;
CREATE FUNCTION pg_temp.partial_insert(regclass, int) RETURNS text AS 'pg_sift', 'sift_test_unique_partial_insert' LANGUAGE C STRICT;
CREATE FUNCTION pg_temp.state_of(stmt text) RETURNS text LANGUAGE plpgsql AS
$$ BEGIN EXECUTE stmt; RETURN 'ok'; EXCEPTION WHEN OTHERS THEN RETURN SQLSTATE; END $$;
SELECT pg_temp.active() AS base \gset
-- the list of the entries of a transaction cannot grow: no entry is left in the registry for it
SET sift.test_dsm_fail = 'sift_uniq_owned';
SELECT pg_temp.state_of('SELECT pg_temp.reserve_one(5)') AS refused;
 refused 
---------
 53200
(1 row)

RESET sift.test_dsm_fail;
SELECT pg_temp.active() - :base AS leaked_entries;
 leaked_entries 
----------------
              0
(1 row)

-- a stripe that the entries of ended transactions fill takes the entry of a running one, and what it held is let go with the transaction
BEGIN;
SELECT pg_temp.fill(7, 512, 3) AS filled;
 filled 
--------
    512
(1 row)

SELECT pg_temp.reserve_one(7) AS reserved_in_a_full_stripe;
 reserved_in_a_full_stripe 
---------------------------
 t
(1 row)

COMMIT;
SELECT pg_temp.active() - :base AS left_in_the_registry;
 left_in_the_registry 
----------------------
                    0
(1 row)

-- a stripe that the entries of a running transaction fill borrows spare entries, and its sweep gives back the borrowed ones of the transactions that ended
BEGIN;
SELECT pg_temp.fill(9, 512, txid_current()) AS filled;
 filled 
--------
    512
(1 row)

SELECT pg_temp.fill(9, 50, 3) AS borrowed;
 borrowed 
----------
       50
(1 row)

SELECT pg_temp.sweep(9);
 sweep 
-------
 
(1 row)

SELECT pg_temp.active() - :base AS kept_by_the_sweep;
 kept_by_the_sweep 
-------------------
               512
(1 row)

COMMIT;
SELECT pg_temp.active() - :base AS left_in_the_registry;
 left_in_the_registry 
----------------------
                    0
(1 row)

-- a transaction that stages more keys than the work memory flushes the stage, and the entries of what it flushed are let go
CREATE TABLE af (id int, v text);
CREATE UNIQUE INDEX af_i ON af USING sift_col (id);
SET work_mem = '64kB';
BEGIN;
INSERT INTO af SELECT g, repeat('x', 100) FROM generate_series(1, 20000) g;
SELECT pg_temp.active() - :base < 10000 AS entries_of_flushed_rows_let_go;
 entries_of_flushed_rows_let_go 
--------------------------------
 t
(1 row)

COMMIT;
SELECT count(*) AS rows, pg_temp.active() - :base AS left_in_the_registry FROM af;
 rows  | left_in_the_registry 
-------+----------------------
 20000 |                    0
(1 row)

RESET work_mem;
-- the first check of a deferred constraint inserts the row it reports a conflict for: the check of the end of the transaction finds the row to judge
CREATE TABLE pt (id int);
CREATE UNIQUE INDEX pt_i ON pt USING sift_col (id);
INSERT INTO pt VALUES (1);
BEGIN;
SELECT pg_temp.partial_insert('pt_i', 1) AS conflict_returned_and_rows_staged;
 conflict_returned_and_rows_staged 
-----------------------------------
 false 1
(1 row)

SELECT pg_temp.partial_insert('pt_i', 2) AS no_conflict_returned_and_rows_staged;
 no_conflict_returned_and_rows_staged 
--------------------------------------
 true 2
(1 row)

ROLLBACK;
SELECT pg_temp.active() - :base AS left_in_the_registry;
 left_in_the_registry 
----------------------
                    0
(1 row)

DROP TABLE af;
DROP TABLE pt;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
