 same scope SELECT count(*), sum(f.n) FROM by_time f JOIN pairs s ON s.member = f.member WHERE s.grp = 1 AND f.at >= timestamptz '2026-03-03 04:00' AND f.at < timestamptz '2026-03-29 11:00'
 same scope SELECT count(*), sum(f.n) FROM by_time f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-03-03 04:00' AND f.at < timestamptz '2026-03-29 11:00'
 same scope SELECT count(*), sum(f.n) FROM by_time f JOIN pairs s ON s.member = f.member WHERE s.grp = ANY(ARRAY[1, 2, 5])
