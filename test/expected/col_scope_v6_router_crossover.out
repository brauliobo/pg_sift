-- the rolling window of every month boundary of the series
SELECT answer(format('SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz %L AND f.at < timestamptz %L', d::text, (d + interval '90 days')::text))
FROM generate_series(timestamptz '2026-01-01', timestamptz '2026-12-31', interval '47 days 7 hours') d;
                                                                                                   answer                                                                                                   
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-01-01 00:00:00+00' AND f.at < timestamptz '2026-04-01 00:00:00+00'
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-02-17 07:00:00+00' AND f.at < timestamptz '2026-05-18 07:00:00+00'
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-04-05 14:00:00+00' AND f.at < timestamptz '2026-07-04 14:00:00+00'
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-05-22 21:00:00+00' AND f.at < timestamptz '2026-08-20 21:00:00+00'
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-07-09 04:00:00+00' AND f.at < timestamptz '2026-10-07 04:00:00+00'
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-08-25 11:00:00+00' AND f.at < timestamptz '2026-11-23 11:00:00+00'
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-10-11 18:00:00+00' AND f.at < timestamptz '2027-01-09 18:00:00+00'
 same scope SELECT count(*), sum(f.n) FROM by_member f JOIN pairs s ON s.member = f.member WHERE s.grp = 2 AND f.at >= timestamptz '2026-11-28 01:00:00+00' AND f.at < timestamptz '2027-02-26 01:00:00+00'
