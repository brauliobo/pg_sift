CREATE TABLE all2 AS SELECT * FROM sift._test_col_wbuf_keyed('t2f_idx', 11, NULL, NULL);
CREATE TABLE ranges2 (lo int8, hi int8);
INSERT INTO ranges2 VALUES (-1000, -990), (0, 0), (5, 50), (-1000, 1000), (-9223372036854775808, -9223372036854775808),
	(9223372036854775807, 9223372036854775807), (100000, 200000), (-9223372036854775808, 9223372036854775807);
SELECT r.lo, r.hi, (SELECT count(*) FROM all2 f WHERE f.key BETWEEN r.lo AND r.hi
		AND NOT EXISTS (SELECT 1 FROM sift._test_col_wbuf_keyed('t2_idx', 11, r.lo, r.hi) k WHERE k.id = f.id)) AS lost
FROM ranges2 r ORDER BY 1, 2;
          lo          |          hi          | lost 
----------------------+----------------------+------
 -9223372036854775808 | -9223372036854775808 |    0
 -9223372036854775808 |  9223372036854775807 |    0
                -1000 |                 -990 |    0
                -1000 |                 1000 |    0
                    0 |                    0 |    0
                    5 |                   50 |    0
               100000 |               200000 |    0
  9223372036854775807 |  9223372036854775807 |    0
(8 rows)

-- a row whose key is an overflow value has no key to compare and is in every read of keys, whatever the range of its page
SELECT count(*) FILTER (WHERE unknown) > 0 AS has_unknown FROM all2;
 has_unknown 
-------------
