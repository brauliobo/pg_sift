		AND NOT EXISTS (SELECT 1 FROM sift._test_col_wbuf_keyed('t2_idx', 11, r.lo, r.hi) k WHERE k.id = f.id)) AS lost_unknown
FROM ranges2 r ORDER BY 1, 2;
          lo          |          hi          | lost_unknown 
