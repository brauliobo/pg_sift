-- sift.col_wbuf_key_range: the pages of a write buffer of column format 55 hold the range of one integer key leaf (the first of the key_cut of the index), and a scan that
-- asks for keys reads only the pages whose range meets them (col/v1/wbuf/read.c, sift_cwbuf_batches_keys). The leaf is order_id (leaf 0: the id of the row, so each page holds a range of
-- ids; the rows are small but the three of 1,000 items span pages) and then tenant_id (leaf 1: random, NULL, overflow and extreme values, so most pages meet most ranges). A read that skips
-- pages never loses a row of the keys. A buffer that a whole read has kept is read from the kept set, and so is one whose reads of keys this backend has made have decoded what the buffer holds.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
-- Format 1: the write buffer is a Format 1 structure; Format 2.0 ignores write_buffer_limit.
SET sift.test_create_format1 = on;
CREATE TABLE t (doc int);
CREATE INDEX t_idx ON t USING sift_col (doc) WITH (write_buffer_limit = 4096);
NOTICE:  sift_col index "t_idx": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('t_idx');
SELECT sift._test_col_wbuf_prepare('t_idx', 0, 0, true) IS NOT NULL AS prepared;
 prepared 
----------
 t
(1 row)

SELECT sift._test_col_wbuf_append('t_idx', 7, 0, 3000) >= 0 AS appended;
 appended 
----------
 t
(1 row)

-- every page of the buffer says its leaf and its range
SELECT count(*) > 16 AS pages, bool_and(leaf = 0) FILTER (WHERE nrecs > 0) AS leaf_zero, bool_and(kmin <= kmax) AS ordered,
	   count(*) FILTER (WHERE nrecs > 0 AND kmin IS NULL) AS without_range, count(*) FILTER (WHERE flags & 2 <> 0) > 0 AS spans
FROM sift._test_col_wbuf_pages('t_idx');
 pages | leaf_zero | ordered | without_range | spans 
-------+-----------+---------+---------------+-------
 t     | t         | t       |             0 | t
(1 row)

-- the first read of the keys 1000 to 1100 decodes the pages that meet them, and every row of those keys is in it
CREATE TABLE part AS SELECT * FROM sift._test_col_wbuf_keyed('t_idx', 7, 1000, 1100);
SELECT count(*) < 3000 AS fewer_rows, bool_and(partial) AS partial, count(*) FILTER (WHERE id BETWEEN 1000 AND 1100) AS wanted FROM part;
 fewer_rows | partial | wanted 
------------+---------+--------
 t          | t       |    101
(1 row)

-- the rows of every range are all there, the one of a row that spans pages and the ones next to it too
CREATE TABLE ranges (lo int8, hi int8);
INSERT INTO ranges VALUES (0, 0), (0, 40), (998, 1000), (999, 999), (1000, 1000), (1999, 2001), (2500, 2600), (2990, 2999), (2999, 5000), (-50, 10), (3000, 4000), (900000, 900001);
SELECT r.lo, r.hi, count(k.id) FILTER (WHERE k.id BETWEEN r.lo AND r.hi) = greatest(least(r.hi, 2999) - greatest(r.lo, 0) + 1, 0) AS every_row
FROM ranges r LEFT JOIN LATERAL sift._test_col_wbuf_keyed('t_idx', 7, r.lo, r.hi) k ON true GROUP BY r.lo, r.hi ORDER BY 1, 2;
   lo   |   hi   | every_row 
--------+--------+-----------
    -50 |     10 | t
      0 |      0 | t
      0 |     40 | t
    998 |   1000 | t
    999 |    999 | t
   1000 |   1000 | t
   1999 |   2001 | t
   2500 |   2600 | t
   2990 |   2999 | t
   2999 |   5000 | t
   3000 |   4000 | t
 900000 | 900001 | t
(12 rows)

-- a read of every row keeps the set, and the reads of keys that follow are read from it
CREATE TABLE allrows AS SELECT * FROM sift._test_col_wbuf_keyed('t_idx', 7, NULL, NULL);
SELECT count(*) AS rows, count(DISTINCT id) AS ids, bool_or(partial) AS partial FROM allrows;
 rows | ids  | partial 
------+------+---------
 3000 | 3000 | f
(1 row)

SELECT count(*) = 3000 AS from_kept_set, bool_or(partial) AS partial FROM sift._test_col_wbuf_keyed('t_idx', 7, 1000, 1100);
 from_kept_set | partial 
---------------+---------
 t             | f
(1 row)

-- VACUUM flags and rows appended since are in the next read of the keys
SELECT sift._test_col_wbuf_delete('t_idx', 5) AS flagged;
 flagged 
---------
     600
(1 row)

SELECT sift._test_col_wbuf_append('t_idx', 7, 3000, 500) >= 0 AS appended;
 appended 
----------
 t
(1 row)

SELECT count(*) FILTER (WHERE id BETWEEN 2900 AND 3099) AS wanted, count(*) FILTER (WHERE id BETWEEN 2900 AND 2999 AND id % 5 = 0) AS dead
FROM sift._test_col_wbuf_keyed('t_idx', 7, 2900, 3099);
 wanted | dead 
--------+------
    180 |    0
(1 row)

SELECT sift._test_check('t_idx') AS orphans;
 orphans 
---------
       0
(1 row)

-- the reads of keys of a backend go on while what they decoded is less than the buffer holds: four fifths of it takes the reads of a quarter of it, the fifth is a whole read whose set is kept
-- (every read of keys above is the first of a backend that has not written the buffer: cold)
CREATE TABLE t4 (doc int);
CREATE INDEX t4_idx ON t4 USING sift_col (doc) WITH (write_buffer_limit = 4096);
NOTICE:  sift_col index "t4_idx": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('t4_idx');
SELECT sift._test_col_wbuf_prepare('t4_idx', 0, 0, true) IS NOT NULL AS prepared;
 prepared 
----------
 t
(1 row)

SELECT sift._test_col_wbuf_append('t4_idx', 7, 0, 1000) >= 0 AS appended;
 appended 
----------
 t
(1 row)

SELECT count(*) < 1000 AS fewer_rows, bool_and(partial) AS partial FROM sift._test_col_wbuf_keyed('t4_idx', 7, 0, 250);
 fewer_rows | partial 
------------+---------
 t          | t
(1 row)

SELECT bool_and(partial) AS partial FROM sift._test_col_wbuf_keyed('t4_idx', 7, 0, 250, false);
 partial 
---------
 t
(1 row)

SELECT bool_and(partial) AS partial FROM sift._test_col_wbuf_keyed('t4_idx', 7, 0, 250, false);
 partial 
---------
 t
(1 row)

SELECT count(*) >= 0 AS fourth FROM sift._test_col_wbuf_keyed('t4_idx', 7, 0, 250, false);
 fourth 
--------
 t
(1 row)

SELECT count(*) AS rows, bool_or(partial) AS partial FROM sift._test_col_wbuf_keyed('t4_idx', 7, 10, 20, false);
 rows | partial 
------+---------
 1000 | f
(1 row)

