-- The rows a transaction updates are flushed to the index of Format 2.0 when it commits, with the index expressions computed again from the heap: an expression that calls an SQL function
-- (not inlined: a subselect with an aggregate) needs a snapshot, which the commit does not have unless the flush takes one. The UPDATE of rows that are still in the buffer of the index
-- commits, and the index answers as the heap does.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET sift.test_create_format1 = off;
SET max_parallel_workers_per_gather = 0;
CREATE FUNCTION norm(j jsonb) RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$
	SELECT coalesce(jsonb_agg(o ORDER BY ord), '[]') FROM jsonb_array_elements(j -> 'parts') WITH ORDINALITY t(o, ord) $$;
CREATE TABLE xp (id int PRIMARY KEY, g int, doc jsonb) WITH (autovacuum_enabled = false);
INSERT INTO xp SELECT i, i % 20, jsonb_build_object('parts', jsonb_build_array(i % 7, i % 5)) FROM generate_series(1, 20000) i;
CREATE INDEX xp_col ON xp USING sift_col (id, g, (norm(doc))) WITH (paths = 'norm[] int4');
INSERT INTO xp SELECT 20000 + i, i % 20, jsonb_build_object('parts', jsonb_build_array(i % 7, i % 5)) FROM generate_series(1, 4000) i;
UPDATE xp SET g = g + 1 WHERE id % 30 = 0;
DELETE FROM xp WHERE id % 31 = 0;
CREATE FUNCTION same(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (' || q || ') r' INTO a;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (' || q || ') r' INTO b;
	RETURN CASE WHEN a = b THEN 'same' ELSE 'DIFFERENT' END;
END $$;
SELECT same('SELECT g, count(*), sum(id) FROM xp GROUP BY g');
 same 
------
 same
(1 row)

SELECT count(*), sum(g) FROM xp;
 count |  sum   
-------+--------
 23226 | 221420
(1 row)

DROP TABLE xp;
DROP FUNCTION same(text);
DROP FUNCTION norm(jsonb);
DROP EXTENSION pg_sift;
