-- A relation that is written to all the time keeps answering from its projections: deletes that grow a deletion vector, pending deletes, rows dead in the heap, heap-only updates, new rows in
-- the slab and a vacuum in between never change an answer, and the projections are still the source of the sealed parts (Spec 50: the overlay takes the dead rows away, once).
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
\set VERBOSITY terse
\i test/proj_helpers.sql
-- Helpers of the projection tests: the answer through the index against the answer of the heap, whether a projection was read, and a check that raises.
CREATE FUNCTION p_check(label text, ok boolean) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'check failed: %', label; END IF;
	RETURN 'ok';
END $$;
CREATE FUNCTION p_rows(q text, via_index boolean) RETURNS text LANGUAGE plpgsql AS $$
DECLARE res text;
BEGIN
	IF via_index THEN
		SET LOCAL enable_seqscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_indexonlyscan = off;
	ELSE
		SET LOCAL enable_seqscan = on; SET LOCAL enable_indexscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL sift.enable_agg = off;
	END IF;
	EXECUTE format('SELECT coalesce(string_agg(r::text, '','' ORDER BY r::text), '''') FROM (%s) r', q) INTO res;
	RETURN res;
END $$;
CREATE FUNCTION p_rows_ordered(q text, via_index boolean) RETURNS text LANGUAGE plpgsql AS $$
DECLARE res text;
BEGIN
	IF via_index THEN
		SET LOCAL enable_seqscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_indexonlyscan = off;
	ELSE
		SET LOCAL enable_seqscan = on; SET LOCAL enable_indexscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL sift.enable_agg = off;
	END IF;
	EXECUTE format('SELECT coalesce(string_agg(r::text, '',''), '''') FROM (%s) r', q) INTO res;
	RETURN res;
END $$;
CREATE FUNCTION p_same(q text) RETURNS text LANGUAGE sql AS
$$ SELECT CASE WHEN p_rows(q, true) = p_rows(q, false) THEN 'same' ELSE 'DIFFERENT: ' || p_rows(q, true) || ' / ' || p_rows(q, false) END $$;
CREATE FUNCTION p_same_order(q text, heap_q text) RETURNS text LANGUAGE sql AS
$$ SELECT CASE WHEN p_rows_ordered(q, true) = p_rows_ordered(heap_q, false) THEN 'same' ELSE 'DIFFERENT: ' || p_rows_ordered(q, true) || ' / ' || p_rows_ordered(heap_q, false) END $$;
CREATE FUNCTION p_uses(q text, proj text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE line text; found boolean := false;
BEGIN
	SET LOCAL enable_seqscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_indexonlyscan = off;
	FOR line IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) ' || q LOOP
		found := found OR line LIKE '%Projection: ' || proj || '%';
	END LOOP;
	RETURN found;
END $$;
CREATE TABLE c (id bigint, tenant int, status text, amount bigint, day date, note text);
CREATE INDEX c_idx ON c USING sift_col (id, tenant, status, amount, day) WITH (key_order = 'id');
INSERT INTO c SELECT i, i % 5, (ARRAY['new', 'open', 'closed'])[1 + i % 3], i % 50, DATE '2026-01-01' + (i % 120), 'n' || i FROM generate_series(1, 20000) i;
SELECT sift.create_projection('c_idx', 'c_agg', 'GROUP BY tenant, status MEASURES count(*), sum(amount), count(DISTINCT amount)');
 create_projection 
-------------------
 t
(1 row)

SELECT sift.create_projection('c_idx', 'c_open', 'GROUP BY tenant MEASURES count(*), sum(amount) FILTER (WHERE status = ''open'') WHERE amount >= 10');
 create_projection 
-------------------
 t
(1 row)

SELECT sift.create_projection('c_idx', 'c_by_amount', 'ORDER BY tenant, amount, id INCLUDE (status)');
 create_projection 
-------------------
 t
(1 row)

VACUUM c;
SELECT p_check('agg served', p_uses('SELECT tenant, status, count(*), sum(amount) FROM c GROUP BY tenant, status', 'c_agg'));
 p_check 
---------
 ok
(1 row)

SELECT p_check('sort served', p_uses('SELECT id FROM c WHERE tenant = 2 ORDER BY amount, id LIMIT 10', 'c_by_amount'));
 p_check 
---------
 ok
(1 row)

-- Each round writes, and every answer is the heap's; the projections stay the chosen source
CREATE FUNCTION churn(round int) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	DELETE FROM c WHERE id % 97 = round % 97;
	UPDATE c SET note = note || 'x' WHERE id % 89 = round % 89;
	UPDATE c SET amount = (amount + 7) % 50 WHERE id % 211 = round % 211;
	INSERT INTO c SELECT 100000 + round * 20 + g, g % 5, 'open', g, DATE '2026-02-01' + g, 'new' FROM generate_series(1, 20) g;
END $$;
CREATE FUNCTION churn_rounds(first int, last int) RETURNS void LANGUAGE plpgsql AS $$
DECLARE r int; q text;
BEGIN
	FOR r IN first..last LOOP
		PERFORM churn(r);
		FOREACH q IN ARRAY ARRAY[
			'SELECT tenant, status, count(*), sum(amount) FROM c GROUP BY tenant, status',
			'SELECT tenant, count(*), count(DISTINCT amount) FROM c GROUP BY tenant',
			'SELECT tenant, count(*), sum(amount) FILTER (WHERE status = ''open'') FROM c WHERE amount >= 10 GROUP BY tenant',
			'SELECT status, count(*) FROM c WHERE tenant IN (1, 3) GROUP BY status'] LOOP
			PERFORM p_check('round ' || r || ': ' || q, p_same(q) = 'same');
		END LOOP;
		PERFORM p_check('round ' || r || ' sort', p_same_order('SELECT id, amount FROM c WHERE tenant = 2 ORDER BY amount, id LIMIT 25',
															  'SELECT id, amount FROM c WHERE tenant = 2 ORDER BY amount + 0, id LIMIT 25') = 'same');
	END LOOP;
END $$;
SELECT churn_rounds(1, 10);
 churn_rounds 
--------------
 
(1 row)

VACUUM c;
SELECT churn_rounds(11, 20);
 churn_rounds 
--------------
 
(1 row)

VACUUM c;
SELECT churn_rounds(21, 30);
 churn_rounds 
--------------
 
(1 row)

VACUUM c;
SELECT p_check('agg still served', p_uses('SELECT tenant, status, count(*), sum(amount) FROM c GROUP BY tenant, status', 'c_agg'));
 p_check 
---------
 ok
(1 row)

SELECT p_check('sort still served', p_uses('SELECT id FROM c WHERE tenant = 2 ORDER BY amount, id LIMIT 10', 'c_by_amount'));
 p_check 
---------
 ok
(1 row)

-- A transaction sees its own deletes through the projection, and a snapshot taken before a delete keeps its rows
BEGIN;
DELETE FROM c WHERE tenant = 4 AND amount < 25;
SELECT p_check('own deletes', p_same('SELECT tenant, count(*), sum(amount) FROM c GROUP BY tenant') = 'same');
 p_check 
---------
 ok
(1 row)

ROLLBACK;
SELECT p_check('after rollback', p_same('SELECT tenant, count(*), sum(amount) FROM c GROUP BY tenant') = 'same');
 p_check 
---------
 ok
(1 row)

-- A heap-only update: the sort projection hands out the root of the chain and the row the snapshot sees is the one returned
UPDATE c SET note = 'changed' WHERE id BETWEEN 1000 AND 1200;
SELECT p_check('hot update', p_same_order('SELECT id, note FROM c WHERE tenant = 1 ORDER BY amount, id LIMIT 60', 'SELECT id, note FROM c WHERE tenant = 1 ORDER BY amount + 0, id LIMIT 60') = 'same');
 p_check 
---------
 ok
(1 row)

-- A partial index serves the statements its predicate implies
CREATE INDEX c_part ON c USING sift_col (id, tenant, amount) WITH (key_order = 'id') WHERE status <> 'closed';
SELECT sift.create_projection('c_part', 'c_part_sort', 'ORDER BY tenant, amount, id');
 create_projection 
-------------------
 t
(1 row)

VACUUM c;
SELECT p_check('partial index', p_same_order('SELECT id FROM c WHERE status <> ''closed'' AND tenant = 3 ORDER BY amount, id LIMIT 20',
											 'SELECT id FROM c WHERE status <> ''closed'' AND tenant = 3 ORDER BY amount + 0, id LIMIT 20') = 'same');
 p_check 
---------
 ok
(1 row)

-- A list of values, a parameter and a LIMIT that is a parameter, planned once for any value
SET plan_cache_mode = force_generic_plan;
PREPARE q_in(int[], bigint) AS SELECT id, amount FROM c WHERE tenant = ANY ($1) ORDER BY amount, id LIMIT $2;
DO $$
DECLARE via_proj text; via_heap text; n bigint;
BEGIN
	EXECUTE 'EXECUTE q_in(ARRAY[0, 2, 4], 40)';
	GET DIAGNOSTICS n = ROW_COUNT;
	PERFORM p_check('generic in list', n = 40);
	EXECUTE 'SELECT string_agg(id::text, '','') FROM (SELECT id FROM c WHERE tenant = ANY (ARRAY[0, 2, 4]) ORDER BY amount, id LIMIT 40) s' INTO via_proj;
	SET LOCAL enable_indexscan = off;
	EXECUTE 'SELECT string_agg(id::text, '','') FROM (SELECT id FROM c WHERE tenant = ANY (ARRAY[0, 2, 4]) ORDER BY amount + 0, id LIMIT 40) s' INTO via_heap;
	PERFORM p_check('in list parity', via_proj = via_heap);
END $$;
RESET plan_cache_mode;
-- A qual no cell can judge is decided on the rows the projection hands out
SELECT p_check('residual qual', p_same_order('SELECT id FROM c WHERE tenant = 1 AND (amount * 3) % 7 = 0 ORDER BY amount, id LIMIT 15',
											 'SELECT id FROM c WHERE tenant = 1 AND (amount * 3) % 7 = 0 ORDER BY amount + 0, id LIMIT 15') = 'same');
 p_check 
---------
 ok
(1 row)

SELECT count(*) FROM sift.check('c_idx', false, 100);
 count 
-------
     0
(1 row)

DROP TABLE c;
DROP FUNCTION churn(int), churn_rounds(int, int);
DROP FUNCTION p_check(text, boolean), p_rows(text, boolean), p_rows_ordered(text, boolean), p_same(text), p_same_order(text, text), p_uses(text, text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
