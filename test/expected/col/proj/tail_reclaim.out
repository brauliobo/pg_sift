-- A vacuum moves what pins the end of the file below the free space under it, projection parts and the pages of the directory included, so that the file can be cut: after a bulk delete the
-- relation shrinks, the projections still answer, and the structure of the index checks.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET maintenance_work_mem = '256MB';
\set VERBOSITY terse
\i test/proj_helpers.sql
-- Helpers of the projection tests: the answer through the index against the answer of the heap, whether a projection was read, and a check that raises.
CREATE FUNCTION p_check(label text, ok boolean) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'check failed: %', label; END IF;
	RETURN 'ok';
END $$;
CREATE FUNCTION p_rows(q text, via_index boolean) RETURNS text LANGUAGE plpgsql AS $$
DECLARE res text;
BEGIN
	IF via_index THEN
		SET LOCAL enable_seqscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_indexonlyscan = off;
	ELSE
		SET LOCAL enable_seqscan = on; SET LOCAL enable_indexscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL sift.enable_agg = off;
	END IF;
	EXECUTE format('SELECT coalesce(string_agg(r::text, '','' ORDER BY r::text), '''') FROM (%s) r', q) INTO res;
	RETURN res;
END $$;
CREATE FUNCTION p_rows_ordered(q text, via_index boolean) RETURNS text LANGUAGE plpgsql AS $$
DECLARE res text;
BEGIN
	IF via_index THEN
		SET LOCAL enable_seqscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_indexonlyscan = off;
	ELSE
		SET LOCAL enable_seqscan = on; SET LOCAL enable_indexscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL sift.enable_agg = off;
	END IF;
	EXECUTE format('SELECT coalesce(string_agg(r::text, '',''), '''') FROM (%s) r', q) INTO res;
	RETURN res;
END $$;
CREATE FUNCTION p_same(q text) RETURNS text LANGUAGE sql AS
$$ SELECT CASE WHEN p_rows(q, true) = p_rows(q, false) THEN 'same' ELSE 'DIFFERENT: ' || p_rows(q, true) || ' / ' || p_rows(q, false) END $$;
CREATE FUNCTION p_same_order(q text, heap_q text) RETURNS text LANGUAGE sql AS
$$ SELECT CASE WHEN p_rows_ordered(q, true) = p_rows_ordered(heap_q, false) THEN 'same' ELSE 'DIFFERENT: ' || p_rows_ordered(q, true) || ' / ' || p_rows_ordered(heap_q, false) END $$;
CREATE FUNCTION p_uses(q text, proj text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE line text; found boolean := false;
BEGIN
	SET LOCAL enable_seqscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_indexonlyscan = off;
	FOR line IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) ' || q LOOP
		found := found OR line LIKE '%Projection: ' || proj || '%';
	END LOOP;
	RETURN found;
END $$;
CREATE TABLE t (id bigint, g int, v bigint, pad text);
CREATE INDEX t_idx ON t USING sift_col (id, g, v, pad) WITH (key_order = 'id');
INSERT INTO t SELECT i, i % 20, i % 1000, repeat(md5(i::text), 4) FROM generate_series(1, 200000) i;
VACUUM t;
SELECT sift.create_projection('t_idx', 't_agg', 'GROUP BY g MEASURES count(*), sum(v)');
 create_projection 
-------------------
 t
(1 row)

SELECT sift.create_projection('t_idx', 't_sort', 'ORDER BY g, v, id');
 create_projection 
-------------------
 t
(1 row)

VACUUM t;
-- Rows written after the projections, behind everything else in the file
INSERT INTO t SELECT 1000000 + i, i % 20, i % 1000, repeat('z', 40) FROM generate_series(1, 20000) i;
VACUUM t;
CREATE TABLE t_size AS SELECT pg_relation_size('t_idx') AS before_bytes;
-- The bulk of the file is deleted: the free space is under the projection parts and the directory that were written last
DELETE FROM t WHERE id <= 150000;
VACUUM t;
VACUUM t;
SELECT p_check('the file was cut', pg_relation_size('t_idx') < (SELECT before_bytes FROM t_size) * 0.6);
 p_check 
---------
 ok
(1 row)

SELECT p_check('agg answers', p_same('SELECT g, count(*), sum(v) FROM t GROUP BY g') = 'same');
 p_check 
---------
 ok
(1 row)

SELECT p_check('sort answers', p_same_order('SELECT id FROM t WHERE g = 7 ORDER BY v, id LIMIT 30', 'SELECT id FROM t WHERE g = 7 ORDER BY v + 0, id LIMIT 30') = 'same');
 p_check 
---------
 ok
(1 row)

SELECT p_check('agg served', p_uses('SELECT g, count(*), sum(v) FROM t GROUP BY g', 't_agg'));
 p_check 
---------
 ok
(1 row)

SELECT p_check('sort served', p_uses('SELECT id FROM t WHERE g = 7 ORDER BY v, id LIMIT 30', 't_sort'));
 p_check 
---------
 ok
(1 row)

SELECT count(*) FROM sift.check('t_idx', false, 100);
 count 
-------
     0
(1 row)

-- Dropping a projection gives its pages back
SELECT sift.drop_projection('t_idx', 't_sort');
 drop_projection 
-----------------
 t
(1 row)

VACUUM t;
SELECT p_check('still answers', p_same('SELECT g, count(*), sum(v) FROM t GROUP BY g') = 'same');
 p_check 
---------
 ok
(1 row)

SELECT count(*) FROM sift.check('t_idx', false, 100);
 count 
-------
     0
(1 row)

DROP TABLE t, t_size;
DROP FUNCTION p_check(text, boolean), p_rows(text, boolean), p_rows_ordered(text, boolean), p_same(text), p_same_order(text, text), p_uses(text, text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
