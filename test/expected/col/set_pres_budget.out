-- The key presence summary of a unit (a bitmap, a list of offsets or a list of runs) is built for a budget of bytes. A budget no larger than the header of the summary leaves no room for a
-- bitmap or a list: nothing is built and nothing is freed that was not allocated.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET client_min_messages = warning;
-- keys too far apart for a bitmap, in a range too wide for runs: no budget of 0 or of the header size (16 bytes) holds them
SELECT sift._test_col_set_budget(ARRAY(SELECT g * 100000 FROM generate_series(1, 400) g)::int8[], b) AS bytes_for_budget_of
FROM (VALUES (0), (1), (16)) AS t(b);
 bytes_for_budget_of 
---------------------
                  -1
                  -1
                  -1
(3 rows)

-- keys that come in runs: a budget of the header alone holds no run, one that holds the runs builds them
SELECT sift._test_col_set_budget(ARRAY(SELECT g FROM generate_series(1, 4000) g WHERE g % 100 < 50)::int8[], b) AS bytes_for_budget_of
FROM (VALUES (0), (16), (24), (4096)) AS t(b);
 bytes_for_budget_of 
---------------------
                  -1
                  -1
                  -1
                 520
(4 rows)

-- a unit without a key has no summary at all
SELECT sift._test_col_set_budget('{}'::int8[], 4096) AS no_keys;
 no_keys 
---------
      -1
(1 row)

DROP EXTENSION pg_sift_test, pg_sift CASCADE;
