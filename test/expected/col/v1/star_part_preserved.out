-- Format 1: a RIGHT or FULL join of a partitioned table to a table that keeps its rows gives each row no partition matched once, after the last partition, not once per partition.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET sift.test_create_format1 = on;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE dim (id int PRIMARY KEY, kind text);
INSERT INTO dim SELECT i, 'k' || i % 3 FROM generate_series(1, 8) i;
CREATE TABLE fact (id int NOT NULL, grp int NOT NULL, d date NOT NULL, qty int) PARTITION BY RANGE (d);
CREATE TABLE fact_a PARTITION OF fact FOR VALUES FROM ('2024-01-01') TO ('2024-04-01');
CREATE TABLE fact_b PARTITION OF fact FOR VALUES FROM ('2024-04-01') TO ('2024-07-01');
CREATE TABLE fact_c PARTITION OF fact FOR VALUES FROM ('2024-07-01') TO ('2024-10-01');
INSERT INTO fact SELECT i, 2 + i % 4, date '2024-01-01' + i % 270, i % 7 FROM generate_series(1, 900) i;
CREATE INDEX fact_col ON fact USING sift_col (id, grp, d, qty);
ANALYZE dim, fact;
SET seq_page_cost = 10000;
SET random_page_cost = 10000;
CREATE FUNCTION plan_of(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l ~ 'Custom Scan \(SiftAgg' THEN RETURN 'sift'; END IF;
	END LOOP;
	RETURN 'normal';
END $$;
CREATE FUNCTION same(q text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE a text; b text;
BEGIN
	EXECUTE 'SELECT string_agg(x::text, ''|'' ORDER BY x::text) FROM (' || q || ') x' INTO a;
	PERFORM set_config('sift.enable_agg', 'off', true);
	EXECUTE 'SELECT string_agg(x::text, ''|'' ORDER BY x::text) FROM (' || q || ') x' INTO b;
	PERFORM set_config('sift.enable_agg', 'on', true);
	RETURN a IS NOT DISTINCT FROM b;
END $$;
SELECT plan_of(q), same(q) FROM (VALUES
	('SELECT s.kind, count(t.id) AS n, sum(t.qty) AS q, count(*) AS tuples FROM fact t RIGHT JOIN dim s ON s.id = t.grp GROUP BY s.kind'),
	('SELECT s.kind, count(t.id) AS n, count(*) AS tuples FROM fact t FULL JOIN dim s ON s.id = t.grp AND s.id > 2 GROUP BY s.kind')) v(q);
 plan_of | same 
---------+------
 sift    | t
 sift    | t
(2 rows)

SELECT s.kind, count(t.id) AS n, count(*) AS tuples FROM fact t RIGHT JOIN dim s ON s.id = t.grp GROUP BY s.kind ORDER BY s.kind;
 kind |  n  | tuples 
------+-----+--------
 k0   | 225 |    226
 k1   | 225 |    227
 k2   | 450 |    451
(3 rows)

DROP FUNCTION plan_of, same;
DROP TABLE fact, dim;
DROP EXTENSION pg_sift;
