-- The rewrite of a key_cut sift_col index in partitions that sift.col_maintain makes goes a step (one partition and the overlays over its window) at a time, and the
-- VACUUM after it leaves the file within a tenth and a partition of the live bytes. Nothing but the call starts it: the worker and VACUUM leave the dirty units as they are.
-- The answers never change and the index verifies.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test CASCADE;
-- Format 1: the segments and units this test reads are Format 1.
SET sift.test_create_format1 = on;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET max_parallel_maintenance_workers = 0;
SET sift.test_col_net = off;	-- the dirty units are what asks for the rewrite (col_net_agg is of the sidecar VACUUM writes for them)
SET sift.test_col_partition_kb = 1024;
SET sift.async_maintenance = off;
CREATE TABLE rr (id int, cust int, d date, amount int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO rr SELECT i, (i::bigint * 7919) % 600, date '2026-01-01' + (i * 31) % 300, i % 100, md5(i::text) FROM generate_series(1, 200000) i;
CREATE INDEX rr_idx ON rr USING sift_col (id, cust, d, amount, pad) WITH (key_cut = 'cust', dict_lookup = off, dead_rewrite_pct = 100);
-- the first rewrite of the index may leave a partition of several units, which the next one cuts
UPDATE rr SET amount = amount + 1 WHERE id % 5 = 1;
VACUUM (FREEZE, DISABLE_PAGE_SKIPPING, INDEX_CLEANUP ON) rr;
SELECT sift.col_maintain('rr_idx') AS partitioned;
 partitioned 
-------------
 t
(1 row)

UPDATE rr SET amount = amount + 1 WHERE id % 5 = 2;
VACUUM (FREEZE, DISABLE_PAGE_SKIPPING, INDEX_CLEANUP ON) rr;
SELECT sift.col_maintain('rr_idx') AS cut_again;
 cut_again 
-----------
 t
(1 row)

VACUUM rr;
SELECT count(*) >= 5 AS partitions, max(bytes) < 1024 * 1024 * 3 / 2 AS within_a_partition FROM sift.col_segments('rr_idx') WHERE kind = 'immutable';
 partitions | within_a_partition 
------------+--------------------
 t          | t
(1 row)

ALTER TABLE rr RESET (autovacuum_enabled);
-- the file is within a tenth of the live bytes and one partition of them after the VACUUM that follows a rewrite (it moves down the blocks above the end that leaves a partition free)
CREATE FUNCTION rr_file_ok(pct int, k int) RETURNS bool LANGUAGE sql AS $$
	SELECT i.relation_blocks * 8192 <= (1 + pct / 100.0) * (SELECT sum(bytes) FROM sift.col_sections('rr_idx') WHERE section <> 'free')
		+ k * (SELECT greatest(max(bytes), 1024 * 1024) FROM sift.col_segments('rr_idx') WHERE kind = 'immutable')
	FROM sift.col_index_info('rr_idx') i $$;
CREATE FUNCTION rr_same() RETURNS bool LANGUAGE plpgsql AS $$
DECLARE a text; b text;
BEGIN
	SET LOCAL enable_seqscan = off; SET LOCAL enable_bitmapscan = off;
	SELECT x::text INTO a FROM (SELECT count(*), sum(amount), count(DISTINCT cust) FROM rr WHERE cust BETWEEN 10 AND 400) x;
	SET LOCAL enable_indexscan = off; SET LOCAL enable_seqscan = on;
	SELECT x::text INTO b FROM (SELECT count(*), sum(amount), count(DISTINCT cust) FROM rr WHERE cust BETWEEN 10 AND 400) x;
	RETURN a = b;
END $$;
-- every partition the steps record holds rows from its bound up to the next one
-- the segments the rewrite leaves cover the keys disjointly: no key is in two of them (two may meet at the one key that ends one and starts the next); the overlays it took in did not
CREATE FUNCTION rr_disjoint() RETURNS bool LANGUAGE sql AS $$
	WITH r AS (SELECT a.segment, min(a.min::int) lo, max(a.max::int) hi FROM sift.col_unit_agg('rr_idx', 'cust') a
			   JOIN sift.col_segments('rr_idx') s ON s.gen = a.segment WHERE s.kind = 'immutable' GROUP BY a.segment)
	SELECT count(*) >= 5 AND NOT EXISTS (SELECT 1 FROM r x JOIN r y ON x.segment < y.segment AND x.lo < y.hi AND y.lo < x.hi) FROM r $$;
-- the rewrite on request, a step (one partition and the overlays over its window) for each call, committed so the next step writes into the blocks this one freed
CREATE PROCEDURE rr_maintain() LANGUAGE plpgsql AS $$
BEGIN
	FOR i IN 1..200 LOOP
		EXIT WHEN NOT sift.col_maintain('rr_idx');
		COMMIT;
	END LOOP;
END $$;
-- rounds of churn: new rows promoted into overlays over every partition, and a few rows of the table updated
CREATE PROCEDURE rr_round(n int) LANGUAGE plpgsql AS $$
BEGIN
	FOR k IN 1..6 LOOP
		INSERT INTO rr SELECT 1000000 * n + 10000 * k + g, (g * 7919) % 600, date '2026-02-01', g % 100, md5(g::text) FROM generate_series(1, 4000) g;
		PERFORM sift.col_promote('rr_idx');
	END LOOP;
	UPDATE rr SET amount = amount + 1 WHERE id % 40 = n;
	COMMIT;
END $$;
SELECT sift.col_verify('rr_idx', true);
 col_verify 
------------
 
(1 row)

SELECT rr_same();
 rr_same 
---------
 t
(1 row)

-- a round, the rewrite on request, and the VACUUM after it
CALL rr_round(1);
SELECT NOT rr_disjoint() AS overlays_meet_the_partitions;
 overlays_meet_the_partitions 
------------------------------
 t
(1 row)

VACUUM rr;
SELECT sift.col_maintenance_due('rr_idx') AS due;
     due     
-------------
 dirty units
(1 row)

CALL rr_maintain();
SELECT bool_and(NOT dirty) AS none_dirty, count(*) FILTER (WHERE bytes * 2 >= 1024 * 1024) >= 5 AS partitions FROM sift.col_segments('rr_idx') WHERE kind = 'immutable';
 none_dirty | partitions 
------------+------------
 t          | t
(1 row)

SELECT rr_disjoint() AS partitions_disjoint;
 partitions_disjoint 
---------------------
 t
(1 row)

SELECT count(*) > 0 AS recorded, bool_and(rows_from_lo) AS rows_from_lo, bool_and(rows_below_next) AS rows_below_next FROM sift._test_col_part_bounds('rr_idx');
 recorded | rows_from_lo | rows_below_next 
----------+--------------+-----------------
 t        | t            | t
(1 row)

VACUUM rr;
SELECT rr_file_ok(10, 1) AS file_within_a_partition;
 file_within_a_partition 
-------------------------
 t
(1 row)

SELECT sift.col_verify('rr_idx', true);
 col_verify 
------------
 
(1 row)

SELECT rr_same();
 rr_same 
---------
 t
(1 row)

-- the next rounds do the same on the blocks the rewrite before them left
CALL rr_round(2);
VACUUM rr;
CALL rr_maintain();
SELECT bool_and(NOT dirty) AS none_dirty FROM sift.col_segments('rr_idx') WHERE kind = 'immutable';
 none_dirty 
------------
