SELECT pg_stat_force_next_flush() \gset
SELECT * FROM ri_note('not vacuumed');
     step     |   build   | table_buffer_passes | temp_files | verified | same_answers 
--------------+-----------+---------------------+------------+----------+--------------
 not vacuumed | old index |                   0 | f          | t        | t
(1 row)

-- REINDEX CONCURRENTLY is built from the heap: its writers change the index it would read
INSERT INTO ri_t SELECT * FROM ri_rows(8001, 8600);
DELETE FROM ri_t WHERE id % 43 = 0;
SELECT pg_stat_force_next_flush() \gset
SELECT ri_start();
 ri_start 
