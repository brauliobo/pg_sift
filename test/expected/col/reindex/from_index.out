-- REINDEX of a sift_col index takes the rows from the index it replaces when it can give them (col/v1/build/from_index.c): the heap is not read, no row goes
-- to a temporary file, and the answers are those of a build from the heap at every state of the table (rows inserted, deleted and updated since the index was built, in the write
-- buffer or in segments, vacuumed or not). Whatever the old index cannot give (no key, a scope, a rewrite of the table, rows this transaction has buffered) is built from the heap.
-- sift.test_col_from_index_used says which; sift.test_col_from_index_off forces the heap, and sift.test_col_from_index_mutant plants a defect that a step must catch.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_helpers;
CREATE EXTENSION pg_sift_test;
-- Format 1: a build from the replaced index reads the segments and the tombstone log of Format 1.
SET sift.test_create_format1 = on;
SET client_min_messages = warning;
SET sift.col_build_source = auto;
SET max_parallel_workers_per_gather = 0;
SET max_parallel_maintenance_workers = 0;
SET sift.async_maintenance = off;
SET sift.test_col_segment_kb = 64;
SET sift.test_col_spill_run_kb = 64;
CREATE TABLE ri_t (id int PRIMARY KEY, tenant_id int, k int, status smallint, created_at timestamptz, a_count int, kind text, label text)
	WITH (autovacuum_enabled = false);
CREATE FUNCTION ri_rows(lo int, hi int) RETURNS SETOF ri_t LANGUAGE sql AS $$
	SELECT i, i % 40, (i::bigint * 7919 % 3000)::int, (i % 5)::smallint, timestamptz '2026-01-01' + (i * 37 % 100000) * interval '1 minute', i % 11, 'kind_' || (i % 9),
		'label ' || (i % 300)
	FROM generate_series(lo, hi) i $$;
INSERT INTO ri_t SELECT * FROM ri_rows(1, 6000);
VACUUM (FREEZE, ANALYZE) ri_t;
CREATE INDEX ri_idx ON ri_t USING sift_col (id, tenant_id, k, status, created_at, a_count, kind, label) WITH (key_cut = 'k', track_changes = 'off');
-- the answers by the index and by the table, which a build from the old index must not change
CREATE FUNCTION ri_answers(by_index bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text := ''; a text; q text;
BEGIN
	FOREACH q IN ARRAY ARRAY['SELECT count(*), sum(a_count), min(label), max(created_at) FROM ri_t WHERE k = 42',
		'SELECT status, count(*), sum(a_count) FROM ri_t WHERE k < 200 GROUP BY 1 ORDER BY 1', 'SELECT count(*), sum(id), sum(k) FROM ri_t',
		'SELECT tenant_id, count(*) FROM ri_t WHERE k BETWEEN 1000 AND 1100 GROUP BY 1 ORDER BY 1', 'SELECT kind, count(*) FROM ri_t WHERE k < 500 GROUP BY 1 ORDER BY 1'] LOOP
		IF by_index THEN
			SET LOCAL enable_seqscan = off; SET LOCAL enable_indexscan = off; SET LOCAL sift.enable_agg = on;
		ELSE
			SET LOCAL enable_seqscan = on; SET LOCAL sift.enable_agg = off;
		END IF;
		EXECUTE 'SELECT string_agg(x::text, E''\n'') FROM (' || q || ') x' INTO a;
		r := r || md5(a);
	END LOOP;
	RETURN md5(r);
END $$;
-- what one REINDEX did: the build it took, table_buffer_passes (every access of a buffer of the table, over its pages, rounded: a scan of the heap is one, and so is the sample of up to 64 pages
-- that a heap build reads to count the rows it will get, which is why a build from the heap shows one more than the scans it makes), whether it wrote temporary files, and the answers of the index
-- against the table's
CREATE TABLE ri_mark (heap_buffers bigint, temp_bytes bigint);
CREATE FUNCTION ri_start() RETURNS void LANGUAGE sql AS $$
	TRUNCATE ri_mark;
	INSERT INTO ri_mark SELECT coalesce((SELECT sum(heap_blks_read + heap_blks_hit) FROM pg_statio_user_tables WHERE relname = 'ri_t'), 0),
		(SELECT temp_bytes FROM pg_stat_database WHERE datname = current_database()) $$;
CREATE FUNCTION ri_note(step text, idx text DEFAULT 'ri_idx') RETURNS TABLE (step text, build text, table_buffer_passes int, temp_files bool, verified bool, same_answers bool)
	LANGUAGE sql AS $$
	SELECT step, CASE current_setting('sift.test_col_from_index_used') WHEN '1' THEN 'old index' ELSE 'heap' END,
		round((coalesce((SELECT sum(heap_blks_read + heap_blks_hit) FROM pg_statio_user_tables WHERE relname = 'ri_t'), 0) - m.heap_buffers) / (pg_relation_size('ri_t') / 8192.0))::int,
		(SELECT temp_bytes FROM pg_stat_database WHERE datname = current_database()) > m.temp_bytes,
		sift.col_verify(idx::regclass, true)::text = '', ri_answers(true) = ri_answers(false)
	FROM ri_mark m $$;
-- the build of the table's rows, the baseline
SELECT pg_stat_force_next_flush() \gset
SELECT ri_start();
 ri_start 
----------
 
(1 row)

SET sift.test_col_from_index_off = on;
REINDEX INDEX ri_idx;
RESET sift.test_col_from_index_off;
SELECT pg_stat_force_next_flush() \gset
SELECT * FROM ri_note('heap build');
    step    | build | table_buffer_passes | temp_files | verified | same_answers 
------------+-------+---------------------+------------+----------+--------------
 heap build | heap  |                   3 | t          | t        | t
(1 row)

-- a clean index
SELECT pg_stat_force_next_flush() \gset
SELECT ri_start();
 ri_start 
----------
 
(1 row)

REINDEX INDEX ri_idx;
SELECT pg_stat_force_next_flush() \gset
SELECT * FROM ri_note('clean');
 step  |   build   | table_buffer_passes | temp_files | verified | same_answers 
-------+-----------+---------------------+------------+----------+--------------
 clean | old index |                   0 | f          | t        | t
(1 row)

