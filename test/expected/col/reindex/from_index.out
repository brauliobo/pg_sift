-- an index that tracks changes (the table has a primary key) reads the table for the baseline of its log, one access of each page that is not all-visible, the map, and for nothing else (the buffers the build itself accessed: PostgreSQL reads a page of the visibility map after it on 17)
CREATE INDEX ri_tracked ON ri_t USING sift_col (id, tenant_id, k, status) WITH (key_cut = 'k');
SELECT pg_stat_force_next_flush() \gset
SELECT ri_start();
 ri_start 
----------
 
(1 row)

REINDEX INDEX ri_tracked;
SELECT pg_stat_force_next_flush() \gset
SELECT current_setting('sift.test_col_from_index_used') AS used,
	current_setting('sift.test_col_build_table_buffers')::int <= pg_relation_size('ri_t') / 8192 + 1 AS reads_each_page_once_and_the_map;
 used | reads_each_page_once_and_the_map 
------+----------------------------------
 1    | t
(1 row)

DROP INDEX ri_tracked;
-- a build from the heap for what the old index cannot give
-- rows this transaction has buffered are not in the index that is replaced
BEGIN;
INSERT INTO ri_t SELECT * FROM ri_rows(9001, 9100);
REINDEX INDEX ri_idx;
SELECT current_setting('sift.test_col_from_index_used') AS used_with_own_rows;
 used_with_own_rows 
--------------------
 0
(1 row)

SELECT ri_answers(true) = ri_answers(false) AS own_rows_indexed;
 own_rows_indexed 
------------------
 t
(1 row)

COMMIT;
SELECT sift.col_verify('ri_idx', true)::text = '' AS verified, ri_answers(true) = ri_answers(false) AS same_answers;
 verified | same_answers 
----------+--------------
 t        | t
(1 row)

-- a table that this transaction rewrote has no rows at the addresses the old index holds
BEGIN;
ALTER TABLE ri_t ALTER COLUMN label TYPE varchar(100);
SELECT current_setting('sift.test_col_from_index_used') AS used_after_rewrite;
 used_after_rewrite 
--------------------
 0
(1 row)

COMMIT;
SELECT sift.col_verify('ri_idx', true)::text = '' AS verified, ri_answers(true) = ri_answers(false) AS same_answers;
 verified | same_answers 
----------+--------------
 t        | t
(1 row)

-- no key: the segments are taken in the order the old index holds them (the old index is read as it is)
CREATE INDEX ri_plain ON ri_t USING sift_col (id, k, status);
REINDEX INDEX ri_plain;
SELECT current_setting('sift.test_col_from_index_used') AS used_unkeyed;
 used_unkeyed 
--------------
 1
(1 row)

DROP INDEX ri_plain;
-- key_order is a key too
CREATE INDEX ri_ordered ON ri_t USING sift_col (id, k, status, created_at) WITH (key_order = 'created_at');
DELETE FROM ri_t WHERE id % 53 = 0;
INSERT INTO ri_t SELECT * FROM ri_rows(9101, 9400);
REINDEX INDEX ri_ordered;
SELECT current_setting('sift.test_col_from_index_used') AS used_key_order;
 used_key_order 
----------------
 1
(1 row)

SELECT sift.col_verify('ri_ordered', true)::text = '' AS verified;
 verified 
----------
 t
(1 row)

DROP INDEX ri_ordered;
-- a mutant that leaves the write buffer out loses the rows of the buffer: a step that cannot tell it from the build has no value
INSERT INTO ri_t SELECT * FROM ri_rows(9401, 9700);
SET sift.test_col_from_index_mutant = 1;
SELECT ri_start();
 ri_start 
----------
 
(1 row)

REINDEX INDEX ri_idx;
RESET sift.test_col_from_index_mutant;
SELECT current_setting('sift.test_col_from_index_used') AS used_with_mutant;
 used_with_mutant 
------------------
 1
(1 row)

SELECT ri_answers(true) = ri_answers(false) AS same_answers_with_rows_left_out;
 same_answers_with_rows_left_out 
---------------------------------
 f
(1 row)

SET sift.test_col_from_index_off = on;
REINDEX INDEX ri_idx;
RESET sift.test_col_from_index_off;
SELECT ri_answers(true) = ri_answers(false) AS same_answers_after_a_build_from_the_heap;
 same_answers_after_a_build_from_the_heap 
------------------------------------------
 t
(1 row)

DROP TABLE ri_t CASCADE;
DROP TABLE ri_mark;
DROP FUNCTION ri_start();
DROP FUNCTION ri_note(text, text);
DROP FUNCTION ri_answers(bool);
-- an index that tracks changes answers without the heap for the rows whose inserters it knows committed before the snapshot (the stamp of each segment) and what was deleted (the log):
-- the rows the old index gave keep their stamps and the log is the build's own, so the read after REINDEX is as free of the heap as it was and gives the table's rows
CREATE TABLE events (id int PRIMARY KEY, tenant_id int NOT NULL, counter_a int, label text) WITH (autovacuum_enabled = false, fillfactor = 100);
INSERT INTO events SELECT i, i % 10, i, 'x' FROM generate_series(1, 20000) i;
CREATE INDEX events_c ON events USING sift_col (id, tenant_id, counter_a) WITH (track_changes = 'id', key_cut = 'tenant_id');
VACUUM events;
CREATE FUNCTION answer(want_sift bool) RETURNS text LANGUAGE sql AS $$ SELECT sift_helpers.events_sums_with_plan_check(want_sift) $$;
CREATE FUNCTION pages() RETURNS int LANGUAGE sql AS $$ SELECT sift_helpers.events_heap_pages() $$;
CREATE FUNCTION chk(what text, OUT test text, OUT build text, OUT same_as_heap_check bool, OUT same_as_no_sift bool, OUT free_reads_heap bool)
LANGUAGE plpgsql AS $$
DECLARE free_ans text; checked text; oracle text; pf int;
BEGIN
	PERFORM set_config('sift.enable_agg', 'on', true);
	PERFORM set_config('sift.test_no_heapfree', 'off', true);
	free_ans := answer(true);
	pf := pages();
	PERFORM set_config('sift.test_no_heapfree', 'on', true);
	checked := answer(true);
	PERFORM set_config('sift.test_no_heapfree', 'off', true);
	PERFORM set_config('sift.enable_agg', 'off', true);
	oracle := answer(false);
	test := what;
	build := CASE current_setting('sift.test_col_from_index_used') WHEN '1' THEN 'old index' ELSE 'heap' END;
	same_as_heap_check := free_ans = checked;
	same_as_no_sift := free_ans = oracle;
	free_reads_heap := pf > 0;
END $$;
SELECT * FROM chk('fresh build');
    test     | build | same_as_heap_check | same_as_no_sift | free_reads_heap 
-------------+-------+--------------------+-----------------+-----------------
 fresh build | heap  | t                  | t               | f
(1 row)

DELETE FROM events WHERE id % 97 = 0;
UPDATE events SET counter_a = counter_a + 5, tenant_id = (tenant_id + 1) % 10 WHERE id % 89 = 1;
INSERT INTO events SELECT i, i % 10, i, 'y' FROM generate_series(20001, 20800) i;
BEGIN; INSERT INTO events SELECT i, i % 10, i, 'z' FROM generate_series(30001, 30200) i; ROLLBACK;
REINDEX INDEX events_c;
SELECT * FROM chk('deleted, updated, inserted, an insert rolled back; REINDEX');
                            test                            |   build   | same_as_heap_check | same_as_no_sift | free_reads_heap 
------------------------------------------------------------+-----------+--------------------+-----------------+-----------------
 deleted, updated, inserted, an insert rolled back; REINDEX | old index | t                  | t               | f
(1 row)

SELECT sift.col_promote('events_c') >= 0 AS promoted;
 promoted 
----------
 t
(1 row)

INSERT INTO events SELECT i, i % 10, i, 'w' FROM generate_series(20801, 21000) i;
DELETE FROM events WHERE id % 101 = 0;
REINDEX INDEX CONCURRENTLY events_c;
SELECT * FROM chk('promoted, then more writes; REINDEX CONCURRENTLY');
                       test                       | build | same_as_heap_check | same_as_no_sift | free_reads_heap 
--------------------------------------------------+-------+--------------------+-----------------+-----------------
 promoted, then more writes; REINDEX CONCURRENTLY | heap  | t                  | t               | t
(1 row)

REINDEX INDEX events_c;
SELECT count(*) = count(stamp) AS every_segment_stamped FROM sift.col_stamps('events_c');
 every_segment_stamped 
-----------------------
 t
(1 row)

SELECT sift.col_verify('events_c', true)::text = '' AS verified;
 verified 
----------
 t
(1 row)

-- a mutant that leaves out the rows of the write buffer (the stamp mutant, which vouches for inserters it never saw finish, is held by col_reindex_from_index_writers)
CREATE FUNCTION ri_writes(lo int) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	INSERT INTO events SELECT i, i % 10, i, 'v' FROM generate_series(lo, lo + 499) i;
	DELETE FROM events WHERE id % 103 = 0;
END $$;
SELECT ri_writes(21001);
 ri_writes 
-----------
 
(1 row)

BEGIN; INSERT INTO events SELECT i, i % 10, i, 'z' FROM generate_series(40001, 40300) i; ROLLBACK;
SET sift.test_col_from_index_mutant = 1;
REINDEX INDEX events_c;
RESET sift.test_col_from_index_mutant;
SELECT * FROM chk('mutant 1: the write buffer left out');
                test                 |   build   | same_as_heap_check | same_as_no_sift | free_reads_heap 
-------------------------------------+-----------+--------------------+-----------------+-----------------
 mutant 1: the write buffer left out | old index | t                  | f               | f
(1 row)

SET sift.test_col_from_index_off = on;
REINDEX INDEX events_c;
RESET sift.test_col_from_index_off;
SELECT * FROM chk('a build from the heap after the mutant');
                  test                  | build | same_as_heap_check | same_as_no_sift | free_reads_heap 
----------------------------------------+-------+--------------------+-----------------+-----------------
 a build from the heap after the mutant | heap  | t                  | t               | f
(1 row)

DROP FUNCTION ri_writes(int);
DROP FUNCTION answer(bool);
DROP FUNCTION pages();
DROP FUNCTION chk(text);
DROP TABLE events;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift;
