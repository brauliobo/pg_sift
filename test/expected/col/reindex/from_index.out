               step               |   build   | table_buffer_passes | temp_files | verified | same_answers 
----------------------------------+-----------+---------------------+------------+----------+--------------
 buffered over segments, vacuumed | old index |                   0 | f          | t        | t
(1 row)

-- the rows of a table that the VACUUM of the index has not seen: updated and deleted after the last VACUUM
UPDATE ri_t SET a_count = a_count + 2 WHERE id % 37 = 4;
DELETE FROM ri_t WHERE id % 41 = 0;
SELECT pg_stat_force_next_flush() \gset
SELECT ri_start();
