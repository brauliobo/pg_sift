-- changes in the buffer over changes in segments, then VACUUM (the dead rows of the table go, the index keeps the entries it has not been asked to drop)
INSERT INTO ri_t SELECT * FROM ri_rows(7601, 8000);
UPDATE ri_t SET k = (k + 11) % 3000 WHERE id % 29 = 3;
DELETE FROM ri_t WHERE id % 31 = 0;
VACUUM ri_t;
SELECT pg_stat_force_next_flush() \gset
SELECT ri_start();
 ri_start 
----------
 
(1 row)

REINDEX INDEX ri_idx;
SELECT pg_stat_force_next_flush() \gset
