-- rows deleted and updated (their key and others), still in the segments the build wrote
DELETE FROM ri_t WHERE id % 13 = 0;
UPDATE ri_t SET k = (k + 7) % 3000 WHERE id % 17 = 1;
UPDATE ri_t SET a_count = a_count + 1, label = 'moved ' || id WHERE id % 19 = 2;
SELECT pg_stat_force_next_flush() \gset
SELECT ri_start();
 ri_start 
