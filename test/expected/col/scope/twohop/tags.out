DROP TABLE states;
DROP FUNCTION state_line();
DROP FUNCTION read_key(int8);
DROP VIEW pair_oracle;
DROP TABLE facts, grants, memberships;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
