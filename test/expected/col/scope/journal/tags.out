-- The journal of a scope relation tags each record with the scope key of its pair, so that a read of some keys is not charged for the pairs that changed in others: the scope summary reads a key
-- whose pairs changed with the changes since it (Scope Cube: delta) and every other key as it is (clean). Table-driven: each state of the pairs (they accumulate) read for each key and for a list
-- of keys: the rows are the join's, and the keys read with the delta cube are those whose pairs changed. A scope of another column of the relation (the region) reads the changes of its own key.
-- Counts only, no timings.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
-- the scope summary is Format 2.0; the testing library builds new indexes in Format 1.0 when told to
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
-- 8 keys; dim_a_id d has a pair with the keys 1 + d % 8 and 1 + (d + 3) % 8; 4,000 events
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, region_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT d, 1 + (d + j * 3) % 8, 1 + (d + j) % 3 FROM generate_series(1, 64) d, generate_series(0, 1) j;
CREATE UNIQUE INDEX tenant_scope_by_region ON tenant_scope (dim_a_id, region_id);
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id, region_id) WITH (track_changes = 'ctid');
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 7) % 64, timestamptz '2026-01-01' + i * interval '9 minutes', i % 10 FROM generate_series(1, 4000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
CREATE TABLE events_region (LIKE events) WITH (autovacuum_enabled = false);
INSERT INTO events_region SELECT * FROM events;
CREATE INDEX events_region_col ON events_region USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'region_id: dim_a_id -> tenant_scope(dim_a_id, region_id)');
VACUUM (FREEZE, ANALYZE) events, events_region;
VACUUM (ANALYZE) tenant_scope;
-- one read of the keys (an int8 array) of the scope column col (tenant_id or region_id) over the events tbl: the rows against the heap, the Scope Read and the Scope Cube of the node
CREATE FUNCTION read_keys(tbl text, col text, keys int8[], OUT same boolean, OUT route text, OUT cube text) LANGUAGE plpgsql AS $$
DECLARE
	q text := format('SELECT count(*), sum(amount) FROM %I f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.%I = ANY (%L::int8[])', tbl, col, keys);
	p jsonb;
	a text;
	b text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF, FORMAT JSON) ' || q INTO p;
	EXECUTE 'SELECT row(t.*)::text FROM (' || q || ') t' INTO a;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'SELECT row(t.*)::text FROM (' || q || ') t' INTO b;
	SET LOCAL sift.enable_agg = on;
	same := a = b;
	route := jsonb_path_query_first(p, '$.**."Scope Read"') #>> '{}';
	cube := jsonb_path_query_first(p, '$.**."Scope Cube"') #>> '{}';
END $$;
-- the line of a state: the rows are the join's and every read is a scope read; the Scope Cube of each key 1..8 read alone (d: delta, c: clean), of a list of two keys, and of the region scope's keys 1..4
CREATE FUNCTION cube_of(c text) RETURNS text LANGUAGE sql IMMUTABLE AS $$ SELECT CASE c WHEN 'delta' THEN 'd' WHEN 'clean' THEN 'c' ELSE '-' END $$;
CREATE FUNCTION state_line(OUT same boolean, OUT scope boolean, OUT cubes text, OUT list_cube text, OUT region_cubes text) LANGUAGE plpgsql AS $$
DECLARE
	l record;
	g record;
BEGIN
	SELECT bool_and(r.same), bool_and(r.route IS NOT NULL), string_agg(cube_of(r.cube), '' ORDER BY k.k) INTO same, scope, cubes
	FROM generate_series(1, 8) k(k), LATERAL read_keys('events', 'tenant_id', ARRAY[k.k]::int8[]) r;
	SELECT * INTO l FROM read_keys('events', 'tenant_id', ARRAY[2, 5]::int8[]);
	same := same AND l.same;
	scope := scope AND l.route IS NOT NULL;
	list_cube := cube_of(l.cube);
	SELECT bool_and(r.same) AS s, bool_and(r.route IS NOT NULL) AS sc, string_agg(cube_of(r.cube), '' ORDER BY k.k) AS cu INTO g
	FROM generate_series(1, 4) k(k), LATERAL read_keys('events_region', 'region_id', ARRAY[k.k]::int8[]) r;
	same := same AND g.s;
	scope := scope AND g.sc;
	region_cubes := g.cu;
END $$;
CREATE TABLE states (n int, label text, edit text);
INSERT INTO states VALUES
	(1, 'clean', 'SELECT 1'),
	(2, 'the pairs of key 1 of six dim_a_id values deleted and inserted again',
		'WITH d AS (DELETE FROM tenant_scope WHERE tenant_id = 1 AND dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1 ORDER BY dim_a_id LIMIT 6) RETURNING *) INSERT INTO tenant_scope SELECT * FROM d'),
	(3, 'a pair moved from key 2 to key 3', 'UPDATE tenant_scope SET tenant_id = 3 WHERE tenant_id = 2 AND dim_a_id = (SELECT min(dim_a_id) FROM tenant_scope WHERE tenant_id = 2) AND NOT EXISTS (SELECT 1 FROM tenant_scope t WHERE t.tenant_id = 3 AND t.dim_a_id = (SELECT min(dim_a_id) FROM tenant_scope WHERE tenant_id = 2))'),
	(4, 'a pair of key 5 deleted', 'DELETE FROM tenant_scope WHERE tenant_id = 5 AND dim_a_id = (SELECT min(dim_a_id) FROM tenant_scope WHERE tenant_id = 5)'),
	(5, 'pairs of key 8 inserted for dim_a_id values with events and none yet in it', 'INSERT INTO tenant_scope SELECT d, 8, 5 FROM generate_series(1, 64) d WHERE d % 8 <> 7 AND d % 8 <> 4 LIMIT 5 ON CONFLICT DO NOTHING'),
	(6, 'a pair of key 1 and region 2 gets region 4', 'UPDATE tenant_scope SET region_id = 4 WHERE dim_a_id = 40 AND tenant_id = 1');
SELECT c FROM states, LATERAL unnest(ARRAY[format('SELECT %s AS n, %L AS state', n, label), edit, 'SELECT * FROM state_line()']) WITH ORDINALITY u(c, o) ORDER BY n, o \gexec
SELECT 1 AS n, 'clean' AS state
