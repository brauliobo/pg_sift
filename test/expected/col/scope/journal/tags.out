-- the reads of each key after the states: the keys whose pairs changed read the changes, the others are clean
SELECT k, r.* FROM generate_series(1, 8) k, LATERAL read_keys('events', 'tenant_id', ARRAY[k]::int8[]) r ORDER BY k;
