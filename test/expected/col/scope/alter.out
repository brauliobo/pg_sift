-- ALTER INDEX .. SET (scope = ..) on a sift_col index would leave it with another leaf list than the one its metapage was written with, and every scan of it would stop until a REINDEX (the plans
-- of the table go without it). It is refused, and the index goes on serving: the replacement is made beside it (CREATE INDEX CONCURRENTLY, then DROP INDEX). So is RESET (scope). A Format 2.0
-- index that holds no row has nothing written under the old list: it takes the scope, and its rows are read through it once they come.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
-- the scope summary is Format 2.0; the testing library builds new indexes in Format 1.0 when told to
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
CREATE FUNCTION try(stmt text) RETURNS text LANGUAGE plpgsql AS
$$ DECLARE hint text; BEGIN EXECUTE stmt; RETURN 'ok';
   EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS hint = PG_EXCEPTION_HINT; RETURN sqlerrm || coalesce(' [' || hint || ']', ''); END $$;
-- what a statement over the table runs on: the sift index it scans, and the scope it reads
CREATE FUNCTION plan_of(q text, OUT scanned text, OUT scope text) LANGUAGE plpgsql AS $$
DECLARE p jsonb;
BEGIN
	EXECUTE 'EXPLAIN (COSTS OFF, FORMAT JSON) ' || q INTO p;
	scanned := jsonb_path_query_first(p, '$.**.Index') #>> '{}';
	scope := jsonb_path_query_first(p, '$.**."Scope Read"') #>> '{}';
END $$;
CREATE TABLE pairs (dim_a_id int NOT NULL, group_id int NOT NULL, PRIMARY KEY (dim_a_id, group_id)) WITH (autovacuum_enabled = false);
INSERT INTO pairs SELECT e, 1 + e % 20 FROM generate_series(1, 400) e;
CREATE INDEX pairs_journal ON pairs USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
-- an index on an empty table
CREATE INDEX facts_empty ON facts USING sift_col (id, dim_a_id, created_at, amount);
SELECT try('ALTER INDEX facts_empty SET (scope = ''group_id: dim_a_id -> pairs(dim_a_id, group_id)'')') AS empty_table;
 empty_table 
-------------
 ok
(1 row)

INSERT INTO facts SELECT i, 1 + i % 450, timestamptz '2026-01-01' + (i % 100) * interval '1 day', i % 10 FROM generate_series(1, 2000) i;
VACUUM facts;
SELECT * FROM plan_of('SELECT count(*), sum(amount) FROM facts WHERE dim_a_id IN (SELECT dim_a_id FROM pairs WHERE group_id = 3)');
   scanned   |      scope      
-------------+-----------------
 facts_empty | summary or join
(1 row)

SELECT count(*), sum(amount) FROM facts WHERE dim_a_id IN (SELECT dim_a_id FROM pairs WHERE group_id = 3);
 count | sum 
-------+-----
    90 |  90
(1 row)

-- sift.agg_scope off: no scope read is planned
SET sift.agg_scope = off;
SELECT * FROM plan_of('SELECT count(*), sum(amount) FROM facts WHERE dim_a_id IN (SELECT dim_a_id FROM pairs WHERE group_id = 3)');
 scanned | scope 
---------+-------
         | 
(1 row)

RESET sift.agg_scope;
SET sift.enable_agg = off;
SELECT count(*), sum(amount) FROM facts WHERE dim_a_id IN (SELECT dim_a_id FROM pairs WHERE group_id = 3);
 count | sum 
-------+-----
    90 |  90
(1 row)

RESET sift.enable_agg;
SELECT try('ALTER INDEX facts_empty SET (scope = ''g: dim_a_id -> pairs(dim_a_id, group_id)'')') AS with_rows;
                                                                                                    with_rows                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 cannot change the column definitions of index "facts_empty" while it holds data [CREATE INDEX CONCURRENTLY a new index with the options, then DROP INDEX public.facts_empty: no scan is lost while it is built.]
(1 row)

TRUNCATE facts;
SELECT try('ALTER INDEX facts_empty RESET (scope)') AS empty_reset;
 empty_reset 
-------------
 ok
(1 row)

DROP INDEX facts_empty;
INSERT INTO facts SELECT i, 1 + i % 450, timestamptz '2026-01-01' + (i % 100) * interval '1 day', i % 10 FROM generate_series(1, 20000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount);
VACUUM (FREEZE, ANALYZE) facts;
SET sift.agg_force = on;
SELECT * FROM plan_of('SELECT kind_amount, count(*) FROM (SELECT amount AS kind_amount FROM facts) t GROUP BY 1');
  scanned  | scope 
-----------+-------
 facts_col | 
(1 row)

-- the index has segments: the scope is refused, and nothing changed
SELECT try('ALTER INDEX facts_col SET (scope = ''group_id: dim_a_id -> pairs(dim_a_id, group_id)'')') AS with_segments;
                                                                                                with_segments                                                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 cannot change the column definitions of index "facts_col" while it holds data [CREATE INDEX CONCURRENTLY a new index with the options, then DROP INDEX public.facts_col: no scan is lost while it is built.]
(1 row)

SELECT NOT EXISTS (SELECT 1 FROM pg_class c, unnest(c.reloptions) o WHERE c.relname = 'facts_col' AND o LIKE 'scope=%') AS no_scope;
 no_scope 
----------
 t
(1 row)

SELECT * FROM plan_of('SELECT kind_amount, count(*) FROM (SELECT amount AS kind_amount FROM facts) t GROUP BY 1');
  scanned  | scope 
-----------+-------
 facts_col | 
(1 row)

-- an option that does not change the leaf list is let through
SELECT try('ALTER INDEX facts_col SET (superunit = 8)') AS other_option;
 other_option 
--------------
 ok
(1 row)

-- the replacement beside it: no scan is lost while it is built, and it serves once the old one goes
CREATE INDEX CONCURRENTLY facts_scope ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'group_id: dim_a_id -> pairs(dim_a_id, group_id)');
SELECT * FROM plan_of('SELECT kind_amount, count(*) FROM (SELECT amount AS kind_amount FROM facts) t GROUP BY 1');
   scanned   | scope 
-------------+-------
 facts_scope | 
(1 row)

DROP INDEX facts_col;
SELECT * FROM plan_of('SELECT kind_amount, count(*) FROM (SELECT amount AS kind_amount FROM facts) t GROUP BY 1');
   scanned   | scope 
-------------+-------
 facts_scope | 
(1 row)

-- RESET (scope) is refused too: the scope is given up by a replacement without it
SELECT try('ALTER INDEX facts_scope RESET (scope)') AS reset_scope;
                                                                                                   reset_scope                                                                                                    
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 cannot change the column definitions of index "facts_scope" while it holds data [CREATE INDEX CONCURRENTLY a new index with the options, then DROP INDEX public.facts_scope: no scan is lost while it is built.]
(1 row)

SELECT * FROM plan_of('SELECT kind_amount, count(*) FROM (SELECT amount AS kind_amount FROM facts) t GROUP BY 1');
   scanned   | scope 
-------------+-------
 facts_scope | 
(1 row)

DROP TABLE facts, pairs;
DROP FUNCTION try(text), plan_of(text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
