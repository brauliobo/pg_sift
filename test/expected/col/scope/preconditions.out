-- a partition declares its own scope: a statement over the partitioned table reads none
CREATE TABLE part_events (id int, dim_a_id int NOT NULL, kind int NOT NULL, amount int NOT NULL) PARTITION BY RANGE (id);
CREATE TABLE part_events_1 PARTITION OF part_events FOR VALUES FROM (0) TO (100000);
CREATE INDEX part_col ON part_events USING sift_col (id, dim_a_id, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
NOTICE:  scope: "part_events_1" is a partition: a statement over the partitioned table reads no scope
DETAIL:  A statement on this partition reads the scope units of its index; the scope index of each partition is declared on that partition.
NOTICE:  scope "tenant_id": the pairs of "tenant_scope" are the rows of its unique btree "tenant_scope_pkey"
NOTICE:  sift_col "part_events_1_id_dim_a_id_amount_idx": built 0 rows (80.0 KB, 0 parts, 0 granules)
DETAIL:  Chosen from the data: scope.
HINT:  Inspect layout with SELECT * FROM sift.status('public.part_events_1_id_dim_a_id_amount_idx');
DROP TABLE part_events;
-- ALTER INDEX .. RESET (scope) would leave segments that hold a scope the index no longer declares: it is refused, and the statements over the table run on the scope
CREATE INDEX altered_col ON events USING sift_col (id, dim_a_id, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
NOTICE:  scope "tenant_id": the pairs of "tenant_scope" are the rows of its unique btree "tenant_scope_pkey"
NOTICE:  sift_col "altered_col": built 2,000 rows (128.0 KB, 65.5 B/row, 0.7x vs heap, 1 parts, 1 granules, codecs: 3 delta, 1 coded)
DETAIL:  Chosen from the data: scope.
HINT:  Inspect layout with SELECT * FROM sift.status('public.altered_col');
ALTER INDEX altered_col RESET (scope);
ERROR:  cannot change the column definitions of index "altered_col" while it holds data
DETAIL:  Its segments were written with the options it has now: reads and writes on its table would fail until a REINDEX writes them again.
HINT:  CREATE INDEX CONCURRENTLY a new index with the options, then DROP INDEX public.altered_col: no scan is lost while it is built.
