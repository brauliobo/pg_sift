DROP INDEX unjournaled_col;
-- row-level security of the relation: the statements of a role the policies apply to read the join as written
CREATE TABLE pairs_rls (m int NOT NULL, s int NOT NULL, PRIMARY KEY (m, s));
ALTER TABLE pairs_rls ENABLE ROW LEVEL SECURITY;
SET sift.test_create_format1 = on;
CREATE INDEX pairs_rls_journal ON pairs_rls USING sift_col (m, s) WITH (track_changes = 'ctid');
NOTICE:  sift_col index "pairs_rls_journal": 1 automatic choice (track_changes)
DETAIL:  track_changes = ctid
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('pairs_rls_journal');
SET sift.test_create_format1 = off;
CREATE INDEX rls_col ON events USING sift_col (id, dim_a_id, amount) WITH (scope = 'tenant_id: dim_a_id -> pairs_rls(m, s)');
NOTICE:  scope "tenant_id": "pairs_rls" has row-level security enabled
DETAIL:  A statement of a role the policies apply to reads its join to the relation as written.
NOTICE:  scope "tenant_id": the pairs of "pairs_rls" are the rows of its unique btree "pairs_rls_pkey"
NOTICE:  sift_col "rls_col": built 2,000 rows (128.0 KB, 65.5 B/row, 0.7x vs heap, 1 parts, 1 granules, codecs: 3 delta, 1 coded)
DETAIL:  Chosen from the data: scope.
HINT:  Inspect layout with SELECT * FROM sift.status('public.rls_col');
DROP INDEX rls_col;
-- a scope of two paths needs the journals of its three relations, as a scope of one path needs its: the build makes them
CREATE TABLE grants (dim_a_id int, group_id int, tenant_id int NOT NULL);
CREATE UNIQUE INDEX grants_direct ON grants (dim_a_id, tenant_id);
CREATE UNIQUE INDEX grants_group ON grants (group_id, tenant_id);
CREATE TABLE memberships (group_id int NOT NULL, dim_a_id int NOT NULL, PRIMARY KEY (group_id, dim_a_id));
CREATE INDEX two_col ON events USING sift_col (id, dim_a_id, amount) WITH (scope = 'tenant_id: dim_a_id -> grants(dim_a_id, tenant_id) | grants(group_id, tenant_id) via memberships(group_id, dim_a_id)');
NOTICE:  scope "tenant_id": the direct pairs of "grants" (dim_a_id, tenant_id) are the rows of its unique btree "grants_direct"
NOTICE:  scope "tenant_id": the joined pairs of "grants" (group_id, tenant_id) are the rows of its unique btree "grants_group"
NOTICE:  scope "tenant_id": the via relation of "memberships" (group_id, dim_a_id) are the rows of its unique btree "memberships_pkey"
NOTICE:  scope "tenant_id": making the journal index "grants_dim_a_id_tenant_id_sift_journal" of "grants" (dim_a_id, tenant_id)
DETAIL:  The writers of "grants" wait until the build of this index ends, as for CREATE INDEX on it, for as long as it takes to read the relation. The index goes with the last scope index that uses it.
HINT:  To build it without blocking the writers, name it, place it or keep it, make it first: CREATE INDEX CONCURRENTLY ON public.grants USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid').
NOTICE:  sift_col index "grants_dim_a_id_tenant_id_sift_journal": 2 automatic choices
DETAIL:  key_columns = dim_a_id, tenant_id; track_changes = ctid
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('grants_dim_a_id_tenant_id_sift_journal');
NOTICE:  scope "tenant_id": making the journal index "grants_group_id_tenant_id_sift_journal" of "grants" (group_id, tenant_id)
DETAIL:  The writers of "grants" wait until the build of this index ends, as for CREATE INDEX on it, for as long as it takes to read the relation. The index goes with the last scope index that uses it.
HINT:  To build it without blocking the writers, name it, place it or keep it, make it first: CREATE INDEX CONCURRENTLY ON public.grants USING sift_col (group_id, tenant_id) WITH (track_changes = 'ctid').
NOTICE:  sift_col index "grants_group_id_tenant_id_sift_journal" stores columns tenant_id of index "grants_dim_a_id_tenant_id_sift_journal", which has the same layout
HINT:  One index over the union of their columns is smaller at the same read cost: create it, drop both.
NOTICE:  sift_col index "grants_group_id_tenant_id_sift_journal": 2 automatic choices
DETAIL:  key_columns = group_id, tenant_id; track_changes = ctid
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('grants_group_id_tenant_id_sift_journal');
NOTICE:  scope "tenant_id": making the journal index "memberships_dim_a_id_group_id_sift_journal" of "memberships" (dim_a_id, group_id)
DETAIL:  The writers of "memberships" wait until the build of this index ends, as for CREATE INDEX on it, for as long as it takes to read the relation. The index goes with the last scope index that uses it.
HINT:  To build it without blocking the writers, name it, place it or keep it, make it first: CREATE INDEX CONCURRENTLY ON public.memberships USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid').
NOTICE:  sift_col index "memberships_dim_a_id_group_id_sift_journal": 2 automatic choices
DETAIL:  key_columns = dim_a_id, group_id; track_changes = ctid
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('memberships_dim_a_id_group_id_sift_journal');
NOTICE:  sift_col "two_col": built 2,000 rows (128.0 KB, 65.5 B/row, 0.7x vs heap, 1 parts, 1 granules, codecs: 3 delta, 1 coded)
DETAIL:  Chosen from the data: scope.
HINT:  Inspect layout with SELECT * FROM sift.status('public.two_col');
