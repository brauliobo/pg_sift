UPDATE var_scope SET tenant_id = 'tenant-5' WHERE tenant_id = 'tenant-6' AND dim_a_id % 2 = 0;
UPDATE uuid_scope SET tenant_id = md5('tenant-5')::uuid WHERE tenant_id = md5('tenant-6')::uuid AND dim_a_id % 2 = 0;
