DELETE FROM tenant_scope WHERE tenant_id = 'tenant-4';
DELETE FROM var_scope WHERE tenant_id = 'tenant-4';
DELETE FROM uuid_scope WHERE tenant_id = md5('tenant-4')::uuid;
