-- The scopes of a sift_col index. The tests that were one file each, one segment for each, each in a schema of its own with the settings reset between them; every segment runs as its test did.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
-- >>> col_scope_batch_entries
CREATE SCHEMA s1;
GRANT USAGE ON SCHEMA s1 TO PUBLIC;
SET search_path = s1, public;
-- The rows of a batch expand to an entry for every scope key of their member, and the count of entries is 32 bits and doubles with its arrays (docs/LIMITS.md,
-- scope_batch_entries). A build whose batch passes the bound is an error that names it, where it would have counted past 32 bits; below it the same build is the same index.
SET client_min_messages = warning;
CREATE TABLE events (id int, dim_a_id int, created_at timestamptz, kind int, value_num numeric);
INSERT INTO events SELECT i, i % 2000 + 1, timestamptz '2026-01-01' + (i || ' min')::interval, i % 5, i FROM generate_series(1, 20000) i;
CREATE TABLE pairs (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id));
INSERT INTO pairs SELECT m, k FROM generate_series(1, 2000) m, generate_series(1, 3) k;
CREATE INDEX pairs_journal ON pairs USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE FUNCTION try(q text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN EXECUTE q; RETURN 'built'; EXCEPTION WHEN OTHERS THEN RETURN sqlerrm; END $$;
SET sift.test_limits = 'scope_batch_entries=1000';
SELECT try('CREATE INDEX events_scope ON events USING sift_col (id, dim_a_id, created_at, kind, value_num) WITH (scope = ''tenant_id: dim_a_id -> pairs(dim_a_id, tenant_id)'')') AS lowered;
                          lowered                           
------------------------------------------------------------
 the rows of a batch expand to more than 1000 scope entries
(1 row)

SET sift.test_limits = 'scope_batch_entries=100000000';
SELECT try('CREATE INDEX events_scope ON events USING sift_col (id, dim_a_id, created_at, kind, value_num) WITH (scope = ''tenant_id: dim_a_id -> pairs(dim_a_id, tenant_id)'')') AS raised;
 raised 
--------
 built
(1 row)

RESET sift.test_limits;
SELECT sift.col_verify('events_scope'::regclass, true) AS verify;
 verify 
--------
 
(1 row)

DROP FUNCTION try(text);
DROP TABLE events, pairs;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s1 CASCADE;
RESET client_min_messages;
-- <<< col_scope_batch_entries
-- >>> col_scope_catalog_memo
CREATE SCHEMA s2;
GRANT USAGE ON SCHEMA s2 TO PUBLIC;
SET search_path = s2, public;
-- A read of a scope asks the catalogs for what only DDL changes (the triggers that make the journal of its pairs complete, the relations of the scope and their journal indexes, its legs, the rows of its
-- relations, the units of its keys) once for a state of the catalogs, not once for each read: the second read of a key is answered from the memos (sift._test_catalog_memos counts the answers), a
-- transaction that has an xid (its own DDL is not counted before it commits) asks every time, and a trigger of the journal that was disabled and enabled again, which any other backend learns of as
-- a message, ends the memo: the journal is no longer the whole truth, and the read says so and gives the join's rows. Counts only, no timings.
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
SET sift.agg_force = on;
SET sift.test_scope_patch = on;
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT d, 1 + (d + j * 3) % 8 FROM generate_series(1, 64) d, generate_series(0, 1) j;
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 7) % 64, timestamptz '2026-01-01' + i * interval '9 minutes', i % 10 FROM generate_series(1, 4000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
VACUUM (FREEZE, ANALYZE) events, tenant_scope;
-- one read of the key k: the rows against the join, whether the units were read
CREATE FUNCTION read_key(k int8, OUT stored boolean, OUT same boolean) LANGUAGE plpgsql AS $$
DECLARE
	p jsonb;
	a text;
	b text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	EXECUTE format('EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF, FORMAT JSON) SELECT count(*), sum(amount) FROM events f WHERE sift.in_scope(''events_col''::regclass, ''tenant_id'', f.dim_a_id, ARRAY[%s]::int8[])', k) INTO p;
	EXECUTE format('SELECT json_agg(t)::text FROM (SELECT count(*), sum(amount) FROM events f WHERE sift.in_scope(''events_col''::regclass, ''tenant_id'', f.dim_a_id, ARRAY[%s]::int8[])) t', k) INTO a;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('SELECT json_agg(t)::text FROM (SELECT count(*), sum(amount) FROM events f WHERE f.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = %s)) t', k) INTO b;
	SET LOCAL sift.enable_agg = on;
	same := a = b;
	stored := jsonb_path_exists(p, '$.**."Scope Units Read"');
END $$;
-- the first read asks the catalogs, the second is answered by the memos
SELECT * FROM read_key(2);
 stored | same 
--------+------
 t      | t
(1 row)

SELECT sift._test_catalog_memos() AS h0 \gset
SELECT * FROM read_key(2);
 stored | same 
--------+------
 t      | t
(1 row)

SELECT sift._test_catalog_memos() > :h0 AS the_second_read_is_answered_by_the_memos;
 the_second_read_is_answered_by_the_memos 
------------------------------------------
 t
(1 row)

-- a transaction with an xid asks every time
BEGIN;
INSERT INTO tenant_scope VALUES (100, 2);
SELECT sift._test_catalog_memos() AS h1 \gset
SELECT * FROM read_key(3);
 stored | same 
--------+------
 t      | t
(1 row)

SELECT sift._test_catalog_memos() = :h1 AS no_memo_in_a_transaction_with_an_xid;
 no_memo_in_a_transaction_with_an_xid 
--------------------------------------
 t
(1 row)

ROLLBACK;
-- the triggers disabled while a pair is inserted and enabled again: the memo does not hide it
SELECT * FROM read_key(2);
 stored | same 
--------+------
 t      | t
(1 row)

ALTER TABLE tenant_scope DISABLE TRIGGER ALL;
INSERT INTO tenant_scope VALUES (101, 2);
DELETE FROM tenant_scope WHERE dim_a_id = 1 AND tenant_id = 2;
ALTER TABLE tenant_scope ENABLE TRIGGER ALL;
SELECT * FROM read_key(2);
 stored | same 
--------+------
 f      | t
(1 row)

SELECT * FROM read_key(4);
 stored | same 
--------+------
 f      | t
(1 row)

DROP FUNCTION read_key(int8);
DROP TABLE events, tenant_scope;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s2 CASCADE;
RESET client_min_messages;
-- <<< col_scope_catalog_memo
-- >>> col_scope_fill
CREATE SCHEMA s3;
GRANT USAGE ON SCHEMA s3 TO PUBLIC;
SET search_path = s3, public;
-- The fill of a scope index expands the member keys of a batch of fact rows by the scope keys the scope relation has for them, under one snapshot (col/v1/scope/fill.c).
-- Both ways to know the pairs (the relation read once, the btree probed per member) give the entries of the join, for members in 0..6 keys, NULL and unknown members.
SET client_min_messages = warning;
CREATE TABLE tenant_scope (member int, scope_key int, PRIMARY KEY (scope_key, member)) WITH (autovacuum_enabled = false);
-- member m (1..20000) is in (m % 7) keys, drawn from 1..40 by a fixed spread: members 7, 14, .. are in none, the others in 1..6
INSERT INTO tenant_scope
	SELECT m, 1 + (m * 31 + j * 13) % 40 FROM generate_series(1, 20000) m, generate_series(0, 5) j WHERE j < m % 7 GROUP BY 1, 2;
CREATE TABLE facts AS
	SELECT i AS ordinal, CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN 100000 + i ELSE 1 + (i * 7919) % 20000 END::int8 AS fk FROM generate_series(0, 4999) i;
CREATE FUNCTION expand_md5(mode int) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	r text;
BEGIN
	EXECUTE format('SET sift.test_conn_fill = %s', mode);
	SELECT md5(string_agg(ordinal || ':' || key, ',' ORDER BY ordinal, key)) INTO r
		FROM sift._test_scope_expand('tenant_scope', 'tenant_scope_pkey', 'member', 'scope_key', (SELECT array_agg(fk ORDER BY ordinal) FROM facts));
	RETURN r;
END $$;
SELECT md5(string_agg(f.ordinal || ':' || s.scope_key, ',' ORDER BY f.ordinal, s.scope_key)) AS joined FROM facts f JOIN tenant_scope s ON s.member = f.fk \gset
SELECT expand_md5(1) = :'joined' AS key_set_is_the_join, expand_md5(2) = :'joined' AS probe_is_the_join, expand_md5(0) = :'joined' AS price_is_the_join;
 key_set_is_the_join | probe_is_the_join | price_is_the_join 
---------------------+-------------------+-------------------
 t                   | t                 | t
(1 row)

-- keys per row of the expansion: 0..6, orphans and NULLs none
SELECT n, count(*) AS rows FROM (
	SELECT f.ordinal, count(e.key) AS n FROM facts f
		LEFT JOIN sift._test_scope_expand('tenant_scope', 'tenant_scope_pkey', 'member', 'scope_key', (SELECT array_agg(fk ORDER BY ordinal) FROM facts)) e USING (ordinal)
		GROUP BY 1) t GROUP BY 1 ORDER BY 1;
 n | rows 
---+------
 0 | 1402
 1 |  599
 2 |  598
 3 |  597
 4 |  602
 5 |  599
 6 |  603
(7 rows)

-- the pairs that fit half of maintenance_work_mem (about 58,000 pairs of 16 bytes at 1MB: more here) are read once, else probed: the same entries
SET maintenance_work_mem = '1MB';
SELECT expand_md5(0) = :'joined' AS small_memory_is_the_join;
 small_memory_is_the_join 
--------------------------
 t
(1 row)

RESET maintenance_work_mem;
-- a deleted pair is expanded by neither way
DELETE FROM tenant_scope WHERE member = 1;
SELECT expand_md5(1) = expand_md5(2) AS ways_agree_after_edit;
 ways_agree_after_edit 
-----------------------
 t
(1 row)

SELECT count(*) = 0 AS member_one_gone FROM sift._test_scope_expand('tenant_scope', 'tenant_scope_pkey', 'member', 'scope_key', ARRAY[1::int8]);
 member_one_gone 
-----------------
 t
(1 row)

DROP FUNCTION expand_md5(int);
DROP TABLE facts;
DROP TABLE tenant_scope;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s3 CASCADE;
RESET client_min_messages;
-- <<< col_scope_fill
-- >>> col_scope_journal_partial
CREATE SCHEMA s4;
GRANT USAGE ON SCHEMA s4 TO PUBLIC;
SET search_path = s4, public;
-- The journal index of a scope relation must hear of every pair a statement inserts: a partial sift_col index never hears of a pair outside its predicate, so a read would take the member
-- for unchanged and answer from stale scope entries. A partial index does not qualify as the journal: the scope index is refused while it is the only candidate, and ignored beside a plain one.
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
SET sift.agg_force = on;
CREATE FUNCTION try(stmt text) RETURNS text LANGUAGE plpgsql AS
$$ DECLARE hint text; BEGIN EXECUTE stmt; RETURN 'ok';
   EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS hint = PG_EXCEPTION_HINT; RETURN sqlerrm || coalesce(' [' || hint || ']', ''); END $$;
-- the scope read and the plain join of one group: the same rows, and whether the units answered
CREATE FUNCTION group_read(k int, OUT same boolean, OUT scope_rows bigint, OUT join_rows bigint, OUT fallback text)
LANGUAGE plpgsql AS $$
DECLARE
	p jsonb;
BEGIN
	EXECUTE format('EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF, FORMAT JSON) SELECT count(*), sum(amount) FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''group_id'', f.dim_a_id, %s)', k) INTO p;
	fallback := jsonb_path_query_first(p, '$.**."Scope Fallback"') #>> '{}';
	EXECUTE format('SELECT count(*) FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''group_id'', f.dim_a_id, %s)', k) INTO scope_rows;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('SELECT count(*) FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM pairs WHERE group_id = %s)', k) INTO join_rows;
	SET LOCAL sift.enable_agg = on;
	same := scope_rows = join_rows;
END $$;
CREATE TABLE pairs (dim_a_id int NOT NULL, group_id int NOT NULL, PRIMARY KEY (dim_a_id, group_id)) WITH (autovacuum_enabled = false);
INSERT INTO pairs SELECT e, 1 + e % 20 FROM generate_series(1, 400) e;
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, 1 + i % 450, timestamptz '2026-01-01' + (i % 100) * interval '1 day', i % 10 FROM generate_series(1, 20000) i;
-- a partial journal index is the only candidate: it does not qualify, and the build makes a journal of its own beside it
CREATE INDEX pairs_partial ON pairs USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid') WHERE group_id < 10;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'group_id: dim_a_id -> pairs(dim_a_id, group_id)');
SELECT string_agg(refobjid::regclass::text, ' ' ORDER BY refobjid::regclass::text) AS only_partial FROM pg_depend WHERE classid = 'pg_class'::regclass AND objid = 'facts_col'::regclass AND refclassid = 'pg_class'::regclass AND deptype = 'n' AND (SELECT relkind FROM pg_class WHERE oid = refobjid) = 'i';
                  only_partial                   
-------------------------------------------------
 pairs_dim_a_id_group_id_sift_journal pairs_pkey
(1 row)

DROP INDEX facts_col;
-- a plain one beside it: the scope index depends on the plain one only
CREATE INDEX pairs_journal ON pairs USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'group_id: dim_a_id -> pairs(dim_a_id, group_id)');
REINDEX INDEX facts_col;
VACUUM (FREEZE, ANALYZE) facts;
SELECT string_agg(refobjid::regclass::text, ' ' ORDER BY refobjid::regclass::text) AS edges FROM pg_depend
WHERE classid = 'pg_class'::regclass AND objid = 'facts_col'::regclass AND refclassid = 'pg_class'::regclass AND deptype = 'n' AND (SELECT relkind FROM pg_class WHERE oid = refobjid) = 'i';
          edges           
--------------------------
 pairs_journal pairs_pkey
(1 row)

