(12 rows)

SELECT sift.col_verify('facts_col', true);
 col_verify 
------------
 
(1 row)

-- one path: the pairs are the rows of a partial unique btree (a soft delete ends a pair) and the journal index is a plain one, so no journal index lists the pairs; the btree of the relation is led by
-- the key, which the dim_a_id of a changed pair cannot ask
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX tenant_scope_active ON tenant_scope (tenant_id, dim_a_id) WHERE deleted_at IS NULL;
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
INSERT INTO tenant_scope SELECT m, 1 + m % 6 FROM generate_series(1, 60) m;
INSERT INTO tenant_scope SELECT m, 1 + (m + 2) % 6 FROM generate_series(5, 60, 5) m;
CREATE TABLE facts1 (id int PRIMARY KEY, dim_a_id int, amount int) WITH (autovacuum_enabled = false);
INSERT INTO facts1 SELECT i, CASE WHEN i % 17 = 0 THEN NULL ELSE 1 + (i * 7) % 63 END, i % 10 FROM generate_series(1, 1500) i;
CREATE INDEX facts1_col ON facts1 USING sift_col (id, dim_a_id, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX facts1_col;
VACUUM (FREEZE, ANALYZE) facts1, tenant_scope;
CREATE TABLE states1 (n int, label text, edit text);
INSERT INTO states1 VALUES
	(1, 'a pair added', 'INSERT INTO tenant_scope VALUES (30, 5, NULL)'),
	(2, 'a pair soft deleted', 'UPDATE tenant_scope SET deleted_at = now() WHERE dim_a_id = 30 AND tenant_id = 5'),
	(3, 'a pair deleted', 'DELETE FROM tenant_scope WHERE dim_a_id = 7'),
	(4, 'a pair moved to another key', 'UPDATE tenant_scope SET tenant_id = 6 WHERE dim_a_id = 8'),
	(5, 'a soft deleted pair restored', 'UPDATE tenant_scope SET deleted_at = NULL WHERE dim_a_id = 30 AND tenant_id = 5'),
	(6, 'an update that keeps every column', 'UPDATE tenant_scope SET tenant_id = tenant_id WHERE dim_a_id IN (1, 2, 3)'),
	(7, 'twenty dim_a_id values of one key deleted', 'DELETE FROM tenant_scope WHERE tenant_id = 3 AND dim_a_id < 40');
CREATE TABLE lines1 (n int, label text, same boolean, scope boolean, cubes text);
SELECT stmt FROM (SELECT n, 0 AS k, 'REINDEX INDEX facts1_col' AS stmt FROM states1
	UNION ALL SELECT n, 1, edit FROM states1
	UNION ALL SELECT n, 2, format('INSERT INTO lines1 SELECT %s, %L, l.* FROM state_line(%L) l', n, label,
		'SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') FROM states1) t ORDER BY n, k \gexec
REINDEX INDEX facts1_col
INSERT INTO tenant_scope VALUES (30, 5, NULL)
INSERT INTO lines1 SELECT 1, 'a pair added', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') l
REINDEX INDEX facts1_col
UPDATE tenant_scope SET deleted_at = now() WHERE dim_a_id = 30 AND tenant_id = 5
INSERT INTO lines1 SELECT 2, 'a pair soft deleted', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') l
REINDEX INDEX facts1_col
DELETE FROM tenant_scope WHERE dim_a_id = 7
INSERT INTO lines1 SELECT 3, 'a pair deleted', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') l
REINDEX INDEX facts1_col
UPDATE tenant_scope SET tenant_id = 6 WHERE dim_a_id = 8
INSERT INTO lines1 SELECT 4, 'a pair moved to another key', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') l
REINDEX INDEX facts1_col
UPDATE tenant_scope SET deleted_at = NULL WHERE dim_a_id = 30 AND tenant_id = 5
INSERT INTO lines1 SELECT 5, 'a soft deleted pair restored', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') l
REINDEX INDEX facts1_col
UPDATE tenant_scope SET tenant_id = tenant_id WHERE dim_a_id IN (1, 2, 3)
INSERT INTO lines1 SELECT 6, 'an update that keeps every column', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') l
REINDEX INDEX facts1_col
DELETE FROM tenant_scope WHERE tenant_id = 3 AND dim_a_id < 40
INSERT INTO lines1 SELECT 7, 'twenty dim_a_id values of one key deleted', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts1 f JOIN tenant_scope s ON s.dim_a_id = f.dim_a_id WHERE s.tenant_id = %s AND s.deleted_at IS NULL') l
SELECT n, label, same, scope, cubes FROM lines1 ORDER BY n;
 n |                   label                   | same | scope | cubes  
---+-------------------------------------------+------+-------+--------
