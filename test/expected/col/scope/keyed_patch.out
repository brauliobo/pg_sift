-- The changes of a scope read are keyed: the pairs that changed since the scope summary name dim_a_id values (the journals', not keys), and the summary reads with the changes since it (Scope Cube:
-- delta) only the keys those dim_a_id values have a pair with, before or after the change: a change of a pair of another key leaves a key clean. Each state below is built again (REINDEX), edited
-- once, and read for each key one at a time: the rows are the join's, every key is a scope read, and the keys read with the delta cube are those of the edit.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
-- the scope summary is Format 2.0; the testing library builds new indexes in Format 1.0 when told to
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
\ir test/common/sql/col/scope/base.sql
\set ECHO none
-- two paths: a tenant is granted a dim_a_id, or a group; a dim_a_id is in groups
CREATE TABLE grants (id int PRIMARY KEY, tenant_id int NOT NULL, dim_a_id int, group_id int, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX grants_direct ON grants (dim_a_id, tenant_id) WHERE deleted_at IS NULL;
CREATE UNIQUE INDEX grants_group ON grants (group_id, tenant_id) WHERE deleted_at IS NULL;
CREATE TABLE group_dims (id serial PRIMARY KEY, group_id int NOT NULL, dim_a_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX group_dims_active ON group_dims (group_id, dim_a_id) WHERE deleted_at IS NULL;
CREATE INDEX grants_by_dim_a ON grants USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX grants_by_group ON grants USING sift_col (group_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX group_dims_by_dim_a ON group_dims USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
-- dim_a_id 1..60: in the group 1 + dim_a_id % 6, every fifth of them in a second one; the tenants 1..6 are granted dim_a_id values and groups
INSERT INTO group_dims (group_id, dim_a_id) SELECT 1 + m % 6, m FROM generate_series(1, 60) m;
INSERT INTO group_dims (group_id, dim_a_id) SELECT 1 + (m + 2) % 6, m FROM generate_series(5, 60, 5) m;
INSERT INTO grants VALUES
	(1, 1, 5, NULL, NULL), (2, 1, 17, NULL, NULL), (3, 1, NULL, 6, NULL),
	(4, 2, NULL, 3, NULL), (5, 2, 8, NULL, now()),
	(6, 3, 1, NULL, NULL), (7, 3, 2, NULL, NULL), (8, 3, NULL, 4, now()),
	(9, 4, NULL, 5, NULL), (10, 4, NULL, 7, NULL),
	(11, 5, 40, NULL, NULL), (12, 5, NULL, 5, NULL),
	(13, 6, 50, 3, NULL);
INSERT INTO facts SELECT i, CASE WHEN i % 17 = 0 THEN NULL ELSE 1 + (i * 7) % 63 END, timestamptz '2026-01-01' + i * interval '9 minutes', i % 10 FROM generate_series(1, 1500) i;
CREATE VIEW pair_oracle AS
	SELECT dim_a_id AS dim_a, tenant_id FROM grants WHERE deleted_at IS NULL AND dim_a_id IS NOT NULL
	UNION
	SELECT m.dim_a_id, g.tenant_id FROM grants g JOIN group_dims m ON m.group_id = g.group_id WHERE g.deleted_at IS NULL AND m.deleted_at IS NULL;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount)
	WITH (scope = 'tenant_id: dim_a_id -> grants(dim_a_id, tenant_id) | grants(group_id, tenant_id) via group_dims(group_id, dim_a_id)');
REINDEX INDEX facts_col;
VACUUM (FREEZE, ANALYZE) facts;
VACUUM (ANALYZE) grants, group_dims;
-- the line of a state: whether every key's rows are the join's, whether every key is a scope read, and for each key 1..6 its Scope Cube (d: delta, c: clean)
CREATE FUNCTION state_line(q text, OUT same boolean, OUT scope boolean, OUT cubes text) LANGUAGE plpgsql AS $$
BEGIN
	SELECT bool_and(r.same), bool_and(r.route IS NOT NULL), string_agg(CASE r.cube WHEN 'delta' THEN 'd' WHEN 'clean' THEN 'c' ELSE '-' END, '' ORDER BY k.k) INTO same, scope, cubes
	FROM generate_series(1, 6) k(k), LATERAL scope_read(format(q, k.k)) r;
END $$;
-- the states accumulate; each starts from a summary built again
CREATE TABLE states (n int, label text, edit text);
INSERT INTO states VALUES
	(1, 'a direct grant of tenant 3 to a new dim_a_id', 'INSERT INTO grants VALUES (101, 3, 30, NULL, NULL)'),
	(2, 'a direct grant of tenant 3 soft deleted', 'UPDATE grants SET deleted_at = now() WHERE id = 7'),
	(3, 'a direct grant of tenant 1 deleted', 'DELETE FROM grants WHERE id = 2'),
	(4, 'a direct grant of tenant 6 moved to a group', 'UPDATE grants SET dim_a_id = NULL, group_id = 6 WHERE id = 13'),
	(5, 'a grant of tenant 2 to a group soft deleted', 'UPDATE grants SET deleted_at = now() WHERE id = 4'),
	(6, 'a grant of tenant 4 to a group added', 'INSERT INTO grants VALUES (102, 4, NULL, 1, NULL)'),
	(7, 'a dim_a_id added to a group: it is granted to tenants 4 and 5', 'INSERT INTO group_dims (group_id, dim_a_id) VALUES (5, 59)'),
	(8, 'a dim_a_id added to a group: it is granted to nobody', 'INSERT INTO group_dims (group_id, dim_a_id) VALUES (9, 59)'),
	(9, 'a dim_a_id soft deleted from the group of tenant 4', 'UPDATE group_dims SET deleted_at = now() WHERE group_id = 5 AND dim_a_id = 10'),
	(10, 'a dim_a_id moved to another group', 'UPDATE group_dims SET group_id = 4 WHERE group_id = 3 AND dim_a_id = 14'),
	(11, 'an update that keeps every column', 'UPDATE grants SET group_id = group_id WHERE id IN (3, 4, 6)'),
	(12, 'a dim_a_id reached by two paths loses one', 'UPDATE grants SET deleted_at = now() WHERE id = 1');
CREATE TABLE lines (n int, label text, same boolean, scope boolean, cubes text);
SELECT stmt FROM (SELECT n, 0 AS k, 'REINDEX INDEX facts_col' AS stmt FROM states
	UNION ALL SELECT n, 1, edit FROM states
	UNION ALL SELECT n, 2, format('INSERT INTO lines SELECT %s, %L, l.* FROM state_line(%L) l', n, label,
		'SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') FROM states) t ORDER BY n, k \gexec
REINDEX INDEX facts_col
INSERT INTO grants VALUES (101, 3, 30, NULL, NULL)
INSERT INTO lines SELECT 1, 'a direct grant of tenant 3 to a new dim_a_id', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
UPDATE grants SET deleted_at = now() WHERE id = 7
INSERT INTO lines SELECT 2, 'a direct grant of tenant 3 soft deleted', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
DELETE FROM grants WHERE id = 2
INSERT INTO lines SELECT 3, 'a direct grant of tenant 1 deleted', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
UPDATE grants SET dim_a_id = NULL, group_id = 6 WHERE id = 13
INSERT INTO lines SELECT 4, 'a direct grant of tenant 6 moved to a group', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
UPDATE grants SET deleted_at = now() WHERE id = 4
INSERT INTO lines SELECT 5, 'a grant of tenant 2 to a group soft deleted', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
INSERT INTO grants VALUES (102, 4, NULL, 1, NULL)
INSERT INTO lines SELECT 6, 'a grant of tenant 4 to a group added', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
INSERT INTO group_dims (group_id, dim_a_id) VALUES (5, 59)
INSERT INTO lines SELECT 7, 'a dim_a_id added to a group: it is granted to tenants 4 and 5', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
INSERT INTO group_dims (group_id, dim_a_id) VALUES (9, 59)
INSERT INTO lines SELECT 8, 'a dim_a_id added to a group: it is granted to nobody', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
UPDATE group_dims SET deleted_at = now() WHERE group_id = 5 AND dim_a_id = 10
INSERT INTO lines SELECT 9, 'a dim_a_id soft deleted from the group of tenant 4', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
UPDATE group_dims SET group_id = 4 WHERE group_id = 3 AND dim_a_id = 14
INSERT INTO lines SELECT 10, 'a dim_a_id moved to another group', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
UPDATE grants SET group_id = group_id WHERE id IN (3, 4, 6)
INSERT INTO lines SELECT 11, 'an update that keeps every column', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
REINDEX INDEX facts_col
UPDATE grants SET deleted_at = now() WHERE id = 1
INSERT INTO lines SELECT 12, 'a dim_a_id reached by two paths loses one', l.* FROM state_line('SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a = f.dim_a_id WHERE o.tenant_id = %s') l
SELECT n, label, same, scope, cubes FROM lines ORDER BY n;
 n  |                             label                             | same | scope | cubes  
----+---------------------------------------------------------------+------+-------+--------
  1 | a direct grant of tenant 3 to a new dim_a_id                  | t    | t     | ccdccc
  2 | a direct grant of tenant 3 soft deleted                       | t    | t     | ccdccc
  3 | a direct grant of tenant 1 deleted                            | t    | t     | dccccc
  4 | a direct grant of tenant 6 moved to a group                   | t    | t     | cccccd
  5 | a grant of tenant 2 to a group soft deleted                   | t    | t     | cdcccc
  6 | a grant of tenant 4 to a group added                          | t    | t     | cccdcc
  7 | a dim_a_id added to a group: it is granted to tenants 4 and 5 | t    | t     | cccddc
  8 | a dim_a_id added to a group: it is granted to nobody          | t    | t     | cccccc
  9 | a dim_a_id soft deleted from the group of tenant 4            | t    | t     | cccddc
 10 | a dim_a_id moved to another group                             | t    | t     | cccccc
