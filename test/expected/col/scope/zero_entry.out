-- A build of rows none of whose members has a pair, and the pairs of those members arriving after it, then rows of members that have pairs promoted: the read of the key takes the pairs that
-- changed since the summary (the read once lost those rows, 650 for 5,650). The same when VACUUM took away the rows that had pairs (they were deleted) and the rows that stay have none.
-- Every read is the join's, before and after the maintenance step. The test col_scope_stamp has the other states.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
-- the scope summary is Format 2.0; the testing library builds new indexes in Format 1.0 when told to
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
\ir test/common/sql/col/scope/base.sql
\set ECHO none
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT m, 1 + m % 8 FROM generate_series(1, 100) m;
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE FUNCTION reads(OUT same boolean, OUT route text) LANGUAGE sql AS $$
	SELECT r.same, r.route FROM scope_read('SELECT count(*), sum(v) FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 3') r $$;
-- the first rows have members with no pair: the build has nothing to write for the scope
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, v int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 201 + i % 100, timestamptz '2026-01-01' + (i % 300) * interval '1 day', i % 10 FROM generate_series(1, 5000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, v) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
SELECT * FROM reads();
 same |  route  
------+---------
 t    | summary
(1 row)

-- the pairs of those members arrive, then rows of members that have pairs, which a promotion takes into the parts
INSERT INTO tenant_scope SELECT m, 3 FROM generate_series(201, 300) m;
INSERT INTO events SELECT 10000 + i, 1 + i % 100, timestamptz '2026-01-01', i % 10 FROM generate_series(1, 5000) i;
SELECT sift.col_promote('events_col') >= 0 AS promoted;
 promoted 
----------
 t
(1 row)

SELECT * FROM reads();
 same |  route  
------+---------
 t    | summary
(1 row)

-- the maintenance step, and the read again
SELECT sift.col_maintain('events_col') AS rewritten;
 rewritten 
-----------
 t
(1 row)

SELECT * FROM reads();
 same |  route  
------+---------
 t    | summary
(1 row)

SELECT sift.col_verify('events_col', true);
 col_verify 
------------
 
(1 row)

DROP TABLE events;
-- half of the rows have members with pairs: they are deleted and VACUUM cleans their parts, and the others stay with no key
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, v int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, CASE WHEN i % 2 = 0 THEN 1 + i % 100 ELSE 301 + i % 100 END, timestamptz '2026-01-01' + (i % 300) * interval '1 day', i % 10 FROM generate_series(1, 6000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, v) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events;
SELECT * FROM reads();
 same |  route  
------+---------
 t    | summary
(1 row)

DELETE FROM events WHERE dim_a_id <= 100;
VACUUM events;
INSERT INTO tenant_scope SELECT m, 3 FROM generate_series(301, 400) m;
INSERT INTO events SELECT 100000 + i, 1 + i % 100, timestamptz '2026-01-01', i % 10 FROM generate_series(1, 3000) i;
SELECT sift.col_promote('events_col') >= 0 AS promoted;
 promoted 
----------
 t
(1 row)

SELECT * FROM reads();
 same |  route  
------+---------
 t    | summary
(1 row)

SELECT sift.col_maintain('events_col') AS rewritten;
 rewritten 
-----------
 t
(1 row)

SELECT * FROM reads();
 same |  route  
------+---------
 t    | summary
(1 row)

SELECT sift.col_verify('events_col', true);
 col_verify 
------------
 
(1 row)

DROP TABLE events, tenant_scope;
DROP FUNCTION reads();
DROP FUNCTION scope_run(text, text), scope_group_run(text), scope_reason_ok(text), scope_read(text);
DROP EXTENSION pg_sift;
