-- The key groups of a scope segment of a Format 1 index (column format minor 51, docs/COL-SCOPE.md "Key groups"): the units that hold one scope key and no other are a group of their own, with
-- the merged cubes of the units and the tables of the ids the units lack (a unit holds a few rows of each id of its key). The block is checked against the units, every byte of it refused when
-- damaged, and it follows writes, deletes, VACUUM, promotion and merge; an aggregate by id, a top of ids, a count by kind or a range of days over a key is md5 equal to the join with the sift plan
-- off. Counts and hashes only.
SET client_min_messages = warning;
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
-- Format 1: the key groups of the scope segments are this format's
SET sift.test_create_format1 = on;
SET max_parallel_workers_per_gather = 0;
SET max_parallel_maintenance_workers = 0;
SET jit = off;
SET sift.agg_force = on;
SET sift.test_col_unit_rows = 100;
-- key 1 holds ids 1 to 60 (several hundred rows of each), key 2 ids 61 to 66, key 3 id 67 only
CREATE TABLE tenant_scope (dim_a_id int, tenant_id int, PRIMARY KEY (dim_a_id, tenant_id));
INSERT INTO tenant_scope SELECT d, CASE WHEN d <= 60 THEN 1 WHEN d <= 66 THEN 2 ELSE 3 END FROM generate_series(1, 67) d;
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at date, score int, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 7919) % 67, date '2026-01-01' + (i / 40), 1 + i % 10, 'k' || (i % 4), i % 500 FROM generate_series(1, 20000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, score, kind, amount)
	WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events;
VACUUM (ANALYZE) tenant_scope;
-- the groups are written: the scope segments are of minor 51, and the block checks against the units
SELECT array_agg(DISTINCT format ORDER BY format) AS minors FROM sift._test_col_formats('events_col');
 minors  
---------
 {45,51}
(1 row)

SELECT sift.col_verify('events_col', true);
 col_verify 
------------
 
(1 row)

CREATE TABLE cases (n int, label text, stmt text);
INSERT INTO cases VALUES
	(1, 'count by id, big key', 'SELECT dim_a_id, count(*) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) GROUP BY 1'),
	(2, 'sum by id, big key', 'SELECT dim_a_id, count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) GROUP BY 1'),
	(3, 'top ids, big key', 'SELECT dim_a_id, count(*) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) GROUP BY 1 ORDER BY 2 DESC, 1 LIMIT 5'),
	(4, 'count by kind, a range of days that cuts the key', 'SELECT kind, count(*) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) AND created_at >= date ''2026-03-01'' GROUP BY 1'),
	(5, 'count by id in a range of days', 'SELECT dim_a_id, count(*) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) AND created_at >= date ''2026-02-01'' AND created_at < date ''2026-04-01'' GROUP BY 1'),
	(6, 'count by score, two keys', 'SELECT score, count(*) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (1, 2)) GROUP BY 1'),
	(7, 'sum by id, mid key', 'SELECT dim_a_id, count(*), sum(amount) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 2) GROUP BY 1'),
	(8, 'count by kind, small key', 'SELECT kind, count(*) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 3) GROUP BY 1'),
	(9, 'count by month and kind, big key', 'SELECT date_trunc(''month'', created_at), kind, count(*) FROM events WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) GROUP BY 1, 2');
-- the answer: md5 of the rows with the sift plan on and off
CREATE FUNCTION probe(q text) RETURNS TABLE (same boolean) LANGUAGE plpgsql AS $$
DECLARE
	on_h text;
	off_h text;
BEGIN
	EXECUTE 'SELECT md5(coalesce(string_agg(t::text, ''|'' ORDER BY t::text), '''')) FROM (' || q || ') t' INTO on_h;
	PERFORM set_config('sift.enable_agg', 'off', true);
	EXECUTE 'SELECT md5(coalesce(string_agg(t::text, ''|'' ORDER BY t::text), '''')) FROM (' || q || ') t' INTO off_h;
	PERFORM set_config('sift.enable_agg', 'on', true);
	RETURN QUERY SELECT on_h = off_h;
END $$;
SELECT c.n, c.label, r.* FROM cases c, LATERAL probe(c.stmt) r ORDER BY c.n;
 n |                      label                       | same 
---+--------------------------------------------------+------
 1 | count by id, big key                             | t
 2 | sum by id, big key                               | t
 3 | top ids, big key                                 | t
 4 | count by kind, a range of days that cuts the key | t
 5 | count by id in a range of days                   | t
 6 | count by score, two keys                         | t
 7 | sum by id, mid key                               | t
 8 | count by kind, small key                         | t
 9 | count by month and kind, big key                 | t
(9 rows)

-- every byte of the block of a small index (1,500 events, groups of 13 units), read as itself with one bit flipped: all refused
CREATE TABLE events_s (id int PRIMARY KEY, dim_a_id int, created_at date, score int, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events_s SELECT i, 1 + (i * 7919) % 67, date '2026-01-01' + (i / 40), 1 + i % 10, 'k' || (i % 4), i % 500 FROM generate_series(1, 1500) i;
CREATE INDEX events_s_col ON events_s USING sift_col (id, dim_a_id, created_at, score, kind, amount)
	WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_s_col;
VACUUM (FREEZE, ANALYZE) events_s;
SELECT array_agg(DISTINCT format ORDER BY format) AS minors FROM sift._test_col_formats('events_s_col');
 minors  
---------
 {45,51}
(1 row)

SELECT supers > 0 AS has_blocks, damaged > 0 AS damages_made, refused = damaged AS all_refused, unnoticed = 0 AS none_unnoticed FROM sift._test_col_super_damage('events_s_col');
 has_blocks | damages_made | all_refused | none_unnoticed 
------------+--------------+-------------+----------------
 t          | t            | t           | t
(1 row)

-- the rollup of the rows of the index (rollup_columns) is kept for each group too: a filter on its columns, a count by them and a range of days that cuts the key are md5 equal to the join with
-- the sift plan off
CREATE TABLE events_r (id int PRIMARY KEY, dim_a_id int, created_at date, score int, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events_r SELECT id, dim_a_id, created_at, score, kind, amount FROM events;
CREATE INDEX events_r_col ON events_r USING sift_col (id, dim_a_id, created_at, score, kind, amount)
	WITH (rollup_columns = 'score, kind: amount', scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_r_col;
VACUUM (FREEZE, ANALYZE) events_r;
SELECT sift.col_verify('events_r_col', true);
 col_verify 
------------
 
(1 row)

CREATE TABLE cases_r (n int, label text, stmt text);
INSERT INTO cases_r VALUES
	(1, 'filter on both columns, big key', 'SELECT count(*) FROM events_r WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) AND score = 3 AND kind = ''k1'''),
	(2, 'sum by kind of a score, big key', 'SELECT kind, count(*), sum(amount) FROM events_r WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) AND score = 3 GROUP BY 1'),
	(3, 'count by score of a kind, big key', 'SELECT score, count(*) FROM events_r WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) AND kind = ''k2'' GROUP BY 1'),
	(4, 'filter on both columns, mid key', 'SELECT count(*), sum(amount) FROM events_r WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 2) AND score = 3 AND kind = ''k1'''),
	(5, 'filter on both columns, small key', 'SELECT count(*) FROM events_r WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 3) AND score = 3 AND kind = ''k1'''),
	(6, 'filter on both columns and a range of days', 'SELECT count(*) FROM events_r WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) AND score = 3 AND kind = ''k1'' AND created_at >= date ''2026-03-01'''),
	(7, 'count by id of a score (the rollup lacks the id)', 'SELECT dim_a_id, count(*) FROM events_r WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 1) AND score = 3 GROUP BY 1');
SELECT c.n, c.label, r.* FROM cases_r c, LATERAL probe(c.stmt) r ORDER BY c.n;
 n |                      label                       | same 
---+--------------------------------------------------+------
 1 | filter on both columns, big key                  | t
 2 | sum by kind of a score, big key                  | t
 3 | count by score of a kind, big key                | t
 4 | filter on both columns, mid key                  | t
 5 | filter on both columns, small key                | t
 6 | filter on both columns and a range of days       | t
 7 | count by id of a score (the rollup lacks the id) | t
(7 rows)

-- every byte of the block of a small index with that rollup (groups of 4 units), refused when damaged
CREATE TABLE events_rs (id int PRIMARY KEY, dim_a_id int, created_at date, score int, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events_rs SELECT i, 1 + (i * 7919) % 67, date '2026-01-01' + (i / 40), 1 + i % 10, 'k' || (i % 4), i % 500 FROM generate_series(1, 1500) i;
CREATE INDEX events_rs_col ON events_rs USING sift_col (id, dim_a_id, created_at, score, kind, amount)
	WITH (rollup_columns = 'score, kind: amount', superunit = 4, scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_rs_col;
VACUUM (FREEZE, ANALYZE) events_rs;
SELECT supers > 0 AS has_blocks, damaged > 0 AS damages_made, refused = damaged AS all_refused, unnoticed = 0 AS none_unnoticed FROM sift._test_col_super_damage('events_rs_col');
 has_blocks | damages_made | all_refused | none_unnoticed 
------------+--------------+-------------+----------------
 t          | t            | t           | t
(1 row)

-- writes since the build, deletes and VACUUM, a promotion and a merge: the groups of the segments written are of the rows that are left
INSERT INTO events SELECT 30000 + i, 1 + (i * 31) % 67, date '2026-05-20' + i % 5, 1 + i % 10, 'k' || (i % 4), i % 500 FROM generate_series(1, 3000) i;
SELECT c.n, r.same FROM cases c, LATERAL probe(c.stmt) r ORDER BY c.n;
 n | same 
---+------
 1 | t
 2 | t
 3 | t
 4 | t
 5 | t
 6 | t
 7 | t
 8 | t
 9 | t
(9 rows)

