-- A scope read is exact whatever the maintenance did to the entity parts and the scope summary:
-- (a) a promotion of new facts and then a VACUUM of the table (a promotion takes the rows of the write buffer into the parts, VACUUM rewrites the parts it cleans), with the facts deleted and
--     updated in between;
-- (b) a build with a small segment size writes many entity segments.
-- Every read (the join of one key or of several, a row for each pair, and IN, a fact once) is md5 equal through the scope node, through sift with sift.agg_scope off and through the normal plan.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
-- the scope summary is Format 2.0; the testing library builds new indexes in Format 1.0 when told to
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
\ir test/common/sql/col/scope/base.sql
\set ECHO none
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT m, 1 + (m * 31 + j * 13) % 12 FROM generate_series(1, 300) m, generate_series(0, 5) j WHERE j < m % 7 ON CONFLICT DO NOTHING;
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
-- the reads of the section: the join of one key or of a set of keys (a row for each pair), and IN of a set (a fact once); every row says whether the rows are the same and how the node read them
CREATE FUNCTION reads(rel regclass, OUT n int, OUT same boolean, OUT route text) RETURNS SETOF record LANGUAGE plpgsql AS $$
DECLARE
	k record;
BEGIN
	FOR k IN SELECT * FROM (VALUES (1, '{1}', true), (2, '{5}', true), (3, '{12}', true), (4, '{2,9}', true), (5, '{1,3,5,7,9,11}', false)) v(n, keys, pairs) LOOP
		SELECT r.same, r.route INTO same, route
		FROM scope_read(CASE WHEN k.pairs
			THEN format('SELECT count(*), sum(v), min(id), max(id) FROM %s e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = ANY (%L::int8[])', rel, k.keys)
			ELSE format('SELECT count(*), sum(v), min(id), max(id), count(DISTINCT dim_a_id) FROM %s e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = ANY (%L::int8[]))', rel, k.keys) END) r;
		n := k.n;
		RETURN NEXT;
	END LOOP;
END $$;
-- (a)
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, v int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 7919) % 320, timestamptz '2026-01-01' + (i % 300) * interval '1 day', i % 10, repeat('x', 60) FROM generate_series(1, 6000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, v) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events;
SELECT * FROM reads('events');
 n | same |                   route                    
---+------+--------------------------------------------
 1 | t    | summary
 2 | t    | summary
 3 | t    | summary
 4 | t    | summary
 5 | t    | scan of the facts (the members of the key)
(5 rows)

INSERT INTO events SELECT i, 1 + i % 320, timestamptz '2026-06-01' + i * interval '1 minute', i % 10, 'y' FROM generate_series(6001, 8000) i;
SELECT sift.col_promote('events_col') >= 0 AS promoted;
 promoted 
----------
 t
(1 row)

SELECT * FROM reads('events');
 n | same |                   route                    
---+------+--------------------------------------------
 1 | t    | summary
 2 | t    | summary
 3 | t    | summary
 4 | t    | summary
 5 | t    | scan of the facts (the members of the key)
(5 rows)

DELETE FROM events WHERE id % 4 = 0;
UPDATE events SET v = v + 1 WHERE id % 9 = 0;
VACUUM events;
SELECT * FROM reads('events');
 n | same |  route  
---+------+---------
 1 | t    | summary
 2 | t    | summary
 3 | t    | summary
 4 | t    | summary
 5 | t    | 
(5 rows)

SELECT sift.col_verify('events_col', true);
 col_verify 
------------
 
(1 row)

SELECT sift.col_promote('events_col') >= 0 AS promoted_again;
 promoted_again 
----------------
 t
(1 row)

VACUUM events;
SELECT * FROM reads('events');
 n | same |                   route                    
---+------+--------------------------------------------
 1 | t    | summary
 2 | t    | summary
 3 | t    | summary
 4 | t    | summary
 5 | t    | scan of the facts (the members of the key)
(5 rows)

SELECT sift.col_verify('events_col', true);
 col_verify 
------------
 
(1 row)

DROP TABLE events;
-- (b)
SET sift.test_col_segment_kb = 64;
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, v int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 7919) % 320, timestamptz '2026-01-01' + (i % 300) * interval '1 day', i % 10, repeat('x', 100) FROM generate_series(1, 30000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, v) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events;
SELECT * FROM reads('events');
 n | same |                   route                    
---+------+--------------------------------------------
 1 | t    | summary
 2 | t    | summary
 3 | t    | summary
 4 | t    | summary
 5 | t    | scan of the facts (the members of the key)
(5 rows)

SELECT sift.col_verify('events_col', true);
 col_verify 
------------
 
(1 row)

DROP TABLE events, tenant_scope;
DROP FUNCTION reads(regclass);
DROP FUNCTION scope_run(text, text), scope_group_run(text), scope_reason_ok(text), scope_read(text);
DROP EXTENSION pg_sift;
