-- REINDEX writes the scope segments under the btree the index recorded: a btree made since, even one the rule prefers (a partial unique btree beats a plain one), cannot change which rows are
-- pairs. The record is the dependency of the index on the btree; REINDEX CONCURRENTLY of the scope index keeps it too, and using names a btree on purpose.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
-- Format 1: the scope segments REINDEX writes (col/v1/scope) are this format's; Format 2.0 keeps a scope summary (col/f2/scope_*)
SET sift.test_create_format1 = on;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
SET sift.agg_force = on;
-- the pairs the scope reads for group k and the rows of the join as written (every row of the relation)
CREATE FUNCTION group_read(k int, OUT same boolean, OUT scope_rows bigint, OUT join_rows bigint)
LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE format('SELECT count(*) FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''group_id'', f.dim_a_id, %s)', k) INTO scope_rows;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('SELECT count(*) FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM memberships WHERE group_id = %s)', k) INTO join_rows;
	SET LOCAL sift.enable_agg = on;
	same := scope_rows = join_rows;
END $$;
CREATE FUNCTION try(stmt text) RETURNS text LANGUAGE plpgsql AS
$$ DECLARE hint text; BEGIN EXECUTE stmt; RETURN 'ok';
   EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS hint = PG_EXCEPTION_HINT; RETURN sqlerrm || coalesce(' [' || hint || ']', ''); END $$;
CREATE FUNCTION edges() RETURNS text LANGUAGE plpgsql AS
$$ DECLARE r text; BEGIN SELECT string_agg(refobjid::regclass::text, ' ' ORDER BY refobjid::regclass::text) INTO r FROM pg_depend
   WHERE classid = 'pg_class'::regclass AND objid = 'facts_col'::regclass AND refclassid = 'pg_class'::regclass AND deptype = 'n' AND (SELECT relkind FROM pg_class WHERE oid = refobjid) = 'i'; RETURN r; END $$;
CREATE FUNCTION pred() RETURNS text LANGUAGE plpgsql AS $$ BEGIN RETURN (SELECT coalesce(pred, 'none') FROM sift._test_scope_legs('facts_col', 0)); END $$;
CREATE TABLE memberships (group_id int NOT NULL, dim_a_id int NOT NULL, deleted_at timestamptz, PRIMARY KEY (group_id, dim_a_id)) WITH (autovacuum_enabled = false);
INSERT INTO memberships SELECT 1 + e % 20, e, CASE WHEN e % 9 = 0 THEN now() END FROM generate_series(1, 400) e;
CREATE INDEX memberships_journal ON memberships USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, 1 + i % 450, timestamptz '2026-01-01' + (i % 100) * interval '1 day', i % 10 FROM generate_series(1, 20000) i;
-- the primary key defines the pairs: every row of the relation, the soft deleted ones too
SET client_min_messages = notice;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'group_id: dim_a_id -> memberships(dim_a_id, group_id)');
NOTICE:  scope "group_id": the pairs of "memberships" are the rows of its unique btree "memberships_pkey"
NOTICE:  scope "group_id": 17,800 entries for 20,000 rows (0.89 per row)
NOTICE:  sift_col index "facts_col": 2 automatic choices (key_columns, track_changes)
DETAIL:  key_columns = dim_a_id; track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('facts_col');
NOTICE:  sift_col index "facts_col" has a scope: column format minor 45, which a library before 5.0 cannot read
HINT:  The scope option needs this format: build the index without it for the older library.
SET client_min_messages = warning;
VACUUM (FREEZE, ANALYZE) facts;
SELECT edges(), pred();
                edges                 | pred 
--------------------------------------+------
 memberships_journal memberships_pkey | none
(1 row)

SELECT * FROM group_read(9);
 same | scope_rows | join_rows 
------+------------+-----------
 t    |        890 |       890
(1 row)

-- a partial unique btree made later is what the rule would choose: REINDEX keeps the recorded one, the pairs and the answers are the same
CREATE UNIQUE INDEX memberships_active ON memberships (dim_a_id, group_id) WHERE deleted_at IS NULL;
SET client_min_messages = notice;
REINDEX INDEX facts_col;
NOTICE:  scope "group_id": the pairs of "memberships" are the rows of its unique btree "memberships_pkey"
NOTICE:  scope "group_id": 17,800 entries for 20,000 rows (0.89 per row)
NOTICE:  sift_col index "facts_col": 2 automatic choices (key_columns, track_changes)
DETAIL:  key_columns = dim_a_id; track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('facts_col');
NOTICE:  sift_col index "facts_col" has a scope: column format minor 45, which a library before 5.0 cannot read
HINT:  The scope option needs this format: build the index without it for the older library.
SET client_min_messages = warning;
SELECT edges(), pred();
                edges                 | pred 
--------------------------------------+------
 memberships_journal memberships_pkey | none
(1 row)

SELECT * FROM group_read(9);
 same | scope_rows | join_rows 
------+------------+-----------
 t    |        890 |       890
(1 row)

-- a rebuilt recorded btree is the recorded one
REINDEX INDEX CONCURRENTLY memberships_pkey;
REINDEX INDEX facts_col;
SELECT edges(), pred();
                edges                 | pred 
--------------------------------------+------
 memberships_journal memberships_pkey | none
(1 row)

SELECT * FROM group_read(9);
 same | scope_rows | join_rows 
------+------------+-----------
 t    |        890 |       890
(1 row)

-- so does the rebuild of the scope index itself, without a lock on the table
REINDEX INDEX CONCURRENTLY facts_col;
SELECT edges(), pred();
                edges                 | pred 
--------------------------------------+------
 memberships_journal memberships_pkey | none
(1 row)

SELECT * FROM group_read(9);
 same | scope_rows | join_rows 
------+------------+-----------
 t    |        890 |       890
(1 row)

-- using cannot name another btree than the recorded one (ALTER INDEX is refused), and does where nothing is recorded (the index made again)
SELECT try('ALTER INDEX facts_col SET (scope = ''group_id: dim_a_id -> memberships(dim_a_id, group_id) using memberships_active'')') AS other_btree;
                                                                                                                            other_btree                                                                                                                             
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 scope "group_id": the scope segments were written under the pairs of "memberships_pkey", not "memberships_active" [Change the btree that defines the pairs with DROP INDEX and CREATE INDEX of this index, or make the index again without the scope and with it.]
(1 row)

DROP INDEX facts_col;
SET client_min_messages = notice;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'group_id: dim_a_id -> memberships(dim_a_id, group_id) using memberships_active');
NOTICE:  scope "group_id": the pairs of "memberships" are the rows of its unique btree "memberships_active" that satisfy (deleted_at IS NULL)
NOTICE:  scope "group_id": 15,842 entries for 20,000 rows (0.79 per row)
NOTICE:  sift_col index "facts_col": 2 automatic choices (key_columns, track_changes)
DETAIL:  key_columns = dim_a_id; track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('facts_col');
NOTICE:  sift_col index "facts_col" has a scope: column format minor 45, which a library before 5.0 cannot read
HINT:  The scope option needs this format: build the index without it for the older library.
SET client_min_messages = warning;
SELECT edges(), pred();
                 edges                  |         pred         
----------------------------------------+----------------------
 memberships_active memberships_journal | (deleted_at IS NULL)
(1 row)

-- the reads follow the partial btree now: the soft deleted pairs are no pairs
SELECT scope_rows < join_rows AS fewer FROM group_read(9);
 fewer 
-------
 t
(1 row)

-- the rule chooses again where nothing is recorded: in the index made again
DROP INDEX facts_col;
SET client_min_messages = notice;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'group_id: dim_a_id -> memberships(dim_a_id, group_id)');
NOTICE:  scope "group_id": the pairs of "memberships" are the rows of its unique btree "memberships_active" that satisfy (deleted_at IS NULL)
NOTICE:  scope "group_id": 15,842 entries for 20,000 rows (0.79 per row)
NOTICE:  sift_col index "facts_col": 2 automatic choices (key_columns, track_changes)
DETAIL:  key_columns = dim_a_id; track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('facts_col');
NOTICE:  sift_col index "facts_col" has a scope: column format minor 45, which a library before 5.0 cannot read
HINT:  The scope option needs this format: build the index without it for the older library.
SET client_min_messages = warning;
SELECT edges(), pred();
                 edges                  |         pred         
----------------------------------------+----------------------
 memberships_active memberships_journal | (deleted_at IS NULL)
(1 row)

DROP TABLE facts, memberships;
DROP FUNCTION group_read(int), try(text), edges(), pred();
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
