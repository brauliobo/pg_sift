-- the declaration: a unique btree before a non-unique one, then the partial rule; USING names the other one; the NOTICE says the pairs are a multiset
CREATE TABLE decl_facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz);
INSERT INTO decl_facts SELECT i, 1 + i % 60, timestamptz '2026-01-01' + i * interval '1 hour' FROM generate_series(1, 300) i;
CREATE TABLE decl_pairs (id serial PRIMARY KEY, dim_a_id int NOT NULL, tenant_id int NOT NULL);
INSERT INTO decl_pairs (dim_a_id, tenant_id) SELECT 1 + i % 50, 1 + i % 7 FROM generate_series(1, 200) i;
CREATE INDEX decl_pairs_a ON decl_pairs (dim_a_id, tenant_id);
CREATE INDEX decl_pairs_b ON decl_pairs (tenant_id, dim_a_id);
CREATE INDEX decl_pairs_journal ON decl_pairs USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
SET client_min_messages = notice;
CREATE INDEX decl_facts_col ON decl_facts USING sift_col (id, dim_a_id, created_at) WITH (scope = 'tenant_id: dim_a_id -> decl_pairs(dim_a_id, tenant_id)');
NOTICE:  scope "tenant_id": the pairs of "decl_pairs" (dim_a_id, tenant_id) are the distinct rows of its non-unique btree "decl_pairs_a"
DETAIL:  A pair may be several rows: a read with the meaning of IN or EXISTS counts a fact once, a join counts it once for each row and runs as written.
NOTICE:  scope "tenant_id": making the journal index "decl_pairs_dim_a_id_tenant_id_sift_journal" of "decl_pairs" (dim_a_id, tenant_id)
DETAIL:  The writers of "decl_pairs" wait until the build of this index ends, as for CREATE INDEX on it, for as long as it takes to read the relation. The index goes with the last scope index that uses it.
HINT:  To build it without blocking the writers, name it, place it or keep it, make it first: CREATE INDEX CONCURRENTLY ON public.decl_pairs USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid').
NOTICE:  sift_col index "decl_pairs_dim_a_id_tenant_id_sift_journal" stores columns dim_a_id, tenant_id of index "decl_pairs_journal", which has the same layout
HINT:  One index over the union of their columns is smaller at the same read cost: create it, drop both.
