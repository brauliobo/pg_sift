-- A scope read is the join's whatever the pairs were when the parts were written:
-- (a) a table whose pair relation is empty at the build (facts before grants): the reads are exact at once, before and after the pairs arrive;
-- (b) an index with many entity segments whose members have no pair, then grants and the first rows of members with pairs: the members granted later are read, after every step;
-- (c) the rows that had pairs are deleted and VACUUM cleans their parts: the rows that stay, whose members are granted later, are read exactly.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
-- the scope summary is Format 2.0; the testing library builds new indexes in Format 1.0 when told to
DO $$ BEGIN IF current_setting('sift.test_create_format1', true) IS NOT NULL THEN PERFORM set_config('sift.test_create_format1', 'off', false); END IF; END $$;
\ir test/common/sql/col/scope/base.sql
\set ECHO none
-- the join of one key, and IN of a set of keys (a fact once): every row says whether the rows are the join's and how the node read them
CREATE FUNCTION reads(OUT n int, OUT same boolean, OUT route text) RETURNS SETOF record LANGUAGE plpgsql AS $$
DECLARE
	k record;
BEGIN
	FOR k IN SELECT * FROM (VALUES (1, 'SELECT count(*), sum(v), min(id), max(id) FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = 3'),
		(2, 'SELECT count(*), sum(v), min(id), max(id) FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = ANY (ARRAY[2, 5, 7]))')) v(n, q) LOOP
		SELECT r.same, r.route INTO same, route FROM scope_read(k.q) r;
		n := k.n;
		RETURN NEXT;
	END LOOP;
END $$;
-- (a) the pair relation is empty
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, v int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + i % 100, timestamptz '2026-01-01' + (i % 300) * interval '1 day', i % 10 FROM generate_series(1, 5000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, v) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
SELECT * FROM reads();
 n | same |  route  
---+------+---------
 1 | t    | summary
 2 | t    | 
(2 rows)

INSERT INTO tenant_scope SELECT m, 1 + m % 8 FROM generate_series(1, 100) m;
SELECT * FROM reads();
 n | same |  route  
---+------+---------
 1 | t    | summary
 2 | t    | 
(2 rows)

INSERT INTO events SELECT 10000 + i, 1 + i % 100, timestamptz '2026-02-01', i % 10 FROM generate_series(1, 3000) i;
SELECT sift.col_promote('events_col') >= 0 AS promoted;
 promoted 
----------
 t
(1 row)

SELECT * FROM reads();
 n | same |  route  
---+------+---------
 1 | t    | summary
 2 | t    | 
(2 rows)

SELECT sift.col_maintain('events_col') AS rewritten;
 rewritten 
-----------
 t
(1 row)

SELECT * FROM reads();
 n | same |  route  
---+------+---------
 1 | t    | summary
 2 | t    | 
(2 rows)

SELECT sift.col_verify('events_col', true);
 col_verify 
------------
 
(1 row)

DROP TABLE events, tenant_scope;
-- (b) many entity segments whose members have no pair, then the first rows of members with pairs
SET sift.test_col_segment_kb = 64;
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT m, 1 + m % 8 FROM generate_series(1, 20) m;
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, v int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 101 + (i * 7919) % 200, timestamptz '2026-01-01' + (i % 300) * interval '1 day', i % 10, repeat('x', 100) FROM generate_series(1, 30000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, v) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
SELECT count(*) > 1 AS entity_segments FROM sift.col_segments('events_col') WHERE kind = 'immutable';
 entity_segments 
-----------------
 f
(1 row)

SELECT * FROM reads();
 n | same |  route  
---+------+---------
 1 | t    | summary
 2 | t    | 
(2 rows)

-- the members of the old rows are granted
INSERT INTO tenant_scope SELECT m, 3 FROM generate_series(101, 140) m;
SELECT * FROM reads();
 n | same |  route  
---+------+---------
 1 | t    | summary
 2 | t    | 
(2 rows)

-- the first rows whose members have pairs
INSERT INTO events SELECT 100000 + i, 1 + i % 20, timestamptz '2026-03-01', i % 10, 'y' FROM generate_series(1, 3000) i;
SELECT sift.col_promote('events_col') >= 0 AS promoted;
 promoted 
