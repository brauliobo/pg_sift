-- The merge that ends a parallel key_cut build writes the partitions its bytes make. A partition is sized to the memory of its writer by an estimate of the memory
-- for each byte of segment, and a writer cut by memory before the estimate came true left a piece under half a partition: the rewrite found the index fragmented again
-- and merged the same segments, for each of the 128 steps it takes (maintenance_work_mem 10 MB, the writer budget 4 MB: 11 s of merges, generation 519, for a 2.5 MB index).
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test CASCADE;
SET client_min_messages = warning;
SET sift.async_maintenance = off;
SET max_parallel_maintenance_workers = 2;
SET min_parallel_table_scan_size = 0;
SET maintenance_work_mem = '10MB';
SET statement_timeout = '60s';
CREATE TABLE t (id int, dim int, day date, v int, w int) WITH (autovacuum_enabled = false, parallel_workers = 2);
INSERT INTO t SELECT g, 1 + (g::bigint * 7919 % 12)::int, date '2018-01-01' + (((g::bigint * 2654435761) % 4294967296 / 65536) % 2900)::int, g % 100, (g::bigint * 40503 % 1000003)::int FROM generate_series(1, 200000) g;
VACUUM (FREEZE, ANALYZE) t;
CREATE INDEX t_cut ON t USING sift_col (dim, day, v, w) WITH (key_cut = 'dim, day');
SELECT max(gen) < 64 AS merges_end, count(*) > 1 AS in_partitions FROM sift.col_segments('t_cut') WHERE kind = 'immutable';
 merges_end | in_partitions 
------------+---------------
 t          | t
(1 row)

SELECT sift.col_verify('t_cut', true);
 col_verify 
------------
 
(1 row)

DROP TABLE t;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
