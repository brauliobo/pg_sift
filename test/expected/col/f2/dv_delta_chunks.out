-- The rows a flush of deletes marks in one granule go to the delta tail of the deletion vector of the part in chunks of at most 2048 rows. A flush of 4096 deletes (the least
-- work_mem allows) writes the vector, the rest of the statement is a delta of 2404 rows of one granule, which a page takes, and a later statement appends 3001 more. Every state is compared
-- with a heap that gets the same statements.
CREATE EXTENSION pg_sift;
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE ch (id int, w int) WITH (autovacuum_enabled = false);
CREATE TABLE chh (LIKE ch) WITH (autovacuum_enabled = false);
INSERT INTO ch SELECT i, i & 1023 FROM generate_series(1, 20000) i;
INSERT INTO chh SELECT * FROM ch;
CREATE INDEX ch_col ON ch USING sift_col (id, w);
VACUUM (FREEZE, ANALYZE) ch;
VACUUM (FREEZE, ANALYZE) chh;
CREATE FUNCTION same_as_heap() RETURNS bool LANGUAGE sql AS $$
	SELECT (SELECT (count(*), sum(w), min(id), max(id)) FROM ch) IS NOT DISTINCT FROM (SELECT (count(*), sum(w), min(id), max(id)) FROM chh)
	   AND (SELECT (count(*), sum(w)) FROM ch WHERE id > 3000) IS NOT DISTINCT FROM (SELECT (count(*), sum(w)) FROM chh WHERE id > 3000)
$$;
SET work_mem = '64kB';
DELETE FROM ch WHERE id <= 6500;
DELETE FROM chh WHERE id <= 6500;
RESET work_mem;
SELECT same_as_heap();
 same_as_heap 
--------------
 t
(1 row)

DELETE FROM ch WHERE id BETWEEN 8000 AND 11000;
DELETE FROM chh WHERE id BETWEEN 8000 AND 11000;
SELECT same_as_heap();
 same_as_heap 
--------------
 t
(1 row)

VACUUM ch;
VACUUM chh;
SELECT same_as_heap();
 same_as_heap 
--------------
 t
(1 row)

DROP TABLE ch, chh;
DROP FUNCTION same_as_heap();
DROP EXTENSION pg_sift;
