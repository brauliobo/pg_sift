-- A part of 4100 rows is read in a batch of 4096 rows and one of 4. A string among the numbers of a JSON key leaf makes the part hold exceptions, and the batch of 4, which has none, took the
-- validity of its rows from the batch before it: the sum of the numbers of the key (cast from their text) left out values of the last rows. It is the heap's.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
\set VERBOSITY terse
CREATE FUNCTION uses_agg(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%SiftAgg%' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
CREATE TABLE jt (id int, doc jsonb);
INSERT INTO jt SELECT i, CASE WHEN i % 7 = 0 THEN '{"w": "heavy"}'::jsonb ELSE jsonb_build_object('w', (i % 40) / 4.0) END FROM generate_series(1, 4100) i;
CREATE INDEX jt_col ON jt USING sift_col (id, doc) WITH (paths = 'doc.w float8');
SET seq_page_cost = 10000;
SET max_parallel_workers_per_gather = 0;
SET sift.enable_agg = on;
SELECT uses_agg($q$SELECT sum((doc->>'w')::float8) FROM jt WHERE jsonb_typeof(doc->'w') = 'number'$q$);
 uses_agg 
----------
 t
(1 row)

SELECT sum((doc->>'w')::float8) AS idx FROM jt WHERE jsonb_typeof(doc->'w') = 'number' \gset
SET sift.enable_agg = off;
SELECT sum((doc->>'w')::float8) AS heap FROM jt WHERE jsonb_typeof(doc->'w') = 'number' \gset
SELECT :'idx' = :'heap' AS same, :'heap' AS sum;
 same |   sum    
------+----------
 t    | 17093.75
(1 row)

DROP TABLE jt;
DROP FUNCTION uses_agg(text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
