	zv_f8(7, ARRAY['NaN'::float8], 10, 20, 0, 8192, 96) AS in_nan_with, zv_f8(7, ARRAY['NaN'::float8], 0, 0, 0, 8192, 97) AS in_nan_all_nan, zv_f8(7, ARRAY[15, 'NaN'::float8], 15, 15, 0, 8192, 96) AS in_both,
