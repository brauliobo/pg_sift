-- a transaction sees its own changes and no other's; ABORT leaves none
BEGIN;
CALL apply('tt', 'DELETE FROM @T WHERE id % 100 = 1');
CALL apply('tt', 'UPDATE @T SET v = 0 WHERE id % 100 = 2');
CALL fill('tt', 70001, 70500);
SELECT 'own changes' AS txn, * FROM checks('tt');
     txn     |   label    |   result    
-------------+------------+-------------
 own changes | global     | same scan
 own changes | one key    | same preagg
 own changes | null key   | same preagg
 own changes | two keys   | same preagg
 own changes | key test   | same preagg
 own changes | null test  | same preagg
 own changes | zone test  | same preagg
 own changes | value test | same scan
(8 rows)

ROLLBACK;
SELECT 'rolled back' AS txn, * FROM checks('tt');
     txn     |   label    |   result    
-------------+------------+-------------
 rolled back | global     | same preagg
 rolled back | one key    | same preagg
 rolled back | null key   | same preagg
 rolled back | two keys   | same preagg
 rolled back | key test   | same preagg
 rolled back | null test  | same preagg
 rolled back | zone test  | same preagg
 rolled back | value test | same scan
(8 rows)

BEGIN;
CALL apply('tt', 'DELETE FROM @T WHERE id % 100 = 1');
COMMIT;
SELECT 'committed delete' AS txn, * FROM checks('tt');
       txn        |   label    |   result    
------------------+------------+-------------
 committed delete | global     | same scan
 committed delete | one key    | same preagg
 committed delete | null key   | same preagg
 committed delete | two keys   | same preagg
 committed delete | key test   | same preagg
 committed delete | null test  | same preagg
 committed delete | zone test  | same preagg
 committed delete | value test | same scan
(8 rows)

VACUUM tt, tth;
SELECT 'vacuum' AS txn, * FROM checks('tt');
  txn   |   label    |   result    
--------+------------+-------------
 vacuum | global     | same scan
 vacuum | one key    | same preagg
 vacuum | null key   | same preagg
 vacuum | two keys   | same preagg
 vacuum | key test   | same preagg
 vacuum | null test  | same preagg
 vacuum | zone test  | same preagg
 vacuum | value test | same scan
(8 rows)

-- the cubes a table declares: 'off' stores none, a declaration stores the cubes it names (and the measures it names: the others scan)
CALL load('tf');
SELECT sift.table_set_option('tf', 'preagg', 'off') IS NOT NULL AS option_set;
 option_set 
