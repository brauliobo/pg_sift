INSERT INTO pch SELECT i, i % 7, i % 3, (i * 37) % 10007, (i % 1000) / 100.0, 0, 'x' FROM generate_series(40001, 41500) i;
SELECT 'insert, in the slab' AS churn, * FROM pars();
