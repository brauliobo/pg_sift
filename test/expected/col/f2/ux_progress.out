-- 5. pg_stat_progress_vacuum while a sift_table is vacuumed: the table has a row in the view, with blocks that only grow up to the total
CREATE TABLE tbl (id int PRIMARY KEY, g int, v numeric(10,2)) USING sift_table;
INSERT INTO tbl SELECT i, i % 10, i / 4.0 FROM generate_series(1, :rows) i;
DELETE FROM tbl WHERE g IN (1, 2, 3);
CREATE TABLE vsamples (phase text, blocks_done int8, blocks_total int8, dead_ids int8, dead_bytes int8, max_dead_bytes int8, cycles int8);
CREATE FUNCTION sample_vacuum(rel regclass, conn text, secs int) RETURNS void LANGUAGE plpgsql AS $$
DECLARE stop timestamptz := clock_timestamp() + secs * interval '1 second';
BEGIN
	WHILE clock_timestamp() < stop AND dblink_is_busy(conn) = 1 LOOP
		PERFORM pg_stat_clear_snapshot();
		INSERT INTO vsamples SELECT phase, heap_blks_scanned, heap_blks_total, num_dead_item_ids, dead_tuple_bytes, max_dead_tuple_bytes, index_vacuum_count
			FROM pg_stat_progress_vacuum WHERE relid = rel;
		PERFORM pg_sleep(0.002);
	END LOOP;
END $$;
SELECT dblink_send_query('b', 'VACUUM ux.tbl');
