-- Format 2.0 live progress and one-line summaries (Spec 31 2.2, 2.3, 2.5). Run on a build where new tables and indexes take Format 2.0; needs dblink and pg_sift_test.
-- Sections 1 and 2 print nothing (the golden output has no NOTICE or INFO line: the silence of a small quick build, of client_min_messages = warning and of a plain VACUUM is the contract).
-- Sections 3 to 5 check themselves: a second connection runs the statement while this one samples the progress views (about 2 s with :rows rows; default 60000, 8 granules).
-- Section 6 prints the lines and is run on request: psql -v show_messages=1 (its numbers are the timings and sizes of the machine, so it has no golden output).
CREATE EXTENSION IF NOT EXISTS pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE EXTENSION IF NOT EXISTS dblink;
SET sift.test_create_format1 = off;
SET max_parallel_maintenance_workers = 0;
SET statement_timeout = '240s';
\if :{?rows}
\else
\set rows 60000
\endif
CREATE SCHEMA ux;
SET search_path = ux, public;
CREATE FUNCTION chk(name text, ok boolean) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	IF NOT ok THEN RAISE EXCEPTION 'FAILED %', name; END IF;
	RETURN name || ': ok';
END $$;
-- 1. a build that is small, quick and chooses nothing says nothing; neither does a REINDEX, a plain VACUUM or a build under client_min_messages = warning
SET client_min_messages = notice;
\set VERBOSITY terse
CREATE TABLE tiny (id int, g int);
INSERT INTO tiny SELECT i, i % 7 FROM generate_series(1, 200) i;
CREATE INDEX tiny_i ON tiny USING sift_col (id, g) WITH (key_order = 'id', track_changes = off);
REINDEX INDEX tiny_i;
DELETE FROM tiny WHERE g = 3;
VACUUM tiny;
-- 2. a large build under client_min_messages = warning says nothing either
CREATE TABLE ev (id int PRIMARY KEY, g int, v int, s text);
INSERT INTO ev SELECT i, i % 100, i % 1000, 'row ' || i FROM generate_series(1, :rows) i;
ANALYZE ev;
SET client_min_messages = warning;
CREATE INDEX ev_quiet ON ev USING sift_col (g, v, s) WITH (key_order = 'g', track_changes = off);
DROP INDEX ev_quiet;
SET client_min_messages = notice;
-- 3. pg_stat_progress_create_index while a Format 2.0 index is built (serial): the phases are the named ones, the rows only grow, none is past the rows of the table
CREATE TABLE samples (at timestamptz, phase text, tuples_done int8, tuples_total int8, blocks_done int8, blocks_total int8, parts_done int8, parts_total int8);
CREATE FUNCTION sample_create_index(rel regclass, conn text, secs int) RETURNS void LANGUAGE plpgsql AS $$
DECLARE stop timestamptz := clock_timestamp() + secs * interval '1 second';
BEGIN
	WHILE clock_timestamp() < stop AND dblink_is_busy(conn) = 1 LOOP
		PERFORM pg_stat_clear_snapshot();
		INSERT INTO samples SELECT clock_timestamp(), phase, tuples_done, tuples_total, blocks_done, blocks_total, partitions_done, partitions_total
			FROM pg_stat_progress_create_index WHERE relid = rel;
		PERFORM pg_sleep(0.002);
	END LOOP;
END $$;
-- CREATE INDEX CONCURRENTLY waits for every transaction that holds an older snapshot, the sampling session's own among them: it samples one transaction at a time
CREATE PROCEDURE sample_create_index_concurrently(rel regclass, conn text, secs int) LANGUAGE plpgsql AS $$
DECLARE stop timestamptz := clock_timestamp() + secs * interval '1 second';
BEGIN
	WHILE clock_timestamp() < stop AND dblink_is_busy(conn) = 1 LOOP
		PERFORM pg_stat_clear_snapshot();
		INSERT INTO samples SELECT clock_timestamp(), phase, tuples_done, tuples_total, blocks_done, blocks_total, partitions_done, partitions_total
			FROM pg_stat_progress_create_index WHERE relid = rel;
		COMMIT;
		PERFORM pg_sleep(0.010);
	END LOOP;
END $$;
CREATE FUNCTION build_checks(label text, nrows bigint) RETURNS SETOF text LANGUAGE plpgsql AS $$
BEGIN
	RETURN NEXT chk(label || ': a sample was taken', (SELECT count(*) FROM samples) > 0);
	RETURN NEXT chk(label || ': every phase is a named one', (SELECT coalesce(bool_and(phase ~ '^(initializing|waiting for .*|index validation: .*|building index: (initializing|sampling schema and key order|scanning table|writing parts|building scope summaries|installing change tracking))$'), true) FROM samples));
	RETURN NEXT chk(label || ': scanning table is reported', (SELECT count(*) FROM samples WHERE phase = 'building index: scanning table') > 0);
	RETURN NEXT chk(label || ': tuples_done only grows', (SELECT coalesce(bool_and(tuples_done >= prev), true)
		FROM (SELECT tuples_done, max(tuples_done) OVER (ORDER BY at ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS prev FROM samples WHERE phase LIKE 'building index%') s));
	RETURN NEXT chk(label || ': tuples_done is not past the rows', (SELECT coalesce(max(tuples_done), 0) FROM samples) <= nrows);
	RETURN NEXT chk(label || ': blocks_done is not past blocks_total', (SELECT coalesce(bool_and(blocks_done <= blocks_total), true) FROM samples WHERE blocks_total > 0));
END $$;
CREATE FUNCTION finish(conn text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	LOOP
		PERFORM 1 FROM dblink_get_result(conn) AS t(r text);
		EXIT WHEN NOT FOUND;
	END LOOP;
END $$;
