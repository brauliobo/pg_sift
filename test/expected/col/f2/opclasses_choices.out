 encoding(n#1) | t               | t
 encoding(n)   | t               | t
 encoding(t)   | t               | t
 encoding(ts)  | t               | t
 encoding(v)   | t               | t
(6 rows)

CREATE INDEX ocf_keyed ON ocf USING sift_col (id, ts, v, n, t) WITH (key_order = 'ts');
SELECT choice, value FROM sift.index_choices('ocf_keyed') WHERE choice IN ('key_order', 'layout') ORDER BY choice;
