(4 rows)

SELECT choice, value ~ '^[a-z0-9_]+ x[0-9]+' AS names_encodings, cost ~ '^[0-9]+ bytes$' AS has_cost FROM sift.index_choices('ocf_col') WHERE choice LIKE 'encoding(%' ORDER BY choice;
    choice     | names_encodings | has_cost 
---------------+-----------------+----------
