-- Format major 2: the time bounds of every part and partition prune the scans on date and timestamp columns that are not the lead key (cold parts are not opened), a late-arriving old
-- row does not widen the bounds of a hot part, the compaction splits the hot rows from the cold ones, the reads through a ReadStream answer as the reads one block at a time do, the
-- allocator hands out the lowest free block first, the free run at the end of the file is given back, and block 0 keeps the summary of the partitions inline.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE EXTENSION pg_sift_helpers;
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
\set VERBOSITY terse
-- the parts a query opens and the parts its time window rules out, from the counters of the scan
CREATE FUNCTION f2_window(q text, OUT result bigint, OUT parts_read int8, OUT parts_skipped int8) LANGUAGE plpgsql AS $$
DECLARE c int8[];
BEGIN
	SET LOCAL enable_seqscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_bitmapscan = on;
	PERFORM sift._test_f2_prune_counters(true);
	EXECUTE q INTO result;
	c := sift._test_f2_prune_counters(true);
	parts_read := c[1];
	parts_skipped := c[2];
END $$;
-- Nine cold batches (200 to 160 days old, 5 days apart) and one hot batch: a part each, on two timestamp columns that are not the key
CREATE TABLE ev (id bigint, tenant int, created_at timestamptz, updated_at timestamptz, v float8);
CREATE INDEX ev_idx ON ev USING sift_col (id, tenant, created_at, updated_at, v) WITH (key_order = 'id');
DO $$ BEGIN
	FOR b IN 0 .. 9 LOOP
		INSERT INTO ev SELECT b * 16000 + i, i % 40,
			CASE WHEN b < 9 THEN now() - ((200 - b * 5) || ' days')::interval + i * interval '1 second' ELSE now() - i * interval '1 second' END,
			CASE WHEN b < 9 THEN now() - ((200 - b * 5) || ' days')::interval + i * interval '1 second' ELSE now() - i * interval '1 second' END, i % 977
		FROM generate_series(1, 16000) i;
		COMMIT;
	END LOOP;
END $$;
SELECT count(*) AS parts, bool_and(flags & 128 <> 0 AND flags & 256 <> 0) AS time_bounds_known FROM sift._test_f2_parts('ev_idx', 1, NULL);
 parts | time_bounds_known 
-------+-------------------
    10 | t
(1 row)

SELECT sift._test_f2_check_keys('ev_idx');
          _test_f2_check_keys           
----------------------------------------
 parts=10 granules=20 rows=160000 exact
(1 row)

SELECT sift._test_f2_check('ev_idx') ~ '^parts=10 ' AS consistent;
 consistent 
------------
 t
(1 row)

SELECT (now() - interval '7 days')::text AS hot_cut \gset
SELECT (now() - interval '170 days')::text AS cold_lo, (now() - interval '169 days')::text AS cold_hi \gset
-- a window on the second time column or on the first opens the hot part alone: nine of ten parts, 90%, are not opened
SELECT result, parts_read, parts_skipped, parts_skipped * 10 >= (parts_read + parts_skipped) * 9 AS cold_pruned
FROM f2_window('SELECT count(*) FROM ev WHERE updated_at >= ' || quote_literal(:'hot_cut'));
 result | parts_read | parts_skipped | cold_pruned 
--------+------------+---------------+-------------
  16000 |          1 |             9 | t
(1 row)

SELECT result, parts_read, parts_skipped, parts_skipped * 10 >= (parts_read + parts_skipped) * 9 AS cold_pruned
FROM f2_window('SELECT count(*) FROM ev WHERE created_at >= ' || quote_literal(:'hot_cut'));
 result | parts_read | parts_skipped | cold_pruned 
--------+------------+---------------+-------------
  16000 |          1 |             9 | t
(1 row)

-- a window inside one cold batch opens that part alone
SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE updated_at >= ' || quote_literal(:'cold_lo') || ' AND updated_at < ' || quote_literal(:'cold_hi'));
 result | parts_read | parts_skipped 
--------+------------+---------------
  16000 |          1 |             9
(1 row)

-- a window that no part holds opens none; an open window opens all of them
SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE updated_at >= now() + interval ''1 day''');
 result | parts_read | parts_skipped 
--------+------------+---------------
      0 |          0 |            10
(1 row)

SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE updated_at >= now() - interval ''1000 days''');
 result | parts_read | parts_skipped 
--------+------------+---------------
 160000 |         10 |             0
(1 row)

SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE tenant = 7');
 result | parts_read | parts_skipped 
--------+------------+---------------
   4000 |         10 |             0
(1 row)

-- the answers are those of the heap
SELECT sift_helpers.f2_same('SELECT count(*), sum(tenant) FROM ev WHERE updated_at >= ' || quote_literal(:'hot_cut'));
 f2_same 
---------
 same
(1 row)

SELECT sift_helpers.f2_same('SELECT id FROM ev WHERE created_at >= ' || quote_literal(:'cold_lo') || ' AND created_at < ' || quote_literal(:'cold_hi') || ' AND tenant < 3');
 f2_same 
---------
 same
(1 row)

SELECT sift_helpers.f2_same('SELECT count(*) FROM ev WHERE updated_at < ' || quote_literal(:'cold_hi'));
 f2_same 
---------
 same
(1 row)

-- a part the time bounds do not rule out is opened whether or not the rows pass: the window is about parts, the predicate about rows
SELECT result FROM f2_window('SELECT count(*) FROM ev WHERE updated_at >= ' || quote_literal(:'hot_cut') || ' AND tenant = 39');
 result 
--------
    400
(1 row)

-- Late arrivals: old rows that land in the next part with hot ones
INSERT INTO ev SELECT 200000 + i, i % 40, CASE WHEN i % 2 = 0 THEN now() - i * interval '1 second' ELSE now() - interval '150 days' + i * interval '1 second' END, now(), i % 977
FROM generate_series(1, 2000) i;
SELECT count(*) AS parts FROM sift._test_f2_parts('ev_idx', 1, NULL);
 parts 
-------
    10
(1 row)

SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE created_at >= ' || quote_literal(:'hot_cut'));
 result | parts_read | parts_skipped 
--------+------------+---------------
  17000 |          1 |             9
(1 row)

-- The compaction splits the hot rows from the cold ones: two parts, the hot one holds the hot batch and the hot half of the late rows
DO $$ DECLARE grp text;
BEGIN
	FOREACH grp IN ARRAY string_to_array(sift._test_f2_plan('ev_idx', 1, NULL), ' / ') LOOP
		CONTINUE WHEN grp = '';
		PERFORM sift._test_f2_compact('ev_idx', 1, NULL, string_to_array(grp, ',')::int8[]);
	END LOOP;
END $$;
SELECT level, flags & 32 <> 0 AS hot, flags & 64 <> 0 AS cold, nrows FROM sift._test_f2_parts('ev_idx', 1, NULL) ORDER BY hot DESC;
 level | hot | cold | nrows  
-------+-----+------+--------
     2 | t   | f    |  16000
     2 | f   | t    | 128000
     2 | f   | t    |  16000
(3 rows)

SELECT sift._test_f2_check('ev_idx') ~ '^parts=3 ' AS consistent;
 consistent 
------------
 t
(1 row)

SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE created_at >= ' || quote_literal(:'hot_cut'));
 result | parts_read | parts_skipped 
--------+------------+---------------
  17000 |          1 |             2
(1 row)

SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE updated_at < ' || quote_literal(:'cold_hi'));
 result | parts_read | parts_skipped 
--------+------------+---------------
 112000 |          1 |             2
(1 row)

SELECT sift_helpers.f2_same('SELECT count(*), sum(id) FROM ev WHERE created_at >= ' || quote_literal(:'hot_cut'));
 f2_same 
---------
 same
(1 row)

SELECT sift_helpers.f2_same('SELECT count(*), sum(id) FROM ev WHERE created_at < ' || quote_literal(:'hot_cut'));
 f2_same 
---------
 same
(1 row)

-- A late row with an old time goes to the cold part at the next compaction, and the hot part keeps its bounds
INSERT INTO ev SELECT 300000 + i, i % 40, now() - interval '120 days' + i * interval '1 second', now(), i FROM generate_series(1, 20000) i;
DO $$ DECLARE grp text;
BEGIN
	FOREACH grp IN ARRAY string_to_array(sift._test_f2_plan('ev_idx', 1, NULL), ' / ') LOOP
		CONTINUE WHEN grp = '';
		PERFORM sift._test_f2_compact('ev_idx', 1, NULL, string_to_array(grp, ',')::int8[]);
	END LOOP;
END $$;
SELECT level, flags & 32 <> 0 AS hot, flags & 64 <> 0 AS cold FROM sift._test_f2_parts('ev_idx', 1, NULL) ORDER BY hot DESC, cold DESC, level;
 level | hot | cold 
-------+-----+------
     2 | t   | f
     2 | f   | t
     2 | f   | t
     1 | f   | f
(4 rows)

SELECT result, parts_read, parts_skipped FROM f2_window('SELECT count(*) FROM ev WHERE created_at >= ' || quote_literal(:'hot_cut'));
 result | parts_read | parts_skipped 
--------+------------+---------------
  17000 |          1 |             3
(1 row)

SELECT sift_helpers.f2_same('SELECT count(*), sum(id) FROM ev WHERE created_at >= ' || quote_literal(:'hot_cut'));
 f2_same 
---------
 same
(1 row)

SELECT sift_helpers.f2_same('SELECT count(*), sum(id) FROM ev WHERE created_at >= ' || quote_literal(:'cold_lo') || ' AND created_at < ' || quote_literal(:'cold_hi'));
 f2_same 
---------
 same
(1 row)

-- The reads of a ReadStream or of ReadBuffer one block at a time answer alike: scans of many parts, a compaction and deletes
CREATE FUNCTION f2_both_ways(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text;
BEGIN
	SET LOCAL sift.test_io_read_stream = on;
	a := sift_helpers.f2_same(q);
	SET LOCAL sift.test_io_read_stream = off;
	b := sift_helpers.f2_same(q);
	RETURN CASE WHEN a = 'same' AND b = 'same' THEN 'same' ELSE 'DIFFERENT: ' || a || ' / ' || b END;
END $$;
CREATE TABLE rs (id bigint, tenant int, status text, created_at timestamptz, amount numeric(12, 2), note text);
CREATE INDEX rs_idx ON rs USING sift_col (id, tenant, status, created_at, amount, note) WITH (key_order = 'id');
DO $$ BEGIN
	FOR b IN 0 .. 5 LOOP
		INSERT INTO rs SELECT b * 30000 + i, i % 40, (ARRAY['new', 'open', 'closed', 'paused'])[1 + i % 4], now() - ((i % 300) || ' days')::interval, (i % 9000) / 100.0, 'note-' || (i % 5000)
		FROM generate_series(1, 30000) i;
		COMMIT;
	END LOOP;
END $$;
SELECT count(*) AS parts FROM sift._test_f2_parts('rs_idx', 1, NULL);
 parts 
-------
     6
(1 row)

SELECT f2_both_ways('SELECT count(*), sum(amount), min(note) FROM rs WHERE status = ''open''');
 f2_both_ways 
--------------
 same
(1 row)

SELECT f2_both_ways('SELECT id, note FROM rs WHERE id BETWEEN 40000 AND 40300');
 f2_both_ways 
--------------
 same
(1 row)

SELECT f2_both_ways('SELECT count(*), sum(tenant) FROM rs WHERE amount > 80');
 f2_both_ways 
--------------
 same
(1 row)

SELECT f2_both_ways('SELECT * FROM rs WHERE id IN (7, 45000, 90001, 179999)');
 f2_both_ways 
--------------
 same
(1 row)

SET sift.test_io_read_stream = off;
DO $$ DECLARE grp text;
BEGIN
	FOREACH grp IN ARRAY string_to_array(sift._test_f2_plan('rs_idx', 1, NULL), ' / ') LOOP
		CONTINUE WHEN grp = '';
		PERFORM sift._test_f2_compact('rs_idx', 1, NULL, string_to_array(grp, ',')::int8[]);
	END LOOP;
END $$;
SET sift.test_io_read_stream = on;
SELECT count(*) AS parts FROM sift._test_f2_parts('rs_idx', 1, NULL);
 parts 
-------
     3
(1 row)

SELECT f2_both_ways('SELECT count(*), sum(amount), min(note) FROM rs WHERE status = ''open''');
 f2_both_ways 
--------------
 same
(1 row)

SELECT f2_both_ways('SELECT id, note FROM rs WHERE id BETWEEN 100000 AND 100300');
 f2_both_ways 
--------------
 same
(1 row)

DELETE FROM rs WHERE id % 7 = 0;
VACUUM rs;
SELECT f2_both_ways('SELECT count(*), sum(amount), min(note) FROM rs WHERE status = ''closed''');
 f2_both_ways 
--------------
 same
(1 row)

SELECT f2_both_ways('SELECT id, note FROM rs WHERE id BETWEEN 100000 AND 100300');
 f2_both_ways 
--------------
 same
(1 row)

SELECT f2_both_ways('SELECT count(*) FROM rs WHERE created_at >= now() - interval ''30 days''');
 f2_both_ways 
--------------
 same
(1 row)

SELECT sift._test_f2_check_keys('rs_idx');
          _test_f2_check_keys          
---------------------------------------
 parts=3 granules=20 rows=154286 exact
(1 row)

RESET sift.test_io_read_stream;
-- The allocator hands out the lowest free block first: single blocks released out of order come back in ascending order
CREATE TABLE fs (v int);
CREATE INDEX fs_idx ON fs USING sift_store_test (v);
SELECT sift._test_f2_init('fs_idx');
 _test_f2_init 
---------------
 
(1 row)

SELECT sift._test_f2_alloc('fs_idx', 64) IS NOT NULL AS pad;
 pad 
-----
 t
(1 row)

SELECT array_agg((a).start ORDER BY ord) AS held FROM (SELECT ord, sift._test_f2_alloc('fs_idx', 1) a FROM generate_series(1, 12) ord) q \gset
SELECT sift._test_f2_release('fs_idx', b, 1, 'none') FROM unnest(:'held'::int8[]) WITH ORDINALITY t(b, o) WHERE o % 2 = 0 ORDER BY o DESC;
 _test_f2_release 
------------------
 
 
 
 
 
 
(6 rows)

SELECT sift._test_f2_reclaim('fs_idx');
 _test_f2_reclaim 
------------------
                6
(1 row)

WITH got AS MATERIALIZED (SELECT i, (sift._test_f2_alloc('fs_idx', 1)).start AS b FROM generate_series(1, 6) i)
SELECT array_agg(b ORDER BY i) = array_agg(b ORDER BY b) AND min(b) <= (:'held'::int8[])[2] AS lowest_first FROM got;
 lowest_first 
--------------
 t
(1 row)

SELECT sift._test_f2_check('fs_idx');
             _test_f2_check              
-----------------------------------------
 parts=0 quarantined=0/0 meta_free=15/16
(1 row)

-- The free run at the end of the file is given back: the extents at its end are released, the high-water mark falls to the live blocks and the file is cut there
SELECT (sift._test_f2_alloc('fs_idx', 1024)).start AS run1 \gset
SELECT (sift._test_f2_alloc('fs_idx', 1024)).start AS run2 \gset
SELECT sift._test_f2_extend_file('fs_idx', :run2 + 1024) = :run2 + 1024 AS file_extended;
 file_extended 
---------------
 t
(1 row)

SELECT blocks_truncated, high_water = file_blocks AS file_at_high_water FROM sift._test_f2_tail_shrink('fs_idx');
 blocks_truncated | file_at_high_water 
------------------+--------------------
                0 | t
(1 row)

SELECT sift._test_f2_release('fs_idx', :run1, 1024, 'none');
 _test_f2_release 
------------------
 
(1 row)

SELECT sift._test_f2_release('fs_idx', :run2, 1024, 'none');
 _test_f2_release 
------------------
 
(1 row)

SELECT blocks_truncated >= 2048 AS tail_given_back, NOT lock_skipped AS not_busy, high_water <= :run1 AS high_water_at_run, file_blocks = high_water AS file_cut
FROM sift._test_f2_tail_shrink('fs_idx');
 tail_given_back | not_busy | high_water_at_run | file_cut 
-----------------+----------+-------------------+----------
 t               | t        | t                 | t
(1 row)

SELECT (sift._test_f2_alloc('fs_idx', 1024)).start <= :run1 AS tail_reused;
 tail_reused 
-------------
 t
(1 row)

SELECT sift._test_f2_check('fs_idx');
             _test_f2_check              
-----------------------------------------
 parts=0 quarantined=0/0 meta_free=14/16
(1 row)

-- Block 0 keeps the summary of the partitions inline, and the check of the manifest compares it with the directory
SELECT inline_len > 0 AS inline, inline_parts, flagged FROM sift._test_f2_meta_inline('ev_idx');
 inline | inline_parts | flagged 
--------+--------------+---------
 t      |            1 | t
(1 row)

SELECT sift._test_f2_check('ev_idx') ~ '^parts=' AS consistent;
 consistent 
------------
 t
(1 row)

DROP TABLE ev, rs, fs;
DROP FUNCTION f2_window(text), f2_both_ways(text);
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
