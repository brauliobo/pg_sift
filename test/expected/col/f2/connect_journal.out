-- the journal and the connections go with the indexes, and the parent index cannot go under a child
DROP INDEX dim_col;
ERROR:  cannot drop index dim_col because other objects depend on it
DETAIL:  index ev_col depends on index dim_col
index ev_uniq depends on index dim_col
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
DROP TABLE dim CASCADE;
