 child writes |     1 | t            | t
 child writes |     2 | t            | t
 child writes |     3 | t            | t
(3 rows)

SELECT * FROM journaled('child writes');
    stage     | records_moved 
--------------+---------------
 child writes | f
(1 row)

-- VACUUM and sift.maintain() trim the journal of what no reader counts, and keep what a stamp may need
UPDATE dim SET b = 1 WHERE k = 11;
VACUUM (INDEX_CLEANUP ON) dim;
