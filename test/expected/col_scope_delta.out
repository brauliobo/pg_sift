-- The rows of the write buffers have no scope entries. A read of a scope key reads them from the buffers, once for each pair of their member under the statement's snapshot (the delta, as the promotion
-- would write them) and the stored units of every member that did not change: the rows it reads besides the units are those of the buffers, not the entity rows of the table. Table-driven: each state
-- of the facts and the pairs (the states accumulate), each read shape; every read is md5 equal to the plain join, says whether it took the units, and how many rows its delta read next to the
-- rows of the buffers. A member whose pairs changed is patched through the entity rows, the buffer rows of it with the rest of its rows (sift.test_scope_patch: the cluster of the tests patches
-- whatever it costs).
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
-- members in up to six keys on purpose: above the default limit of the multiplicity
SET sift.scope_max_multiplicity = 8;
SET jit = off;
SET client_min_messages = warning;
SET sift.agg_force = on;
-- q: the statement over the scope units; plain: the same over the join of the pairs
CREATE FUNCTION scope_run(q text, plain text, OUT same boolean, OUT stored boolean, OUT why text, OUT patched_keys int, OUT delta_rows int)
LANGUAGE plpgsql AS $$
DECLARE
	p jsonb;
	a text;
	b text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	BEGIN
		EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF, FORMAT JSON) ' || q INTO p;
		EXECUTE 'SELECT coalesce(json_agg(t)::text, '''') FROM (' || q || ') t' INTO a;
	EXCEPTION WHEN feature_not_supported THEN
		same := NULL;
		stored := false;
		why := 'error: ' || substring(SQLERRM FROM '"(.*)"');
		RETURN;
	END;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'SELECT coalesce(json_agg(t)::text, '''') FROM (' || plain || ') t' INTO b;
	SET LOCAL sift.enable_agg = on;
	same := a = b;
	why := jsonb_path_query_first(p, '$.**."Scope Fallback"') #>> '{}';
	stored := jsonb_path_exists(p, '$.**."Scope Units Read"');
	patched_keys := coalesce(jsonb_path_query_first(p, '$.**."Scope Patched Keys"')::text::int, 0);
	delta_rows := coalesce(jsonb_path_query_first(p, '$.**."Scope Delta Rows"')::text::int, 0);
END $$;
-- 12 groups; member m is in 1 + m % 6 of them (1 to 6), members 100..109 are in none, members 301..320 have facts and no pair; 20,000 padded facts, some without a member
CREATE TABLE membership (dim_a_id int, group_id int, PRIMARY KEY (dim_a_id, group_id));
INSERT INTO membership SELECT m, 1 + (m * 5 + j * 7) % 12 FROM generate_series(1, 300) m, generate_series(0, m % 6) j WHERE m NOT BETWEEN 100 AND 109 ON CONFLICT DO NOTHING;
CREATE INDEX membership_journal ON membership USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, at timestamptz, v int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, CASE WHEN i % 97 = 0 THEN NULL ELSE 1 + (i * 7919) % 320 END,
	timestamptz '2026-01-01' + (i % 300) * interval '1 day', i % 10, repeat('x', 100) FROM generate_series(1, 20000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, at, v)
	WITH (scope = 'group_id: dim_a_id -> membership(dim_a_id, group_id)');
REINDEX INDEX facts_col;
VACUUM (FREEZE, ANALYZE) facts;
VACUUM (ANALYZE) membership;
-- the read shapes: nkeys the keys each has (a read per pair of them counts a row for each pair, so its delta may hold that many copies of a buffer row), @ the scope conjunct and $ its keys
CREATE TABLE shapes (n int, label text, nkeys int, pairs boolean, keys int8[], q text, plain text);
INSERT INTO shapes VALUES
	(1, 'one key, count and sum', 1, false, '{3}', 'SELECT count(*), sum(v), min(id), max(id) FROM facts f WHERE @',
		'SELECT count(*), sum(v), min(id), max(id) FROM facts f WHERE EXISTS (SELECT 1 FROM membership m WHERE m.dim_a_id = f.dim_a_id AND m.group_id = ANY ($))'),
	(2, 'IN list of keys', 3, false, '{7,9,11}', 'SELECT count(*), sum(v), min(id), max(id) FROM facts f WHERE @',
		'SELECT count(*), sum(v), min(id), max(id) FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM membership WHERE group_id = ANY ($))'),
	(3, 'EXISTS, dim_b in several keys', 6, false, '{1,2,3,4,5,6}', 'SELECT count(*), sum(v), min(id), max(id) FROM facts f WHERE @',
		'SELECT count(*), sum(v), min(id), max(id) FROM facts f WHERE EXISTS (SELECT 1 FROM membership m WHERE m.dim_a_id = f.dim_a_id AND m.group_id = ANY ($))'),
	(4, 'a row for each pair of three keys', 3, true, '{3,5,7}', 'SELECT count(*), sum(v), min(id), max(id) FROM facts f WHERE @',
		'SELECT count(*), sum(v), min(id), max(id) FROM facts f JOIN membership m ON m.dim_a_id = f.dim_a_id WHERE m.group_id = ANY ($)'),
	(5, 'listing of one key', 1, false, '{4}', 'SELECT id, v FROM facts f WHERE @ ORDER BY id DESC LIMIT 25',
		'SELECT id, v FROM facts f WHERE EXISTS (SELECT 1 FROM membership m WHERE m.dim_a_id = f.dim_a_id AND m.group_id = ANY ($)) ORDER BY id DESC LIMIT 25');
-- delta: none, within the rows of the buffers (the copies a pair of each of the keys makes at most), or more than they hold
CREATE FUNCTION probe() RETURNS TABLE (n int, label text, verdict text, route text, delta text, patched boolean) LANGUAGE sql AS $$
	SELECT s.n, s.label, CASE r.same WHEN true THEN 'same' WHEN false THEN 'DIFFERENT' ELSE 'needs the join' END, coalesce(r.why, CASE WHEN r.stored THEN 'units' END),
		CASE WHEN r.delta_rows IS NULL THEN 'no read' WHEN r.delta_rows = 0 THEN 'none' WHEN r.delta_rows <= b.rows * s.nkeys THEN 'within the buffers' ELSE 'MORE THAN THE BUFFERS' END, r.patched_keys > 0
	FROM shapes s,
		LATERAL (SELECT coalesce(sum(rows), 0) AS rows FROM sift.col_segments('facts_col') WHERE kind = 'buffer') b,
		LATERAL scope_run(
			replace(s.q, '@', format('sift.in_scope%s(''facts_col''::regclass, ''group_id'', f.dim_a_id, %L::int8[])', CASE WHEN s.pairs THEN '_pairs' END, s.keys)),
			replace(s.plain, '$', format('%L::int8[]', s.keys))) r
	ORDER BY s.n
$$;
-- each state: the statement that makes it (they accumulate), and then the reads
CREATE TABLE states (n int, label text, stmt text);
INSERT INTO states VALUES
	(1, 'buffered inserts, 1% of the table (dim_b of any number of keys, of none, of no member)',
		'INSERT INTO facts SELECT 20000 + i, CASE WHEN i % 50 = 0 THEN NULL ELSE 1 + (i * 37) % 320 END, timestamptz ''2026-02-01'', 1, ''y'' FROM generate_series(1, 200) i'),
	(2, 'buffered updates (the old versions dead in their units) and deletes (stored rows and buffered ones)',
		'UPDATE facts SET v = v + 100 WHERE id % 9 = 0 AND id <= 20000; DELETE FROM facts WHERE id % 11 = 0 AND id <= 20000; DELETE FROM facts WHERE id > 20000 AND id % 7 = 0'),
	(3, 'pairs added (dim_b that have buffered rows too)',
		'INSERT INTO membership VALUES (1, 12), (2, 12), (7, 12), (301, 12), (302, 3), (303, 5), (303, 3) ON CONFLICT DO NOTHING'),
	(4, 'pairs removed',
		'DELETE FROM membership WHERE group_id = 3 AND dim_a_id % 5 = 0'),
	(5, 'pairs moved (a member changes tenant)',
		'WITH d AS (DELETE FROM membership WHERE dim_a_id % 7 = 0 RETURNING dim_a_id, group_id) INSERT INTO membership SELECT dim_a_id, 1 + group_id % 12 FROM d ON CONFLICT DO NOTHING'),
	(6, 'buffered rows of a changed member, and of dim_b that did not change',
		'INSERT INTO facts SELECT 21000 + i, 1 + (i * 13) % 320, timestamptz ''2026-02-02'', 2, ''z'' FROM generate_series(1, 300) i; DELETE FROM membership WHERE dim_a_id IN (8, 9, 10, 14); INSERT INTO membership VALUES (8, 5), (9, 4), (14, 11) ON CONFLICT DO NOTHING'),
	(7, 'promoted (the buffers are in the segments; the pairs that changed still patch)',
		'SELECT sift.col_promote(''facts_col'')'),
	(8, 'buffered inserts after the promotion',
		'INSERT INTO facts SELECT 22000 + i, 1 + (i * 17) % 320, timestamptz ''2026-02-03'', 3, ''w'' FROM generate_series(1, 150) i'),
	(9, 'merged',
		'SELECT sift.col_merge(''facts_col'', true)');
CREATE FUNCTION apply(i int) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	s states;
BEGIN
	SELECT * INTO s FROM states WHERE n = i;
	EXECUTE s.stmt;
	RETURN s.label;
END $$;
