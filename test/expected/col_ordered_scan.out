-- An index-only scan of a sift_col index on the first column gives that column in order when the plan reads it alone (ORDER BY, either direction): the order array of the column
-- merged with the write buffer, the heap saying what a row holds when its page is not all-visible. The rows must be the heap's, in order, NULL rows last (first for DESC), after
-- deletes, updates, rows in the write buffer, a transaction's own changes, and for an index whose segments have no order array (the rows are sorted by the scan).
CREATE EXTENSION pg_sift;
SET sift.async_maintenance = off;
SET timezone = 'UTC';
CREATE TABLE os (id int, k int4, d date, pad text DEFAULT repeat('x', 200));
ALTER TABLE os ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO os (id, k, d) SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE (i * 7919) % 3001 - 1500 END, CASE WHEN i % 17 = 0 THEN NULL ELSE date '2020-01-01' + (i * 31) % 700 END
FROM generate_series(1, 9000) i;
CREATE INDEX os_i ON os USING sift_col (k, id) WITH (count_columns = 'off', write_buffer_limit = 256, order_columns = 'k', order_array_columns = 'k', order_layout = 'whole');
NOTICE:  sift_col index "os_i" does not track changes: the table has no primary key of one column
HINT:  Name a column that has a unique index of its own and that the index holds: WITH (track_changes = 'id'); WITH (track_changes = 'off') silences this.
NOTICE:  sift_col index "os_i": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  1.6 bytes a row for each column, 0.0 MB together; the segments are column format minor 38, which a library before 3.7 cannot read. ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit.
HINT:  Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "os_i": order_layout: k: exact keys, 1.6 bytes a row
DETAIL:  A compact chunk of an order array keeps the heap address of each row and its key rounded to a bucket of a few bits; the heap settles ties and gives the exact key of the rows a scan needs. The build keeps a chunk compact where that is at least a fifth smaller than keeping the exact keys and it has no run of 8 equal keys or more. The segments with a compact chunk are column format minor 41, which a library before 4.0 cannot read.
HINT:  To write exact keys only, run ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge; 'compact: column' and 'whole: column' choose it for a column.
CREATE TABLE ot (id int, k int8, pad text DEFAULT repeat('x', 200));
ALTER TABLE ot ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO ot (id, k) SELECT i, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 104729::int8) % 5003 - 2500 END FROM generate_series(1, 6000) i;
CREATE INDEX ot_i ON ot USING sift_col (k, id) WITH (count_columns = 'off', write_buffer_limit = 256, order_layout = 'whole');
NOTICE:  sift_col index "ot_i" does not track changes: the table has no primary key of one column
HINT:  Name a column that has a unique index of its own and that the index holds: WITH (track_changes = 'id'); WITH (track_changes = 'off') silences this.
CREATE TABLE oa (k int4, id int4, b int8);
INSERT INTO oa SELECT CASE WHEN i % 97 = 0 THEN NULL ELSE i % 700 END, i, i FROM generate_series(1, 3000) i;
CREATE INDEX oa_i ON oa USING sift_col (k sift.col_int4_ops, id sift.col_int4_ops, b sift.col_int8_ops);
NOTICE:  sift_col index "oa_i" does not track changes: the table has no primary key of one column
HINT:  Name a column that has a unique index of its own and that the index holds: WITH (track_changes = 'id'); WITH (track_changes = 'off') silences this.
CREATE TABLE oc (id int, k int4);
INSERT INTO oc SELECT i, CASE WHEN i % 29 = 0 THEN NULL ELSE ((i::int8 * 2654435761) % 1000000007)::int END FROM generate_series(1, 36000) i;
CREATE INDEX oc_i ON oc USING sift_col (k, id) WITH (count_columns = 'off', order_columns = 'k', order_array_columns = 'k', order_layout = 'compact');
NOTICE:  sift_col index "oc_i" does not track changes: the table has no primary key of one column
HINT:  Name a column that has a unique index of its own and that the index holds: WITH (track_changes = 'id'); WITH (track_changes = 'off') silences this.
NOTICE:  sift_col index "oc_i": order_array_columns adds the sorted keys and heap addresses to the sorted runs of 1 column
DETAIL:  2.8 bytes a row for each column, 0.1 MB together; the segments are column format minor 41, which a library before 4.0 cannot read. ORDER BY column LIMIT n reads n entries of the array and n rows of the heap, whatever the number of units, and a range of the column (up to 16,384 rows) hands the heap the addresses between its bounds without reading a unit.
HINT:  Drop the option, or set sift.col_format_minor to 14, to keep the sorted runs only.
NOTICE:  sift_col index "oc_i": order_layout: k: rounded keys in 49.3% of 71 chunks, exact in the rest, 2.8 bytes a row
DETAIL:  A compact chunk of an order array keeps the heap address of each row and its key rounded to a bucket of a few bits; the heap settles ties and gives the exact key of the rows a scan needs. The build keeps a chunk compact where that is at least a fifth smaller than keeping the exact keys and it has no run of 8 equal keys or more. The segments with a compact chunk are column format minor 41, which a library before 4.0 cannot read.
HINT:  To write exact keys only, run ALTER INDEX .. SET (order_layout = 'whole') and REINDEX, or a merge; 'compact: column' and 'whole: column' choose it for a column.
VACUUM (ANALYZE) oc;
VACUUM (ANALYZE) oa;
VACUUM (ANALYZE) os;
VACUUM (ANALYZE) ot;
-- sorts is 0 for the ordered scan (queries 1 to 4, 6 to 8, 10 to 17: 12 is an aggregate that orders by the first column of an index scan whose subquery names the others, and the scan must give those columns too; a window, a merge join of
-- two ordered scans and a sorted GROUP BY read it too, though SiftAgg may answer a statement that aggregates; the window result is the column k itself, as a window nothing reads is dropped from the subquery that os_run hashes)
-- and 1 for query 5 (NULLS FIRST ascending is not the order of the scan), 9 and 18 (they read another column)
-- materials is 0 throughout (enable_material is off, which leaves the Materialize that a scan with no mark and restore needs): the inner side of a merge join (query 16, with many equal keys) marks its position and goes back to it, and the scan keeps the rows of one group for that, where PostgreSQL would put a Materialize over it
-- the rows of q as the plan gives them, in the order it gives them (the ordered scan, or the heap and a Sort with sift off)
CREATE FUNCTION os_run(q text, ios bool, OUT n bigint, OUT md5 text, OUT scans int, OUT sorts int, OUT mats int) LANGUAGE plpgsql AS $$
DECLARE line text;
BEGIN
	PERFORM set_config('sift.enable_agg', 'off', true);
	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	PERFORM set_config('sift.enable_col_scan', ios::text, true);
	PERFORM set_config('enable_seqscan', (NOT ios)::text, true);
	PERFORM set_config('enable_sort', (NOT ios)::text, true);
	PERFORM set_config('enable_bitmapscan', 'false', true);
	PERFORM set_config('enable_hashjoin', 'false', true);
	PERFORM set_config('enable_nestloop', 'false', true);
	PERFORM set_config('enable_hashagg', 'false', true);
	PERFORM set_config('enable_material', 'false', true);
	scans := 0;
	sorts := 0;
	mats := 0;
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF line ~ 'Index Only Scan (Backward )?using o._i' THEN scans := scans + 1; END IF;
		IF line ~ '^ *(->  )?Sort$' THEN sorts := sorts + 1; END IF;
		IF line ~ '^ *(->  )?Materialize$' THEN mats := mats + 1; END IF;
	END LOOP;
	EXECUTE 'SELECT count(*), md5(string_agg(coalesce(k::text, ''null''), ''|'')) FROM (' || q || ') w' INTO n, md5;
END $$;
CREATE FUNCTION os_check(q text, OUT rows bigint, OUT agree bool, OUT ordered_scans int, OUT sorts int, OUT materials int) LANGUAGE plpgsql AS $$
DECLARE a record; h record;
BEGIN
	SELECT * INTO a FROM os_run(q, true);
	SELECT * INTO h FROM os_run(q, false);
	rows := h.n; agree := a.n = h.n AND a.md5 IS NOT DISTINCT FROM h.md5; ordered_scans := a.scans; sorts := a.sorts; materials := a.mats;
	IF NOT agree THEN
		RAISE EXCEPTION 'the ordered scan gives other rows than the heap: % (% against % rows)', q, a.n, h.n;
	END IF;
END $$;
CREATE TABLE os_q (n int, q text);
INSERT INTO os_q VALUES
 (1, 'SELECT k FROM os ORDER BY k'),
 (2, 'SELECT k FROM os ORDER BY k DESC'),
 (3, 'SELECT k FROM os WHERE k BETWEEN -300 AND 700 ORDER BY k'),
 (4, 'SELECT k FROM os WHERE k IS NOT NULL ORDER BY k DESC'),
 (5, 'SELECT k FROM os ORDER BY k NULLS FIRST'),
 (6, 'SELECT k FROM ot ORDER BY k'),
 (7, 'SELECT k FROM ot ORDER BY k DESC'),
 (8, 'SELECT k FROM ot WHERE k < 0 ORDER BY k DESC'),
 (9, 'SELECT k, d FROM os ORDER BY k'),
 (10, 'SELECT k FROM oc ORDER BY k'),
 (11, 'SELECT k FROM oc ORDER BY k DESC'),
 (12, 'SELECT array_agg(k ORDER BY k)::text AS k FROM (SELECT k, id, b FROM oa WHERE k IS NULL OR k <> ALL (ARRAY(SELECT g * 13 FROM generate_series(1, 500) g))) s'),
 (13, 'SELECT max(k) OVER (ORDER BY k) AS k FROM os'),
 (14, 'SELECT max(k) OVER (ORDER BY k DESC) AS k FROM ot'),
 (15, 'SELECT sum(k) OVER (PARTITION BY k) AS k FROM oc'),
 (16, 'SELECT a.k FROM os a JOIN os b ON a.k = b.k'),
 (17, 'SELECT k, count(*) FROM os GROUP BY k'),
 (18, 'SELECT max(k) OVER (ORDER BY k) + coalesce(d - d, 0) AS k FROM os');
SELECT n, q, (os_check(q)).* FROM os_q ORDER BY n;
 n  |                                                                              q                                                                               | rows  | agree | ordered_scans | sorts | materials 
----+--------------------------------------------------------------------------------------------------------------------------------------------------------------+-------+-------+---------------+-------+-----------
