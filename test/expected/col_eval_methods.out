-- sift.eval_methods names the methods under evaluation that are on: a comma separated list, a name with a minus sign turns a default one off, a name that is none of the five is an
-- error and leaves the setting as it was.
CREATE EXTENSION pg_sift;
SHOW sift.eval_methods;
 sift.eval_methods 
-------------------
 
(1 row)

SET sift.eval_methods = 'snapshot_masks, latest_hint';
SHOW sift.eval_methods;
      sift.eval_methods      
-----------------------------
 snapshot_masks, latest_hint
(1 row)

SET sift.eval_methods = '-skip_trigger_lookup,penalty_maintenance,-unit_rewrite';
SHOW sift.eval_methods;
                   sift.eval_methods                    
--------------------------------------------------------
 -skip_trigger_lookup,penalty_maintenance,-unit_rewrite
(1 row)

SET sift.eval_methods = 'skip_trigger_lookup,-skip_trigger_lookup';
SET sift.eval_methods = 'snapshot_mask';
ERROR:  invalid value for parameter "sift.eval_methods": "snapshot_mask"
DETAIL:  Unknown evaluation method: snapshot_mask
SHOW sift.eval_methods;
            sift.eval_methods             
------------------------------------------
 skip_trigger_lookup,-skip_trigger_lookup
(1 row)

SET sift.eval_methods = '-latest_hints';
ERROR:  invalid value for parameter "sift.eval_methods": "-latest_hints"
DETAIL:  Unknown evaluation method: latest_hints
SET sift.eval_methods = 'snapshot_masks,,';
ERROR:  invalid value for parameter "sift.eval_methods": "snapshot_masks,,"
SET sift.eval_methods = 'a b';
ERROR:  invalid value for parameter "sift.eval_methods": "a b"
RESET sift.eval_methods;
SHOW sift.eval_methods;
 sift.eval_methods 
-------------------
 
(1 row)

-- the records library hashes the settings that are not the default and this one always (the query of collect.settings_of): a method that is on is in the hash
SET sift.eval_methods = 'snapshot_masks';
SELECT name || '=' || current_setting(name) AS in_the_settings_hash FROM pg_settings WHERE (source NOT IN ('default', 'override') OR name = 'sift.eval_methods') AND name = 'sift.eval_methods';
       in_the_settings_hash       
----------------------------------
 sift.eval_methods=snapshot_masks
(1 row)

RESET sift.eval_methods;
-- An unavailable rewrite must fail atomically, rather than silently measure the baseline.
SET sift.eval_methods = 'latest_hint';
SET sift.eval_methods = 'unit_rewrite';
ERROR:  invalid value for parameter "sift.eval_methods": "unit_rewrite"
DETAIL:  Evaluation method unit_rewrite is disabled: independent unit-generation retirement is not verified for snapshots and hot standby.
HINT:  Leave unit_rewrite disabled; use VACUUM and the existing segment maintenance paths.
SHOW sift.eval_methods;
 sift.eval_methods 
-------------------
 latest_hint
(1 row)

SET sift.eval_methods = 'snapshot_masks,unit_rewrite';
ERROR:  invalid value for parameter "sift.eval_methods": "snapshot_masks,unit_rewrite"
DETAIL:  Evaluation method unit_rewrite is disabled: independent unit-generation retirement is not verified for snapshots and hot standby.
HINT:  Leave unit_rewrite disabled; use VACUUM and the existing segment maintenance paths.
SHOW sift.eval_methods;
 sift.eval_methods 
-------------------
 latest_hint
(1 row)

SET sift.eval_methods = '-unit_rewrite';
SET sift.eval_methods = 'unit_rewrite,-unit_rewrite';
RESET sift.eval_methods;
DROP EXTENSION pg_sift;
