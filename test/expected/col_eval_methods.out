-- sift.eval_methods names the methods under evaluation that are on: a comma separated list, a name that is none of the two is an
-- error and leaves the setting as it was. skip_trigger_lookup, the method that was on by default, is always on, snapshot_masks, which had no code, and latest_hint, which won nothing, were removed: none of the three is a name.
CREATE EXTENSION pg_sift;
SHOW sift.eval_methods;
 sift.eval_methods 
-------------------
 
(1 row)

SET sift.eval_methods = 'penalty_maintenance, unit_rewrite';
SHOW sift.eval_methods;
         sift.eval_methods         
-----------------------------------
 penalty_maintenance, unit_rewrite
(1 row)

SET sift.eval_methods = 'penalty_maintenance,unit_rewrite';
SHOW sift.eval_methods;
        sift.eval_methods         
----------------------------------
 penalty_maintenance,unit_rewrite
(1 row)

SET sift.eval_methods = 'skip_trigger_lookup';
ERROR:  invalid value for parameter "sift.eval_methods": "skip_trigger_lookup"
DETAIL:  Unknown evaluation method: skip_trigger_lookup
SET sift.eval_methods = 'snapshot_masks';
ERROR:  invalid value for parameter "sift.eval_methods": "snapshot_masks"
DETAIL:  Unknown evaluation method: snapshot_masks
SET sift.eval_methods = '-unit_rewrite';
ERROR:  invalid value for parameter "sift.eval_methods": "-unit_rewrite"
DETAIL:  Unknown evaluation method: -unit_rewrite
SET sift.eval_methods = 'snapshot_mask';
ERROR:  invalid value for parameter "sift.eval_methods": "snapshot_mask"
DETAIL:  Unknown evaluation method: snapshot_mask
SHOW sift.eval_methods;
        sift.eval_methods         
----------------------------------
 penalty_maintenance,unit_rewrite
(1 row)

SET sift.eval_methods = 'penalty_maintenance,,';
ERROR:  invalid value for parameter "sift.eval_methods": "penalty_maintenance,,"
SET sift.eval_methods = 'a b';
ERROR:  invalid value for parameter "sift.eval_methods": "a b"
RESET sift.eval_methods;
SHOW sift.eval_methods;
 sift.eval_methods 
-------------------
 
(1 row)

-- the records library hashes the settings that are not the default and this one always (the query of collect.settings_of): a method that is on is in the hash
SET sift.eval_methods = 'penalty_maintenance';
SELECT name || '=' || current_setting(name) AS in_the_settings_hash FROM pg_settings WHERE (source NOT IN ('default', 'override') OR name = 'sift.eval_methods') AND name = 'sift.eval_methods';
         in_the_settings_hash          
---------------------------------------
 sift.eval_methods=penalty_maintenance
(1 row)

RESET sift.eval_methods;
-- Every method is available explicitly; the name of a removed one is an error.
SET sift.eval_methods = 'latest_hint';
ERROR:  invalid value for parameter "sift.eval_methods": "latest_hint"
DETAIL:  Unknown evaluation method: latest_hint
SET sift.eval_methods = 'unit_rewrite';
SHOW sift.eval_methods;
 sift.eval_methods 
-------------------
 unit_rewrite
(1 row)

SET sift.eval_methods = 'penalty_maintenance,unit_rewrite';
SHOW sift.eval_methods;
        sift.eval_methods         
----------------------------------
 penalty_maintenance,unit_rewrite
(1 row)

RESET sift.eval_methods;
DROP EXTENSION pg_sift;
