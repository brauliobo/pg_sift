DROP FUNCTION check_state(text), scope_topn(text), runs_of(text), rows_md5(text), ql(text, text), q(text, text), scope_of(text, text);
DROP TABLE keys, events, pairs_t, pairs_v, pairs_u;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
