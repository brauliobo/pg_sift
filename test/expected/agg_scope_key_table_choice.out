-- A scope read and the join as written are priced for the keys a table of keys gives. The join to a table of keys is a plan that runs whole, whatever the keys: its scan reads every pair
-- of the scope relation (a row each) and hands the pairs of the keys up to the join (a row each, dearer than the lookup of a table), where the keys as constants are a lookup of their own pairs. The
-- price took it for the lookup and under-priced the join of the largest keys by 3 and 4 million instructions: the scope units, cheaper, lost the choice to the join (10 and 30 keys of the 50 that
-- hold most of the table). The units are read where they are cheaper and the join where it is, with the keys from a table as with the keys as constants.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET default_statistics_target = 1000;
SET sift.test_scope_patch = off;
-- 5,000 ids of 60 events each in 50 tenants of 8 to 316 ids (the pairs 4,999), user 1 holds the 10 largest, user 2 three small, user 3 one of the middle and user 4 the 30 largest
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT i, 1 + floor(50 * power(i / 5000.0, 2))::int FROM generate_series(1, 4999) i;
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int NOT NULL, created_at date NOT NULL, kind int NOT NULL, amount int NOT NULL) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + ((i::bigint * 7919) % 5000), date '2025-01-01' + i % 365, i % 8, i % 100 FROM generate_series(1, 300000) i;
CREATE TABLE user_keys (user_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (user_id, tenant_id));
INSERT INTO user_keys SELECT 1, t FROM generate_series(1, 10) t;
INSERT INTO user_keys VALUES (2, 48), (2, 49), (2, 50), (3, 25);
INSERT INTO user_keys SELECT 4, t FROM generate_series(1, 30) t;
CREATE INDEX tenant_pairs_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, kind, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events, tenant_scope, user_keys;
CREATE FUNCTION key_table_sql(keys text) RETURNS text LANGUAGE sql AS
$$ SELECT 'SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN ' || keys || ') GROUP BY kind' $$;
-- the arm the node runs: the scope units, or the join with its reason
CREATE FUNCTION key_table_arm(keys text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'scope units';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || key_table_sql(keys) LOOP
		IF l ~ 'Scope Fallback' THEN r := trim(regexp_replace(l, 'Scope Fallback: ', 'join, ')); END IF;
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION key_table_rows(keys text, enable_agg text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('sift.enable_agg', enable_agg, false);
	EXECUTE 'SELECT md5(string_agg(t::text, ''|'' ORDER BY t::text)) FROM (' || key_table_sql(keys) || ') t' INTO r;
	PERFORM set_config('sift.enable_agg', 'on', false);
	RETURN r;
END $$;
SELECT label, key_table_arm(keys) AS arm, key_table_rows(keys, 'on') = key_table_rows(keys, 'off') AS same_rows
FROM (VALUES ('the 10 largest keys, from a table', '(SELECT tenant_id FROM user_keys WHERE user_id = 1)'),
             ('the 30 largest keys, from a table', '(SELECT tenant_id FROM user_keys WHERE user_id = 4)'),
             ('a key of the middle, from a table', '(SELECT tenant_id FROM user_keys WHERE user_id = 3)'),
             ('3 small keys, from a table', '(SELECT tenant_id FROM user_keys WHERE user_id = 2)'),
             ('the 30 largest keys, as constants', '(' || (SELECT string_agg(i::text, ', ') FROM generate_series(1, 30) i) || ')')) AS v(label, keys)
ORDER BY label;
               label               |                arm                | same_rows 
-----------------------------------+-----------------------------------+-----------
 3 small keys, from a table        | scope units                       | t
 a key of the middle, from a table | scope units                       | t
 the 10 largest keys, from a table | scope units                       | t
 the 30 largest keys, as constants | join, join is cheaper for 30 keys | t
 the 30 largest keys, from a table | scope units                       | t
(5 rows)

