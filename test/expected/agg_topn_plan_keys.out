(1 row)

VACUUM (FREEZE, ANALYZE) events;
UPDATE reads r SET large = blocks(f.q) FROM forms f WHERE f.name = r.name;
SELECT name, large <= small * 1.3 AS flat FROM reads ORDER BY name;
