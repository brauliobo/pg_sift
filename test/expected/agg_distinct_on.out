-- DISTINCT ON in the aggregate scan (docs/AGG.md, "DISTINCT ON"): a group by the ON columns that keeps, for each group, the columns of the first row by the ORDER BY.
-- Rows of a group that tie in the ORDER BY have no order: SQL leaves the row DISTINCT ON keeps unspecified, so the scan keeps one of them (same_tied below compares the ON and sort
-- columns with the normal plan and checks that the row is a row of the table). Every other statement is run with the pushdown and with sift.enable_agg = off: the rows must be the same, after every kind of write.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
-- the table is small: page costs that keep the sort and the btree plans from looking cheap as well
SET seq_page_cost = 10000; SET random_page_cost = 10000;
CREATE TABLE ev (id int PRIMARY KEY, tenant_id int, kind text, day date, ts timestamp, amount numeric(10, 2), note varchar(5)) WITH (autovacuum_enabled = false);
INSERT INTO ev
SELECT i, 1 + (i * 7919) % 60, (ARRAY['a', 'b', 'c', NULL])[1 + i % 4], date '2024-01-01' + i % 90, timestamp '2024-01-01' + ((i * 37) % 100000) * interval '1 second',
       CASE WHEN i % 11 = 0 THEN NULL ELSE (i % 1000) / 10.0 END, left(md5(i::text), 5)
FROM generate_series(1, 6000) i;
CREATE INDEX ev_col ON ev USING sift_col (id, tenant_id, kind, day, ts, amount, note);
NOTICE:  sift_col index "ev_col": rollup_dims = 'auto' writes a rollup of the rows by tenant_id, kind
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 60 of them a unit; the cells add to the index and to its build.
HINT:  To drop it, run ALTER INDEX ev_col SET (rollup_dims = 'off') and REINDEX; rollup_dims = 'a, b: measure' names the columns.
VACUUM (FREEZE, ANALYZE) ev;
CREATE TABLE tenants (id int PRIMARY KEY, kind text);
INSERT INTO tenants SELECT i, (ARRAY['outlet', 'popup', 'flagship'])[1 + i % 3] FROM generate_series(1, 60) i;
ANALYZE tenants;
CREATE FUNCTION plan_of(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'normal';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l LIKE '%Custom Scan (SiftAgg)%' THEN r := 'SiftAgg'; END IF;
		IF l LIKE '%Workers Planned: _%' AND l NOT LIKE '%Workers Planned: 0%' THEN r := r || ' with workers'; END IF;
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION same(q text) RETURNS TABLE (plan text, result_rows bigint, vs_normal_plan bigint) LANGUAGE plpgsql AS $$
BEGIN
	plan := plan_of(q);
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS %s', q);
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS %s', q);
	RESET sift.enable_agg;
	result_rows := (SELECT count(*) FROM r_on);
	vs_normal_plan := (SELECT count(*) FROM ((TABLE r_on EXCEPT TABLE r_off) UNION ALL (TABLE r_off EXCEPT TABLE r_on)) d);
	DROP TABLE r_on, r_off;
	RETURN NEXT;
END $$;
-- a statement whose ORDER BY leaves ties (its select list holds the id): the pairs (ON and sort columns) are those of the normal plan, whatever row of a tie each plan keeps, and the row is a row of the table
CREATE FUNCTION same_tied(q text, pairs text, tbl regclass) RETURNS TABLE (plan text, result_rows bigint, pairs_vs_normal_plan bigint, rows_not_in_table bigint) LANGUAGE plpgsql AS $$
BEGIN
	plan := plan_of(q);
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS %s', q);
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS %s', q);
	RESET sift.enable_agg;
	EXECUTE 'SELECT count(*) FROM r_on' INTO result_rows;
	EXECUTE format('SELECT count(*) FROM ((SELECT %1$s FROM r_on EXCEPT SELECT %1$s FROM r_off) UNION ALL (SELECT %1$s FROM r_off EXCEPT SELECT %1$s FROM r_on)) d', pairs) INTO pairs_vs_normal_plan;
	EXECUTE format('SELECT count(*) FROM r_on o WHERE NOT EXISTS (SELECT 1 FROM %s e WHERE e.id = o.id AND to_jsonb(e) @> to_jsonb(o))', tbl) INTO rows_not_in_table;
	DROP TABLE r_on, r_off;
	RETURN NEXT;
END $$;
-- the plan: the aggregates are the first row's columns by the ORDER BY
EXPLAIN (COSTS OFF) SELECT DISTINCT ON (tenant_id) tenant_id, id, ts, amount FROM ev ORDER BY tenant_id, ts DESC, id;
                                                                              QUERY PLAN                                                                              
----------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: tenant_id, ts DESC, id
   ->  Custom Scan (SiftAgg)
         Index: ev_col
         Group Keys: tenant_id
         Pushed Aggregates: first_row(ev.id ORDER BY ev.ts DESC, ev.id), first_row(ev.ts ORDER BY ev.ts DESC, ev.id), first_row(ev.amount ORDER BY ev.ts DESC, ev.id)
(6 rows)

