 null   | inner     |       0 | t            | t
 null   | inner     |       1 | t            | t
 null   | inner_all |       0 | t            | t
 null   | inner_all |       1 | t            | t
 null   | left      |       0 | t            | t
 null   | left      |       1 | t            | t
 null   | semi      |       0 | t            | t
 null   | semi      |       1 | t            | t
