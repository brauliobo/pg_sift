SELECT mig_same('SELECT d.country, d.tier, count(*) AS n FROM ev JOIN dims d ON d.id = ev.dim_a_id WHERE d.country IN (3, 17, 41) AND d.tier = 2 GROUP BY 1, 2') AS same;
