SELECT mig_same('SELECT d.country, count(*) AS n FROM ev JOIN dims d ON d.id = ev.dim_a_id WHERE d.country IN (3, 17, 41) AND ev.day >= ''2025-01-01'' GROUP BY d.country') AS same;
