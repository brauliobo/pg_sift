(1 row)

SELECT mig_same('SELECT d.tier, count(*) AS n FROM ev JOIN dims d ON d.id = ev.dim_a_id WHERE d.tier IN (1, 2) AND d.country IN (3, 17) GROUP BY 1') AS same;
 same 
