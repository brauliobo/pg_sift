-- the sort of every row that passes spills (work_mem), and a deep page
SET work_mem = '64kB';
SELECT tb_check($q$SELECT id, s, v FROM tb ORDER BY coalesce(s, v, 'zzz'), id LIMIT 20 OFFSET 20000$q$) AS spilled_texts,
	   tb_check($q$SELECT id, a, c FROM tb ORDER BY CASE WHEN c > 0 THEN 1 ELSE 0 END, coalesce(a, c) DESC, id LIMIT 30 OFFSET 15000$q$) AS spilled_two_keys;
    spilled_texts    | spilled_two_keys 
---------------------+------------------
 same+topn+sorted 20 | same+topn 30
(1 row)

RESET work_mem;
-- rows of the write buffer and dirty units: new rows, updated and deleted ones are not in the stored units yet
INSERT INTO tb SELECT 30000 + i, i % 7, CASE WHEN i % 3 = 0 THEN NULL ELSE i - 200 END, NULL, NULL, NULL, 12.5 * i, NULL, DATE '2019-12-31' - i % 5, NULL,
	CASE WHEN i % 5 = 0 THEN NULL ELSE '!Ǆ' || i || 'zz' END, 'w' || i
FROM generate_series(1, 700) i;
UPDATE tb SET a = NULL, s = 'Aaa' || id WHERE id % 97 = 0;
UPDATE tb SET a = -5, d = NULL, c = NULL WHERE id % 89 = 0;
DELETE FROM tb WHERE id % 83 = 0;
