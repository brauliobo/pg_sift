-- workers: each keeps a heap of the keys it saw, the leader merges them
SELECT tag, tb_check(q, 2) FROM tb_q WHERE tag IN ('case_null_zero', 'case_simple', 'case_text', 'coalesce_ints', 'coalesce_texts', 'nullif_int', 'greatest', 'bool_or_null', 'in_list_text', 'six_keys') ORDER BY tag COLLATE "C";
