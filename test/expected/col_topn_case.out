-- an expression that raises raises the same SQLSTATE in both plans, and the branch of a CASE or the later argument of a coalesce that is not taken is not evaluated
CREATE FUNCTION tb_error(q text, pushed bool) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	PERFORM tb_mode(pushed, 0);
	EXECUTE q;
	RETURN 'no error';
EXCEPTION WHEN OTHERS THEN
	RETURN SQLSTATE;
END $$;
CREATE FUNCTION tb_scan(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE line text; plan text := '';
BEGIN
	PERFORM tb_mode(true, 0);
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || line; END LOOP;
	RETURN CASE WHEN plan ~ 'Top-N: ' THEN 'topn' ELSE 'plain' END;
END $$;
SELECT tag, tb_error(q, true) = tb_error(q, false) AS same_error, tb_error(q, true) AS sqlstate, tb_scan(q) AS pushed
FROM (VALUES ('case_div_taken',   $q$SELECT id FROM tb ORDER BY CASE WHEN c IS NOT NULL THEN 1000 / (c - 37) ELSE 0 END, id LIMIT 5$q$),
			 ('case_div_skipped', $q$SELECT id FROM tb ORDER BY CASE WHEN c IS NOT NULL AND c <> 37 THEN 1000 / (c - 37) ELSE 0 END, id LIMIT 5$q$),
			 ('case_overflow',    $q$SELECT id FROM tb ORDER BY CASE WHEN a IS NOT NULL THEN a + 1 ELSE 0 END, id LIMIT 5$q$),
			 ('case_overflow_ok', $q$SELECT id FROM tb ORDER BY CASE WHEN a < 2147483647 THEN a + 1 ELSE 0 END, id LIMIT 5$q$),
			 ('coalesce_div',     $q$SELECT id FROM tb ORDER BY coalesce(a, 1 / (g - g)), id LIMIT 5$q$),
			 ('coalesce_div_ok',  $q$SELECT id FROM tb WHERE a IS NOT NULL ORDER BY coalesce(a, 1 / (g - g)), id LIMIT 5$q$),
			 ('nullif_div',       $q$SELECT id FROM tb ORDER BY 100 / nullif(g, 0), id LIMIT 5$q$),
			 ('nullif_div_taken', $q$SELECT id FROM tb ORDER BY 100 / nullif(g, 3), id LIMIT 5$q$),
			 ('greatest_overflow',$q$SELECT id FROM tb ORDER BY greatest(a, c) + 1, id LIMIT 5$q$),
			 ('in_cast',          $q$SELECT id FROM tb ORDER BY b::int IN (1, 2, 3), id LIMIT 5$q$)) v(tag, q)
ORDER BY tag COLLATE "C";
        tag        | same_error | sqlstate | pushed 
-------------------+------------+----------+--------
 case_div_skipped  | t          | no error | topn
 case_div_taken    | t          | 22012    | topn
 case_overflow     | t          | 22003    | topn
 case_overflow_ok  | t          | no error | topn
 coalesce_div      | t          | 22012    | topn
 coalesce_div_ok   | t          | no error | topn
 greatest_overflow | t          | 22003    | topn
 in_cast           | t          | 22003    | topn
 nullif_div        | t          | no error | topn
 nullif_div_taken  | t          | 22012    | topn
(10 rows)

-- what stays with the normal plan, each by a named refusal
SET sift.enable_agg = on;
SET enable_seqscan = off; SET enable_indexscan = off; SET enable_bitmapscan = off;
SELECT k, w.used, w.slug, w.reason
FROM (VALUES ('sub-select',  $q$SELECT id FROM tb ORDER BY CASE WHEN g > (SELECT 1) THEN 1 ELSE 0 END, id LIMIT 5$q$),
			 ('stable',      $q$SELECT id FROM tb ORDER BY CASE WHEN d > current_date THEN 1 ELSE 0 END, id LIMIT 5$q$),
			 ('volatile',    $q$SELECT id FROM tb ORDER BY CASE WHEN random() > 2 THEN 1 ELSE g END, id LIMIT 5$q$),
			 ('allowed',     $q$SELECT id FROM tb ORDER BY CASE WHEN a IS NULL THEN 0 ELSE a END, id LIMIT 5$q$)) q(k, q),
	 LATERAL sift.explain_why(q.q) w
ORDER BY k COLLATE "C";
     k      | used |    slug    |                                                                                  reason                                                                                  
------------+------+------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 allowed    | t    |            | 
 stable     | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression calls a function that is not immutable)
 sub-select | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression reads a parameter of a sub-select)
 volatile   | f    | volatile   | the query calls a volatile function, which PostgreSQL evaluates for every row and the scan cannot reproduce (the sort expression calls a function that is not immutable)
(4 rows)

RESET enable_seqscan; RESET enable_indexscan; RESET enable_bitmapscan;
DROP TABLE tb, tb_q;
DROP FUNCTION tb_check(text,integer), tb_error(text,boolean), tb_mode(boolean,integer), tb_scan(text);
DROP EXTENSION pg_sift_test, pg_sift;
