-----------+------+-----
 t         | t    | t
(1 row)

SELECT decoded AS before, sift._test_col_mem_encodes() AS encodes_before FROM sift._test_col_wbuf_reads('wp_col') \gset
VACUUM wp;
SELECT * FROM wp_same() AS after_vacuum;
