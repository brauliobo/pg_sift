-----------+------+-----
 t         | t    | t
(1 row)

SELECT decoded = :before AS none_decoded_again, sift._test_col_mem_encodes() = :encodes_before AS none_encoded_again, nrows >= 1600 AS buffered FROM sift._test_col_wbuf_reads('wp_col');
