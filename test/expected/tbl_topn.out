         | two_keys=same+topn 25
(1 row)

RESET max_parallel_workers_per_gather;
RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET min_parallel_table_scan_size;
-- columns added later: the older segments have none of the sort column (null, or the constant of the default), the newer ones have it
ALTER TABLE ct ADD COLUMN z int;
ALTER TABLE ct ADD COLUMN w int DEFAULT 5;
INSERT INTO ct (store, status, ts, seq, z, w, memo)
SELECT 1 + i % 40, (ARRAY['paid','shipped'])[1 + i % 2], timestamp '2026-01-01' + i * interval '1 minute', 300000 + i, (hashint4(i) & 2147483647) % 500, i % 4, ct_words(i + 200000)
FROM generate_series(1, 3000) i;
INSERT INTO ct_q VALUES
	('added_z',    $q$SELECT id, z FROM ct ORDER BY z DESC NULLS LAST, id LIMIT 10$q$),
	('added_z_nf', $q$SELECT id, z FROM ct ORDER BY z NULLS FIRST, id LIMIT 10$q$),
	('added_w',    $q$SELECT id, w FROM ct WHERE status = 'paid' ORDER BY w DESC, id LIMIT 10$q$),
	('added_w_s',  $q$SELECT id, w, ts FROM ct WHERE memo @@> 'gift' ORDER BY w, ts DESC, id LIMIT 10$q$);
SELECT * FROM ct_stage('added columns');
