        | two_keys=same+topn 25
(1 row)

-- workers do not change the plan of a top-N
SET max_parallel_workers_per_gather = 2;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SELECT * FROM ct_stage('workers');
  stage  |         results         
---------+-------------------------
 workers | boolean=same+topn 10   +
         | col_or=same+topn 10    +
         | date_asc=same+topn 15  +
         | date_desc=same+topn 15 +
         | date_nf=same+topn 15   +
         | date_nl=same+topn 15   +
         | expr_out=same+topn 8   +
         | few=same+topn 37       +
         | filters=same+topn 12   +
         | float_all=same+topn 40 +
         | float_asc=same+topn 9  +
         | float_desc=same+topn 9 +
         | fuzzy=same+topn 10     +
         | id_desc=same+topn 6    +
         | in_or=same+topn 10     +
         | junk_key=same+topn 8   +
         | newest=same+topn 10    +
         | no_filter=same+topn 10 +
         | no_search=same+topn 10 +
         | none=same 0            +
         | num_asc=same+topn 20   +
         | num_desc=same+topn 20  +
         | num_nan=same+topn 30   +
         | offset=same+topn 5     +
         | oldest=same+topn 7     +
         | phrase=same+topn 10    +
         | prefix=same+topn 10    +
         | seq_asc=same+topn 10   +
         | seq_desc=same+topn 10  +
