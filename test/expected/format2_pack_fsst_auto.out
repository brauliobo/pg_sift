--------------+----------------
           12 |             12
(1 row)

SELECT count(*) AS parts, count(DISTINCT header_blk) AS pages, bool_and(packed) AS packed, count(DISTINCT (header_blk, slot)) AS slots FROM pk_info('pk_a_idx');
 parts | pages | packed | slots 
-------+-------+--------+-------
    12 |     2 | t      |    12
(1 row)

