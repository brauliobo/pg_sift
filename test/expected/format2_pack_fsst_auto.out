CREATE TABLE lg (id bigint, doc text);
INSERT INTO lg SELECT i, (SELECT string_agg(substr(md5('w' || ((i * 31 + j * 17 + (i * j) % 13 + (i * j * j) % 7) % 3000)), 1, 8), ' ') FROM generate_series(1, 30) j) FROM generate_series(1, 24000) i;
