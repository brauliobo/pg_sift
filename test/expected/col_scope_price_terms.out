-- The price of a scope read (col/scope.h) is one pure function of the counts of the read: the units it opens (read row by row or answered from their pre-aggregates), the entries it reads, the pairs it lists
-- when it counts a row once for several keys, the changed pairs it leaves out of its units, the patch and the delta of them. The executor takes the join as written where it costs less, and tells the reader how many
-- changed pairs that join leaves it, so that a read that has more refuses before it lists them. The terms are those of the cells of three shapes (instructions of the backend, warm, one backend, the scope read forced:
-- 30 keys of 111 rows, 500 of 3 rows, 110 of 55 rows with a tenth of them in two keys), and the arm the price takes is the one that was cheaper when measured.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
SET sift.agg_force = on;
SET sift.test_scope_patch = off;
-- each term alone, from the counts that are not named being 0 (pure: the same counts give the same price)
CREATE FUNCTION price(nkeys int, once bool, units int8 DEFAULT 0, entries int8 DEFAULT 0, preagg float8 DEFAULT 0, drops int DEFAULT 0, key_pairs int8 DEFAULT 0, changed int8 DEFAULT 0,
	patch_units int8 DEFAULT 0, patch_scan_rows int8 DEFAULT 0, delta_rows int8 DEFAULT 0, pairs int8 DEFAULT 0, entry_instr float8 DEFAULT 0) RETURNS float8 LANGUAGE sql AS
$$ SELECT units_price FROM sift._test_scope_price(nkeys, once, units, entries, preagg, entry_instr, drops, key_pairs, changed, patch_units, patch_scan_rows, delta_rows, pairs) $$;
CREATE FUNCTION term(label text, got float8, per float8, n float8) RETURNS TABLE (term text, instructions float8, per_count float8) LANGUAGE sql AS $$ SELECT label, got, round((got / n)::numeric, 1)::float8 $$;
CREATE TABLE base AS SELECT price(2, true) AS setup;
SELECT t.* FROM base, LATERAL (VALUES
	('the read before any unit', setup, 1),
	('a unit read row by row', price(2, true, units => 10) - setup, 10),
	('a unit its pre-aggregates answer', price(1, true, units => 10, preagg => 1) - setup, 10),
	('an entry, with the aggregation of the model', price(2, true, entries => 1000, entry_instr => 45) - setup, 1000),
	('an entry more for each key with a drop list', price(2, true, entries => 1000, drops => 2) - price(2, true, entries => 1000), 2000),
	('a pair of the relation listed for several keys', price(2, true, pairs => 1000) - setup, 1000),
	('a pair of the keys listed and deduped', price(2, true, key_pairs => 1000) - setup, 1000),
	('the same pairs for one key: not listed', price(1, true, pairs => 1000, key_pairs => 1000) - setup, 1000),
	('a changed pair', price(2, true, changed => 1000) - setup, 1000),
	('an entry left out of the units of a changed read', price(2, true, entries => 1000, changed => 1) - price(2, true, entries => 1000) - price(2, true, changed => 1) + setup, 1000),
	('a unit the changed pairs rows fall in', price(1, false, patch_units => 10, delta_rows => 100000) - price(1, false, delta_rows => 100000), 10),
	('a fact row looked at to find them', price(1, false, patch_scan_rows => 1000) - setup, 1000),
	('a copy of the delta', price(1, false, delta_rows => 1000) - setup, 1000)
) AS v(label, got, n), LATERAL term(v.label, v.got, 0, v.n::float8) t;
                       term                       | instructions | per_count 
--------------------------------------------------+--------------+-----------
 the read before any unit                         |       450000 |    450000
 a unit read row by row                           |       367000 |     36700
 a unit its pre-aggregates answer                 |       133000 |     13300
 an entry, with the aggregation of the model      |        63000 |        63
 an entry more for each key with a drop list      |        30000 |        15
 a pair of the relation listed for several keys   |        39000 |        39
 a pair of the keys listed and deduped            |       286000 |       286
 the same pairs for one key: not listed           |            0 |         0
 a changed pair                                   |      3450000 |      3450
 an entry left out of the units of a changed read |        20000 |        20
 a unit the changed pairs rows fall in            |       430000 |     43000
 a fact row looked at to find them                |        13000 |        13
 a copy of the delta                              |      1600000 |      1600
(13 rows)

-- the entity path: the pairs it reads, the units and the rows of the fact segments that may hold a dim_a_id of the keys, the entries it keeps
SELECT round((e.entity_price - b.entity_price)::numeric / 1000) AS thousand_instr_for_60_units
FROM sift._test_scope_price(1, true, 0, 0, path_units => 60) e, sift._test_scope_price(1, true, 0, 0) b;
 thousand_instr_for_60_units 
-----------------------------
                        2202
(1 row)

-- the cells: the price of the scope read for the counts the executor has, against the read measured, and the arm the price takes against the one that was cheaper
CREATE TABLE cells (n int GENERATED ALWAYS AS IDENTITY, shape text, keys int, once bool, units int8, entries int8, preagg float8, drops int, key_pairs int8, changed int8, patch_units int8, patch_scan_rows int8, delta_rows int8, pairs int8,
	entry_instr float8, measured float8, join_as_written float8);
INSERT INTO cells (shape, keys, once, units, entries, preagg, drops, key_pairs, changed, patch_units, patch_scan_rows, delta_rows, pairs, entry_instr, measured, join_as_written) VALUES
