-- a read of keys whose pairs changed past what the join leaves it is refused before it lists them: 1,200 dim_a_ids of 40 keys, 100 facts each
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT i, 1 + i % 40 FROM generate_series(1, 1200) i;
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at date, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + i % 1200, date '2025-01-01' + i % 300, 'k' || i % 4, i % 100 FROM generate_series(1, 120000) i;
CREATE INDEX tenant_pairs_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, kind, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events, tenant_scope;
CREATE FUNCTION rows_md5(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	DROP TABLE IF EXISTS choice_rows;
	EXECUTE 'CREATE TEMP TABLE choice_rows AS ' || q;
	SELECT md5(coalesce(string_agg(t::text, '|' ORDER BY t::text), '')) INTO r FROM choice_rows t;
	DROP TABLE choice_rows;
	RETURN r;
END $$;
-- the run of a prepared statement over the keys given: the scope read, or the join with its reason, and whether its rows are those of the join (sift.agg_scope off)
CREATE FUNCTION outcome(keys int[], OUT chosen text, OUT same_rows boolean) LANGUAGE plpgsql AS $$
DECLARE
	l text;
	a text;
	b text;
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', false);
	DEALLOCATE ALL;
	PREPARE q(int[]) AS SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = ANY ($1)) GROUP BY kind;
	chosen := 'scope read';
	FOR l IN EXECUTE format('EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) EXECUTE q(%L)', keys) LOOP
		IF l ~ 'Scope Fallback' THEN chosen := regexp_replace(l, '^ *Scope Fallback: ', ''); END IF;
	END LOOP;
	a := rows_md5(format('EXECUTE q(%L)', keys));
	PERFORM set_config('sift.agg_scope', 'off', false);
	b := rows_md5(format('EXECUTE q(%L)', keys));
	PERFORM set_config('sift.agg_scope', 'on', false);
	DEALLOCATE ALL;
	RESET plan_cache_mode;
	same_rows := a = b;
END $$;
-- the stamps of the scope segments, before any pair changes
SELECT lineage AS l0, horizon AS hor FROM sift._test_scope_stamps('events_col', 0) WHERE journal = 0 \gset
SELECT 'clean' AS state, * FROM outcome('{1,2,3}');
 state |   chosen   | same_rows 
-------+------------+-----------
 clean | scope read | t
(1 row)

-- 5 dim_a_ids in other keys have their pairs ended and restored: the read leaves their entries out and goes on
CREATE FUNCTION churn(n int) RETURNS void LANGUAGE sql AS $$
	WITH d AS (DELETE FROM tenant_scope WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id > 3 ORDER BY dim_a_id LIMIT n) RETURNING dim_a_id, tenant_id)
	INSERT INTO tenant_scope SELECT * FROM d $$;
SELECT churn(5);
 churn 
-------
 
(1 row)

SELECT '5 pairs changed' AS state, * FROM outcome('{1,2,3}');
      state      |   chosen   | same_rows 
-----------------+------------+-----------
 5 pairs changed | scope read | t
(1 row)

-- 700 are more than the join leaves the read of 3 keys and fewer than the cap of the rows of the table (763): the pairs of the relation are read whole for them (cheaper than asking for each), and the join answers on the price
SELECT churn(700);
 churn 
-------
 
(1 row)

SELECT '700 pairs changed' AS state, * FROM outcome('{1,2,3}');
       state       |   chosen   | same_rows 
-------------------+------------+-----------
 700 pairs changed | scope read | t
(1 row)

-- the cap counts the distinct dim_a_ids, not the records of the journal: 700 changed by 1,410 records are 700
SELECT cap, why, count(key) AS changed FROM unnest(ARRAY[700, 699]) cap, LATERAL sift._test_scope_journal_changes('events_col', 0, :l0, :'hor', cap) GROUP BY cap, why ORDER BY cap DESC;
 cap |          why          | changed 
-----+-----------------------+---------
 700 | ok                    |     700
 699 | too many changed keys |       0
(2 rows)

DROP TABLE events, tenant_scope, base, cells CASCADE;
DROP FUNCTION price, term, rows_md5, outcome, churn;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
