-- The point directory of heap addresses by the default formula: an equality on an integer column of nearly unique values that does not follow the order of the table reads every unit
-- (the keys of a unit span the whole range), so a CREATE INDEX whose benefit B (the speedup of the equality) is at least its cost C (the growth of the index and of the build)
-- writes the column to point_tid_columns as 'auto: col' and says so. Not a column in heap order, not one of few values, not a table where the lookup is cheap, not an option the user set.
CREATE EXTENSION pg_sift;
SET sift.async_maintenance = off;
SET max_parallel_maintenance_workers = 0;
CREATE TABLE pa (id int, rid int8, a int, b int, c int, d int, e int, f int, tenant_id int) WITH (fillfactor = 10, autovacuum_enabled = false);
INSERT INTO pa SELECT g, hashint8extended(g, 9) & 4611686018427387903, (hashint8extended(g, 1) & 1023)::int, (hashint8extended(g, 2) & 1023)::int, (hashint8extended(g, 3) & 1023)::int,
	(hashint8extended(g, 4) & 1023)::int, (hashint8extended(g, 5) & 1023)::int, (hashint8extended(g, 6) & 1023)::int, (hashint8extended(g, 7) & 127)::int FROM generate_series(1, 400000) g;
VACUUM (FREEZE, ANALYZE) pa;
CREATE FUNCTION popt(regclass) RETURNS text LANGUAGE sql AS $$ SELECT coalesce((SELECT split_part(o, '=', 2) FROM pg_class c, unnest(c.reloptions) o WHERE c.oid = $1 AND o LIKE 'point_tid_columns=%'), '-') $$;
-- the column of random values: chosen, with the numbers of the formula
SET client_min_messages = notice;
CREATE INDEX pa_rid ON pa USING sift_col (rid, a, b, c, d, e, f);
NOTICE:  sift_col index "pa_rid": point_tid_columns includes "rid", chosen by the default formula: an equality on its nearly unique values, which do not follow the order of the table, would read every unit (about 2.2 M instructions against 0.2 M with the directory; predicted index size +73%, benefit 49 against cost 29)
HINT:  ALTER INDEX pa_rid SET (point_tid_columns = 'off') and REINDEX keep the index without it.
SET client_min_messages = warning;
-- the column in heap order, few values, a one-column index of a table that is small for it: not chosen
CREATE INDEX pa_id ON pa USING sift_col (id, a, b, c, d, e, f);
CREATE INDEX pa_few ON pa USING sift_col (a, b, c, d, e, f);
CREATE TABLE pas AS SELECT * FROM pa WHERE id <= 20000;
VACUUM (FREEZE, ANALYZE) pas;
CREATE INDEX pas_rid ON pas USING sift_col (rid, a, b, c, d, e, f);
-- the options the user sets are kept
CREATE INDEX pa_off ON pa USING sift_col (rid, a, b, c, d, e, f) WITH (point_tid_columns = 'off');
CREATE INDEX pa_user ON pa USING sift_col (rid, a, b, c, d, e, f) WITH (point_columns = 'a');
CREATE INDEX pa_tid ON pa USING sift_col (rid, a, b, c, d, e, f) WITH (point_tid_columns = 'rid');
CREATE INDEX pa_plain ON pa USING sift_col (rid, a, b, c, d, e, f) WITH (point_columns = 'rid');
SELECT i AS idx, popt(i::regclass) AS point_tid_columns FROM unnest(ARRAY['pa_rid', 'pa_id', 'pa_few', 'pas_rid', 'pa_off', 'pa_user', 'pa_tid', 'pa_plain']) i ORDER BY 1;
   idx    | point_tid_columns 
----------+-------------------
 pa_few   | -
 pa_id    | -
 pa_off   | off
 pa_plain | -
 pa_rid   | auto: rid
 pa_tid   | rid
 pa_user  | -
 pas_rid  | -
(8 rows)

-- an index cut by a key (key_cut) keeps the directory, and a rebuild keeps both: the choice of the build does not stop the cut
CREATE INDEX pa_kc ON pa USING sift_col (tenant_id, rid, a, b, c, d, e, f);
SELECT reloptions FROM pg_class WHERE relname = 'pa_kc';
                                 reloptions                                 
----------------------------------------------------------------------------
 {"key_cut=auto: tenant_id","point_tid_columns=auto: rid",key_columns=auto}
(1 row)

REINDEX INDEX pa_kc;
SELECT reloptions FROM pg_class WHERE relname = 'pa_kc';
                                 reloptions                                 
----------------------------------------------------------------------------
 {"key_cut=auto: tenant_id","point_tid_columns=auto: rid",key_columns=auto}
(1 row)

DROP INDEX pa_kc;
-- a rebuild decides again from the data it finds and keeps the choice
REINDEX INDEX pa_rid;
REINDEX INDEX pa_id;
SELECT popt('pa_rid') AS rid_after_reindex, popt('pa_id') AS id_after_reindex;
 rid_after_reindex | id_after_reindex 
-------------------+------------------
 auto: rid         | -
(1 row)

ALTER INDEX pa_rid SET (point_tid_columns = 'off');
REINDEX INDEX pa_rid;
SELECT popt('pa_rid') AS rid_off;
 rid_off 
---------
 off
(1 row)

ALTER INDEX pa_rid RESET (point_tid_columns);
REINDEX INDEX pa_rid;
SELECT popt('pa_rid') AS rid_decided_again;
 rid_decided_again 
-------------------
 auto: rid
(1 row)

-- the answers are those of the table
DROP INDEX pa_id, pa_few, pa_off, pa_user, pa_tid, pa_plain;
SELECT rid AS k FROM pa WHERE id = 123457 \gset
SET enable_seqscan = off; SET enable_bitmapscan = off;
SELECT count(*), min(id) FROM pa WHERE rid = :k;
 count |  min   
-------+--------
     1 | 123457
(1 row)

SELECT count(*) FROM pa WHERE rid IN (:k, 1, 2, (SELECT rid FROM pa WHERE id = 777));
 count 
-------
     2
(1 row)

SET enable_seqscan = on; SET enable_bitmapscan = on; SET enable_indexscan = off;
DROP INDEX pa_rid;
SELECT count(*), min(id) FROM pa WHERE rid = :k;
 count |  min   
-------+--------
     1 | 123457
(1 row)

SELECT count(*) FROM pa WHERE rid IN (:k, 1, 2, (SELECT rid FROM pa WHERE id = 777));
 count 
-------
     2
(1 row)

-- a timestamp of nearly unique values is not a lookup key (its reads are ranges and an order), and the growth the NOTICE predicts counts the values of the paths of a jsonb column, not its documents
CREATE TABLE pj AS SELECT g AS id, hashint8extended(g, 9) & 4611686018427387903 AS rid, TIMESTAMP '2025-01-01' + (hashint8extended(g, 3) & 8388607) * interval '1 second' AS ts,
	jsonb_build_object('a', g % 7, 't', 't' || g % 40, 'text', repeat(md5(g::text), 8)) AS doc FROM generate_series(1, 400000) g;
VACUUM (FREEZE, ANALYZE) pj;
SET client_min_messages = notice;
CREATE INDEX pj_auto ON pj USING sift_col (rid, ts, doc) WITH (key_cut = 'off', order_array_columns = 'off', paths = 'doc.a float8, doc.t astext');
NOTICE:  sift_col index "pj_auto": point_tid_columns includes "rid", chosen by the default formula: an equality on its nearly unique values, which do not follow the order of the table, would read every unit (about 2.2 M instructions against 0.2 M with the directory; predicted index size +74%, benefit 49 against cost 29)
HINT:  ALTER INDEX pj_auto SET (point_tid_columns = 'off') and REINDEX keep the index without it.
SET client_min_messages = warning;
CREATE INDEX pj_off ON pj USING sift_col (rid, ts, doc) WITH (key_cut = 'off', order_array_columns = 'off', paths = 'doc.a float8, doc.t astext', point_tid_columns = 'off');
SELECT popt('pj_auto') AS pj_point_tid_columns,
	round(100.0 * (pg_relation_size('pj_auto') - pg_relation_size('pj_off')) / pg_relation_size('pj_off'), -1) AS measured_growth_pct;
 pj_point_tid_columns | measured_growth_pct 
----------------------+---------------------
 auto: rid            |                  90
(1 row)

DROP TABLE pj;
DROP FUNCTION popt(regclass);
DROP TABLE pa, pas;
DROP EXTENSION pg_sift;
