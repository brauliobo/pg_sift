RESET plan_cache_mode;
-- the reason of each near miss, as the planning says it
CREATE FUNCTION miss_run(f pforms) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	RAISE NOTICE '%', f.name;
	RETURN plan_of(f, 'force_generic_plan');
END $$;
SET client_min_messages = notice;
SET sift.explain_refusals = on;
SELECT name, miss_run(f) AS plan FROM pforms f WHERE name LIKE 'miss:%' ORDER BY name COLLATE "C";
NOTICE:  miss: $1 and a column
NOTICE:  SiftAgg not used: scope: a join to the scope relation of a scope index is not one the scope read proves equal to the join: the join runs as written (the scope relation has another condition: (tenant_scope.tenant_id = ($1 + (tenant_scope.dim_a_id % 2))))
DETAIL:  arm: scope
HINT:  Join the scope relation by its declared member column to the declared column of the table, bind its scope key with an equality or an IN list of constants, and read no other column of it; the detail names what differs.
NOTICE:  miss: join, ANY (ARRAY(SELECT ..)), a row for each pair
NOTICE:  SiftAgg not used: scope: a join to the scope relation of a scope index is not one the scope read proves equal to the join: the join runs as written (several keys or every key, or the key as a group key, and a row counts once for each pair: where the units cannot answer the node runs the join, which the first pass does not have)
DETAIL:  arm: scope
HINT:  Join the scope relation by its declared member column to the declared column of the table, bind its scope key with an equality or an IN list of constants, and read no other column of it; the detail names what differs.
NOTICE:  miss: keys by a join to the table of keys
NOTICE:  SiftAgg not used: scope: a join to the scope relation of a scope index is not one the scope read proves equal to the join: the join runs as written (the table of keys may hold a key more than once, and the join counts a row for each of them)
DETAIL:  arm: scope
HINT:  Join the scope relation by its declared member column to the declared column of the table, bind its scope key with an equality or an IN list of constants, and read no other column of it; the detail names what differs.
NOTICE:  miss: numeric $1
NOTICE:  SiftAgg not used: scope: a join to the scope relation of a scope index is not one the scope read proves equal to the join: the join runs as written (the scope key is not bound by an equality or an IN list of constants or parameters)
DETAIL:  arm: scope
HINT:  Join the scope relation by its declared member column to the declared column of the table, bind its scope key with an equality or an IN list of constants, and read no other column of it; the detail names what differs.
NOTICE:  miss: range on the key
NOTICE:  SiftAgg not used: scope: a join to the scope relation of a scope index is not one the scope read proves equal to the join: the join runs as written (the scope key is not bound by an equality or an IN list of constants or parameters)
DETAIL:  arm: scope
HINT:  Join the scope relation by its declared member column to the declared column of the table, bind its scope key with an equality or an IN list of constants, and read no other column of it; the detail names what differs.
                          name                           | plan 
---------------------------------------------------------+------
 miss: $1 and a column                                   | join
 miss: join, ANY (ARRAY(SELECT ..)), a row for each pair | join
 miss: keys by a join to the table of keys               | join
 miss: numeric $1                                        | join
 miss: range on the key                                  | join
(5 rows)

RESET sift.explain_refusals;
SET client_min_messages = warning;
DROP FUNCTION miss_run(pforms);
-- a statement run with the arguments given: the keys of the run and the reader's refusal
CREATE FUNCTION arg_run(f pforms, extra text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', false);
	DEALLOCATE ALL;
	EXECUTE prepared(f, 'q');
	r := run_of(called(f, 'q', extra));
	DEALLOCATE ALL;
	RETURN r;
END $$;
-- the values a parameter may have: the keys of the run, and the rows of the join. A NULL and the NULLs of an array match nothing; an array is a set
CREATE TABLE pargs (form text, extra text);
INSERT INTO pargs VALUES
 ('IN, $1', 'NULL'), ('IN, $1', '3'), ('IN, $1', '11'),
 ('join, $1', 'NULL'), ('join, $1', '3'),
 ('IN, ANY ($1)', 'NULL'), ('IN, ANY ($1)', $a$'{}'$a$), ('IN, ANY ($1)', $a$'{NULL}'$a$), ('IN, ANY ($1)', $a$'{3,NULL}'$a$), ('IN, ANY ($1)', $a$'{3,3,4}'$a$), ('IN, ANY ($1)', $a$'{11,12}'$a$),
 ('latest 5, $1', 'NULL'), ('latest 5, $1', '4'),
 ('IN, ($1, $2)', 'NULL, 3'), ('IN, ($1, $2)', '3, 3');
SELECT a.form, a.extra, arg_run(f, a.extra) AS run, same_rows(f, 'force_generic_plan', a.extra) AS same_rows FROM pargs a JOIN pforms f ON f.name = a.form ORDER BY a.form COLLATE "C", a.extra COLLATE "C";
     form     |   extra    |             run              | same_rows 
--------------+------------+------------------------------+-----------
 IN, $1       | 11         | Keys: $1 (1 keys)            | t
 IN, $1       | 3          | Keys: $1 (1 keys)            | t
