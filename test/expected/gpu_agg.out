-- sift.gpu = on against the CPU: every aggregate the Vulkan path may take (docs/GPU.md) must give the rows the CPU gives, and so must the shapes it
-- leaves to the CPU. The test prints only whether the two agree, so it has the same output on a build without the backend, on one without a device, and
-- on one with a device. NOTICEs (no backend, no device, a device that failed) are not shown.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET seq_page_cost = 1000;
SET random_page_cost = 1000;
CREATE TABLE gx (id int, g int, c text, w int, q int, a bigint, n int, f float8, wide int, tz int, p numeric(12,2)) WITH (autovacuum_enabled = false);
INSERT INTO gx
SELECT i, i % 40, (ARRAY['north', 'south', 'east', 'west', 'centre'])[1 + i % 5], (i * 7919) % 100003 - 50000, (i * 31) % 1000,
       (i::bigint * 1000003) % 5000000000 - 2500000000, CASE WHEN i % 1000 = 0 THEN NULL ELSE i % 9 END, (i % 100) / 8.0,
       i % 100, 7, (((i::bigint * 37) % 1000000) - 500000)::numeric / 100
FROM generate_series(1, 250000) i;
CREATE INDEX gx_col ON gx USING sift_col (id, g, c, w, q, a, n, f, wide, tz, p);
VACUUM (FREEZE, ANALYZE) gx;
-- the same rows with the device on and off, in both directions
CREATE FUNCTION same(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE d bigint;
BEGIN
	SET sift.gpu = on;
	SET sift.gpu_min_rows = 1;
	EXECUTE format('CREATE TEMP TABLE r_on AS SELECT x::text AS r FROM (%s) x', q);
	SET sift.gpu = off;
	EXECUTE format('CREATE TEMP TABLE r_off AS SELECT x::text AS r FROM (%s) x', q);
	RESET sift.gpu;
	RESET sift.gpu_min_rows;
	SELECT count(*) INTO d FROM ((TABLE r_on EXCEPT ALL TABLE r_off) UNION ALL (TABLE r_off EXCEPT ALL TABLE r_on)) x;
	d := d + abs((SELECT count(*) FROM r_on) - (SELECT count(*) FROM r_off));
	DROP TABLE r_on, r_off;
	RETURN d = 0;
END $$;
SHOW sift.gpu;
 sift.gpu 
----------
 off
(1 row)

SHOW sift.gpu_min_rows;
 sift.gpu_min_rows 
-------------------
 5000000
(1 row)

SHOW sift.gpu_cache_mb;
 sift.gpu_cache_mb 
-------------------
 256MB
(1 row)

SHOW sift.gpu_device;
 sift.gpu_device 
-----------------
 
(1 row)

-- grouped count and sum of an integer key
SELECT same($$SELECT g, count(*), sum(w), sum(q) FROM gx GROUP BY g$$) AS int_key;
 int_key 
---------
 t
(1 row)

SELECT same($$SELECT g, count(*), sum(w), sum(q) FROM gx WHERE q < 900 GROUP BY g$$) AS int_key_filtered;
 int_key_filtered 
------------------
 t
(1 row)

