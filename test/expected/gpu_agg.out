(1 row)

INSERT INTO gx SELECT 300000 + i, i % 40, 'north', i, i % 1000, i, 1, 1.0, i % 100, 7, i / 4.0 FROM generate_series(1, 5000) i;
SELECT same($$SELECT g, count(*), sum(w) FROM gx WHERE q < 900 GROUP BY g$$) AS write_buffer;
 write_buffer 
--------------
 t
(1 row)

-- the settings
SET sift.gpu = auto;
SELECT count(*), sum(w) = (SELECT sum(w) FROM gx) AS auto_equal FROM gx;
 count  | auto_equal 
--------+------------
 254754 | t
(1 row)

SET sift.gpu = on;
SET sift.gpu_device = 'no such device';
SELECT same($$SELECT g, count(*), sum(w) FROM gx WHERE q < 900 GROUP BY g$$) AS unknown_device;
 unknown_device 
----------------
 t
(1 row)

RESET sift.gpu_device;
SET sift.gpu_cache_mb = 16;
SELECT same($$SELECT g, count(*), sum(w), sum(q), sum(p) FROM gx WHERE w < 20000 GROUP BY g$$) AS small_cache;
 small_cache 
-------------
 t
(1 row)

RESET sift.gpu_cache_mb;
SET sift.gpu = bogus;
ERROR:  invalid value for parameter "sift.gpu": "bogus"
HINT:  Available values: off, auto, on.
RESET sift.gpu;
-- EXPLAIN works whatever the backend
DO $$ BEGIN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) SELECT g, count(*) FROM gx GROUP BY g'; END $$;
DROP FUNCTION same(text);
DROP TABLE gx;
DROP EXTENSION pg_sift;
