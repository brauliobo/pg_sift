-- units with dead rows or pages that are not all-visible are read by the CPU in the same query
UPDATE gx SET w = w + 1, a = a - 5 WHERE id % 97 = 0;
DELETE FROM gx WHERE id % 1013 = 0;
SELECT same($$SELECT g, count(*), sum(w), sum(q) FROM gx WHERE w < 20000 GROUP BY g$$) AS dirty_grouped;
 dirty_grouped 
---------------
 t
(1 row)

SELECT same($$SELECT count(*), sum(w) FROM gx WHERE q < 500$$) AS dirty_ungrouped;
