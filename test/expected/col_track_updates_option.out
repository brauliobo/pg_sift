-- The index option track_updates names the column that identifies a row across updates: it must be a column of the index that a unique index of its own covers and that cannot be NULL.
-- On by default (auto: the primary key when the index holds it, else off with a NOTICE); named, or auto, it creates the tombstone log with the index and turns the point directory of the column on;
-- 'off' keeps the index as it was before 4.0 (no log segment, no option written).
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
CREATE TABLE t (id int PRIMARY KEY, g int NOT NULL, v int, u int NOT NULL UNIQUE, p int NOT NULL, d int NOT NULL) WITH (autovacuum_enabled = false);
CREATE UNIQUE INDEX t_partial ON t (p) WHERE p > 0;
ALTER TABLE t ADD CONSTRAINT t_d_key UNIQUE (d) DEFERRABLE;
INSERT INTO t SELECT i, i % 10, i, i, i, i FROM generate_series(1, 2000) i;
-- default: the primary key is kept, the option is written
CREATE INDEX t_dflt ON t USING sift_col (id, g, v);
SELECT count(*) AS logs FROM sift.col_segments('t_dflt') WHERE kind = 'tombstones';
 logs 
------
    1
(1 row)

SELECT reloptions::text ~ 'track_updates=id' AS has_option FROM pg_class WHERE relname = 't_dflt';
 has_option 
------------
 t
(1 row)

DROP INDEX t_dflt;
-- off: nothing kept, nothing written
CREATE INDEX t_off ON t USING sift_col (id, g, v) WITH (track_updates = 'off');
SELECT count(*) AS logs FROM sift.col_segments('t_off') WHERE kind = 'tombstones';
 logs 
------
    0
(1 row)

SELECT reloptions::text ~ 'track_updates' AS has_option FROM pg_class WHERE relname = 't_off';
 has_option 
------------
 t
(1 row)

DROP INDEX t_off;
-- a primary key, named and automatic: one log segment, the key in the point directory
CREATE INDEX t_named ON t USING sift_col (id, g, v) WITH (track_updates = 'id');
SELECT count(*) AS logs FROM sift.col_segments('t_named') WHERE kind = 'tombstones';
 logs 
------
    1
(1 row)

SELECT split_part(o, '=', 1) AS opt, split_part(o, '=', 2) AS val FROM pg_class c, unnest(c.reloptions) o WHERE c.relname = 't_named' AND o ~ '^(track_updates|point_tid_columns)' ORDER BY 1;
        opt        |   val    
-------------------+----------
 point_tid_columns | auto: id
 track_updates     | id
(2 rows)

DROP INDEX t_named;
CREATE INDEX t_auto ON t USING sift_col (id, g, v) WITH (track_updates = 'auto');
SELECT count(*) AS logs FROM sift.col_segments('t_auto') WHERE kind = 'tombstones';
 logs 
------
    1
(1 row)

SELECT o AS track_updates_written FROM pg_class c, unnest(c.reloptions) o WHERE c.relname = 't_auto' AND o ~ '^track_updates';
 track_updates_written 
-----------------------
 track_updates=id
(1 row)

-- REINDEX keeps the option and the log
REINDEX INDEX t_auto;
SELECT count(*) AS logs FROM sift.col_segments('t_auto') WHERE kind = 'tombstones';
 logs 
------
    1
(1 row)

SELECT o AS track_updates_after_reindex FROM pg_class c, unnest(c.reloptions) o WHERE c.relname = 't_auto' AND o ~ '^track_updates';
 track_updates_after_reindex 
-----------------------------
 track_updates=id
(1 row)

-- ALTER INDEX checks the new value like CREATE INDEX does
ALTER INDEX t_auto SET (track_updates = 'g');
ERROR:  track_updates: column "g" has no unique index of its own
DETAIL:  The index replaces the older entries of a key when the row is updated, which is exact only when no two live rows share the key.
HINT:  Create a UNIQUE or PRIMARY KEY constraint on the column alone: not deferrable, not partial, not on an expression, not on several columns.
ALTER INDEX t_auto SET (track_updates = 'id');
DROP INDEX t_auto;
-- a second unique column
CREATE INDEX t_unique ON t USING sift_col (u, g, v) WITH (track_updates = 'u');
SELECT count(*) AS logs FROM sift.col_segments('t_unique') WHERE kind = 'tombstones';
 logs 
------
    1
(1 row)

DROP INDEX t_unique;
-- refused, each with what to do
CREATE INDEX t_bad ON t USING sift_col (g, v) WITH (track_updates = 'g');
ERROR:  track_updates: column "g" has no unique index of its own
DETAIL:  The index replaces the older entries of a key when the row is updated, which is exact only when no two live rows share the key.
HINT:  Create a UNIQUE or PRIMARY KEY constraint on the column alone: not deferrable, not partial, not on an expression, not on several columns.
CREATE INDEX t_bad ON t USING sift_col (id, g, v) WITH (track_updates = 'v');
ERROR:  track_updates: column "v" can be NULL
HINT:  A row is found by its key: declare the column NOT NULL, or use its primary key.
CREATE INDEX t_bad ON t USING sift_col (id, g) WITH (track_updates = 'v');
ERROR:  invalid track_updates option: "v" is not a column of the index
CREATE INDEX t_bad ON t USING sift_col (id, g, p) WITH (track_updates = 'p');
ERROR:  track_updates: column "p" has no unique index of its own
DETAIL:  The index replaces the older entries of a key when the row is updated, which is exact only when no two live rows share the key.
HINT:  Create a UNIQUE or PRIMARY KEY constraint on the column alone: not deferrable, not partial, not on an expression, not on several columns.
CREATE INDEX t_bad ON t USING sift_col (id, g, d) WITH (track_updates = 'd');
ERROR:  track_updates: column "d" has no unique index of its own
DETAIL:  The index replaces the older entries of a key when the row is updated, which is exact only when no two live rows share the key.
HINT:  Create a UNIQUE or PRIMARY KEY constraint on the column alone: not deferrable, not partial, not on an expression, not on several columns.
CREATE INDEX t_bad ON t USING sift_col (id, g) WITH (track_updates = 'nope');
ERROR:  invalid track_updates option: "nope" is not a column of the index
CREATE INDEX t_bad ON t USING sift_col (id, g) WITH (track_updates = 'id, g');
ERROR:  invalid track_updates option "id, g": a single column: a composite key is not supported
CREATE INDEX t_bad ON t USING sift_col (g, v) WITH (track_updates = 'id');
ERROR:  invalid track_updates option: "id" is not a column of the index
-- a table with no primary key: auto says so and keeps no key
CREATE TABLE n (a int, b int);
INSERT INTO n SELECT i, i FROM generate_series(1, 100) i;
CREATE INDEX n_c ON n USING sift_col (a, b) WITH (track_updates = 'auto');
SELECT count(*) AS logs FROM sift.col_segments('n_c') WHERE kind = 'tombstones';
 logs 
------
    0
(1 row)

DROP TABLE n;
-- the build with the log does not change an answer, and the checks pass
CREATE INDEX t_c ON t USING sift_col (id, g, v) WITH (track_updates = 'id');
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT count(*) AS n, sum(v) AS s FROM t WHERE g = 3;
  n  |   s    
-----+--------
 200 | 199600
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT sift.col_verify('t_c');
 col_verify 
------------
 
(1 row)

-- CREATE INDEX CONCURRENTLY is allowed with track_updates alone
CREATE INDEX CONCURRENTLY t_cic ON t USING sift_col (id, g, v) WITH (track_updates = 'id');
SELECT count(*) AS logs FROM sift.col_segments('t_cic') WHERE kind = 'tombstones';
 logs 
------
    1
(1 row)

DROP INDEX t_cic;
-- RESET stops keeping a key
ALTER INDEX t_c RESET (track_updates);
SELECT o AS track_updates_after_reset FROM pg_class c, unnest(c.reloptions) o WHERE c.relname = 't_c' AND o ~ '^track_updates';
 track_updates_after_reset 
---------------------------
(0 rows)

DROP TABLE t;
DROP EXTENSION pg_sift;
