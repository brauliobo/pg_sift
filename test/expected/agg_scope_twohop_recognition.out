-- the privileges of the statement: the plan of the scope read has no scan of the tables of the arms, and the role still needs what the join needs, as the owner of a view it reads through
CREATE ROLE twohop_reader NOLOGIN;
CREATE FUNCTION denied(q text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE q;
	RETURN 'rows';
EXCEPTION WHEN insufficient_privilege THEN RETURN sqlerrm;
END $$;
CREATE TABLE roles_forms (name text PRIMARY KEY, q text);
INSERT INTO roles_forms SELECT name, q FROM forms WHERE name IN ('IN', 'IN, view', 'join, union', 'join, view', 'IN, one path');
GRANT SELECT ON facts, tenant_pairs, roles_forms TO twohop_reader;
SET ROLE twohop_reader;
SELECT name, denied(q) AS no_privilege_on_the_tables FROM roles_forms ORDER BY name;
     name     |     no_privilege_on_the_tables     
--------------+------------------------------------
 IN           | permission denied for table grants
 IN, one path | permission denied for table grants
 IN, view     | rows
 join, union  | permission denied for table grants
 join, view   | rows
(5 rows)

RESET ROLE;
GRANT SELECT ON grants TO twohop_reader;
SET ROLE twohop_reader;
SELECT name, denied(q) AS no_privilege_on_memberships FROM roles_forms ORDER BY name;
     name     |       no_privilege_on_memberships       
--------------+-----------------------------------------
 IN           | permission denied for table memberships
 IN, one path | rows
 IN, view     | rows
 join, union  | permission denied for table memberships
 join, view   | rows
(5 rows)

RESET ROLE;
GRANT SELECT ON memberships TO twohop_reader;
SET ROLE twohop_reader;
SELECT name, denied(q) AS privileges FROM roles_forms ORDER BY name;
     name     | privileges 
--------------+------------
 IN           | rows
 IN, one path | rows
 IN, view     | rows
 join, union  | rows
 join, view   | rows
(5 rows)

-- a plan made for the role that had the privilege: the role that lost it is refused
PREPARE kept_for_role AS SELECT count(*) FROM facts f WHERE f.dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = 1);
PREPARE kept_for_role_inline AS SELECT count(*) FROM facts f WHERE f.dim_a_id IN (SELECT g.dim_a_id FROM grants g WHERE g.tenant_id = 1 AND g.deleted_at IS NULL
	UNION SELECT m.dim_a_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.tenant_id = 1 AND g.deleted_at IS NULL AND m.deleted_at IS NULL);
SELECT label('EXECUTE kept_for_role_inline') AS for_the_role, denied('EXECUTE kept_for_role_inline') AS allowed;
       for_the_role       | allowed 
--------------------------+---------
 scope read, 1 keys, once | rows
(1 row)

RESET ROLE;
REVOKE SELECT ON memberships FROM twohop_reader;
SET ROLE twohop_reader;
SELECT denied('EXECUTE kept_for_role_inline') AS revoked;
                 revoked                 
-----------------------------------------
 permission denied for table memberships
(1 row)

RESET ROLE;
-- row-level security on a table of an arm: the policy is a condition of its own, which the arm cannot be proved to leave out
GRANT SELECT ON memberships TO twohop_reader;
ALTER TABLE grants ENABLE ROW LEVEL SECURITY;
CREATE POLICY grants_all ON grants FOR SELECT USING (status = 'live');
SET ROLE twohop_reader;
SELECT name, label(q) AS plan, same(q) AS same_rows FROM roles_forms WHERE name IN ('IN', 'IN, view') ORDER BY name;
   name   |                          plan                          | same_rows 
----------+--------------------------------------------------------+-----------
 IN       | join, row-level security applies to the scope relation | t
 IN, view | scope read, 1 keys, once                               | t
(2 rows)

RESET ROLE;
DROP POLICY grants_all ON grants;
ALTER TABLE grants DISABLE ROW LEVEL SECURITY;
DEALLOCATE ALL;
DROP TABLE roles_forms;
DROP FUNCTION denied(text);
DROP OWNED BY twohop_reader;
DROP ROLE twohop_reader;
-- the plan holds the relations of the arms and the scope index: a prepared statement is planned again when the btree of a path is replaced, and with no scope left
PREPARE kept AS SELECT count(*) FROM facts f WHERE f.dim_a_id IN (SELECT member FROM tenant_pairs WHERE tenant_id = 1);
SELECT label('EXECUTE kept') AS recorded_btrees, same('EXECUTE kept') AS same_rows;
     recorded_btrees      | same_rows 
--------------------------+-----------
 scope read, 1 keys, once | t
(1 row)

CREATE UNIQUE INDEX grants_group_live ON grants (group_id, tenant_id) WHERE deleted_at IS NULL AND status = 'live';
DROP INDEX facts_col;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount, kind)
	WITH (scope = 'tenant_id: dim_a_id -> grants(dim_a_id, tenant_id) | grants(group_id, tenant_id) using grants_group_live via memberships(group_id, dim_a_id)');
REINDEX INDEX facts_col;
SELECT label('EXECUTE kept') AS stricter_btree, same('EXECUTE kept') AS same_rows;
                                                                                        stricter_btree                                                                                         | same_rows 
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+-----------
 join, an arm of the union on grants: the pairs of the scope are the rows of its unique btree that satisfy ((deleted_at IS NULL) AND (status = 'live'::text)): the statement does not state it | t
(1 row)

DROP INDEX facts_col;
SELECT label('EXECUTE kept') AS no_scope_index, same('EXECUTE kept') AS same_rows;
 no_scope_index | same_rows 
----------------+-----------
 normal plan    | t
(1 row)

-- the legs on non-unique btrees (a pair in several rows of its relation): the UNION of the statement is the distinct pair set the units hold, so a join over it counts a fact once for each pair
CREATE TABLE grants_m (id int PRIMARY KEY, tenant_id int NOT NULL, dim_a_id int, group_id int, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE INDEX grants_m_direct ON grants_m (dim_a_id, tenant_id) WHERE deleted_at IS NULL;
CREATE INDEX grants_m_group ON grants_m (group_id, tenant_id) WHERE deleted_at IS NULL;
CREATE TABLE memberships_m (id serial PRIMARY KEY, group_id int NOT NULL, dim_a_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE INDEX memberships_m_active ON memberships_m (group_id, dim_a_id) WHERE deleted_at IS NULL;
CREATE INDEX grants_m_by_member ON grants_m USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX grants_m_by_group ON grants_m USING sift_col (group_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX memberships_m_by_member ON memberships_m USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
INSERT INTO memberships_m (group_id, dim_a_id) SELECT 1 + m % 6, m FROM generate_series(1, 58) m;
INSERT INTO memberships_m (group_id, dim_a_id) SELECT 1 + m % 6, m FROM generate_series(5, 58, 5) m;
INSERT INTO grants_m VALUES (1, 1, 5, NULL, NULL), (2, 1, 5, NULL, NULL), (3, 1, NULL, 6, NULL), (4, 1, NULL, 6, NULL), (5, 2, NULL, 3, NULL), (6, 2, 8, NULL, NULL), (7, 2, 8, NULL, NULL);
CREATE TABLE facts_m (id int PRIMARY KEY, dim_a_id int, amount int) WITH (autovacuum_enabled = false);
INSERT INTO facts_m SELECT i, 1 + (i * 7) % 60, i % 10 FROM generate_series(1, 3000) i;
CREATE INDEX facts_m_col ON facts_m USING sift_col (id, dim_a_id, amount)
	WITH (scope = 'tenant_id: dim_a_id -> grants_m(dim_a_id, tenant_id) | grants_m(group_id, tenant_id) via memberships_m(group_id, dim_a_id)');
VACUUM (FREEZE, ANALYZE) facts_m, grants_m, memberships_m;
CREATE VIEW tenant_pairs_m AS
	SELECT g.dim_a_id AS member, g.tenant_id FROM grants_m g WHERE g.deleted_at IS NULL
	UNION
	SELECT m.dim_a_id, g.tenant_id FROM grants_m g JOIN memberships_m m ON m.group_id = g.group_id WHERE g.deleted_at IS NULL AND m.deleted_at IS NULL;
CREATE VIEW tenant_pairs_m_all AS
	SELECT g.dim_a_id AS member, g.tenant_id FROM grants_m g WHERE g.deleted_at IS NULL
	UNION ALL
	SELECT m.dim_a_id, g.tenant_id FROM grants_m g JOIN memberships_m m ON m.group_id = g.group_id WHERE g.deleted_at IS NULL AND m.deleted_at IS NULL;
DELETE FROM forms;
INSERT INTO forms VALUES
 ('IN', $q$SELECT sum(amount) AS total, count(*) AS n FROM facts_m f WHERE f.dim_a_id IN (SELECT member FROM tenant_pairs_m WHERE tenant_id = 1)$q$),
 ('EXISTS', $q$SELECT sum(amount) AS total, count(*) AS n FROM facts_m f WHERE EXISTS (SELECT 1 FROM tenant_pairs_m v WHERE v.member = f.dim_a_id AND v.tenant_id = 2)$q$),
 ('join', $q$SELECT sum(amount) AS total, count(*) AS n FROM facts_m f JOIN tenant_pairs_m v ON v.member = f.dim_a_id WHERE v.tenant_id = 1$q$),
 ('join, UNION ALL', $q$SELECT sum(amount) AS total, count(*) AS n FROM facts_m f JOIN tenant_pairs_m_all v ON v.member = f.dim_a_id WHERE v.tenant_id = 1$q$);
SELECT name, label(q) AS plan, same(q) AS same_rows FROM forms ORDER BY name;
      name       |                                                                       plan                                                                        | same_rows 
-----------------+---------------------------------------------------------------------------------------------------------------------------------------------------+-----------
 EXISTS          | scope read, 1 keys, once                                                                                                                          | t
 IN              | scope read, 1 keys, once                                                                                                                          | t
 join            | scope read, 1 keys, per pair                                                                                                                      | t
 join, UNION ALL | join, a join to a UNION ALL of the two paths of the scope counts a member that both paths reach twice: the pairs are the distinct rows of a UNION | t
(4 rows)

DROP VIEW tenant_pairs_m, tenant_pairs_m_all;
DROP TABLE facts_m, grants_m, memberships_m;
DEALLOCATE ALL;
DROP FUNCTION label(text), rows_md5(text), same(text), states(text), held(text), facts_of(int), direct_arm(text, text, text), joined_arm(text, text, text, text), in_stmt(text), join_stmt(text, text);
DROP TABLE forms;
DROP VIEW tenant_pairs, tenant_pairs_all, tenant_pairs_barrier, tenant_pairs_keyfirst;
DROP TABLE facts, grants, memberships, my_tenants;
DROP EXTENSION pg_sift;
