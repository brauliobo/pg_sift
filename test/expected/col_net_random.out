SELECT count(*) FILTER (WHERE same) || ' ok' AS equal_to_sift_off, count(*) = (SELECT count(*) * 6 FROM rn_step WHERE sql LIKE 'VACUUM%') AS every_vacuum_checked FROM rn_res;
