INSERT INTO peaks SELECT 'few', 'build', 20000, (SELECT count(*) FROM sift.col_segments('ws_i')), (SELECT max(rows) FROM sift.col_segments('ws_i')), scope, peak
		FROM sift._test_mem_highwater(true) WHERE scope IN ('col_writer_dict', 'col_writer_points')
UPDATE ws SET g = g + 1 WHERE id % 3 = 0
VACUUM ws
SET sift.test_col_segment_kb = 2048
SELECT count(*) * 0 AS reset FROM sift._test_mem_highwater(true)
 reset 
