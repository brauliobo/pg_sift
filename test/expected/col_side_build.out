 4 |   3 |    9 |                0
 5 |   1 |    8 |                0
 5 |   1 |    9 |                0
 5 |   2 |    8 |                0
 5 |   2 |    9 |                0
 5 |   3 |    8 |                0
 5 |   3 |    9 |                0
(30 rows)

SELECT r.n, (SELECT rows FROM sift._test_side_agg('events_col', 0, 1, 'SELECT tenant_id::int8, dim_a_id::int8 FROM tenant_scope', 4, 5, 9, 0, r.lo, r.hi) WHERE tag = 'runs') > 0 AS answered_by_runs
  FROM rng r ORDER BY 1;
 n | answered_by_runs 
---+------------------
