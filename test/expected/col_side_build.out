 1 |   3 |    9 |                0
 2 |   1 |    8 |                0
 2 |   1 |    9 |                0
 2 |   2 |    8 |                0
 2 |   2 |    9 |                0
 2 |   3 |    8 |                0
 2 |   3 |    9 |                0
 3 |   1 |    8 |                0
 3 |   1 |    9 |                0
