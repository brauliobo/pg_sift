CREATE EXTENSION pg_sift;
CREATE FUNCTION toks(doc text, stemmer text DEFAULT NULL, c bool DEFAULT NULL, a bool DEFAULT NULL)
  RETURNS text LANGUAGE sql
  AS $$ SELECT string_agg(token, ' ' ORDER BY pos) FROM sift.tokenize(doc, NULL, stemmer, c, a) $$;
-- positions and character offsets
SELECT *, substr(d, start_offset + 1, end_offset - start_offset) AS source
  FROM (VALUES ('The  Quick-brown fox jumps over the lazy dog.')) v(d), sift.tokenize(d);
                       d                       | token | pos | start_offset | end_offset | source 
-----------------------------------------------+-------+-----+--------------+------------+--------
 The  Quick-brown fox jumps over the lazy dog. | the   |   0 |            0 |          3 | The
 The  Quick-brown fox jumps over the lazy dog. | quick |   1 |            5 |         10 | Quick
 The  Quick-brown fox jumps over the lazy dog. | brown |   2 |           11 |         16 | brown
 The  Quick-brown fox jumps over the lazy dog. | fox   |   3 |           17 |         20 | fox
 The  Quick-brown fox jumps over the lazy dog. | jumps |   4 |           21 |         26 | jumps
 The  Quick-brown fox jumps over the lazy dog. | over  |   5 |           27 |         31 | over
 The  Quick-brown fox jumps over the lazy dog. | the   |   6 |           32 |         35 | the
 The  Quick-brown fox jumps over the lazy dog. | lazy  |   7 |           36 |         40 | lazy
 The  Quick-brown fox jumps over the lazy dog. | dog   |   8 |           41 |         44 | dog
(9 rows)

SELECT *, substr(d, start_offset + 1, end_offset - start_offset) AS source
  FROM (VALUES ('Crème brûlée à São Paulo')) v(d), sift.tokenize(d);
            d             | token  | pos | start_offset | end_offset | source 
--------------------------+--------+-----+--------------+------------+--------
 Crème brûlée à São Paulo | creme  |   0 |            0 |          5 | Crème
 Crème brûlée à São Paulo | brulee |   1 |            6 |         12 | brûlée
 Crème brûlée à São Paulo | a      |   2 |           13 |         14 | à
 Crème brûlée à São Paulo | sao    |   3 |           15 |         18 | São
 Crème brûlée à São Paulo | paulo  |   4 |           19 |         24 | Paulo
(5 rows)

