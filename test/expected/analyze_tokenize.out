-- apostrophes, hyphens, underscores, periods and numbers separate
SELECT d, toks(d) FROM (VALUES
  ('don''t'), ('O''Neil''s'), ('John’s book'), ('rock''n''roll'), ('l''amour'), ('ʼokina ʻokina'),
  ('e-mail snake_case U.S.A.'), ('3.14 1,000 2024-10-11 10:30'), ('mp3 covid19 x86_64 C++ C# .NET'),
  ('user@example.com https://a.b/c?d=e')) v(d);
                 d                  |               toks               
------------------------------------+----------------------------------
 don't                              | don t
 O'Neil's                           | o neil s
 John’s book                        | john s book
 rock'n'roll                        | rock n roll
 l'amour                            | l amour
 ʼokina ʻokina                      | okina ʻokina
 e-mail snake_case U.S.A.           | e mail snake case u s a
 3.14 1,000 2024-10-11 10:30        | 3 14 1 000 2024 10 11 10 30
 mp3 covid19 x86_64 C++ C# .NET     | mp3 covid19 x86 64 c c net
 user@example.com https://a.b/c?d=e | user example com https a b c d e
(10 rows)

