  ('Ελληνικά ἀρχή ᾳ'), ('Москва Ёлка Йошкар-Ола їжак ў'), ('mañana Nguyễn'),
  ('مُحَمَّد'), ('עִבְרִית'), ('ﷲ'), ('ｶﾀｶﾅ'), ('㎏ ℌ ℃')) v(d);
