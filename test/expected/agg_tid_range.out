SET plan_cache_mode = force_generic_plan;
PREPARE th_generic (tid, tid) AS SELECT g, count(*) AS n FROM th WHERE ctid >= $1 AND ctid < $2 GROUP BY g;
SELECT plan_of('EXECUTE th_generic(''(10,1)'', ''(300,1)'')');
 plan_of 
---------
