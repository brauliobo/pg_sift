(1 row)

SET plan_cache_mode = force_custom_plan;
PREPARE th_custom (tid, tid) AS SELECT g, count(*) AS n FROM th WHERE ctid >= $1 AND ctid < $2 GROUP BY g ORDER BY g;
SELECT plan_of('EXECUTE th_custom(''(10,1)'', ''(300,1)'')');
 plan_of 
---------
