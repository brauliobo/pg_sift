SELECT same($$SELECT category, avg(p) AS a, count(DISTINCT id) AS orders, sum(n) AS items, count(DISTINCT id) FILTER (WHERE p > 5) AS high
			  FROM (SELECT o.id, i.category, avg(i.price) AS p, count(*) AS n
