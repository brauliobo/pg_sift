-- The sample of the default key_cut is a number of units (superblocks of 256 pages), not a number of rows: a table of narrow rows, with more than 12,500 rows a unit, is
-- sampled like one of wide rows (32 units at least) and decided by the default formula, instead of ending at "the units are too large for a sample" whatever its size.
CREATE EXTENSION pg_sift;
SET sift.async_maintenance = off;
CREATE TABLE kn (d date, a int, pad text) WITH (autovacuum_enabled = false);
SELECT setseed(0.5);
 setseed 
---------
 
(1 row)

INSERT INTO kn SELECT '2020-01-01'::date + (random() * 1826)::int, (random() * 1000)::int, repeat('x', 112) FROM generate_series(1, 900000) i;
VACUUM (FREEZE, ANALYZE) kn;
SELECT pg_relation_size('kn') / 8192 / 256 >= 64 AS units_at_least_64,
       (SELECT reltuples FROM pg_class WHERE relname = 'kn') / (pg_relation_size('kn') / 8192 / 256) > 12500 AS rows_a_unit_over_12500;
 units_at_least_64 | rows_a_unit_over_12500 
-------------------+------------------------
 t                 | t
(1 row)

CREATE INDEX kn_i ON kn USING sift_col (d, a) WITH (order_array_columns = 'off');
NOTICE:  sift_col index "kn_i": 1 automatic choice (key_cut), 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key; key_cut = d
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('kn_i');
SELECT leaf, sampled, decision, reason IS DISTINCT FROM 'the units are too large for a sample' AS was_sampled FROM sift.key_cut_decision('kn_i');
 leaf | sampled | decision | was_sampled 
------+---------+----------+-------------
 d    |      17 | cut      | t
(1 row)

DROP TABLE kn;
-- the sample is 16 superblocks at least (a table of fewer is sampled whole) and the formula decides, with no minimum of units: 500,000 ranges of 56-byte rows (23 units) are cut by the start of the range,
-- as 1,000,000 and 3,000,000 are (@> 4.4 M instructions without the cut, 1.0 M with it, a GiST 0.4 M)
CREATE TABLE kr (id int, r int4range, pad text) WITH (autovacuum_enabled = false);
INSERT INTO kr SELECT i, int4range(x, x + 1 + (hashint8extended(i, 7) & 1023)::int), repeat('x', 40)
FROM (SELECT i, (hashint8extended(i, 3) & 33554431)::int AS x FROM generate_series(1, 500000) i) s;
VACUUM (FREEZE, ANALYZE) kr;
SELECT pg_relation_size('kr') / 8192 / 256 < 32 AS under_32_units;
 under_32_units 
----------------
 t
(1 row)

CREATE INDEX kr_i ON kr USING sift_col (r);
NOTICE:  sift_col index "kr_i": 1 automatic choice (key_cut), 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key; key_cut = r#1
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('kr_i');
SELECT leaf, decision, benefit_over_cost FROM (SELECT leaf, decision, reason LIKE '%benefit of the cut is at least its cost' AS benefit_over_cost FROM sift.key_cut_decision('kr_i')) d;
 leaf | decision | benefit_over_cost 
------+----------+-------------------
 r#1  | cut      | t
(1 row)

SELECT reloptions FROM pg_class WHERE relname = 'kr_i';
      reloptions       
-----------------------
 {"key_cut=auto: r#1"}
(1 row)

SET enable_seqscan = off; SET enable_bitmapscan = off;
SELECT count(*) FROM kr WHERE r @> 12345678;
 count 
-------
    11
(1 row)

SET enable_seqscan = on; SET enable_bitmapscan = on; SET enable_indexscan = off;
DROP INDEX kr_i;
SELECT count(*) FROM kr WHERE r @> 12345678;
 count 
-------
    11
(1 row)

DROP TABLE kr;
-- a superblock that holds no row (a deleted and vacuumed range of the heap, the empty pages a bulk load leaves at its end) is no sample: it gives its place to the next one that has
-- rows, so that the first look and the sample of the rule still hold their superblocks and the table is decided, not left with "fewer superblocks than it needs"
CREATE TABLE kd (id bigint, foreign_id int, d date, pad text) WITH (fillfactor = 10, autovacuum_enabled = false);
INSERT INTO kd SELECT i, (i * 7919) % 2003, date '2020-01-01' + (i * 31 % 1500), repeat('x', 100) FROM generate_series(1, 60000) i;
VACUUM (FREEZE, ANALYZE) kd;
CREATE INDEX kd_i ON kd USING sift_col (foreign_id, d) WITH (key_cut = 'off');
NOTICE:  sift_col index "kd_i": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('kd_i');
SELECT sampled, decision FROM sift.key_cut_decision('kd_i');
 sampled | decision 
---------+----------
      16 | cut
(1 row)

DELETE FROM kd WHERE id <= 30000;
VACUUM kd;
SELECT sampled, reason NOT LIKE 'the sample holds%' AS was_decided FROM sift.key_cut_decision('kd_i');
 sampled | was_decided 
---------+-------------
      16 | t
(1 row)

DROP TABLE kd;
CREATE TABLE kt (id bigint, foreign_id int, d date, pad text) WITH (fillfactor = 10, autovacuum_enabled = false);
INSERT INTO kt SELECT i, (i * 7919) % 2003, date '2020-01-01' + (i * 31 % 1500), repeat('x', 100) FROM generate_series(1, 60000) i;
DELETE FROM kt WHERE id > 52000;
VACUUM (TRUNCATE false, ANALYZE) kt;
SELECT pg_relation_size('kt') / 8192 / 256 AS units_with_pages, (SELECT count(DISTINCT (ctid::text::point)[0]::int / 256) FROM kt) AS units_with_rows;
 units_with_pages | units_with_rows 
------------------+-----------------
               46 |              41
(1 row)

CREATE INDEX kt_i ON kt USING sift_col (foreign_id, d) WITH (key_cut = 'off');
NOTICE:  sift_col index "kt_i": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('kt_i');
SELECT sampled, reason NOT LIKE 'the sample holds%' AS was_decided FROM sift.key_cut_decision('kt_i');
 sampled | was_decided 
---------+-------------
      16 | t
(1 row)

DROP TABLE kt;
-- an empty table has nothing to sample
CREATE TABLE ke (id int, d date);
CREATE INDEX ke_i ON ke USING sift_col (id, d);
NOTICE:  sift_col index "ke_i": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('ke_i');
SELECT decision, reason FROM sift.key_cut_decision('ke_i');
 decision |       reason       
----------+--------------------
 none     | the table is empty
(1 row)

DROP TABLE ke;
DROP EXTENSION pg_sift;
