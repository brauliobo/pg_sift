RESET sift.agg_connect_found;
-- a parent too large for maintenance_work_mem is not resolved: the stamp says so, a NOTICE names the keys, the memory and the setting, sift.col_connections says refused, the join reads the parent
CREATE TABLE dim_big (id int PRIMARY KEY, label text) WITH (autovacuum_enabled = false);
INSERT INTO dim_big SELECT i, repeat('x', 40) || i FROM generate_series(1, 40000) i;
CREATE INDEX dim_big_col ON dim_big USING sift_col (id, label);
NOTICE:  sift_col index "dim_big_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('dim_big_col');
CREATE TABLE big_events (id int PRIMARY KEY, dim_big_id int NOT NULL) WITH (autovacuum_enabled = false);
INSERT INTO big_events SELECT i, 1 + i % 40000 FROM generate_series(1, 2000) i;
SET maintenance_work_mem = '1MB';
CREATE INDEX big_events_col ON big_events USING sift_col (id, dim_big_id) WITH (connect = 'dim_big_id -> dim_big(id)');
NOTICE:  sift_col index "big_events_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('big_events_col');
SELECT fill FROM sift.col_connections WHERE child = 'big_events_col'::regclass;
   fill   
----------
 unfilled
(1 row)

SELECT sift.col_maintain('big_events_col') AS rewritten;
NOTICE:  sift_col index "big_events_col": the keys of dim_big(id) do not fit maintenance_work_mem
DETAIL:  40000 keys need about 1.8 MB at 48 bytes a key, and the lookup may use half of maintenance_work_mem (0.5 MB): the connection keeps no found flag for them.
HINT:  Raise maintenance_work_mem and REINDEX the index, or set connect = 'off' on it.
 rewritten 
-----------
 t
(1 row)

SELECT fill FROM sift.col_connections WHERE child = 'big_events_col'::regclass;
                                       fill                                        
-----------------------------------------------------------------------------------
 refused: the keys of the parent do not fit maintenance_work_mem (1 of 1 segments)
(1 row)

SELECT * FROM found_run($q$SELECT count(*) FROM big_events e JOIN dim_big d ON d.id = e.dim_big_id$q$);
 same | proofs | keys |             why             | leaf_reads | heap_fetches | workers 
------+--------+------+-----------------------------+------------+--------------+---------
 t    |      0 |    0 | parent too large to resolve |          1 |            0 |       0
(1 row)

RESET maintenance_work_mem;
-- a parent that is written all the time, and children with a parent row for every key (a foreign key keeps them so): a parent row inserted or written again after the stamp changes no flag,
-- only the keys that ended are outside the proof
CREATE TABLE dim_c (id int PRIMARY KEY, label text, region int, note int) WITH (autovacuum_enabled = false, fillfactor = 50);
INSERT INTO dim_c SELECT i, 'l' || i, i % 7, 0 FROM generate_series(1, 300) i;
CREATE INDEX dim_c_col ON dim_c USING sift_col (id, label, region);
NOTICE:  sift_col index "dim_c_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('dim_c_col');
CREATE TABLE facts (id int PRIMARY KEY, dim_c_id int, v int) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, CASE WHEN i % 53 = 0 THEN NULL ELSE 1 + i % 300 END, i % 10 FROM generate_series(1, 3000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_c_id, v) WITH (connect = 'dim_c_id -> dim_c(id)');
NOTICE:  sift_col index "facts_col": 2 automatic choices (key_columns, track_changes)
DETAIL:  key_columns = dim_c_id; track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('facts_col');
CREATE TABLE shapes2 (n int, sql text);
INSERT INTO shapes2 SELECT n, replace(replace(replace(sql, 'events', 'facts'), 'dim_a_id', 'dim_c_id'), 'dim_a', 'dim_c') FROM shapes;
-- probes: the keys the scan looked up in the btree of the parent (a key that only updates ended is held without one)
CREATE FUNCTION phase2() RETURNS TABLE (n int, same boolean, proofs int, keys int, probes int, why text) LANGUAGE sql AS $$
	SELECT s.n, r.same, r.proofs, r.keys, r.heap_fetches, r.why FROM shapes2 s, LATERAL found_run(s.sql) r ORDER BY s.n
$$;
SELECT sift.col_maintain('facts_col') AS rewritten;
 rewritten 
