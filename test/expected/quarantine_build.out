-- An index that is being built is not an index that left service: the planner hook and the guard of the quarantine ask the state of an index whose file has no metapage yet (CREATE INDEX
-- on a table that has no statistics and rows enough for the build to ANALYZE it plans a statement while the index is being built), and the build, REINDEX, CREATE INDEX
-- CONCURRENTLY and the indexes of the partitions of a table succeed with the default sift.on_corruption.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET client_min_messages = warning;
SET sift.on_corruption = quarantine;
CREATE TABLE big (id int, v int, g int);
INSERT INTO big SELECT i, i % 7, i % 3 FROM generate_series(1, 100500) i;
CREATE INDEX big_idx ON big USING sift_col (id, v, g);
SELECT count(*) AS rows, count(*) FILTER (WHERE v = 3) AS v3 FROM big;
  rows  |  v3   
--------+-------
 100500 | 14357
(1 row)

REINDEX INDEX big_idx;
SELECT count(*) FILTER (WHERE v = 3) AS v3_after_reindex FROM big;
 v3_after_reindex 
------------------
            14357
(1 row)

CREATE INDEX CONCURRENTLY big_idx2 ON big USING sift_col (id, v);
REINDEX INDEX CONCURRENTLY big_idx2;
SELECT count(*) AS quarantined FROM sift.quarantine;
 quarantined 
-------------
           0
(1 row)

DROP INDEX big_idx2;
CREATE TABLE bigp (id int, v int, g int) PARTITION BY RANGE (id);
CREATE TABLE bigp1 PARTITION OF bigp FOR VALUES FROM (0) TO (60000);
CREATE TABLE bigp2 PARTITION OF bigp FOR VALUES FROM (60000) TO (200000);
INSERT INTO bigp SELECT i, i % 7, i % 3 FROM generate_series(1, 100500) i;
CREATE INDEX bigp_idx ON bigp USING sift_col (id, v, g);
SELECT count(*) FILTER (WHERE v = 3) AS v3_partitioned FROM bigp;
 v3_partitioned 
----------------
          14357
(1 row)

CREATE TABLE doc (id int, body text);
INSERT INTO doc SELECT i, 'alpha beta ' || (i % 10) FROM generate_series(1, 20000) i;
CREATE INDEX doc_idx ON doc USING sift (body);
REINDEX INDEX doc_idx;
SELECT count(*) AS alpha3 FROM doc WHERE body @@> 'alpha 3';
 alpha3 
--------
   2000
(1 row)

SELECT count(*) AS quarantined FROM sift.quarantine;
 quarantined 
-------------
           0
(1 row)

DROP TABLE big, bigp, doc;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
