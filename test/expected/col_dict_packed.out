 13 | 0:in:keccbc87e4b5ce2fe28308fd9f2a7baf3|ke9cf01c03f0979eb59cc770a5b87a542|none | ok
 14 | 0:prefix:k0                                                                   | ok
 15 | 0:prefix:kff                                                                  | ok
 16 | 0:ge:kc                                                                       | ok
 17 | 0:lt:k1                                                                       | ok
(17 rows)

-- a segment of each layout in one index, and a merge to one of the earlier minor 39
INSERT INTO dp SELECT i, 'k' || md5(i::text), md5(i::text)::uuid FROM generate_series(20001, 25000) i;
SELECT sift.col_promote('dp_new') > 0 AS promoted_new;
 promoted_new 
--------------
 t
(1 row)

SET sift.test_col_dict_unpacked = on;
SELECT sift.col_promote('dp_old') > 0 AS promoted_old;
 promoted_old 
--------------
 t
(1 row)

RESET sift.test_col_dict_unpacked;
SELECT 'dp_old' AS idx, format, count(*) AS segments FROM sift.col_segments('dp_old') WHERE kind = 'immutable' GROUP BY 2 UNION ALL SELECT 'dp_new', format, count(*) FROM sift.col_segments('dp_new') WHERE kind = 'immutable' GROUP BY 2 ORDER BY 1, 2;
  idx   | format | segments 
--------+--------+----------
 dp_new |     39 |        3
 dp_old |     37 |        3
(2 rows)

