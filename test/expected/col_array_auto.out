-- paths = auto for the array columns: a sample of the table says whether the arrays differ (their elements stand in place of the whole-array image) or repeat (the image stays)
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET client_min_messages = notice;
CREATE TABLE aa (id int, uniq text[], rep text[], mid text[], ids int4[]) WITH (autovacuum_enabled = false);
INSERT INTO aa SELECT i, ARRAY['a' || i, 'b' || i % 50, 'c' || i % 7], ARRAY['r' || i % 5, 's' || i % 3], ARRAY['m' || i % 100, 'n' || i % 11], ARRAY[i, i % 100]
FROM generate_series(1, 12000) i;
ANALYZE aa;
CREATE INDEX aa_col ON aa USING sift_col (id, uniq, rep, mid, ids);
NOTICE:  sift_col index "aa_col": array_lengths = 'auto' keeps the lengths of the arrays uniq, rep, mid, ids
DETAIL:  cardinality(x), array_length(x, 1) and x IS [NOT] NULL are read from two integer columns of each array, without the array: about a byte a row for each.
HINT:  To drop them, run ALTER INDEX aa_col SET (array_lengths = 'off') and REINDEX.
NOTICE:  sift_col index "aa_col": paths = 'auto' keeps the elements of the arrays uniq, ids, mid
DETAIL:  An element test (@>, &&, <@, = ANY) of an array column of text or integers reads a directory of the rows that own each element, where it read every array. The arrays of uniq, ids are nearly all different in a sample, so the index keeps their elements in place of the arrays: equality with an array reads the rows that own its elements and their order, GROUP BY and DISTINCT of an array and the array itself read the table. The arrays of mid repeat, so the index keeps them as well (a '+' in paths).
HINT:  To keep the arrays and leave the elements out, run ALTER INDEX aa_col SET (paths = 'auto:') and REINDEX.
SELECT regexp_replace(reloptions::text, '(auto: )[^,}]*', '\1...') AS options FROM pg_class WHERE relname = 'aa_col';
                            options                            
---------------------------------------------------------------
 {array_lengths=on,"paths=auto: ..., +mid[] text, ids[] int4"}
(1 row)

SELECT leaf, path, type FROM sift.col_leaves('aa_col') ORDER BY leaf;
 leaf |  path  |       type       
------+--------+------------------
    0 | id     | integer
    1 | uniq   | text[]
    2 | uniq#1 | integer (lane 1)
    3 | uniq#2 | integer (lane 2)
    4 | uniq[] | bigint
    5 | uniq[] | text
    6 | rep    | text[]
    7 | rep#1  | integer (lane 1)
    8 | rep#2  | integer (lane 2)
    9 | mid    | text[]
   10 | mid#1  | integer (lane 1)
   11 | mid#2  | integer (lane 2)
   12 | mid[]  | bigint
   13 | mid[]  | text
   14 | ids    | integer[]
   15 | ids#1  | integer (lane 1)
   16 | ids#2  | integer (lane 2)
   17 | ids[]  | bigint
   18 | ids[]  | integer
(19 rows)

SELECT sift.col_verify('aa_col', true);
 col_verify 
------------
 
(1 row)

SET seq_page_cost = 1000;
SET random_page_cost = 1000;
SELECT count(*) FROM aa WHERE uniq @> ARRAY['b7', 'c0'];
 count 
-------
    35
(1 row)

SELECT count(*) FROM aa WHERE rep @> ARRAY['r2'];
 count 
-------
  2400
(1 row)

SELECT count(*) FROM aa WHERE mid @> ARRAY['m7', 'n3'];
 count 
-------
    11
(1 row)

SELECT count(*) FROM aa WHERE ids && ARRAY[5, 99999];
 count 
-------
   120
(1 row)

SELECT rep, count(*) FROM aa GROUP BY 1 ORDER BY 1 LIMIT 3;
   rep   | count 
---------+-------
 {r0,s0} |   800
 {r0,s1} |   800
 {r0,s2} |   800
(3 rows)

-- a table too small for a sample gets neither
CREATE TABLE ab AS SELECT i AS id, ARRAY['a' || i] AS uniq FROM generate_series(1, 500) i;
CREATE INDEX ab_col ON ab USING sift_col (id, uniq);
NOTICE:  sift_col index "ab_col": array_lengths = 'auto' keeps the lengths of the arrays uniq
DETAIL:  cardinality(x), array_length(x, 1) and x IS [NOT] NULL are read from two integer columns of each array, without the array: about a byte a row for each.
HINT:  To drop them, run ALTER INDEX ab_col SET (array_lengths = 'off') and REINDEX.
SELECT leaf, path FROM sift.col_leaves('ab_col') ORDER BY leaf;
 leaf |  path  
------+--------
    0 | id
    1 | uniq
    2 | uniq#1
    3 | uniq#2
(4 rows)

-- a table loaded and indexed before its first ANALYZE or VACUUM (reltuples -1) is sized from its pages, as the planner does: it gets the same choice as the analyzed one
CREATE TABLE ac (id int, uniq text[], rep text[]) WITH (autovacuum_enabled = false);
INSERT INTO ac SELECT i, ARRAY['a' || i, 'b' || i % 50, 'c' || i % 7], ARRAY['r' || i % 5, 's' || i % 3] FROM generate_series(1, 12000) i;
SELECT reltuples FROM pg_class WHERE relname = 'ac';
 reltuples 
-----------
        -1
(1 row)

CREATE INDEX ac_col ON ac USING sift_col (id, uniq, rep);
NOTICE:  sift_col index "ac_col": array_lengths = 'auto' keeps the lengths of the arrays uniq, rep
DETAIL:  cardinality(x), array_length(x, 1) and x IS [NOT] NULL are read from two integer columns of each array, without the array: about a byte a row for each.
HINT:  To drop them, run ALTER INDEX ac_col SET (array_lengths = 'off') and REINDEX.
NOTICE:  sift_col index "ac_col": paths = 'auto' keeps the elements of the arrays uniq
DETAIL:  An element test (@>, &&, <@, = ANY) of an array column of text or integers reads a directory of the rows that own each element, where it read every array. The arrays of uniq are nearly all different in a sample, so the index keeps their elements in place of the arrays: equality with an array reads the rows that own its elements and their order, GROUP BY and DISTINCT of an array and the array itself read the table.
HINT:  To keep the arrays and leave the elements out, run ALTER INDEX ac_col SET (paths = 'auto:') and REINDEX.
SELECT regexp_replace(reloptions::text, '(auto: )[^,}]*', '\1...') AS options FROM pg_class WHERE relname = 'ac_col';
               options               
-------------------------------------
 {array_lengths=on,"paths=auto: ...}
(1 row)

SELECT leaf, path, type FROM sift.col_leaves('ac_col') ORDER BY leaf;
 leaf |  path  |       type       
------+--------+------------------
    0 | id     | integer
    1 | uniq   | text[]
    2 | uniq#1 | integer (lane 1)
    3 | uniq#2 | integer (lane 2)
    4 | uniq[] | bigint
    5 | uniq[] | text
    6 | rep    | text[]
    7 | rep#1  | integer (lane 1)
    8 | rep#2  | integer (lane 2)
(9 rows)

-- the HINT of the NOTICE: paths = 'auto:' keeps the arrays and leaves the elements out (an empty value is auto, which chooses the elements again)
ALTER INDEX aa_col SET (paths = 'auto:');
REINDEX INDEX aa_col;
SELECT leaf, path FROM sift.col_leaves('aa_col') ORDER BY leaf;
 leaf |  path  
------+--------
    0 | id
    1 | uniq
    2 | uniq#1
    3 | uniq#2
    4 | rep
    5 | rep#1
    6 | rep#2
    7 | mid
    8 | mid#1
    9 | mid#2
   10 | ids
   11 | ids#1
   12 | ids#2
(13 rows)

ALTER INDEX aa_col SET (paths = '');
REINDEX INDEX aa_col;
NOTICE:  sift_col index "aa_col": paths = 'auto' keeps the elements of the arrays uniq, ids, mid
DETAIL:  An element test (@>, &&, <@, = ANY) of an array column of text or integers reads a directory of the rows that own each element, where it read every array. The arrays of uniq, ids are nearly all different in a sample, so the index keeps their elements in place of the arrays: equality with an array reads the rows that own its elements and their order, GROUP BY and DISTINCT of an array and the array itself read the table. The arrays of mid repeat, so the index keeps them as well (a '+' in paths).
HINT:  To keep the arrays and leave the elements out, run ALTER INDEX aa_col SET (paths = 'auto:') and REINDEX.
SELECT leaf, path FROM sift.col_leaves('aa_col') ORDER BY leaf;
 leaf |  path  
------+--------
    0 | id
    1 | uniq
    2 | uniq#1
    3 | uniq#2
    4 | uniq[]
    5 | uniq[]
    6 | rep
    7 | rep#1
    8 | rep#2
    9 | mid
   10 | mid#1
   11 | mid#2
   12 | mid[]
   13 | mid[]
   14 | ids
   15 | ids#1
   16 | ids#2
   17 | ids[]
   18 | ids[]
(19 rows)

DROP TABLE aa, ab, ac;
DROP EXTENSION pg_sift;
