-- SiftAggV6 against the heap, for the operands a plan reads when the scan starts: float parameters and constants (NaN and the infinities are values of the order of PostgreSQL, so the
-- scan decides them as the heap does), and the PARAM_EXEC of a correlated scan (a lateral join, which rescans it with the value of each outer row) and of a sub-select that runs first.
-- Every statement is run with the node (sift.enable_agg), without it, and through the index scan of the same index; the first word says the answers agree, the second the plan the node's.
CREATE EXTENSION IF NOT EXISTS pg_sift;
SET sift.test_create_format1 = off;
SET sift.agg_force = on;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET timezone = 'UTC';
CREATE TABLE fp (id int PRIMARY KEY, g int, f float8, h float4, n int, v bigint) WITH (autovacuum_enabled = false);
INSERT INTO fp SELECT i, i % 5, CASE WHEN i % 997 = 0 THEN 'NaN' WHEN i % 991 = 0 THEN 'Infinity' WHEN i % 983 = 0 THEN '-Infinity' WHEN i % 89 = 0 THEN NULL ELSE (i % 500) * 0.25 - 40 END,
	(i % 100) * 0.5, i % 100, i * 3 FROM generate_series(1, 20000) i;
CREATE INDEX fp_col ON fp USING sift_col (g, f, h, n, id, v);
CREATE TABLE fd (k int PRIMARY KEY, label text, region int);
INSERT INTO fd SELECT i, 'name' || i, i % 4 FROM generate_series(0, 99) i;
VACUUM ANALYZE fp;
ANALYZE fd;
CREATE FUNCTION answer(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	IF q ~* '^execute' THEN
		EXECUTE 'CREATE TEMP TABLE same_r AS ' || q;
		q := 'SELECT * FROM same_r';
	END IF;
	EXECUTE 'SELECT md5(coalesce(string_agg(r::text, ''|'' ORDER BY r::text), '''')) FROM (' || q || ') r' INTO r;
	DROP TABLE IF EXISTS pg_temp.same_r;
	RETURN r;
END $$;
CREATE FUNCTION same(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text; c text; l text; plan text := '';
BEGIN
	PERFORM set_config('sift.enable_agg', 'on', true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || l; END LOOP;
	a := answer(q);
	PERFORM set_config('sift.enable_agg', 'off', true);
	b := answer(q);
	PERFORM set_config('enable_seqscan', 'off', true);
	c := answer(q);
	PERFORM set_config('enable_seqscan', 'on', true);
	RETURN (CASE WHEN a = b AND b = c THEN 'same' ELSE 'DIFFERENT' END) || ' ' ||
		(CASE WHEN plan LIKE '%SiftAggV6Sip%' THEN 'sip' WHEN plan LIKE '%SiftAggV6%' THEN 'node' ELSE 'normal' END) || ' ' || q;
END $$;
-- a float constant or parameter against a float8 and a float4 column: NaN, the infinities, NULL, a value the column holds and one it does not
SELECT same(format('SELECT count(*), min(id), max(id) FROM fp WHERE %s %s %L::%s', col, o, v, ty))
FROM (VALUES ('f', 'float8'), ('h', 'float4')) c(col, ty), unnest(ARRAY['=', '<', '<=', '>', '>=']) o, unnest(ARRAY['NaN', 'Infinity', '-Infinity', '0', '12.5', '-39.75']) v;
                                        same                                        
------------------------------------------------------------------------------------
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f = 'NaN'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h = 'NaN'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f < 'NaN'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h < 'NaN'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f <= 'NaN'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h <= 'NaN'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f > 'NaN'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h > 'NaN'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f >= 'NaN'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h >= 'NaN'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f = 'Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h = 'Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f < 'Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h < 'Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f <= 'Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h <= 'Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f > 'Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h > 'Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f >= 'Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h >= 'Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f = '-Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h = '-Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f < '-Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h < '-Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f <= '-Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h <= '-Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f > '-Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h > '-Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f >= '-Infinity'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h >= '-Infinity'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f = '0'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h = '0'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f < '0'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h < '0'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f <= '0'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h <= '0'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f > '0'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h > '0'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f >= '0'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h >= '0'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f = '12.5'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h = '12.5'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f < '12.5'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h < '12.5'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f <= '12.5'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h <= '12.5'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f > '12.5'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h > '12.5'::float4
 same node SELECT count(*), min(id), max(id) FROM fp WHERE f >= '12.5'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h >= '12.5'::float4
