 same node SELECT count(*), min(id), max(id) FROM fp WHERE f >= '-39.75'::float8
 same node SELECT count(*), min(id), max(id) FROM fp WHERE h >= '-39.75'::float4
(60 rows)

SET plan_cache_mode = force_generic_plan;
PREPARE f1(float8) AS SELECT g, count(*), sum(id) FROM fp WHERE f > $1 GROUP BY g;
PREPARE f2(float8, float8) AS SELECT count(*), min(id), max(id) FROM fp WHERE f >= $1 AND f <= $2;
PREPARE f3(float4) AS SELECT count(*) FROM fp WHERE h < $1;
PREPARE f4(float8) AS SELECT count(*) FROM fp WHERE f = $1;
SELECT same(q) FROM unnest(ARRAY['EXECUTE f1(0)', 'EXECUTE f1(''NaN'')', 'EXECUTE f1(''Infinity'')', 'EXECUTE f1(''-Infinity'')', 'EXECUTE f1(-1000)', 'EXECUTE f1(NULL)',
	'EXECUTE f2(-5, 5)', 'EXECUTE f2(''-Infinity'', ''Infinity'')', 'EXECUTE f2(''NaN'', ''NaN'')', 'EXECUTE f2(0, ''NaN'')', 'EXECUTE f3(10)', 'EXECUTE f3(''NaN'')',
	'EXECUTE f4(0)', 'EXECUTE f4(''NaN'')', 'EXECUTE f4(''Infinity'')']) q;
                     same                      
-----------------------------------------------
 same node EXECUTE f1(0)
 same node EXECUTE f1('NaN')
 same node EXECUTE f1('Infinity')
 same node EXECUTE f1('-Infinity')
 same node EXECUTE f1(-1000)
 same node EXECUTE f1(NULL)
 same node EXECUTE f2(-5, 5)
 same node EXECUTE f2('-Infinity', 'Infinity')
 same node EXECUTE f2('NaN', 'NaN')
 same node EXECUTE f2(0, 'NaN')
 same node EXECUTE f3(10)
 same node EXECUTE f3('NaN')
 same node EXECUTE f4(0)
 same node EXECUTE f4('NaN')
 same node EXECUTE f4('Infinity')
(15 rows)

RESET plan_cache_mode;
-- PARAM_EXEC of a lateral join: each outer row rescans the aggregate with its own value
SELECT same(q) FROM unnest(ARRAY[
	'SELECT l.k, x.g, x.c FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, count(*) c FROM fp WHERE n > l.k GROUP BY g) x',
	'SELECT l.k, x.g, x.c FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, count(*) c FROM fp WHERE f > l.k::float8 / 3 GROUP BY g) x',
	'SELECT l.k, x.g, x.c FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, count(*) c FROM fp WHERE f > l.k::float8 / 3 GROUP BY g ORDER BY c DESC, g LIMIT 2) x',
	'SELECT l.k, x.* FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, sum(v), rank() OVER (ORDER BY sum(v)) FROM fp WHERE n > l.k GROUP BY g) x',
	'SELECT l.k, x.label, x.c FROM generate_series(1000, 60000, 20000) l(k), LATERAL (SELECT d.label, count(*) c FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.v > l.k GROUP BY d.label) x',
	'SELECT l.k, x.label, x.c FROM generate_series(1, 5) l(k), LATERAL (SELECT d.label, count(*) c FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.f > l.k * 10 GROUP BY d.label) x'
]) q;
                                                                                                    same                                                                                                     
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same node SELECT l.k, x.g, x.c FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, count(*) c FROM fp WHERE n > l.k GROUP BY g) x
 same normal SELECT l.k, x.g, x.c FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, count(*) c FROM fp WHERE f > l.k::float8 / 3 GROUP BY g) x
 same normal SELECT l.k, x.g, x.c FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, count(*) c FROM fp WHERE f > l.k::float8 / 3 GROUP BY g ORDER BY c DESC, g LIMIT 2) x
 same normal SELECT l.k, x.* FROM generate_series(10, 90, 40) l(k), LATERAL (SELECT g, sum(v), rank() OVER (ORDER BY sum(v)) FROM fp WHERE n > l.k GROUP BY g) x
 same node SELECT l.k, x.label, x.c FROM generate_series(1000, 60000, 20000) l(k), LATERAL (SELECT d.label, count(*) c FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.v > l.k GROUP BY d.label) x
 same sip SELECT l.k, x.label, x.c FROM generate_series(1, 5) l(k), LATERAL (SELECT d.label, count(*) c FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.f > l.k * 10 GROUP BY d.label) x
(6 rows)

-- PARAM_EXEC of a sub-select that runs before the scan
SELECT same(q) FROM unnest(ARRAY[
	'SELECT g, count(*) FROM fp WHERE f > (SELECT avg(f) FROM fp WHERE f < ''Infinity'') GROUP BY g',
	'SELECT g, count(*) FROM fp WHERE n > (SELECT max(n) / 2 FROM fp) GROUP BY g ORDER BY 2 DESC, 1 LIMIT 3',
	'SELECT d.label, count(*) FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.v > (SELECT max(v) / 2 FROM fp) GROUP BY d.label',
	'SELECT d.label, count(*) FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.f > (SELECT avg(f) FROM fp WHERE f < ''Infinity'') GROUP BY d.label',
	'SELECT g, count(*) FROM fp WHERE f > (SELECT f FROM fp WHERE id = 0) GROUP BY g'
]) q;
                                                                              same                                                                              
----------------------------------------------------------------------------------------------------------------------------------------------------------------
 same node SELECT g, count(*) FROM fp WHERE f > (SELECT avg(f) FROM fp WHERE f < 'Infinity') GROUP BY g
 same node SELECT g, count(*) FROM fp WHERE n > (SELECT max(n) / 2 FROM fp) GROUP BY g ORDER BY 2 DESC, 1 LIMIT 3
 same node SELECT d.label, count(*) FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.v > (SELECT max(v) / 2 FROM fp) GROUP BY d.label
 same node SELECT d.label, count(*) FROM fp f JOIN fd d ON d.k = f.n WHERE d.region = 1 AND f.f > (SELECT avg(f) FROM fp WHERE f < 'Infinity') GROUP BY d.label
 same node SELECT g, count(*) FROM fp WHERE f > (SELECT f FROM fp WHERE id = 0) GROUP BY g
(5 rows)

DROP TABLE fp, fd;
DROP FUNCTION same(text);
DROP FUNCTION answer(text);
DROP EXTENSION pg_sift;
