-- The tiers merge the overlays of a key-cut index (the partitions a smaller setting cut, under half of the size in effect) as runs that are consecutive in the key: the
-- partitions they write meet none of the others. Picked by their sizes, the overlays of different keys made partitions that met each other, and the rewrite of those
-- (a second write of the index after a VACUUM of a delete) was the end of the merges.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET client_min_messages = warning;
SET sift.async_maintenance = off;
SET sift.async_maintenance = off;
SET max_parallel_maintenance_workers = 0;
CREATE TABLE kr (id int, cust int, amount int, pad text) WITH (autovacuum_enabled = false);
CREATE INDEX kr_idx ON kr USING sift_col (id, cust, amount, pad) WITH (key_cut = 'cust');
INSERT INTO kr SELECT i, c, i % 100, substr(md5(i::text), 1, 1 + 4 * ((c / 64 * 5) % 7))
FROM (SELECT i, ((i::bigint * 7919) % 2000)::int c FROM generate_series(1, 1000000) i) t;
SELECT sift.col_promote('kr_idx');
 col_promote 
-------------
           2
(1 row)

CREATE FUNCTION kr_disjoint() RETURNS bool LANGUAGE sql AS $$
	WITH r AS (SELECT a.segment, min(a.min::int) lo, max(a.max::int) hi FROM sift.col_unit_agg('kr_idx', 'cust') a GROUP BY a.segment)
	SELECT NOT EXISTS (SELECT 1 FROM r x JOIN r y ON x.segment < y.segment AND x.lo < y.hi AND y.lo < x.hi) $$;
-- a unit is a partition at a setting under its bytes, and the sizes of the partitions differ by the key
SET sift.test_col_partition_kb = 64;
SELECT sift.col_merge('kr_idx', true);
 col_merge 
-----------
         1
(1 row)

CREATE TEMP TABLE kr_before AS SELECT count(*) AS partitions FROM sift.col_segments('kr_idx') WHERE kind = 'immutable';
SELECT partitions > 16 AS many_partitions, kr_disjoint() AS partitions_disjoint FROM kr_before;
 many_partitions | partitions_disjoint 
-----------------+---------------------
 t               | t
(1 row)

-- all of them are overlays of the size in effect after the setting is raised; the VACUUM of a delete merges them in runs of the key
DELETE FROM kr WHERE id % 10 = 0;
SET sift.test_col_partition_kb = 8192;
VACUUM kr;
SELECT count(*) < (SELECT partitions FROM kr_before) AS fewer_segments, sum(rows) = (SELECT count(*) FROM kr) AS rows_kept, kr_disjoint() AS disjoint_after_vacuum
FROM sift.col_segments('kr_idx') WHERE kind = 'immutable';
 fewer_segments | rows_kept | disjoint_after_vacuum 
----------------+-----------+-----------------------
 t              | t         | t
(1 row)

SELECT sift.col_verify('kr_idx', true);
 col_verify 
------------
 
(1 row)

DROP FUNCTION kr_disjoint();
DROP TABLE kr_before;
DROP TABLE kr;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
