 12 | t    | f
(12 rows)

SELECT sift.col_promote('events_col') IS NOT NULL AND sift.col_promote('events_t_col') IS NOT NULL AS promoted;
 promoted 
----------
 t
(1 row)

SELECT c.n, r.same, r.scope_units FROM cases c, LATERAL probe(c.stmt) r ORDER BY c.n;
 n  | same | scope_units 
