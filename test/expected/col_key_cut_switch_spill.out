-- ALTER INDEX .. SET (key_cut) leaves the segments cut the old way, and a merge sorts their rows again. Rows that do not fit maintenance_work_mem are sorted
-- by a sort that spills to temporary files (as a sort of the executor does), not held whole: the merge stops with no error, whatever the size of the input,
-- and writes what it writes when the rows fit. The sizes here are small: maintenance_work_mem is lowered to 1 MB so that 30,000 rows do not fit (a row of the sort takes about 100 bytes).
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
CREATE EXTENSION pg_sift_helpers;
SET client_min_messages = warning;
SET max_parallel_maintenance_workers = 0;
-- 100 tenants in heap order but for 15% of the rows, which land anywhere (the units of a cut by tenant_id each span the heap); NULL keys, text, an array and a
-- float among the leaves, so that the rows a sort writes and reads back hold every kind of value
CREATE TABLE sp (id int, tenant_id int, a1 int, a2 int, f float8, label text, tags int[], pad text) WITH (fillfactor = 10, autovacuum_enabled = false);
SELECT setseed(0.5);
 setseed 
---------
 
(1 row)

INSERT INTO sp SELECT i, CASE WHEN random() < 0.15 THEN (random() * 100)::int ELSE i / 300 END,
	CASE WHEN i % 17 = 0 THEN NULL ELSE (i * 31) % 1000 END, (i * 37) % 1000,
	CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN -0.0 ELSE (i % 500) / 8.0 END,
	'label ' || (i % 3000), ARRAY[i % 7, i % 11, i % 13], repeat('x', 40)
FROM generate_series(1, 30000) i;
VACUUM (FREEZE, ANALYZE) sp;
CREATE FUNCTION sp_check(idx regclass) RETURNS TABLE (differences bigint) LANGUAGE plpgsql AS $$
BEGIN
	PERFORM sift.col_verify(idx, true);
	RETURN QUERY SELECT sift_helpers.differences_agg('SELECT tenant_id, count(*) AS n, sum(a1) AS s, max(id) AS m FROM sp GROUP BY tenant_id')
		+ sift_helpers.differences_agg('SELECT a1, count(*) AS n, sum(a2) AS s, min(f) AS lo FROM sp WHERE a1 BETWEEN 100 AND 400 GROUP BY a1')
		+ sift_helpers.differences_agg('SELECT label, count(*) AS n, sum(tags[1]) AS s FROM sp WHERE label LIKE ''label 1%'' GROUP BY label')
		+ sift_helpers.differences_agg('SELECT a2, count(*) AS n FROM sp WHERE a1 IS NULL GROUP BY a2');
END $$;
CREATE FUNCTION sp_churn(base int) RETURNS void LANGUAGE sql AS $$
	INSERT INTO sp SELECT base + i, (random() * 100)::int, CASE WHEN i % 19 = 0 THEN NULL ELSE (i * 7) % 1000 END, i % 999, i / 3.0, 'label ' || (i % 100), ARRAY[i % 5], 'y'
	FROM generate_series(1, 2000) i;
	DELETE FROM sp WHERE id % 13 = base % 13 AND id < 30000;
$$;
-- the segments of an index as the merge wrote them, to compare two merges of the same rows
CREATE FUNCTION sp_segments(idx regclass) RETURNS TABLE (kind text, rows bigint, units int, dead_rows bigint, bytes bigint) LANGUAGE sql AS $$
	SELECT kind, rows, units, dead_rows, bytes FROM sift.col_segments(idx) ORDER BY sb_lo, rows, bytes;
$$;
-- two indexes of the same rows, cut by tenant_id; one is merged with the memory the rows need, the other with a memory they do not fit
CREATE INDEX sp_fit ON sp USING sift_col (tenant_id, a1, a2, f, label, tags, pad) WITH (key_cut = 'tenant_id', order_array_columns = 'off');
CREATE INDEX sp_spill ON sp USING sift_col (tenant_id, a1, a2, f, label, tags, pad) WITH (key_cut = 'tenant_id', order_array_columns = 'off');
ALTER INDEX sp_fit SET (key_cut = 'a1');
ALTER INDEX sp_spill SET (key_cut = 'a1');
SELECT sp_churn(100000);
 sp_churn 
----------
 
(1 row)

SELECT sift._test_col_cut_sorts_reset();
 _test_col_cut_sorts_reset 
