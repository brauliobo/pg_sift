DROP TABLE sp;
-- the rolling rewrite of an index in partitions reads the overlays through the window of the key range of a partition, and a step leaves the rows outside it to the
-- steps that own them: the rows of an input that is sorted are cut by the window as well. Every keyed input is read as cut another way (sift.test_col_loose_inputs), so
-- each step sorts the rows of the partition and the overlays that are in its window and leaves the others out
CREATE TABLE rl (id int, cust int, a1 int, amount int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO rl SELECT i, (i::bigint * 7919) % 600, (i * 31) % 1000, i % 100, md5(i::text) FROM generate_series(1, 60000) i;
SET sift.async_maintenance = on;
SET sift.test_col_partition_kb = 256;
SET sift.async_maintenance = off;
SET sift.test_col_net = off;
CREATE INDEX rl_idx ON rl USING sift_col (id, cust, a1, amount, pad) WITH (key_cut = 'cust', dict_lookup = off, dead_rewrite_pct = 100);
UPDATE rl SET amount = amount + 1 WHERE id % 5 = 1;
VACUUM (FREEZE, DISABLE_PAGE_SKIPPING, INDEX_CLEANUP ON) rl;
SELECT sift.col_maintain('rl_idx') IS NOT NULL AS partitioned;
 partitioned 
-------------
 t
(1 row)

UPDATE rl SET amount = amount + 1 WHERE id % 5 = 2;
VACUUM (FREEZE, DISABLE_PAGE_SKIPPING, INDEX_CLEANUP ON) rl;
SET maintenance_work_mem = '1MB';
SET sift.test_col_loose_inputs = on;
SELECT sift._test_col_cut_sorts_reset();
 _test_col_cut_sorts_reset 
---------------------------
 
(1 row)

SELECT sift.col_maintain('rl_idx') IS NOT NULL AS rolled;
 rolled 
--------
 t
(1 row)

UPDATE rl SET amount = amount + 1 WHERE id % 5 = 3;
VACUUM (FREEZE, DISABLE_PAGE_SKIPPING, INDEX_CLEANUP ON) rl;
DO $$ BEGIN FOR i IN 1..12 LOOP PERFORM sift.col_maintain('rl_idx'); END LOOP; END $$;
SELECT sift._test_col_cut_sort_rows() > 100000 AS rows_sorted, sift._test_col_cut_sort_disk_kb() > 0 AS on_disk, sift._test_col_cut_sort_cut() > 0 AS window_cut_rows;
 rows_sorted | on_disk | window_cut_rows 
-------------+---------+-----------------
 t           | t       | t
(1 row)

RESET sift.test_col_loose_inputs;
RESET maintenance_work_mem;
SELECT count(*) >= 3 AS partitions FROM sift.col_segments('rl_idx') WHERE kind = 'immutable';
 partitions 
------------
 t
(1 row)

SELECT sift.col_verify('rl_idx', true);
