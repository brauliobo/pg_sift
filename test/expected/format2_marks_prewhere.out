-- Writes, a merge and a vacuum on those keys: new parts whose keys fall between and beyond the old ones, deletes, updates of the key, a NaN in a part
INSERT INTO mt SELECT 100000 + i, 'g' || lpad(((i / 1500) % 30)::text, 2, '0'), ('00000000-0000-0000-0000-' || lpad(((i / 20) % 600)::text, 12, '0'))::uuid, ((i / 100) % 70)::numeric / 4, i % 97, 'k' || (i % 31)
FROM generate_series(1, 30000) i;
DELETE FROM mt WHERE id % 11 = 0 AND g = 'g03';
UPDATE mt SET g = 'g03', u = '00000000-0000-0000-0000-000000000030', n = 2.5 WHERE id % 503 = 0;
INSERT INTO mtn SELECT 50000 + i, 'g' || (i / 5000), CASE WHEN i % 700 = 0 THEN 'NaN'::numeric ELSE ((i / 100) % 50)::numeric / 4 END, i % 97 FROM generate_series(1, 20000) i;
