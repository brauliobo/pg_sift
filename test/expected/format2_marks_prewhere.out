-- A key column with a collation of its own: the order of the part is the bytes', so a range or a prefix is the heap's, and an equality under a nondeterministic collation is too
CREATE COLLATION mk_nd (provider = icu, locale = 'und-u-ks-level2', deterministic = false);
CREATE TABLE mc (id int, g text COLLATE "und-x-icu", h text COLLATE "C", v int);
INSERT INTO mc SELECT i, (ARRAY['a', 'B', 'c', 'D', U&'\00E9', 'E', 'z', 'Z', 'b', 'A'])[1 + (i / 500) % 10], (ARRAY['x', 'Y', 'w', 'V'])[1 + i % 4], i % 13 FROM generate_series(1, 20000) i;
CREATE INDEX mc_idx ON mc USING sift_col (id, g, h, v) WITH (key_order = 'g, h');
SELECT q, f2_same(q) FROM unnest(ARRAY[
	'SELECT id FROM mc WHERE g = ''B''',
	'SELECT id FROM mc WHERE g = ''b''',
	'SELECT id FROM mc WHERE g > ''b''',
	'SELECT id FROM mc WHERE g BETWEEN ''a'' AND ''c''',
	'SELECT id FROM mc WHERE g < ''D'' COLLATE "C"',
	'SELECT id FROM mc WHERE g >= ''c'' COLLATE "und-x-icu"',
	'SELECT id FROM mc WHERE g LIKE ''B%''',
	'SELECT id FROM mc WHERE g LIKE ''b%'' COLLATE "C"',
	'SELECT id FROM mc WHERE g = ''b'' COLLATE mk_nd',
	'SELECT id FROM mc WHERE g > ''b'' COLLATE mk_nd',
	'SELECT id FROM mc WHERE g IN (''a'', ''Z'')',
	'SELECT id FROM mc WHERE g = ''B'' AND h > ''W''',
	'SELECT id FROM mc WHERE g > ''b'' AND h = ''Y''',
	'SELECT id FROM mc WHERE h = ''w'' AND g = ''E''',
	'SELECT id FROM mc WHERE h < ''X'''
]) AS t(q);
                          q                           | f2_same 
------------------------------------------------------+---------
 SELECT id FROM mc WHERE g = 'B'                      | same
 SELECT id FROM mc WHERE g = 'b'                      | same
 SELECT id FROM mc WHERE g > 'b'                      | same
 SELECT id FROM mc WHERE g BETWEEN 'a' AND 'c'        | same
 SELECT id FROM mc WHERE g < 'D' COLLATE "C"          | same
 SELECT id FROM mc WHERE g >= 'c' COLLATE "und-x-icu" | same
 SELECT id FROM mc WHERE g LIKE 'B%'                  | same
 SELECT id FROM mc WHERE g LIKE 'b%' COLLATE "C"      | same
 SELECT id FROM mc WHERE g = 'b' COLLATE mk_nd        | same
 SELECT id FROM mc WHERE g > 'b' COLLATE mk_nd        | same
 SELECT id FROM mc WHERE g IN ('a', 'Z')              | same
 SELECT id FROM mc WHERE g = 'B' AND h > 'W'          | same
 SELECT id FROM mc WHERE g > 'b' AND h = 'Y'          | same
 SELECT id FROM mc WHERE h = 'w' AND g = 'E'          | same
 SELECT id FROM mc WHERE h < 'X'                      | same
(15 rows)

-- The marks add no setting
SELECT count(*) AS settings FROM pg_settings WHERE name ~ '^sift\.(key_marks|col_stats|lazy|read_ahead)';
 settings 
----------
        0
(1 row)

DROP TABLE mk, mkd, mku, mkj, mt, mtn, mc, after_writes, after_text_writes;
DROP COLLATION mk_nd;
DROP FUNCTION f2_same(text), idx_blocks(text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
