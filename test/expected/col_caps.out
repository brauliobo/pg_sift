-- The caps of the options, told at CREATE INDEX: a cube(...) dim has no histogram in a unit with more groups than its cap, a key_columns leaf keeps a
-- bloom filter, not its keys, in a unit with more than 32 distinct ones and nothing where its keys are one value or fill their range, and no key list or
-- bitmap over 3% of the unit, a rollup_dims rollup is not written in a unit with too many cells, and calendar_columns = 'all' leaves out the
-- date columns past the 16 dimensions of the cube; a query on them scans those units, so the build says how many, and what to set.
SET max_parallel_maintenance_workers = 0;
SET max_parallel_workers_per_gather = 0;
SET statement_timeout = '60s';
CREATE EXTENSION pg_sift;
-- 100,000 rows in 3 units. few: 7 values; many: 50,000 values (more than the 4,096 groups of a cube dim in every unit); mid: 400 values, none next to another
-- (a bloom filter beyond 32 keys, and no gap-free range that a zone would tell); wide: 3,000 values
CREATE TABLE caps (id int, few int, many int, mid int, wide bigint) WITH (autovacuum_enabled = off);
INSERT INTO caps SELECT g, g % 7, (g * 7919) % 50000, ((g * 7919) % 400) * 3, ((g * 7919) % 3000) * 3 FROM generate_series(1, 100000) g;
-- a dim over its cap, and a summary of more than 32 keys that is a bloom filter
CREATE INDEX caps_a ON caps USING sift_col (id, few, many, wide) WITH (preagg = 'cube(few: id; many: id)', key_columns = 'wide', point_tid_columns = 'off');
NOTICE:  sift_col index caps_a: the cube dim "many" has no histogram in 100% of 3 units, which hold more than 4096 groups of it
DETAIL:  A query that groups or filters by it scans those units (sift.col_rollup_misses counts them).
HINT:  Group by a leaf with fewer values per unit, or sort the table by it before REINDEX.
-- the same for a column of 3,000 keys, alone
CREATE INDEX caps_b ON caps USING sift_col (id, few, wide) WITH (key_columns = 'wide', point_tid_columns = 'off');
NOTICE:  sift_col index caps_b: key_columns wrote no key list or bitmap of "wide" in 34% of 3 units, where it would take more than 3% of the bytes of the unit
DETAIL:  A count(DISTINCT) of the column scans those units; their keys are a bloom filter where there are more than 32, else exact or, where they fill their range, nothing.
HINT:  Leave "wide" out of key_columns, or sort the table by it before REINDEX.
-- the caps hold: nothing to tell (the 7 keys of few are a bitmap)
CREATE INDEX caps_c ON caps USING sift_col (id, few, many, mid) WITH (preagg = 'cube(few: id)', key_columns = 'few', point_tid_columns = 'off');
-- the default spec asks for no dim by name, and no set: silent
CREATE INDEX caps_d ON caps USING sift_col (id, few, many, mid) WITH (point_tid_columns = 'off');
-- no key list or bitmap of many (over 3% of the unit: a bloom filter instead), a rollup of more cells than a tenth of the rows
CREATE INDEX caps_e ON caps USING sift_col (id, few, many, mid) WITH (key_columns = 'few, many', rollup_dims = 'few, many', point_tid_columns = 'off');
NOTICE:  sift_col index caps_e: key_columns wrote no key list or bitmap of "many" in 100% of 3 units, where it would take more than 3% of the bytes of the unit
DETAIL:  A count(DISTINCT) of the column scans those units; their keys are a bloom filter where there are more than 32, else exact or, where they fill their range, nothing.
HINT:  Leave "many" out of key_columns, or sort the table by it before REINDEX.
NOTICE:  sift_col index caps_e: rollup_dims wrote no rollup of "few, many" in 100% of 3 units, which hold more combinations of them than a unit may keep
DETAIL:  A unit keeps at most a tenth of its rows as cells, and at most 4096; a query that groups by those columns scans the others.
HINT:  Name fewer columns, or columns with fewer values per unit.
-- what is written is silent: a bitmap that fits (few); the 2,800 combinations of a rollup fit two units and not the third, which holds fewer rows (34%)
CREATE INDEX caps_f ON caps USING sift_col (id, few, many, mid) WITH (key_columns = 'few', rollup_dims = 'few, mid', point_tid_columns = 'off');
NOTICE:  sift_col index caps_f: rollup_dims wrote no rollup of "few, mid" in 34% of 3 units, which hold more combinations of them than a unit may keep
DETAIL:  A unit keeps at most a tenth of its rows as cells, and at most 4096; a query that groups by those columns scans the others.
HINT:  Name fewer columns, or columns with fewer values per unit.
-- the cube holds 16 dimensions: the cells of the dates come first and the plain columns give way (the NOTICE names them); 'all' leaves date columns out only when the dates alone are more than 16
CREATE TABLE caps_cal (c1 int, c2 int, c3 int, c4 int, c5 int, c6 int, c7 int, c8 int, c9 int, c10 int, c11 int, c12 int, c13 int, c14 int, c15 int, c16 int, d1 date, d2 date) WITH (autovacuum_enabled = off);
INSERT INTO caps_cal SELECT g, g % 3, g % 4, g % 5, g % 6, g % 7, g % 8, g % 9, g % 3, g % 4, g % 5, g % 6, g % 7, g % 8, g % 9, g % 2, date '2024-01-01' + g % 30, date '2024-01-01' + g % 20 FROM generate_series(1, 5000) g;
CREATE INDEX caps_cal_all ON caps_cal USING sift_col (c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, d1, d2) WITH (calendar_columns = 'all');
NOTICE:  sift_col index caps_cal_all writes a rollup of the rows by c2, c9
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 3 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX caps_cal_all SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
NOTICE:  sift_col index caps_cal_all: the cube holds 16 dimensions and left out the histograms of 4 columns: "c15", "c16", "d1", "d2"
DETAIL:  The calendar cells of the date and timestamp columns come first and then the columns in their order; a query that groups or filters by those columns scans the units.
HINT:  Give preagg = 'cube(...)' the dimensions the queries group by (sift.index_advice lists the columns that qualify), or preagg = 'auto' to give them to the columns whose histograms fit.
-- the default is the same list
CREATE INDEX caps_cal_default ON caps_cal USING sift_col (c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, d1, d2);
NOTICE:  sift_col index caps_cal_default writes a rollup of the rows by c2, c9
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 3 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX caps_cal_default SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
NOTICE:  sift_col index caps_cal_default: the cube holds 16 dimensions and left out the histograms of 4 columns: "c15", "c16", "d1", "d2"
DETAIL:  The calendar cells of the date and timestamp columns come first and then the columns in their order; a query that groups or filters by those columns scans the units.
HINT:  Give preagg = 'cube(...)' the dimensions the queries group by (sift.index_advice lists the columns that qualify), or preagg = 'auto' to give them to the columns whose histograms fit.
-- the dates alone past the cap
CREATE TABLE caps_dates (d1 date, d2 date, d3 date, d4 date, d5 date, d6 date, d7 date, d8 date, d9 date, d10 date, d11 date, d12 date, d13 date, d14 date, d15 date, d16 date, d17 date) WITH (autovacuum_enabled = off);
INSERT INTO caps_dates SELECT date '2024-01-01' + g % 30, date '2024-01-01' + g % 20, date '2024-01-01' + g % 10, date '2024-01-01' + g % 9, date '2024-01-01' + g % 8, date '2024-01-01' + g % 7,
	date '2024-01-01' + g % 6, date '2024-01-01' + g % 5, date '2024-01-01' + g % 4, date '2024-01-01' + g % 3, date '2024-01-01' + g % 2, date '2024-01-01', date '2024-02-01' + g % 12, date '2024-03-01' + g % 13,
	date '2024-04-01' + g % 14, date '2024-05-01' + g % 15, date '2024-06-01' + g % 16 FROM generate_series(1, 5000) g;
CREATE INDEX caps_dates_all ON caps_dates USING sift_col (d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17);
NOTICE:  sift_col index caps_dates_all writes a rollup of the rows by d11, d12
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 2 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX caps_dates_all SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
NOTICE:  sift_col index caps_dates_all: the cube holds 16 dimensions and left out the histograms of 17 columns: "d1", "d2", "d3", "d4", "d5", "d6", "d7", "d8", "d9", "d10", "d11", "d12", "d13", "d14", "d15", "d16", "d17"
DETAIL:  The calendar cells of the date and timestamp columns come first and then the columns in their order; a query that groups or filters by those columns scans the units.
HINT:  Give preagg = 'cube(...)' the dimensions the queries group by (sift.index_advice lists the columns that qualify), or preagg = 'auto' to give them to the columns whose histograms fit.
NOTICE:  sift_col index caps_dates_all: the calendar cells of every date and timestamp column (calendar_columns = 'all', the default) left out 1 column: "d17"
DETAIL:  The cube holds at most 16 dimensions, and the other columns of the index take the rest; a query that groups by those dates scans the units.
HINT:  Name the columns the queries group by in calendar_columns (the list must fit the 16 dimensions), or give preagg = 'cube(...)' only the dims they need.
-- all of them fit
CREATE INDEX caps_cal_two ON caps_cal USING sift_col (c1, c2, d1, d2) WITH (calendar_columns = 'all');
NOTICE:  sift_col index caps_cal_two writes a rollup of the rows by c2, d1
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 30 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX caps_cal_two SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
-- off says nothing
ALTER INDEX caps_a SET (key_columns = 'off');
REINDEX INDEX caps_a;
NOTICE:  sift_col index caps_a: the cube dim "many" has no histogram in 100% of 3 units, which hold more than 4096 groups of it
DETAIL:  A query that groups or filters by it scans those units (sift.col_rollup_misses counts them).
HINT:  Group by a leaf with fewer values per unit, or sort the table by it before REINDEX.
-- a refresh tells the same, whether or not it rewrote a segment
ALTER INDEX caps_c SET (preagg = 'cube(few: id; many: id)');
SELECT * FROM sift.col_refresh('caps_c');
NOTICE:  sift_col index caps_c: the cube dim "many" has no histogram in 100% of 3 units, which hold more than 4096 groups of it
DETAIL:  A query that groups or filters by it scans those units (sift.col_rollup_misses counts them).
HINT:  Group by a leaf with fewer values per unit, or sort the table by it before REINDEX.
 refreshed | remaining 
-----------+-----------
         0 |         0
(1 row)

DROP TABLE caps, caps_cal, caps_dates;
DROP EXTENSION pg_sift;
