 count | count | sum  
-------+-------+------
     3 |     1 | 7515
(1 row)

SET sift.enable_agg = off;
SELECT count(*), count(DISTINCT uid), sum(id) FROM vd WHERE uid = md5('5')::uuid;
 count | count | sum  
-------+-------+------
     3 |     1 | 7515
(1 row)

RESET sift.enable_agg;
SELECT sift.col_verify('vd_g', true);
 col_verify 
------------
 
(1 row)

