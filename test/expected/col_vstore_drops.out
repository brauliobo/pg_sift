-- nobody can drop a store under a member, by its name or by the table
DROP TABLE vd_uid_sift_values;
ERROR:  cannot drop table vd_uid_sift_values because other objects depend on it
DETAIL:  index vd_f depends on table vd_uid_sift_values
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
DROP TABLE vd_url_sift_values;
ERROR:  cannot drop table vd_url_sift_values because other objects depend on it
DETAIL:  index vd_f depends on table vd_url_sift_values
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
SELECT * FROM vd_check('after the refused drops');
          step           | shapes | same 
-------------------------+--------+------
 after the refused drops |      9 |    9
(1 row)

-- a column that goes drops the indexes that hold it, and the stores that only they used; a member without it stays whole
CREATE INDEX vd_g ON vd USING sift_col (id, uid);
SELECT * FROM vd_state('a member of the uid only');
           step           |   stores    | values_same | vd_c 
--------------------------+-------------+-------------+------
 a member of the uid only | uid=2 url=1 | t           | -
(1 row)

