SELECT 'su_off' AS tbl, * FROM pa_sum('su_off') UNION ALL SELECT 'su_two', * FROM pa_sum('su_two') UNION ALL SELECT 'su_big', * FROM pa_sum('su_big')
UNION ALL SELECT 'su_old', * FROM pa_sum('su_old') ORDER BY 1;
