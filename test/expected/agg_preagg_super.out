-- 6. a parallel build lays the rows out in other units from run to run; whatever it does, the summaries agree with the units
SET max_parallel_maintenance_workers = 2;
SET min_parallel_table_scan_size = 0;
CREATE INDEX su_par_col ON su USING sift_col (id, kind, grp, val, small, amt, flt, d) WITH (write_buffer_limit = 4096, superunit = 3);
SELECT sift.col_verify('su_par_col', true);
 col_verify 
------------
 
(1 row)

DROP INDEX su_col;
SELECT queries, differ FROM pa_sum('su');
 queries | differ 
---------+--------
      20 |      0
(1 row)

RESET max_parallel_maintenance_workers;
-- the option is a number from 2 to 256, or 0
CREATE INDEX su_bad1 ON su USING sift_col (id, kind) WITH (superunit = 1);
ERROR:  superunit must be 0 or between 2 and 256
CREATE INDEX su_bad2 ON su USING sift_col (id, kind) WITH (superunit = 257);
ERROR:  value 257 out of bounds for option "superunit"
DETAIL:  Valid values are between "0" and "256".
CREATE INDEX su_bad3 ON su USING sift_col (id, kind) WITH (superunit = 'many');
ERROR:  invalid value for integer option "superunit": many
DROP TABLE su, su_off, su_two, su_big, su_old, pa_q;
DROP FUNCTION pa_rows(text, bool, bool, bool), pa_units(text), pa_check(text, int, int), pa_sum(text);
DROP PROCEDURE pa_settle();
DROP EXTENSION pg_sift;
