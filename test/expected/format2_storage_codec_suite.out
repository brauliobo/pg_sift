	SELECT p.part_id, p.key_lo, i.part_gen, i.header_blk, i.packed, i.slot, i.inline
	FROM sift._test_f2_partitions(idx) p, LATERAL sift._test_f2_pack_info(idx, p.part_id, p.key_lo) i $$;
