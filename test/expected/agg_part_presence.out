-- The key lists of the integer columns an index keeps in its units (key_columns = auto) follow the data of each partition: one partition keeps the
-- list of a column and its neighbour does not. That is no other layout: a unit without a list is read by its rows, so the table is one source and the
-- scan counts on the lists every partition keeps. The statements run with enable_agg on and off: the rows must be the same.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
SET seq_page_cost = 10000; SET random_page_cost = 10000;
CREATE TABLE pk (id int NOT NULL, g int NOT NULL, h int NOT NULL, v int NOT NULL) PARTITION BY RANGE (id);
CREATE TABLE pk_a PARTITION OF pk FOR VALUES FROM (0) TO (20000) WITH (autovacuum_enabled = false);
CREATE TABLE pk_b PARTITION OF pk FOR VALUES FROM (20000) TO (40000) WITH (autovacuum_enabled = false);
CREATE TABLE pk_c PARTITION OF pk FOR VALUES FROM (40000) TO (60000) WITH (autovacuum_enabled = false);
INSERT INTO pk SELECT i, ((i::bigint * 7919) % 300)::int, ((i::bigint * 104729) % 40)::int, i % 17 FROM generate_series(0, 59999) i;
CREATE INDEX pk_col ON pk USING sift_col (id, g, h, v) WITH (key_columns = 'g, h');
NOTICE:  sift_col index pk_a_id_g_h_v_idx writes a rollup of the rows by h, v
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 680 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX pk_a_id_g_h_v_idx SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
NOTICE:  sift_col index pk_b_id_g_h_v_idx writes a rollup of the rows by h, v
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 680 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX pk_b_id_g_h_v_idx SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
NOTICE:  sift_col index pk_c_id_g_h_v_idx writes a rollup of the rows by h, v
DETAIL:  A GROUP BY or a filter of both columns is read from the cells of each unit. Their combinations fit the cells a unit may keep (a tenth of its rows, at most 4096) in at least 90% of 1 sampled stretches of about a unit, about 680 of them a unit; the cells add to the index and to its build.
HINT:  ALTER INDEX pk_c_id_g_h_v_idx SET (rollup_dims = 'off'), then REINDEX, drops it; rollup_dims = 'a, b: measure' names the columns.
VACUUM (FREEZE, ANALYZE) pk;
CREATE FUNCTION differences(q text) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE d bigint;
BEGIN
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS %s', q);
	SET LOCAL sift.enable_agg = on;
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS %s', q);
	SELECT count(*) INTO d FROM ((TABLE r_on EXCEPT ALL TABLE r_off) UNION ALL (TABLE r_off EXCEPT ALL TABLE r_on)) x;
	DROP TABLE r_on, r_off;
	RETURN d;
END $$;
CREATE FUNCTION why(q text) RETURNS text LANGUAGE sql AS $$ SELECT CASE WHEN bool_or(used) THEN 'scan' ELSE max(slug) END FROM sift.explain_why(q) $$;
CREATE TABLE queries (name text, q text);
INSERT INTO queries VALUES
	('distinct g', 'SELECT h % 4 AS k, count(DISTINCT g) AS n, sum(v) AS s FROM pk GROUP BY 1'),
	('distinct h', 'SELECT g % 4 AS k, count(DISTINCT h) AS n FROM pk GROUP BY 1'),
	('plain', 'SELECT v, count(*) AS n FROM pk GROUP BY 1');
SELECT name, why(q) AS plan, differences(q) AS differences FROM queries ORDER BY name;
    name    | plan | differences 
------------+------+-------------
 distinct g | scan |           0
 distinct h | scan |           0
 plain      | scan |           0
(3 rows)

-- one partition keeps no list: the same statements
DO $$
DECLARE ix regclass;
BEGIN
	SELECT i.indexrelid::regclass INTO ix FROM pg_index i WHERE i.indrelid = 'pk_b'::regclass;
	EXECUTE format('ALTER INDEX %s SET (key_columns = ''off'')', ix);
	EXECUTE format('REINDEX INDEX %s', ix);
END $$;
VACUUM (FREEZE, ANALYZE) pk;
SELECT name, why(q) AS plan, differences(q) AS differences FROM queries ORDER BY name;
    name    | plan | differences 
------------+------+-------------
 distinct g | scan |           0
 distinct h | scan |           0
 plain      | scan |           0
(3 rows)

-- and one that keeps the list of another column
DO $$
DECLARE ix regclass;
BEGIN
	SELECT i.indexrelid::regclass INTO ix FROM pg_index i WHERE i.indrelid = 'pk_c'::regclass;
	EXECUTE format('ALTER INDEX %s SET (key_columns = ''g'')', ix);
	EXECUTE format('REINDEX INDEX %s', ix);
END $$;
VACUUM (FREEZE, ANALYZE) pk;
SELECT name, why(q) AS plan, differences(q) AS differences FROM queries ORDER BY name;
    name    | plan | differences 
------------+------+-------------
 distinct g | scan |           0
 distinct h | scan |           0
 plain      | scan |           0
(3 rows)

DROP TABLE queries;
DROP FUNCTION why(text), differences(text);
DROP TABLE pk;
DROP EXTENSION pg_sift;
