-- jsonb_typeof(path) = 'type' pushed into the aggregate scan under forced parallel plans: each query must plan as a Gather over a partial Custom
-- Scan (SiftAgg) with two workers, and its rows must be the rows of the normal plan. mode: parallel (Gather over SiftAgg), serial (SiftAgg alone),
-- none (the normal plan). The workers filter their units by type as the leader does; a value a selected row holds that the leaf cannot store
-- raises in a worker as it does in the leader.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
CREATE TABLE p_t (id int, grp int, attrs jsonb) WITH (fillfactor = 10, autovacuum_enabled = false);
INSERT INTO p_t
SELECT i, i % 7,
       CASE i % 13 WHEN 0 THEN jsonb_build_object('m', 'str' || i, 'n', 'x', 's', i, 'b', 1)
                   WHEN 1 THEN '{"m": true, "n": null, "s": true, "b": "no"}'
                   WHEN 2 THEN '{"m": {"a": 1}, "n": [], "s": {"a": 1}, "b": []}'
                   WHEN 3 THEN '{}'
                   ELSE jsonb_build_object('m', (i * 7919) % 8000 / 8.0, 'n', i % 500, 's', 'v' || i % 40, 'b', i % 3 = 0) END
FROM generate_series(1, 20000) i;
CREATE INDEX p_col ON p_t USING sift_col (id, grp, attrs) WITH (paths = 'attrs.m float8, attrs.n int4, attrs.s text, attrs.b bool');
VACUUM ANALYZE p_t;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET min_parallel_index_scan_size = 0;
SET max_parallel_workers_per_gather = 2;
SET seq_page_cost = 10000;
CREATE FUNCTION p_rows(q text, push bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('sift.enable_agg', push::text, true);
	EXECUTE format('SELECT string_agg(x::text, E''\n'' ORDER BY x::text) FROM (%s) x', q) INTO r;
	RETURN r;
END $$;
CREATE FUNCTION p_mode(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; gather bool := false; agg bool := false;
BEGIN
	PERFORM set_config('sift.enable_agg', 'on', true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		gather := gather OR l LIKE '%Workers Planned: 2%';
		agg := agg OR l LIKE '%Custom Scan (SiftAgg)%';
	END LOOP;
	RETURN CASE WHEN agg AND gather THEN 'parallel' WHEN agg THEN 'serial' ELSE 'none' END;
END $$;
-- how a query ends: its rows (as a hash) or the error
CREATE FUNCTION p_outcome(q text, push bool) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	RETURN 'rows ' || md5(p_rows(q, push));
EXCEPTION WHEN OTHERS THEN
	RETURN 'error ' || SQLSTATE;
END $$;
CREATE TABLE p_q (n serial, q text);
INSERT INTO p_q (q) VALUES
	('SELECT count(*), sum((attrs->>''m'')::float8) FROM p_t WHERE jsonb_typeof(attrs->''m'') = ''number'''),
	('SELECT grp, count(*), sum((attrs->>''m'')::float8) FROM p_t WHERE jsonb_typeof(attrs->''m'') = ''number'' GROUP BY grp'),
	('SELECT grp, count(*), max((attrs->>''n'')::int) FROM p_t WHERE jsonb_typeof(attrs->''n'') = ''number'' GROUP BY grp'),
	('SELECT count(*), count(DISTINCT attrs->>''s'') FROM p_t WHERE jsonb_typeof(attrs->''s'') = ''string'''),
	('SELECT grp, count(*) FILTER (WHERE (attrs->>''b'')::bool) FROM p_t WHERE jsonb_typeof(attrs->''b'') = ''boolean'' GROUP BY grp'),
	('SELECT count(*), sum((attrs->>''m'')::float8) FROM p_t WHERE jsonb_typeof(attrs->''m'') IN (''number'') AND jsonb_typeof(attrs->''n'') = ''number'' AND id > 4000'),
	-- selects values the leaf cannot hold: the error is the same in every process
	('SELECT count(*) FROM p_t WHERE jsonb_typeof(attrs->''m'') = ''string'''),
	('SELECT count(*) FROM p_t WHERE jsonb_typeof(attrs->''s'') = ''number''');
CREATE FUNCTION p_compare(OUT n int, OUT mode text, OUT same text) RETURNS SETOF record LANGUAGE plpgsql AS $$
DECLARE q text; a text; b text;
BEGIN
	FOR n, q IN SELECT p_q.n, p_q.q FROM p_q ORDER BY p_q.n LOOP
		mode := p_mode(q);
		a := p_outcome(q, true);
		b := p_outcome(q, false);
		same := CASE WHEN a = b THEN 'same' ELSE 'pushed: ' || a || '; normal: ' || b END;
		RETURN NEXT;
	END LOOP;
END $$;
SELECT n, mode, same FROM p_compare();
 n |   mode   |                                same                                
---+----------+--------------------------------------------------------------------
 1 | parallel | same
 2 | parallel | same
 3 | parallel | same
 4 | parallel | same
 5 | parallel | same
 6 | parallel | same
 7 | parallel | pushed: error 0A000; normal: rows 3c5a04c882ba089c7041f5f0a61ed2cd
 8 | parallel | pushed: error 0A000; normal: rows 3c5a04c882ba089c7041f5f0a61ed2cd
(8 rows)

DROP TABLE p_t, p_q;
DROP FUNCTION p_rows(text, bool), p_mode(text), p_outcome(text, bool), p_compare();
DROP EXTENSION pg_sift;
