-- The automatic rewrite of an index waits as long again as the last one took (sift.col_auto_rewrite_backoff) and does not start a step over sift.col_auto_rewrite_max_size;
-- sift.col_maintain is held by neither, and the file does not grow by a copy for each rewrite.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
SET client_min_messages = warning;
CREATE TABLE dim_a (id int PRIMARY KEY, name text, score int) WITH (autovacuum_enabled = false);
INSERT INTO dim_a SELECT i, 'p' || i, i % 100 FROM generate_series(1, 20000) i;
CREATE INDEX dim_a_col ON dim_a USING sift_col (id, name, score) WITH (track_changes = 'id');
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, amount int, body text) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, 1 + (i * 7919) % 22000, i % 5, md5(i::text) FROM generate_series(1, 150000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, amount, body) WITH (track_changes = 'id', connect = 'dim_a_id -> dim_a(id)');
VACUUM dim_a, facts;
SELECT sift.col_maintain('facts_col') AS filled;
 filled 
--------
 t
(1 row)

SELECT sum(bytes) > 1024 * 1024 AS over_a_megabyte FROM sift.col_segments('facts_col');
 over_a_megabyte 
-----------------
 t
(1 row)

CREATE FUNCTION newest_gen() RETURNS bigint LANGUAGE sql AS $$ SELECT max(gen) FROM sift.col_segments('facts_col') $$;
CREATE FUNCTION held() RETURNS bool LANGUAGE sql AS $$
	SELECT coalesce(bool_or(b LIKE 'the last automatic rewrite holds the next one off until %'), false)
	FROM sift.col_maintenance_status('facts_col'), unnest(blocked_by) b
$$;
-- a rebuild of the parent index makes every stamp of the child old: the child is due again after each rewrite, as it is when a rewrite outlasts the changes it was started for
CREATE TABLE rounds (kind text, round int, steps int);
SET sift.col_auto_rewrite_backoff = 0;
\o /dev/null
SELECT s FROM generate_series(1, 5) r, LATERAL unnest(ARRAY[
	'REINDEX INDEX dim_a_col',
	format('INSERT INTO rounds SELECT ''no wait'', %s, sift._test_col_auto_rewrite(''facts_col'')', r)]) WITH ORDINALITY u(s, o) ORDER BY r, o \gexec
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'no wait', 1, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'no wait', 2, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'no wait', 3, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'no wait', 4, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'no wait', 5, sift._test_col_auto_rewrite('facts_col')
\o
SELECT held() AS held_without_wait;
 held_without_wait 
-------------------
 f
(1 row)

REINDEX INDEX facts_col;
SET sift.col_auto_rewrite_backoff = 1000000;
\o /dev/null
SELECT s FROM generate_series(1, 5) r, LATERAL unnest(ARRAY[
	'REINDEX INDEX dim_a_col',
	format('INSERT INTO rounds SELECT ''wait'', %s, sift._test_col_auto_rewrite(''facts_col'')', r)]) WITH ORDINALITY u(s, o) ORDER BY r, o \gexec
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'wait', 1, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'wait', 2, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'wait', 3, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'wait', 4, sift._test_col_auto_rewrite('facts_col')
REINDEX INDEX dim_a_col
INSERT INTO rounds SELECT 'wait', 5, sift._test_col_auto_rewrite('facts_col')
\o
SELECT kind, count(*) FILTER (WHERE steps > 0) AS rewrites, count(*) AS rounds FROM rounds GROUP BY kind ORDER BY kind;
  kind   | rewrites | rounds 
---------+----------+--------
 no wait |        5 |      5
 wait    |        1 |      5
(2 rows)

-- the reason is still due, the server's own rule holds it off and says so, and a call of the operator does not wait
SELECT sift.col_maintenance_due('facts_col', true) AS automatic_due, sift.col_maintenance_due('facts_col', false) AS due, held() AS held;
 automatic_due |       due        | held 
---------------+------------------+------
               | stale connection | t
(1 row)

SELECT newest_gen() AS gen \gset
SELECT sift._test_col_auto_rewrite('facts_col') AS steps, newest_gen() = :gen AS unchanged;
 steps | unchanged 
-------+-----------
    -1 | t
(1 row)

SELECT sift.col_maintain('facts_col') AS maintained, newest_gen() > :gen AS rewritten;
 maintained | rewritten 
------------+-----------
 t          | t
(1 row)

SELECT sift.col_maintenance_due('facts_col', false) AS due_after;
 due_after 
-----------
 
(1 row)

-- a step over the size is not started, whatever is due, and the automatic rewrite looks again in an hour
REINDEX INDEX facts_col;
REINDEX INDEX dim_a_col;
SET sift.col_auto_rewrite_backoff = 10;
SET sift.col_auto_rewrite_max_size = 1;
SELECT sift.col_maintenance_due('facts_col', true) AS automatic_due, held() AS held;
  automatic_due   | held 
------------------+------
 stale connection | f
(1 row)

SELECT newest_gen() AS gen \gset
SELECT sift._test_col_auto_rewrite('facts_col') AS steps, newest_gen() = :gen AS unchanged;
 steps | unchanged 
-------+-----------
     0 | t
(1 row)

SELECT sift.col_maintenance_due('facts_col', true) AS automatic_due, sift.col_maintenance_due('facts_col', false) AS due, held() AS held;
 automatic_due |       due        | held 
---------------+------------------+------
               | stale connection | t
(1 row)

SELECT sift.col_maintain('facts_col') AS maintained, newest_gen() > :gen AS rewritten;
 maintained | rewritten 
------------+-----------
 t          | t
(1 row)

RESET sift.col_auto_rewrite_max_size;
-- rewrites that follow each other reuse the blocks the one before freed: the file is at most twice what the segments hold after each VACUUM, not a copy more for each rewrite
CREATE TABLE sizes (round int, blocks bigint, used bigint);
\o /dev/null
SELECT s FROM generate_series(1, 5) r, LATERAL unnest(ARRAY[
	'REINDEX INDEX dim_a_col',
	'SELECT sift.col_maintain(''facts_col'')',
	'VACUUM facts',
	format('INSERT INTO sizes SELECT %s, relation_blocks, used_blocks FROM sift.col_space(''facts_col'')', r)]) WITH ORDINALITY u(s, o) ORDER BY r, o \gexec
REINDEX INDEX dim_a_col
SELECT sift.col_maintain('facts_col')
VACUUM facts
INSERT INTO sizes SELECT 1, relation_blocks, used_blocks FROM sift.col_space('facts_col')
REINDEX INDEX dim_a_col
SELECT sift.col_maintain('facts_col')
VACUUM facts
INSERT INTO sizes SELECT 2, relation_blocks, used_blocks FROM sift.col_space('facts_col')
REINDEX INDEX dim_a_col
SELECT sift.col_maintain('facts_col')
VACUUM facts
INSERT INTO sizes SELECT 3, relation_blocks, used_blocks FROM sift.col_space('facts_col')
REINDEX INDEX dim_a_col
SELECT sift.col_maintain('facts_col')
VACUUM facts
INSERT INTO sizes SELECT 4, relation_blocks, used_blocks FROM sift.col_space('facts_col')
REINDEX INDEX dim_a_col
SELECT sift.col_maintain('facts_col')
VACUUM facts
INSERT INTO sizes SELECT 5, relation_blocks, used_blocks FROM sift.col_space('facts_col')
\o
SELECT count(*) AS rounds, max(blocks::float8 / used) <= 2.1 AS file_within_twice FROM sizes;
 rounds | file_within_twice 
--------+-------------------
      5 | t
(1 row)

DROP FUNCTION held(), newest_gen();
DROP TABLE sizes, rounds, facts, dim_a CASCADE;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
