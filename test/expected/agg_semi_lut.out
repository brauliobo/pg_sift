-- from workers: each builds its table
ALTER TABLE ev SET (parallel_workers = 2);
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET max_parallel_workers_per_gather = 2;
SELECT * FROM same($$SELECT kind, count(*) AS n, sum(amount) AS s FROM ev WHERE entity_id IN (SELECT entity_id FROM members WHERE group_id = 8) GROUP BY kind$$);
                plan                | result_rows | vs_generic_join | vs_normal_plan 
------------------------------------+-------------+-----------------+----------------
 SiftAgg with workers semi tables 1 |           4 |               0 |              0
(1 row)

SELECT * FROM same($$SELECT kind, count(*) AS n FROM ev WHERE NOT EXISTS (SELECT 1 FROM dims d WHERE d.id = ev.entity_id AND d.country < 30) GROUP BY kind$$);
                plan                | result_rows | vs_generic_join | vs_normal_plan 
------------------------------------+-------------+-----------------+----------------
 SiftAgg with workers semi tables 1 |           4 |               0 |              0
(1 row)

RESET max_parallel_workers_per_gather;
RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET min_parallel_table_scan_size;
ALTER TABLE ev RESET (parallel_workers);
-- a rescan (the inner side of a nested loop) replays the same groups; a prepared statement with the parameter in the subquery, custom and generic
SET enable_material = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SELECT plan_of($$SELECT g, count(*) AS n FROM generate_series(1, 3) g CROSS JOIN LATERAL (SELECT kind FROM ev WHERE entity_id IN (SELECT entity_id FROM members WHERE group_id = 2) GROUP BY kind) k GROUP BY g ORDER BY g$$) AS rescanned;
       rescanned       
-----------------------
 SiftAgg semi tables 1
(1 row)

SELECT g, count(*) AS n FROM generate_series(1, 3) g CROSS JOIN LATERAL (SELECT kind FROM ev WHERE entity_id IN (SELECT entity_id FROM members WHERE group_id = 2) GROUP BY kind) k GROUP BY g ORDER BY g;
 g | n 
---+---
 1 | 4
 2 | 4
 3 | 4
(3 rows)

RESET enable_material;
RESET enable_hashjoin;
RESET enable_mergejoin;
PREPARE by_group(int) AS SELECT kind, count(*) AS n FROM ev WHERE entity_id IN (SELECT entity_id FROM members WHERE group_id = $1) GROUP BY kind ORDER BY kind;
CREATE FUNCTION same_group(g int) RETURNS TABLE (result_rows bigint, vs_generic_join bigint) LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS EXECUTE by_group(%s)', g);
	SET LOCAL sift.agg_semi_lut = off;
	EXECUTE format('CREATE TEMP TABLE r_gen ON COMMIT DROP AS EXECUTE by_group(%s)', g);
	RESET sift.agg_semi_lut;
	result_rows := (SELECT count(*) FROM r_on);
	vs_generic_join := (SELECT count(*) FROM ((TABLE r_on EXCEPT TABLE r_gen) UNION ALL (TABLE r_gen EXCEPT TABLE r_on)) d);
	DROP TABLE r_on, r_gen;
	RETURN NEXT;
END $$;
SET plan_cache_mode = force_custom_plan;
SELECT plan_of('EXECUTE by_group(2)') AS custom;
        custom         
-----------------------
 SiftAgg semi tables 1
(1 row)

SELECT * FROM same_group(2);
 result_rows | vs_generic_join 
-------------+-----------------
           4 |               0
(1 row)

SET plan_cache_mode = force_generic_plan;
SELECT plan_of('EXECUTE by_group(2)') AS generic;
        generic        
-----------------------
 SiftAgg semi tables 1
(1 row)

SELECT * FROM same_group(2);
 result_rows | vs_generic_join 
-------------+-----------------
           4 |               0
(1 row)

SELECT * FROM same_group(7);
 result_rows | vs_generic_join 
-------------+-----------------
           4 |               0
(1 row)

RESET plan_cache_mode;
-- the table is read under the snapshot of the scan: this transaction's own deletes, inserts and updates of the membership table
BEGIN;
DELETE FROM members WHERE group_id = 5 AND entity_id % 2 = 0;
INSERT INTO members SELECT 5, 20000 + i, NULL FROM generate_series(1, 300) i;
UPDATE members SET deleted_at = now() WHERE group_id = 3 AND entity_id < 100;
SELECT * FROM same($$SELECT kind, count(*) AS n FROM ev WHERE entity_id IN (SELECT entity_id FROM members WHERE group_id IN (3, 5) AND deleted_at IS NULL) GROUP BY kind$$);
         plan          | result_rows | vs_generic_join | vs_normal_plan 
-----------------------+-------------+-----------------+----------------
 SiftAgg semi tables 1 |           4 |               0 |              0
(1 row)

ROLLBACK;
DEALLOCATE ALL;
DROP FUNCTION same_group(int);
DROP FUNCTION same(text);
DROP FUNCTION plan_of(text);
DROP TABLE ev, members, dims, codes, holidays, members8, members_nn, nothing, sparse;
DROP EXTENSION pg_sift;
