-- two semi joins and an anti join in one query, and with the filters of the leaves
SELECT * FROM same($$SELECT kind, count(*) AS n, sum(amount) AS s FROM ev WHERE day >= '2024-06-01' AND small_id < 40
	AND entity_id IN (SELECT entity_id FROM members WHERE group_id = 6) AND entity_id IN (SELECT id FROM dims WHERE country < 40)
	AND NOT EXISTS (SELECT 1 FROM members_nn x WHERE x.entity_id = ev.entity_id) GROUP BY kind$$);
         plan          | result_rows | vs_generic_join | vs_normal_plan 
-----------------------+-------------+-----------------+----------------
 SiftAgg semi tables 3 |           4 |               0 |              0
(1 row)

