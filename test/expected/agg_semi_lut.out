-- the span of the keys is bounded by sift.agg_semi_lut_size: wider keys keep the generic join, the answer is the same
SELECT plan_of($$SELECT count(*) FROM ev WHERE entity_id IN (SELECT entity_id FROM sparse)$$) AS span_3m_default;
    span_3m_default    
