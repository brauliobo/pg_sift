-- Format 2.0 sift_table parity: every check raises on failure and prints one row (name, ok); a clean run prints only ok rows.
-- About 15 s. Run on a build where new tables take Format 2.0 (sift.test_create_format1 off) except in section 12, which makes a Format 1 table.
CREATE EXTENSION IF NOT EXISTS pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE EXTENSION IF NOT EXISTS pageinspect;
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET statement_timeout = '240s';
CREATE SCHEMA f2p;
SET search_path = f2p, public;
CREATE FUNCTION chk(name text, got anyelement, want anyelement) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	IF got IS DISTINCT FROM want THEN RAISE EXCEPTION 'FAILED %: got %, want %', name, got, want; END IF;
	RETURN name || ': ok';
END $$;
CREATE FUNCTION fails(stmt text, state text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE stmt;
	RAISE EXCEPTION 'FAILED: % did not raise %', stmt, state;
EXCEPTION WHEN OTHERS THEN
	IF SQLSTATE <> state THEN RAISE EXCEPTION 'FAILED: % raised % (%), want %', stmt, SQLSTATE, SQLERRM, state; END IF;
	RETURN state || ': ok';
END $$;
CREATE FUNCTION format_major(rel regclass) RETURNS int LANGUAGE sql AS $$
	SELECT (get_byte(page, 28) + 256 * get_byte(page, 29))::int FROM (SELECT get_raw_page(rel::text, 0) AS page) p $$;
-- 1. CRUD
CREATE TABLE t (id int PRIMARY KEY, g int, v numeric(10,2), s text, ts timestamptz) USING sift_table;
INSERT INTO t SELECT i, i % 10, i / 4.0, 'row ' || i, timestamptz '2024-01-01' + i * interval '1 minute' FROM generate_series(1, 20000) i;
SELECT chk('insert count', count(*)::int, 20000) FROM t;
       chk        
------------------
 insert count: ok
(1 row)

SELECT chk('insert sum', sum(v), (SELECT sum(i / 4.0) FROM generate_series(1, 20000) i)::numeric) FROM t;
      chk       
----------------
 insert sum: ok
(1 row)

UPDATE t SET v = v + 1, s = s || '!' WHERE g = 3;
SELECT chk('update rows', count(*)::int, 2000) FROM t WHERE s LIKE '%!';
       chk       
-----------------
 update rows: ok
(1 row)

SELECT chk('update value', v, 13 / 4.0 + 1) FROM t WHERE id = 13;
       chk        
------------------
 update value: ok
(1 row)

DELETE FROM t WHERE g = 7;
SELECT chk('delete count', count(*)::int, 18000) FROM t;
       chk        
------------------
 delete count: ok
(1 row)

SELECT chk('deleted gone', count(*)::int, 0) FROM t WHERE g = 7;
       chk        
------------------
 deleted gone: ok
(1 row)

SELECT chk('pk probe', s, 'row 5') FROM t WHERE id = 5;
     chk      
--------------
 pk probe: ok
(1 row)

SELECT chk('pk probe of a deleted row', count(*)::int, 0) FROM t WHERE id = 7;
              chk              
-------------------------------
 pk probe of a deleted row: ok
(1 row)

SELECT chk('format major', format_major('t'), 2);
       chk        
------------------
 format major: ok
(1 row)

SELECT chk('ctid is virtual', (SELECT count(*)::int FROM t WHERE ctid = (SELECT ctid FROM t WHERE id = 5)), 1);
         chk         
---------------------
 ctid is virtual: ok
(1 row)

SELECT chk('tid range', (SELECT count(*)::int FROM t WHERE ctid >= '(0,1)' AND ctid < '(1,1)') BETWEEN 1 AND 291, true);
      chk      
---------------
 tid range: ok
(1 row)

SELECT chk('tablesample', (SELECT count(*) FROM t TABLESAMPLE SYSTEM (100)) = 18000, true);
       chk       
-----------------
 tablesample: ok
(1 row)

-- 2. MVCC: rollback, repeatable read, read committed, subtransactions
BEGIN;
INSERT INTO t VALUES (100001, 1, 1, 'rolled back', now());
UPDATE t SET v = -1 WHERE id = 1;
DELETE FROM t WHERE id = 2;
ROLLBACK;
SELECT chk('rollback insert', count(*)::int, 0) FROM t WHERE id = 100001;
         chk         
---------------------
 rollback insert: ok
(1 row)

SELECT chk('rollback update', v <> -1, true) FROM t WHERE id = 1;
         chk         
---------------------
 rollback update: ok
(1 row)

SELECT chk('rollback delete', count(*)::int, 1) FROM t WHERE id = 2;
         chk         
---------------------
 rollback delete: ok
(1 row)

BEGIN;
SAVEPOINT a;
DELETE FROM t WHERE id = 3;
ROLLBACK TO a;
SELECT chk('rollback to savepoint', count(*)::int, 1) FROM t WHERE id = 3;
            chk            
---------------------------
 rollback to savepoint: ok
(1 row)

SAVEPOINT b;
INSERT INTO t VALUES (100002, 1, 1, 'kept', now());
RELEASE b;
COMMIT;
SELECT chk('release savepoint', count(*)::int, 1) FROM t WHERE id = 100002;
          chk          
-----------------------
 release savepoint: ok
(1 row)

BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT count(*) FROM t \gset before_
INSERT INTO t VALUES (100003, 1, 1, 'inside', now());
SELECT chk('own insert visible', count(*)::int, :before_count + 1) FROM t;
          chk           
------------------------
 own insert visible: ok
(1 row)

ROLLBACK;
SELECT chk('own insert rolled back', count(*)::int, :before_count) FROM t;
            chk             
----------------------------
 own insert rolled back: ok
(1 row)

BEGIN;
DECLARE c CURSOR FOR SELECT id FROM t WHERE id <= 3 ORDER BY id;
UPDATE t SET v = 0 WHERE id <= 3;
SELECT chk('cursor snapshot', (SELECT count(*)::int FROM t WHERE id <= 3 AND v = 0), 3);
         chk         
---------------------
 cursor snapshot: ok
(1 row)

FETCH ALL FROM c;
 id 
----
  1
  2
  3
(3 rows)

ROLLBACK;
