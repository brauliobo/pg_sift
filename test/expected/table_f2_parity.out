-- 10. VACUUM FREEZE advances relfrozenxid; index cleanup; VACUUM (TRUNCATE) keeps the rows
CREATE TABLE vf (id int PRIMARY KEY, v int) USING sift_table;
INSERT INTO vf SELECT i, i FROM generate_series(1, 8000) i;
SELECT age(relfrozenxid) AS age0 FROM pg_class WHERE oid = 'vf'::regclass \gset
DELETE FROM vf WHERE id % 2 = 0;
VACUUM (FREEZE, INDEX_CLEANUP ON, VERBOSE OFF) vf;
SELECT chk('freeze relfrozenxid advanced', age(relfrozenxid) <= :age0 + 1, true) FROM pg_class WHERE oid = 'vf'::regclass;
               chk                
----------------------------------
 freeze relfrozenxid advanced: ok
(1 row)

SELECT chk('freeze rows', (count(*)::int, sum(v)::bigint), (4000, (SELECT sum(i) FROM generate_series(1, 7999, 2) i))) FROM vf;
       chk       
-----------------
 freeze rows: ok
(1 row)

SELECT chk('vacuum drops the index entries of dead rows', (SELECT count(*)::int FROM vf WHERE id = 2), 0);
                       chk                       
-------------------------------------------------
 vacuum drops the index entries of dead rows: ok
(1 row)

SET enable_seqscan = off;
SELECT chk('index after vacuum', (SELECT count(*)::int FROM vf WHERE id BETWEEN 1 AND 100), 50);
          chk           
------------------------
 index after vacuum: ok
(1 row)

RESET enable_seqscan;
DELETE FROM vf WHERE id > 100;
VACUUM (TRUNCATE ON) vf;
SELECT chk('rows after tail', count(*)::int, 50) FROM vf;
