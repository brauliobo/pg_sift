-- 16. Virtual generated columns (PostgreSQL 18) hold no value in the table (EXT-12)
SELECT current_setting('server_version_num')::int >= 180000 AS pg18 \gset
\if :pg18
CREATE TABLE gv (id int PRIMARY KEY, a int, v int GENERATED ALWAYS AS (a * 2) VIRTUAL, s text, ts timestamptz) USING sift_table;
INSERT INTO gv (id, a, s, ts) SELECT i, i, 'r' || i, now() FROM generate_series(1, 5000) i;
SELECT chk('virtual column evaluates', (sum(v), count(*) FILTER (WHERE v = a * 2)::int), (25005000::bigint, 5000)) FROM gv;
             chk              
------------------------------
 virtual column evaluates: ok
(1 row)

UPDATE gv SET a = a + 1 WHERE id <= 100;
SELECT chk('virtual column follows update', v, 22) FROM gv WHERE id = 10;
                chk                
-----------------------------------
 virtual column follows update: ok
(1 row)

ALTER TABLE gv ADD COLUMN w int GENERATED ALWAYS AS (a + 100) VIRTUAL;
ALTER TABLE gv ADD COLUMN k int DEFAULT 5;
SELECT chk('virtual column added later', (count(*) FILTER (WHERE w = a + 100)::int, count(*) FILTER (WHERE k = 5)::int), (5000, 5000)) FROM gv;
              chk               
--------------------------------
 virtual column added later: ok
(1 row)

ALTER TABLE gv DROP COLUMN v;
VACUUM gv;
SELECT chk('after drop and vacuum', (count(*)::int, sum(w)::bigint), (5000, 13002600::bigint)) FROM gv;
            chk            
---------------------------
 after drop and vacuum: ok
(1 row)

\endif
-- 17. A lookup by address finds its row among many parts: one part for each batch of a hundred rows
CREATE TABLE lp (id int PRIMARY KEY, v int) USING sift_table;
DO $$ BEGIN FOR i IN 0..39 LOOP INSERT INTO lp SELECT i * 100 + n, n FROM generate_series(1, 100) n; COMMIT; END LOOP; END $$;
SELECT chk('probe every batch', (SELECT count(*)::int FROM generate_series(0, 39) i, LATERAL (SELECT 1 FROM lp WHERE id = i * 100 + 50) x), 40);
          chk          
-----------------------
 probe every batch: ok
(1 row)

UPDATE lp SET v = -v WHERE id % 100 = 50;
SELECT chk('update every batch', count(*)::int, 40) FROM lp WHERE v = -50;
          chk           
------------------------
 update every batch: ok
(1 row)

SELECT chk('read an empty stage', count(*)::int, 4000) FROM lp;
           chk           
-------------------------
 read an empty stage: ok
(1 row)

