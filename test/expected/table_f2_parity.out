----------------------
 attach partition: ok
(1 row)

DROP TABLE pub_part;
DROP TABLE pub;
DROP PUBLICATION f2p_all;
-- 13. sift.upgrade_table(regclass) RETURNS bool: a Format 1 table becomes Format 2.0 with its rows, indexes and options; false (and a notice) when there is nothing to do; MAINTAIN is the right
SET sift.test_create_format1 = on;
CREATE TABLE up (id int PRIMARY KEY, g int, s text, ts timestamptz) USING sift_table;
INSERT INTO up SELECT i, i % 7, repeat('u', i % 50), timestamptz '2024-01-01' + i * interval '1 second' FROM generate_series(1, 40000) i;
SET sift.test_create_format1 = off;
UPDATE up SET s = 'upd' WHERE id <= 100;
DELETE FROM up WHERE id > 39000;
CREATE INDEX up_g ON up (g);
SELECT sift.table_set_option('up', 'key_order', 'ts');
 table_set_option 
------------------
 
(1 row)

SELECT chk('before upgrade', format_major('up'), 1);
        chk         
--------------------
 before upgrade: ok
(1 row)

SELECT count(*), sum(id), md5(string_agg(s, ',' ORDER BY id)) FROM up \gset up0_
SELECT pg_relation_filenode('up') AS fn_up \gset
SELECT chk('upgrade result', sift.upgrade_table('up'), true);
        chk         
--------------------
 upgrade result: ok
(1 row)

SELECT chk('after upgrade', format_major('up'), 2);
        chk        
-------------------
 after upgrade: ok
(1 row)

SELECT chk('upgrade swapped the file', pg_relation_filenode('up') <> :fn_up, true);
             chk              
------------------------------
 upgrade swapped the file: ok
(1 row)

SELECT chk('upgrade count', count(*)::int, :up0_count::int) FROM up;
        chk        
-------------------
 upgrade count: ok
(1 row)

SELECT chk('upgrade sum', sum(id)::numeric, :up0_sum::numeric) FROM up;
       chk       
-----------------
 upgrade sum: ok
(1 row)

SELECT chk('upgrade content', md5(string_agg(s, ',' ORDER BY id)), :'up0_md5') FROM up;
         chk         
---------------------
 upgrade content: ok
(1 row)

SELECT chk('upgrade keeps the indexes', (SELECT count(*)::int FROM pg_index WHERE indrelid = 'up'::regclass AND indisvalid), 2);
              chk              
-------------------------------
 upgrade keeps the indexes: ok
(1 row)

SELECT chk('upgrade keeps the options', value, 'ts') FROM sift.table_option_values WHERE rel::oid = 'up'::regclass AND name = 'key_order';
              chk              
-------------------------------
 upgrade keeps the options: ok
(1 row)

SET enable_seqscan = off;
SELECT chk('index after upgrade', count(*)::int, (SELECT count(*)::int FROM generate_series(1, 39000) i WHERE i % 7 = 3)) FROM up WHERE g = 3;
           chk           
-------------------------
 index after upgrade: ok
(1 row)

RESET enable_seqscan;
SELECT pg_relation_filenode('up') AS fn_up2 \gset
SELECT chk('upgrade twice', sift.upgrade_table('up'), false);
        chk        
-------------------
 upgrade twice: ok
(1 row)

SELECT chk('upgrade twice keeps the file', pg_relation_filenode('up') = :fn_up2, true);
               chk                
----------------------------------
 upgrade twice keeps the file: ok
(1 row)

INSERT INTO up VALUES (50000, 1, 'after', now());
SELECT chk('write after upgrade', count(*)::int, 39001) FROM up;
           chk           
-------------------------
 write after upgrade: ok
(1 row)

VACUUM FREEZE up;
CREATE ROLE f2p_user NOLOGIN;
GRANT USAGE ON SCHEMA f2p TO f2p_user;
SET ROLE f2p_user;
SELECT fails('SELECT sift.upgrade_table(''f2p.up'')', '42501');
   fails   
-----------
 42501: ok
(1 row)

RESET ROLE;
GRANT MAINTAIN ON up TO f2p_user;
SET ROLE f2p_user;
SELECT chk('maintain may upgrade', sift.upgrade_table('f2p.up'), false);
           chk            
--------------------------
 maintain may upgrade: ok
(1 row)

RESET ROLE;
