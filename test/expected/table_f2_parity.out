-- 7. BM25 index on a table: visibility of the rows it scores
CREATE TABLE d (id int PRIMARY KEY, body text) USING sift_table;
INSERT INTO d SELECT i, 'alpha beta ' || (CASE WHEN i % 3 = 0 THEN 'gamma' ELSE 'delta' END) || ' doc' || i FROM generate_series(1, 3000) i;
CREATE INDEX d_bm25 ON d USING sift (body);
SELECT chk('bm25 match', count(*)::int, 1000) FROM d WHERE body @@> 'gamma';
      chk       
----------------
 bm25 match: ok
(1 row)

DELETE FROM d WHERE id % 6 = 0;
SELECT chk('bm25 after delete', count(*)::int, 500) FROM d WHERE body @@> 'gamma';
          chk          
-----------------------
 bm25 after delete: ok
(1 row)

BEGIN;
UPDATE d SET body = 'omega only' WHERE id = 3;
SELECT chk('bm25 own update', count(*)::int, 1) FROM d WHERE body @@> 'omega';
         chk         
---------------------
 bm25 own update: ok
(1 row)

ROLLBACK;
SELECT chk('bm25 after rollback', count(*)::int, 0) FROM d WHERE body @@> 'omega';
           chk           
-------------------------
 bm25 after rollback: ok
(1 row)

-- 8. Wide values: stored outside the granules, read back, updated, compacted
CREATE TABLE w (id int PRIMARY KEY, big text, b bytea, j jsonb) USING sift_table;
INSERT INTO w SELECT i, repeat(md5(i::text), 400), decode(repeat(md5(i::text), 300), 'hex') , jsonb_build_object('k', repeat('x', 6000), 'i', i)
	FROM generate_series(1, 200) i;
SELECT chk('wide length', (min(length(big)), max(length(big))), (12800, 12800)) FROM w;
       chk       
-----------------
 wide length: ok
(1 row)

SELECT chk('wide content', big, repeat(md5('7'), 400)) FROM w WHERE id = 7;
       chk        
------------------
 wide content: ok
(1 row)

SELECT chk('wide bytea', length(b), 4800) FROM w WHERE id = 7;
      chk       
----------------
 wide bytea: ok
(1 row)

SELECT chk('wide jsonb', j ->> 'i', '7') FROM w WHERE id = 7;
      chk       
----------------
 wide jsonb: ok
(1 row)

UPDATE w SET big = repeat('z', 20000) WHERE id <= 50;
SELECT chk('wide update', count(*)::int, 50) FROM w WHERE big = repeat('z', 20000);
       chk       
-----------------
 wide update: ok
(1 row)

DELETE FROM w WHERE id > 100;
VACUUM w;
SELECT chk('wide after vacuum', (count(*)::int, count(*) FILTER (WHERE length(big) >= 12800)::int), (100, 100)) FROM w;
          chk          
-----------------------
 wide after vacuum: ok
(1 row)

SELECT chk('wide aggregate', sum(length(big))::bigint, 50::bigint * 20000 + 50::bigint * 12800) FROM w;
        chk         
--------------------
 wide aggregate: ok
(1 row)

-- 9. ALTER TABLE: ADD, RENAME and DROP COLUMN keep the relation file; ALTER COLUMN TYPE rewrites it into a new one
CREATE TABLE a (id int, v int) USING sift_table;
INSERT INTO a SELECT i, i FROM generate_series(1, 5000) i;
SELECT pg_relation_filenode('a') AS fn0 \gset
ALTER TABLE a ADD COLUMN extra text DEFAULT 'x';
ALTER TABLE a ADD COLUMN nothing int;
SELECT chk('add column keeps the file', pg_relation_filenode('a') = :fn0, true);
              chk              
-------------------------------
 add column keeps the file: ok
(1 row)

SELECT chk('add column default', (count(*) FILTER (WHERE extra = 'x')::int, count(nothing)::int), (5000, 0)) FROM a;
          chk           
------------------------
 add column default: ok
(1 row)

INSERT INTO a VALUES (5001, 1, 'y', 7);
ALTER TABLE a ALTER COLUMN v TYPE bigint;
SELECT chk('widen rewrites', pg_relation_filenode('a') <> :fn0, true);
        chk         
--------------------
 widen rewrites: ok
(1 row)

SELECT pg_relation_filenode('a') AS fn1 \gset
SELECT chk('widen values', sum(v), (SELECT sum(i) + 1 FROM generate_series(1, 5000) i)::numeric) FROM a;
       chk        
------------------
 widen values: ok
(1 row)

ALTER TABLE a RENAME COLUMN v TO val;
SELECT chk('rename column', sum(val), (SELECT sum(i) + 1 FROM generate_series(1, 5000) i)::numeric) FROM a;
        chk        
-------------------
 rename column: ok
(1 row)

ALTER TABLE a DROP COLUMN nothing;
SELECT chk('drop column', (SELECT count(*)::int FROM pg_attribute WHERE attrelid = 'a'::regclass AND attnum > 0 AND NOT attisdropped), 3);
       chk       
-----------------
 drop column: ok
(1 row)

SELECT chk('drop column keeps the file', pg_relation_filenode('a') = :fn1, true);
              chk               
--------------------------------
 drop column keeps the file: ok
(1 row)

ALTER TABLE a ALTER COLUMN val TYPE text USING val::text;
SELECT chk('recast values', (SELECT min(val) FROM a WHERE id = 5000), '5000');
        chk        
-------------------
 recast values: ok
(1 row)

ALTER TABLE a ADD COLUMN gen int GENERATED ALWAYS AS (id * 2) STORED;
SELECT chk('stored generated column', gen, 20) FROM a WHERE id = 10;
             chk             
-----------------------------
