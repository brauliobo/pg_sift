-- EvalPlanQual: the second session waits on a row the first updates, then re-evaluates its qual on the successor
SELECT dblink_exec('s2', 'SET search_path = f2p');
 dblink_exec 
-------------
 SET
(1 row)

BEGIN;
UPDATE oc SET n = 100 WHERE id = 20;
SELECT dblink_send_query('s2', 'UPDATE oc SET n = n + 1 WHERE id = 20 AND n >= 2');
 dblink_send_query 
-------------------
                 1
(1 row)

DO $$
DECLARE deadline timestamptz := clock_timestamp() + interval '10 s';
BEGIN
	WHILE NOT EXISTS (SELECT 1 FROM pg_stat_activity WHERE wait_event_type = 'Lock' AND pid <> pg_backend_pid() AND datname = current_database()) LOOP
		IF clock_timestamp() > deadline THEN RAISE EXCEPTION 'the second session did not wait on the row'; END IF;
		PERFORM pg_sleep(0.01);
	END LOOP;
END $$;
COMMIT;
SELECT chk('epq update count', r, 'UPDATE 1') FROM dblink_get_result('s2') AS x(r text);
         chk          
----------------------
 epq update count: ok
(1 row)

SELECT chk('epq successor', n, 101) FROM oc WHERE id = 20;
        chk        
-------------------
 epq successor: ok
(1 row)

SELECT dblink_disconnect('s2');
 dblink_disconnect 
-------------------
 OK
(1 row)

-- 6. Secondary B-tree, partial, expression, unique and covering indexes; Index Only Scan reports no heap fetches that skip MVCC
CREATE INDEX t_g ON t (g);
CREATE INDEX t_expr ON t (lower(s));
CREATE INDEX t_part ON t (id) WHERE g = 3;
CREATE UNIQUE INDEX t_uniq ON t (id, g);
SET enable_seqscan = off;
SELECT chk('btree probe', count(*)::int, 2000) FROM t WHERE g = 3;
       chk       
-----------------
 btree probe: ok
(1 row)

SELECT chk('expression probe', count(*)::int, 1) FROM t WHERE lower(s) = 'row 5';
         chk          
----------------------
 expression probe: ok
(1 row)

SELECT chk('partial probe', count(*)::int, 2000) FROM t WHERE g = 3 AND id > 0;
        chk        
-------------------
 partial probe: ok
(1 row)

SET enable_bitmapscan = off;
SELECT chk('index scan after update', (SELECT count(*)::int FROM t WHERE g = 3 AND s LIKE '%!'), 2000);
             chk             
-----------------------------
 index scan after update: ok
(1 row)

RESET enable_bitmapscan;
RESET enable_seqscan;
SET enable_indexscan = off; SET enable_seqscan = off;
SELECT chk('bitmap scan', count(*)::int, 2000) FROM t WHERE g = 3;
       chk       
-----------------
 bitmap scan: ok
(1 row)

RESET enable_indexscan; RESET enable_seqscan;
SELECT chk('index vs seq', (SELECT count(*) FROM t WHERE g BETWEEN 2 AND 4), count(*)) FROM (SELECT * FROM t WHERE g BETWEEN 2 AND 4 OFFSET 0) x;
       chk        
------------------
 index vs seq: ok
(1 row)

UPDATE t SET g = 11 WHERE id <= 100;
SELECT chk('index follows update', count(*)::int, 90) FROM t WHERE g = 11;
           chk            
--------------------------
 index follows update: ok
(1 row)

CREATE INDEX CONCURRENTLY t_cic ON t (ts);
SELECT chk('cic valid', indisvalid, true) FROM pg_index WHERE indexrelid = 't_cic'::regclass;
