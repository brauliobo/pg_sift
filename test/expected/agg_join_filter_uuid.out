-- An inner or semi lookup join on a uuid leaf of Custom Scan (SiftAgg) is keyed by the 16 bytes of the uuid and takes the filter of the text leaves (sift.agg_join_filter;
-- "Join Text Filters" of EXPLAIN ANALYZE): a unit that holds none of the keys is not read and the rows of one that holds some are narrowed to those with a key of the table.
-- Every statement is run with the filter, with sift.agg_join_filter = off and with sift.enable_agg = off: the rows must be the same.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_helpers;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET seq_page_cost = 10000; SET random_page_cost = 10000;
-- 400 consecutive rows for each account, NULL accounts, and accounts that differ from another in one byte only (the first, the middle and the last)
CREATE TABLE ev (id int PRIMARY KEY, acct uuid, grp int, amount int) WITH (autovacuum_enabled = false);
INSERT INTO ev
SELECT i, CASE WHEN i % 97 = 0 THEN NULL ELSE md5('acct-' || (i / 400))::uuid END, i % 7, i % 1000
FROM generate_series(1, 120000) i;
UPDATE ev SET acct = '00000000-0000-0000-0000-000000000001' WHERE id % 5000 = 1;
UPDATE ev SET acct = '00000000-0000-0000-0000-000000000002' WHERE id % 5000 = 2;
UPDATE ev SET acct = '01000000-0000-0000-0000-000000000000' WHERE id % 5000 = 3;
UPDATE ev SET acct = '00000000-0000-0001-0000-000000000000' WHERE id % 5000 = 4;
CREATE INDEX ev_col ON ev USING sift_col (grp, acct, amount);
VACUUM (FREEZE, ANALYZE) ev;
-- keys: present, absent, duplicated, NULL, one byte away from a present value, in capitals (the same uuid)
CREATE TABLE ks (k uuid, w int);
INSERT INTO ks SELECT md5('acct-' || a)::uuid, a FROM unnest(ARRAY[3, 4, 250, 299, 299]) a;
INSERT INTO ks VALUES (NULL, 1), (md5('acct-absent')::uuid, 2), ('00000000-0000-0000-0000-000000000001', 5), ('00000000-0000-0000-0000-000000000003', 6),
       ('01000000-0000-0000-0000-000000000000', 7), ('00000000-0000-0001-0000-000000000000', 8), (upper(md5('acct-10'))::uuid, 9);
CREATE TABLE kuniq (k uuid PRIMARY KEY, w int);
INSERT INTO kuniq SELECT DISTINCT ON (k) k, w FROM ks WHERE k IS NOT NULL;
CREATE TABLE kfew (k uuid, w int);
INSERT INTO kfew SELECT md5('acct-' || a)::uuid, a FROM unnest(ARRAY[3, 4]) a;
CREATE TABLE kmany (k uuid);
INSERT INTO kmany SELECT md5('acct-' || a)::uuid FROM generate_series(0, 299) a;
INSERT INTO kmany SELECT md5('many-' || a)::uuid FROM generate_series(0, 9999) a;
CREATE TABLE knone (k uuid);
ANALYZE ks; ANALYZE kuniq; ANALYZE kfew; ANALYZE kmany; ANALYZE knone;
CREATE FUNCTION plan_of(q text) RETURNS text LANGUAGE sql AS $$ SELECT sift_helpers.plan_siftagg_with_text_key_filters(q) $$;
CREATE FUNCTION same(q text) RETURNS TABLE (plan text, result_rows bigint, vs_no_filter bigint, vs_normal_plan bigint) LANGUAGE plpgsql AS $$
BEGIN
	plan := plan_of(q);
	EXECUTE format('CREATE TEMP TABLE r_on ON COMMIT DROP AS %s', q);
	SET LOCAL sift.agg_join_filter = off;
	EXECUTE format('CREATE TEMP TABLE r_gen ON COMMIT DROP AS %s', q);
	RESET sift.agg_join_filter;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('CREATE TEMP TABLE r_off ON COMMIT DROP AS %s', q);
	RESET sift.enable_agg;
	result_rows := (SELECT count(*) FROM r_on);
	vs_no_filter := (SELECT count(*) FROM ((TABLE r_on EXCEPT TABLE r_gen) UNION ALL (TABLE r_gen EXCEPT TABLE r_on)) d);
	vs_normal_plan := (SELECT count(*) FROM ((TABLE r_on EXCEPT TABLE r_off) UNION ALL (TABLE r_off EXCEPT TABLE r_on)) d);
	DROP TABLE r_on, r_gen, r_off;
	RETURN NEXT;
END $$;
-- the rows the scan read, and those it read without the filter: the units that hold no key are not read
CREATE FUNCTION scanned(q text, filter bool) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE l text; n bigint;
BEGIN
	EXECUTE format('SET LOCAL sift.agg_join_filter = %s', filter);
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF l ~ 'Rows: (\d+) scanned' THEN n := substring(l from 'Rows: (\d+) scanned')::bigint; END IF;
	END LOOP;
	RETURN n;
END $$;
-- a semi join, an inner join that returns a column (the duplicated key repeats its rows) and by the unique key of a table, EXISTS, a join by two columns
SELECT * FROM same($$SELECT grp, count(*) AS n, sum(amount) AS s FROM ev WHERE acct IN (SELECT k FROM ks) GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           7 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT k.w, count(*) AS n, sum(amount) AS s FROM ev JOIN ks k ON k.k = ev.acct GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           8 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT k.w, count(*) AS n, sum(amount) AS s FROM ev JOIN kuniq k ON k.k = ev.acct GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           8 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE EXISTS (SELECT 1 FROM ks k WHERE k.k = ev.acct AND k.w > 4)$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT ev.grp, count(*) AS n FROM ev JOIN ks k ON k.k = ev.acct AND k.w = ev.grp GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           3 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT grp, count(*) AS n FROM ev JOIN ks k ON k.k = ev.acct WHERE ev.amount < 500 GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           7 |            0 |              0
(1 row)

-- one key, the NULL key, the keys one byte away from a present value, the capitals
SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks WHERE w = 250)$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks WHERE w = 1)$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks WHERE w IN (5, 6))$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks WHERE w IN (7, 8))$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks WHERE w = 9)$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

-- a join and the leaf's own condition, two joins on the same leaf
SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks) AND acct IN (SELECT k FROM kfew)$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 2 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks) AND acct <> '00000000-0000-0000-0000-000000000001' AND amount > 100$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

-- a leaf that the query reads besides its join (grouped, counted distinct, as text, in the ON clause) is read as the datums of the unit; the join alone reads the stored dictionary
SELECT * FROM same($$SELECT acct, count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks) GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           8 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT k.w, count(DISTINCT acct) AS d, min(acct::text) AS lo, max(acct::text) AS hi FROM ev JOIN ks k ON k.k = ev.acct GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           8 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev JOIN ks k ON k.k = ev.acct AND k.w > length(ev.acct::text) - 30$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IS NOT NULL AND acct IN (SELECT k FROM ks)$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

-- more keys than the filter takes (a sixteenth of the rows of the table), a table with no row, a table of keys that match nothing
SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM kmany)$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM knone)$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks WHERE w = 2)$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           1 |            0 |              0
(1 row)

-- a LEFT join and an anti join keep the tuples without a match: no filter
SELECT * FROM same($$SELECT k.w, count(*) AS n FROM ev LEFT JOIN ks k ON k.k = ev.acct GROUP BY 1$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           9 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE NOT EXISTS (SELECT 1 FROM ks k WHERE k.k = ev.acct)$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           1 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct NOT IN (SELECT k FROM ks WHERE k IS NOT NULL)$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           1 |            0 |              0
(1 row)

-- the keys of two accounts that sit in the first units: the others are not read, where the scan without the filter reads every row
SELECT scanned($$SELECT count(*) FROM ev WHERE acct IN (SELECT k FROM kfew)$$, true) < scanned($$SELECT count(*) FROM ev WHERE acct IN (SELECT k FROM kfew)$$, false) AS filter_prunes_units;
 filter_prunes_units 
---------------------
 t
(1 row)

SELECT scanned($$SELECT count(*) FROM ev WHERE acct IN (SELECT k FROM kfew)$$, false) = (SELECT count(*) FROM ev) AS no_filter_reads_all;
 no_filter_reads_all 
---------------------
 t
(1 row)

-- parallel workers narrow their own units
SET max_parallel_workers_per_gather = 2; SET parallel_setup_cost = 0; SET parallel_tuple_cost = 0; SET min_parallel_table_scan_size = 0; SET min_parallel_index_scan_size = 0;
SELECT * FROM same($$SELECT grp, count(*) AS n FROM ev WHERE acct IN (SELECT k FROM ks) GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           7 |            0 |              0
(1 row)

RESET max_parallel_workers_per_gather;
-- a sift_table and the partitions of a table read the stored dictionary the same way
CREATE TABLE evt (id int, acct uuid, grp int, amount int) USING sift_table;
INSERT INTO evt SELECT * FROM ev;
VACUUM (FREEZE, ANALYZE) evt;
CREATE TABLE evp (id int, acct uuid, grp int, amount int) PARTITION BY RANGE (id);
CREATE TABLE evp1 PARTITION OF evp FOR VALUES FROM (0) TO (60000);
CREATE TABLE evp2 PARTITION OF evp FOR VALUES FROM (60000) TO (1000000);
INSERT INTO evp SELECT * FROM ev;
CREATE INDEX evp_col ON evp USING sift_col (grp, acct, amount);
VACUUM (FREEZE, ANALYZE) evp;
SELECT * FROM same($$SELECT grp, count(*) AS n, sum(amount) AS s FROM evt WHERE acct IN (SELECT k FROM ks) GROUP BY 1$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           7 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT k.w, count(*) AS n FROM evt JOIN ks k ON k.k = evt.acct GROUP BY 1$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           8 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT grp, count(*) AS n, sum(amount) AS s FROM evp WHERE acct IN (SELECT k FROM ks) GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           7 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT k.w, count(*) AS n FROM evp JOIN ks k ON k.k = evp.acct GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           8 |            0 |              0
(1 row)

-- rows written after the index was built (the write buffer) and rows changed or deleted since
INSERT INTO ev SELECT 200000 + i, '00000000-0000-0000-0000-000000000001', i % 7, i FROM generate_series(1, 300) i;
INSERT INTO ev SELECT 300000 + i, NULL, i % 7, i FROM generate_series(1, 30) i;
UPDATE ev SET acct = md5('acct-250')::uuid WHERE id % 1500 = 0;
UPDATE ev SET acct = NULL WHERE id % 1000 = 5;
DELETE FROM ev WHERE id % 1000 = 1 AND acct IS NOT NULL;
SELECT * FROM same($$SELECT grp, count(*) AS n, sum(amount) AS s FROM ev WHERE acct IN (SELECT k FROM ks) GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           7 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT k.w, count(*) AS n FROM ev JOIN ks k ON k.k = ev.acct GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           8 |            0 |              0
(1 row)

SELECT * FROM same($$SELECT count(*) AS n FROM ev WHERE acct NOT IN (SELECT k FROM ks WHERE k IS NOT NULL)$$);
  plan   | result_rows | vs_no_filter | vs_normal_plan 
---------+-------------+--------------+----------------
 SiftAgg |           1 |            0 |              0
(1 row)

VACUUM ev;
SELECT * FROM same($$SELECT grp, count(*) AS n, sum(amount) AS s FROM ev WHERE acct IN (SELECT k FROM ks) GROUP BY 1$$);
            plan            | result_rows | vs_no_filter | vs_normal_plan 
----------------------------+-------------+--------------+----------------
 SiftAgg text key filters 1 |           7 |            0 |              0
(1 row)

DROP FUNCTION same(text), plan_of(text), scanned(text, bool);
DROP TABLE ev, evt, evp, ks, kuniq, kfew, kmany, knone;
DROP EXTENSION pg_sift_helpers;
DROP EXTENSION pg_sift;
