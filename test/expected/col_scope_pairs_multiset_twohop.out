-- A scope of two paths (the grants a tenant has on a dim_a_id, and on the groups of the dim_a_id) whose three relations hold their pairs in several rows: a grant for each source of it, a row of
-- the group for each source. The pairs are the DISTINCT union of the direct pairs and of the joined ones, whatever the btrees hold twice: a pair reached by both paths and by several rows of
-- each is one pair, in the units and in every read. Table-driven: each state of the three relations (they accumulate) by each read shape; every cell md5 equal to the oracle (the UNION),
-- the units read, a read for each pair of one key counts a fact once for each distinct pair.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
SET sift.agg_force = on;
SET sift.test_scope_patch = on;
CREATE TABLE grants (id int PRIMARY KEY, tenant_id int NOT NULL, dim_a_id int, group_id int, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE INDEX grants_direct ON grants (dim_a_id, tenant_id) WHERE deleted_at IS NULL;
CREATE INDEX grants_group ON grants (group_id, tenant_id) WHERE deleted_at IS NULL;
CREATE TABLE memberships (id serial PRIMARY KEY, group_id int NOT NULL, dim_a_id int NOT NULL, deleted_at timestamptz) WITH (autovacuum_enabled = false);
CREATE INDEX memberships_active ON memberships (group_id, dim_a_id) WHERE deleted_at IS NULL;
CREATE INDEX grants_by_member ON grants USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX grants_by_group ON grants USING sift_col (group_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX memberships_by_member ON memberships USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
-- dim_a_id 1..58 are in the group 1 + m % 6, every fifth of them in a row twice, every seventh in a second group (and that one twice)
INSERT INTO memberships (group_id, dim_a_id) SELECT 1 + m % 6, m FROM generate_series(1, 58) m;
INSERT INTO memberships (group_id, dim_a_id) SELECT 1 + m % 6, m FROM generate_series(5, 58, 5) m;
INSERT INTO memberships (group_id, dim_a_id) SELECT 1 + (m + 2) % 6, m FROM generate_series(7, 58, 7) m;
INSERT INTO memberships (group_id, dim_a_id) SELECT 1 + (m + 2) % 6, m FROM generate_series(7, 58, 14) m;
INSERT INTO grants VALUES
	(1, 1, 5, NULL, NULL),		-- tenant 1: dim_a_id 5 directly twice, and through its group (6) twice
	(2, 1, 5, NULL, NULL),
	(3, 1, NULL, 6, NULL),
	(4, 1, NULL, 6, NULL),
	(5, 2, NULL, 3, NULL),		-- tenant 2: a group, and a direct grant
	(6, 2, 8, NULL, NULL),
	(7, 3, 1, NULL, NULL),		-- tenant 3: three dim_a_id, one of them twice
	(8, 3, 2, NULL, NULL),
	(9, 3, 3, NULL, NULL),
	(10, 3, 3, NULL, NULL),
	(11, 4, NULL, 5, NULL),		-- tenant 4: a group
	(12, 5, 40, NULL, NULL),	-- tenant 5: a dim_a_id and a group that has it, each twice
	(13, 5, 40, NULL, NULL),
	(14, 5, NULL, 5, NULL),
	(15, 5, NULL, 5, NULL);
INSERT INTO facts SELECT i, CASE WHEN i % 17 = 0 THEN NULL WHEN i % 19 = 0 THEN 100000 + i ELSE 1 + (i * 7) % 60 END, timestamptz '2026-01-01' + i * interval '9 minutes', i % 10
	FROM generate_series(1, 3000) i;
CREATE VIEW pair_oracle AS
	SELECT dim_a_id, tenant_id FROM grants WHERE deleted_at IS NULL AND dim_a_id IS NOT NULL
	UNION
	SELECT m.dim_a_id, g.tenant_id FROM grants g JOIN memberships m ON m.group_id = g.group_id WHERE g.deleted_at IS NULL AND m.deleted_at IS NULL;
SELECT count(*) AS pairs, (SELECT count(*) FROM grants g JOIN memberships m ON m.group_id = g.group_id) AS joined_rows FROM pair_oracle;
 pairs | joined_rows 
-------+-------------
    48 |          81
(1 row)

SET client_min_messages = notice;
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount)
	WITH (scope = 'tenant_id: dim_a_id -> grants(dim_a_id, tenant_id) | grants(group_id, tenant_id) via memberships(group_id, dim_a_id)');
NOTICE:  scope "tenant_id": the direct pairs of "grants" (dim_a_id, tenant_id) are the distinct rows of its non-unique btree "grants_direct" that satisfy (deleted_at IS NULL)
DETAIL:  A pair may be several rows: a read with the meaning of IN or EXISTS counts a fact once, a join counts it once for each row and runs as written.
NOTICE:  scope "tenant_id": the joined pairs of "grants" (group_id, tenant_id) are the distinct rows of its non-unique btree "grants_group" that satisfy (deleted_at IS NULL)
DETAIL:  A pair may be several rows: a read with the meaning of IN or EXISTS counts a fact once, a join counts it once for each row and runs as written.
NOTICE:  scope "tenant_id": the via relation of "memberships" (group_id, dim_a_id) are the distinct rows of its non-unique btree "memberships_active" that satisfy (deleted_at IS NULL)
DETAIL:  A pair may be several rows: a read with the meaning of IN or EXISTS counts a fact once, a join counts it once for each row and runs as written.
NOTICE:  scope "tenant_id": 2,143 entries for 3,000 rows (0.71 per row)
NOTICE:  sift_col index "facts_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('facts_col');
NOTICE:  sift_col index "facts_col" has a scope: column format minor 49, which a library before 5.0 cannot read
HINT:  The scope option needs this format: build the index without it for the older library.
SET client_min_messages = warning;
REINDEX INDEX facts_col;
VACUUM (FREEZE, ANALYZE) facts;
VACUUM (ANALYZE) grants, memberships;
CREATE TABLE shapes (n int, label text, q text, plain text);
INSERT INTO shapes VALUES
	(1, 'IN, tenant 1', 'SELECT count(*), sum(amount) FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''tenant_id'', f.dim_a_id, 1)',
		'SELECT count(*), sum(amount) FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM pair_oracle WHERE tenant_id = 1)'),
	(2, 'IN, tenants 2 and 5', 'SELECT count(*), sum(amount) FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''tenant_id'', f.dim_a_id, ARRAY[2, 5]::int8[])',
		'SELECT count(*), sum(amount) FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM pair_oracle WHERE tenant_id IN (2, 5))'),
	(3, 'a row for each pair, tenant 1', 'SELECT count(*), sum(amount) FROM facts f WHERE sift.in_scope_pairs(''facts_col''::regclass, ''tenant_id'', f.dim_a_id, 1)',
		'SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a_id = f.dim_a_id WHERE o.tenant_id = 1'),
	(4, 'a row for each pair, tenant 3', 'SELECT count(*), sum(amount) FROM facts f WHERE sift.in_scope_pairs(''facts_col''::regclass, ''tenant_id'', f.dim_a_id, 3)',
		'SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a_id = f.dim_a_id WHERE o.tenant_id = 3'),
	(5, 'a row for each pair, tenant 5', 'SELECT count(*), sum(amount) FROM facts f WHERE sift.in_scope_pairs(''facts_col''::regclass, ''tenant_id'', f.dim_a_id, 5)',
		'SELECT count(*), sum(amount) FROM facts f JOIN pair_oracle o ON o.dim_a_id = f.dim_a_id WHERE o.tenant_id = 5'),
	(6, 'top 5, tenant 5', 'SELECT id FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''tenant_id'', f.dim_a_id, 5) ORDER BY created_at DESC, id DESC LIMIT 5',
		'SELECT id FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM pair_oracle WHERE tenant_id = 5) ORDER BY created_at DESC, id DESC LIMIT 5');
CREATE FUNCTION tp_run(qq text, plain text, OUT same boolean, OUT route text) LANGUAGE plpgsql AS $$
DECLARE
	p jsonb;
	a text;
	b text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	BEGIN
		EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF, FORMAT JSON) ' || qq INTO p;
		EXECUTE 'SELECT md5(coalesce(json_agg(t)::text, '''')) FROM (' || qq || ') t' INTO a;
	EXCEPTION WHEN feature_not_supported THEN
		route := 'error: ' || substring(SQLERRM FROM '"(.*)"');
		RETURN;
	END;
	SET LOCAL sift.enable_agg = off;
	EXECUTE 'SELECT md5(coalesce(json_agg(t)::text, '''')) FROM (' || plain || ') t' INTO b;
	SET LOCAL sift.enable_agg = on;
	same := a = b;
	route := coalesce(jsonb_path_query_first(p, '$.**."Scope Fallback"') #>> '{}', CASE WHEN jsonb_path_exists(p, '$.**."Scope Units Read"') THEN 'units' ELSE 'no scope read' END);
END $$;
CREATE FUNCTION probe() RETURNS TABLE (n int, label text, verdict text, route text) LANGUAGE sql AS $$
	SELECT s.n, s.label, CASE r.same WHEN true THEN 'same' ELSE 'DIFFERENT' END, r.route FROM shapes s, LATERAL tp_run(s.q, s.plain) r ORDER BY s.n
$$;
CREATE TABLE states (n int, label text, stmt text);
INSERT INTO states VALUES
	(1, 'built', 'SELECT 1'),
	(2, 'a direct grant that exists, once more', 'INSERT INTO grants VALUES (101, 3, 1, NULL, NULL), (102, 3, 1, NULL, NULL), (103, 2, 8, NULL, NULL)'),
	(3, 'one of two direct rows of a pair deleted: the pair stays', 'DELETE FROM grants WHERE id IN (101, 9)'),
	(4, 'both direct rows of a pair that its group grants too deleted: the group keeps the pair', 'DELETE FROM grants WHERE id IN (1, 2)'),
	(5, 'one of two group grant rows soft deleted: the pair stays', 'UPDATE grants SET deleted_at = now() WHERE id = 3'),
	(6, 'both group grant rows soft deleted: the pair is gone (no direct row is left)', 'UPDATE grants SET deleted_at = now() WHERE id = 4'),
	(7, 'a group grant row restored', 'UPDATE grants SET deleted_at = NULL WHERE id = 4'),
	(8, 'one of two rows of a dim_a_id in a group soft deleted: the dim_a_id stays in it', 'UPDATE memberships SET deleted_at = now() WHERE id IN (SELECT min(id) FROM memberships WHERE dim_a_id IN (5, 10) GROUP BY dim_a_id, group_id HAVING count(*) > 1)'),
	(9, 'both rows of a dim_a_id in a group deleted: it leaves the group', 'DELETE FROM memberships WHERE dim_a_id = 35 AND group_id = 1 + 35 % 6'),
	(10, 'a row of a dim_a_id added to a group twice', 'INSERT INTO memberships (group_id, dim_a_id) VALUES (3, 59), (3, 59), (5, 59)'),
	(11, 'buffered facts of dim_a_id of the three kinds', 'INSERT INTO facts SELECT 5000 + i, CASE i % 4 WHEN 0 THEN 5 WHEN 1 THEN 3 WHEN 2 THEN 40 ELSE 59 END, timestamptz ''2026-02-05'', 4 FROM generate_series(1, 80) i'),
	(12, 'promoted', 'SELECT sift.col_promote(''facts_col'')'),
	(13, 'merged', 'SELECT sift.col_merge(''facts_col'', true)'),
	(14, 'rebuilt', 'REINDEX INDEX facts_col');
SELECT c FROM states, LATERAL unnest(ARRAY[format('SELECT %s AS n, %L AS state', n, label), stmt, 'SELECT * FROM probe()']) WITH ORDINALITY u(c, o) ORDER BY n, o \gexec
