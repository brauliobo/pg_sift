------------
 
(1 row)

SELECT count(*) FILTER (WHERE rows = 12000) AS overlays, coalesce(sift.col_maintenance_due('oh_idx', true), '-') AS due_automatic FROM sift.col_segments('oh_idx') WHERE kind = 'immutable';
