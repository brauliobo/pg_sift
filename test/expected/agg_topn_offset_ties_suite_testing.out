-- The top-N scans. The tests that were one file each, one segment for each, each in a schema of its own with the settings reset between them; every segment runs as its test did.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
CREATE EXTENSION pg_sift_helpers;
SET enable_indexscan = off; SET enable_indexonlyscan = off; SET enable_bitmapscan = off;
-- >>> agg_topn_offset_dirty
CREATE SCHEMA s1;
GRANT USAGE ON SCHEMA s1 TO PUBLIC;
SET search_path = s1, public;
-- ORDER BY key LIMIT n OFFSET m over the global order of the key, in units that hold dead rows or whose pages are not all-visible: the entries the OFFSET throws away are
-- confirmed without the heap when their page is all-visible and the unit's liveness says the row is live (the dead rows of a unit are listed once); the others are fetched.
-- The rows are the plan's without the extension after deleted, updated (HOT and not), rolled back and vacuumed rows, and for a cursor opened before the update.
SET sift.async_maintenance = off;
SET max_parallel_maintenance_workers = 0;
SET max_parallel_workers_per_gather = 0;
\set VERBOSITY terse
CREATE TABLE od (id int PRIMARY KEY, n int, s text COLLATE "C", pad text DEFAULT repeat('x', 200));
ALTER TABLE od ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO od (id, n, s) SELECT i, (i * 7919) % 1000, 'k' || lpad(((i::bigint * 7919) % 100003)::text, 6, '0') FROM generate_series(1, 12000) i;
-- pages with gaps (the rows of a page are then a bitmap of its offsets in the unit)
DELETE FROM od WHERE id % 5 = 2;
VACUUM od;
CREATE INDEX od_i ON od USING sift_col (id sift.col_int4_ops, n sift.col_int4_ops, s sift.col_text_ops) WITH (order_array_columns = 'id, n, s', track_changes = 'off');
NOTICE:  sift_col index "od_i": 1 automatic choice (order_array_columns)
NOTICE:  sift_col index "od_i" is column format minor 44, which a library before 4.3 cannot read
VACUUM (FREEZE, ANALYZE, DISABLE_PAGE_SKIPPING) od;
SET sift.test_topn_heads = off;
-- the rows are the plan's without the extension, in order; the answer says 'skipped' when the scan fetched no more than the LIMIT and an eighth of the OFFSET more, 'fetched' when it fetched more
CREATE FUNCTION od_chk(q text, lim int, off int) RETURNS text LANGUAGE sql AS $$ SELECT sift_helpers.topn_offset_check_heap_fetches(q, lim, off) $$;
CREATE FUNCTION od_all(lim int DEFAULT 10, offs int[] DEFAULT ARRAY[1500, 6000]) RETURNS TABLE (result text, n bigint) LANGUAGE sql AS
$$ SELECT od_chk(format('SELECT id, n, s FROM od ORDER BY %s %s LIMIT %s OFFSET %s', k, d, lim, o), lim, o) AS result, count(*)
   FROM unnest(ARRAY['s', 'n, id']) k, unnest(ARRAY['ASC', 'DESC']) d, unnest(offs) o GROUP BY 1 ORDER BY 1 $$;
SELECT * FROM od_all();
 result  | n 
---------+---
 skipped | 8
(1 row)

-- deleted and updated rows: their pages are not all-visible, the others are
DELETE FROM od WHERE id % 53 = 0;
UPDATE od SET n = n + 1, s = 'u' || s WHERE id % 97 = 0;
SELECT * FROM od_all();
 result  | n 
---------+---
 fetched | 8
(1 row)

-- a VACUUM flags the dead rows of every unit and frees their addresses
VACUUM od;
SELECT * FROM od_all();
 result  | n 
---------+---
 skipped | 8
(1 row)

-- a HOT update (no indexed column changes), an update rolled back and a cursor opened before an update
UPDATE od SET pad = repeat('y', 200) WHERE id % 31 = 0;
BEGIN;
UPDATE od SET n = n + 5, s = 'r' || s WHERE id % 101 = 0;
ROLLBACK;
SELECT * FROM od_all();
 result  | n 
---------+---
 fetched | 8
(1 row)

VACUUM od;
SELECT * FROM od_all();
 result  | n 
---------+---
 skipped | 8
(1 row)

BEGIN ISOLATION LEVEL REPEATABLE READ;
SET LOCAL sift.enable_agg = off;
CREATE TEMP TABLE od_before AS SELECT id, n, s FROM od ORDER BY s LIMIT 5 OFFSET 6000;
SET LOCAL sift.enable_agg = on; SET LOCAL sift.agg_force = on; SET LOCAL enable_seqscan = off; SET LOCAL enable_sort = off;
DECLARE od_c CURSOR FOR SELECT id, n, s FROM od ORDER BY s LIMIT 5 OFFSET 6000;
UPDATE od SET s = 'a' || s WHERE id % 3 = 0;
FETCH ALL FROM od_c;
  id  |  n  |    s    
------+-----+---------
 5413 | 547 | k064263
   46 | 274 | k064265
 9795 | 605 | k064280
 4428 | 332 | k064282
 8810 | 390 | k064299
(5 rows)

SELECT * FROM od_before;
  id  |  n  |    s    
------+-----+---------
 5413 | 547 | k064263
   46 | 274 | k064265
 9795 | 605 | k064280
 4428 | 332 | k064282
 8810 | 390 | k064299
(5 rows)

COMMIT;
SELECT * FROM od_all();
 result  | n 
---------+---
 fetched | 8
(1 row)

VACUUM od;
SELECT * FROM od_all();
 result  | n 
---------+---
 fetched | 6
 skipped | 2
(2 rows)

DROP FUNCTION od_all(int, int[]), od_chk(text, int, int);
DROP TABLE od;
RESET ALL;
SET enable_indexscan = off; SET enable_indexonlyscan = off; SET enable_bitmapscan = off;
SET client_min_messages = warning;
DROP SCHEMA s1 CASCADE;
RESET client_min_messages;
-- <<< agg_topn_offset_dirty
-- >>> agg_topn_offset_keyed
CREATE SCHEMA s2;
GRANT USAGE ON SCHEMA s2 TO PUBLIC;
SET search_path = s2, public;
-- ORDER BY key LIMIT n OFFSET m over the global order of the key of an index cut by another key (key_cut: its units hold the rows of one value of the cut key, wherever they
-- are in the heap): the entries the OFFSET throws away are not confirmed by the heap when their page is all-visible and their row is not among the dead rows of the segment's
-- units; the others are fetched. The rows are the plan's without the extension after deleted, updated (HOT and not), rolled back and vacuumed rows, new rows, a promotion,
-- a merge, and for a cursor opened before an update.
SET sift.async_maintenance = off;
SET max_parallel_maintenance_workers = 0;
SET max_parallel_workers_per_gather = 0;
\set VERBOSITY terse
CREATE TABLE ok (id int PRIMARY KEY, c int, n int, s text COLLATE "C", pad text DEFAULT repeat('x', 200));
ALTER TABLE ok ALTER COLUMN pad SET STORAGE PLAIN;
INSERT INTO ok (id, c, n, s) SELECT i, (i * 7919) % 37, (i * 104729) % 100003, 'k' || lpad(((i::bigint * 7919) % 100003)::text, 6, '0') FROM generate_series(1, 12000) i;
CREATE INDEX ok_i ON ok USING sift_col (id sift.col_int4_ops, c sift.col_int4_ops, n sift.col_int4_ops, s sift.col_text_ops)
	WITH (key_cut = 'c', order_array_columns = 'id, n, s', track_changes = 'off');
NOTICE:  sift_col index "ok_i": 1 automatic choice (order_array_columns)
NOTICE:  sift_col index "ok_i" is column format minor 44, which a library before 4.3 cannot read
VACUUM (FREEZE, ANALYZE, DISABLE_PAGE_SKIPPING) ok;
SET sift.test_topn_heads = off;
-- the rows are the plan's without the extension, in order; the answer says 'skipped' when the scan fetched no more than the LIMIT and an eighth of the OFFSET more, 'fetched'
-- when it fetched more, 'units' when the walk of the units answered
CREATE FUNCTION ok_chk(q text, lim int, off int) RETURNS text LANGUAGE sql AS $$ SELECT sift_helpers.topn_offset_check_heap_fetches(q, lim, off) $$;
CREATE FUNCTION ok_all(lim int DEFAULT 10, offs int[] DEFAULT ARRAY[1500, 6000]) RETURNS TABLE (result text, n bigint) LANGUAGE sql AS
$$ SELECT ok_chk(format('SELECT id, n, s FROM ok ORDER BY %s %s LIMIT %s OFFSET %s', k, d, lim, o), lim, o) AS result, count(*)
   FROM unnest(ARRAY['s', 'n', 'n, id']) k, unnest(ARRAY['ASC', 'DESC']) d, unnest(offs) o GROUP BY 1 ORDER BY 1 $$;
SELECT * FROM ok_all();
