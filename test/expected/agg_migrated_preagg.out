 17 | min, max: scan                  | t
 18 | expression: scan                | t
(18 rows)

-- 5. merged: the dead rows are gone and every unit is stored with its pre-aggregates again
SELECT sift.col_merge('ec_col', true) >= 0 AS merged;
 merged 
--------
 t
(1 row)

