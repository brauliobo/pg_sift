       (SELECT by_set FROM ss_units('SELECT count(*) FROM ss WHERE cat = ' || quote_literal(:'c1'))) > 0 AS text_skips,
       (SELECT by_set FROM ss_units('SELECT count(*) FROM ss WHERE id = 12345')) = 0 AS dense_id_has_none,
