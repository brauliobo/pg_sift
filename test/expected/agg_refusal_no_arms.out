-- sift.explain_why and sift.explain_refusals name the two level arm only for a statement that has arms: an aggregate over a UNION ALL, or over one
-- aggregate that groups by a unique row id. An aggregate over an ordinary sub-select (a plain GROUP BY, a LIMIT, a join to one) has none, and is
-- told nothing about arms it does not have.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE ev (id int PRIMARY KEY, kind int NOT NULL, val float8 NOT NULL);
INSERT INTO ev SELECT i, i % 50, i FROM generate_series(1, 5000) i;
CREATE INDEX ev_col ON ev USING sift_col (id, kind, val);
NOTICE:  sift_col index "ev_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('ev_col');
CREATE TABLE ev2 (id int PRIMARY KEY, kind int NOT NULL, val float8 NOT NULL);
INSERT INTO ev2 SELECT * FROM ev;
VACUUM (ANALYZE) ev, ev2;
CREATE TABLE shapes (name text, q text);
INSERT INTO shapes VALUES
 ('grouped sub-select', 'SELECT count(*) FROM (SELECT kind, percentile_cont(0.5) WITHIN GROUP (ORDER BY val) FROM ev GROUP BY kind) s'),
 ('grouped sub-select sum', 'SELECT count(*) FROM (SELECT kind, sum(val) FROM ev GROUP BY kind) s'),
 ('sub-select without index', 'SELECT count(*) FROM (SELECT kind, sum(val) FROM ev2 GROUP BY kind) s'),
 ('limited sub-select', 'SELECT count(*) FROM (SELECT * FROM ev LIMIT 10) s'),
 ('joined sub-select', 'SELECT sum(s.n) FROM ev JOIN (SELECT kind, count(*) n FROM ev GROUP BY kind) s ON s.kind = ev.kind'),
 ('one arm by row id', 'SELECT upper(kind::text), sum(n) FROM (SELECT id, kind, count(*) n FROM ev GROUP BY id, kind) s GROUP BY 1'),
 ('two arms', 'SELECT m.kind, sum(m.n) FROM (SELECT id, kind, 1 AS n FROM ev UNION ALL SELECT id, kind, 2 FROM ev2) m GROUP BY 1');
SELECT s.name, w.arm, w.used, w.slug FROM shapes s, LATERAL sift.explain_why(s.q) w WHERE w.arm ~ 'two_level' ORDER BY s.ctid, w.arm;
       name        |    arm    | used |   slug   
-------------------+-----------+------+----------
 one arm by row id | two_level | f    | two_keys
 two arms          | two_level | f    | two_arms
(2 rows)

DROP TABLE shapes;
DROP TABLE ev, ev2;
DROP EXTENSION pg_sift;
