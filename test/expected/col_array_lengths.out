    4 | ia#2 | integer (lane 2)
    5 | ta   | text[]
    6 | ta#1 | integer (lane 1)
    7 | ta#2 | integer (lane 2)
    8 | na   | numeric[]
    9 | na#1 | integer (lane 1)
   10 | na#2 | integer (lane 2)
   11 | ma   | integer[]
   12 | ma#1 | integer (lane 1)
   13 | ma#2 | integer (lane 2)
   14 | lb   | integer[]
   15 | lb#1 | integer (lane 1)
   16 | lb#2 | integer (lane 2)
(17 rows)

