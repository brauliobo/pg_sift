-- a generic plan reads the dimension and the bound from parameters
PREPARE g(int, int) AS SELECT count(*) FROM al WHERE array_length(ma, $1) > $2;
SET plan_cache_mode = force_generic_plan;
EXECUTE g(1, 1);
 count 
-------
  1251
(1 row)

EXECUTE g(2, 1);
 count 
-------
  1251
(1 row)

RESET plan_cache_mode;
DEALLOCATE g;
