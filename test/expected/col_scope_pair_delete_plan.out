(1 row)

-- the pairs listed: those of members with facts only, and no statement for none
SELECT setting, edit, size, pairs FROM gone ORDER BY setting DESC, size, edit;
          setting          |          edit           | size | pairs 
---------------------------+-------------------------+------+-------
 with statistics           | members with facts      |    3 |     3
 with statistics           | members with facts      |  100 |   100
 with statistics           | members without facts   |  100 |      
 with statistics           | half of them have facts | 2000 |  1000
 with statistics           | members with facts      | 3000 |  3000
 with statistics           | members without facts   | 3000 |      
 pair table never analyzed | members with facts      |    3 |     3
 pair table never analyzed | members with facts      |  100 |   100
 pair table never analyzed | members without facts   |  100 |      
 pair table never analyzed | half of them have facts | 2000 |  1000
 pair table never analyzed | members with facts      | 3000 |  3000
 pair table never analyzed | members without facts   | 3000 |      
(12 rows)

-- the delete never hashes the copy (the pairs are the hashed side) and never scans it for each pair: it reads the copy once, or probes it by its index (for the few pairs of 3)
SELECT setting, edit, size, count(*) FILTER (WHERE line ~ 'Seq Scan on facts_by_tenant') <= 1 AS copy_scanned_at_most_once,
	   count(*) FILTER (WHERE line ~ 'Index Scan.* on facts_by_tenant') > 0 AS probes_the_copy,
	   string_agg(line, E'\n' ORDER BY ord) ~ 'Hash\n +-> Seq Scan on facts_by_tenant' AS hashes_the_copy
FROM (SELECT *, row_number() OVER () AS ord FROM plans) p GROUP BY setting, edit, size ORDER BY setting DESC, size, edit;
          setting          |          edit           | size | copy_scanned_at_most_once | probes_the_copy | hashes_the_copy 
---------------------------+-------------------------+------+---------------------------+-----------------+-----------------
 with statistics           | members with facts      |    3 | t                         | t               | f
 with statistics           | members with facts      |  100 | t                         | f               | f
 with statistics           | half of them have facts | 2000 | t                         | f               | f
 with statistics           | members with facts      | 3000 | t                         | f               | f
 pair table never analyzed | members with facts      |    3 | t                         | t               | f
 pair table never analyzed | members with facts      |  100 | t                         | f               | f
 pair table never analyzed | half of them have facts | 2000 | t                         | f               | f
 pair table never analyzed | members with facts      | 3000 | t                         | f               | f
(8 rows)

-- facts and pairs that change in one statement: the pairs of a member whose facts go, move to another member or come from nothing are still taken from the copy
SET spec.setting = 'one statement'; SET spec.edit = 'facts and pairs'; SET spec.size = 0;
INSERT INTO scope_pairs SELECT * FROM all_pairs ON CONFLICT DO NOTHING;
WITH f AS (DELETE FROM facts WHERE dim_a_id = 11 RETURNING 1) DELETE FROM scope_pairs WHERE dim_a_id = 11;
WITH f AS (UPDATE facts SET dim_a_id = 12 WHERE dim_a_id = 13 RETURNING 1) DELETE FROM scope_pairs WHERE dim_a_id = 13;
WITH f AS (INSERT INTO facts (dim_a_id, kind, amount) VALUES (6500, 1, 1) RETURNING 1) DELETE FROM scope_pairs WHERE dim_a_id = 6500;
WITH f AS (DELETE FROM facts WHERE dim_a_id BETWEEN 2001 AND 2400 RETURNING 1) UPDATE scope_pairs SET tenant_id = 200 WHERE dim_a_id BETWEEN 2001 AND 2400 AND tenant_id < 100;
-- the copy equals the join after the edits
SELECT count(*) AS differs FROM sift.scope_verify('facts_by_tenant');
 differs 
---------
       0
(1 row)

SELECT (SELECT md5(string_agg(tenant_id || '/' || id || '/' || dim_a_id || '/' || kind || '/' || amount, ',' ORDER BY tenant_id, id)) FROM facts_by_tenant)
	 = (SELECT md5(string_agg(s.tenant_id || '/' || f.id || '/' || f.dim_a_id || '/' || f.kind || '/' || f.amount, ',' ORDER BY s.tenant_id, f.id))
		FROM facts f JOIN scope_pairs s USING (dim_a_id)) AS rows_equal_join;
