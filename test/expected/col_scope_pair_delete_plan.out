-- The DELETE a scope copy's trigger runs for the pairs that go finds the copy's rows of the pairs whose member has facts and no others: a pair whose member has no fact has no copy
-- row, and a statement over all the pairs read the whole copy for as few as 1,000 of them (600 M instructions, as for 10,000). The statement is a semi join of the copy with the arrays
-- of those pairs, so that PostgreSQL hashes the pairs and not the copy, and probes the copy for each pair of a few and reads it once for many. The plans are those of the statements
-- the trigger runs (sift.scope_pairs_gone, sift.scope_pairs_delete), explained from a trigger of the spec's own over the same transition table, with and without statistics of the
-- pair table.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE facts (id serial PRIMARY KEY, dim_a_id int NOT NULL, kind smallint NOT NULL, amount numeric(8,2) NOT NULL);
CREATE TABLE scope_pairs (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (tenant_id, dim_a_id));
CREATE INDEX ON facts (dim_a_id);
-- ids 1 to 6,000 have 10 facts each, ids 6,001 to 12,000 none; every id is in one key, every seventh in a second
INSERT INTO facts (dim_a_id, kind, amount) SELECT 1 + g % 6000, g % 5, g FROM generate_series(1, 60000) g;
INSERT INTO scope_pairs SELECT d, 1 + d % 50 FROM generate_series(1, 12000) d;
INSERT INTO scope_pairs SELECT d, 100 + d % 20 FROM generate_series(1, 12000) d WHERE d % 7 = 0;
CREATE TABLE all_pairs AS SELECT * FROM scope_pairs;
ANALYZE facts, scope_pairs;
SELECT count(*) > 0 AS built FROM (SELECT sift.scope_create('facts_by_tenant', 'facts', 'dim_a_id', 'scope_pairs', 'tenant_id', partition => false)) q;
 built 
-------
 t
(1 row)

VACUUM ANALYZE facts_by_tenant;
CREATE TABLE plans (setting text, edit text, size int, line text);
CREATE TABLE gone (setting text, edit text, size int, pairs int);
CREATE FUNCTION explain_delete() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
	c  sift.scope_copies;
	ms text;
	ks text;
	l  text;
BEGIN
	SELECT * INTO c FROM sift.scope_copies WHERE copy = 'public.facts_by_tenant';
	EXECUTE sift.scope_pairs_gone(c, TG_OP) INTO ms, ks;
	INSERT INTO gone VALUES (current_setting('spec.setting'), current_setting('spec.edit'), current_setting('spec.size')::int, cardinality(ms::int[]));
	IF ms IS NOT NULL THEN
		FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || sift.scope_pairs_delete(c) USING ms, ks LOOP
			INSERT INTO plans VALUES (current_setting('spec.setting'), current_setting('spec.edit'), current_setting('spec.size')::int, l);
		END LOOP;
	END IF;
	RETURN NULL;
END $$;
CREATE TRIGGER explain_delete AFTER DELETE ON scope_pairs REFERENCING OLD TABLE AS old_rows FOR EACH STATEMENT EXECUTE FUNCTION explain_delete();
-- the pair table never analyzed: what a table filled by a bulk load has until autovacuum
CREATE FUNCTION forget_pair_statistics() RETURNS void LANGUAGE sql AS $$
	DELETE FROM pg_statistic WHERE starelid = 'scope_pairs'::regclass;
	UPDATE pg_class SET reltuples = -1, relpages = 0, relallvisible = 0 WHERE oid = 'scope_pairs'::regclass $$;
CREATE TABLE edits (n serial, edit text, size int, stmt text);
INSERT INTO edits (edit, size, stmt) VALUES
	('members with facts', 3,    'DELETE FROM scope_pairs WHERE tenant_id <= 50 AND dim_a_id BETWEEN 1 AND 3'),
	('members with facts', 100,  'DELETE FROM scope_pairs WHERE tenant_id <= 50 AND dim_a_id BETWEEN 101 AND 200'),
	('members with facts', 3000, 'DELETE FROM scope_pairs WHERE tenant_id <= 50 AND dim_a_id BETWEEN 1001 AND 4000'),
	('members without facts', 100,  'DELETE FROM scope_pairs WHERE tenant_id <= 50 AND dim_a_id BETWEEN 6101 AND 6200'),
	('members without facts', 3000, 'DELETE FROM scope_pairs WHERE tenant_id <= 50 AND dim_a_id BETWEEN 7001 AND 10000'),
	('half of them have facts', 2000, 'DELETE FROM scope_pairs WHERE tenant_id <= 50 AND dim_a_id BETWEEN 5001 AND 7000');
CREATE FUNCTION run_edits(setting text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE
	e record;
BEGIN
	PERFORM set_config('spec.setting', setting, false);
	FOR e IN SELECT * FROM edits ORDER BY n LOOP
		PERFORM set_config('spec.edit', e.edit, false), set_config('spec.size', e.size::text, false);
		EXECUTE e.stmt;
		INSERT INTO scope_pairs SELECT * FROM all_pairs ON CONFLICT DO NOTHING;
	END LOOP;
END $$;
SELECT run_edits('with statistics');
 run_edits 
-----------
 
(1 row)

SELECT forget_pair_statistics();
 forget_pair_statistics 
------------------------
 
(1 row)

SELECT run_edits('pair table never analyzed');
 run_edits 
