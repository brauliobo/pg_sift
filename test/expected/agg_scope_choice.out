-- A scope read and the join as written (the first pass of the planner) are two ways to answer one statement, and the one that costs less is the one the node runs. The plan holds both: the
-- scope read, and the join priced at several key counts; the node counts the entries of the keys it really has when it starts (a constant list, a parameter of a prepared statement, the
-- array of a parameter, a table of keys), prices the scope read with the model of the reader (col/scope.h) and runs the join where it costs less (EXPLAIN: Scope Fallback: join is cheaper for
-- N keys). A refusal of the reader (a top-n over changed pairs) is the same choice with its reason, never an error: the join counts a row for each pair of a member in several keys and the
-- units cannot, once the pairs of the member changed. The rows are those of the join and of the normal plan in every form, key count, plan mode and state of the pairs.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET default_statistics_target = 1000;
SET sift.test_scope_patch = off;
-- 1200 members, one of 40 tenants each, 100 events each
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at date, kind text, amount int) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + i % 1200, date '2025-01-01' + i % 300, 'k' || i % 4, i % 100 FROM generate_series(1, 120000) i;
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT i, 1 + i % 40 FROM generate_series(1, 1200) i;
-- the user u has the tenants 1 to u
CREATE TABLE my_keys (user_id int, tenant_id int);
INSERT INTO my_keys SELECT u, g FROM unnest(ARRAY[1, 10, 30]) u, generate_series(1, 30) g WHERE g <= u;
CREATE INDEX tenant_pairs_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, kind, amount) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events, tenant_scope, my_keys;
-- a prepared statement: its name, parameter types and body
CREATE TABLE cforms (name text PRIMARY KEY, types text, body text);
INSERT INTO cforms VALUES
 ('IN, ANY ($1)', 'int[]', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = ANY ($1)) GROUP BY kind$q$),
 ('IN, table of keys, a plan of its own', 'int', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (SELECT tenant_id FROM my_keys WHERE user_id = $1)) GROUP BY kind$q$),
 ('join, ANY ($1), a row for each pair', 'int[]', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id = ANY ($1) GROUP BY kind$q$),
 ('join, table of keys, a row for each pair', 'int', $q$SELECT kind, sum(amount) AS total, count(*) AS n FROM events e JOIN tenant_scope s ON s.dim_a_id = e.dim_a_id WHERE s.tenant_id IN (SELECT tenant_id FROM my_keys WHERE user_id = $1) GROUP BY kind$q$),
 ('top 5 ids, ANY ($1)', 'int[]', $q$SELECT e.dim_a_id, sum(amount) AS total FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = ANY ($1)) GROUP BY e.dim_a_id ORDER BY total DESC, e.dim_a_id LIMIT 5$q$),
 ('latest 5, ANY ($1)', 'int[]', $q$SELECT id, created_at FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = ANY ($1)) ORDER BY created_at DESC, id LIMIT 5$q$);
CREATE FUNCTION prepared(f cforms, stmt text) RETURNS text LANGUAGE sql AS
$$ SELECT 'PREPARE ' || quote_ident(stmt) || '(' || f.types || ') AS ' || f.body $$;
CREATE FUNCTION called(stmt text, args text) RETURNS text LANGUAGE sql AS $$ SELECT 'EXECUTE ' || quote_ident(stmt) || '(' || args || ')' $$;
-- the argument of the keys 1 to k, and of the keys given
CREATE FUNCTION karg(f cforms, k int) RETURNS text LANGUAGE sql AS
$$ SELECT CASE f.types WHEN 'int' THEN k::text ELSE quote_literal((SELECT '{' || string_agg(g::text, ',') || '}' FROM generate_series(1, k) g)) END $$;
CREATE FUNCTION karg(keys int[]) RETURNS text LANGUAGE sql AS $$ SELECT quote_literal(keys::text) $$;
-- what the run did: the keys it had and the choice (the scope read, or the join with its reason)
CREATE FUNCTION run_of(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := '';
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF l ~ 'Scope (Keys|Fallback)' THEN r := r || regexp_replace(l, '^ *Scope ', '') || '; '; END IF;
	END LOOP;
	RETURN rtrim(r, '; ');
END $$;
CREATE FUNCTION rows_md5(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	DROP TABLE IF EXISTS choice_rows;
	EXECUTE 'CREATE TEMP TABLE choice_rows AS ' || q;
	SELECT md5(coalesce(string_agg(t::text, '|' ORDER BY t::text), '')) INTO r FROM choice_rows t;
	DROP TABLE choice_rows;
	RETURN r;
END $$;
-- the rows of a statement prepared under the settings given: the plan of its first execution is the one that runs
CREATE FUNCTION rows_of(f cforms, mode text, agg_scope text, enable_agg text, args text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('plan_cache_mode', mode, false);
	PERFORM set_config('sift.agg_scope', agg_scope, false);
	PERFORM set_config('sift.enable_agg', enable_agg, false);
	DEALLOCATE ALL;
	EXECUTE prepared(f, 'q');
	r := rows_md5(called('q', args));
	DEALLOCATE ALL;
	PERFORM set_config('sift.agg_scope', 'on', false);
	PERFORM set_config('sift.enable_agg', 'on', false);
	RETURN r;
END $$;
-- the choice of one run, and whether its rows are those of the join (sift.agg_scope off) and of the normal plan (sift.enable_agg off)
CREATE FUNCTION outcome(f cforms, mode text, args text, OUT chosen text, OUT why text, OUT same_rows boolean) LANGUAGE plpgsql AS $$
DECLARE r text; a text;
BEGIN
	PERFORM set_config('plan_cache_mode', mode, false);
	DEALLOCATE ALL;
	EXECUTE prepared(f, 'q');
	r := run_of(called('q', args));
	DEALLOCATE ALL;
	chosen := CASE WHEN r ~ 'Fallback' THEN 'join' WHEN r ~ 'Keys' THEN 'scope read' ELSE 'no scope read' END;
	why := coalesce(substring(r from 'Fallback: (.*)'), '');
	a := rows_of(f, mode, 'on', 'on', args);
	same_rows := a = rows_of(f, mode, 'off', 'on', args) AND a = rows_of(f, mode, 'on', 'off', args);
END $$;
-- the plan of a statement: the scope read of every key count, per pair where a row counts once for each pair of a member
CREATE FUNCTION label(f cforms) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; plan text := '';
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', false);
	DEALLOCATE ALL;
	EXECUTE prepared(f, 'q');
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) EXECUTE q(NULL)' LOOP
		plan := plan || l || E'\n';
	END LOOP;
	DEALLOCATE ALL;
	RETURN CASE WHEN plan ~ 'Scope Index' THEN 'scope read, ' || substring(plan from 'Scope Semantics: ([^\n]*)') ELSE 'join' END;
END $$;
SELECT name, label(f) AS plan FROM cforms f ORDER BY name COLLATE "C";
                   name                   |         plan         
------------------------------------------+----------------------
 IN, ANY ($1)                             | scope read, once
 IN, table of keys, a plan of its own     | scope read, once
 join, ANY ($1), a row for each pair      | scope read, per pair
 join, table of keys, a row for each pair | scope read, per pair
 latest 5, ANY ($1)                       | scope read, once
 top 5 ids, ANY ($1)                      | scope read, once
(6 rows)

-- every form at 1, 10 and 30 keys, with the generic plan (the keys are estimated at 10) and the custom plan (the keys of the call): the join where it costs less
SELECT f.name, k.n AS keys, m.mode, o.chosen, o.why, o.same_rows
FROM cforms f, (VALUES (1), (10), (30)) k(n), (VALUES ('force_generic_plan'), ('force_custom_plan')) m(mode), LATERAL outcome(f, m.mode, karg(f, k.n)) o
ORDER BY f.name COLLATE "C", k.n, m.mode;
                   name                   | keys |        mode        |    chosen     |             why             | same_rows 
------------------------------------------+------+--------------------+---------------+-----------------------------+-----------
 IN, ANY ($1)                             |    1 | force_custom_plan  | scope read    |                             | t
