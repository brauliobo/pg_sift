 join, ANY ($1), a row for each pair      |    1 | force_custom_plan  | scope read    |                             | t
 join, ANY ($1), a row for each pair      |    1 | force_generic_plan | scope read    |                             | t
 join, ANY ($1), a row for each pair      |   10 | force_custom_plan  | join          | join is cheaper for 10 keys | t
 join, ANY ($1), a row for each pair      |   10 | force_generic_plan | join          | join is cheaper for 10 keys | t
 join, ANY ($1), a row for each pair      |   30 | force_custom_plan  | join          | join is cheaper for 30 keys | t
 join, ANY ($1), a row for each pair      |   30 | force_generic_plan | join          | join is cheaper for 30 keys | t
 join, table of keys, a row for each pair |    1 | force_custom_plan  | scope read    |                             | t
 join, table of keys, a row for each pair |    1 | force_generic_plan | scope read    |                             | t
 join, table of keys, a row for each pair |   10 | force_custom_plan  | join          | join is cheaper for 10 keys | t
 join, table of keys, a row for each pair |   10 | force_generic_plan | join          | join is cheaper for 10 keys | t
 join, table of keys, a row for each pair |   30 | force_custom_plan  | join          | join is cheaper for 30 keys | t
 join, table of keys, a row for each pair |   30 | force_generic_plan | join          | join is cheaper for 30 keys | t
 latest 5, ANY ($1)                       |    1 | force_custom_plan  | scope read    |                             | t
 latest 5, ANY ($1)                       |    1 | force_generic_plan | scope read    |                             | t
 latest 5, ANY ($1)                       |   10 | force_custom_plan  | join          | join is cheaper for 10 keys | t
 latest 5, ANY ($1)                       |   10 | force_generic_plan | join          | join is cheaper for 10 keys | t
 latest 5, ANY ($1)                       |   30 | force_custom_plan  | join          | join is cheaper for 30 keys | t
 latest 5, ANY ($1)                       |   30 | force_generic_plan | join          | join is cheaper for 30 keys | t
 top 5 ids, ANY ($1)                      |    1 | force_custom_plan  | scope read    |                             | t
 top 5 ids, ANY ($1)                      |    1 | force_generic_plan | scope read    |                             | t
 top 5 ids, ANY ($1)                      |   10 | force_custom_plan  | join          | join is cheaper for 10 keys | t
 top 5 ids, ANY ($1)                      |   10 | force_generic_plan | join          | join is cheaper for 10 keys | t
 top 5 ids, ANY ($1)                      |   30 | force_custom_plan  | join          | join is cheaper for 30 keys | t
 top 5 ids, ANY ($1)                      |   30 | force_generic_plan | join          | join is cheaper for 30 keys | t
(36 rows)

RESET plan_cache_mode;
-- one cached generic plan run with other keys each time: each run makes the choice of its own
CREATE FUNCTION cached_keys(f cforms, counts int[]) RETURNS TABLE (n int, chosen text, same_rows boolean) LANGUAGE plpgsql AS $$
DECLARE r text; a text;
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', false);
	DEALLOCATE ALL;
	EXECUTE prepared(f, 'q');
	FOREACH n IN ARRAY counts LOOP
		r := run_of(called('q', karg(f, n)));
		chosen := CASE WHEN r ~ 'Fallback' THEN 'join' ELSE 'scope read' END;
		a := rows_md5(called('q', karg(f, n)));
		PERFORM set_config('sift.enable_agg', 'off', false);
		EXECUTE prepared(f, 'plain');
		same_rows := a = rows_md5(called('plain', karg(f, n)));
		DEALLOCATE "plain";
		PERFORM set_config('sift.enable_agg', 'on', false);
		RETURN NEXT;
	END LOOP;
	DEALLOCATE ALL;
END $$;
SELECT f.name, c.* FROM cforms f, cached_keys(f, ARRAY[1, 30, 10, 30, 1, 20, 2]) c WHERE f.name IN ('IN, ANY ($1)', 'join, ANY ($1), a row for each pair') ORDER BY f.name COLLATE "C";
                name                 | n  |   chosen   | same_rows 
-------------------------------------+----+------------+-----------
 IN, ANY ($1)                        |  1 | scope read | t
 IN, ANY ($1)                        | 30 | join       | t
 IN, ANY ($1)                        | 10 | join       | t
 IN, ANY ($1)                        | 30 | join       | t
 IN, ANY ($1)                        |  1 | scope read | t
 IN, ANY ($1)                        | 20 | join       | t
 IN, ANY ($1)                        |  2 | scope read | t
 join, ANY ($1), a row for each pair |  1 | scope read | t
 join, ANY ($1), a row for each pair | 30 | join       | t
 join, ANY ($1), a row for each pair | 10 | join       | t
 join, ANY ($1), a row for each pair | 30 | join       | t
 join, ANY ($1), a row for each pair |  1 | scope read | t
 join, ANY ($1), a row for each pair | 20 | join       | t
 join, ANY ($1), a row for each pair |  2 | scope read | t
(14 rows)

RESET plan_cache_mode;
-- the node as the inner side of a nested loop runs more than once: the choice is made again for each rescan, and the rows are the normal plan's
CREATE FUNCTION rescanned(k int) RETURNS TABLE (n int, run text, same_rows boolean) LANGUAGE plpgsql AS $$
DECLARE q text; a text;
BEGIN
	q := 'SELECT k.n, x.kind, x.total FROM generate_series(1, 3) k(n) LEFT JOIN (SELECT kind, sum(amount) AS total FROM events e WHERE e.dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = ANY (ARRAY['
		|| (SELECT string_agg(g::text, ',') FROM generate_series(1, k) g) || '])) GROUP BY kind) x ON true';
	n := k;
	PERFORM set_config('enable_material', 'off', false);
	PERFORM set_config('enable_hashjoin', 'off', false);
	PERFORM set_config('enable_mergejoin', 'off', false);
	PERFORM set_config('enable_memoize', 'off', false);
	run := run_of(q);
	a := rows_md5(q);
	PERFORM set_config('sift.enable_agg', 'off', false);
	same_rows := a = rows_md5(q);
	PERFORM set_config('sift.enable_agg', 'on', false);
	RESET enable_material; RESET enable_hashjoin; RESET enable_mergejoin; RESET enable_memoize;
	RETURN NEXT;
END $$;
SELECT * FROM rescanned(1) UNION ALL SELECT * FROM rescanned(30) ORDER BY n;
 n  |                       run                       | same_rows 
----+-------------------------------------------------+-----------
  1 | Keys: 1                                         | t
 30 | Keys: 30; Fallback: join is cheaper for 30 keys | t
(2 rows)

-- the pairs change: the keys of a tenant leave and return (the changed pairs of its members, which the units of the scope read patch), the members of many tenants do, the members have
-- pairs of other tenants (a row for each pair is then several rows of the member). The keys of the run: one tenant, four tenants, thirty.
CREATE FUNCTION churn(n int, only_tenant int DEFAULT NULL) RETURNS void LANGUAGE sql AS $$
	WITH d AS (DELETE FROM tenant_scope WHERE ctid IN (SELECT ctid FROM (SELECT ctid, row_number() OVER (PARTITION BY tenant_id ORDER BY dim_a_id) r FROM tenant_scope
													  WHERE only_tenant IS NULL OR tenant_id = only_tenant) x WHERE r <= n) RETURNING dim_a_id, tenant_id)
	INSERT INTO tenant_scope SELECT * FROM d
$$;
CREATE FUNCTION states(note text) RETURNS TABLE (state text, form text, tenants text, chosen text, why text, same_rows boolean) LANGUAGE plpgsql AS $$
DECLARE f cforms; kt text; k int[]; o record;
BEGIN
	FOR f IN SELECT * FROM cforms c WHERE c.name IN ('IN, ANY ($1)', 'join, ANY ($1), a row for each pair', 'latest 5, ANY ($1)') ORDER BY c.name COLLATE "C" LOOP
		FOR kt IN SELECT unnest(ARRAY['{22}', '{1,2,3,4}', (SELECT '{' || string_agg(g::text, ',') || '}' FROM generate_series(1, 30) g)]) LOOP
			k := kt::int[];
			SELECT * INTO o FROM outcome(f, 'force_generic_plan', karg(k));
			state := note;
			form := f.name;
			tenants := cardinality(k) || CASE WHEN k = ARRAY[22] THEN ' (22)' ELSE '' END;
			chosen := o.chosen;
			why := o.why;
			same_rows := o.same_rows;
			RETURN NEXT;
		END LOOP;
	END LOOP;
END $$;
SELECT * FROM states('built');
