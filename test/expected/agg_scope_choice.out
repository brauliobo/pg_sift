RESET plan_cache_mode;
-- the keys by the rows of a table, and several keys of a row for each pair, over the pairs changed
SELECT f.name, o.* FROM cforms f, LATERAL outcome(f, 'force_generic_plan', karg(f, 10)) o WHERE f.name IN ('IN, table of keys, a plan of its own', 'join, table of keys, a row for each pair', 'join, ANY ($1), a row for each pair') ORDER BY f.name COLLATE "C";
                   name                   | chosen |             why             | same_rows 
