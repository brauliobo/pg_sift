(6 rows)

RESET sift.agg_scope;
RESET plan_cache_mode;
DROP FUNCTION states(text), churn(int, int), rescanned(int), cached_keys(cforms, int[]), label(cforms), outcome(cforms, text, text), rows_of(cforms, text, text, text, text), rows_md5(text),
	run_of(text), karg(int[]), karg(cforms, int), called(text, text), prepared(cforms, text);
DROP TABLE cforms, events, tenant_scope, my_keys;
DROP EXTENSION pg_sift;
