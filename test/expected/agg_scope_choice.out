(3 rows)

RESET plan_cache_mode;
-- the switch: with sift.agg_scope off the join runs as written
SET sift.agg_scope = off;
SELECT name, label(f) AS plan FROM cforms f ORDER BY name COLLATE "C";
                   name                   | plan 
------------------------------------------+------
