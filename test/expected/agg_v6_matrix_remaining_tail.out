-- The last variants of the format matrix that Format 1 pushes and Format 2.0 left to PostgreSQL: ORDER BY .. LIMIT past the Top-N cap. Every statement answers the rows the heap answers with
-- sift.enable_agg = off, on a sift_col index and on a sift_table; plan_ok prints t when it ran as SiftAggV6 (the Top-N node or the aggregate node).
-- requires: build col
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_sift;
SET sift.test_create_format1 = off;
SET sift.agg_force = on;
SET seq_page_cost = 10000;
SET random_page_cost = 10000;
CREATE TABLE th (id int PRIMARY KEY, cat int, a int, b float8, t text) WITH (autovacuum_enabled = false);
INSERT INTO th SELECT g, g % 40, CASE WHEN g % 11 = 0 THEN NULL ELSE (g * 7919) % 1000 END, CASE WHEN g % 13 = 0 THEN NULL ELSE (g % 50) - 20.5 END, 'k' || g % 9
FROM generate_series(1, 3000) g;
CREATE TABLE tc (LIKE th INCLUDING ALL) WITH (autovacuum_enabled = false);
CREATE TABLE tt (LIKE th INCLUDING ALL) USING sift_table WITH (autovacuum_enabled = false);
INSERT INTO tc SELECT * FROM th;
INSERT INTO tt SELECT * FROM th;
CREATE INDEX tc_col ON tc USING sift_col (id, cat, a, b, t);
SELECT sift.table_maintain('tt') IS NOT NULL AS maintained;
 maintained 
------------
 t
(1 row)

ANALYZE th; ANALYZE tc; ANALYZE tt;
CREATE FUNCTION rows_of(q text, agg boolean) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('sift.enable_agg', CASE WHEN agg THEN 'on' ELSE 'off' END, true);
	EXECUTE format('SELECT coalesce(string_agg(r::text, E''\n''), '''') FROM (%s) r', q) INTO r;
	PERFORM set_config('sift.enable_agg', 'on', true);
	RETURN r;
END $$;
CREATE FUNCTION parity(q text) RETURNS boolean LANGUAGE sql AS $$ SELECT rows_of(q, true) = rows_of(q, false) $$;
CREATE FUNCTION plan_ok(q text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE line text; n int := 0;
BEGIN
	FOR line IN EXECUTE 'EXPLAIN (COSTS off) ' || q LOOP n := n + (line LIKE '%SiftAggV6%')::int; END LOOP;
	RETURN n >= 1;
END $$;
-- LIMIT past the cap of the Top-N tournament (100000 rows): the node sorts the rows it reads, as it does for a limit it is given as a parameter
CREATE TEMP TABLE l_cases (n int, q text);
INSERT INTO l_cases VALUES
	(1, 'SELECT id, a FROM %s WHERE cat < 30 ORDER BY a DESC, id LIMIT 100001'),
	(2, 'SELECT id, a FROM %s WHERE cat < 30 ORDER BY a DESC, id LIMIT 1000000'),
	(3, 'SELECT id, a FROM %s WHERE cat < 30 ORDER BY a DESC, id LIMIT 99990 OFFSET 11'),
	(4, 'SELECT id, a FROM %s ORDER BY a NULLS FIRST, id DESC LIMIT 200000 OFFSET 5'),
	(5, 'SELECT id, b FROM %s WHERE cat > 10 ORDER BY b DESC NULLS LAST, id LIMIT 150000'),
	(6, 'SELECT id, a FROM %s ORDER BY a, id FETCH FIRST 150000 ROWS WITH TIES'),
	(7, 'SELECT id, a FROM %s WHERE cat < 0 ORDER BY a, id LIMIT 100001');
SELECT n, parity(format(q, 'tc')) AS index_rows, parity(format(q, 'tt')) AS table_rows, plan_ok(format(q, 'tc')) AS index_plan FROM l_cases ORDER BY n;
 n | index_rows | table_rows | index_plan 
---+------------+------------+------------
 1 | t          | t          | t
 2 | t          | t          | t
 3 | t          | t          | t
 4 | t          | t          | t
 5 | t          | t          | t
 6 | t          | t          | t
 7 | t          | t          | t
(7 rows)

DROP FUNCTION rows_of(text, boolean), parity(text), plan_ok(text);
DROP TABLE th, tc, tt;
DROP EXTENSION pg_sift;
