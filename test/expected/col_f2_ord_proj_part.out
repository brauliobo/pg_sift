 (7, 'SELECT id, k FROM rp_b_p WHERE k BETWEEN 100 AND 5000 ORDER BY k, id LIMIT 700', 'SELECT id, k FROM rp_b_p WHERE k BETWEEN 100 AND 5000 ORDER BY k + 0, id LIMIT 700'),
