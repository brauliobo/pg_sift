SELECT n, (rp_b_prun(q, h)).* FROM rp_b_pq WHERE n IN (1, 5, 6) ORDER BY n;
 n | rows | agree |       node       |         source         | index_only | fetched 
---+------+-------+------------------+------------------------+------------+---------
 1 |   10 | t     | SiftProjSortScan | relation, bounded sort | t          | f
 5 |    1 | t     | SiftProjSortScan | relation, bounded sort | t          | f
 6 |   10 | t     | SiftProjSortScan | relation, bounded sort | t          | f
(3 rows)

-- after a vacuum: the changed parts are rebuilt and the projection serves them again
VACUUM rp_b_p;
SELECT n, (rp_b_prun(q, h)).* FROM rp_b_pq WHERE n IN (1, 2, 3, 5, 6, 7, 9, 10, 11, 12) ORDER BY n;
