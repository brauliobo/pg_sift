-------------------
 t
(1 row)

VACUUM rp_b_p;
INSERT INTO rp_b_p SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE ((i::int8 * 7919) % 100003)::int END, i % 50 FROM generate_series(8001, 16000) i;
VACUUM rp_b_p;
INSERT INTO rp_b_p SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE ((i::int8 * 7919) % 100003)::int END, i % 50 FROM generate_series(16001, 20000) i;
