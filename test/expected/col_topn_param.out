RESET tp.workers;
-- a btree on the key and the order answers each probe in less time than the scan does (the price of the scan for a key is a scan of a unit): the plan keeps it
CREATE INDEX tp_dev_ts ON tp (dev, ts);
ANALYZE tp;
SELECT tp_mode(true);
 tp_mode 
---------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT d.k, x.id FROM generate_series(1, 5) d(k) CROSS JOIN LATERAL (SELECT id FROM tp WHERE dev = d.k ORDER BY ts DESC, id LIMIT 3) x;
                         QUERY PLAN                          
-------------------------------------------------------------
 Nested Loop
   ->  Function Scan on generate_series d
   ->  Limit
         ->  Incremental Sort
               Sort Key: tp.ts DESC, tp.id
               Presorted Key: tp.ts
               ->  Index Scan Backward using tp_dev_ts on tp
                     Index Cond: (dev = d.k)
(8 rows)

DROP INDEX tp_dev_ts;
ANALYZE tp;
-- a generic plan: one plan for every key, the limit a parameter of the statement (plpgsql keeps the plan of its statement)
CREATE FUNCTION tp_gen(keys int[], lim int) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	RETURN (SELECT md5(string_agg(d.k || ':' || x.id, ',' ORDER BY d.ord, x.ts DESC, x.id))
			FROM unnest(keys) WITH ORDINALITY d(k, ord) CROSS JOIN LATERAL (SELECT id, ts FROM tp WHERE dev = d.k ORDER BY ts DESC, id LIMIT lim) x);
END $$;
SET plan_cache_mode = force_generic_plan;
SELECT tp_mode(true);
 tp_mode 
---------
 
(1 row)

PREPARE tp_p (int[], int) AS
	SELECT d.k, x.id FROM unnest($1) d(k) CROSS JOIN LATERAL (SELECT id, ts FROM tp WHERE dev = d.k ORDER BY ts DESC, id LIMIT $2) x;
EXPLAIN (COSTS OFF) EXECUTE tp_p(ARRAY[5, 3], 4);
                      QUERY PLAN                       
-------------------------------------------------------
 Nested Loop
   ->  Function Scan on unnest d
   ->  Limit
         ->  Custom Scan (SiftAgg)
               Index: tp_col
               Filters: dev = $0
               Top-N: ts DESC, id (limit by parameter)
(7 rows)

