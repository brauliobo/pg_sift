-- A top-N of the scan (ORDER BY .. LIMIT, the latest rows of a tenant) reads the scope units less the members whose pairs changed, and the delta (the rows of the write buffers and those of the changed
-- members, copied for each pair) as units of the same scan, so its heap takes the rows of both under the sort and the tie rule of the join. Every state of the pairs and of the facts, every shape of the
-- sort (ties, mixed directions, an offset, an output the sort does not read, a sort expression, a condition besides the tenant), md5 equal to stock PostgreSQL, and whether the units were read.
-- The second half: an index that keeps only some columns of its units (cols(..)) answers a top-N whose output the units give only when they hold every column it reads, and the join says why otherwise.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
\ir test/scope_helpers.sql
\set ECHO none
-- 10 tenants of 36 members, one in seven of them in a second tenant; the facts of a member are dated around its own date, in minutes of two days, so that the times tie
CREATE TABLE tenant_scope (dim_a_id int NOT NULL, tenant_id int NOT NULL, PRIMARY KEY (dim_a_id, tenant_id)) WITH (autovacuum_enabled = false);
INSERT INTO tenant_scope SELECT i, 1 + i % 10 FROM generate_series(1, 360) i;
INSERT INTO tenant_scope SELECT i, 1 + (i * 3 + 1) % 10 FROM generate_series(1, 360) i WHERE i % 7 = 0 ON CONFLICT DO NOTHING;
CREATE INDEX tenant_scope_journal ON tenant_scope USING sift_col (dim_a_id, tenant_id) WITH (track_changes = 'ctid');
CREATE TABLE events (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, v int, pad text) WITH (autovacuum_enabled = false);
INSERT INTO events SELECT i, 1 + (i * 7919) % 400, timestamptz '2026-01-01' + (hashint4(1 + (i * 7919) % 400) & 255) * interval '1 day' + (i % 2880) * interval '1 minute', i % 10, repeat('x', 40)
	FROM generate_series(1, 20000) i;
CREATE INDEX events_col ON events USING sift_col (id, dim_a_id, created_at, v) WITH (scope = 'tenant_id: dim_a_id -> tenant_scope(dim_a_id, tenant_id)');
REINDEX INDEX events_col;
VACUUM (FREEZE, ANALYZE) events, tenant_scope;
SET sift.test_scope_patch = on;
CREATE TABLE shapes (n int, label text, q text);
INSERT INTO shapes VALUES
	(1, 'latest 20',                    'SELECT id, created_at FROM events e WHERE @ ORDER BY created_at DESC, id DESC LIMIT 20'),
	(2, 'latest 20, an output',         'SELECT id, v, created_at FROM events e WHERE @ ORDER BY created_at DESC, id DESC LIMIT 20'),
	(3, 'by id, an output',             'SELECT id, v FROM events e WHERE @ ORDER BY id DESC LIMIT 25'),
	(4, 'oldest 20, mixed directions',  'SELECT id, created_at FROM events e WHERE @ ORDER BY created_at ASC, id DESC LIMIT 20'),
	(5, 'two tenants',                  'SELECT id, created_at FROM events e WHERE dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id IN (3, 5)) ORDER BY created_at DESC, id DESC LIMIT 20'),
	(6, 'an offset',                    'SELECT id, created_at FROM events e WHERE @ ORDER BY created_at DESC, id DESC LIMIT 10 OFFSET 7'),
	(7, 'a condition',                  'SELECT id, created_at, v FROM events e WHERE @ AND v > 3 ORDER BY created_at DESC, id DESC LIMIT 20'),
	(8, 'a sort expression',            'SELECT id, v FROM events e WHERE @ ORDER BY abs(v - 5) DESC, id LIMIT 15'),
	(9, 'ties, the time alone',         'SELECT id FROM events e WHERE @ ORDER BY created_at DESC, id LIMIT 12');
CREATE FUNCTION probe() RETURNS TABLE (n int, label text, verdict text, route text, patched boolean) LANGUAGE sql AS $$
	SELECT s.n, s.label, CASE r.same WHEN true THEN 'same' ELSE 'DIFFERENT' END, coalesce(r.why, CASE WHEN r.stored THEN 'units' ELSE 'no units' END), r.patched
	FROM shapes s, LATERAL scope_run(replace(s.q, '@', 'dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 3)'), replace(s.q, '@', 'dim_a_id IN (SELECT dim_a_id FROM tenant_scope WHERE tenant_id = 3)')) r
	ORDER BY s.n
$$;
-- each state: the statement that makes it (they accumulate), and then the reads
CREATE TABLE states (n int, label text, stmt text);
INSERT INTO states VALUES
	(1, 'buffered inserts, the newest rows of the tenant and of others, tied in time',
		'INSERT INTO events SELECT 30000 + i, 1 + (i * 37) % 400, timestamptz ''2026-12-01'' + (i % 5) * interval ''1 minute'', i % 10, ''y'' FROM generate_series(1, 400) i'),
	(2, 'pairs added: ids with the newest rows join the tenant',
		'INSERT INTO tenant_scope SELECT m, 3 FROM generate_series(371, 400) m ON CONFLICT DO NOTHING; INSERT INTO tenant_scope SELECT m, 3 FROM generate_series(1, 40) m WHERE m % 10 <> 3 ON CONFLICT DO NOTHING'),
	(3, 'pairs removed: ids with the newest rows leave the tenant',
		'DELETE FROM tenant_scope WHERE tenant_id = 3 AND dim_a_id % 4 = 1'),
	(4, 'a member moved to another tenant',
		'WITH d AS (DELETE FROM tenant_scope WHERE tenant_id = 3 AND dim_a_id % 9 = 2 RETURNING dim_a_id) INSERT INTO tenant_scope SELECT dim_a_id, 8 FROM d ON CONFLICT DO NOTHING'),
	(5, 'the newest facts deleted, moved in time, moved to other ids',
		'DELETE FROM events WHERE id > 30000 AND id % 3 = 0; UPDATE events SET created_at = created_at + interval ''400 days'' WHERE id > 30000 AND id % 11 = 0; UPDATE events SET dim_a_id = 3 + 10 * (id % 30) WHERE id BETWEEN 100 AND 400'),
	(6, 'promoted: the buffers are in the segments, the pairs that changed still patch',
		'SELECT sift.col_promote(''events_col'')'),
	(7, 'buffered inserts after the promotion',
		'INSERT INTO events SELECT 31000 + i, 1 + (i * 17) % 400, timestamptz ''2026-12-02'', i % 10, ''w'' FROM generate_series(1, 150) i'),
	(8, 'merged',
		'SELECT sift.col_merge(''events_col'', true)'),
	(9, 'deletes of the newest rows',
		'DELETE FROM events WHERE id % 13 = 0 AND id > 20000'),
	(10, 'vacuumed',
		'VACUUM events');
\echo clean
clean
SELECT * FROM probe();
 n |            label            | verdict | route | patched 
---+-----------------------------+---------+-------+---------
 1 | latest 20                   | same    | units | f
