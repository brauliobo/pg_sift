-- SiftAggV6 over an index of format major 2, the statements the aggregate scan takes beyond constants and a bare table: parameters of a generic plan, a partial index, windows and DISTINCT ON above
-- the groups, stddev, variance, bool_or, bool_and and min and max of a text, <>, a join whose fact table the filter of its dimension prunes, a table under row security, and date_trunc of a date.
-- Every query is run with the node and without it (sift.enable_agg) and the two answers are compared; the first word says they agree, the second that the plan is the node's.
CREATE EXTENSION IF NOT EXISTS pg_sift;
SET sift.test_create_format1 = off;
SET sift.agg_force = on;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET timezone = 'UTC';
CREATE TABLE pw (id int PRIMARY KEY, g int, t text COLLATE "C", v bigint, f float8, h float8, d date, ts timestamptz, b bool, n int, deleted_at timestamptz) WITH (autovacuum_enabled = false);
INSERT INTO pw SELECT i, i % 7, CASE WHEN i % 11 = 0 THEN NULL ELSE 'key' || (i % 13) || repeat('x', i % 20) END, CASE WHEN i % 17 = 0 THEN NULL ELSE i * 3 END,
	i % 1000, (i % 1000) * 0.37, DATE '2020-01-01' + (i % 400), TIMESTAMPTZ '2021-01-01' + i * interval '1 hour', CASE WHEN i % 19 = 0 THEN NULL ELSE i % 3 = 0 END, i % 100,
	CASE WHEN i % 10 = 0 THEN TIMESTAMPTZ '2022-01-01' END FROM generate_series(1, 30000) i;
CREATE INDEX pw_col ON pw USING sift_col (g, t, v, f, h, d, ts, b, n, id);
CREATE INDEX pw_live ON pw USING sift_col (g, v, n, id) WHERE deleted_at IS NULL;
UPDATE pw SET v = v + 1 WHERE id % 50 = 0;
DELETE FROM pw WHERE id % 97 = 0;
VACUUM pw;
ANALYZE pw;
INSERT INTO pw SELECT i, i % 7, 'new' || i, i, i, i, DATE '2022-01-01', TIMESTAMPTZ '2022-01-01', true, 5, NULL FROM generate_series(30001, 30500) i;
CREATE FUNCTION answer(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	IF q ~* '^execute' THEN
		EXECUTE 'CREATE TEMP TABLE same_r AS ' || q;
		q := 'SELECT * FROM same_r';
	END IF;
	EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (' || q || ') r' INTO r;
	DROP TABLE IF EXISTS pg_temp.same_r;
	RETURN r;
END $$;
CREATE FUNCTION same(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE a text; b text; plan text := ''; l text;
BEGIN
	SET LOCAL sift.enable_agg = on;
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || l; END LOOP;
	a := answer(q);
	SET LOCAL sift.enable_agg = off;
	b := answer(q);
	RETURN (CASE WHEN a IS DISTINCT FROM b THEN 'DIFFERENT' ELSE 'same' END) || ' ' || (CASE WHEN plan LIKE '%SiftAggV6%' THEN 'node' ELSE 'normal' END) || ' ' || q;
END $$;
-- Q-A01. A parameter of a generic plan is read when the scan starts, and again at every rescan: the answer follows the value
SET plan_cache_mode = force_generic_plan;
PREPARE by_n(int) AS SELECT g, count(*), sum(v) FROM pw WHERE n > $1 GROUP BY g;
PREPARE by_ids(int, int) AS SELECT count(*), min(id), max(id) FROM pw WHERE id >= $1 AND id < $2;
SELECT same(q) FROM unnest(ARRAY['EXECUTE by_n(50)', 'EXECUTE by_n(98)', 'EXECUTE by_n(1000)', 'EXECUTE by_ids(100, 200)', 'EXECUTE by_ids(29000, 31000)']) q;
                  same                  
----------------------------------------
 same node EXECUTE by_n(50)
 same node EXECUTE by_n(98)
 same node EXECUTE by_n(1000)
 same node EXECUTE by_ids(100, 200)
 same node EXECUTE by_ids(29000, 31000)
(5 rows)

EXECUTE by_n(NULL);
 g | count | sum 
---+-------+-----
(0 rows)

SELECT same('SELECT l.k, (SELECT count(*) FROM pw WHERE n > l.k) FROM generate_series(1, 5) l(k)');
                                             same                                              
-----------------------------------------------------------------------------------------------
 same node SELECT l.k, (SELECT count(*) FROM pw WHERE n > l.k) FROM generate_series(1, 5) l(k)
(1 row)

SELECT same('SELECT g, count(*) FROM pw WHERE n > (SELECT max(n) / 2 FROM pw) GROUP BY g');
                                         same                                          
---------------------------------------------------------------------------------------
 same node SELECT g, count(*) FROM pw WHERE n > (SELECT max(n) / 2 FROM pw) GROUP BY g
(1 row)

RESET plan_cache_mode;
-- Q-A02. A partial index answers the query whose clauses imply its predicate, and no other
SELECT same(q) FROM unnest(ARRAY[
	'SELECT g, count(*), sum(v) FROM pw WHERE deleted_at IS NULL GROUP BY g',
	'SELECT g, count(*) FROM pw WHERE deleted_at IS NULL AND n > 50 GROUP BY g',
	'SELECT count(*) FROM pw'
]) q;
                                        same                                         
-------------------------------------------------------------------------------------
 same node SELECT g, count(*), sum(v) FROM pw WHERE deleted_at IS NULL GROUP BY g
 same node SELECT g, count(*) FROM pw WHERE deleted_at IS NULL AND n > 50 GROUP BY g
 same node SELECT count(*) FROM pw
(3 rows)

-- Q-A03. Windows and DISTINCT ON above the groups
SELECT same(q) FROM unnest(ARRAY[
	'SELECT g, sum(v), rank() OVER (ORDER BY sum(v)) FROM pw GROUP BY g',
	'SELECT g, count(*), sum(count(*)) OVER () FROM pw GROUP BY g',
	'SELECT DISTINCT ON (g) g, count(*) FROM pw GROUP BY g ORDER BY g, count(*) DESC'
]) q;
                                            same                                             
---------------------------------------------------------------------------------------------
 same normal SELECT g, sum(v), rank() OVER (ORDER BY sum(v)) FROM pw GROUP BY g
 same normal SELECT g, count(*), sum(count(*)) OVER () FROM pw GROUP BY g
 same normal SELECT DISTINCT ON (g) g, count(*) FROM pw GROUP BY g ORDER BY g, count(*) DESC
(3 rows)

-- Q-A04. stddev, variance, bool_or, bool_and of floats and booleans, min and max of a text in the C collation (a collation that sorts otherwise is the executor's)
SELECT same(q) FROM unnest(ARRAY[
	'SELECT g, round(stddev(f)::numeric, 3), round(stddev_pop(f)::numeric, 3), round(variance(f)::numeric, 3), round(var_pop(f)::numeric, 3), round(var_samp(f)::numeric, 3) FROM pw GROUP BY g',
	'SELECT g, round(stddev(h)::numeric, 6), round(var_pop(h)::numeric, 6) FROM pw GROUP BY g',
	'SELECT g, stddev_pop(n::float8), var_samp(n::float8) FROM pw GROUP BY g',
	'SELECT stddev(f), var_pop(f) FROM pw WHERE n > 1000',
	'SELECT g, bool_or(b), bool_and(b), every(b) FROM pw GROUP BY g',
	'SELECT g, min(t), max(t) FROM pw GROUP BY g',
	'SELECT min(t), max(t), count(t) FROM pw WHERE n < 0',
	'SELECT g, min(t COLLATE "en-x-icu"), max(t COLLATE "en-x-icu") FROM pw GROUP BY g'
]) q;
                                                                                                 same                                                                                                 
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 same node SELECT g, round(stddev(f)::numeric, 3), round(stddev_pop(f)::numeric, 3), round(variance(f)::numeric, 3), round(var_pop(f)::numeric, 3), round(var_samp(f)::numeric, 3) FROM pw GROUP BY g
 same node SELECT g, round(stddev(h)::numeric, 6), round(var_pop(h)::numeric, 6) FROM pw GROUP BY g
 same normal SELECT g, stddev_pop(n::float8), var_samp(n::float8) FROM pw GROUP BY g
 same node SELECT stddev(f), var_pop(f) FROM pw WHERE n > 1000
 same node SELECT g, bool_or(b), bool_and(b), every(b) FROM pw GROUP BY g
 same node SELECT g, min(t), max(t) FROM pw GROUP BY g
 same node SELECT min(t), max(t), count(t) FROM pw WHERE n < 0
 same normal SELECT g, min(t COLLATE "en-x-icu"), max(t COLLATE "en-x-icu") FROM pw GROUP BY g
(8 rows)

-- Q-A05. <> of an integer, a text, a date and a boolean, the NULLs it leaves out
SELECT same(q) FROM unnest(ARRAY[
	'SELECT g, count(*) FROM pw WHERE n <> 5 GROUP BY g',
	'SELECT g, count(*) FROM pw WHERE t <> ''key3'' GROUP BY g',
	'SELECT g, count(*) FROM pw WHERE d <> DATE ''2020-06-01'' GROUP BY g',
	'SELECT g, count(*) FROM pw WHERE b <> true GROUP BY g',
	'SELECT g, count(*) FROM pw WHERE v <> 3::bigint AND n <> 5 GROUP BY g'
]) q;
                                      same                                       
---------------------------------------------------------------------------------
 same node SELECT g, count(*) FROM pw WHERE n <> 5 GROUP BY g
 same node SELECT g, count(*) FROM pw WHERE t <> 'key3' GROUP BY g
 same node SELECT g, count(*) FROM pw WHERE d <> DATE '2020-06-01' GROUP BY g
 same normal SELECT g, count(*) FROM pw WHERE b <> true GROUP BY g
 same node SELECT g, count(*) FROM pw WHERE v <> 3::bigint AND n <> 5 GROUP BY g
(5 rows)

-- Q-A06. A join with a dimension: its filter prunes the fact table (the paths of the join are those of the planner; the answers are PostgreSQL's)
CREATE TABLE pd (k int PRIMARY KEY, label text, region int);
INSERT INTO pd SELECT i, 'name' || i, i % 4 FROM generate_series(0, 99) i;
ANALYZE pd;
SELECT same(q) FROM unnest(ARRAY[
	'SELECT d.label, count(*), sum(f.v) FROM pw f JOIN pd d ON d.k = f.n WHERE d.region = 1 GROUP BY d.label',
	'SELECT d.region, count(*), avg(f.f) FROM pw f JOIN pd d ON d.k = f.n GROUP BY d.region',
	'SELECT count(*) FROM pw f JOIN pd d ON d.k = f.n AND d.label = ''name7'''
]) q;
                                                       same                                                        
-------------------------------------------------------------------------------------------------------------------
 same node SELECT d.label, count(*), sum(f.v) FROM pw f JOIN pd d ON d.k = f.n WHERE d.region = 1 GROUP BY d.label
 same node SELECT d.region, count(*), avg(f.f) FROM pw f JOIN pd d ON d.k = f.n GROUP BY d.region
 same node SELECT count(*) FROM pw f JOIN pd d ON d.k = f.n AND d.label = 'name7'
(3 rows)

-- Q-A07. date_trunc of a date (PostgreSQL reads the date as a timestamptz), in a filter and in a key
SELECT same(q) FROM unnest(ARRAY[
	'SELECT date_trunc(''month'', d) AS m, count(*) FROM pw GROUP BY 1',
	'SELECT date_trunc(''year'', d), date_trunc(''week'', d), date_trunc(''day'', d), date_trunc(''hour'', d) FROM pw GROUP BY 1, 2, 3, 4',
	'SELECT count(*) FROM pw WHERE date_trunc(''quarter'', d) = TIMESTAMPTZ ''2020-04-01''',
	'SELECT g, count(*) FROM pw WHERE date_trunc(''month'', d) >= TIMESTAMPTZ ''2020-06-01'' GROUP BY g'
]) q;
                                                                   same                                                                   
------------------------------------------------------------------------------------------------------------------------------------------
 same normal SELECT date_trunc('month', d) AS m, count(*) FROM pw GROUP BY 1
 same normal SELECT date_trunc('year', d), date_trunc('week', d), date_trunc('day', d), date_trunc('hour', d) FROM pw GROUP BY 1, 2, 3, 4
 same normal SELECT count(*) FROM pw WHERE date_trunc('quarter', d) = TIMESTAMPTZ '2020-04-01'
 same normal SELECT g, count(*) FROM pw WHERE date_trunc('month', d) >= TIMESTAMPTZ '2020-06-01' GROUP BY g
(4 rows)

SET timezone = 'America/Sao_Paulo';
SELECT same('SELECT date_trunc(''month'', d), count(*) FROM pw GROUP BY 1');
                                  same                                  
------------------------------------------------------------------------
 same normal SELECT date_trunc('month', d), count(*) FROM pw GROUP BY 1
(1 row)

SET timezone = 'UTC';
-- Q-A08. Row security: the scan of the index would count the rows of every tenant, so the aggregate is the executor's and sees only the rows of the policy
CREATE ROLE sift_parity_tenant NOLOGIN;
CREATE TABLE pr (id int PRIMARY KEY, tenant int, v int);
INSERT INTO pr SELECT i, i % 3, i FROM generate_series(1, 3000) i;
CREATE INDEX pr_col ON pr USING sift_col (tenant, v, id);
ANALYZE pr;
GRANT SELECT ON pr TO sift_parity_tenant;
ALTER TABLE pr ENABLE ROW LEVEL SECURITY;
CREATE POLICY own ON pr FOR SELECT TO sift_parity_tenant USING (tenant = 1);
SET ROLE sift_parity_tenant;
SELECT same(q) FROM unnest(ARRAY['SELECT count(*), sum(v) FROM pr', 'SELECT tenant, count(*) FROM pr GROUP BY tenant']) q;
                            same                             
-------------------------------------------------------------
 same normal SELECT count(*), sum(v) FROM pr
 same normal SELECT tenant, count(*) FROM pr GROUP BY tenant
(2 rows)

SELECT count(*), sum(v) FROM pr;
 count |   sum   
-------+---------
  1000 | 1499500
(1 row)

RESET ROLE;
SELECT same('SELECT tenant, count(*) FROM pr GROUP BY tenant');
                           same                            
-----------------------------------------------------------
 same node SELECT tenant, count(*) FROM pr GROUP BY tenant
(1 row)

DROP TABLE pr, pd, pw;
DROP ROLE sift_parity_tenant;
DROP FUNCTION same(text);
DROP FUNCTION answer(text);
DROP EXTENSION pg_sift;
