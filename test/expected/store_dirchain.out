DROP TABLE dr;
DROP TABLE dm;
DROP TABLE model;
DROP FUNCTION step(text, int, int, int8);
DROP FUNCTION run(int, int);
DROP PROCEDURE edits(int);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
