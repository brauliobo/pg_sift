DROP TABLE sw_dict;
DROP TABLE sw, sw_pat;
DROP FUNCTION sw_check(text), agg_pushed(text), agg_rows(text, bool);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
