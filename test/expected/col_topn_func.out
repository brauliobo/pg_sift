-- ORDER BY <a function of the columns> LIMIT n: concatenations, nested functions, functions with a string result (left, substr, initcap, md5, ...), numeric and date
-- functions, a function of the user's (plpgsql, immutable) and a parameter of a generic plan. The scan runs PostgreSQL's own expression evaluator for every row that
-- passes the WHERE, so the functions, their errors and the collation of their string results are the backend's. Every query runs twice, the plain plan as the reference
-- (sift.enable_agg off) and the pushed one, and the rows are compared in order. A parameter of the statement or a function that is not parallel safe keeps the scan
-- in the leader (no workers); an expression that is not immutable keeps the normal plan.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET sift.async_maintenance = off;
CREATE TABLE tb (id int PRIMARY KEY, g int, a int, b bigint, c smallint, f float8, n numeric(12,2), m numeric(18,0), d date, t timestamp, s text, v varchar(12), u uuid);
INSERT INTO tb
SELECT i, i % 7,
	CASE WHEN i % 4000 < 900 THEN NULL WHEN i = 17000 THEN 2147483647 WHEN i = 21000 THEN -2147483648 ELSE i / 3 END,
	CASE WHEN i % 11 = 0 THEN NULL WHEN i % 997 = 0 THEN 9223372036854775807 WHEN i % 991 = 0 THEN -9223372036854775807 - 1 ELSE (i * 104729::bigint) % 1000003 - 500000 END,
	CASE WHEN i % 5 = 0 THEN NULL WHEN i % 101 = 0 THEN 32767 WHEN i % 103 = 0 THEN -32768 ELSE (i * 37) % 2000 - 1000 END,
	CASE WHEN i % 17 = 0 THEN NULL WHEN i % 1009 = 0 THEN 'NaN' WHEN i % 1013 = 0 THEN 'Infinity' WHEN i % 1021 = 0 THEN '-0' ELSE ((i * 7919) % 20001 - 10000) / 7.0 END,
	CASE WHEN i % 7 = 0 THEN NULL WHEN i % 997 = 0 THEN 9999999999.99 ELSE ((i * 37) % 4001 - 2000) / 7.0 END,
	CASE WHEN i % 23 = 0 THEN NULL ELSE (i * 1000003::bigint) % 100000 - 50000 END,
	CASE WHEN i % 9 = 0 THEN NULL WHEN i % 5003 = 0 THEN 'infinity' ELSE DATE '2020-01-01' + (i / 40) END,
	CASE WHEN i % 3 = 0 THEN NULL ELSE TIMESTAMP '2020-01-01' + (i % 7000) * interval '29 minutes' END,
	CASE WHEN i % 17 = 0 THEN NULL WHEN i % 23 = 0 THEN ''
		ELSE (ARRAY['Zed','apple','Apple','banana','éclair','Ärger','b','B','a b','a-b','z','10','9','ß','ss','日本','é日','_x','  ','İstanbul'])[1 + i % 20] || (i % 211) END,
	CASE WHEN i % 19 = 0 THEN NULL ELSE 'V' || (i % 53) END,
	CASE WHEN i % 29 = 0 THEN NULL ELSE ('00000000-0000-0000-0000-' || lpad(to_hex((i * 7919) % 100000), 12, '0'))::uuid END
FROM generate_series(1, 30000) i;
SET sift.test_limits = 'unit_bytes=65536';
CREATE INDEX tb_col ON tb USING sift_col (id, g, a, b, c, f, n, m, d, t, s, v, u);
NOTICE:  sift_col: the strings of leaf 12 (attribute 13) in superblock 0 pass 65536 bytes: the values after them are stored as overflow and read from the heap
HINT:  Index an expression that keeps the part of the value that is used, such as left(column, 255).
NOTICE:  sift_col: the strings of leaf 12 (attribute 13) in superblock 1 pass 65536 bytes: the values after them are stored as overflow and read from the heap
HINT:  Index an expression that keeps the part of the value that is used, such as left(column, 255).
RESET sift.test_limits;
VACUUM (ANALYZE) tb;
CREATE FUNCTION tb_mode(pushed bool, workers int) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('sift.enable_agg', pushed::text, true);
	PERFORM set_config('enable_seqscan', (NOT pushed)::text, true);
	PERFORM set_config('enable_indexscan', (NOT pushed)::text, true);
	PERFORM set_config('enable_bitmapscan', (NOT pushed)::text, true);
	PERFORM set_config('max_parallel_workers_per_gather', CASE WHEN pushed THEN workers ELSE 0 END::text, true);
	PERFORM set_config('parallel_setup_cost', '0', true);
	PERFORM set_config('parallel_tuple_cost', '0', true);
	PERFORM set_config('min_parallel_table_scan_size', '0', true);
END $$;
-- 'same' / 'DIFFERENT' (the rows and their order), '+topn' when the pushed plan is the top-N scan, '+sorted' when it sorts every row, '+par' when it plans workers, and the number of rows
CREATE FUNCTION tb_check(q text, workers int DEFAULT 0) RETURNS text LANGUAGE plpgsql AS $$
DECLARE n bigint; plan text := ''; line text;
BEGIN
	DROP TABLE IF EXISTS tb_a, tb_b;
	PERFORM tb_mode(true, workers);
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || line || E'\n'; END LOOP;
	EXECUTE 'CREATE TEMP TABLE tb_a AS SELECT row_number() OVER () AS pos, row_to_json(x)::text AS r FROM (' || q || ') x';
	PERFORM tb_mode(false, 0);
	EXECUTE 'CREATE TEMP TABLE tb_b AS SELECT row_number() OVER () AS pos, row_to_json(x)::text AS r FROM (' || q || ') x';
	SELECT count(*) INTO n FROM ((SELECT pos, r FROM tb_a EXCEPT ALL SELECT pos, r FROM tb_b) UNION ALL (SELECT pos, r FROM tb_b EXCEPT ALL SELECT pos, r FROM tb_a)) d;
	RETURN CASE WHEN n = 0 THEN 'same' ELSE 'DIFFERENT' END || CASE WHEN plan ~ 'Top-N: ' THEN '+topn' ELSE '' END || CASE WHEN plan ~ ', sorted' THEN '+sorted' ELSE '' END || CASE WHEN plan ~ 'Workers Planned' THEN '+par' ELSE '' END || ' ' || (SELECT count(*) FROM tb_b);
END $$;
CREATE FUNCTION tf_double(x int) RETURNS int LANGUAGE plpgsql IMMUTABLE PARALLEL SAFE AS $$ BEGIN RETURN x * 2 + 1; END $$;
CREATE FUNCTION tf_double_unsafe(x int) RETURNS int LANGUAGE plpgsql IMMUTABLE PARALLEL UNSAFE AS $$ BEGIN RETURN x * 2 + 1; END $$;
CREATE FUNCTION tf_raise(x int) RETURNS int LANGUAGE plpgsql IMMUTABLE PARALLEL SAFE AS $$ BEGIN IF x = 17 THEN RAISE EXCEPTION 'seventeen' USING ERRCODE = 'P0042'; END IF; RETURN x; END $$;
CREATE FUNCTION tf_stable(x int) RETURNS int LANGUAGE plpgsql STABLE AS $$ BEGIN RETURN x; END $$;
-- a collation of the C library or ICU other than C, when the build has one (the case of strings follows its ctype)
CREATE FUNCTION tb_coll() RETURNS text LANGUAGE sql AS $$
	SELECT coalesce((SELECT collname FROM pg_collation WHERE collname IN ('en_US.utf8', 'und-x-icu') ORDER BY collname LIMIT 1), 'C') $$;
-- a statement with parameters, planned generic: tb_check's answer
CREATE FUNCTION tb_check_p(q text, types text, args text, workers int DEFAULT 0) RETURNS text LANGUAGE plpgsql AS $$
DECLARE n bigint; plan text := ''; line text;
BEGIN
	DROP TABLE IF EXISTS tb_a, tb_b, tb_a0, tb_b0;
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', true);
	PERFORM tb_mode(true, workers);
	DEALLOCATE ALL;
	EXECUTE format('PREPARE tb_p(%s) AS %s', types, q);
	FOR line IN EXECUTE format('EXPLAIN (COSTS OFF) EXECUTE tb_p(%s)', args) LOOP plan := plan || line || E'\n'; END LOOP;
	EXECUTE format('CREATE TEMP TABLE tb_a0 AS EXECUTE tb_p(%s)', args);
	PERFORM tb_mode(false, 0);
	DEALLOCATE ALL;
	EXECUTE format('PREPARE tb_p(%s) AS %s', types, q);
	EXECUTE format('CREATE TEMP TABLE tb_b0 AS EXECUTE tb_p(%s)', args);
	CREATE TEMP TABLE tb_a AS SELECT row_number() OVER () AS pos, row_to_json(x)::text AS r FROM tb_a0 x;
	CREATE TEMP TABLE tb_b AS SELECT row_number() OVER () AS pos, row_to_json(x)::text AS r FROM tb_b0 x;
	SELECT count(*) INTO n FROM ((SELECT pos, r FROM tb_a EXCEPT ALL SELECT pos, r FROM tb_b) UNION ALL (SELECT pos, r FROM tb_b EXCEPT ALL SELECT pos, r FROM tb_a)) d;
	RETURN CASE WHEN n = 0 THEN 'same' ELSE 'DIFFERENT' END || CASE WHEN plan ~ 'Top-N: ' THEN '+topn' ELSE '' END || CASE WHEN plan ~ 'Workers Planned' THEN '+par' ELSE '' END || ' ' || (SELECT count(*) FROM tb_b);
END $$;
CREATE TABLE tb_q (tag text PRIMARY KEY, q text NOT NULL);
INSERT INTO tb_q VALUES
	('concat_lower',    $q$SELECT id, s, v FROM tb ORDER BY lower(s || v), id LIMIT 25$q$),
	('concat_upper',    $q$SELECT id, s, v FROM tb ORDER BY upper(v || s) DESC, id LIMIT 25$q$),
	('concat_sep',      $q$SELECT id, s FROM tb ORDER BY s || '-' || id::text, id LIMIT 25$q$),
	('concat_c',        $q$SELECT id, s, v FROM tb ORDER BY (s || v) COLLATE "C" DESC, id LIMIT 25$q$),
	('concat_locale',   format($q$SELECT id, s, v FROM tb ORDER BY lower((s || v) COLLATE %I), id LIMIT 25 OFFSET 3$q$, tb_coll())),
	('concat_nulls',    $q$SELECT id, s, v FROM tb ORDER BY coalesce(s, '') || coalesce(v, '') DESC, coalesce(v, '') || '/' || coalesce(s, ''), id LIMIT 25$q$),
	('nested_lu',       $q$SELECT id, s FROM tb ORDER BY lower(upper(s)), id LIMIT 25$q$),
	('nested_ul',       $q$SELECT id, s FROM tb ORDER BY upper(lower(s)) DESC, id LIMIT 25$q$),
	('left',            $q$SELECT id, s FROM tb ORDER BY left(s, 3), id LIMIT 25$q$),
	('substr',          $q$SELECT id, s FROM tb ORDER BY substr(s, 2, 3) DESC, id LIMIT 25$q$),
	('trim_right',      $q$SELECT id, s FROM tb ORDER BY right(btrim(s), 2), id LIMIT 25$q$),
	('initcap',         $q$SELECT id, s FROM tb ORDER BY initcap(s), id LIMIT 25$q$),
	('initcap_locale',  format($q$SELECT id, s FROM tb ORDER BY initcap(s COLLATE %I) DESC, id LIMIT 25$q$, tb_coll())),
	('reverse',         $q$SELECT id, s FROM tb ORDER BY reverse(s), id LIMIT 25$q$),
	('replace',         $q$SELECT id, s FROM tb ORDER BY replace(s, 'a', 'z'), id LIMIT 25$q$),
	('translate',       $q$SELECT id, s FROM tb ORDER BY translate(s, 'aeiou', 'AEIOU') DESC, id LIMIT 25$q$),
	('md5',             $q$SELECT id, s FROM tb ORDER BY md5(s), id LIMIT 25$q$),
	('repeat',          $q$SELECT id, s FROM tb ORDER BY repeat(left(s, 2), 3), id LIMIT 25$q$),
	('lpad',            $q$SELECT id FROM tb ORDER BY lpad((id % 97)::text, 4, '0'), id LIMIT 25$q$),
	('case_text_func',  $q$SELECT id, s FROM tb ORDER BY CASE WHEN s IS NULL THEN '' ELSE left(s, 3) END, id LIMIT 25$q$),
	('coalesce_text',   $q$SELECT id, s, v FROM tb ORDER BY coalesce(left(s, 2), v), id LIMIT 25$q$),
	('length_concat',   $q$SELECT id, s, v FROM tb ORDER BY length(s || v) DESC NULLS LAST, id LIMIT 25$q$),
	('abs_guarded',     $q$SELECT id, a FROM tb WHERE a > -2147483648 ORDER BY abs(a) DESC, id LIMIT 25$q$),
	('mod_div',         $q$SELECT id, a FROM tb WHERE a BETWEEN -1000 AND 1000 ORDER BY mod(a, 7), div(a, 50) DESC, id LIMIT 25$q$),
	('round_numeric',   $q$SELECT id, n FROM tb ORDER BY round(n, 1), sign(n), id LIMIT 25$q$),
	('floor_ceil',      $q$SELECT id, n FROM tb ORDER BY floor(n) DESC, ceil(n), id LIMIT 25$q$),
	('sqrt_abs',        $q$SELECT id, f FROM tb ORDER BY sqrt(abs(f)), id LIMIT 25$q$),
	('ln_positive',     $q$SELECT id, f FROM tb WHERE f > 0 AND f < 'Infinity' ORDER BY ln(f) DESC, id LIMIT 25$q$),
	('date_trunc',      $q$SELECT id, t FROM tb ORDER BY date_trunc('month', t) DESC, id LIMIT 25$q$),
	('extract_date',    $q$SELECT id, d FROM tb WHERE d < 'infinity' ORDER BY extract(month FROM d), id LIMIT 25$q$),
	('make_date',       $q$SELECT id, g FROM tb ORDER BY make_date(2024, 1 + g, 1) DESC, id LIMIT 25$q$),
	('ts_interval_col', $q$SELECT id, t, g FROM tb ORDER BY t + g * interval '1 hour', id LIMIT 25$q$),
	('epoch_diff',      $q$SELECT id, t FROM tb ORDER BY extract(epoch FROM t - TIMESTAMP '2020-02-01') DESC, id LIMIT 25$q$),
	('user_function',   $q$SELECT id, g FROM tb WHERE a BETWEEN -1000 AND 1000 ORDER BY tf_double(a), id LIMIT 25$q$),
	('user_in_case',    $q$SELECT id, g FROM tb WHERE a BETWEEN -1000 AND 1000 ORDER BY CASE WHEN a > 0 THEN tf_double(a) ELSE 0 END DESC, id LIMIT 25$q$),
	('two_funcs',       $q$SELECT id, s, a FROM tb WHERE a BETWEEN -1000 AND 1000 ORDER BY left(s, 2), abs(a) % 10 DESC, id LIMIT 30$q$),
	('six_keys',        $q$SELECT id, s FROM tb ORDER BY g, left(s, 1), lower(s || v), length(s), md5(s), upper(v), id LIMIT 30$q$),
	('window_total',    $q$SELECT id, s, count(*) OVER () AS total FROM tb WHERE g IN (1, 2) ORDER BY left(s, 2), id LIMIT 10$q$),
	('deep_page',       $q$SELECT id, s FROM tb ORDER BY lower(s || v), id LIMIT 20 OFFSET 20000$q$),
	('all_rows',        $q$SELECT id, s FROM tb ORDER BY left(s, 2), id LIMIT 200000$q$);
SELECT tag, tb_check(q) FROM tb_q ORDER BY tag COLLATE "C";
