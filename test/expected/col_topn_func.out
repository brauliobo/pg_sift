-- workers: each keeps a heap of the keys it saw, the leader merges them
SELECT tag, tb_check(q, 2) FROM tb_q WHERE tag IN ('concat_lower', 'nested_lu', 'left', 'md5', 'case_text_func', 'round_numeric', 'date_trunc', 'user_function', 'two_funcs', 'six_keys') ORDER BY tag COLLATE "C";
