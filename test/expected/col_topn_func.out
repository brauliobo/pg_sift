-- a function that is not parallel safe keeps the scan in the leader; so does a parameter of the statement
SELECT tb_check($q$SELECT id, g FROM tb WHERE a BETWEEN -1000 AND 1000 ORDER BY tf_double_unsafe(a), id LIMIT 25$q$, 2) AS unsafe_function,
	   tb_check($q$SELECT id, g FROM tb WHERE a BETWEEN -1000 AND 1000 ORDER BY tf_double(a), id LIMIT 25$q$, 2) AS safe_function;
 unsafe_function |  safe_function   
-----------------+------------------
 same+topn 25    | same+topn+par 25
(1 row)

-- the sort of every row that passes spills (work_mem), and a deep page
SET work_mem = '64kB';
SELECT tb_check($q$SELECT id, s, v FROM tb ORDER BY lower(s || v), id LIMIT 20 OFFSET 20000$q$) AS spilled_concat,
	   tb_check($q$SELECT id, s FROM tb ORDER BY md5(s), id LIMIT 30 OFFSET 15000$q$) AS spilled_md5;
   spilled_concat    |     spilled_md5     
---------------------+---------------------
 same+topn+sorted 20 | same+topn+sorted 30
(1 row)

RESET work_mem;
-- parameters of the statement, planned generic: the same rows as the plain plan, in the leader
SELECT tb_check_p($q$SELECT id, g FROM tb ORDER BY g + $1, id LIMIT 25$q$, 'int', '7') AS plus,
	   tb_check_p($q$SELECT id, g FROM tb ORDER BY CASE WHEN g > $1 THEN 1 ELSE 0 END, id DESC LIMIT 25$q$, 'int', '3') AS in_case,
	   tb_check_p($q$SELECT id, a FROM tb ORDER BY coalesce(a, $1), id LIMIT 25$q$, 'int', '250') AS coalesce_default,
	   tb_check_p($q$SELECT id, s FROM tb ORDER BY s || $1, id LIMIT 25$q$, 'text', $$'-x'$$) AS text_appended,
	   tb_check_p($q$SELECT id, s FROM tb ORDER BY left(s, $1), id LIMIT 25$q$, 'int', '2', 2) AS with_workers_asked;
