-- an expression that raises raises the same SQLSTATE in both plans, and none for a row the WHERE removes
CREATE FUNCTION tb_error(q text, pushed bool) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	PERFORM tb_mode(pushed, 0);
	EXECUTE q;
	RETURN 'no error';
EXCEPTION WHEN OTHERS THEN
	RETURN SQLSTATE;
END $$;
CREATE FUNCTION tb_scan(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE line text; plan text := '';
BEGIN
	PERFORM tb_mode(true, 0);
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || line; END LOOP;
	RETURN CASE WHEN plan ~ 'Top-N: ' THEN 'topn' ELSE 'plain' END;
END $$;
SELECT tag, tb_error(q, true) = tb_error(q, false) AS same_error, tb_error(q, true) AS sqlstate, tb_scan(q) AS pushed
FROM (VALUES ('abs_min',          $q$SELECT id FROM tb ORDER BY abs(a), id LIMIT 5$q$),
			 ('abs_min_where',    $q$SELECT id FROM tb WHERE a > -2147483648 ORDER BY abs(a), id LIMIT 5$q$),
			 ('ln_not_positive',  $q$SELECT id FROM tb ORDER BY ln(f), id LIMIT 5$q$),
			 ('power_overflow',   $q$SELECT id FROM tb ORDER BY power(f, 400), id LIMIT 5$q$),
			 ('user_raise',       $q$SELECT id FROM tb ORDER BY tf_raise((id % 40)::int), id LIMIT 5$q$),
			 ('user_raise_where', $q$SELECT id FROM tb WHERE id % 40 <> 17 ORDER BY tf_raise((id % 40)::int), id LIMIT 5$q$),
			 ('make_date_month',  $q$SELECT id FROM tb ORDER BY make_date(2024, g + 7, 1), id LIMIT 5$q$),
			 ('make_date_ok',     $q$SELECT id FROM tb ORDER BY make_date(2024, g + 6, 1), id LIMIT 5$q$)) v(tag, q)
ORDER BY tag COLLATE "C";
       tag        | same_error | sqlstate | pushed 
------------------+------------+----------+--------
 abs_min          | t          | 22003    | topn
 abs_min_where    | t          | no error | topn
 ln_not_positive  | t          | 2201E    | topn
 make_date_month  | t          | 22008    | topn
 make_date_ok     | t          | no error | topn
 power_overflow   | t          | 22003    | topn
 user_raise       | t          | P0042    | topn
 user_raise_where | t          | no error | topn
(8 rows)

-- what stays with the normal plan, each by a named refusal
SET sift.enable_agg = on;
SET enable_seqscan = off; SET enable_indexscan = off; SET enable_bitmapscan = off;
SELECT k, w.used, w.slug, w.reason
FROM (VALUES ('stable user function', $q$SELECT id FROM tb ORDER BY tf_stable(g), id LIMIT 5$q$),
			 ('concat function',      $q$SELECT id FROM tb ORDER BY concat(s, v), id LIMIT 5$q$),
			 ('stable text of date',  $q$SELECT id FROM tb ORDER BY d::text, id LIMIT 5$q$),
			 ('interval result',      $q$SELECT id FROM tb WHERE t < 'infinity' ORDER BY t - TIMESTAMP '2020-02-01', id LIMIT 5$q$),
			 ('array result',         $q$SELECT id FROM tb ORDER BY ARRAY[g, 1], id LIMIT 5$q$),
			 ('jsonb result',         $q$SELECT id FROM tb ORDER BY to_jsonb(g), id LIMIT 5$q$),
			 ('sub-select',           $q$SELECT id FROM tb ORDER BY length(s) + (SELECT 1), id LIMIT 5$q$),
			 ('allowed',              $q$SELECT id FROM tb ORDER BY lower(s || v), id LIMIT 5$q$)) q(k, q),
	 LATERAL sift.explain_why(q.q) w
ORDER BY k COLLATE "C";
          k           | used |    slug    |                                                                                reason                                                                                 
----------------------+------+------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------
 allowed              | t    |            | 
 array result         | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression has a result type the scan does not hold as a key)
 concat function      | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression calls a function that is not immutable)
 interval result      | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression has a result type the scan does not hold as a key)
 jsonb result         | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression has a result type the scan does not hold as a key)
 stable text of date  | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression calls a function that is not immutable)
 stable user function | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression calls a function that is not immutable)
 sub-select           | f    | topn_shape | the ORDER BY .. LIMIT is not over the scanned table's columns with a condition the scan tests (the sort expression reads a parameter of a sub-select)
(8 rows)

RESET enable_seqscan; RESET enable_indexscan; RESET enable_bitmapscan;
DROP TABLE tb, tb_q;
DROP FUNCTION tb_check(text,integer), tb_check_p(text,text,text,integer), tb_coll(), tb_error(text,boolean), tb_mode(boolean,integer), tb_scan(text),
	tf_double(int), tf_double_unsafe(int), tf_raise(int), tf_stable(int);
DROP EXTENSION pg_sift_test, pg_sift;
