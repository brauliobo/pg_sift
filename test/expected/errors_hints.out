-- The limits a user can reach say what to do: SQLSTATE, message, detail and hint of each, with the test-only setting sift.test_limits lowering
-- the limit so that a few rows reach it (src/core/limits.h). scripts/check-errors.sh proves that no 54000, 0A000 or 55000 lacks a hint or a detail.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
CREATE FUNCTION expect(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	st text; m text; d text; h text;
BEGIN
	EXECUTE q;
	RETURN 'no error';
EXCEPTION WHEN OTHERS THEN
	GET STACKED DIAGNOSTICS st = RETURNED_SQLSTATE, m = MESSAGE_TEXT, d = PG_EXCEPTION_DETAIL, h = PG_EXCEPTION_HINT;
	RETURN concat_ws(E'\n  ', st || ' ' || m, 'detail: ' || nullif(d, ''), 'hint: ' || nullif(h, ''));
END
$$;
CREATE TABLE one (id int, v text);
INSERT INTO one VALUES (1, repeat('x', 200));
CREATE TABLE many (id int, v text);
INSERT INTO many SELECT i, repeat(chr(96 + i), 60) FROM generate_series(1, 5) i;
-- a string over the limit, and the strings of one unit over it
SET sift.test_limits = 'string_bytes=100';
SELECT expect('CREATE INDEX ON one USING sift_col (id, v)');
                                        expect                                        
--------------------------------------------------------------------------------------
 54000 a value of 200 bytes does not fit the sift_col column "v" (at most 100 bytes) +
   hint: Leave the column out of the index, or index left(column, N) or a hash of it.
(1 row)

SELECT expect('CREATE INDEX ON many USING sift_col (id, v)');
                                        expect                                        
--------------------------------------------------------------------------------------
 54000 the strings of one unit of the sift_col column "v" exceed 100 bytes           +
   hint: Leave the column out of the index, or index left(column, N) or a hash of it.
(1 row)

RESET sift.test_limits;
-- an index that is not on a heap table
CREATE TABLE tbl (id int, v text) USING sift_table;
SELECT expect('CREATE INDEX ON tbl USING sift_col (id)');
                                         expect                                         
----------------------------------------------------------------------------------------
 0A000 sift_col indexes require a heap table                                           +
   hint: Index a heap table, or copy the rows into one with CREATE TABLE ... AS SELECT.
(1 row)

-- more leaves than an index holds: 128 declared paths
CREATE TABLE docs (id int, payload jsonb);
SELECT expect(format('CREATE INDEX ON docs USING sift_col (id, payload) WITH (paths = %L)',
					 (SELECT string_agg(format('payload.k%s int4', i), ', ') FROM generate_series(1, 128) i)));
                                                     expect                                                      
-----------------------------------------------------------------------------------------------------------------
 54000 a sift_col index holds at most 128 columns                                                               +
   detail: Column "payload" brings the index to 129 columns and paths.                                          +
   hint: Leave out the columns the queries do not read, or create several indexes: the planner picks among them.
(1 row)

-- a jsonb path spec over its size
SELECT expect(format('CREATE INDEX ON many USING sift_col (id) WITH (paths = %L)', repeat('a int4,', 20000) || 'b int4'));
                                   expect                                   
----------------------------------------------------------------------------
 54000 sift shred paths: the spec has more than 65536 bytes                +
   hint: Declare fewer paths, or a wildcard path for the keys of an object.
(1 row)

-- a row of a sift_table over the write buffer
SELECT sift.table_set_option('tbl', 'write_buffer_limit', '2048');
 table_set_option 
------------------
 
(1 row)

SELECT sift.table_set_option('tbl', 'wide_rows', 'off');
 table_set_option 
------------------
 
(1 row)

SELECT expect($$INSERT INTO tbl VALUES (1, repeat('z', 3000000))$$);
                                                                           expect                                                                            
-------------------------------------------------------------------------------------------------------------------------------------------------------------
 54000 row of sift_table "tbl" is too large: 3000024 bytes                                                                                                  +
   detail: A row has to fit one write buffer of 2048 kB.                                                                                                    +
   hint: Set sift.table_wide_rows = on to accept it (up to 1 GB), raise sift.table_write_buffer_limit (up to 8192 kB), or keep the document outside the row.
(1 row)

-- sift.explain_why takes one statement; a score of a ctid that is no column of a table says where it exists
SELECT expect($$SELECT * FROM sift.explain_why('select 1; select 2')$$);
                                                                       expect                                                                       
----------------------------------------------------------------------------------------------------------------------------------------------------
 0A000 sift.explain_why takes one SELECT statement or the EXECUTE of a prepared one                                                                +
   hint: Pass the text of a single SELECT, without a second statement; the SELECT of an INSERT, CREATE TABLE AS or a DELETE is explained by itself.
(1 row)

SELECT expect('SELECT sift.score(q.c) FROM (SELECT ctid AS c FROM many OFFSET 0) q');
                                                                               expect                                                                               
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
 0A000 sift.score() must be computed by a sift scan of the same relation                                                                                           +
   detail: The score exists only inside the scan of the relation the ctid belongs to: it is not computed above a join, in a sublink, or for the ctid of a subquery.+
   hint: Call it on the ctid of a table in the FROM clause of the query level that scans the table.
(1 row)

-- an ALTER INDEX that changes what the segments were written with is refused once the index holds a segment, and the table goes on working;
-- an index with no segment takes it, and the first write uses the new options
CREATE TABLE alt (id int, v text);
CREATE INDEX alt_idx ON alt USING sift (v);
SELECT expect('ALTER INDEX alt_idx SET (prefix_index = 2)');
  expect  
----------
 no error
(1 row)

INSERT INTO alt VALUES (1, 'alpha beta');
SELECT count(*) FROM alt WHERE v @@> 'al*';
 count 
-------
     1
(1 row)

SELECT expect('ALTER INDEX alt_idx SET (prefix_index = 3)');
                                                                    expect                                                                    
----------------------------------------------------------------------------------------------------------------------------------------------
 0A000 cannot change the analyzer options of index "alt_idx" while it holds data                                                             +
   detail: Its segments were written with the options it has now: reads and writes on its table would fail until a REINDEX writes them again.+
   hint: CREATE INDEX CONCURRENTLY a new index with the options, then DROP INDEX public.alt_idx: no scan is lost while it is built.
(1 row)

SELECT expect('ALTER INDEX alt_idx RESET (prefix_index)');
                                                                    expect                                                                    
----------------------------------------------------------------------------------------------------------------------------------------------
 0A000 cannot change the analyzer options of index "alt_idx" while it holds data                                                             +
   detail: Its segments were written with the options it has now: reads and writes on its table would fail until a REINDEX writes them again.+
   hint: CREATE INDEX CONCURRENTLY a new index with the options, then DROP INDEX public.alt_idx: no scan is lost while it is built.
(1 row)

INSERT INTO alt VALUES (2, 'alpha gamma');
SELECT count(*) FROM alt WHERE v @@> 'al*';
 count 
-------
     2
(1 row)

-- a paths spec that names a column, not a path with its type, and the lists of columns of the options: the name, what is wrong with it, what to write
SELECT expect($$CREATE INDEX ON docs USING sift_col (id, payload) WITH (paths = 'payload')$$);
                                                                expect                                                                 
---------------------------------------------------------------------------------------------------------------------------------------
 42601 sift shred paths: expected a type after the path (bool, int2, int4, int8, float4, float8, text or astext) at position 8        +
   hint: Name the type of every path, 'doc.id int4, doc.items[]{sku text}'; 'auto' lets the build choose the paths from the documents.
(1 row)

SELECT expect($$CREATE INDEX ON many USING sift_col (id, v) WITH (key_columns = 'nope')$$);
                                    expect                                    
------------------------------------------------------------------------------
 22023 invalid key_columns option "nope": "nope" is not a column of the index
(1 row)

SELECT expect($$CREATE INDEX ON many USING sift_col (id, v) WITH (key_columns = '"v')$$);
                                     expect                                     
--------------------------------------------------------------------------------
 22023 invalid list of column names: the quote that opens at ""v" is not closed
(1 row)

SELECT expect($$CREATE INDEX ON many USING sift_col (id, v) WITH (key_cut = 'v')$$);
                                                           expect                                                           
----------------------------------------------------------------------------------------------------------------------------
 22023 invalid key_cut option "v": "v" is not an integer, date, timestamp, numeric or float column of the index (at most 4)
(1 row)

DROP TABLE one, many, tbl, docs, alt;
DROP FUNCTION expect(text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
