-- A sift_col index that lost the projections of its directory (REINDEX: the new relation file holds none) while sift.projection_defs keeps their definitions gets them again from the next
-- vacuum: each is listed as ready, answers the aggregate from the projection, and is not created a second time.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
\set VERBOSITY terse
CREATE TABLE h (id int PRIMARY KEY, a int, b int);
INSERT INTO h SELECT g, g % 10, g % 20 FROM generate_series(1, 5000) g;
CREATE INDEX h_col ON h USING sift_col (id, a, b) WITH (key_order = 'id');
VACUUM h;
SELECT sift.create_projection('h_col', 'by_a', 'GROUP BY a MEASURES count(*), sum(b)');
 create_projection 
-------------------
 t
(1 row)

VACUUM h;
CREATE FUNCTION listed() RETURNS TABLE (relation text, name text, state text, has_rows boolean) LANGUAGE sql AS
$$ SELECT relation::text, name, state, rows > 0 FROM sift.secondary_projections ORDER BY 1, 2 $$;
CREATE FUNCTION answers(rel text, proj text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	q text := format('SELECT a, count(*), sum(b) FROM %s GROUP BY a', rel);
	l text; used boolean := false; via_proj text; via_heap text;
BEGIN
	SET LOCAL sift.agg_force = on; SET LOCAL sift.enable_agg = on;
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) ' || q LOOP
		used := used OR l LIKE '%Projection: ' || proj || '%';
	END LOOP;
	EXECUTE format('SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (%s) r', q) INTO via_proj;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (%s) r', q) INTO via_heap;
	RETURN CASE WHEN used THEN 'read from ' || proj ELSE 'read from the base parts' END || ', ' || CASE WHEN via_proj = via_heap THEN 'same rows as the heap' ELSE 'DIFFERENT' END;
END $$;
SELECT answers('h', 'by_a');
                answers                
---------------------------------------
 read from by_a, same rows as the heap
(1 row)

SELECT * FROM listed();
 relation | name | state | has_rows 
----------+------+-------+----------
 h_col    | by_a | ready | t
(1 row)

REINDEX INDEX h_col;
SELECT count(*) AS defs FROM sift.projection_defs;
 defs 
------
    1
(1 row)

VACUUM h;
SELECT * FROM listed();
 relation | name | state | has_rows 
----------+------+-------+----------
 h_col    | by_a | ready | t
(1 row)

SELECT answers('h', 'by_a');
                answers                
---------------------------------------
 read from by_a, same rows as the heap
(1 row)

SELECT sift.create_projection('h_col', 'by_a', 'GROUP BY a MEASURES count(*), sum(b)');
ERROR:  relation "h_col" already has a projection "by_a"
DROP TABLE h;
DROP FUNCTION listed(), answers(text, text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
