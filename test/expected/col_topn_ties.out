 SELECT j FROM tt ORDER BY j LIMIT 10                 | same
 SELECT j FROM tt ORDER BY j LIMIT 10 OFFSET 40       | same
 SELECT j, id FROM tt ORDER BY j DESC, id LIMIT 10    | same
 SELECT j, id FROM tt ORDER BY j, id LIMIT 10         | same
 SELECT k FROM tt ORDER BY k DESC LIMIT 10            | same
 SELECT k FROM tt ORDER BY k DESC LIMIT 10 OFFSET 7   | same
