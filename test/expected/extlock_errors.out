-- Whatever sift reports while it holds the relation extension lock, it reports without a lock of the catalog: PostgreSQL forbids a heavyweight lock under the extension lock (an assertion with
-- cassert), and the error context of the index and the damage record look names up. Every class of core/damage.h, and what is no damage, raised under the lock with a cold catalog cache.
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
CREATE FUNCTION expect(q text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
	EXECUTE q;
	RETURN 'ok';
EXCEPTION WHEN OTHERS THEN
	RETURN SQLSTATE;
END $$;
SET client_min_messages = error;
CREATE TABLE t (id int, v int, body text);
INSERT INTO t SELECT g, g % 7, 'alpha beta' || g % 5 FROM generate_series(1, 2000) g;
CREATE INDEX t_col ON t USING sift_col (id, v);
CREATE INDEX t_bm25 ON t USING sift (body);
SELECT m AS on_corruption, i AS index, k AS kind, expect(format('SET sift.on_corruption = %L; SELECT sift._test_raise_extending(%L::regclass, %L)', m, i, k)) AS raised
FROM unnest(ARRAY['error', 'quarantine']) m, unnest(ARRAY['t_col', 't_bm25']) i,
	 unnest(ARRAY['index', 'data', 'scope', 'other_data', 'other_index', 'error', 'warning', 'log']) k
ORDER BY m DESC, i, k;
 on_corruption | index  |    kind     | raised 
---------------+--------+-------------+--------
 quarantine    | t_bm25 | data        | XX001
 quarantine    | t_bm25 | error       | 54000
 quarantine    | t_bm25 | index       | XX002
 quarantine    | t_bm25 | log         | ok
 quarantine    | t_bm25 | other_data  | XX001
 quarantine    | t_bm25 | other_index | XX002
 quarantine    | t_bm25 | scope       | XX001
 quarantine    | t_bm25 | warning     | ok
 quarantine    | t_col  | data        | XX001
 quarantine    | t_col  | error       | 54000
 quarantine    | t_col  | index       | XX002
 quarantine    | t_col  | log         | ok
 quarantine    | t_col  | other_data  | XX001
 quarantine    | t_col  | other_index | XX002
 quarantine    | t_col  | scope       | XX001
 quarantine    | t_col  | warning     | ok
 error         | t_bm25 | data        | XX001
 error         | t_bm25 | error       | 54000
 error         | t_bm25 | index       | XX002
 error         | t_bm25 | log         | ok
 error         | t_bm25 | other_data  | XX001
 error         | t_bm25 | other_index | XX002
 error         | t_bm25 | scope       | XX001
 error         | t_bm25 | warning     | ok
 error         | t_col  | data        | XX001
 error         | t_col  | error       | 54000
 error         | t_col  | index       | XX002
 error         | t_col  | log         | ok
 error         | t_col  | other_data  | XX001
 error         | t_col  | other_index | XX002
 error         | t_col  | scope       | XX001
 error         | t_col  | warning     | ok
(32 rows)

SELECT index, detections > 0 AS recorded FROM sift.quarantine ORDER BY index;
 index  | recorded 
--------+----------
 t_col  | t
 t_bm25 | t
(2 rows)

DROP TABLE t;
DROP FUNCTION expect(text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
