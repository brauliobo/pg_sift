-- A Sort of many rows over the groups of a scan is done by a SiftSort node: the distinct values of each sort key are sorted once with the comparator of the key
-- (its sort operator, collation and nulls order), and the rows by the ranks. The rows come out in the order of the Sort they replace, for text, numeric, float, date
-- and expression keys, DESC, NULLS FIRST and LAST, ties, a scroll cursor read backwards, a merge join, a rescan, with workers, and the Sort under a Limit stays.
CREATE EXTENSION pg_sift;
SET sift.agg_preagg = off;
SET extra_float_digits = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET min_parallel_index_scan_size = 0;
SET enable_sort = on;
CREATE TABLE r (id int, a int, b text, c numeric(8,2), d date, f float8, t text) WITH (fillfactor = 20, autovacuum_enabled = false);
INSERT INTO r
SELECT i, i % 97, CASE WHEN i % 31 = 0 THEN NULL ELSE 'k' || (i * 7 % 83) END, (i % 40) / 4.0, DATE '2024-01-01' + (i % 25),
       CASE i % 9 WHEN 0 THEN 0.0 WHEN 1 THEN -0.0 WHEN 2 THEN 'NaN' WHEN 3 THEN NULL WHEN 4 THEN 'Infinity' WHEN 5 THEN '-Infinity' ELSE i % 5 - 2.5 END,
       (ARRAY['a', 'A', 'b', 'B', 'é', 'e', '', 'z', 'Z', '10', '9', '_', 'ab', 'aB', 'Ab'])[1 + i % 15] || (i % 7)
FROM generate_series(1, 40000) i;
CREATE INDEX r_col ON r USING sift_col (id, a, b, c, d, f, t);
NOTICE:  sift_col index "r_col": 1 automatic choice (rollup_columns), 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key; rollup_columns = c, d
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('r_col');
VACUUM ANALYZE r;
-- the rows of the statement as a checksum, in the order it gives them, with the pushdown and the workers as given
CREATE FUNCTION r_sum(q text, push bool, workers int) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('sift.enable_agg', push::text, true);
	PERFORM set_config('max_parallel_workers_per_gather', workers::text, true);
	EXECUTE format('SELECT md5(string_agg(q::text, E''\n'')) FROM (%s) q', q) INTO r;
	RETURN r;
END $$;
-- whether the plan of the statement has a SiftSort node, and a Sort
CREATE FUNCTION r_plan(q text, workers int) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text[] := '{}';
BEGIN
	PERFORM set_config('sift.enable_agg', 'on', true);
	PERFORM set_config('max_parallel_workers_per_gather', workers::text, true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l ~ 'Custom Scan \(SiftSort\)' THEN r := r || 'SiftSort'::text; ELSIF l ~ '^\s*(-> +)?Sort$' THEN r := r || 'Sort'::text; END IF;
	END LOOP;
	RETURN CASE WHEN cardinality(r) = 0 THEN 'none' ELSE array_to_string(r, ' ') END;
END $$;
CREATE TABLE r_q (n int, q text);
INSERT INTO r_q VALUES
	(1, 'SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) DESC, b, a'),
	(2, 'SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY b DESC NULLS LAST, a'),
	(3, 'SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY b NULLS FIRST, a DESC'),
	(4, 'SELECT a, c, d, sum(id) s FROM r GROUP BY a, c, d ORDER BY c DESC, d, a DESC'),
	(5, 'SELECT a, f, d, count(*) n FROM r GROUP BY a, f, d ORDER BY f NULLS FIRST, a, d'),
	(6, 'SELECT a, f, d, count(*) n FROM r GROUP BY a, f, d ORDER BY f DESC NULLS LAST, a DESC, d'),
	(7, 'SELECT t, a, count(*) n FROM r GROUP BY t, a ORDER BY t, a'),
	(8, 'SELECT t, a, count(*) n FROM r GROUP BY t, a ORDER BY t COLLATE "C" DESC, a'),
	(9, 'SELECT t, a, count(*) n FROM r GROUP BY t, a ORDER BY lower(t), a DESC, t'),
	(10, 'SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY COALESCE(b, ''none'') DESC, a'),
	(11, 'SELECT a, b, t, count(*) n FROM r GROUP BY a, b, t ORDER BY a % 5, b, t DESC, a'),
	(12, 'SELECT a, d, sum(c) s FROM r GROUP BY a, d ORDER BY sum(c) DESC NULLS LAST, d, a'),
	(13, 'SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY n, a, b'),
	(14, 'SELECT COALESCE(x.a, y.a) a, COALESCE(x.c, y.c) c, x.n, y.s FROM (SELECT a, c, count(*) n FROM r GROUP BY a, c) x FULL JOIN (SELECT a, c, sum(id) s FROM r GROUP BY a, c) y ON x.a = y.a AND x.c = y.c ORDER BY COALESCE(x.c, y.c) DESC, COALESCE(x.a, y.a)'),
	(15, 'SELECT a, c, n, s FROM (SELECT a, c, count(*) n, sum(id) s FROM r GROUP BY a, c) x FULL JOIN (SELECT a % 13 a, c, 1 m FROM r GROUP BY 1, 2) y USING (a, c) ORDER BY c DESC NULLS LAST, a, n');
-- the group keys alone are ordered by the scan itself: the same shapes behind a measure, so that the Sort stays
INSERT INTO r_q SELECT n + 100, replace(q, 'ORDER BY ', 'ORDER BY count(*) % 3, ') FROM r_q WHERE n BETWEEN 2 AND 8;
-- every shape: a SiftSort in the plan (a Sort when the node is not offered), and the rows equal to the normal plan's, without and with workers
SELECT n, r_plan(q, 0) plan_serial, r_sum(q, true, 0) = r_sum(q, false, 0) same_serial, r_sum(q, true, 3) = r_sum(q, false, 0) same_workers FROM r_q ORDER BY n;
  n  | plan_serial | same_serial | same_workers 
-----+-------------+-------------+--------------
   1 | SiftSort    | t           | t
   2 | none        | t           | t
   3 | none        | t           | t
   4 | none        | t           | t
   5 | SiftSort    | t           | t
   6 | SiftSort    | t           | t
   7 | none        | t           | t
   8 | none        | t           | t
   9 | SiftSort    | t           | t
  10 | SiftSort    | t           | t
  11 | SiftSort    | t           | t
  12 | SiftSort    | t           | t
  13 | SiftSort    | t           | t
  14 | SiftSort    | t           | t
  15 | SiftSort    | t           | t
 102 | SiftSort    | t           | t
 103 | SiftSort    | t           | t
 104 | SiftSort    | t           | t
 105 | SiftSort    | t           | t
 106 | SiftSort    | t           | t
 107 | SiftSort    | t           | t
 108 | SiftSort    | t           | t
(22 rows)

SELECT n, r_plan(q, 3) plan_workers FROM r_q ORDER BY n;
  n  | plan_workers 
-----+--------------
