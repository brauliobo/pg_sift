-- a key with a nondeterministic collation: the groups that are equal for the collation are one group, shown as either of the values, so the rows are compared lowered
CREATE COLLATION r_ci (provider = icu, locale = 'und-u-ks-level2', deterministic = false);
CREATE TABLE rc (id int, a int, t text COLLATE r_ci) WITH (autovacuum_enabled = false);
INSERT INTO rc SELECT i, i % 101, (ARRAY['a', 'A', 'b', 'B', 'é', 'e', 'E', 'z'])[1 + i % 8] || (i % 11) FROM generate_series(1, 40000) i;
CREATE INDEX rc_col ON rc USING sift_col (id, a, t);
NOTICE:  sift_col index "rc_col": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('rc_col');
VACUUM ANALYZE rc;
SELECT r_plan(q, 0) plan, r_sum(q, true, 0) = r_sum(q, false, 0) same
FROM (VALUES ('SELECT lower(t), a, n FROM (SELECT t, a, count(*) n FROM rc GROUP BY t, a ORDER BY count(*) % 3, t, a DESC) q')) v(q);
   plan   | same 
----------+------
 SiftSort | t
(1 row)

SELECT r_plan(q, 0) plan FROM (VALUES ('SELECT t, a, count(*) n FROM rc GROUP BY t, a ORDER BY count(*) % 3, t, a DESC')) v(q);
   plan   
----------
 SiftSort
(1 row)

-- a single key of an integer type is sorted by the Sort itself
SELECT r_plan('SELECT a, count(*) n FROM r GROUP BY a ORDER BY a DESC', 0) int_key,
       r_plan('SELECT id, count(*) n FROM r GROUP BY id ORDER BY count(*) DESC', 0) int_measure;
 int_key | int_measure 
---------+-------------
 none    | Sort
(1 row)

-- a small input keeps the Sort; a tight work_mem keeps the node, which sorts by the rows as the Sort does when the ranks do not fit
SELECT r_plan('SELECT a, b, count(*) n FROM r WHERE id < 100 GROUP BY a, b ORDER BY count(*) % 3, b, a', 0) small_input;
 small_input 
-------------
 Sort
(1 row)

SET work_mem = '64kB';
SELECT r_plan(q, 0) FROM r_q WHERE n = 1;
  r_plan  
----------
 SiftSort
(1 row)

SELECT r_sum(q, true, 0) = r_sum(q, false, 0) FROM r_q WHERE n = 1;
 ?column? 
----------
 t
(1 row)

RESET work_mem;
SELECT r_plan('SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b, a LIMIT 10', 0) with_limit;
 with_limit 
------------
 Sort
(1 row)

SELECT r_plan('SELECT * FROM (SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b, a) s LIMIT 10', 0) limit_over;
 limit_over 
------------
 Sort
(1 row)

-- a scroll cursor reads the node forwards and backwards, past its end and back to its start
CREATE FUNCTION r_scroll(push bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
	c SCROLL CURSOR FOR SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b DESC NULLS LAST, a;
	r record; out text[] := '{}';
BEGIN
	PERFORM set_config('sift.enable_agg', push::text, true);
	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	OPEN c;
	FETCH FIRST FROM c INTO r; out := out || r::text;
	FOR i IN 1..2500 LOOP FETCH c INTO r; EXIT WHEN NOT FOUND; out := out || r::text; END LOOP;
	FETCH c INTO r; out := out || COALESCE(r::text, 'end');
	FOR i IN 1..3000 LOOP FETCH PRIOR FROM c INTO r; EXIT WHEN NOT FOUND; out := out || r::text; END LOOP;
	FETCH LAST FROM c INTO r; out := out || r::text;
	FETCH ABSOLUTE 7 FROM c INTO r; out := out || r::text;
	FETCH RELATIVE -3 FROM c INTO r; out := out || r::text;
	CLOSE c;
	RETURN md5(array_to_string(out, E'\n')) || ' ' || cardinality(out);
END $$;
SELECT r_scroll(true) = r_scroll(false) scroll_same, r_scroll(true) ~ ' 5[0-9]{3}$' scroll_rows;
 scroll_same | scroll_rows 
-------------+-------------
 t           | t
(1 row)

-- a merge join marks and restores the node
CREATE FUNCTION r_join(push bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	PERFORM set_config('sift.enable_agg', push::text, true);
	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	SELECT md5(string_agg(q::text, E'\n')) INTO r FROM (
		SELECT x.a, x.b, x.n, y.n m
		FROM (SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b, a) x
		JOIN (SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b, a) y ON x.b = y.b AND x.a = y.a % 50) q;
	RETURN r;
END $$;
SELECT r_join(true) = r_join(false) merge_join;
 merge_join 
------------
 t
(1 row)

-- a node that is read again (the inner side of a nested loop with no Materialize) starts from its first row each time
CREATE TABLE r_q2 (q text);
INSERT INTO r_q2 VALUES ('SELECT g, md5(string_agg(s.a || s.b, '','')) FROM generate_series(1, 3) g, (SELECT a, b FROM r GROUP BY a, b ORDER BY count(*) % 3, b, a) s GROUP BY g');
SET enable_material = off;
SET enable_memoize = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SELECT r_plan(q, 0) rescan_plan, r_sum(q, true, 0) = r_sum(q, false, 0) rescan_same FROM r_q2;
 rescan_plan | rescan_same 
-------------+-------------
 SiftSort    | t
(1 row)

RESET enable_material;
RESET enable_memoize;
RESET enable_hashjoin;
RESET enable_mergejoin;
SET enable_hashjoin = off;
SET enable_nestloop = off;
SELECT r_plan('SELECT x.a, x.b, x.n, y.n m FROM (SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b, a) x JOIN (SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b, a) y ON x.b = y.b AND x.a = y.a % 50', 0) merge_join_plan;
           merge_join_plan           
-------------------------------------
 SiftSort SiftSort SiftSort SiftSort
(1 row)

RESET enable_hashjoin;
RESET enable_nestloop;
SELECT r_plan('SELECT a, b, count(*) n FROM r GROUP BY a, b ORDER BY count(*) % 3, b DESC NULLS LAST, a', 0) cursor_plan;
 cursor_plan 
-------------
 SiftSort
(1 row)

DROP TABLE r_q;
DROP FUNCTION r_sum(text, bool, int);
DROP FUNCTION r_plan(text, int);
DROP FUNCTION r_scroll(bool);
DROP FUNCTION r_join(bool);
DROP TABLE r_q2;
DROP TABLE rc;
DROP COLLATION r_ci;
DROP TABLE r;
DROP EXTENSION pg_sift;
