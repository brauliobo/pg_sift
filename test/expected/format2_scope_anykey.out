(1 row)

SELECT same(format('SELECT count(*), sum(a.spent) FROM accounts a JOIN pairs_uuid p ON p.member = a.member WHERE p.key = %s', lit('uuid', 0))) AS unique_include_uuid;
 unique_include_uuid 
---------------------
 same node
(1 row)

SELECT same(format('SELECT p.key, count(*), sum(a.spent) FROM accounts a JOIN pairs_text p ON p.member = a.member GROUP BY p.key')) AS unique_include_group;
 unique_include_group 
----------------------
 same node
(1 row)

INSERT INTO accounts SELECT 5000 + i, 1 + i % 60, 'new' || i, i % 5, i % 90 FROM generate_series(1, 500) i;
UPDATE accounts SET spent = spent + 1 WHERE id % 7 = 0;
DELETE FROM accounts WHERE id % 11 = 0;
VACUUM accounts;
SELECT same(format('SELECT count(*), sum(a.spent) FROM accounts a JOIN pairs_text p ON p.member = a.member WHERE p.key = %s', lit('text', 0))) AS after_dml_text;
 after_dml_text 
----------------
