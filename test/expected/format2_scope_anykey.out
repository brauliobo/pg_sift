-- 5. UNIQUE and INCLUDE compose with a text or uuid scope in format major 2
CREATE TABLE accounts (id int NOT NULL, member int NOT NULL, email text NOT NULL, plan int NOT NULL, spent int NOT NULL);
INSERT INTO accounts SELECT i, 1 + i % 60, 'user' || i || '@example.com', i % 5, i % 90 FROM generate_series(1, 3000) i;
CREATE UNIQUE INDEX accounts_u ON accounts USING sift_col (member, id) INCLUDE (plan, spent) WITH (scope = 'k: member -> pairs_text(member, key)', track_changes = 'ctid');
CREATE UNIQUE INDEX accounts_uu ON accounts USING sift_col (member, id) INCLUDE (plan, spent) WITH (scope = 'k: member -> pairs_uuid(member, key)', track_changes = 'ctid');
SELECT relation::text, format_major, scopes FROM sift.status() WHERE relation::text LIKE 'accounts\_%' ORDER BY 1;
  relation   | format_major | scopes 
-------------+--------------+--------
 accounts_u  |            2 |      1
 accounts_uu |            2 |      1
(2 rows)

INSERT INTO accounts VALUES (1, 2, 'dup', 0, 0);
ERROR:  duplicate key value violates unique constraint "accounts_u"
DETAIL:  Key (member, id)=(2, 1) already exists.
SELECT same(format('SELECT count(*), sum(a.spent) FROM accounts a JOIN pairs_text p ON p.member = a.member WHERE p.key = %s', lit('text', 0))) AS unique_include_text;
 unique_include_text 
---------------------
