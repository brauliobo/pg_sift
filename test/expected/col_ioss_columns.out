PREPARE io_p(int, int) AS SELECT count(*), sum(id), sum(n) FROM (SELECT id, n FROM io WHERE a BETWEEN $1 AND $2 OFFSET 0) x;
SET plan_cache_mode = force_generic_plan;
EXECUTE io_p(100, 400);
