-- the copy equals the join after the edits, and a pair of an id that has no fact adds no row
SELECT count(*) AS differs FROM sift.scope_verify('facts_by_tenant');
 differs 
---------
       0
(1 row)

SELECT (SELECT md5(string_agg(tenant_id || '/' || id || '/' || dim_a_id || '/' || kind || '/' || amount, ',' ORDER BY tenant_id, id)) FROM facts_by_tenant)
	 = (SELECT md5(string_agg(s.tenant_id || '/' || f.id || '/' || f.dim_a_id || '/' || f.kind || '/' || f.amount, ',' ORDER BY s.tenant_id, f.id))
		FROM facts f JOIN scope_pairs s USING (dim_a_id)) AS rows_equal_join;
 rows_equal_join 
-----------------
 t
(1 row)

-- facts and pairs that change in one statement: the facts of the new pair's member that the same statement inserts are in the copy once
WITH f AS (INSERT INTO facts (dim_a_id, kind, amount) VALUES (6500, 1, 1), (6500, 2, 2) RETURNING 1) INSERT INTO scope_pairs VALUES (6500, 300), (6501, 300);
SELECT count(*) AS differs FROM sift.scope_verify('facts_by_tenant');
 differs 
---------
       0
(1 row)

SELECT count(*) AS rows_of_the_new_pair FROM facts_by_tenant WHERE dim_a_id = 6500 AND tenant_id = 300;
 rows_of_the_new_pair 
----------------------
                    2
(1 row)

-- a partitioned copy: the same insert, one partition for each key
SELECT sift.scope_drop('facts_by_tenant');
