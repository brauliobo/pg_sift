-- VACUUM of a table whose sift_col index is damaged succeeds: the index is taken out of service (the warning says so), the dead rows are removed from the heap, and the
-- statements that follow give the answers of the heap
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.on_corruption = quarantine;
CREATE TABLE t (id int, v int);
INSERT INTO t SELECT g, g % 7 FROM generate_series(1, 20000) g;
CREATE INDEX t_idx ON t USING sift_col (id, v);
NOTICE:  sift_col index "t_idx": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('t_idx');
DELETE FROM t WHERE id % 5 = 0;
SELECT count(*) AS rows_before, sum(id) FILTER (WHERE v = 3) AS ids_before FROM t;
 rows_before | ids_before 
-------------+------------
       16000 |   22845713
(1 row)

-- the liveness run of the segment gets another page type
SELECT first_block AS live FROM sift.col_extents('t_idx') WHERE what = 'liveness run' \gset
SELECT sift._test_poke('t_idx', :live, 8176, 9, 2);
 _test_poke 
------------
 
(1 row)

VACUUM t;
WARNING:  sift index "t_idx" is quarantined; VACUUM skipped it
HINT:  Queries and maintenance run without it. REINDEX INDEX public.t_idx puts it back in service.
SELECT index, error_code, detections, skipped_writes, skipped_vacuums, refused_scans FROM sift.quarantine;
 index | error_code | detections | skipped_writes | skipped_vacuums | refused_scans 
-------+------------+------------+----------------+-----------------+---------------
 t_idx | XX002      |          1 |              0 |               2 |             0
(1 row)

SELECT n_dead_tup AS dead_after_vacuum FROM pg_stat_all_tables WHERE relid = 't'::regclass;
 dead_after_vacuum 
-------------------
                 0
(1 row)

SELECT count(*) AS rows_after, sum(id) FILTER (WHERE v = 3) AS ids_after FROM t;
 rows_after | ids_after 
------------+-----------
      16000 |  22845713
(1 row)

-- a second VACUUM has nothing to do with the index and says so
VACUUM t;
SELECT index, detections, skipped_vacuums FROM sift.quarantine;
 index | detections | skipped_vacuums 
-------+------------+-----------------
 t_idx |          1 |               3
(1 row)

VACUUM (ANALYZE) t;
REINDEX INDEX t_idx;
NOTICE:  sift_col index "t_idx": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('t_idx');
SELECT count(*) AS listed_after_reindex FROM sift.quarantine;
 listed_after_reindex 
----------------------
                    0
(1 row)

VACUUM t;
SELECT count(*) AS rows_after_reindex FROM t;
 rows_after_reindex 
--------------------
              16000
(1 row)

DROP TABLE t;
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
