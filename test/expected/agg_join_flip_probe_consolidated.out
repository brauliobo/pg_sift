-- <<< agg_left_child_scan
-- >>> agg_left_partial
CREATE SCHEMA s6;
GRANT USAGE ON SCHEMA s6 TO PUBLIC;
SET search_path = s6, public;
SET sift.test_create_format1 = on;
-- A table left-joined to a join of two small tables (every kind and region with its count, zero for the pairs of no event) cannot be one preserved lookup, so the join read every row of
-- the table. The scan makes the groups of the rows by the columns the join equates and the query joins them to the pairs: a count is the group's (0 for a pair of none), a sum, min or max
-- the group's (NULL for none), count(*) counts the row of a pair of none once. `partial` says the plan reads the groups in the scan, `rows_same` that the rows are those of sift off.
-- What the groups cannot give (a float sum, avg, count(DISTINCT), a column of the table outside the aggregates, a WHERE on it) keeps the join.
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE lp_kinds (id int PRIMARY KEY, name text NOT NULL);
CREATE TABLE lp_regions (region text PRIMARY KEY);
CREATE TABLE lp_events (id int PRIMARY KEY, kind_id int, region text, status text NOT NULL, qty int, amount numeric, ratio float8) WITH (autovacuum_enabled = false);
INSERT INTO lp_kinds SELECT i, 'kind_' || i FROM generate_series(1, 8) i;
INSERT INTO lp_regions SELECT 'r' || i FROM generate_series(1, 6) i;
INSERT INTO lp_events SELECT i, CASE WHEN i % 89 = 0 THEN NULL ELSE 1 + i % 6 END, CASE WHEN i % 97 = 0 THEN NULL ELSE 'r' || (1 + i % 5) END,
  (ARRAY['new','paid','void'])[1 + i % 3], CASE WHEN i % 13 = 0 THEN NULL ELSE i % 50 END, (i % 1000) / 10.0, (i % 70) / 7.0 FROM generate_series(1, 7500) i;
CREATE INDEX lp_events_col ON lp_events USING sift_col (id, kind_id, region, status, qty, amount, ratio);
VACUUM (FREEZE, ANALYZE) lp_kinds, lp_regions, lp_events;
CREATE TABLE q (ord serial, name text, sql text);
INSERT INTO q (name, sql) VALUES
  ('count of a column',           $q$SELECT k.name, r.region, count(e.id) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2$q$),
  ('count(*) and sums',           $q$SELECT k.name, r.region, count(*), sum(e.qty), sum(e.amount), min(e.amount), max(e.status) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2$q$),
  ('a condition on the table',    $q$SELECT k.name, r.region, count(e.id), sum(e.qty) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region AND e.status = 'paid' GROUP BY 1, 2$q$),
  ('a condition on the pairs',    $q$SELECT k.name, r.region, count(*), count(e.id) FROM lp_kinds k JOIN lp_regions r ON true LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region AND k.id % 2 = 0 GROUP BY 1, 2$q$),
  ('a WHERE on the pairs',        $q$SELECT k.name, r.region, count(e.id) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region WHERE k.id <= 7 AND r.region <> 'r2' GROUP BY 1, 2$q$),
  ('groups of several pairs',     $q$SELECT k.name, count(e.id), count(*), sum(e.qty) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1$q$),
  ('HAVING',                      $q$SELECT k.name, r.region, sum(e.qty) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2 HAVING sum(e.qty) > 5000 OR count(e.id) = 0$q$),
  ('no GROUP BY',                 $q$SELECT count(*), count(e.id), sum(e.qty), max(e.amount) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region$q$),
  ('no GROUP BY, no pair',        $q$SELECT count(*), count(e.id), sum(e.qty) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region WHERE k.id > 100$q$),
  ('ORDER BY and LIMIT',          $q$SELECT k.name, r.region, count(e.id) c FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2 ORDER BY c DESC, 1, 2 LIMIT 5$q$),
  ('a float sum',                 $q$SELECT k.name, r.region, sum(e.ratio) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2$q$),
  ('avg',                         $q$SELECT k.name, r.region, avg(e.qty) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2$q$),
  ('count(DISTINCT)',             $q$SELECT k.name, r.region, count(DISTINCT e.status) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2$q$),
  ('a column of the table',       $q$SELECT k.name, e.status, count(*) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region GROUP BY 1, 2$q$),
  ('a WHERE on the table',        $q$SELECT k.name, r.region, count(e.id) FROM lp_kinds k CROSS JOIN lp_regions r LEFT JOIN lp_events e ON e.kind_id = k.id AND e.region = r.region WHERE e.status IS NULL OR e.status = 'void' GROUP BY 1, 2$q$);
CREATE FUNCTION partial_check(q text) RETURNS TABLE (partial bool, rows_same bool) LANGUAGE plpgsql AS
$$ DECLARE l text; plan text := ''; a text; b text;
BEGIN
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP plan := plan || l || E'\n'; END LOOP;
  partial := plan LIKE '%Subquery Scan on e%' AND plan LIKE '%Custom Scan (SiftAgg%';
  PERFORM set_config('sift.enable_agg', 'on', true);
  EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (' || q || ') r' INTO a;
  PERFORM set_config('sift.enable_agg', 'off', true);
  EXECUTE 'SELECT md5(string_agg(r::text, ''|'' ORDER BY r::text)) FROM (' || q || ') r' INTO b;
  PERFORM set_config('sift.enable_agg', 'on', true);
  rows_same := a IS NOT DISTINCT FROM b;
  RETURN NEXT;
END $$;
SELECT q.name, c.* FROM q, LATERAL partial_check(q.sql) c ORDER BY q.ord;
           name           | partial | rows_same 
--------------------------+---------+-----------
 count of a column        | t       | t
 count(*) and sums        | t       | t
 a condition on the table | t       | t
 a condition on the pairs | t       | t
 a WHERE on the pairs     | t       | t
 groups of several pairs  | t       | t
 HAVING                   | t       | t
 no GROUP BY              | t       | t
 no GROUP BY, no pair     | f       | t
 ORDER BY and LIMIT       | t       | t
 a float sum              | f       | t
 avg                      | f       | t
 count(DISTINCT)          | f       | t
 a column of the table    | f       | t
 a WHERE on the table     | f       | t
(15 rows)

DROP FUNCTION partial_check(text);
DROP TABLE q, lp_kinds, lp_regions, lp_events;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s6 CASCADE;
RESET client_min_messages;
-- <<< agg_left_partial
-- >>> agg_probe_rewrite
CREATE SCHEMA s7;
GRANT USAGE ON SCHEMA s7 TO PUBLIC;
SET search_path = s7, public;
SET sift.test_create_format1 = on;
-- A join to a large table on a btree column, and an EXISTS, NOT EXISTS or IN over one, has the same rows as the lateral child that is a probe of the btree for each key the scan meets;
-- the planner makes that form too and keeps it where it costs less.
SET client_min_messages = warning;
SET jit = off;
-- NULL keys in a tenth of the events, three thousand keys, ten events to each
CREATE TABLE ev (id int, fk int, v int, d date) WITH (autovacuum_enabled = false);
INSERT INTO ev SELECT i, CASE WHEN i % 10 = 0 THEN NULL ELSE i % 3000 END, i % 7, date '2026-01-01' + i % 300 FROM generate_series(1, 30000) i;
CREATE INDEX ev_col ON ev USING sift_col (id, fk, v, d);
-- ten rows to a key, five statuses, no row for a key that is a multiple of seven
CREATE TABLE lk (id int NOT NULL, parent int NOT NULL, status int, label text, weight int) WITH (autovacuum_enabled = false);
INSERT INTO lk SELECT i, i % 3000, (i / 3000) % 5, 'l' || (i % 3000 % 3), i % 4 FROM generate_series(0, 14999) i WHERE i % 3000 % 7 <> 0;
INSERT INTO lk SELECT i, i % 3000, (i / 3000) % 5, 'l' || (i % 3000 % 3), i % 4 FROM generate_series(30000, 18499) i WHERE i % 3000 % 7 <> 0;
CREATE INDEX lk_cover ON lk (parent, status) INCLUDE (label, weight);
-- a table of seven rows, below the size a probe is made for
CREATE TABLE dm (v int);
INSERT INTO dm SELECT generate_series(0, 6);
VACUUM (FREEZE, ANALYZE) ev, lk, dm;
CREATE FUNCTION probe_q(keys text, kind text) RETURNS text LANGUAGE sql AS $$
	SELECT CASE kind
		WHEN 'inner' THEN format('SELECT lk.label, count(*), sum(ev.v) FROM ev JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN %s AND ev.d IS NOT NULL GROUP BY 1 ORDER BY 1', keys)
		WHEN 'inner_covered' THEN format('SELECT lk.label, count(*), sum(lk.weight) FROM ev JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'left' THEN format('SELECT lk.label, count(*), sum(ev.v), count(lk.id) FROM ev LEFT JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'left_null_keys' THEN format('SELECT lk.label, count(*), sum(ev.v) FROM ev LEFT JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.id BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'semi' THEN format('SELECT ev.v, count(*) FROM ev WHERE ev.fk BETWEEN %s AND EXISTS (SELECT 1 FROM lk WHERE lk.parent = ev.fk AND lk.status = 4 AND lk.label = ''l1'') GROUP BY 1 ORDER BY 1', keys)
		WHEN 'anti' THEN format('SELECT ev.v, count(*) FROM ev WHERE ev.fk BETWEEN %s AND NOT EXISTS (SELECT 1 FROM lk WHERE lk.parent = ev.fk AND lk.status = 4 AND lk.label = ''l1'') GROUP BY 1 ORDER BY 1', keys)
		WHEN 'inner_heap' THEN format('SELECT lk.label, count(*), sum(lk.id) FROM ev JOIN lk ON lk.parent = ev.fk WHERE ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'system_column' THEN format('SELECT lk.label, count(*) FROM ev JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN %s AND lk.ctid IS NOT NULL GROUP BY 1 ORDER BY 1', keys)
		WHEN 'comma_lateral' THEN format('SELECT x.w, count(*) FROM ev, lk, LATERAL (SELECT ev.v + 1 AS w) x WHERE lk.parent = ev.fk AND lk.status = 2 AND ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'comma' THEN format('SELECT lk.label, count(*), sum(ev.v) FROM ev, lk WHERE lk.parent = ev.fk AND lk.status = 2 AND ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'comma_three' THEN format('SELECT lk.label, count(*), sum(dm.v) FROM dm, ev, lk WHERE ev.v = dm.v AND lk.parent = ev.fk AND lk.status = 2 AND ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'not_in' THEN format('SELECT ev.v, count(*) FROM ev WHERE ev.fk BETWEEN %s AND ev.fk NOT IN (SELECT lk.parent FROM lk WHERE lk.status = 4 AND lk.label = ''l1'') GROUP BY 1 ORDER BY 1', keys)
		WHEN 'not_in_nullable' THEN format('SELECT ev.v, count(*) FROM ev WHERE ev.v < 3 AND ev.id BETWEEN %s AND ev.fk NOT IN (SELECT lk.parent FROM lk WHERE lk.status = 4 AND lk.label = ''l1'') GROUP BY 1 ORDER BY 1', keys)
		WHEN 'sublink' THEN format('SELECT ev.v, count(*) FROM ev JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN %s AND (SELECT count(*) FROM dm WHERE dm.v = lk.weight) > 0 GROUP BY 1 ORDER BY 1', keys)
		WHEN 'sublink_in_list' THEN format('SELECT ev.v, count(*), max((SELECT dm.v FROM dm WHERE dm.v = lk.weight + 1)) FROM ev LEFT JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'whole_row' THEN format('SELECT ev.v, count(lk), sum(length(lk::text)), count(*) FROM ev LEFT JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'join_alias' THEN format('SELECT j.label, count(*), sum(j.weight) FROM (ev JOIN lk ON lk.parent = ev.fk AND lk.status = 2) AS j (eid, fk, v, d, lid, parent, status, label, weight) WHERE j.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'anti_two_tables' THEN format('SELECT dm.v, count(*) FROM ev, dm WHERE ev.v = dm.v AND ev.fk BETWEEN %s AND NOT EXISTS (SELECT 1 FROM lk WHERE lk.parent = ev.fk AND lk.status = 4 AND lk.label = ''l1'') GROUP BY 1 ORDER BY 1', keys)
		WHEN 'lateral_entry' THEN format('SELECT x.w, count(*) FROM ev JOIN lk ON lk.parent = ev.fk AND lk.status = 2, LATERAL (SELECT lk.weight + ev.v AS w) x WHERE ev.fk BETWEEN %s GROUP BY 1 ORDER BY 1', keys)
		WHEN 'in' THEN format('SELECT ev.v, count(*) FROM ev WHERE ev.fk BETWEEN %s AND ev.fk IN (SELECT lk.parent FROM lk WHERE lk.status = 4 AND lk.label = ''l1'') GROUP BY 1 ORDER BY 1', keys)
	END
$$;
-- whether the statement runs a probe of the table's btree for each key
CREATE FUNCTION probes(sql text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE l text; r boolean := false; BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || sql LOOP
		r := r OR l ~ 'Lookup Joins: .*sift_probe';
	END LOOP;
	RETURN r;
END $$;
SELECT '100 AND 109' AS few \gset
-- a few keys: the probes, and no bitmap scan in the child of one that fetches rows from the heap (the scan walks an index scan in its btree)
CREATE FUNCTION bitmap_child(sql text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE l text; r boolean := false; BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || sql LOOP
		r := r OR l ~ 'Bitmap';
	END LOOP;
	RETURN r;
END $$;
SELECT bitmap_child(probe_q(:'few', 'inner_heap')) AS bitmap_child;
