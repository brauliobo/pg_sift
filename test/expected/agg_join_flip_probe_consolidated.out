-- The join flips and the probe rewrites of src/agg/plan and src/agg/flat (invert, partial, probe), one segment each, in a schema of its own: anti joins, the child-first gate,
-- disabled-node ranking, the scan side of an inner join, LEFT JOIN child scans, partial joins, btree probes (also partial and unvacuumed) and sift_table probes. Replaces ten tests.
CREATE EXTENSION pg_sift;
-- >>> agg_anti_flip
CREATE SCHEMA s1;
GRANT USAGE ON SCHEMA s1 TO PUBLIC;
SET search_path = s1, public;
SET sift.test_create_format1 = on;
-- The parents that have no child (a LEFT JOIN with a WHERE on a column of the child being NULL, or NOT EXISTS: an anti join) are counted from the child's scan with the
-- parents as its lookup, as the LEFT JOIN is, where the child is much larger than the parents: the scan reads the keys that have children once and the parents that
-- none of them names are the rows left. PostgreSQL 19 hands the planner the anti join for the LEFT JOIN as well; 17 and 18 hand the LEFT JOIN and its WHERE. The
-- answers are those of the normal plan for every form, with NULL keys, children of no parent, an ON condition on both tables and a filter of the parents.
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
CREATE TABLE af_parent (id int PRIMARY KEY, alt int, grp int, rank int) WITH (autovacuum_enabled = off);
INSERT INTO af_parent SELECT g, CASE WHEN g % 7 = 0 THEN NULL ELSE g END, g % 25, g % 100 FROM generate_series(1, 2500) g;
CREATE TABLE af_child (id int PRIMARY KEY, parent_id int, kind text, amount int) WITH (autovacuum_enabled = off);
INSERT INTO af_child
SELECT g, CASE WHEN g % 97 = 0 THEN NULL WHEN g % 53 = 0 THEN 30000 + g % 100 ELSE 1 + (g::bigint * 7919) % 15000 END, (ARRAY['a', 'b', 'c', 'd'])[1 + g % 4], g % 1000
FROM generate_series(1, 50000) g;
CREATE INDEX af_parent_col ON af_parent USING sift_col (id, alt, grp, rank);
CREATE INDEX af_child_col ON af_child USING sift_col (id, parent_id, kind, amount);
VACUUM (FREEZE, ANALYZE) af_parent, af_child;
CREATE TABLE shapes (slug text, sql text);
INSERT INTO shapes VALUES
 ('left_join_childless_by_group', 'SELECT p.grp, count(*) AS parents FROM af_parent p LEFT JOIN af_child c ON c.parent_id = p.id AND c.kind = ''d'' WHERE c.id IS NULL GROUP BY 1'),
 ('not_exists_childless_by_group', 'SELECT p.grp, count(*) AS parents FROM af_parent p WHERE NOT EXISTS (SELECT 1 FROM af_child c WHERE c.parent_id = p.id AND c.kind = ''d'') GROUP BY 1'),
 ('not_exists_childless_count', 'SELECT count(*) AS parents FROM af_parent p WHERE NOT EXISTS (SELECT 1 FROM af_child c WHERE c.parent_id = p.id)'),
 ('not_exists_childless_filtered_parents', 'SELECT p.grp, count(*) AS parents, sum(p.rank) AS ranks FROM af_parent p WHERE p.rank < 40 AND NOT EXISTS (SELECT 1 FROM af_child c WHERE c.parent_id = p.id AND c.amount > 500) GROUP BY 1'),
 ('not_exists_on_both_tables', 'SELECT p.grp, count(*) AS parents FROM af_parent p WHERE NOT EXISTS (SELECT 1 FROM af_child c WHERE c.parent_id = p.id AND c.amount > p.rank * 8) GROUP BY 1'),
 ('not_exists_null_parent_key', 'SELECT p.grp, count(*) AS parents FROM af_parent p WHERE NOT EXISTS (SELECT 1 FROM af_child c WHERE c.parent_id = p.alt) GROUP BY 1');
CREATE FUNCTION plan_of(sql text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'normal plan';
BEGIN
	PERFORM set_config('sift.enable_agg', 'true', true);
	PERFORM set_config('sift.agg_force', 'true', true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || sql LOOP
		IF l ~ 'Index: af_parent_col' THEN r := 'parents scanned'; END IF;
		IF l ~ 'Index: af_child_col' THEN r := 'children scanned'; END IF;
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION answer(sql text, scan bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text; BEGIN
	PERFORM set_config('sift.enable_agg', scan::text, true);
	PERFORM set_config('sift.agg_force', scan::text, true);
	EXECUTE 'SELECT string_agg(t::text, '';'' ORDER BY t::text) FROM (' || sql || ') t' INTO r;
	RETURN r;
END $$;
SELECT slug, plan_of(sql) AS plan, answer(sql, true) = answer(sql, false) AS same_answers FROM shapes ORDER BY slug;
                 slug                  |       plan       | same_answers 
---------------------------------------+------------------+--------------
 left_join_childless_by_group          | children scanned | t
 not_exists_childless_by_group         | children scanned | t
 not_exists_childless_count            | children scanned | t
 not_exists_childless_filtered_parents | children scanned | t
 not_exists_null_parent_key            | children scanned | t
 not_exists_on_both_tables             | children scanned | t
(6 rows)

DROP FUNCTION plan_of(text), answer(text, bool);
DROP TABLE shapes, af_child, af_parent;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s1 CASCADE;
RESET client_min_messages;
-- <<< agg_anti_flip
-- >>> agg_child_first_gate
CREATE SCHEMA s2;
GRANT USAGE ON SCHEMA s2 TO PUBLIC;
SET search_path = s2, public;
SET sift.test_create_format1 = on;
-- sift.agg_child_first gates the plans that scan the child of a LEFT JOIN with the preserved parent as its lookup (and the two rewrites around it, docs/COL-CONNECT.md):
-- on, the statement counts the children of each parent from a scan of the child; off, it is the lookup join, a scan of the parent that loads the child. The answers are the same, also for count(c) of the whole row of the child when most parents have no child (the nullable side: 0 for count(c), 1 for count(*)).
SET max_parallel_workers_per_gather = 0;
SET jit = off;
CREATE TABLE cf_parent (id int PRIMARY KEY, region int) WITH (autovacuum_enabled = false);
INSERT INTO cf_parent SELECT g, g % 50 FROM generate_series(1, 20000) g;
CREATE TABLE cf_child (id int PRIMARY KEY, parent_id int NOT NULL REFERENCES cf_parent, v int) WITH (autovacuum_enabled = false);
INSERT INTO cf_child SELECT g, 1 + (g::bigint * 7919) % 20000, g % 1000 FROM generate_series(1, 200000) g;
CREATE INDEX cf_parent_col ON cf_parent USING sift_col (id, region);
NOTICE:  sift_col index "cf_parent_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('cf_parent_col');
CREATE INDEX cf_child_col ON cf_child USING sift_col (id, parent_id, v);
NOTICE:  sift_col index "cf_child_col" connected to cf_parent(id) through foreign key "cf_child_parent_id_fkey"
HINT:  connect = 'off' on the index turns it off.
NOTICE:  sift_col index "cf_child_col": 3 automatic choices
DETAIL:  key_columns = parent_id; order_array_columns = v (second order by parent_id: entity); track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('cf_child_col');
NOTICE:  sift_col index "cf_child_col" is column format minor 38, which a library before 3.7 cannot read
DETAIL:  The choice order_array_columns writes it; sift.col_format_minor (15) numbers the formats of 3.x only, up to 15. sift.index_choices('cf_child_col') says how to turn each choice off.
HINT:  A superuser can SET sift.col_format_minor = 14 before the build to skip the choices that need it.
VACUUM (FREEZE, ANALYZE) cf_parent, cf_child;
CREATE FUNCTION joins(q text, child_first bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'none'; BEGIN
	PERFORM set_config('sift.enable_agg', 'true', true);
	PERFORM set_config('sift.agg_child_first', child_first::text, true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l ~ 'Lookup Joins:' THEN r := trim(l); END IF;
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION answer(q text, scan bool, child_first bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text; BEGIN
	PERFORM set_config('sift.enable_agg', scan::text, true);
	PERFORM set_config('sift.agg_child_first', child_first::text, true);
	EXECUTE 'SELECT string_agg(t::text, '';'' ORDER BY t::text) FROM (' || q || ') t' INTO r;
	RETURN r;
END $$;
SELECT q.name, joins(q.sql, true) AS child_first_on, joins(q.sql, false) AS child_first_off,
       answer(q.sql, true, true) = answer(q.sql, false, true) AS on_equals_native,
       answer(q.sql, true, false) = answer(q.sql, false, true) AS off_equals_native
FROM (VALUES
	('count per parent', 'SELECT p.id, count(c.id) FROM cf_parent p LEFT JOIN cf_child c ON c.parent_id = p.id GROUP BY p.id ORDER BY 2 DESC, 1 LIMIT 10'),
	('sum per region', 'SELECT p.region, count(c.id), sum(c.v) FROM cf_parent p LEFT JOIN cf_child c ON c.parent_id = p.id GROUP BY p.region ORDER BY 1'),
	('whole row of the child', 'SELECT p.region, count(c) AS c, count(*) AS s FROM cf_parent p LEFT JOIN cf_child c ON c.parent_id = p.id AND c.v = 3 GROUP BY p.region ORDER BY 1')
) q (name, sql) ORDER BY q.name;
          name          |           child_first_on            |        child_first_off        | on_equals_native | off_equals_native 
------------------------+-------------------------------------+-------------------------------+------------------+-------------------
 count per parent       | Lookup Joins: cf_parent (preserved) | none                          | t                | t
 sum per region         | Lookup Joins: cf_parent (preserved) | none                          | t                | t
 whole row of the child | Lookup Joins: c (subquery) (left)   | Lookup Joins: cf_child (left) | t                | t
(3 rows)

DROP FUNCTION joins(text, bool), answer(text, bool, bool);
DROP TABLE cf_child, cf_parent;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s2 CASCADE;
RESET client_min_messages;
-- <<< agg_child_first_gate
-- >>> agg_flat_disabled_nodes
CREATE SCHEMA s3;
GRANT USAGE ON SCHEMA s3 TO PUBLIC;
SET search_path = s3, public;
SET sift.test_create_format1 = on;
-- The plan of a rewrite (a LEFT JOIN counted from the child's groups, sift.agg_child_first) is set against the plan as written the way PostgreSQL ranks plans: the plan with fewer
-- nodes that enable_* = off disabled first, then the cost. 17 has the penalty in the cost, 18 counts the nodes apart: the choice is the same on every major, and so are the rows.
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
CREATE TABLE cw (grp int, a int) WITH (autovacuum_enabled = false);
CREATE TABLE lk (id int PRIMARY KEY, name text);
INSERT INTO cw SELECT 1 + i % 3, i % 5 FROM generate_series(1, 600) i;
INSERT INTO cw SELECT 4, NULL FROM generate_series(1, 2);
INSERT INTO lk VALUES (1, 'one'), (2, 'two'), (3, 'three'), (5, 'five');
CREATE INDEX cw_col ON cw USING sift_col (grp, a);
VACUUM (FREEZE, ANALYZE) cw, lk;
CREATE FUNCTION set_up(settings text, scan bool, child_first bool) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config(o, 'on', true) FROM unnest(ARRAY['enable_seqscan', 'enable_indexscan', 'enable_bitmapscan', 'enable_indexonlyscan', 'enable_hashjoin']) o;
	PERFORM set_config('sift.enable_agg', scan::text, true);
	PERFORM set_config('sift.agg_child_first', child_first::text, true);
	EXECUTE settings;
END $$;
CREATE FUNCTION plan_of(q text, settings text, child_first bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'normal plan'; BEGIN
	PERFORM set_up(settings, true, child_first);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF l ~ 'Custom Scan \(SiftAgg' THEN r := 'scan'; END IF;
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION answer(q text, settings text, scan bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text; BEGIN
	PERFORM set_up(settings, scan, true);
	EXECUTE 'SELECT string_agg(t::text, '';'' ORDER BY t::text) FROM (' || q || ') t' INTO r;
	RETURN r;
END $$;
SELECT s.name AS settings, q.name AS statement, plan_of(q.sql, s.sets, true) AS child_first_on, plan_of(q.sql, s.sets, false) AS child_first_off,
       answer(q.sql, s.sets, true) = answer(q.sql, s.sets, false) AS same_rows
FROM (VALUES
	('default', 'SELECT 1'),
	('seqscan off', 'SET LOCAL enable_seqscan = off'),
	('seqscan, hashjoin off', 'SET LOCAL enable_seqscan = off; SET LOCAL enable_hashjoin = off'),
	('every table scan off', 'SET LOCAL enable_seqscan = off; SET LOCAL enable_indexscan = off; SET LOCAL enable_bitmapscan = off; SET LOCAL enable_indexonlyscan = off')
) s (name, sets),
(VALUES
	('the table as the nullable side', 'SELECT l.id, count(e) AS c, count(*) AS s FROM lk l LEFT JOIN cw e ON e.grp = l.id GROUP BY 1'),
	('a list of values', 'SELECT v.g, count(e) AS c FROM (VALUES (1), (2), (9)) v (g) LEFT JOIN cw e ON e.grp = v.g GROUP BY 1')
) q (name, sql)
ORDER BY 1, 2;
       settings        |           statement            | child_first_on | child_first_off | same_rows 
-----------------------+--------------------------------+----------------+-----------------+-----------
 default               | a list of values               | normal plan    | normal plan     | t
 default               | the table as the nullable side | normal plan    | normal plan     | t
 every table scan off  | a list of values               | scan           | normal plan     | t
 every table scan off  | the table as the nullable side | scan           | normal plan     | t
 seqscan off           | a list of values               | scan           | normal plan     | t
 seqscan off           | the table as the nullable side | scan           | normal plan     | t
 seqscan, hashjoin off | a list of values               | scan           | normal plan     | t
 seqscan, hashjoin off | the table as the nullable side | scan           | normal plan     | t
(8 rows)

DROP FUNCTION answer(text, text, bool), plan_of(text, text, bool), set_up(text, bool, bool);
DROP TABLE cw, lk;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s3 CASCADE;
RESET client_min_messages;
-- <<< agg_flat_disabled_nodes
-- >>> agg_join_order
CREATE SCHEMA s4;
GRANT USAGE ON SCHEMA s4 TO PUBLIC;
SET search_path = s4, public;
SET sift.test_create_format1 = on;
-- The scan of an inner join reads the table that is dear to load as its own rows and loads the small ones as lookups, whichever table the FROM list
-- starts with.
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE customers AS SELECT i AS id, (ARRAY['A', 'B', 'C', 'D'])[1 + i % 4] AS segment FROM generate_series(1, 2500) i;
CREATE TABLE sales AS
SELECT i AS id, 1 + (i::bigint * 7919 % 5000)::int AS customer_id, DATE '2024-01-01' + (i * 13) % 700 AS ordered, DATE '2024-01-01' + (i * 13) % 700 + (i * 31) % 40 AS shipped,
	   (i % 97)::float8 AS amount
FROM generate_series(1, 150000) i;
CREATE INDEX customers_col ON customers USING sift_col (id, segment);
CREATE INDEX sales_col ON sales USING sift_col (customer_id, ordered, shipped, amount);
VACUUM (FREEZE, ANALYZE) customers, sales;
\ir test/agg_helpers.sql
\set ECHO none
-- the index the Custom Scan (SiftAgg) of a plan reads
CREATE FUNCTION scanned(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE line text; found text;
BEGIN
  PERFORM set_config('sift.enable_agg', 'on', true);
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP found := coalesce(found, substring(line from 'Index: (\w+)')); END LOOP;
  RETURN found;
END $$;
CREATE FUNCTION same(q text) RETURNS bool LANGUAGE sql AS $$ SELECT outcome(q, false) = outcome(q, true) $$;
CREATE TABLE shapes (name text, q text);
INSERT INTO shapes VALUES
 ('segment', $q$ SELECT segment, count(*) AS n, sum(amount) AS total FROM %s WHERE sales.customer_id = customers.id AND ordered < DATE '2025-03-01' GROUP BY 1 $q$),
 ('late', $q$ SELECT segment, count(*) AS n FROM %s WHERE sales.customer_id = customers.id AND shipped > ordered + 30 AND segment IN ('A', 'B') GROUP BY 1 $q$);
-- both orders of the FROM list scan the large table and give the answers of the normal plan
SELECT name, scanned(format(q, 'customers, sales')) AS dimension_first, scanned(format(q, 'sales, customers')) AS fact_first,
       same(format(q, 'customers, sales')) AS dimension_first_same, same(format(q, 'sales, customers')) AS fact_first_same
FROM shapes ORDER BY name;
  name   | dimension_first | fact_first | dimension_first_same | fact_first_same 
---------+-----------------+------------+----------------------+-----------------
 late    | sales_col       | sales_col  | t                    | t
 segment | sales_col       | sales_col  | t                    | t
(2 rows)

-- a lookup table read whole from the leaves of a column index that holds its columns is priced below the same read from the heap
CREATE TEMP TABLE load_price (leaves bool, scan_cost float8);
SET sift.agg_lookup_columns = on;
INSERT INTO load_price SELECT true, scan_cost FROM sift.explain_why(format((SELECT q FROM shapes WHERE name = 'segment'), 'sales, customers')) WHERE arm = 'single';
SET sift.agg_lookup_columns = off;
INSERT INTO load_price SELECT false, scan_cost FROM sift.explain_why(format((SELECT q FROM shapes WHERE name = 'segment'), 'sales, customers')) WHERE arm = 'single';
RESET sift.agg_lookup_columns;
SELECT (SELECT scan_cost FROM load_price WHERE leaves) < (SELECT scan_cost FROM load_price WHERE NOT leaves) AS cheaper_from_the_leaves;
 cheaper_from_the_leaves 
-------------------------
 t
(1 row)

DROP FUNCTION scanned(text), same(text), outcome(text, bool), runs_in_scan(text), pushed(text), runq(text, bool);
DROP TABLE shapes, sales, customers;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s4 CASCADE;
RESET client_min_messages;
-- <<< agg_join_order
-- >>> agg_left_child_scan
CREATE SCHEMA s5;
GRANT USAGE ON SCHEMA s5 TO PUBLIC;
SET search_path = s5, public;
SET sift.test_create_format1 = on;
-- A LEFT JOIN of two tables that both have a sift_col index: the scan may run over the child with the preserved parent as its lookup, as well as over the parent with the child as
-- its lookup, and the price chooses. The answers are those of the normal plan, serial and with workers, before and after writes to the parent and to the child (a parent
-- with no child, a child of no parent, a key changed, rows deleted).
SET jit = off;
SET sift.agg_force = on;
CREATE TABLE parent (id int PRIMARY KEY, region int, kind int, name text) WITH (autovacuum_enabled = false);
INSERT INTO parent SELECT i, i % 100, i % 10, CASE WHEN i % 17 = 0 THEN NULL ELSE 'p' || i END FROM generate_series(1, 20000) i;
CREATE TABLE child (id int PRIMARY KEY, parent_id int, v int, ts date, flag bool) WITH (autovacuum_enabled = false);
-- 200,000 children of 18,000 parents (the others have none), 1,000 of keys no parent has, and some NULL keys
INSERT INTO child SELECT i, CASE WHEN i % 200 = 0 THEN NULL WHEN i % 200 = 1 THEN 30000 + i % 1000 ELSE 1 + (i * 7) % 18000 END, (i * 13) % 100,
	date '2026-01-01' + (i % 300), i % 3 = 0 FROM generate_series(1, 200000) i;
CREATE INDEX parent_col ON parent USING sift_col (id, region, kind, name);
NOTICE:  sift_col index "parent_col": 2 automatic choices (rollup_columns, track_changes)
DETAIL:  rollup_columns = region, kind; track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('parent_col');
CREATE INDEX child_col ON child USING sift_col (id, parent_id, v, ts, flag);
NOTICE:  sift_col index "child_col": 5 automatic choices
DETAIL:  key_order = parent_id, ts; key_columns = parent_id; rollup_columns = v, flag;
order_array_columns = ts (second order only); track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('child_col');
NOTICE:  sift_col index "child_col" is column format minor 38, which a library before 3.7 cannot read
DETAIL:  The choice order_array_columns writes it; sift.col_format_minor (15) numbers the formats of 3.x only, up to 15. sift.index_choices('child_col') says how to turn each choice off.
HINT:  A superuser can SET sift.col_format_minor = 14 before the build to skip the choices that need it.
VACUUM (FREEZE, ANALYZE) parent, child;
CREATE TABLE shapes (slug text, sql text);
INSERT INTO shapes VALUES
 ('left_join_top_parents_by_children', $q$SELECT p.id, count(c.id) FROM parent p LEFT JOIN child c ON c.parent_id = p.id GROUP BY p.id ORDER BY 2 DESC, 1 LIMIT 10$q$),
 ('left_join_count_by_region', $q$SELECT p.region, count(c.id), count(*) FROM parent p LEFT JOIN child c ON c.parent_id = p.id GROUP BY 1$q$),
 ('left_join_flagged_recent_sum_by_region', $q$SELECT p.region, sum(c.v) FROM parent p LEFT JOIN child c ON c.parent_id = p.id AND c.flag AND c.ts >= date '2026-06-01' GROUP BY 1$q$),
 ('left_join_small_values_by_region', $q$SELECT p.region, count(*), count(c.flag), sum(c.v) FROM parent p LEFT JOIN child c ON c.parent_id = p.id AND c.v < 5 WHERE p.id > 100 GROUP BY p.region$q$),
 ('left_join_count_distinct_value_by_kind', $q$SELECT p.kind, count(DISTINCT c.v), max(c.ts), min(p.name) FROM parent p LEFT JOIN child c ON c.parent_id = p.id WHERE p.region < 50 GROUP BY 1$q$),
 ('left_join_childless_count_and_sum', $q$SELECT count(*) FILTER (WHERE c.id IS NULL), count(c.id), sum(c.v) FROM parent p LEFT JOIN child c ON c.parent_id = p.id$q$),
 ('left_join_orphans_by_flag', $q$SELECT p.name IS NULL, c.flag, count(*) FROM parent p LEFT JOIN child c ON c.parent_id = p.id GROUP BY 1, 2$q$),
 ('left_join_high_or_missing_by_region', $q$SELECT p.region, count(*) FROM parent p LEFT JOIN child c ON c.parent_id = p.id WHERE c.v > 90 OR c.v IS NULL GROUP BY 1$q$);
CREATE FUNCTION answer(sql text, scan bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text; BEGIN
	PERFORM set_config('sift.enable_agg', scan::text, true);
	EXECUTE 'SELECT string_agg(t::text, '';'' ORDER BY t::text) FROM (' || sql || ') t' INTO r;
	RETURN r;
END $$;
-- the table the scan runs over ('normal' when the statement has no scan)
CREATE FUNCTION scanned(sql text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'normal'; BEGIN
	PERFORM set_config('sift.enable_agg', 'true', true);
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || sql LOOP
		IF l ~ 'Index: child_col' THEN r := 'child'; ELSIF l ~ 'Index: parent_col' THEN r := 'parent'; END IF;
	END LOOP;
	RETURN r;
END $$;
CREATE FUNCTION report(label text) RETURNS TABLE (stage text, workers int, shape text, same_answers bool, scan text) LANGUAGE plpgsql AS $$
DECLARE w int; BEGIN
	FOREACH w IN ARRAY ARRAY[0, 2] LOOP
		PERFORM set_config('max_parallel_workers_per_gather', w::text, true);
		PERFORM set_config('parallel_setup_cost', '0', true);
		PERFORM set_config('parallel_tuple_cost', '0', true);
		PERFORM set_config('min_parallel_table_scan_size', '0', true);
		RETURN QUERY SELECT label, w, slug, answer(sql, true) = answer(sql, false), scanned(sql) FROM shapes ORDER BY slug;
	END LOOP;
END $$;
