 status  |       3 | t
(10 rows)

DROP FUNCTION compare_all(), answers(text, text, text, int), probes(text), probe_q(text, text);
DROP TABLE ev, lk;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s8 CASCADE;
RESET client_min_messages;
-- <<< agg_probe_partial
-- >>> agg_probe_table_am
CREATE SCHEMA s9;
GRANT USAGE ON SCHEMA s9 TO PUBLIC;
SET search_path = s9, public;
SET sift.test_create_format1 = on;
-- A correlated probe of a table of another access method (sift_table) fetches every entry through the access method, an Index Only Scan too: the scan that probes it does the work of
-- the normal plan's nested loop and no less, so it is not chosen; the same probe of a heap table, whose entries an all-visible page gives from the btree, is. The answers are the same.
-- The count of the NOT EXISTS and of the EXISTS (shapes 1 and 3 on the table of the other access method) is made from a scan of the fact table instead (agg/flat/invert.c), which reads less
-- than the probes; the NOT EXISTS grouped by a column of the dimension (shape 5) from the same scan, which keeps the rows of the dimension nothing matched (agg/from/scan.c).
SET max_parallel_workers_per_gather = 0;
SET jit = off;
CREATE TABLE dim (id int PRIMARY KEY, grp int) WITH (autovacuum_enabled = false);
INSERT INTO dim SELECT g, g % 7 FROM generate_series(1, 5000) g;
CREATE INDEX dim_col ON dim USING sift_col (id, grp);
NOTICE:  sift_col index "dim_col": 1 automatic choice (track_changes)
DETAIL:  track_changes = id
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('dim_col');
-- the keys 4501 to 5000 have no fact
CREATE TABLE fact_am (id bigint PRIMARY KEY, dim_id int) USING sift_table;
INSERT INTO fact_am SELECT g, 1 + (hashint4(g) & 2147483647) % 4500 FROM generate_series(1, 100000) g;
CREATE INDEX fact_am_k ON fact_am (dim_id);
CREATE TABLE fact_h (id bigint PRIMARY KEY, dim_id int) WITH (autovacuum_enabled = false);
INSERT INTO fact_h SELECT * FROM fact_am;
CREATE INDEX fact_h_k ON fact_h (dim_id);
VACUUM (FREEZE, ANALYZE) dim, fact_am, fact_h;
CREATE TABLE shapes (n int, sql text);
INSERT INTO shapes
SELECT row_number() OVER (), format(q, t) FROM (VALUES
 ($q$SELECT count(*) FROM dim d WHERE NOT EXISTS (SELECT 1 FROM %s f WHERE f.dim_id = d.id)$q$),
 ($q$SELECT count(*) FROM dim d WHERE EXISTS (SELECT 1 FROM %s f WHERE f.dim_id = d.id)$q$),
 ($q$SELECT d.grp, count(*) FROM dim d WHERE NOT EXISTS (SELECT 1 FROM %s f WHERE f.dim_id = d.id) GROUP BY 1 ORDER BY 1$q$)
) q (q), (VALUES ('fact_am'), ('fact_h')) t (t);
CREATE FUNCTION answer(sql text, force bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text; BEGIN
	PERFORM set_config('sift.agg_force', force::text, true);
	EXECUTE 'SELECT string_agg(t::text, '';'' ORDER BY t::text) FROM (' || sql || ') t' INTO r;
	RETURN r;
END $$;
CREATE FUNCTION plan(sql text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'normal'; BEGIN
	FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || sql LOOP
		IF l ~ 'Custom Scan \(SiftAgg' THEN r := 'SiftAgg'; END IF;
	END LOOP;
	RETURN r;
END $$;
SELECT n, substring(sql from 'FROM (fact_\w+)') AS fact, plan(sql), answer(sql, true) = answer(sql, false) AS same_answers FROM shapes ORDER BY n;
 n |  fact   |  plan   | same_answers 
---+---------+---------+--------------
 1 | fact_am | SiftAgg | t
 2 | fact_h  | SiftAgg | t
 3 | fact_am | SiftAgg | t
 4 | fact_h  | SiftAgg | t
 5 | fact_am | SiftAgg | t
 6 | fact_h  | SiftAgg | t
(6 rows)

DROP FUNCTION plan(text), answer(text, bool);
DROP TABLE shapes, dim, fact_am, fact_h;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s9 CASCADE;
RESET client_min_messages;
-- <<< agg_probe_table_am
-- >>> agg_probe_unvacuumed
CREATE SCHEMA s10;
GRANT USAGE ON SCHEMA s10 TO PUBLIC;
SET search_path = s10, public;
SET sift.test_create_format1 = on;
-- A table that was loaded and never vacuumed or analyzed has reltuples = -1 and nothing visible in its visibility map. The probe rewrite of an EXISTS, NOT EXISTS, NOT IN or
-- join to a large btree table was refused for it (it asked pg_class for the rows), so the scan read the whole table or PostgreSQL kept its own plan: the planner's own estimate
-- of the rows (from the pages and the row width) decides, as it does for the plans around it. A correlated LIMIT 1 child that the scan probes in its btree (probe_direct) is priced
-- by what the probe takes, not by the normal plan's idea of the rows: it is the scan's plan in the three states.
SET client_min_messages = warning;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
CREATE TABLE ev (id int, fk int, v int) WITH (autovacuum_enabled = false);
INSERT INTO ev SELECT i, 1 + i % 3000, i % 7 FROM generate_series(1, 150000) i;
CREATE INDEX ev_col ON ev USING sift_col (id, fk, v);
CREATE TABLE lk (id int NOT NULL, parent int NOT NULL, status int, label text, weight int) WITH (autovacuum_enabled = false);
-- the index exists before the rows: the reltuples a btree build leaves in the table differs between PostgreSQL 17 (the rows) and 18 (-1), the state of the test is -1
CREATE INDEX lk_cover ON lk (parent, status) INCLUDE (label, weight);
INSERT INTO lk SELECT i, 1 + i % 3000, (i / 3000) % 5, 'l' || (i % 3000 % 3), i % 4 FROM generate_series(0, 74999) i;
SELECT c.relname, c.reltuples, c.relallvisible FROM pg_class c WHERE c.relname IN ('ev', 'lk') ORDER BY 1;
 relname | reltuples | relallvisible 
---------+-----------+---------------
 ev      |    150000 |             0
 lk      |        -1 |             0
(2 rows)

CREATE FUNCTION probes(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE line text;
BEGIN
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF line LIKE '%Lookup Joins:%' THEN RETURN true; END IF;
	END LOOP;
	RETURN false;
END $$;
CREATE TABLE shapes (name text, q text);
INSERT INTO shapes VALUES
 ('not_in', $q$SELECT ev.v, count(*) FROM ev WHERE ev.fk BETWEEN 100 AND 159 AND ev.fk NOT IN (SELECT lk.parent FROM lk WHERE lk.status = 4 AND lk.label = 'l1') GROUP BY 1 ORDER BY 1$q$),
 ('anti', $q$SELECT ev.v, count(*) FROM ev WHERE ev.fk BETWEEN 100 AND 159 AND NOT EXISTS (SELECT 1 FROM lk WHERE lk.parent = ev.fk AND lk.status = 4 AND lk.label = 'l1') GROUP BY 1 ORDER BY 1$q$),
 ('semi', $q$SELECT ev.v, count(*) FROM ev WHERE ev.fk BETWEEN 100 AND 159 AND EXISTS (SELECT 1 FROM lk WHERE lk.parent = ev.fk AND lk.status = 4 AND lk.label = 'l1') GROUP BY 1 ORDER BY 1$q$),
 ('lateral', $q$SELECT ev.v, count(*) FROM ev JOIN LATERAL (SELECT 1 FROM lk WHERE lk.parent = ev.fk AND lk.status = 0 LIMIT 1) x ON true WHERE ev.v < 5 GROUP BY 1 ORDER BY 1$q$),
 ('join', $q$SELECT lk.label, count(*), sum(ev.v) FROM ev JOIN lk ON lk.parent = ev.fk AND lk.status = 2 WHERE ev.fk BETWEEN 100 AND 159 GROUP BY 1 ORDER BY 1$q$);
-- never analyzed, never vacuumed
SELECT name, probes(q) AS probed FROM shapes ORDER BY name;
  name   | probed 
---------+--------
 anti    | t
 join    | t
 lateral | t
 not_in  | t
 semi    | t
(5 rows)

-- analyzed, not vacuumed (nothing all-visible)
ANALYZE ev, lk;
SELECT c.relname, c.relallvisible FROM pg_class c WHERE c.relname IN ('ev', 'lk') ORDER BY 1;
 relname | relallvisible 
---------+---------------
 ev      |             0
 lk      |             0
(2 rows)

SELECT name, probes(q) AS probed FROM shapes ORDER BY name;
  name   | probed 
---------+--------
 anti    | t
 join    | t
 lateral | t
 not_in  | t
 semi    | t
(5 rows)

-- vacuumed
VACUUM (FREEZE, ANALYZE) ev, lk;
SELECT name, probes(q) AS probed FROM shapes ORDER BY name;
  name   | probed 
---------+--------
 anti    | t
 join    | t
 lateral | t
 not_in  | t
 semi    | t
(5 rows)

DROP FUNCTION probes(text);
DROP TABLE shapes, ev, lk;
RESET ALL;
SET client_min_messages = warning;
DROP SCHEMA s10 CASCADE;
RESET client_min_messages;
-- <<< agg_probe_unvacuumed
DROP EXTENSION pg_sift;
