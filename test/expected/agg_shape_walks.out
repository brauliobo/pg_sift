-- The passes that look for a rewrite of a statement (a shared CTE, json_build_object, an aggregate of a CASE, an EXISTS, an ARRAY sub-link, a correlated min() or max(), a lateral sub-select with
-- a sub-link, a left join) need one kind of node each: one walk of the statement finds which kinds it holds, and a pass whose node is not there does not walk it.
-- sift._test_prepass_nodes (pg_sift_test) counts the nodes the passes visit.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
CREATE TABLE sw_fact (id int, k int, v int);
INSERT INTO sw_fact SELECT i, i % 500, i % 7 FROM generate_series(1, 20000) i;
CREATE TABLE sw_keys (k int);
INSERT INTO sw_keys SELECT i FROM generate_series(1, 20) i;
ANALYZE sw_fact;
CREATE INDEX sw_fact_col ON sw_fact USING sift_col (id, k, v) WITH (rollup_columns = 'off');
NOTICE:  sift_col index "sw_fact_col": 1 advice (track_changes)
DETAIL:  advice: track_changes = the table has no one-column primary key
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('sw_fact_col');
CREATE FUNCTION sw_nodes(q text) RETURNS bigint LANGUAGE plpgsql AS $f$
BEGIN
	PERFORM sift._test_prepass_nodes(true);
	EXECUTE 'EXPLAIN (COSTS OFF) ' || q;
	RETURN sift._test_prepass_nodes(true);
END $f$;
-- the first planning of a form loads what the others reuse
SELECT sw_nodes('SELECT v, count(*) FROM sw_fact WHERE k IN (SELECT k FROM sw_keys) GROUP BY v') AS discard \gset
-- a statement that nests and holds none of the kinds is walked for them once: its nodes are about those of its own tree (178 when each pass walked it)
SELECT sw_nodes('SELECT v, count(*) FROM sw_fact WHERE k IN (SELECT k FROM sw_keys) GROUP BY v') AS plain \gset
SELECT :plain > 0 AS the_passes_ran, :plain < 100 AS one_walk_for_the_kinds;
 the_passes_ran | one_walk_for_the_kinds 
----------------+------------------------
 t              | t
(1 row)

-- a statement that holds the kind of a pass is walked by it too
SELECT sw_nodes('SELECT json_build_object(''n'', count(*)) FROM sw_fact WHERE k IN (SELECT k FROM sw_keys)') > :plain AS json_call_walked;
 json_call_walked 
------------------
 t
(1 row)

SELECT sw_nodes('SELECT sum(CASE WHEN v = 1 THEN id END) FROM sw_fact WHERE k IN (SELECT k FROM sw_keys)') > :plain AS case_aggregate_walked;
 case_aggregate_walked 
-----------------------
 t
(1 row)

SELECT sw_nodes('WITH c AS (SELECT * FROM sw_fact WHERE k IN (SELECT k FROM sw_keys)) SELECT count(*) FROM c') > :plain AS with_walked;
 with_walked 
-------------
 t
(1 row)

-- one that holds a sub-link of a kind the passes find no rewrite for is not
SELECT sw_nodes('SELECT count(*) FROM sw_fact f WHERE EXISTS (SELECT 1 FROM sw_keys s WHERE s.k = f.k)') < 100 AS exists_few_nodes;
 exists_few_nodes 
------------------
 t
(1 row)

SELECT sw_nodes('SELECT count(*) FROM sw_fact WHERE k = ANY (ARRAY(SELECT k FROM sw_keys))') < 100 AS array_few_nodes;
 array_few_nodes 
-----------------
 t
(1 row)

-- the rewrites that remain are made: the statements answer as they did
SELECT count(*) AS in_sublink FROM sw_fact WHERE k IN (SELECT k FROM sw_keys);
 in_sublink 
------------
        800
(1 row)

SELECT count(*) AS exists_sublink FROM sw_fact f WHERE EXISTS (SELECT 1 FROM sw_keys s WHERE s.k = f.k);
 exists_sublink 
----------------
            800
(1 row)

SELECT count(*) AS array_sublink FROM sw_fact WHERE k = ANY (ARRAY(SELECT k FROM sw_keys));
 array_sublink 
---------------
           800
(1 row)

SELECT sum(CASE WHEN v = 1 THEN id END) AS case_aggregate FROM sw_fact WHERE k IN (SELECT k FROM sw_keys);
 case_aggregate 
----------------
        1123706
(1 row)

SELECT json_build_object('n', count(*)) AS json_call FROM sw_fact WHERE k IN (SELECT k FROM sw_keys);
  json_call  
-------------
 {"n" : 800}
(1 row)

DROP FUNCTION sw_nodes(text);
DROP TABLE sw_fact, sw_keys;
DROP EXTENSION pg_sift_test, pg_sift CASCADE;
