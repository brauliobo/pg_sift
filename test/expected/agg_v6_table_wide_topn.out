DROP TABLE qt, qh, qx, qxh;
DROP VIEW qbulk, qedge;
DROP FUNCTION plan_of(text), node_ok(text, text), text_of(text, boolean), same(text, text, text, boolean), same_exec(text, text, text, text);
DROP EXTENSION pg_sift;
