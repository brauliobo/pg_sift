-- the compact lines of EXPLAIN (ANALYZE) of the Format 2.0 engine: four scans in text, the pruning one in JSON, and the zero counters of VERBOSE
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SELECT sift._test_explain_v6(s, 'text') FROM generate_series(1, 4) s;
                                                   _test_explain_v6                                                   
----------------------------------------------------------------------------------------------------------------------
   Parts: scanned=4 pruned_key=188 pruned_time=8 l0_slabs=1                                                          +
   Granules: scanned=62 pruned_zone=410 pruned_skip=118 pruned_dict=12 preagg=48                                     +
   Exec: SIMD=avx512 workers=4/4 cfilt=91.9% (dict=38 rle=14 forbit=8 fsst=2) late_mat_saved=18.4MB group=dict-direct+
   I/O & Mem: aio_batches=14 (112 blks) peak_mem=2.8MB/4.0MB                                                         +
 
   Scope Exec: L2_hit=1 topk_ring=20 spills=0 heap_vet=0                                                             +
   Exec: SIMD=avx512                                                                                                 +
   I/O & Mem: aio_batches=1 (3 blks) peak_mem=128KB/4.0MB                                                            +
 
   Hybrid: bm25_hits=312 col_granules=4                                                                              +
   Exec: SIMD=avx512 cfilt=100.0% (forbit=4) late_mat_saved=1.2MB                                                    +
   I/O & Mem: aio_batches=2 (9 blks) peak_mem=412KB/4.0MB                                                            +
 
   Parts: scanned=6 pruned_key=0 pruned_time=194                                                                     +
   Granules: scanned=112 pruned_zone=68 pruned_skip=84                                                               +
   SIP Filter: sbbf=64KB pass=1.4% (11200/800000 rows) granules_pruned=84                                            +
   Exec: SIMD=avx512 workers=4/4 cfilt=88.4% (rle=44 forbit=68) group=radix-ht                                       +
   I/O & Mem: aio_batches=22 (240 blks) peak_mem=3.9MB/4.0MB spills=1 (1.2MB)                                        +
   Fallback: preagg_skipped (runtime SIP filter on non-cube column 'entity_id')                                      +
 
(4 rows)

