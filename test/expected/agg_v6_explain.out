SELECT sift._test_explain_v6(2, 'text', true);
                                     _test_explain_v6                                      
-------------------------------------------------------------------------------------------
   Scope Exec: L2_hit=1 topk_ring=20 spills=0 heap_vet=0                                  +
   Exec: SIMD=avx512 late_mat_saved=0KB late_mat_exits=0 sparse_decodes=0 adapt_reorders=0+
   I/O & Mem: aio_batches=1 (3 blks) peak_mem=128KB/4.0MB spills=0 (0KB)                  +
 
(1 row)

SELECT s, array_length(string_to_array(trim(trailing E'\n' from sift._test_explain_v6(s, 'text')), E'\n'), 1) <= 6 AS at_most_six_lines FROM generate_series(1, 4) s;
 s | at_most_six_lines 
---+-------------------
 1 | t
 2 | t
 3 | t
 4 | t
(4 rows)

DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
