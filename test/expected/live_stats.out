----------
 t
(1 row)

SELECT sift.merge('ls_idx', true) > 0 AS merged;
 merged 
--------
 t
(1 row)

SELECT count(*) FILTER (WHERE kind = 'immutable') = 1 AS one_segment, count(*) FILTER (WHERE dirty) AS dirty_left FROM sift.segments('ls_idx');
 one_segment | dirty_left 
-------------+------------
 t           |          0
(1 row)

