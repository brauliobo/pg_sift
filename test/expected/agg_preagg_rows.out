-- a transaction that deleted rows sees them gone, another does not until it commits
BEGIN;
DELETE FROM rd WHERE id BETWEEN 1 AND 100;
SELECT * FROM pa_sum('rd');
 queries | differ | all_pre | some_pre | no_pre 
---------+--------+---------+----------+--------
