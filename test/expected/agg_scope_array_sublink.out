-- the key by a parameter: custom and generic plans
PREPARE arr_by_key(int) AS SELECT kind, sum(amount) AS total, count(*) AS n FROM facts f WHERE f.dim_a_id = ANY (ARRAY(SELECT member FROM tenant_pairs WHERE tenant_id = $1)) GROUP BY kind;
PREPARE arr_by_keys(int[]) AS SELECT kind, sum(amount) AS total, count(*) AS n FROM facts f WHERE f.dim_a_id = ANY (ARRAY(SELECT member FROM tenant_pairs WHERE tenant_id = ANY ($1))) GROUP BY kind;
SET plan_cache_mode = force_generic_plan;
SELECT label('EXECUTE arr_by_key(1)') AS by_key, label('EXECUTE arr_by_keys(ARRAY[2, 5])') AS by_keys, same('EXECUTE arr_by_key(1)') AS same_key, same('EXECUTE arr_by_keys(ARRAY[2, 5])') AS same_keys;
          by_key           |          by_keys          | same_key | same_keys 
---------------------------+---------------------------+----------+-----------
 scope read, $1 keys, once | scope read, $1 keys, once | t        | t
(1 row)

SET plan_cache_mode = force_custom_plan;
SELECT label('EXECUTE arr_by_key(1)') AS by_key, label('EXECUTE arr_by_keys(ARRAY[2, 5])') AS by_keys, same('EXECUTE arr_by_key(1)') AS same_key, same('EXECUTE arr_by_keys(ARRAY[2, 5])') AS same_keys;
          by_key          |         by_keys          | same_key | same_keys 
--------------------------+--------------------------+----------+-----------
 scope read, 1 keys, once | scope read, 2 keys, once | t        | t
(1 row)

RESET plan_cache_mode;
-- the pairs change after the build: the rows are the join's in every state
