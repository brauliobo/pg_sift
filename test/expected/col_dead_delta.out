 net_after_merge 
-----------------
               0
(1 row)

SELECT sift.col_verify('dd_col', true);
 col_verify 
------------
 
(1 row)

DROP FUNCTION dd_net(text), dd_same(text);
DROP TABLE dd, dd_q;
DROP EXTENSION pg_sift;
