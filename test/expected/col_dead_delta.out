-- ... and the group that no row is left in is not one of the groups of the answer
SELECT kind, count(*) FROM dd GROUP BY kind ORDER BY kind;
 kind | count 
------+-------
 k0   |  7389
 k1   |  6650
 k2   |  7388
 k3   |  7388
 k4   |  7388
      |   840
(6 rows)

-- the setting off scans every dirty unit
SET sift.agg_dead_delta = 0;
SELECT dd_net('SELECT grp, count(*), sum(amount) FROM dd GROUP BY grp') AS net_off;
 net_off 
---------
       0
(1 row)

SET sift.agg_dead_delta = 25;
-- more dead rows than the share: the unit scans
SET sift.agg_dead_delta = 1;
SELECT dd_net('SELECT grp, count(*), sum(amount) FROM dd GROUP BY grp') AS net_over_share;
 net_over_share 
----------------
              0
(1 row)

SET sift.agg_dead_delta = 25;
-- a page that is not all-visible: the unit scans and the answer is the heap's
UPDATE dd SET qty = qty + 1 WHERE id % 1000 = 5;
SELECT n, dd_same(q) AS same FROM dd_q WHERE n IN (1, 2, 3, 9) ORDER BY n;
 n | same 
---+------
 1 | t
 2 | t
 3 | t
 9 | t
(4 rows)

VACUUM (DISABLE_PAGE_SKIPPING) dd;
-- the merge of everything leaves no dead rows: every unit is exact again
SELECT sift.col_merge('dd_col', true) >= 0 AS merged;
 merged 
--------
 t
(1 row)

SELECT n, dd_same(q) AS same FROM dd_q ORDER BY n;
 n  | same 
----+------
