--------------
 same
(1 row)

SELECT p_same_order('SELECT id, qty FROM s ORDER BY qty, id LIMIT 5 OFFSET 7', 'SELECT id, qty FROM s ORDER BY qty + 0, id LIMIT 5 OFFSET 7');
