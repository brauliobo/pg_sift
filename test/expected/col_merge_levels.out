(1 row)

-- a write buffer of 64 kB makes a segment of every few hundred rows while a statement inserts; the rewrite leaves few
CREATE TABLE mw (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, k int NOT NULL, amount float8 NOT NULL) WITH (autovacuum_enabled = off);
CREATE INDEX mw_idx ON mw USING sift_col (id, k, amount) WITH (key_cut = k, key_cut_rows = 100, write_buffer_limit = 64);
SET sift.col_auto_merge = off;
INSERT INTO mw (k, amount) SELECT 1 + (random() * 399)::int, round((random() * 100)::numeric, 2) FROM generate_series(1, 20000);
SELECT sift.col_promote('mw_idx') IS NOT NULL AS promoted;
 promoted 
----------
 t
(1 row)

SELECT count(*) > 8 AS many_segments FROM sift.col_segments('mw_idx') WHERE kind = 'immutable';
 many_segments 
---------------
 t
(1 row)

SELECT sift.col_maintain('mw_idx') AS maintained;
 maintained 
------------
 t
(1 row)

SELECT count(*) <= 3 AS few_segments FROM sift.col_segments('mw_idx') WHERE kind = 'immutable';
 few_segments 
--------------
 t
(1 row)

SELECT sum(rows) = 20000 AS all_rows FROM sift.col_segments('mw_idx') WHERE kind = 'immutable';
 all_rows 
----------
 t
(1 row)

DROP FUNCTION ml_rows(int), ml_segments(), ml_units(int), ml_requests(int);
DROP TABLE ml, mw;
DROP EXTENSION pg_sift CASCADE;
