-- The small segments (overlays) that promotions leave over the keys of an index that is not cut into partitions are merged by the same rule as in a partitioned one: the
-- segments under half the largest, the smallest that come to twice the largest of them (a size-tiered step: a row is not rewritten at every promotion),
-- when the units and segments a request for a key would no longer open, times the requests the index has had, come to half of the rewrite of their rows. The largest
-- segment is not rewritten, an index nobody reads is not merged, and a promotion of a write buffer made of many small ones ends in few segments.
CREATE EXTENSION pg_sift;
SET client_min_messages = warning;
SET max_parallel_maintenance_workers = 0;
SET sift.async_maintenance = off;
SET sift.col_auto_merge_wal_pct = 5;
CREATE TABLE ml (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, k int NOT NULL, kind_id int NOT NULL, amount float8 NOT NULL) WITH (autovacuum_enabled = off);
CREATE FUNCTION ml_rows(n int) RETURNS void LANGUAGE sql AS $$
  INSERT INTO ml (k, kind_id, amount) SELECT 1 + (random() * 399)::int, 1 + (random() * 6)::int, round((random() * 100)::numeric, 2) FROM generate_series(1, n) $$;
SELECT ml_rows(40000);
 ml_rows 
---------
 
(1 row)

CREATE INDEX ml_idx ON ml USING sift_col (id, k, kind_id, amount) WITH (key_cut = k, key_cut_rows = 100);
SET sift.col_auto_merge = off;
-- two promotions of 3,000 rows each over the same keys: two overlays of 7.5% of the rows of the first segment
DO $$ BEGIN FOR i IN 1..2 LOOP PERFORM ml_rows(3000); PERFORM sift.col_promote('ml_idx'); COMMIT; END LOOP; END $$;
VACUUM (FREEZE, ANALYZE, INDEX_CLEANUP off) ml;
RESET sift.col_auto_merge;
ALTER TABLE ml RESET (autovacuum_enabled);
CREATE FUNCTION ml_segments() RETURNS bigint LANGUAGE sql AS $$ SELECT count(*) FROM sift.col_segments('ml_idx') WHERE kind = 'immutable' $$;
CREATE FUNCTION ml_units(key int) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE l text; n bigint := 0;
BEGIN
  FOR l IN EXECUTE format('EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) SELECT kind_id, count(*), sum(amount) FROM ml WHERE k = %s GROUP BY kind_id', key) LOOP
    IF l LIKE '%Units:%' THEN n := (regexp_match(l, 'Units: (\d+) read'))[1]::bigint; END IF;
  END LOOP;
  RETURN n;
END $$;
CREATE FUNCTION ml_requests(n int) RETURNS void LANGUAGE plpgsql AS $$
BEGIN FOR i IN 1..n LOOP PERFORM kind_id, count(*), sum(amount) FROM ml WHERE k = 1 + (i * 7) % 400 GROUP BY kind_id; END LOOP; END $$;
SELECT ml_segments() AS segments;
 segments 
----------
        3
(1 row)

SELECT gen AS base_gen FROM sift.col_segments('ml_idx') WHERE kind = 'immutable' ORDER BY bytes DESC LIMIT 1 \gset
SELECT ml_units(7) AS units_before \gset
SET sift.enable_agg = off;
SELECT md5(string_agg(x::text, ',' ORDER BY x::text)) AS native FROM (SELECT k, kind_id, count(*), round(sum(amount)::numeric, 2) FROM ml GROUP BY 1, 2) x \gset
RESET sift.enable_agg;
-- no one has read the index: the merge is not worth its rows
SELECT coalesce(sift.col_maintenance_due('ml_idx', true), 'not due') AS due_cold;
 due_cold 
----------
 not due
(1 row)

SELECT ml_requests(1500);
 ml_requests 
-------------
 
(1 row)

SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

CHECKPOINT;
SELECT coalesce(sift.col_maintenance_due('ml_idx', true), 'not due') AS due_read;
   due_read    
---------------
 overlay units
(1 row)

SELECT sift.col_maintain('ml_idx') AS maintained;
 maintained 
------------
 t
(1 row)

-- the overlays are one, the largest segment is the one it was
SELECT ml_segments() AS segments;
 segments 
----------
        2
(1 row)

SELECT count(*) = 1 AS base_kept FROM sift.col_segments('ml_idx') WHERE kind = 'immutable' AND gen = :base_gen;
 base_kept 
-----------
 t
(1 row)

SELECT coalesce(sift.col_maintenance_due('ml_idx', true), 'not due') AS due_merged;
 due_merged 
------------
 not due
(1 row)

SELECT ml_units(7) < :units_before AS fewer_units;
 fewer_units 
-------------
 t
(1 row)

SELECT md5(string_agg(x::text, ',' ORDER BY x::text)) = :'native' AS same_rows FROM (SELECT k, kind_id, count(*), round(sum(amount)::numeric, 2) FROM ml GROUP BY 1, 2) x;
 same_rows 
-----------
 t
(1 row)

-- a size-tiered step: a small promotion next to the merged overlay (under a tenth of it) is not worth a rewrite of that one
SET sift.col_auto_merge = off;
SELECT ml_rows(500);
 ml_rows 
---------
 
(1 row)

SELECT sift.col_promote('ml_idx') AS promoted;
 promoted 
----------
        1
(1 row)

RESET sift.col_auto_merge;
SELECT ml_segments() AS segments;
 segments 
----------
        3
(1 row)

SELECT ml_requests(1500);
 ml_requests 
-------------
 
(1 row)

SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT coalesce(sift.col_maintenance_due('ml_idx', true), 'not due') AS due_small_next_to_large;
 due_small_next_to_large 
-------------------------
 not due
(1 row)

-- the next promotion of the size of the first overlays makes the step worth it: the three come to twice the merged one
SET sift.col_auto_merge = off;
SELECT ml_rows(6000);
 ml_rows 
---------
 
(1 row)

SELECT sift.col_promote('ml_idx') AS promoted;
 promoted 
----------
        1
(1 row)

RESET sift.col_auto_merge;
SET sift.enable_agg = off;
SELECT md5(string_agg(x::text, ',' ORDER BY x::text)) AS native FROM (SELECT k, kind_id, count(*), round(sum(amount)::numeric, 2) FROM ml GROUP BY 1, 2) x \gset
RESET sift.enable_agg;
SELECT coalesce(sift.col_maintenance_due('ml_idx', true), 'not due') AS due_next_step;
 due_next_step 
---------------
 overlay units
(1 row)

SELECT sift.col_maintain('ml_idx') AS maintained;
 maintained 
------------
 t
(1 row)

SELECT ml_segments() AS segments;
 segments 
----------
        2
(1 row)

SELECT count(*) = 1 AS base_kept FROM sift.col_segments('ml_idx') WHERE kind = 'immutable' AND gen = :base_gen;
 base_kept 
-----------
 t
(1 row)

SELECT md5(string_agg(x::text, ',' ORDER BY x::text)) = :'native' AS same_rows FROM (SELECT k, kind_id, count(*), round(sum(amount)::numeric, 2) FROM ml GROUP BY 1, 2) x;
 same_rows 
-----------
