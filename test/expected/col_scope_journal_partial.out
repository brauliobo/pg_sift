-- The journal index of a scope relation must hear of every pair a statement inserts: a partial sift_col index never hears of a pair outside its predicate, so a read would take the member
-- for unchanged and answer from stale scope entries. A partial index does not qualify as the journal: the scope index is refused while it is the only candidate, and ignored beside a plain one.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
SET client_min_messages = warning;
SET sift.agg_force = on;
CREATE FUNCTION try(stmt text) RETURNS text LANGUAGE plpgsql AS
$$ DECLARE hint text; BEGIN EXECUTE stmt; RETURN 'ok';
   EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS hint = PG_EXCEPTION_HINT; RETURN sqlerrm || coalesce(' [' || hint || ']', ''); END $$;
-- the scope read and the plain join of one group: the same rows, and whether the units answered
CREATE FUNCTION group_read(k int, OUT same boolean, OUT scope_rows bigint, OUT join_rows bigint, OUT fallback text)
LANGUAGE plpgsql AS $$
DECLARE
	p jsonb;
BEGIN
	EXECUTE format('EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF, FORMAT JSON) SELECT count(*), sum(amount) FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''group_id'', f.dim_a_id, %s)', k) INTO p;
	fallback := jsonb_path_query_first(p, '$.**."Scope Fallback"') #>> '{}';
	EXECUTE format('SELECT count(*) FROM facts f WHERE sift.in_scope(''facts_col''::regclass, ''group_id'', f.dim_a_id, %s)', k) INTO scope_rows;
	SET LOCAL sift.enable_agg = off;
	EXECUTE format('SELECT count(*) FROM facts f WHERE f.dim_a_id IN (SELECT dim_a_id FROM pairs WHERE group_id = %s)', k) INTO join_rows;
	SET LOCAL sift.enable_agg = on;
	same := scope_rows = join_rows;
END $$;
CREATE TABLE pairs (dim_a_id int NOT NULL, group_id int NOT NULL, PRIMARY KEY (dim_a_id, group_id)) WITH (autovacuum_enabled = false);
INSERT INTO pairs SELECT e, 1 + e % 20 FROM generate_series(1, 400) e;
CREATE TABLE facts (id int PRIMARY KEY, dim_a_id int, created_at timestamptz, amount int) WITH (autovacuum_enabled = false);
INSERT INTO facts SELECT i, 1 + i % 450, timestamptz '2026-01-01' + (i % 100) * interval '1 day', i % 10 FROM generate_series(1, 20000) i;
-- a partial journal index is the only candidate: refused with a hint
CREATE INDEX pairs_partial ON pairs USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid') WHERE group_id < 10;
SELECT try('CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = ''group_id: dim_a_id -> pairs(dim_a_id, group_id)'')') AS only_partial;
                                                                                                                                                 only_partial                                                                                                                                                  
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 scope "group_id": the journal index of "pairs" is a partial index [A partial index never hears of a pair inserted outside its predicate, unless the predicate of the btree of the pairs implies it: CREATE INDEX ON pairs USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid') without a WHERE.]
(1 row)

-- a plain one beside it: the scope index depends on the plain one only
CREATE INDEX pairs_journal ON pairs USING sift_col (dim_a_id, group_id) WITH (track_changes = 'ctid');
CREATE INDEX facts_col ON facts USING sift_col (id, dim_a_id, created_at, amount) WITH (scope = 'group_id: dim_a_id -> pairs(dim_a_id, group_id)');
REINDEX INDEX facts_col;
VACUUM (FREEZE, ANALYZE) facts;
SELECT string_agg(refobjid::regclass::text, ' ' ORDER BY refobjid::regclass::text) AS edges FROM pg_depend
WHERE classid = 'pg_class'::regclass AND objid = 'facts_col'::regclass AND refclassid = 'pg_class'::regclass AND deptype = 'n' AND (SELECT relkind FROM pg_class WHERE oid = refobjid) = 'i';
          edges           
--------------------------
 pairs_journal pairs_pkey
(1 row)

SELECT * FROM group_read(15);
 same | scope_rows | join_rows | fallback 
------+------------+-----------+----------
 t    |        890 |       890 | 
(1 row)

-- a pair inserted outside the predicate of the partial index (group 15) and one inside it (group 3): both are exact
INSERT INTO pairs VALUES (420, 15), (421, 3);
SELECT * FROM group_read(15);
 same | scope_rows | join_rows | fallback 
------+------------+-----------+----------
 t    |        934 |       934 | 
(1 row)

SELECT * FROM group_read(3);
 same | scope_rows | join_rows | fallback 
------+------------+-----------+----------
 t    |        934 |       934 | 
(1 row)

DELETE FROM pairs WHERE dim_a_id IN (15, 17);
SELECT * FROM group_read(16);
 same | scope_rows | join_rows | fallback 
------+------------+-----------+----------
 t    |        845 |       845 | 
(1 row)

SELECT * FROM group_read(18);
 same | scope_rows | join_rows | fallback 
------+------------+-----------+----------
 t    |        845 |       845 | 
(1 row)

DROP TABLE facts, pairs;
DROP FUNCTION group_read(int), try(text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
