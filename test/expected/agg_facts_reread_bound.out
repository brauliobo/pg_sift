-- The facts of a partition index (layout, statistics, pre-aggregates) are read again when its stamp moves, and the earlier ones stay in "sift cache partition facts" until the cache is emptied:
-- that is bounded by sift.backend_cache_kb, not by the number of re-reads. 1000 plans with a change of the table between each leave the context under the budget; with a budget far above what they need it grows with them.
CREATE EXTENSION pg_sift;
SELECT current_setting('sift.backend_cache_kb') AS default_budget;
 default_budget 
----------------
 16MB
(1 row)

SET max_parallel_workers_per_gather = 0;
SET client_min_messages = warning;
SET jit = off;
SET sift.agg_force = on;
SET seq_page_cost = 10000;
CREATE TABLE fb_events (id int, dim_a_id int, amount int) PARTITION BY HASH (id);
CREATE TABLE fb_events_0 PARTITION OF fb_events FOR VALUES WITH (MODULUS 2, REMAINDER 0);
CREATE TABLE fb_events_1 PARTITION OF fb_events FOR VALUES WITH (MODULUS 2, REMAINDER 1);
INSERT INTO fb_events SELECT i, 1 + i % 5, i % 97 FROM generate_series(1, 500) i;
CREATE INDEX fb_events_col ON fb_events USING sift_col (id, dim_a_id, amount);
VACUUM ANALYZE fb_events;
CREATE TEMP TABLE fb_peak (budget_kb int, peak_kb bigint);
CREATE FUNCTION fb_facts_kb() RETURNS bigint LANGUAGE sql AS
$$ SELECT coalesce(sum(total_bytes), 0) / 1024 FROM pg_backend_memory_contexts WHERE name = 'sift cache partition facts' $$;
CREATE FUNCTION fb_cycles(n int, budget_kb int) RETURNS void LANGUAGE plpgsql AS $$
DECLARE peak bigint := 0;
BEGIN
	EXECUTE format('SET sift.backend_cache_kb = %s', budget_kb);
	FOR i IN 1..n LOOP
		INSERT INTO fb_events VALUES (1000 + i, 1 + i % 5, i % 97);
		EXECUTE 'EXPLAIN (COSTS OFF) SELECT dim_a_id, count(*), sum(amount) FROM fb_events WHERE id BETWEEN 1 AND 400 GROUP BY dim_a_id';
		peak := greatest(peak, fb_facts_kb());
	END LOOP;
	INSERT INTO fb_peak VALUES (budget_kb, peak);
END $$;
SELECT fb_cycles(1000, 1);
 fb_cycles 
-----------
 
(1 row)

SELECT fb_cycles(1000, 1048576);
 fb_cycles 
-----------
 
(1 row)

SELECT budget_kb, peak_kb <= 16 AS stays_under_the_budget_and_one_plan FROM fb_peak WHERE budget_kb = 1;
 budget_kb | stays_under_the_budget_and_one_plan 
-----------+-------------------------------------
         1 | t
(1 row)

SELECT peak_kb > (SELECT peak_kb FROM fb_peak WHERE budget_kb = 1) * 4 AS grows_without_a_budget FROM fb_peak WHERE budget_kb = 1048576;
 grows_without_a_budget 
------------------------
 t
(1 row)

DROP FUNCTION fb_cycles(int, int), fb_facts_kb();
DROP TABLE fb_events;
DROP EXTENSION pg_sift;
