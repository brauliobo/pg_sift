(1 row)

-- forced compact keeps a chunk with a run of equal keys in a group and the build says so
SET client_min_messages = notice;
\set VERBOSITY default
ALTER INDEX gc_i SET (order_layout = 'compact');
REINDEX INDEX gc_i;
NOTICE:  sift_col index "gc_i": 2 automatic choices, 1 advice
DETAIL:  advice: track_changes = the table has no one-column primary key;
order_array_columns = created (second order only); order_layout = created compact in 86% of chunks
HINT:  Reasons, costs and how to turn each off: SELECT * FROM sift.index_choices('gc_i');
NOTICE:  sift_col index "gc_i" is column format minor 44, which a library before 4.3 cannot read
HINT:  SET sift.col_format_minor = 14 before the build to write a format the older library reads.
\set VERBOSITY terse
SET client_min_messages = warning;
SELECT sift.col_verify('gc_i', true);
 col_verify 
------------
 
(1 row)

ALTER INDEX gc_i SET (order_layout = 'whole');
REINDEX INDEX gc_i;
SELECT sift.col_verify('gc_i', true);
