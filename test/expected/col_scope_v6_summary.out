(80 rows)

SELECT s AS scenario, count(*) AS seeds, count(*) FILTER (WHERE r LIKE '%failures=0') AS clean
FROM unnest(ARRAY['inline', 'nullfilter', 'mapedit']) AS s, generate_series(1, 25) AS seed, LATERAL (SELECT sift._test_scope_v6(s, seed) AS r) x
GROUP BY s ORDER BY s;
  scenario  | seeds | clean 
------------+-------+-------
 inline     |    25 |    25
 mapedit    |    25 |    25
 nullfilter |    25 |    25
(3 rows)

-- float8 measures with NaN, infinities and signed zeros keep PostgreSQL's order in the extremes of a cube (NaN above +Infinity), built, merged, read back and subtracted
-- A month cell is a UTC month: a timestamptz answers a local month from cells only in UTC, else from the cells inside it and a scan of the boundary rows
SET TimeZone = 'UTC';
SELECT current_setting('TimeZone') AS time_zone, regexp_split_to_table(sift._test_scope_v6('monthtz', 1), E'\n') AS line;
 time_zone |                   line                   
-----------+------------------------------------------
 UTC       | monthtz zones=16 utc_zones=5 answers=192
 UTC       | failures=0
(2 rows)

SET TimeZone = 'America/New_York';
SELECT current_setting('TimeZone') AS time_zone, regexp_split_to_table(sift._test_scope_v6('monthtz', 1), E'\n') AS line;
    time_zone     |                   line                   
------------------+------------------------------------------
 America/New_York | monthtz zones=16 utc_zones=4 answers=192
 America/New_York | failures=0
(2 rows)

SET TimeZone = 'America/Sao_Paulo';
SELECT current_setting('TimeZone') AS time_zone, regexp_split_to_table(sift._test_scope_v6('monthtz', 1), E'\n') AS line;
     time_zone     |                   line                   
-------------------+------------------------------------------
 America/Sao_Paulo | monthtz zones=16 utc_zones=4 answers=192
 America/Sao_Paulo | failures=0
(2 rows)

RESET TimeZone;
-- no scenario wrote a temporary file; the counter does move when a sort spills
SELECT pg_stat_force_next_flush() IS NOT NULL AS flushed;
 flushed 
---------
 t
(1 row)

SELECT temp_files = :temp_before AS no_temp_files FROM pg_stat_database WHERE datname = current_database();
 no_temp_files 
---------------
 t
(1 row)

SET work_mem = '64kB';
SELECT count(*) FROM (SELECT g FROM generate_series(1, 200000) g ORDER BY g DESC) s;
 count  
--------
 200000
(1 row)

RESET work_mem;
SELECT pg_stat_force_next_flush() IS NOT NULL AS flushed;
 flushed 
---------
 t
(1 row)

SELECT temp_files > :temp_before AS spill_is_counted FROM pg_stat_database WHERE datname = current_database();
 spill_is_counted 
------------------
 t
(1 row)

DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
