WITH f AS MATERIALIZED (SELECT * FROM fetch_cursor()) SELECT count(*) AS cursor_differing_rows FROM ((TABLE before_cursor EXCEPT TABLE f) UNION ALL (TABLE f EXCEPT TABLE before_cursor)) d;
