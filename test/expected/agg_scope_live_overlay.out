 same scope summary SELECT ep.parent_id, date_trunc('month', ... tity_id WHERE ep.parent_id IN (4, 5) GROUP BY 1, 2
 same scope summary SELECT count(*), sum(e.amount) FROM even ... p.entity_id = e.entity_id WHERE ep.parent_id = 999
