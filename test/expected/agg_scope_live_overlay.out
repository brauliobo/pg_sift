 same scope summary SELECT ep.parent_id, count(*), sum(e.amo ... N ep.entity_id = e.entity_id GROUP BY ep.parent_id
 same scope join SELECT e.id, e.entity_id, e.event_date,  ... = 4 ORDER BY e.event_date DESC, e.id DESC LIMIT 20
