-- a statement that scans one index twice and an aborted one leave no pin behind
BEGIN;
SET LOCAL sift.enable_agg = off;
SET LOCAL enable_seqscan = off;
SELECT count(*) FROM (SELECT k FROM oa ORDER BY k LIMIT 5) a, (SELECT k FROM oa ORDER BY k DESC LIMIT 5) b;
 count 
-------
    25
(1 row)

SELECT k FROM oa WHERE k / (k - k) > 0 ORDER BY k;
ERROR:  division by zero
ROLLBACK;
SELECT (SELECT max(k) FROM oa) AS still_reads;
