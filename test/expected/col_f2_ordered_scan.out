BEGIN;
SET LOCAL enable_indexscan = off;
SET LOCAL enable_indexonlyscan = off;
SET LOCAL enable_bitmapscan = off;
DECLARE oc2 SCROLL CURSOR FOR SELECT k, id FROM oa WHERE k IS NOT NULL ORDER BY k, id;
FETCH 3 FROM oc2;
   k   |  id  
-------+------
 -1987 | 8649
 -1983 | 8541
