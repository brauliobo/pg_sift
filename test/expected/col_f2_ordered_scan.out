-- format major 1: the rows of ORDER BY are those of the heap, and a cursor that scrolls over the index reads them again through a Materialize
SET sift.test_create_format1 = on;
CREATE TABLE of1 (id int, k int4);
INSERT INTO of1 SELECT i, CASE WHEN i % 9 = 0 THEN NULL ELSE (i * 7919) % 1001 END FROM generate_series(1, 6000) i;
CREATE INDEX of1_k ON of1 USING sift_col (k sift.col_int4_ops, id sift.col_int4_ops);
VACUUM (ANALYZE) of1;
SET sift.test_create_format1 = off;
SELECT sift._test_index_format('of1_k'::regclass) AS format_major;
 format_major 
--------------
            1
(1 row)

SET enable_seqscan = off;
SET sift.enable_agg = off;
EXPLAIN (COSTS OFF) SELECT k FROM of1 ORDER BY k LIMIT 5;
                QUERY PLAN                
------------------------------------------
 Limit
   ->  Index Only Scan using of1_k on of1
(2 rows)

