-- The ordered scan of a sift_col index of format major 2 whose key_order is the order of its columns (col/f2/scan/ord_stream.c): the rows in the order of the key, forward and backward, NULLS FIRST or LAST,
-- DESC, on one column and on several, with no Sort over the scan. Every query runs twice, as the planner is made to run it (an ordered index scan) and on the heap (a sequential scan and a Sort), and the
-- rows must be the same in the same order, after deletes, updates, rows in the L0 slab, a transaction's own changes and a vacuum. A merge join with equal keys marks and restores the position of its inner
-- scan; a cursor that scrolls over an ordered scan reads through a Materialize; (a, b) > ($1, $2) reaches the scan as one range of the key; a cursor that scrolls over an index of format major 1 still works.
-- The typed families carry the comparison function the executor wants for a row comparison (the SQL of the release gives it to them).
CREATE EXTENSION pg_sift_test CASCADE;
NOTICE:  installing required extension "pg_sift"
SET sift.async_maintenance = off;
SET sift.test_create_format1 = off;
SET client_min_messages = warning;
SET timezone = 'UTC';
CREATE TABLE oa (id int, k int4, d date, pad text DEFAULT repeat('x', 100));
INSERT INTO oa (id, k, d) SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE (i * 7919) % 3001 - 1500 END, CASE WHEN i % 17 = 0 THEN NULL ELSE date '2020-01-01' + (i * 31) % 700 END FROM generate_series(1, 8000) i;
CREATE INDEX oa_k ON oa USING sift_col (k sift.col_int4_ops) WITH (key_order = 'k');
CREATE INDEX oa_d ON oa USING sift_col (d sift.col_date_ops) WITH (key_order = 'd');
CREATE TABLE ob (id int, k int8);
INSERT INTO ob SELECT i, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 104729::int8) % 5003 - 2500 END FROM generate_series(1, 4000) i;
CREATE INDEX ob_k ON ob USING sift_col (k sift.col_int8_ops DESC NULLS LAST) WITH (key_order = 'k DESC NULLS LAST');
CREATE TABLE oc (a int4, b int4, id int);
INSERT INTO oc SELECT CASE WHEN i % 97 = 0 THEN NULL ELSE i % 40 END, CASE WHEN i % 31 = 0 THEN NULL ELSE (i * 17) % 100 END, i FROM generate_series(1, 5000) i;
CREATE INDEX oc_ab ON oc USING sift_col (a sift.col_int4_ops, b sift.col_int4_ops DESC) WITH (key_order = 'a, b DESC');
VACUUM (ANALYZE) oa;
VACUUM (ANALYZE) ob;
VACUUM (ANALYZE) oc;
-- the formats: the indexes are of format major 2 (the plans below say they give the order)
SELECT i, sift._test_index_format(i::regclass) AS format_major FROM (VALUES ('oa_k'), ('oa_d'), ('ob_k'), ('oc_ab')) v(i);
   i   | format_major 
-------+--------------
 oa_k  |            2
 oa_d  |            2
 ob_k  |            2
 oc_ab |            2
(4 rows)

-- the rows of q as the plan gives them (ord: the ordered index scan; else the heap and a Sort), and the nodes the plan has
CREATE FUNCTION ox_run(q text, ord bool, OUT n bigint, OUT md5 text, OUT scans int, OUT sorts int, OUT mats int) LANGUAGE plpgsql AS $$
DECLARE line text;
BEGIN
	PERFORM set_config('sift.enable_agg', 'off', true);
	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	PERFORM set_config('enable_seqscan', (NOT ord)::text, true);
	PERFORM set_config('enable_indexscan', ord::text, true);
	PERFORM set_config('enable_indexonlyscan', ord::text, true);
	PERFORM set_config('enable_sort', (NOT ord)::text, true);
	PERFORM set_config('enable_bitmapscan', 'false', true);
	PERFORM set_config('enable_hashjoin', 'false', true);
	PERFORM set_config('enable_nestloop', 'false', true);
	PERFORM set_config('enable_hashagg', 'false', true);
	PERFORM set_config('enable_material', 'false', true);
	scans := 0;
	sorts := 0;
	mats := 0;
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF line ~ 'Index (Only )?Scan (Backward )?using o._' THEN scans := scans + 1; END IF;
		IF line ~ '^ *(->  )?(Incremental )?Sort$' THEN sorts := sorts + 1; END IF;
		IF line ~ '^ *(->  )?Materialize$' THEN mats := mats + 1; END IF;
	END LOOP;
	EXECUTE 'SELECT count(*), md5(string_agg(w::text, ''|'')) FROM (' || q || ') w' INTO n, md5;
END $$;
CREATE FUNCTION ox_check(q text, OUT rows bigint, OUT agree bool, OUT ordered_scans int, OUT sorts int, OUT materials int) LANGUAGE plpgsql AS $$
DECLARE a record; h record;
BEGIN
	SELECT * INTO a FROM ox_run(q, true);
	SELECT * INTO h FROM ox_run(q, false);
	rows := h.n; agree := a.n = h.n AND a.md5 IS NOT DISTINCT FROM h.md5; ordered_scans := a.scans; sorts := a.sorts; materials := a.mats;
	IF NOT agree THEN
		RAISE EXCEPTION 'the ordered scan gives other rows than the heap: % (% against % rows)', q, a.n, h.n;
	END IF;
END $$;
CREATE TABLE ox_q (n int, q text);
INSERT INTO ox_q VALUES
 (1, 'SELECT k FROM oa ORDER BY k'),
 (2, 'SELECT k FROM oa ORDER BY k DESC'),
 (3, 'SELECT k FROM oa ORDER BY k NULLS FIRST'),
 (4, 'SELECT k FROM oa ORDER BY k DESC NULLS LAST'),
 (5, 'SELECT k FROM oa WHERE k BETWEEN -300 AND 700 ORDER BY k'),
 (6, 'SELECT k FROM oa WHERE k IS NOT NULL ORDER BY k DESC'),
 (7, 'SELECT k FROM oa ORDER BY k LIMIT 10'),
 (8, 'SELECT k FROM oa ORDER BY k DESC LIMIT 10'),
 (9, 'SELECT k FROM oa WHERE id % 7 = 3 ORDER BY k'),
 (10, 'SELECT max(k) FROM oa'),
 (11, 'SELECT min(k) FROM oa'),
 (12, 'SELECT d FROM oa ORDER BY d'),
 (13, 'SELECT d FROM oa ORDER BY d DESC LIMIT 25'),
 (14, 'SELECT k FROM ob ORDER BY k DESC NULLS LAST'),
 (15, 'SELECT k FROM ob ORDER BY k NULLS FIRST'),
 (16, 'SELECT k FROM ob WHERE k > 0 ORDER BY k DESC NULLS LAST LIMIT 30'),
 (17, 'SELECT a, b FROM oc ORDER BY a, b DESC'),
 (18, 'SELECT a, b FROM oc ORDER BY a DESC NULLS FIRST, b NULLS FIRST'),
 (19, 'SELECT a, b FROM oc WHERE a = 7 ORDER BY b DESC'),
 (20, 'SELECT a, b FROM oc WHERE a BETWEEN 5 AND 9 ORDER BY a, b DESC LIMIT 40'),
 (21, 'SELECT a, b, id FROM oc WHERE a IS NOT NULL ORDER BY a, b DESC, id');
-- ordered_scans is 1 and sorts 0 where the index gives the order, forward or backward (15 is the backward scan of ob_k); 3, 4, 18 and 21 ask an order it does not give and sort
