-- a cursor that scrolls (over a Materialize: the access method offers no backward scan to a cursor) gives the rows of the heap, and the same ones when it moves back and forth
BEGIN;
SET LOCAL sift.enable_agg = off;
SET LOCAL enable_seqscan = off;
SET LOCAL enable_sort = off;
DECLARE oc1 SCROLL CURSOR FOR SELECT k, id FROM oa WHERE k IS NOT NULL ORDER BY k, id;
FETCH 3 FROM oc1;
