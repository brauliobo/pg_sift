-- a merge join with equal keys marks the position of its inner scan at the first row of each key and goes back to it for the next row of the outer side: no Sort and no Materialize
CREATE TABLE oj (id int, k int4);
INSERT INTO oj SELECT i, (i * 11) % 700 - 100 FROM generate_series(1, 2000) i;
CREATE INDEX oj_k ON oj USING sift_col (k sift.col_int4_ops) WITH (key_order = 'k');
VACUUM (ANALYZE) oj;
INSERT INTO oj SELECT 2500 + i, (i * 7) % 300 FROM generate_series(1, 500) i;
DELETE FROM oj WHERE id % 19 = 0;
CREATE TABLE oq (n int, q text);
INSERT INTO oq VALUES
 (1, 'SELECT a.k, b.k FROM oa a JOIN oj b ON a.k = b.k'),
 (2, 'SELECT a.k, a.id, b.id FROM oj a JOIN oj b ON a.k = b.k WHERE a.id < 800'),
 (3, 'SELECT a.k FROM oj a JOIN oa b ON a.k = b.k WHERE b.k > 0');
CREATE FUNCTION oq_run(q text, mj bool, OUT n bigint, OUT sum numeric, OUT sorts int, OUT merges int) LANGUAGE plpgsql AS $$
DECLARE line text;
BEGIN
	PERFORM set_config('sift.enable_agg', 'off', true);
	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	PERFORM set_config('enable_seqscan', (NOT mj)::text, true);
	PERFORM set_config('enable_sort', (NOT mj)::text, true);
	PERFORM set_config('enable_bitmapscan', 'false', true);
	PERFORM set_config('enable_hashjoin', (NOT mj)::text, true);
	PERFORM set_config('enable_mergejoin', mj::text, true);
	PERFORM set_config('enable_nestloop', 'false', true);
	PERFORM set_config('enable_material', 'false', true);
	sorts := 0;
	merges := 0;
	FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF line ~ '^ *(->  )?(Incremental )?Sort$' THEN sorts := sorts + 1; END IF;
		IF line ~ 'Merge Join' THEN merges := merges + 1; END IF;
	END LOOP;
	EXECUTE 'SELECT count(*), sum(hashtext(w::text)) FROM (' || q || ') w' INTO n, sum;
END $$;
SELECT oq.n, oq.q, a.n AS rows, a.n = h.n AND a.sum = h.sum AS agree, a.sorts AS sorts, a.merges AS merge_joins
FROM oq, LATERAL oq_run(oq.q, true) a, LATERAL oq_run(oq.q, false) h ORDER BY oq.n;
 n |                                    q                                     | rows | agree | sorts | merge_joins 
---+--------------------------------------------------------------------------+------+-------+-------+-------------
 1 | SELECT a.k, b.k FROM oa a JOIN oj b ON a.k = b.k                         | 4477 | t     |     0 |           1
 2 | SELECT a.k, a.id, b.id FROM oj a JOIN oj b ON a.k = b.k WHERE a.id < 800 | 2632 | t     |     0 |           1
 3 | SELECT a.k FROM oj a JOIN oa b ON a.k = b.k WHERE b.k > 0                | 3940 | t     |     0 |           1
(3 rows)

-- keyset pagination: the rows after (a, b) in the order of the key, as one range of it; every probe gives the rows of the heap
CREATE TABLE ok_oa (a int4, b int4, id int);
INSERT INTO ok_oa SELECT i % 50, (i * 7) % 90, i FROM generate_series(1, 3000) i;
CREATE INDEX ok_ab ON ok_oa USING sift_col (a sift.col_int4_ops, b sift.col_int4_ops) WITH (key_order = 'a, b');
VACUUM (ANALYZE) ok_oa;
DELETE FROM ok_oa WHERE id % 23 = 0;
INSERT INTO ok_oa SELECT i % 60, (i * 3) % 95, 4000 + i FROM generate_series(1, 300) i;
CREATE FUNCTION ok_cmp(pa int, pb int, lim int, ops text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE x text; y text;
BEGIN
	PERFORM set_config('sift.enable_agg', 'off', true);
	PERFORM set_config('enable_seqscan', 'false', true);
	PERFORM set_config('enable_bitmapscan', 'false', true);
	PERFORM set_config('enable_sort', 'false', true);
	EXECUTE format('SELECT md5(string_agg(w::text, ''|'')) FROM (SELECT a, b FROM ok_oa WHERE (a, b) %s ($1, $2) ORDER BY a, b LIMIT $3) w', ops) INTO x USING pa, pb, lim;
	PERFORM set_config('enable_seqscan', 'true', true);
	PERFORM set_config('enable_indexscan', 'false', true);
	PERFORM set_config('enable_indexonlyscan', 'false', true);
	PERFORM set_config('enable_sort', 'true', true);
	EXECUTE format('SELECT md5(string_agg(w::text, ''|'')) FROM (SELECT a, b FROM ok_oa WHERE (a, b) %s ($1, $2) ORDER BY a, b LIMIT $3) w', ops) INTO y USING pa, pb, lim;
	PERFORM set_config('enable_indexscan', 'true', true);
	PERFORM set_config('enable_indexonlyscan', 'true', true);
	RETURN x IS NOT DISTINCT FROM y;
END $$;
SELECT ops, count(*) AS probes, bool_and(ok_cmp(pa, pb, lim, ops)) AS agree
FROM unnest(ARRAY['>', '>=']) ops, generate_series(-1, 61, 9) pa, generate_series(-1, 96, 19) pb, unnest(ARRAY[1, 20, 500]) lim GROUP BY ops ORDER BY ops;
 ops | probes | agree 
-----+--------+-------
 >   |    126 | t
 >=  |    126 | t
(2 rows)

SET enable_seqscan = off;
EXPLAIN (COSTS OFF) SELECT a, b FROM ok_oa WHERE (a, b) > (30, 40) ORDER BY a, b LIMIT 20;
