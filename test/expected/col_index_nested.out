-- ---------------------------------------------------------------------------------------------------------
-- Overflow: shapes and values the declared types cannot hold. The row is still a candidate for every predicate on the affected columns.
-- ---------------------------------------------------------------------------------------------------------
CREATE TABLE odd (id serial PRIMARY KEY, doc jsonb);
INSERT INTO odd (doc) VALUES
	('{"items": [{"category": "x", "qty": 1}]}'),
	('{"items": [{"category": "x", "qty": 1.5}]}'),
	('{"items": [{"category": "x", "qty": "7"}]}'),
	('{"items": [{"category": "x", "qty": 99999999999}]}'),
	('{"items": [{"category": 5, "qty": 2}]}'),
	('{"items": [{"category": "x", "qty": [1]}]}'),
	('{"items": {"category": "x", "qty": 1}}'),
	('{"items": 3}'),
	('{"items": [1, "a", null, {"category": "x", "qty": 1}]}'),
	('{"items": [[{"category": "x"}]]}'),
	('{"items": []}'),
	(NULL),
	(jsonb_build_object('items', jsonb_build_array(jsonb_build_object('category', repeat('c', 300), 'qty', 1))));
CREATE INDEX odd_col ON odd USING sift_col (doc) WITH (paths = 'doc.items[]{category text, qty int4}');
SELECT sift.col_verify('odd_col', true);
 col_verify 
------------
 
(1 row)

-- leaves: 0 doc.items[] (group), 1 category, 2 qty
SELECT string_agg(o.id::text, ',' ORDER BY o.id) AS candidates_qty_eq_1
FROM odd o WHERE o.ctid IN (SELECT tid FROM sift._test_col_tids('odd_col', 'g0:2:eq:1'));
  candidates_qty_eq_1  
-----------------------
 1,2,3,4,6,7,8,9,10,13
(1 row)

SELECT string_agg(o.id::text, ',' ORDER BY o.id) AS exact_qty_eq_1
FROM odd o WHERE EXISTS (SELECT 1 FROM jsonb_array_elements(CASE WHEN jsonb_typeof(o.doc -> 'items') = 'array' THEN o.doc -> 'items' ELSE '[]' END) e
						 WHERE jsonb_typeof(e) = 'object' AND e -> 'qty' = '1');
