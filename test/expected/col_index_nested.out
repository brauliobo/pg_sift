INSERT INTO orders (store_id, status, metrics, doc)
SELECT i % 20, 'paid', jsonb_build_object('a', i % 5, 'zz', 1.5), jsonb_build_object('items', jsonb_build_array(jsonb_build_object('category', 'x', 'kind', 'p', 'qty', i % 9, 'price', 1.5),
	jsonb_build_object('category', 'y', 'kind', 'q', 'qty', 3)), 'notes', jsonb_build_array('n1'))
FROM generate_series(1, 3000) i;
SELECT 'insert', string_agg(CASE WHEN r = 'ok' THEN '.' ELSE r END, '' ORDER BY n) FROM (SELECT n, col_cmp('o_col', preds, heapwhere) r FROM col_checks) s;
 ?column? |         string_agg         
----------+----------------------------
 insert   | ..........................
(1 row)

UPDATE orders SET doc = jsonb_set(doc, '{items,0,category}', '"z"') WHERE id % 10 = 0 AND jsonb_array_length(jarr(doc -> 'items')) > 0;
DELETE FROM orders WHERE id % 13 = 1;
BEGIN;
INSERT INTO orders (store_id, status, doc) SELECT 1, 'new', '{"items": [{"category": "x", "kind": "p", "qty": 1}]}' FROM generate_series(1, 200);
ROLLBACK;
SELECT 'write', string_agg(CASE WHEN r = 'ok' THEN '.' ELSE r END, '' ORDER BY n) FROM (SELECT n, col_cmp('o_col', preds, heapwhere) r FROM col_checks) s;
