DROP TABLE odd;
DROP TABLE col_checks;
DROP TABLE orders;
DROP FUNCTION items_has(jsonb, text, text, int);
DROP FUNCTION jarr(jsonb);
DROP FUNCTION col_cmp(regclass, text, text);
DROP EXTENSION pg_sift_test;
DROP EXTENSION pg_sift;
