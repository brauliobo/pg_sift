-- the same element, not the same row: one row can hold category x in one element and kind p in another
SELECT (SELECT count(*) FROM sift._test_col_tids('o_col', 'g5:6:eq:x;g5:7:eq:p')) AS same_element,
	   (SELECT count(*) FROM orders WHERE items_has(doc, 'x', NULL, NULL) AND items_has(doc, NULL, 'p', NULL)) AS two_elements;
 same_element | two_elements 
--------------+--------------
         2064 |         2960
(1 row)

-- values read back: the elements of each row in array order, the member names of the maps in jsonb order
SELECT count(*) AS differing FROM (
	SELECT tid, val FROM sift._test_col_read('o_col', 6, '')
	EXCEPT SELECT ctid, '{' || coalesce((SELECT string_agg(e ->> 'category', ',' ORDER BY o) FROM jsonb_array_elements(jarr(doc -> 'items')) WITH ORDINALITY a(e, o)), '') || '}' FROM orders) z;
 differing 
-----------
         0
