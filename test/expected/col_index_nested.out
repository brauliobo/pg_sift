-- Nested columns of the sift_col index: arrays of objects inside jsonb keep their parent counts, so a predicate on several fields holds for one
-- element (the same element), exactly as EXISTS over jsonb_array_elements. Maps (key.*) have the member name as a text column. Values that the
-- declared type cannot hold overflow: the row stays a candidate and the heap decides.
CREATE EXTENSION pg_sift;
CREATE EXTENSION pg_sift_test;
SET sift.async_maintenance = off;
CREATE FUNCTION col_cmp(idx regclass, preds text, heapwhere text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE tbl regclass; a bigint; b bigint; ex bigint; mi bigint;
BEGIN
	SELECT indrelid::regclass INTO tbl FROM pg_index WHERE indexrelid = idx;
	SELECT count(*) INTO a FROM sift._test_col_tids(idx, preds);
	EXECUTE format('SELECT count(*) FROM %s WHERE %s', tbl, heapwhere) INTO b;
	EXECUTE format('SELECT count(*) FROM (SELECT tid FROM sift._test_col_tids(%L, %L) EXCEPT SELECT ctid FROM %s WHERE %s) z', idx, preds, tbl, heapwhere) INTO ex;
	EXECUTE format('SELECT count(*) FROM (SELECT ctid FROM %s WHERE %s EXCEPT SELECT tid FROM sift._test_col_tids(%L, %L)) z', tbl, heapwhere, idx, preds) INTO mi;
	RETURN CASE WHEN a = b AND ex = 0 AND mi = 0 THEN 'ok' ELSE format('MISMATCH index=%s heap=%s extra=%s missing=%s', a, b, ex, mi) END;
END $$;
CREATE FUNCTION jarr(j jsonb) RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$ SELECT CASE WHEN jsonb_typeof(j) = 'array' THEN j ELSE '[]' END $$;
CREATE FUNCTION items_has(doc jsonb, cat text, kind text, minqty int) RETURNS bool LANGUAGE sql IMMUTABLE AS $$
	SELECT EXISTS (SELECT 1 FROM jsonb_array_elements(jarr(doc -> 'items')) e
				   WHERE (cat IS NULL OR e ->> 'category' = cat) AND (kind IS NULL OR e ->> 'kind' = kind) AND (minqty IS NULL OR (e ->> 'qty')::int >= minqty))
$$;
CREATE TABLE orders (id serial PRIMARY KEY, store_id int, status text, metrics jsonb, doc jsonb);
INSERT INTO orders (store_id, status, metrics, doc)
SELECT i % 20, (ARRAY['new', 'paid', 'void'])[1 + i % 3],
	   CASE WHEN i % 13 = 0 THEN NULL
			ELSE (SELECT coalesce(jsonb_object_agg(k, (i * length(k) % 17) / 2.0), '{}') FROM unnest(ARRAY['a', 'b', 'cc', 'ddd', 'e']) WITH ORDINALITY u(k, o) WHERE (i + o) % 3 <> 0) END,
	   CASE WHEN i % 29 = 0 THEN NULL
			WHEN i % 31 = 0 THEN '{}'::jsonb
			WHEN i % 37 = 0 THEN '{"items": null, "notes": []}'::jsonb
			ELSE jsonb_build_object(
				'items', (SELECT coalesce(jsonb_agg(CASE WHEN (i + k) % 11 = 0 THEN jsonb_build_object('category', (ARRAY['x', 'y', 'z'])[1 + (i + k) % 3])
														 ELSE jsonb_build_object('category', (ARRAY['x', 'y', 'z'])[1 + (i + k) % 3], 'kind', (ARRAY['p', 'q'])[1 + (i * k) % 2],
																				'qty', (i + k) % 9, 'price', ((i + k) % 40) * 1.5) END), '[]')
						  FROM generate_series(1, i % 6) k),
				'notes', (SELECT coalesce(jsonb_agg('n' || (i + k) % 5), '[]') FROM generate_series(1, i % 4) k)) END
FROM generate_series(1, 5000) i;
CREATE INDEX o_col ON orders USING sift_col (store_id, status, metrics, doc)
	WITH (paths = 'metrics.* float8, doc.items[]{category text, kind text, qty int4, price float4}, doc.notes[] text', write_buffer_limit = 64);
-- leaves: 0 store_id, 1 status, 2 metrics.* (group), 3 its member name, 4 its value, 5 doc.items[] (group), 6 category, 7 kind, 8 qty, 9 price,
-- 10 doc.notes[] (group), 11 its value
SELECT leaves, rows = (SELECT count(*) FROM orders) AS rows_match FROM sift.col_index_info('o_col');
 leaves | rows_match 
--------+------------
     12 | t
(1 row)

SELECT sift.col_verify('o_col', true);
 col_verify 
------------
 
(1 row)

CREATE TABLE col_checks (n serial, preds text, heapwhere text);
INSERT INTO col_checks (preds, heapwhere) VALUES
	('g5:6:eq:x', 'items_has(doc, ''x'', NULL, NULL)'),
	('g5:6:eq:x;g5:7:eq:p', 'items_has(doc, ''x'', ''p'', NULL)'),
	('g5:6:eq:x;g5:7:eq:p;g5:8:ge:3', 'items_has(doc, ''x'', ''p'', 3)'),
	('g5:6:in:x|y;g5:8:lt:2', 'EXISTS (SELECT 1 FROM jsonb_array_elements(jarr(doc -> ''items'')) e WHERE e ->> ''category'' IN (''x'', ''y'') AND (e ->> ''qty'')::int < 2)'),
	('g5:9:gt:30', 'EXISTS (SELECT 1 FROM jsonb_array_elements(jarr(doc -> ''items'')) e WHERE (e ->> ''price'')::float4 > 30)'),
	('g5:6:eq:x;g5:7:null', 'EXISTS (SELECT 1 FROM jsonb_array_elements(jarr(doc -> ''items'')) e WHERE e ->> ''category'' = ''x'' AND e ->> ''kind'' IS NULL)'),
	('g5:6:eq:nothere', 'items_has(doc, ''nothere'', NULL, NULL)'),
	('g5!:6:eq:x', 'NOT items_has(doc, ''x'', NULL, NULL)'),
	('g5!:6:eq:x;g5!:7:eq:p', 'NOT items_has(doc, ''x'', ''p'', NULL)'),
	('g5:6:eq:x;g5!:7:eq:p', 'items_has(doc, ''x'', NULL, NULL) AND NOT items_has(doc, NULL, ''p'', NULL)'),
	('g5:6:prefix:x', 'EXISTS (SELECT 1 FROM jsonb_array_elements(jarr(doc -> ''items'')) e WHERE e ->> ''category'' LIKE ''x%'')'),
	('5:eq:3', 'jsonb_typeof(doc -> ''items'') = ''array'' AND jsonb_array_length(jarr(doc -> ''items'')) = 3'),
	('5:ge:1;5:le:2', 'jsonb_typeof(doc -> ''items'') = ''array'' AND jsonb_array_length(jarr(doc -> ''items'')) BETWEEN 1 AND 2'),
	('5:eq:0', 'jsonb_typeof(doc -> ''items'') = ''array'' AND jsonb_array_length(jarr(doc -> ''items'')) = 0'),
	('5:null', '(doc -> ''items'') IS NULL OR jsonb_typeof(doc -> ''items'') = ''null'''),
	('10:eq:2', 'jsonb_typeof(doc -> ''notes'') = ''array'' AND jsonb_array_length(jarr(doc -> ''notes'')) = 2'),
	('g10:11:eq:n1', 'doc -> ''notes'' ? ''n1'''),
	('g10:11:prefix:n;g10:11:ne:n1', 'EXISTS (SELECT 1 FROM jsonb_array_elements_text(jarr(doc -> ''notes'')) e WHERE e LIKE ''n%'' AND e <> ''n1'')'),
	('g2:3:eq:a', 'metrics ? ''a'''),
	('g2:3:eq:a;g2:4:gt:2', 'EXISTS (SELECT 1 FROM jsonb_each(metrics) e WHERE e.key = ''a'' AND (e.value)::text::float8 > 2)'),
	('g2:3:in:a|cc;g2:4:le:1', 'EXISTS (SELECT 1 FROM jsonb_each(metrics) e WHERE e.key IN (''a'', ''cc'') AND (e.value)::text::float8 <= 1)'),
	('g2!:3:eq:ddd', 'NOT coalesce(metrics ? ''ddd'', false)'),
	('2:eq:3', 'jsonb_typeof(metrics) = ''object'' AND (SELECT count(*) FROM jsonb_object_keys(metrics)) = 3'),
	('2:null', 'metrics IS NULL'),
	('0:eq:7;1:eq:paid;g5:6:eq:x;g5:7:eq:q', 'store_id = 7 AND status = ''paid'' AND items_has(doc, ''x'', ''q'', NULL)'),
	('0:lt:5;g5:8:ge:5;g10:11:eq:n2', 'store_id < 5 AND items_has(doc, NULL, NULL, 5) AND doc -> ''notes'' ? ''n2''');
SELECT n, preds, col_cmp('o_col', preds, heapwhere) FROM col_checks ORDER BY n;
