-- `LEFT JOIN LATERAL jsonb_each(doc) r ON r.key = 'k'` is the member k of each row: a row without it stays, with NULL columns. Its value is read at the
-- row level (or by a correlated child through casts), with PostgreSQL's results and errors; before PostgreSQL 18 the normal plan runs.
CREATE EXTENSION pg_sift;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE facts (id int, entity_id int, metrics jsonb);
INSERT INTO facts
SELECT i, i % 40,
       CASE i % 7 WHEN 0 THEN '{}'::jsonb WHEN 1 THEN '{"other": 3}'::jsonb WHEN 2 THEN NULL WHEN 3 THEN '{"overall": 6.5, "other": 9}'::jsonb
                  ELSE jsonb_build_object('overall', i % 10, 'other', i % 3) END
FROM generate_series(1, 20000) i;
CREATE INDEX facts_col ON facts USING sift_col (id, entity_id, metrics) WITH (paths = 'metrics.* float8');
VACUUM (FREEZE, ANALYZE) facts;
-- The result, or the SQLSTATE and message, with the scan off and on. on: the table scans are off, so a Custom Scan (SiftAgg) runs when the query is one it can run.
CREATE FUNCTION outcome(q text, enabled bool) RETURNS text LANGUAGE plpgsql AS $$
DECLARE result text;
BEGIN
  PERFORM set_config('sift.enable_agg', enabled::text, true);
  PERFORM set_config(s, (NOT enabled)::text, true) FROM unnest(ARRAY['enable_seqscan', 'enable_indexscan', 'enable_bitmapscan', 'enable_indexonlyscan']) s;
  EXECUTE 'SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text)::text, ''no rows'') FROM (' || q || ') t' INTO result;
  RETURN result;
EXCEPTION WHEN OTHERS THEN RETURN SQLSTATE || ' ' || SQLERRM;
END $$;
CREATE FUNCTION runs_in_scan(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE line text; found bool := false;
BEGIN
  PERFORM set_config(s, 'false', true) FROM unnest(ARRAY['enable_seqscan', 'enable_indexscan', 'enable_bitmapscan', 'enable_indexonlyscan']) s;
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP found := found OR line LIKE '%Custom Scan (SiftAgg)%'; END LOOP;
  RETURN found;
END $$;
CREATE FUNCTION check_query(name text, q text) RETURNS TABLE (label text, scan bool, same bool, outcome text) LANGUAGE plpgsql AS $$
BEGIN
  RETURN QUERY SELECT name, runs_in_scan(q), outcome(q, false) = outcome(q, true), left(outcome(q, true), 100);
END $$;
-- the rows without the member are counted, with NULL columns
SELECT * FROM check_query('count', $q$
 SELECT f.entity_id % 3 AS k, count(*) AS rows, count(CAST(r.value AS float)) AS members, sum(CAST(r.value AS float)) AS total
 FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall' GROUP BY 1
$q$);
 label | scan | same |                                               outcome                                                
-------+------+------+------------------------------------------------------------------------------------------------------
 count | f    | t    | [{"k": 0, "rows": 7000, "total": 20006, "members": 4000}, {"k": 1, "rows": 6500, "total": 18240, "me
(1 row)

SELECT * FROM check_query('filter', $q$
 SELECT count(*) AS n, avg(CAST(r.value AS float)) AS mean
 FROM facts f LEFT JOIN LATERAL (SELECT key, value FROM jsonb_each(f.metrics)) r ON r.key = 'overall' WHERE f.entity_id < 30
$q$);
 label  | scan | same |                  outcome                  
--------+------+------+-------------------------------------------
 filter | f    | t    | [{"n": 15000, "mean": 5.000058329444704}]
(1 row)

-- a correlated child reads the member through casts: a row without it gives the child NULL
SELECT * FROM check_query('child', $q$
 SELECT c.category, count(*) AS n, count(DISTINCT f.id) AS ids
 FROM facts f LEFT JOIN LATERAL (SELECT key, value FROM jsonb_each(f.metrics)) ra ON ra.key = 'overall'
 JOIN LATERAL (SELECT 'all' AS category UNION (SELECT CASE WHEN CAST(ra.value AS integer) > 6 THEN 'high' ELSE 'low' END)) c ON true
 GROUP BY 1
$q$);
 label | scan | same |                                               outcome                                                
-------+------+------+------------------------------------------------------------------------------------------------------
 child | f    | t    | [{"n": 14572, "ids": 14572, "category": "low"}, {"n": 20000, "ids": 20000, "category": "all"}, {"n":
(1 row)

-- a child that reads the member another way, and a read of the key: the normal plan
SELECT * FROM check_query('child text', $q$
 SELECT c.v, count(*) FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall'
 JOIN LATERAL (SELECT r.value::text AS v UNION ALL SELECT 'x') c ON true GROUP BY 1
$q$);
   label    | scan | same |                                               outcome                                                
------------+------+------+------------------------------------------------------------------------------------------------------
 child text | f    | t    | [{"v": "0", "count": 857}, {"v": "1", "count": 857}, {"v": "2", "count": 857}, {"v": "3", "count": 8
(1 row)

SELECT * FROM check_query('key', $q$
 SELECT r.key, count(*) FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall' GROUP BY 1
$q$);
 label | scan | same |                              outcome                               
-------+------+------+--------------------------------------------------------------------
 key   | f    | t    | [{"key": "overall", "count": 11428}, {"key": null, "count": 8572}]
(1 row)

SELECT * FROM check_query('child union all, bare read', $q$
 SELECT c.v, count(*) FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) ra ON ra.key = 'overall'
 JOIN LATERAL (SELECT 'a' AS v UNION ALL SELECT (ra.value IS NULL)::text) c ON true GROUP BY 1
$q$);
           label            | scan | same |                                          outcome                                           
----------------------------+------+------+--------------------------------------------------------------------------------------------
 child union all, bare read | f    | t    | [{"v": "a", "count": 20000}, {"v": "false", "count": 11428}, {"v": "true", "count": 8572}]
(1 row)

-- Error timing: the cast of the member raises for the rows that reach it, with PostgreSQL's SQLSTATE and message.
INSERT INTO facts VALUES (20001, 1, '{"overall": 3000000000}'), (20002, 2, '{"overall": 1e30}');
VACUUM (FREEZE, ANALYZE) facts;
SELECT * FROM check_query('excluded row', $q$SELECT c.category, count(*) AS n FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall'
   JOIN LATERAL (SELECT 'all' AS category UNION ALL SELECT CASE WHEN r.value::int > 6 THEN 'high' ELSE 'low' END) c ON true
   WHERE f.id < 20000 GROUP BY 1$q$);
    label     | scan | same |                                               outcome                                               
--------------+------+------+-----------------------------------------------------------------------------------------------------
 excluded row | f    | t    | [{"n": 14571, "category": "low"}, {"n": 19999, "category": "all"}, {"n": 5428, "category": "high"}]
(1 row)

SELECT * FROM check_query('int out of range', $q$SELECT c.category, count(*) AS n FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall'
   JOIN LATERAL (SELECT 'all' AS category UNION ALL SELECT CASE WHEN r.value::int > 6 THEN 'high' ELSE 'low' END) c ON true
   WHERE f.id = 20001 GROUP BY 1$q$);
      label       | scan | same |          outcome           
------------------+------+------+----------------------------
 int out of range | f    | t    | 22003 integer out of range
(1 row)

-- a JSON null member is NULL in PostgreSQL 18 and an error before it (the text is not compared: it depends on the version)
INSERT INTO facts VALUES (20004, 4, '{"overall": null}');
VACUUM (FREEZE, ANALYZE) facts;
SELECT label, same FROM check_query('json null', $q$SELECT count(*) AS n, sum(CAST(r.value AS float)) AS total FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall' WHERE f.id = 20004$q$);
   label   | same 
-----------+------
 json null | t
(1 row)

-- a document that is not an object raises PostgreSQL's error for the rows that reach the join, and so does a member that is no number: the scan is not used
INSERT INTO facts VALUES (20003, 3, '[1, 2]'), (20005, 5, '{"overall": "abc"}');
VACUUM (FREEZE, ANALYZE) facts;
SELECT * FROM check_query('array document', $q$SELECT count(*), sum(CAST(r.value AS float)) FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall' WHERE f.id = 20003$q$);
     label      | scan | same |                   outcome                    
----------------+------+------+----------------------------------------------
 array document | f    | t    | 22023 cannot call jsonb_each on a non-object
(1 row)

SELECT * FROM check_query('string member', $q$SELECT count(*), sum(CAST(r.value AS float)) FROM facts f LEFT JOIN LATERAL jsonb_each(f.metrics) r ON r.key = 'overall' WHERE f.id = 20005$q$);
     label     | scan | same |                         outcome                         
---------------+------+------+---------------------------------------------------------
 string member | f    | t    | 22023 cannot cast jsonb string to type double precision
(1 row)

DROP FUNCTION check_query(text, text), outcome(text, bool), runs_in_scan(text);
DROP TABLE facts;
DROP EXTENSION pg_sift;
